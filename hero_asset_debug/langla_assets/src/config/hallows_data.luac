Config.HallowsData.data_skill_up_length = 90
Config.HallowsData.data_skill_up_cache = {}
Config.HallowsData.data_skill_up = function(key)
	if Config.HallowsData.data_skill_up_cache[key] == nil then
		local base = Config.HallowsData.data_skill_up_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.HallowsData.data_skill_up_cache[key] = {
			lose = base[1],
			skill_bid = base[2],
			lev_limit = base[3],
		}	end
	return Config.HallowsData.data_skill_up_cache[key] 
end
