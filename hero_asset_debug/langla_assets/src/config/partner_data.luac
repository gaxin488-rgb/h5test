   [405142] = [[{405142, TI18N("Trương Liêu (169 Năm —222 Năm )") TI18N("Một vị tướng nổi tiếng của Tào Ngụy cuối thời Hán và thời Tam Quốc, hậu duệ của Nhiếp Nghị"), TI18N("hỏa long dsgame"), {{-70,181}}, 90}]],
[505042] = [[{505042, "Vị diện chi chủ", "Đường Hạo", "Đường Hạo là Hạo Thiên Tông tông chủ nhi tử, tông chủ người thừa kế, được vinh dự Hạo Thiên Tông đệ nhất kỳ tài", {{80,250}}, 40}]],
[50523] = [[{50523, "U lê máu võ", "Tộc trưởng bộ tộc Cửu Lê chỉ có thể chết chứ không thể đầu hàng.", "\nVà tất cả những điều này chỉ là vì tôi đã sử dụng bóng tối để tạo ra thứ mà họ gọi là quái vật", {{111,48}}, 50}]],
    [50524] = [[{50524, TI18N("Nữ thần Thỏ"), TI18N("Những kẻ yếu đuối như các ngươi không có lý do để tồn tại trên thế giới"), TI18N("hỏa long dsgame"), {{-70,181}}, 90}]],
	[20528] = [[{20528, "Chim sẻ rạng đông", "Dậy lúc bình minh và đứng mãi mãi", "Ngọn lửa đỏ ở Nam Minh Viễn luôn cháy, qua nhiều năm đã sinh ra một loài chim thần, tên là Chu Tước", {{80,60}}, 50}]],
	[50525] = [[{50525, "Chúa tể tội lỗi sâu thẳm", "Bọn họ nói ta là  Tội nhân , đem ta trục xuất Thánh Sơn", "Hoachi.xyz", {{225,75}}, 55}]],
[50526] = [[{50526, "Võ Thánh", "Quan Vũ, chữ Vân Trường", "cuối thời Đông Hán danh tướng,cùng Trương Phi cùng nhau được xưng là một đấu một vạn. Lúc đầu đi theo Lưu Bị trằn trọc các nơi, từng bị Tào Tháo bắt sống, tại bạch mã chém giết Viên Thiệu Đại tướng Nhan Lương, sau trở về Lưu Bị.", {{20,70}}, 65}]],
[20522] = [[{20522, "Ngọc thải liên tâm", "Vì thế gian vạn vật mà sinh", "haitacdsgame.mobi", {{10,60}}, 50}]],
