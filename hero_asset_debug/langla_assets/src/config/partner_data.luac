	[40401] = [[{40401, TI18N("语言_par_11_52"), TI18N("语言_par_11_131"), TI18N("语言_par_11_210"), {{-20,50}}, 80, 42}]],
	[40301] = [[{40301, "", "", "", {{-20,50}}, 80, 25}]],
	[30514] = [[{30514, TI18N("语言_par_11_305141"), TI18N("语言_par_11_30514"), TI18N("语言_par_11_305143"), {{-20,50}}, 80, 113}]],
	[30515] = [[{30515, TI18N("语言_par_11_305151"), TI18N("语言_par_11_305152"), TI18N("语言_par_11_305153"), {{-20,50}}, 80}]],
	[160502] = [[{160502, TI18N("natsu"), TI18N("Hỏa long truyền kỳ"), TI18N("Hỏa long truyền kỳ"), {{-70,181}}, 90}]],
	[30516] = [[{30516, TI18N("fenyx"), TI18N("Hỏa long truyền kỳ dsgame"), TI18N("Hỏa long truyền kỳ dsgame"), {{96,104}}, 55}]],
	[30517] = [[{30517, TI18N("kungfu panda"), TI18N("Hỏa long truyền kỳ dsgame"), TI18N("Hỏa long truyền kỳ dsgame"), {{0,0}}, 55}]],
	[15016] = [[{15016, TI18N("Magic Siren Song"), TI18N("Muốn nghe tôi hát không"), TI18N("Hỏa long truyền kỳ dsgame"), {{40,0}}, 65}]],
	[70505] = [[{70505, TI18N("Boruto Momoshiki Ego"), TI18N("Boruto Momoshiki Ego"), TI18N("Boruto Momoshiki Ego"), {{-20,50}}, 80}]],
	[60538] = [[{60538, "<OTSUTSUKI CLAN>", "You think I\'m helpless without chakra?", "As Koji continued his attack while Isshiki fully unleashed his Kāma, he eventually caught Jigen off-guard, summoning a giant wall of flames. As Jigen failed to absorb them, Koji explained that he summoned naturally occurring flames void of chakra, meaning the mark was powerless before it as the flames began to consume him. Jigen tried to shrink the flames, but he could not maintain it for long due to his body reaching its limits. As Jigen\'s body was killed, and Kawaki\'s Kāma had yet to fully decompress, Isshiki was forced to fully reincarnate using Jigen as an imperfect vessel.", {{30,50}}, 60}]],
[60541] = [[{60541, "Otsutsuki Clan", "", "", {{30,50}}, 60}]],
[60548] = [[{60548, "Hoa Đà", "", " quê cũ tiêu huyện đột nhiên xuất hiện một vị thần bí thầy thuốc,  thế nhân giai truyền làm Hoa Đà mang theo oán niệm thi giải thành tiên biến thành.", {{0,0}}, 100}]],
	[30524] = [[{30524, "", "Chính là bởi vì có khiếm khuyết và thất bại, chúng ta mới có thể đứng lên,thực lực này mới là thực lực chân chính", "Một ninja đến từ Làng Lá ở Hỏa Quốc, cô là con gái cả của Hyuga Hiashi, người đứng đầu gia tộc Hyuga nổi tiếng của Konoha và là một trong những hậu duệ của Otsutsuki Hamura. Cô ấy là một cô gái có tính cách khá yếu đuối. Cuối cùng cô trở thành vợ của Naruto và có một con trai và một con gái.", {{0,0}}, 100}]],
	[30525] = [[{30525, "long ảnh", "Nhân thế ngàn năm, bất quá chỉ là một cái chớp mắt mà thôi", {{0,0}}, 55}]],
[30526] = [[{30526, TI18N("Orochimaru: Bát Đại Kỳ Xà"), TI18N("语言_par_11_405152"), TI18N("语言_par_11_405153"), {{-20,50}}, 80, 153, 0}]],
	[30528] = [[{30528, "Cướp sát thiền hổ", "Nghiệp Hỏa thiêu tẫn ba ngàn niệm, lại nghe hổ khiếu trấn sơn hà", "1, \n Ta quỳ gối bậc đá xanh lúc trước, đàn hương chính tràn qua chùa mái hiên nhà", {{0,0}}, 100, {}}]],
   [40522] = [[{40522, TI18N("Sage Toad"), TI18N("Với bầu trời làm nền và đầu ngẩng cao, một anh hùng thực sự không ai khác ngoài Jiraiya"), TI18N("hỏa long dsgame"), {{-70,181}}, 90}]],

   [30572] = [[{30572, TI18N("Sứ giả Côn Lôn"), TI18N("hỏa long dsgame"), TI18N("hỏa long dsgame"), {{-70,181}}, 90}]],
[60542] = [[{60542, TI18N("Hokage Bóng Tối"), TI18N("Nếu không có anh ấy, tôi là người duy nhất có thể bảo vệ ngôi làng"), TI18N("Sasuke Uchiha là người kế thừa của gia tộc Uchiha. Mắt phải của anh là Sharingan, và mắt trái của anh là Rinnegan. Anh là bạn và đối thủ của Naruto Uzumaki, và anh đã phá vỡ mảnh thiên thạch rơi xuống Konohagakure khi Naruto vắng mặt"), {{-20,50}}, 80, 137, 0}]],
[80531] = [[{80531, "ta yêu thiên nhiên", "ta yêu cả gái đẹp", "hoalongtruyenky", {{20,70} }, 65}]],
[80533] = [[{80533, "broly", "ta cần kiếm songoku", "hoalongtruyenky", {{20,70} }, 65}]],
[60514] = [[{60514, "Nguồn gốc Làng lá", "Thủ lĩnh gốc rễ của Làng Lá trong Hỏa Quốc, một trong những cao thủ của Làng Lá, người hạ lệnh diệt Tộc Uchiha, thực lực siêu phàm, giỏi nhẫn thuật Futon. Bị Sasuke đánh bại trong trận chiến với Uchiha Sasuke, để bảo vệ con mắt của Shisui, anh đã dùng thuật phong ấn tứ tượng để tự sát", "hoalongtruyenky", {{20,70} }, 65}]],
	[30513] = [[{30513, TI18N("语言_par_11_305131"), TI18N("语言_par_11_30513"), TI18N("语言_par_11_305133"), {{-20,50}}, 80, 110}]],
