	[50301] = [[{50301, "", "", "", {}, 0, 26}]],
	[61544] = [[{61544, "Sasuke: Final Valley made in hoachi.xyz", "made in hoachi.xyz", "Sasuke: Final Valley made in hoachi.xyz", {{30,50}}, 60}]],
	 [60501] = [[{60501, TI18N("ZORO WANO"), TI18N("ta đã rửa tay gác kiếm quy ẩn tại làng lá , lấy pháp danh THÍCH ĐÁNH LỘN, hoalongtruyenky"), TI18N("hoalongtruyenky"),{{-25,80}}, 65}]],
	 [60503] = [[{60503, TI18N("Law WANO"), TI18N("nghe nói làng lá có mấy khứa từ elora tràn qua xâm chiếm, mình phải qua gạ solo kiếm sẹo mới đc, hoalongtruyenky"), TI18N("hoalongtruyenky"),{{-25,80}}, 65}]],
	[70522] = [[{70522, TI18N("kingkong"), TI18N("rừng núi là cha, sông suối là mẹ, kẻ nào phá cha mẹ ta , sẽ là kẻ thù của ta"), TI18N("kingkong"), {{25,0}}, 45}]],
	[70516] = [[{70516, TI18N("kỳ lân"), TI18N("xuất hiện trong truyền thuyết thượng cổ , được admin MRsơn đưa vào làng lá để chế ngự các thế lực hắc ám "), TI18N("kỳ lân"), {{20,70}}, 65}]],
	[70521] = [[{70521, TI18N("cửu sắc thần nữ"), TI18N("Người ta nói rằng có một ngôi chùa Linglong ở núi Qixia, trong đó có một nữ thần có sức mạnh của lời nói, chỉ cần cô ấy hứa, cô ấy nhất định sẽ thành hiện thực "), TI18N("hoalongtruyenky"), {{25,0}}, 45}]],
	[40515] = [[{40515, TI18N("语言_par_11_405151"), TI18N("语言_par_11_405152"), TI18N("语言_par_11_405153"), {{-20,50}}, 80,119}]],
	[405111] = [[{405111, "Diệu thế tinh tiễn", "Mũi tên của tôi có thể xuyên qua mọi bóng tối。", "Nhân mã là một chủng tộc gồm những con thú nửa người có nửa thân trên giống hình người và nửa thân dưới giống ngựa. Chúng có thân hình khỏe mạnh và chạy giỏi.", {{-55,40}}, 55}]],
     [40521] = [[{40521, TI18N("phi ưng"), TI18N("hỏa long dsgame"), TI18N("hỏa long dsgame"), {{-70,181}}, 90}]],
	 [40523] = [[{40523, TI18N("凯[八门]"), TI18N("hoalongtruyenky"), TI18N("hoalongtruyenky"), {{0,30}}, 70}]],
	[10520] = [[{10520, "Uông Dương Bá Chủ", "Đại dương vô tận và tăm tối, còn ta thì đáng sợ hơn cả đại dương", "Đại dương và lục địa là hai thế giới hoàn toàn khác biệt. Ma Kình Vương chưa bao giờ tò mò về những chuyện bên ngoài biển cả, lục địa khô khốc và tẻ nhạt, còn con người trên đó lại luôn thích đấu đá lẫn nhau. Cô không nhớ mình đã sống bao lâu, còn con mắt trái bị tổn thương chính là dấu ấn để lại từ lần thách thức Hải Thần đời trước.\nSự thay đổi bắt đầu từ một lần 'kình lạc' (cá voi chết đi), từng tộc nhân một ra đi, Ma Kình Vương đã thốt lên tiếng gầm nhọn hoắt nhất đời mình: 'Ta lấy danh nghĩa đại dương thề rằng: Nhân loại làm hại tộc Ma Kình, bất kể là ai, ta tuyệt đối không tha thứ một kẻ nào!' Vì Thâm Hải Ma Kình Vương mà đại dương vạn dặm sóng xanh bỗng chốc nhuốm đỏ.\nCuộc chiến giữa tộc Ma Kình và nhân loại vùng ven biển không hồi kết, càng nhiều kình lạc lại càng tích tụ thêm nhiều hận thù... Cuối cùng ngay cả Hải Thần cũng không cầm lòng được, khuyên Thâm Hải Ma Kình Vương dừng tay. 'Hải Thần thì sao? Ngươi là Hải Thần, không bảo vệ tộc loại, ngược lại còn đi cầu xin cho người trên cạn, thật là vô liêm sỉ! Ngôi vị Hải Thần này thà để ta ngồi còn hơn!' Thâm Hải Ma Kình Vương đã trở thành truyền thuyết, cô là bá chủ vùng biển, là tồn tại gần nhất với 'Hồn Thú Cộng Chủ Thần Long' trong truyền thuyết, là nỗi sợ hãi, là cái chết, là sự hủy diệt, là bóng ma ám ảnh của tất cả nhân loại ven biển.\nĐại dương không có chiến tranh thật tĩnh lặng và tươi đẹp, khiến Ma Kình Vương nhớ về quãng thời gian rất lâu trước đây, khi cô và tộc nhân cùng nhau dệt nên những khúc ca. Sau bao lâu, cô bắt đầu ngâm nga, nhưng luôn cảm thấy có gì đó không đúng. Phải rồi, không có sự hợp xướng của đàn cá voi. Đến cuối cùng, Thâm Hải Ma Kình Vương trở thành một vị vua không có thần dân, một kẻ mồ côi không có thân tộc, là con Ma Kình cuối cùng, chỉ có Võ Hồn làm bạn, và đây vốn dĩ không phải là tâm nguyện của cô.\nĐể thấu hiểu được đạo lý đơn giản này, cô đã phải trả giá bằng biết bao nhiêu sự hy sinh.", {{0,0}}, 100, {}}]],

	[40520] = [[{40520, TI18N("Chế Độ Rikudou"), TI18N("Tôi sẽ trở thành Hokage vĩ đại nhất từng có! Đó là ước mơ của tôi!"), TI18N("Naruto vào chế độ mới sau khi nhận được một phần chakra của các Beasts từ Một Tailed đến Tám-Tailed, cáo Chín Tailed Yin, và Sức mạnh Sage của Jinchuriki Ten-Tails, cũng như chakra và sức mạnh Yang của Sage Six Paths. Anh có thể sử dụng nhiều sức mạnh ma thuật như Six Paths Senjutsu, Sức mạnh Yang và Sức mạnh Beast Tail, và sức chiến đấu của anh vượt trội hơn các chế độ khác"), {{-65,40}}, 100, 140, 0}]],
		[10529] = [[{10529, "Huyền băng phù hộ hồn", "Quá khứ ân oán ta chưa từng quên,", "Hiss...\nChúng ta là những con thú kỳ lạ được sinh ra từ năng lượng tâm linh của trời đất, và chúng ta nên thuận theo bản chất của mình", {{0,0}}, 100}]],
[40525] = [[{40525, "Lưu Ly Nguyệt tiên", "Chúng ở nhân gian nói trên trời, không biết trên trời ức nhân gian", "1\n eloradsgame ", {{20,70}}, 65}]],
[40925] = [[{40925, TI18N("Minato: Hỏa Ảnh Tiên Pháp"), TI18N(""), TI18N(""), {{0,0}}, 100, 153, 0}]],
	 [40524] = [[{40524, TI18N("Hơi thở Lửa"), TI18N("Nếu là bạn, bạn chắc chắn sẽ có thể tìm ra câu trả lời"), TI18N("Một phiên bản độc đáo của Hokage thứ tư, phiên bản này là một kiếm sĩ sử dụng kỹ thuật thở, lấy cảm hứng từ một câu chuyện được kể bởi một du khách từ thế giới khác."), {{0,0}}, 100, 152, 0}]],
	 [40526] = [[{40526, TI18N("Cửu Thần Thú: Chân Long"), TI18N("Ta là Ứng Long, vị võ thần đầu tiên dưới thời Hoàng Đế, và ta ở đây để giúp đỡ."), TI18N("Vùng đất hoang tàn này chính là Đại Hoang mạc."), {{20,0}}, 65}]],
