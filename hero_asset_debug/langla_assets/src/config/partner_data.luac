Config.PartnerData.data_partner_star_length = 1036
Config.PartnerData.data_partner_star_cache = {}
Config.PartnerData.data_partner_star = function(key)
	if Config.PartnerData.data_partner_star_cache[key] == nil then
		local base = Config.PartnerData.data_partner_star_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerData.data_partner_star_cache[key] = {
			bid = base[1],
			star = base[2],
			res_id = base[3],
			head_id = base[4],
			add_hp = base[5],
			add_atk = base[6],
			add_def = base[7],
			add_speed = base[8],
			attr = base[9],
			expend1 = base[10],
			expend2 = base[11],
			expend3 = base[12],
			other_expend = base[13],
			skills = base[14],
			lev_max = base[15],
			is_show = base[16],
			is_show_pokedex = base[17],
			attr_show = base[18],
			show_effect = base[19],
			fight_effect = base[20],
			source = base[21],
		}
	end
	return Config.PartnerData.data_partner_star_cache[key] 
end
