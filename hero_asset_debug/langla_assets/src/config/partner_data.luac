Config.PartnerData.data_partner_library_length = 113
Config.PartnerData.data_partner_library_cache = {}
Config.PartnerData.data_partner_library = function(key)
	if Config.PartnerData.data_partner_library_cache[key] == nil then
		local base = Config.PartnerData.data_partner_library_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerData.data_partner_library_cache[key] = {
			bid = base[1],
			title = base[2],
			voice_str = base[3],
			story = base[4],
			draw_offset = base[5],
			scale = base[6],
			order = base[7],
		}
	end
	return Config.PartnerData.data_partner_library_cache[key] 
end
