[70539] = [[{70539, "Sức Mạnh Lời Nguyền", "Ngon thì nhào vô kiếm sẹo", "Ngon thì nhào vô kiếm sẹo", {{0,0}}, 50}]],
[50927] = [[{50927, TI18N("Sức mạnh hủy diệt"), TI18N("Gầm——————!!!"), TI18N("Chứng kiến ​​Hinata ngã gục trước mắt, cơn giận dữ và lòng căm thù tột độ của Naruto đã phá vỡ phong ấn. Ý thức của cậu bị chakra của Cửu Vĩ nuốt chửng, lập tức giải phóng Tứ Vĩ và tiến hóa thành Lục Vĩ. Luồng Chakra đáng sợ đó hiện hình thành một chiếc áo choàng yêu hồ màu đỏ, từ đó trấn áp Pain"), {{0,0}}, 100, 153, 0}]],
[50529] = [[{50529, TI18N("Bất tử bất diệt"), TI18N("Có thể tìm thêm cho tôi một chút niềm vui không?"), TI18N("Chứng kiến ​​sự mong manh của cuộc sống trong chiến tranh, Orochimaru nảy sinh nỗi ám ảnh cuồng tín về sự bất tử. Trong hành trình tìm kiếm chân lý của thế giới, hắn bị ám ảnh bởi những thí nghiệm cấm kỵ, và sau khi bị người thầy phát hiện, hắn kiên quyết rời bỏ làng Lá. Sau khi gia nhập tổ chức Akatsuki, con mắt tả luân nhãn toàn năng của Itachi Uchiha đã khơi dậy lòng tham của hắn. Để chiếm đoạt vật chứa hoàn hảo này, cuối cùng hắn đã không kìm dã tâm của mình và tung ra những chiếc răng nanh độc hại tấn công Itachi từ phía sau"), {{-20,50}}, 80, 154, 0}]],
[40927] = [[{40927, TI18N("Sức mạnh hủy diệt"), TI18N("Gầm——————!!!"), TI18N("Chứng kiến ​​Hinata ngã gục trước mắt, cơn giận dữ và lòng căm thù tột độ của Naruto đã phá vỡ phong ấn. Ý thức của cậu bị chakra của Cửu Vĩ nuốt chửng, lập tức giải phóng Tứ Vĩ và tiến hóa thành Lục Vĩ. Luồng Chakra đáng sợ đó hiện hình thành một chiếc áo choàng yêu hồ màu đỏ, từ đó trấn áp Pain"), {{0,0}}, 100, 153, 0}]],
[70547] = [[{70547, "Minh uyên song sinh", "Sinh tồn vẫn là hủy diệt , đây là một vấn đề.", "\nBị cả thần quốc lẫn minh giới ruồng bỏ vì đứng giữa ranh giới sinh và tử,kẻ mang quyền năng tử vong đã tự tay chôn vùi quá khứ của mình,dùng lưỡi hái tổ chức tang lễ cho chính bản thân. /nHoàng hôn của chư thần giáng xuống theo định mệnh không thể đảo ngược.Khi ánh sáng và bóng tối cùng suy tàn,Minh Quốc bước vào kỷ nguyên mới. /nGiữa sinh và tử, giữa hủy diệt và tân sinh,một ý chí cổ xưa thức tỉnh,và kẻ từng bị khước từ nay trở thànhchủ nhân mới của Minh Giới.", {{0,30}}, 70, {}}]],
