Config.UnitData1.data_unit1_length = 3510
Config.UnitData1.data_unit1_cache = {}
Config.UnitData1.data_unit1 = function(key)
	if Config.UnitData1.data_unit1_cache[key] == nil then
		-- ID 90001-95000 là unit ảo cho tầng 5001-10000.
		-- Mượn hình và đội hình của 500 tầng 4501-5000.
		local lookup_key = key
		if type(key) == "number" and key >= 90001 and key <= 95000 then
			lookup_key = 3051501 + ((key - 90001) % 500)
		end
		local base = Config.UnitData1.data_unit1_table[lookup_key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.UnitData1.data_unit1_cache[key] = {
			bid = key,
			name = base[2],
			multi_wave_monster = base[3],
			career = base[4],
			sex = base[5],
			type = base[6],
			sub_type = base[7],
			lev = base[8],
			body_id = base[9],
			talk = base[10],
			model_size = base[11],
			monster1 = base[12],
			monster2 = base[13],
			monster3 = base[14],
			monster4 = base[15],
			monster5 = base[16],
			formation = base[17],
		}
	end
	return Config.UnitData1.data_unit1_cache[key] 
end
