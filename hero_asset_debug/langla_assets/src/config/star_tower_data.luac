-- Tự sinh tầng 5001-10000 từ 500 tầng mẫu 4501-5000.
-- Mỗi tầng dùng một unit ảo riêng; độ khó tăng tuyến tính 0.1% mỗi tầng.
local function star_tower_copy(source)
	if type(source) ~= "table" then return source end
	local result = {}
	for key, value in pairs(source) do
		result[key] = star_tower_copy(value)
	end
	return result
end

local star_tower_base_recommend = Config.StarTowerData.data_tower_base[5000].recommend or 0
for floor = 5001, 10000 do
	local template_floor = 4501 + ((floor - 5001) % 500)
	local data = star_tower_copy(Config.StarTowerData.data_tower_base[template_floor])
	local factor = 10000 + (floor - 5000) * 10
	data.lev = floor
	data.name = TI18N("Tầng" .. floor)
	data.unit_id = 90001 + (floor - 5001)
	data.recommend = math.floor(star_tower_base_recommend * factor / 10000)
	Config.StarTowerData.data_tower_base[floor] = data
end

Config.StarTowerData.data_tower_base_fun = function(key)
	local data=Config.StarTowerData.data_tower_base[key]
	if DATA_DEBUG and data == nil then
		print('(Config.StarTowerData.data_tower_base['..key..'])not found') return
	end
	return data
end
-- -------------------tower_base_end---------------------


