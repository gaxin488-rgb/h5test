Config.ItemData3.data_unit_length = 840
Config.ItemData3.data_unit_cache = {}
Config.ItemData3.data_unit = function(key)
	if Config.ItemData3.data_unit_cache[key] == nil then
		local base = Config.ItemData3.data_unit_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.ItemData3.data_unit_cache[key] = {
			id = base[1],
			name = base[2],
			icon = base[3],
			type = base[4],
			sub_type = base[5],
			quality = base[6],
			overlap = base[7],
			gain_type = base[8],
			use_type = base[9],
			value = base[10],
			desc = base[11],
			lev = base[12],
			career = base[13],
			sex = base[14],
			eqm_set = base[15],
			eqm_star = base[16],
			ext = base[17],
			eqm_output_id = base[18],
			eqm_jie = base[19],
			is_effect = base[20],
			type_desc = base[21],
			can_share = base[22],
		}
	end
	return Config.ItemData3.data_unit_cache[key] 
end
