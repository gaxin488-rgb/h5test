HeroTipsPanel = HeroTipsPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort

function HeroTipsPanel:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_tips_panel"
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 

    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("hero", "hero"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist},
    }

    self.attr_list = {[1]="atk",[2]="hp",[3]="def",[4]="speed"}
    self.break_icon_list = {}
    self.break_icon_bg_list = {}

    -- Kỹ năng: thu nhỏ và giảm khoảng cách để 5 ô không tràn khỏi khung.
    self.skill_width = 70
    self.skill_item_scale = 0.56
    self.skill_item_spacing = 68
    -- Ô Năng lực là hình vuông lớn: cạnh bằng chiều cao của ô Kỹ năng
    -- phía trên (0.56 x 1.16 = 0.6496, làm tròn thành 0.65).
    self.talent_skill_item_scale = 0.65
    self.talent_skill_item_spacing = 81
    -- Toạ độ X cục bộ của ô Năng lực đầu tiên trong skill_node.
    -- Giá trị càng âm thì cả hàng càng sát sang trái.
    self.talent_skill_start_x = -32
    -- Dịch toàn bộ hàng Năng lực sang trái để các ô sát mép trái hơn
    -- và hạn chế ô cuối bị tràn khỏi khung.
    self.talent_skill_row_shift_left = 55

    -- Giữ nguyên chiều ngang hiện tại, chỉ kéo chiều dọc dài hơn một chút
    -- để ô kỹ năng có dạng hình chữ nhật đứng thay vì hình vuông.
    self.skill_item_vertical_stretch = 1.16
    self.talent_skill_item_vertical_stretch = 1.0
    self.skill_item_list = {}

    self.equip_type_list = HeroConst.EquipPosList

    self.equip_icon_name_list = {
        [BackPackConst.item_type.WEAPON] = "hero_info_7",  --武器icon
        [BackPackConst.item_type.SHOE] = "hero_info_10",  --鞋子icon
        [BackPackConst.item_type.CLOTHES] = "hero_info_9",  --衣服icon 
        [BackPackConst.item_type.HAT] = "hero_info_8",  --裤子icon
        [BackPackConst.item_type.ACCESSORY_1] = "hero_info_27", --饰品1icon
        [BackPackConst.item_type.ACCESSORY_2] = "hero_info_28", --饰品2icon
        [5] = "hero_info_11", --武器icon--神器
        [6] = "hero_info_11", --武器icon
    }   

													  
																						  
																				 
								  

															  
																								  
									 
																		   
													   
									  
								
								 
																								  
																						 
																							 
								   
							   
																  
								
														  
								   
																 
								  

    self.holy_equip_type_list = HeroConst.HolyequipmentPosList
    self.holy_equip_icon_name_list = {
        [BackPackConst.item_type.GOD_EARRING] = "hero_info_25",  --耳环
        [BackPackConst.item_type.GOD_RING] = "hero_info_27",  --戒指
        [BackPackConst.item_type.GOD_NECKLACE] = "hero_info_26",  --项链
        [BackPackConst.item_type.GOD_BANGLE] = "hero_info_28",  --手镯
    }
																							 
																	
											   
							 
							 
							 
							 
								 
								 
								 
								 
	 
end

function HeroTipsPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
        -- self.background:setSwallowTouches(false)
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.box_bg = self.main_panel:getChildByName("box_bg")  
    self.box_bg_1 = self.main_panel:getChildByName("box_bg_1")  
    self.title_icon = self.main_panel:getChildByName("title_icon")  
    if self.box_bg_1 then
        self.box_bg_1:setVisible(false)
    end
    if self.title_icon then
        self.title_icon:setVisible(false)
    end
    self.top_panel = self.main_panel:getChildByName("top_panel")  

    self.hero_node = self.top_panel:getChildByName("hero_node")
    self.hero_item = HeroExhibitionItem.new(0.8, false)
    self.hero_node:addChild(self.hero_item)

    self.hero_name = self.top_panel:getChildByName("hero_name")

    self.advanced_node = self.top_panel:getChildByName("advanced_node")
    self.score_image = self.top_panel:getChildByName("score_image")
    --战力    
    self.power_click = self.top_panel:getChildByName("power_click")
    local arrow_bg = self.power_click:getChildByName("arrow_bg")
    self.fight_label = CommonNum.new(20, self.power_click, 99999, - 2, cc.p(0, 0.5))
    self.fight_label:setPosition(arrow_bg:getPositionX() + arrow_bg:getContentSize().width/2, 28) 

    --按钮
    self.comment_btn = self.top_panel:getChildByName("comment_btn")
    self.look_btn = self.top_panel:getChildByName("look_btn")

    --属性信息
    local attr_panel = self.top_panel:getChildByName("attr_panel")
    self.attr_icon_list = {}
    self.attr_icon_list[1] = attr_panel:getChildByName("attr_icon1")
    self.attr_icon_list[2] = attr_panel:getChildByName("attr_icon2")
    self.attr_icon_list[3] = attr_panel:getChildByName("attr_icon3")
    self.attr_icon_list[4] = attr_panel:getChildByName("attr_icon4")

    self.attr_label_list = {}
    self.attr_label_list[1] = attr_panel:getChildByName("attr_label1")
    self.attr_label_list[2] = attr_panel:getChildByName("attr_label2")
    self.attr_label_list[3] = attr_panel:getChildByName("attr_label3")
    self.attr_label_list[4] = attr_panel:getChildByName("attr_label4")

    self.top_panel:getChildByName("advancedKey"):setString(TI18N("语言_c_855"))


    self.skill_container = self.top_panel:getChildByName("scroll_view")
    self.skill_container:setScrollBarEnabled(false)
    self.skill_container:setTouchEnabled(false)

    -- Cho phép icon kỹ năng vẽ ra phần nền đen hai bên của ScrollView.
    -- Nếu giữ clipping, mọi phần nằm ngoài khung scroll_view sẽ bị cắt dù
    -- bên ngoài vẫn còn khoảng trống nhìn thấy trong cửa sổ.
    if self.skill_container.setClippingEnabled then
        self.skill_container:setClippingEnabled(false)
    end
    self.skill_container_size = self.skill_container:getContentSize()

    self.skill_key = self.top_panel:getChildByName("skill_key")
    self.skill_key:setString(TI18N("语言_c_3204"))
    self.box_bg = self.main_panel:getChildByName("box_bg")

    self.equip_panel = self.main_panel:getChildByName("equip_panel")

    self.equip_node_list = {}
    for i=1,8 do
        self.equip_node_list[i] = self.equip_panel:getChildByName("equip_node"..i)
        -- CSB gốc chỉ có equip_node1~6. Tạo thêm equip_node7/8 cho 2 slot phụ kiện.
        if self.equip_node_list[i] == nil and (i == 7 or i == 8) then
            local node = ccui.Widget:create()
            node:setName("equip_node"..i)
            node:setContentSize(cc.size(1, 1))
            self.equip_panel:addChild(node)
            self.equip_node_list[i] = node
        end
    end

    self.holy_equip_node_list = {}
														   
    for i=1,4 do
        self.holy_equip_node_list[i] = self.equip_panel:getChildByName("holy_equip_node_"..i) 
															   

																					 
																		 
						   
									   
								   
											  
										   
		   
										   
    end

    self:layoutEquipNodeGrid3x4()

    self.btn_goto = self.main_panel:getChildByName("btn_goto")
    if self.btn_goto then
        self.btn_goto:getChildByName("label"):setString(TI18N("语言_c_3205"))
    end
end


-- Bố cục 3 hàng x 4 ô:
-- Hàng 1: 4 trang bị thường cũ
-- Hàng 2: 2 phụ kiện mới + 2 thần khí
-- Hàng 3: 4 cao trang / thần trang
							
function HeroTipsPanel:layoutEquipNodeGrid3x4()
    if not self.equip_panel or not self.equip_node_list then return end
    local n = self.equip_node_list
    if not n[1] or not n[2] or not n[3] or not n[4] or not n[5] or not n[6] or not n[7] or not n[8] then return end
														
			  
	   

														   

    -- Xoá nền/lock thừa nằm sẵn trong CSB, tránh sinh ra 2 ô bị đè lên item.
    -- BackPackItem bên dưới sẽ tự tạo khung trống mới, nên xoá children gốc là an toàn.
    self._equip_node_cleaned = self._equip_node_cleaned or {}
    local function cleanNode(index)
        local node = n[index]
        if node and not self._equip_node_cleaned[index] then
            node:removeAllChildren()
            self._equip_node_cleaned[index] = true
        end
    end
    for i = 1, 8 do
        cleanNode(i)
    end

    self._holy_node_cleaned = self._holy_node_cleaned or {}
    for i = 1, 4 do
        local node = self.holy_equip_node_list and self.holy_equip_node_list[i]
        if node and not self._holy_node_cleaned[i] then
            node:removeAllChildren()
            self._holy_node_cleaned[i] = true
        end
    end

    -- Ẩn thêm các nền/khóa thần khí nếu CSB đặt chúng ngoài equip_node5/6.
    local hide_names = {
        "artifacts_bg_1", "artifacts_bg_2", "artifact_bg_1", "artifact_bg_2",
        "img_lock5", "img_lock6", "lab_lock5", "lab_lock6",
        "img_lock_1", "img_lock_2", "lab_lock_1", "lab_lock_2",
        "lock5", "lock6", "lock_5", "lock_6"
    }
    for _, name in ipairs(hide_names) do
        local child = self.equip_panel:getChildByName(name)
        if child then
            child:setVisible(false)
        end
    end

    -- Lấy 4 cột theo hàng cao trang nếu có, vì hàng này trong CSB thường đã căn đều.
    local x_list = {}
    for i = 1, 4 do
        local holy_node = self.holy_equip_node_list and self.holy_equip_node_list[i]
        if holy_node then
            x_list[i] = holy_node:getPositionX()
        end
    end
    if not x_list[1] or not x_list[2] or not x_list[3] or not x_list[4] then
        local size = self.equip_panel:getContentSize()
        local width = size and size.width or 420
        local start_x = width * 0.20
        local end_x = width * 0.80
        local gap = (end_x - start_x) / 3
        for i = 1, 4 do
            x_list[i] = start_x + gap * (i - 1)
        end
    end

    local function avgY(list, default_y)
        local sum = 0
        local count = 0
        for _, node in ipairs(list) do
            if node then
                sum = sum + node:getPositionY()
                count = count + 1
            end
        end
        if count > 0 then return sum / count end
        return default_y or 0
    end

								  
				   
    local row3_y = avgY(self.holy_equip_node_list or {}, 0)
	   

											   
    local row1_y = avgY({n[1], n[2]}, row3_y + 140)
    local row2_y = avgY({n[3], n[4]}, (row1_y + row3_y) * 0.5)

    -- Cho khoảng cách giữa các hàng bằng đúng khoảng cách giữa các cột.
    -- Vì các ô trang bị có cùng kích thước/scale, dùng cùng khoảng cách tâm
    -- sẽ tạo khoảng trống ngang và dọc cân nhau như một lưới vuông.
    local column_gap_sum = 0
    local column_gap_count = 0
    for i = 1, 3 do
        if x_list[i] and x_list[i + 1] then
            column_gap_sum = column_gap_sum + math.abs(x_list[i + 1] - x_list[i])
            column_gap_count = column_gap_count + 1
        end
    end
											 
    local grid_gap = column_gap_count > 0 and (column_gap_sum / column_gap_count) or 76

    -- Giữ nguyên tâm của cả cụm 3 hàng, chỉ giãn đều lên và xuống.
																							  
    local top_is_bigger = row1_y > row3_y
    local direction = top_is_bigger and 1 or -1
    local grid_center_y = (row1_y + row2_y + row3_y) / 3
    row2_y = grid_center_y
																	
    row1_y = grid_center_y + direction * grid_gap
																 
    row3_y = grid_center_y - direction * grid_gap
												

    local function setPos(node, x, y)
        if node then node:setPosition(cc.p(x, y)) end
    end

    -- Hàng 1: 4 trang bị thường cũ
    setPos(n[1], x_list[1], row1_y)
    setPos(n[2], x_list[2], row1_y)
    setPos(n[3], x_list[3], row1_y)
    setPos(n[4], x_list[4], row1_y)

    -- Hàng 2: phụ kiện 1, phụ kiện 2, thần khí 1, thần khí 2
    setPos(n[7], x_list[1], row2_y)
    setPos(n[8], x_list[2], row2_y)
    setPos(n[5], x_list[3], row2_y)
    setPos(n[6], x_list[4], row2_y)

    -- Hàng 3: 4 cao trang / thần trang
																										  
															  
													  
												
											  
																   

								
    for i = 1, 4 do
        setPos(self.holy_equip_node_list and self.holy_equip_node_list[i], x_list[i], row3_y)
    end

								
				   
			   
																	   
						  
				  
		 
	   

																								
																				  
   

													
									  

										   
															   
	   
										
														  
	   

												
												   
																						

											  
															 
end


function HeroTipsPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn) ,false, 1)
    registerButtonEventListener(self.comment_btn, function() self:onClickCommentBtn()  end ,true, 2, nil , 0.8)
    registerButtonEventListener(self.look_btn, function() self:onClickLookBtn() end ,true, 2, nil, 0.8)
    registerButtonEventListener(self.btn_goto, function() self:onClickGotoBtn() end ,true, 2)

    self:addGlobalEvent(HeroEvent.Del_Hero_Event, function(list)
        if self.hero_vo then
            for i,v in ipairs(list) do
                if self.hero_vo.partner_id == v.partner_id then
                    self:onClickCloseBtn()
                end
            end
        end
    end)

    self:addGlobalEvent(HeroEvent.Hero_Get_Talent_Event, function()
        if self.hero_vo then
            self:updateTalent(self.hero_vo)
        end
    end)
end

--评论
function HeroTipsPanel:onClickCommentBtn()
    if not self.hero_vo then return end
    PokedexController:getInstance():openCommentWindow(true, self.hero_vo)
end

--关闭
function HeroTipsPanel:onClickCloseBtn()
    controller:openHeroTipsPanel(false)
end

function HeroTipsPanel:onClickLookBtn()
    if not self.hero_vo then return end 
    controller:openHeroTipsAttrPanel(true, self.hero_vo)
end

--前往更换英雄
function HeroTipsPanel:onClickGotoBtn()
    if not self.hero_vo then return end 
    RoleController:getInstance():openRoleHeroShowFormPanel(true)
    self:onClickCloseBtn()
end

-- @setting.is_hide_equip 是否隐藏装备 
-- @setting.is_show_form_btn 是否显示更换英雄按钮(目前只有一个地方传这个按钮..如果有多.需改成支持多个的方式 --by lwc)
-- 如果显示更换英雄按钮..必须is_hide_equip = false
function HeroTipsPanel:openRootWnd(hero_vo, setting)
    if not hero_vo then return end
    self.hero_vo = hero_vo
    local config = Config.PartnerData.data_partner_base[hero_vo.bid]
    if not config then return end

    local score = controller:getModel():heroBidScore(hero_vo.bid)
    local path = string.format("partner_rarity_%s", score)
    local src =  PathTool.getResFrame('partnersummon', path,false)
    self.score_image:loadTexture(src,LOADTEXT_TYPE_PLIST)

    local setting = setting or {}
    local is_hide_equip = setting.is_hide_equip or false
    local is_show_form_btn = setting.is_show_form_btn or false
    --背景框--超过13星就显示特殊背景
    -- if hero_vo.star and hero_vo.star >= 13 then
    --     if self.box_bg_1 then
    --         self.box_bg_1:setVisible(true)
    --     end
    --     if self.title_icon then
    --         self.title_icon:setVisible(true)
    --     end 
    --     self.box_bg:setVisible(false)
    -- end

    --头像
    self.hero_item:setData(hero_vo)

    --名字
    self.hero_name:setString(config.name)

    --战斗力
    local power = hero_vo.power or 0
    self.fight_label:setNum(power)

    --进阶
    self:updateAdvanceInfo(hero_vo)

    --属性icon
    for i,attr_str in ipairs(self.attr_list) do
        if self.attr_icon_list[i] then
            local res_id = PathTool.getAttrIconByStr(attr_str)
            local res = PathTool.getResFrame("common",res_id)
            loadSpriteTexture(self.attr_icon_list[i], res, LOADTEXT_TYPE_PLIST)   
        end

        if self.attr_label_list[i] then
            local value = hero_vo[attr_str] or 0
            self.attr_label_list[i]:setString(value)
        end
    end

    local key = getNorKey(config.type, config.break_id, hero_vo.break_lev)
    local break_config = Config.PartnerData.data_partner_brach[key]
    self:initSkill(hero_vo, break_config)

    --隐藏装备
    if is_hide_equip then
        self.equip_panel:setVisible(false)
        local size = self.box_bg:getContentSize()
        self.box_bg:setContentSize(cc.size(size.width, 370))
        self.main_panel:setPositionY(670)
    else
        self:updateEquip(hero_vo)

        --天赋
        local skill_key = self.equip_panel:getChildByName("skill_key")
        skill_key:setString(TI18N("语言_c_47"))
        
        self:updateTalent(hero_vo)

        --神装
        local holy_key = self.equip_panel:getChildByName("holy_key")
        holy_key:setString(TI18N("语言_c_3206"))

        self:updateHolyEquip(hero_vo)
        if is_show_form_btn then
            self.btn_goto:setVisible(true)
            local size = self.box_bg:getContentSize()
            self.box_bg:setContentSize(cc.size(size.width, 872))
        end
										  
    end
end

--更新进阶显示
function HeroTipsPanel:updateAdvanceInfo(hero_vo)
    local max_count = model:getHeroMaxBreakCountByInitStar(hero_vo.star)
    local star_width = 27 + 8
    local break_count = hero_vo.break_lev or 0
    if model:isResonateCystalHero(hero_vo) then
        break_count = hero_vo.resonate_break_lev or 0
    end

    local x = 0
    for i,v in ipairs(self.break_icon_list) do
        v:setVisible(false)
    end
    for i=1,max_count do
        if i <= break_count then
            if not self.break_icon_list[i] then
                local res = PathTool.getResFrame("tips","tips_12")
                local star = createSprite(res, x + (i-1)*star_width, 0, self.advanced_node, cc.p(0,0.5), LOADTEXT_TYPE_PLIST, 1)
                -- star:setScale(0.6)
                self.break_icon_list[i] = star
            else
                self.break_icon_list[i]:setVisible(true)
            end
            
            if self.break_icon_bg_list[i] then
                self.break_icon_bg_list[i]:setVisible(false)
            end
        else
            if self.break_icon_list[i] then
                self.break_icon_list[i]:setVisible(false)
            end
            if not self.break_icon_bg_list[i] then
                local res = PathTool.getResFrame("tips","tips_13")
                local star = createSprite(res, x + (i-1)*star_width, 0, self.advanced_node, cc.p(0,0.5), LOADTEXT_TYPE_PLIST, 0)
                -- star:setScale(0.6)
                self.break_icon_bg_list[i] = star
            else
                self.break_icon_bg_list[i]:setVisible(true)
            end
        end
    end
end

-- Kéo riêng chiều dọc của SkillItem, không làm thay đổi chiều ngang.
-- Lưu scale gốc để việc refresh dữ liệu nhiều lần không bị kéo dài chồng lên nhau.
function HeroTipsPanel:applyVerticalSkillShape(item, stretch_y)
    if not item then return end

    local target = item
    if item.getRoot then
        local ok, root = pcall(function() return item:getRoot() end)
        if ok and root then
            target = root
        end
    end

    if not target.setScaleX or not target.setScaleY then return end

    if item._vertical_shape_base_scale_x == nil then
        item._vertical_shape_base_scale_x = target.getScaleX and target:getScaleX() or 1
        item._vertical_shape_base_scale_y = target.getScaleY and target:getScaleY() or 1
    end

    target:setScaleX(item._vertical_shape_base_scale_x)
    target:setScaleY(item._vertical_shape_base_scale_y * (stretch_y or 1.16))
end

function HeroTipsPanel:initSkill(hero_vo, break_config)
    if not break_config then return end
    local key = getNorKey(hero_vo.bid, hero_vo.star)
    local star_config = Config.PartnerData.data_partner_star(key)
    if star_config == nil then return end

    local skill_list = {}
    for i,v in ipairs(star_config.skills) do
        -- 不是普通攻击 1表示普通攻击
        if v[1] ~= 1 then
            table_insert(skill_list, v)
        end
    end

    -- Giữ toàn bộ hàng kỹ năng nằm trong vùng nhìn thấy, không kéo rộng
    -- inner container vì việc đó làm ô cuối tràn ra ngoài khung.
    local item_spacing = self.skill_item_spacing or 72
    local item_scale = self.skill_item_scale or 0.56
    local item_count = #skill_list
    local visible_width = self.skill_container_size.width
    local content_width = item_count > 1 and item_spacing * (item_count - 1) or 0

    -- Không ép start_x về 0. Khi hàng kỹ năng rộng hơn ScrollView, start_x
    -- âm sẽ chia phần dư đều sang hai vùng nền đen trái/phải. Clipping đã
    -- được tắt ở open_callback nên icon vẫn hiển thị đầy đủ.
    local skill_row_shift_left = 0
    local start_x = (visible_width - content_width) * 0.5 - skill_row_shift_left
    local center_y = self.skill_container_size.height * 0.5

    self.skill_container:setInnerContainerSize(
        cc.size(visible_width, self.skill_container_size.height)
    )

    for i,v in ipairs(self.skill_item_list) do
        v:setVisible(false)
    end

    for i,skill in ipairs(skill_list) do
        local config = Config.SkillData.data_get_skill(skill[2])
        if config then
            --是否锁住
            local is_lock = false
            if skill[1] > break_config.skill_num then
                is_lock = true
            end
            if self.skill_item_list[i] == nil then
                self.skill_item_list[i] = SkillItem.new(
                    true, true, true, item_scale, true
                )
                self.skill_container:addChild(self.skill_item_list[i])
            end
            self.skill_item_list[i]:setData(config)
            self:applyVerticalSkillShape(
                self.skill_item_list[i],
                self.skill_item_vertical_stretch
            )
            self.skill_item_list[i]:showUnEnabled(is_lock)
            self.skill_item_list[i]:setVisible(true)
            self.skill_item_list[i]:setPosition(
                start_x + item_spacing * (i - 1),
                center_y
            )
        else
            print(string_format("@技能表id: %s 没发现", tostring(skill.skill_bid)))
        end
    end
end

function HeroTipsPanel:updateEquip(hero_vo)
    self.equip_item_list = self.equip_item_list or {}

    -- Tách rõ trang bị thường, phụ kiện mới và thần khí.
    local equip_vo_list = {}
    local artifact_vo_list = {}

    local function buildGoodsVo(data)
        if not data then return nil end
        local base_id = data.base_id or data.bid or data.id
        if not base_id then return nil end
        local vo = GoodsVo.New(base_id)
        if vo and vo.initAttrData then
            vo:initAttrData(data)
        end
        return vo
    end

    -- Trang bị thường từ protocol 11061. Dùng config.type để nhận đúng ACCESSORY_1/2.
    if hero_vo.eqms ~= nil then
        for i,v in ipairs(hero_vo.eqms) do
            local item_config = Config.ItemData.data_get_data(v.base_id)
            local equip_type = (item_config and item_config.type) or v.type
            if equip_type then
                equip_vo_list[equip_type] = buildGoodsVo(v)
            end
        end
    elseif hero_vo.eqm_list ~= nil then
        for k,v in pairs(hero_vo.eqm_list) do
            local equip_type = k
            if v and v.config and v.config.type then
                equip_type = v.config.type
            end
            equip_vo_list[equip_type] = v
        end
    end

    -- Thần khí chỉ lấy artifact_pos 1/2, không nhét vào slot 5/6 của trang bị thường nữa.
    if hero_vo.artifacts ~= nil then
        for i,artifact_data in ipairs(hero_vo.artifacts) do
            if artifact_data.artifact_pos and artifact_data.artifact_pos < 100 then
                artifact_vo_list[artifact_data.artifact_pos] = buildGoodsVo(artifact_data)
            end
        end
    elseif hero_vo.artifact_list ~= nil then
        for k,v in pairs(hero_vo.artifact_list) do
            artifact_vo_list[k] = v
        end
    end

    for k,item in pairs(self.equip_item_list) do
        item:setData()
        if item.empty_icon then 
            item.empty_icon:setVisible(true)
        end
        item.equip_vo = nil
    end

    local function createOrUpdateItem(node_index, item_key, empty_icon_key, equip_vo, is_artifact, artifact_pos)
        local equip_node = self.equip_node_list and self.equip_node_list[node_index]
        if not equip_node then return end

        if self.equip_item_list[item_key] == nil then
            local item = BackPackItem.new(false,true,nil,1,false, true)
            equip_node:addChild(item,1)
            item:setPosition(cc.p(0,0))
            item:setScale(0.7)
            item:addBtnCallBack(function() 
                self:selectEquipVo(item:getData(), is_artifact and artifact_pos or item_key, is_artifact) 
            end)
            local res = PathTool.getResFrame("hero", self.equip_icon_name_list[empty_icon_key])
            local empty_icon = createImage(item:getRoot(), res,60,60, cc.p(0.5,0.5), true, 10, false)
            item.empty_icon = empty_icon
            self.equip_item_list[item_key] = item    
        end

        if equip_vo then
            self.equip_item_list[item_key]:setData(equip_vo)
            self.equip_item_list[item_key].equip_vo = equip_vo
            if self.equip_item_list[item_key].empty_icon then
                self.equip_item_list[item_key].empty_icon:setVisible(false)
            end
        end
    end

    -- Hàng 1: 4 trang bị thường cũ
    createOrUpdateItem(1, BackPackConst.item_type.WEAPON, BackPackConst.item_type.WEAPON, equip_vo_list[BackPackConst.item_type.WEAPON], false)
    createOrUpdateItem(2, BackPackConst.item_type.SHOE, BackPackConst.item_type.SHOE, equip_vo_list[BackPackConst.item_type.SHOE], false)
    createOrUpdateItem(3, BackPackConst.item_type.CLOTHES, BackPackConst.item_type.CLOTHES, equip_vo_list[BackPackConst.item_type.CLOTHES], false)
    createOrUpdateItem(4, BackPackConst.item_type.HAT, BackPackConst.item_type.HAT, equip_vo_list[BackPackConst.item_type.HAT], false)

    -- Hàng 2: 2 phụ kiện mới + 2 thần khí
    createOrUpdateItem(7, BackPackConst.item_type.ACCESSORY_1, BackPackConst.item_type.ACCESSORY_1, equip_vo_list[BackPackConst.item_type.ACCESSORY_1], false)
    createOrUpdateItem(8, BackPackConst.item_type.ACCESSORY_2, BackPackConst.item_type.ACCESSORY_2, equip_vo_list[BackPackConst.item_type.ACCESSORY_2], false)
    createOrUpdateItem(5, "artifact_1", 5, artifact_vo_list[1], true, 1)
    createOrUpdateItem(6, "artifact_2", 6, artifact_vo_list[2], true, 2)
end

--@ index 索引  如果是装备可以是装备类型 equip_type
function HeroTipsPanel:selectEquipVo(equip_vo, index, is_artifact)
    if not self.hero_vo then return end
    if not equip_vo then return end
    if is_artifact == true then
        controller:openArtifactTipsWindow(true, equip_vo, PartnerConst.ArtifactTips.normal, self.hero_vo.partner_id, index)
    else
        controller:openEquipTips(true, equip_vo, PartnerConst.EqmTips.normal, self.hero_vo) 
    end
end

function HeroTipsPanel:updateTalent(hero_vo)
    local skill_tips = self.equip_panel:getChildByName("skill_tips")
    local skill_node = self.equip_panel:getChildByName("skill_node")
    if not skill_tips then return end
    if not skill_node then return end
    local role_vo = RoleController:getInstance():getRoleVo()
    if not role_vo then return end

    local skill_list = {}
    if role_vo and hero_vo.rid and hero_vo.srv_id and role_vo.rid == hero_vo.rid and role_vo.srv_id == hero_vo.srv_id then
        --是自己的英雄
        if model:isOpenTanlentByHerovo(hero_vo) and hero_vo.ishaveTalentData and not hero_vo:ishaveTalentData() then
            controller:sender11099({{partner_id = hero_vo.partner_id}})
            return
        end
    end

    if hero_vo.talent_skill_list then
        --本地的
        for k,v in pairs(hero_vo.talent_skill_list) do
            local data = {}
            data.pos = k
            data.skill_id = v
            table_insert(skill_list, data)
        end
    elseif hero_vo.dower_skill then
        --网络的
        skill_list = hero_vo.dower_skill
    end

    table_sort(skill_list, function(a, b) return a.pos < b.pos end)
    if #skill_list > 0 then
        skill_tips:setVisible(false)

        -- Thu nhỏ và gom sát hàng năng lực. Tính vùng còn lại từ vị trí
        -- skill_node tới mép phải equip_panel để không cho ô cuối vượt viền.
        local item_spacing = self.talent_skill_item_spacing or 72
        local item_scale = self.talent_skill_item_scale or 0.65
        local item_count = #skill_list
        local panel_width = self.equip_panel:getContentSize().width
        local node_width = skill_node:getContentSize().width
        local panel_available = panel_width - skill_node:getPositionX() - 16
        local available_width = panel_available

        if node_width and node_width >= 10 then
            available_width = math.min(node_width, panel_available)
        end
        available_width = math.max(0, available_width)

        local content_width = item_count > 1 and item_spacing * (item_count - 1) or 0

        -- Đặt trực tiếp vị trí ô Năng lực đầu tiên theo hệ toạ độ của skill_node.
        -- Cách này không còn phụ thuộc vào hàng Kỹ năng phía trên nên chỉnh là thấy ngay.
        local start_x = self.talent_skill_start_x
        if start_x == nil then
            start_x = (available_width - content_width) * 0.5
        end

        self.talent_skill_item_list = self.talent_skill_item_list or {}
        for _, item in ipairs(self.talent_skill_item_list) do
            item:setVisible(false)
        end

        for i,v in ipairs(skill_list) do
            local config = Config.SkillData.data_get_skill(v.skill_id)
            if config then
                local item = self.talent_skill_item_list[i]
                if item == nil then
                    item = SkillItem.new(
                        true, true, true, item_scale, nil, false
                    )
                    skill_node:addChild(item)
                    self.talent_skill_item_list[i] = item
                end

                item:setData(config)
                self:applyVerticalSkillShape(
                    item,
                    self.talent_skill_item_vertical_stretch
                )
                item:setPosition(
                    start_x + (i - 1) * item_spacing,
                    0
                )
                item:setVisible(true)
            end
        end
    else
        skill_tips:setString(TI18N("语言_c_3207"))
    end
end

												 
																		
														
												  
										  

																	   
									   
													
					  
   

--神装
function HeroTipsPanel:updateHolyEquip(hero_vo)
    self.holy_equip_item_list = self.holy_equip_item_list or {}
    --装备
																							  
																					
    local equip_vo_list = {}
							  

															
								 
								 
										  
		   
							   
										  
		   
	   

    if hero_vo.holy_eqm ~= nil then
        --说明是网络返回的
        for i,v in ipairs(hero_vo.holy_eqm) do
            local item_config = Config.ItemData.data_get_data(v.base_id)
            if item_config then
                v.type = item_config.type
                equip_vo_list[v.type] = GoodsVo.New(v.base_id)
                if equip_vo_list[v.type]["initAttrData"] then
                    equip_vo_list[v.type]:initAttrData(v)
                end
                equip_vo_list[v.type]:setEnchantScore(0)
											   
				   

																				 
														   
            end
        end
    elseif hero_vo.holy_eqm_list ~= nil then
        --说明是本地的 hero_vo
        for k,v in pairs(hero_vo.holy_eqm_list) do
            equip_vo_list[k] = v
													
										  
			   

								
					 
																		   
			   
															  
														  
																	 
							
			   
													
        end
    end

    for k,item in pairs(self.holy_equip_item_list) do
        item:setData()
        if item.empty_icon then 
            item.empty_icon:setVisible(true)
        end
        item.equip_vo = nil
    end

    for i,equip_node in ipairs(self.holy_equip_node_list) do
        local equip_type = self.holy_equip_type_list[i] or i
        local equip_vo = equip_vo_list[equip_type]
        if self.holy_equip_item_list[equip_type] == nil then
            local item = BackPackItem.new(false,true,nil,1,false, true)
            equip_node:addChild(item,1)
            item:setPosition(cc.p(0,0))
            item:setScale(0.7)
            item:addBtnCallBack(function() 
                self:selectEquipVo(item:getData(), i) 
            end)
            local res= PathTool.getResFrame("hero",self.holy_equip_icon_name_list[equip_type])
            local empty_icon = createImage(item:getRoot(), res,60,60, cc.p(0.5,0.5), true, 10, false)
            item.empty_icon = empty_icon
            self.holy_equip_item_list[equip_type] = item    
        end

        if equip_vo then
																						  
            self.holy_equip_item_list[equip_type]:setData(equip_vo)
									
																			   
											
											
            self.holy_equip_item_list[equip_type].equip_vo = equip_vo
											  
																  
					

																 
										  
				 
																   
											   
												
												   
				 
											
            if self.holy_equip_item_list[equip_type].empty_icon then
			   

                self.holy_equip_item_list[equip_type].empty_icon:setVisible(false)
							
									  
										
									   
													 
				   
            end
        end
    end

    if self.holy_tips_label == nil then 
        self.holy_tips_label = createRichLabel(20, cc.c4b(0xe0,0xbf,0x98,0xff), cc.p(0.5, 0.5), cc.p(298.12, -284), nil, nil, 720)
											   
											   
												  
						 
		 
        self.equip_panel:addChild(self.holy_tips_label)
									  
																 
    end
    
    local list = model:getHolyEquipSuitDes(equip_vo_list)
    if next(list) ~= nil then
        -- table_sort(list, function(a, b) return a.id < b.id end)
        local str = TI18N("语言_c_4308")
        for k,v in ipairs(list) do
										   
            local suit_str = string_format("<img src='%s' scale=0.8 /> %s ", v.icon_res, v.name)
			 
            str = str..suit_str
        end
        self.holy_tips_label:setString(str)
    else
        self.holy_tips_label:setString(TI18N("语言_c_3208"))
    end
end


function HeroTipsPanel:close_callback()
    if self.hero_item then 
        self.hero_item:DeleteMe()
        self.hero_item = nil
    end
     if self.fight_label then
        self.fight_label:DeleteMe()
        self.fight_label = nil
    end

    if self.equip_item_list then
        for k,v in pairs(self.equip_item_list) do
            v:DeleteMe()
        end
    end   
    self.equip_item_list = nil
									 
														  
						   
		   
	   
								   

    if self.skill_item_list then
        for k,v in pairs(self.skill_item_list) do
            v:DeleteMe()
        end
    end
    self.skill_item_list = nil

    if self.talent_skill_item_list then
        for k,v in pairs(self.talent_skill_item_list) do
            v:DeleteMe()
        end
    end
    self.talent_skill_item_list = nil

    controller:openHeroTipsPanel(false)
end