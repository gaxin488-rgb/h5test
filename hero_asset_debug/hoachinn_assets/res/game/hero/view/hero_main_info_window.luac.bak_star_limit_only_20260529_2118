            self.spine_model:setScale(0.5)
           -- self.recommend_btn:addChild(self.spine_model)
        end
    else
        self.comment_btn:setVisible(true)
        --self.recommend_btn:setVisible(false)
        if self.spine_model then
            self.spine_model:setVisible(false)
            self.spine_model:removeFromParent()
            self.spine_model = nil
        end
