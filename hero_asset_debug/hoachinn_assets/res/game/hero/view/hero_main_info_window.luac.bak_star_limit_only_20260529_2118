function HeroMainTabGemPanel:registerEvents()
    if self.hero_equip_update_event == nil then
        self.hero_equip_update_event = GlobalEvent:getInstance():Bind(HeroEvent.Equip_Update_Event, function()
            self:refreshInfoLater()
        end)
    end
    if self.hero_data_update_event == nil then
        self.hero_data_update_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Data_Update, function(hero_vo)
            if not self.hero_vo or not hero_vo then return end
            if hero_vo.partner_id == self.hero_vo.partner_id then
                self.hero_vo = model:getHeroById(self.hero_vo.partner_id) or hero_vo
                self:updateInfo(self.hero_vo)
            end
        end)
    end
    if self.hero_equip_redpoint_event == nil then
        self.hero_equip_redpoint_event = GlobalEvent:getInstance():Bind(HeroEvent.Equip_RedPoint_Event, function()
            if not self.hero_vo then return end
            self:updateRedPoint()
        end)
    end
end

function HeroMainTabGemPanel:selectGemByType(gem_type)
    if not self.hero_vo or not gem_type then return end
    local equip_list = model:getHeroEquipList(self.hero_vo.partner_id)
    local equip_vo = self.slot_gem_vo_list and self.slot_gem_vo_list[gem_type] or equip_list[gem_type]
    if equip_vo ~= nil then
        controller:openEquipTips(true, equip_vo, PartnerConst.EqmTips.partner, self.hero_vo)
    else
        controller:openEquipPanel(true, gem_type, self.hero_vo.partner_id)
    end
end

function HeroMainTabGemPanel:refreshInfoLater()
    if not self.hero_vo then return end
    self.hero_vo = model:getHeroById(self.hero_vo.partner_id) or self.hero_vo
    self:updateInfo(self.hero_vo)
    delayRun(self, 0.15, function()
        if self.hero_vo then
            self.hero_vo = model:getHeroById(self.hero_vo.partner_id) or self.hero_vo
            self:updateInfo(self.hero_vo)
        end
    end)
    delayRun(self, 0.45, function()
        if self.hero_vo then
            self.hero_vo = model:getHeroById(self.hero_vo.partner_id) or self.hero_vo
            self:updateInfo(self.hero_vo)
        end
    end)
end

function HeroMainTabGemPanel:updateGemItemIcon(item, equip_vo, gem_type)
    if not item then return end
    local cfg = normalizeHeroItemVo(equip_vo)
    if cfg and item.setSelfBackground and cfg.quality then
        item:setSelfBackground(cfg.quality)
    end
end

function HeroMainTabGemPanel:updateInfo(hero_vo)
    if not hero_vo then return end
    local equip_list = model:getHeroEquipList(hero_vo.partner_id)
    self.slot_gem_vo_list = {}

    for _, gem_type in ipairs(self.gem_type_list) do
        local item = self.gem_item_list[gem_type]
        local equip_vo = equip_list[gem_type]
        if not equip_vo then
            for _, vo in pairs(equip_list) do
                local cfg = normalizeHeroItemVo(vo)
                local vo_type = vo and (vo.type or (cfg and cfg.type)) or nil
                if vo_type == gem_type then
                    equip_vo = vo
                    break
                end
            end
        end
        self.slot_gem_vo_list[gem_type] = equip_vo
        if item then
            if equip_vo then
                normalizeHeroItemVo(equip_vo)
                item:setData(equip_vo)
                if item.empty_icon then item.empty_icon:setVisible(false) end
                if item.showAddIcon then item:showAddIcon(false) end
                self:updateGemItemIcon(item, equip_vo, gem_type)
                if item.setEnchantLev then item:setEnchantLev(equip_vo.enchant or 0) end
                item.equip_vo = equip_vo
            else
                item:setData()
                if item.empty_icon then item.empty_icon:setVisible(true) end
                if item.showAddIcon then item:showAddIcon(false) end
                self:updateGemItemIcon(item, nil, gem_type)
                if item.setEnchantLev then item:setEnchantLev(0) end
                item.equip_vo = nil
                item:setBackgroundRes(PathTool.getResFrame("hero", "hero_info_32"))
            end
        end
    end
    self:updateRedPoint()
end

function HeroMainTabGemPanel:updateRedPoint()
    if not self.hero_vo then return end
    local equip_list = model:getHeroEquipList(self.hero_vo.partner_id)
    for _, gem_type in ipairs(self.gem_type_list) do
        local item = self.gem_item_list[gem_type]
        if item then
            local is_redpoint = false
            if HeroCalculate and HeroCalculate.checkSingleHeroEachPosEquipRedPoint then
                is_redpoint = HeroCalculate.checkSingleHeroEachPosEquipRedPoint(gem_type, equip_list[gem_type])
            end
            item:showRedPoint(is_redpoint)
        end
    end
end

function HeroMainTabGemPanel:setData(hero_vo)
    self.hero_vo = hero_vo
    self:updateInfo(hero_vo)
end

function HeroMainTabGemPanel:setVisibleStatus(status)
    self:setVisible(status)
    if status then
        self:refreshInfoLater()
    end
end

function HeroMainTabGemPanel:DeleteMe()
    if self.hero_equip_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_equip_update_event)
        self.hero_equip_update_event = nil
    end
    if self.hero_equip_redpoint_event then
        GlobalEvent:getInstance():UnBind(self.hero_equip_redpoint_event)
        self.hero_equip_redpoint_event = nil
    end
    if self.hero_data_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_data_update_event)
        self.hero_data_update_event = nil
    end
    if self.gem_item_list then
        for _, item in pairs(self.gem_item_list) do
            item:DeleteMe()
        end
        self.gem_item_list = nil
    end
    if self.gem_spine_list then
        for _, spine in pairs(self.gem_spine_list) do
            if spine and spine.DeleteMe then
                spine:DeleteMe()
            elseif spine and spine.removeFromParent then
                spine:removeFromParent()
            end
        end
        self.gem_spine_list = nil
    end
end

