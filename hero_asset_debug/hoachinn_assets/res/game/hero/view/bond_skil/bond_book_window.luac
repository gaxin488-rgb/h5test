BondBookWindow = BondBookWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local item_pos = {
    [1] = cc.p(290,50),
    [2] = cc.p(360,10),
    [3] = cc.p(300,-50),
    [4] = cc.p(370,-80),
    [5] = cc.p(240,-100),
    [6] = cc.p(320,-150), --下
    [7] = cc.p(390,-190),
    [8] = cc.p(250,-210),
    [9] = cc.p(320,-260),
    [10] = cc.p(410,-290),
    [11] = cc.p(230,-300),
    [12] = cc.p(285,-380), --上
    [13] = cc.p(365,-355),
    [14] = cc.p(430,-390),
    [15] = cc.p(190,-410),
    [16] = cc.p(250,-480),
    [17] = cc.p(345,-450),
    [18] = cc.p(450,-490),
}
--技能属性的位置
local pos_list = {
    [1] = cc.p(50,45),
    [2] = cc.p(200,45),
    [3] = cc.p(350,45),
    [4] = cc.p(50,15),
    [5] = cc.p(200,15),
}
local rotation_list = {
    [1] = {[1] = -180,[2] = -19.5,[3] = -10},
    [2] = {[1] = -10,[2] = 0,[3] = 10},
    [3] = {[1] = 10,[2] = 19.5,[3] = 29},
    [4] = {[1] = 29,[2] = 39,[3] = 180},
}

function BondBookWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full
    self.layout_name = "skill/bond_book_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("bondskill", "bondskill"), type = ResourcesType.plist}
    }

    self.book_list = {}
    self.click_img_list ={}
    self.role_vo = RoleController:getInstance():getRoleVo()
    --初始化比例
    self.slider_percent = 50
    --缩放大小 为 1 时 slider_percent 的比例值
    self.scale_percent = 50
    self.max_scale = 1.5
    --最小比例
    self.min_scale = 0.5
    self.bond_skill_list = {}
    self.click_id = 0
    self.attr_list = {}
end

function BondBookWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container:setZOrder(2)
    -- self.main_container:setScale(display.getMaxScale())

    self.slip_panel = self.main_container:getChildByName("slip_panel")
    self.main_panel = self.slip_panel:getChildByName("main_panel")
    for i = 1, 4 do
        self.book_list[i] = self.main_panel:getChildByName("book_"..i)
        self.click_img_list[i] = self.book_list[i]:getChildByName("click_img")
        self.click_img_list[i]:setVisible(false)
    end
    self.title_panel = self.main_container:getChildByName("title_panel")
    self.title_bg = self.title_panel:getChildByName("title_bg")
    self.title_txt = self.title_panel:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_c_6178"))
    self.title_bg:setContentSize(cc.size(math.max(self.title_txt:getContentSize().width+100,300),63))
    self.btn_rule = self.title_panel:getChildByName("btn_rule")
    self.lv_panel = self.main_container:getChildByName("lv_panel")
    self.lv_title = self.lv_panel:getChildByName("lv_title")
    self.lv_title:setString(TI18N("语言_c_6179"))
    self.info_panel = self.main_container:getChildByName("info_panel")
    self.info_panel:setVisible(false)
    self.skill_panel = self.info_panel:getChildByName("skill_panel")
    self.skill_name = self.skill_panel:getChildByName("skill_name")
    self.eff_panel = self.info_panel:getChildByName("eff_panel")
    self.base_panel = self.eff_panel:getChildByName("base_panel")
    self.base_bg = self.base_panel:getChildByName("base_bg")
    self.base_name = self.base_panel:getChildByName("base_name")
    self.base_name:setString(TI18N("语言_c_6180"))
    self.base_bg:setContentSize(cc.size(math.max(self.base_name:getContentSize().width+100,311),27))
    self.effect_panel = self.eff_panel:getChildByName("effect_panel")
    self.eff_bg = self.effect_panel:getChildByName("eff_bg")
    self.eff_name = self.effect_panel:getChildByName("eff_name")
    self.eff_name:setString(TI18N("语言_c_6181"))
    self.eff_bg:setContentSize(cc.size(math.max(self.eff_name:getContentSize().width+100,311),27))
    self.eff_desc = self.effect_panel:getChildByName("eff_desc")
    self.eff_desc:setScrollBarEnabled(false)
    self.slider_panel = self.main_container:getChildByName("slider_panel")
    self.slider = self.slider_panel:getChildByName("slider")
    self.slider:setBarPercent(3, 97)
    self.slider:setScale9Enabled(true)
    self.delete_btn = self.slider_panel:getChildByName("delete_btn")
    self.add_btn = self.slider_panel:getChildByName("add_btn")
    self.close_btn = self.main_container:getChildByName("close_btn")
    self:adaptationScreen()
end

--设置适配屏幕
function BondBookWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)

    local container_size = self.main_container:getContentSize()
    local tab_y = self.title_panel:getPositionY()
    self.title_panel:setPositionY(top_y - (container_size.height - tab_y))
    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)
end

function BondBookWindow:register_event()
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,true, 2)
    self.slider:addEventListener(function ( sender,event_type )
        if event_type == ccui.SliderEventType.percentChanged then
            self.slider_percent = self.slider:getPercent()
            self:setIconScale()
        end
    end)
    self.main_container:addTouchEventListener(function ( sender,event_type )
        if event_type == ccui.TouchEventType.moved then
            local touch_began = self.touch_began
            local touch_move = sender:getTouchMovePosition()
            if touch_began.x > touch_move.x then
                local num = math.floor((touch_began.x - touch_move.x)/30)
                -- if self.touch_rot + num < 40 then
                    self.main_panel:setRotation(self.touch_rot + num)
                -- end
            elseif touch_began.x < touch_move.x then
                local num = math.floor((touch_move.x - touch_began.x)/30)
                -- if self.touch_rot - num > -20 then
                    self.main_panel:setRotation(self.touch_rot - num)
                -- end
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
            self.touch_rot = self.main_panel:getRotation()
        elseif event_type == ccui.TouchEventType.ended then
            self:setMainRota()
        elseif event_type == ccui.TouchEventType.canceled then
            self:setMainRota()
        end
    end)
    self.btn_rule:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            local reward_desc_cfg = Config.PartnerBondSkillData.data_const["bond_skill_desc"]
            if reward_desc_cfg then
                TipsManager:getInstance():showAdventureBuffTipsScroll(reward_desc_cfg.desc, sender:getTouchBeganPosition(),nil,nil,550,nil,600)
            end
        end
    end)
end

function BondBookWindow:setMainRota()
    local rota = self.main_panel:getRotation()
    for key, value in pairs(rotation_list ) do
        if rota >= value[1] and rota < value[3] then
            local action1 = cc.RotateTo:create(0.3, value[2])
            self.main_panel:runAction(cc.Sequence:create(action1))
        end
    end
end

function BondBookWindow:setIconScale()
    local cur_scale
    if self.slider_percent > self.scale_percent then
        local scale = self.max_scale - 1
        cur_scale = 1 + (self.slider_percent - self.scale_percent) * scale /50 
    elseif self.slider_percent < self.scale_percent then
        local scale = 1 - self.min_scale 
        cur_scale = self.min_scale + self.slider_percent * scale /50 
    else
        cur_scale = 1
    end
    self.cur_scale = cur_scale
    self.slip_panel:setScale(cur_scale)
end
function BondBookWindow:onClickBtnClose()
    controller:openBondBookWindow(false)
end

function BondBookWindow:openRootWnd()
    self.slider:setPercent(self.slider_percent)
    self:setIconScale()
    self:setData()
end

function BondBookWindow:setData()
    local list = model:getBondNumForLv()
    local txt = TI18N("语言_c_6370")
    self.lv_txt = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(0,0.5),cc.p(250,25),nil,nil,700)
    self.lv_panel:addChild(self.lv_txt)
    self.lv_txt:setString(LangStringFormat(txt,list))
    for key, value in pairs(self.bond_skill_list) do
        for k, v in pairs(value) do
            v:DeleteMe()
        end
    end
    local list = model:getBondSkillList()
    for i = 1, tableLen(list) do
        local rot = self.book_list[i]:getRotation()
        self.book_list[i]:setRotation(0)
        if not self.bond_skill_list[i] then
            self.bond_skill_list[i] = {}
        end
        local j = 1
        local id_list = {}
        for key, value in pairs(list[i]) do
            local list = {}
            list.id = value.id
            list.sort = value.sort
            table.insert(id_list, list)
        end
        table.sort(id_list,function(a,b) return a.sort < b.sort end)
        for h = 1, tableLen(id_list) do
            local _x = item_pos[j].x
            local _y = item_pos[j].y
            list[i][id_list[h].id]._index = j
            if not self.bond_skill_list[i][j] then
                self.bond_skill_list[i][j] = BondSkillItem.new(true,0.6)
                self.book_list[i]:addChild(self.bond_skill_list[i][j])
                self.bond_skill_list[i][j]:setPosition(cc.p(_x,_y))
                self.bond_skill_list[i][j]:setZOrder(200+i)
            end
            self.bond_skill_list[i][j]:setData(list[i][id_list[h].id])
            self.bond_skill_list[i][j]:setLockSta(false)
            self.bond_skill_list[i][j]:setbondParVis(false)
            self.bond_skill_list[i][j]:setequipSta(false)
            self.bond_skill_list[i][j]:setnameSta(false)
            setChildUnEnabled(false,self.bond_skill_list[i][j].item_icon)
            
            registerButtonEventListener(self.bond_skill_list[i][j], function()
                self.main_panel:setRotation(rotation_list[i][2])
                for k, v in pairs(self.click_img_list) do
                    if k ~= i then
                        v:setVisible(false)
                    else
                        v:setVisible(true)
                        v:setPosition(cc.p(item_pos[list[i][id_list[h].id]._index].x-1,item_pos[list[i][id_list[h].id]._index].y-5)) 
                    end                    
                end
                self:clickItem(list[i][id_list[h].id])
            end ,true, 2 , false , 0.6)
            j = j + 1
        end
        self.book_list[i]:setRotation(rot)
    end
end

function BondBookWindow:clickItem(data)
    if self.click_id == data.id then
        for k, v in pairs(self.click_img_list) do
            v:setVisible(false)
        end
        self.info_panel:setVisible(false)
        self.click_id = 0
    else
        self.info_panel:setVisible(true)
        self.click_id = data.id
        local list = {}
        list = deepCopy(Config.PartnerBondSkillData.data_base_info[data.id][tableLen(Config.PartnerBondSkillData.data_base_info[data.id])])
        list.data = data.data
        self:updateInfoPanel(list)
    end
end
function BondBookWindow:updateInfoPanel(data)
    local skill_cfg = Config.SkillData.data_get_skill(data.skill_ids[1])
    self.skill_name:setChangeScaleOffWidth(-500)
    setTextMaxWidth(self.skill_name,160)
    self.skill_name:setString(transformTextToShort(skill_cfg.name, 22))
    self.skill_name:setTouchEnabled(true)
    addEvt2showAllTextTips(self.skill_name,skill_cfg.name,22)
    if not self.skill_item then
        self.skill_item = SkillItem.new(true,true,true,0.8, true)
        self.skill_panel:addChild(self.skill_item)
        self.skill_item:setPosition(cc.p(80,90))
    end
    self.skill_item:setData(skill_cfg)
    self:setAttrPanel(data.attr_c)
    if not self.skill_desc then
        self.skill_desc = createRichLabel(20,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0,1),cc.p(34,10),0,nil,400)
        self.eff_desc:addChild(self.skill_desc)
    end
    self.skill_desc:setString(skill_cfg.des)
    local _h = math.max(self.skill_desc:getContentSize().height,self.eff_desc:getContentSize().height)
    if _h > self.eff_desc:getContentSize().height then
        self.eff_desc:setTouchEnabled(true)
    else
        self.eff_desc:setTouchEnabled(false)
    end
    self.eff_desc:setInnerContainerSize(cc.size(468,_h))
    self.skill_desc:setPositionY(_h)
end

--设置属性
function BondBookWindow:setAttrPanel(data)
    for key, value in pairs(self.attr_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.base_panel) then
			self.base_panel:removeChild(value)
		end
		value = nil
	end
    for i = 1, tableLen(data) do
        local item = self:setAttrItem(data[i])
        self.base_panel:addChild(item)
        item:setPosition(pos_list[i])
        self.attr_list[i] = item
    end
end

function BondBookWindow:setAttrItem(data)
    local item = ccui.Layout:create()
    item:setAnchorPoint(cc.p(0, 0.5))
    item:setTouchEnabled(true)
    local label = createRichLabel(20, cc.c4b(0x7c,0x55,0x36,0xff), cc.p(0, 0), cc.p(0, 0), -4, nil, 456)
    item:addChild(label)
    local icon = PathTool.getAttrIconByStr(data[1])
    local is_per = PartnerCalculate.isShowPerByStr(data[1])
    local num = deepCopy(data[2])
    if is_per == true then
        num = (data[2]*0.1).."%"
    end
    local attr_str = string.format("<img src='%s' scale=0.8 /><div fontcolor=#7c5536>   %s</div>", PathTool.getResFrame("common", icon), num)
    label:setString(attr_str)
    item:setContentSize(label:getContentSize())
    item:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            local txt = Config.AttrData.data_key_to_name[data[1]]
            TipsManager:getInstance():showCommonTips(txt, sender:getTouchBeganPosition(),24,30,300,false,0,50,true)
        end
    end)
    return item
end
function BondBookWindow:close_callback()
    controller:openBondBookWindow(false)
end