--@ index 索引  如果是装备可以是装备类型 equip_type
function HeroMainTabEquipPanel:selectEquipByIndex(index)
    if self.artifact_node_index_list then
        for pos, node_index in ipairs(self.artifact_node_index_list) do
            if index == node_index then
                self:selectArtifactByPos(pos)
                return
            end
        end
    end
    self:selectEquipByType(index)
end

function HeroMainTabEquipPanel:selectArtifactByPos(pos)
    if not self.hero_vo then return end
    local equip_vo = self.artifact_display_list and self.artifact_display_list[pos] or (self.hero_vo.artifact_list and self.hero_vo.artifact_list[pos] or nil)
    if equip_vo == nil then
        local artifact_lock = self.artifact_lock_list[pos]
        if artifact_lock then
            if artifact_lock[1] == 'lev' then
                if self.hero_vo.lev < artifact_lock[2] then
                    message(string_format( TI18N("语言_c_3034"),artifact_lock[2]))
                    return
                end
            elseif artifact_lock[1] == 'star' then
                if self.hero_vo.star < artifact_lock[2] then
                    message(string_format( TI18N("语言_c_3035"),artifact_lock[2]))
                    return
                end
            end
        end
    end

    if equip_vo and next(equip_vo) ~=nil then
        controller:openArtifactTipsWindow(true, equip_vo, PartnerConst.ArtifactTips.partner, self.hero_vo.partner_id, pos, self.lock_list and self.lock_list[pos])
    else
        controller:openArtifactListWindow(true, pos, self.hero_vo.partner_id)
    end
end

function HeroMainTabEquipPanel:selectEquipByType(equip_type)
    if not self.hero_vo then return end
    local equip_list = model:getHeroEquipList(self.hero_vo.partner_id)
    local equip_vo = self.slot_equip_vo_list and self.slot_equip_vo_list[equip_type] or equip_list[equip_type]
    if equip_vo ~= nil then
        controller:openEquipTips(true, equip_vo, PartnerConst.EqmTips.partner, self.hero_vo)
    else
        controller:openEquipPanel(true,equip_type,self.hero_vo.partner_id)
    end
end


