--更新圣器的红点
function HeroMainTabEquipPanel:updateArtifactRedPoint()
    --符文(神器) 红点
    if self.lock_list then
        local slot_num = self.artifact_slot_count or math.max(2, #self.artifact_lock_list)
        for i=1,slot_num do
            if self.img_box[i] then
                if not self.lock_list[i] then
                    local equip_vo = self.artifact_display_list and self.artifact_display_list[i] or (self.hero_vo.artifact_list and self.hero_vo.artifact_list[i] or nil)
                    local is_redpoint = HeroCalculate.checkSingleArtifactRedPoint(equip_vo)
                    -- item:showRedPoint(is_redpoint)
                    addRedPointToNodeByStatus(self.img_box[i], is_redpoint, -1, -10)
                    if self.img_box[i].red_point then
                        self.img_box[i].red_point:setScale(0.7)
                    end
                else
                    addRedPointToNodeByStatus(self.img_box[i], false)
                end
            end
        end
    end
end

--更新每一个装备红点
function HeroMainTabEquipPanel:updateEachEquipRedPoint(equip_type)
    if not self.hero_vo then return false end
    local equip_list = model:getHeroEquipList(self.hero_vo.partner_id)
    local item = self.equip_item_list[equip_type]
    if not item then return false end
    local is_redpoint = HeroCalculate.checkSingleHeroEachPosEquipRedPoint(equip_type, equip_list[equip_type])
    item:showRedPoint(is_redpoint)
    return is_redpoint
end

function HeroMainTabEquipPanel:updateInfo(hero_vo)
    if not hero_vo then return end
    local equip_list = model:getHeroEquipList(hero_vo.partner_id)
    self.slot_equip_vo_list = {}
    local used_key_list = {}

    for _,_type in ipairs(self.equip_type_list) do
        if equip_list[_type] then
            self.slot_equip_vo_list[_type] = equip_list[_type]
            used_key_list[_type] = true
        elseif _type == SPEC1_TYPE and equip_list[5] then
            self.slot_equip_vo_list[_type] = equip_list[5]
            used_key_list[5] = true
        elseif _type == SPEC2_TYPE and equip_list[6] then
            self.slot_equip_vo_list[_type] = equip_list[6]
            used_key_list[6] = true
        end
    end

    for key,equip_vo in pairs(equip_list) do
        local equip_type = getEquipTypeByKey(key, equip_vo)
        if equip_type and self.equip_item_list[equip_type] and self.slot_equip_vo_list[equip_type] == nil then
            self.slot_equip_vo_list[equip_type] = equip_vo
            used_key_list[key] = true
        end
    end

    for i,_type in ipairs(self.equip_type_list) do
        local equip_vo = self.slot_equip_vo_list[_type]
        local item = self.equip_item_list[_type]
        if item then
            if equip_vo then
                normalizeHeroEquipVo(equip_vo)
                item:setData(equip_vo)
                if item.setEnchantLev then item:setEnchantLev(equip_vo.enchant or 0) end
                if item.empty_icon then item.empty_icon:setVisible(false) end
                item.equip_vo = equip_vo
            else
                item:setData()
                if item.setEnchantLev then item:setEnchantLev(0) end
                if item.empty_icon then item.empty_icon:setVisible(true) end
                item.equip_vo = nil
                item:setBackgroundRes(PathTool.getResFrame("hero", "hero_info_32"))
            end
        end
    end
    self:updateArtifactInfo(hero_vo)
end

--神器信息
function HeroMainTabEquipPanel:updateArtifactInfo( hero_vo )
    --解锁信息
    self.lock_list = {}
    self.artifact_display_list = {}
    local used_artifact_key_list = {}
    if hero_vo.artifact_list then
        for i=1,(self.artifact_slot_count or 4) do
            if hero_vo.artifact_list[i] then
                self.artifact_display_list[i] = hero_vo.artifact_list[i]
                used_artifact_key_list[i] = true
            end
        end
        for key,equip_vo in pairs(hero_vo.artifact_list) do
            if not used_artifact_key_list[key] and equip_vo then
                for i=1,(self.artifact_slot_count or 4) do
                    if self.artifact_display_list[i] == nil then
                        self.artifact_display_list[i] = equip_vo
                        used_artifact_key_list[key] = true
                        break
                    end
                end
            end
        end
    end
    -- 默认按 4 个神器槽位处理；若没有配置则视为已解锁
    local slot_num = self.artifact_slot_count or 4
    for i=1,slot_num do
        local v = self.artifact_lock_list[i] or {'star', 0}
        if self.img_lock[i] then self.img_lock[i]:setVisible(false) end
        if self.lab_lock[i] then
            self.lab_lock[i]:setVisible(true)
            self.lab_lock[i]:setString("")
        end
        local is_lock = true
        local item = self.artifact_item_list and self.artifact_item_list[i] or nil
        if v[1] == 'lev' then
            if hero_vo.lev >= v[2]  then
                --已解锁
                is_lock = false
                if self.img_box[i] then self.img_box[i]:setVisible(true) end
                if self.img_bg[i] then self.img_bg[i]:setVisible(true) end
                if item then
                    item:setVisible(true)
                end
            else
                local max_lev = Config.PartnerData.data_partner_max_lev[self.hero_vo.bid]
                if max_lev and max_lev >= v[2] then
                    if self.img_lock[i] then self.img_lock[i]:setVisible(true) end
                    if self.img_box[i] then self.img_box[i]:setVisible(true) end
                    if self.img_bg[i] then self.img_bg[i]:setVisible(true) end
                    if item then
                        item:setVisible(true)
                    end
                    
                    if self.lab_lock[i] then self.lab_lock[i]:setString(string.format(TI18N("语言_c_2867"),v[2])) end
                else
                    if self.img_box[i] then self.img_box[i]:setVisible(false) end
                    if self.img_bg[i] then self.img_bg[i]:setVisible(false) end
                    if item then
                        item:setVisible(false)
                    end
                end
            end
        elseif v[1] == 'star' then
            local max_star = Config.PartnerData.data_partner_max_star[self.hero_vo.bid]
            if max_star and max_star < v[2] then
                --策划要求不满星级的要隐藏
                if self.img_box[i] then self.img_box[i]:setVisible(false) end
                if self.img_bg[i] then self.img_bg[i]:setVisible(false) end
                if item then
                    item:setVisible(false)
                end
            else
                if self.img_box[i] then
                    self.img_box[i]:setVisible(true)
                    if self.img_box[i].red_point then
                        self.img_box[i].red_point:setVisible(false)
                    end
                end
                if self.img_bg[i] then self.img_bg[i]:setVisible(true) end
                if item then
                    item:setVisible(true)
                end
                if hero_vo.star >= v[2] then
                    is_lock = false
                else
                    if self.img_lock[i] then self.img_lock[i]:setVisible(true) end
                    if self.lab_lock[i] then self.lab_lock[i]:setString(string.format(TI18N("语言_c_4742"),v[2])) end
                end
            end
        end
        self.lock_list[i] = is_lock
    end
    --self.artifact_item_list 是神器信息
    if hero_vo.artifact_list then
        local slot_num2 = self.artifact_slot_count or 4
        for i=1,slot_num2 do
            local item = self.artifact_item_list and self.artifact_item_list[i] or nil
            local equip_vo = self.artifact_display_list and self.artifact_display_list[i] or hero_vo.artifact_list[i]
            -- if not self.lock_list[i] and equip_vo then
            --策划要求 原本 6星解锁 改成 7星解锁 .原本6星的已有数据的保留
            if item and equip_vo then
                item:setData(equip_vo)
                if item.empty_icon then 
                    item.empty_icon:setVisible(false)
                end
                item.equip_vo = equip_vo
                if self.img_lock[i] then self.img_lock[i]:setVisible(false) end
                if self.lab_lock[i] then self.lab_lock[i]:setVisible(false) end
                item:setBackgroundOpacity(255)
            elseif item then
                item:setData()
                if item.empty_icon then 
                    item.empty_icon:setVisible(true)
                end
                item:setBackgroundOpacity(0)
                item.equip_vo = nil
            end
        end
    end

    self:updateArtifactRedPoint()
end

function HeroMainTabEquipPanel:setVisibleStatus(bool)
    self:setVisible(bool)
end


--移除
function HeroMainTabEquipPanel:DeleteMe()
    if self.hero_data_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_data_update_event)
        self.hero_data_update_event = nil
    end
    if self.hero_equip_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_equip_update_event)
        self.hero_equip_update_event = nil
    end
    if self.hero_equip_redpoint_event then
        GlobalEvent:getInstance():UnBind(self.hero_equip_redpoint_event)
        self.hero_equip_redpoint_event = nil
    end
    if self.update_artifact_event then
        GlobalEvent:getInstance():UnBind(self.update_artifact_event)
        self.update_artifact_event = nil
    end
    if self.equip_spine_list then
        for _, spine in pairs(self.equip_spine_list) do
            if spine and spine.DeleteMe then
                spine:DeleteMe()
            elseif spine and spine.removeFromParent then
                spine:removeFromParent()
            end
        end
        self.equip_spine_list = nil
    end
    if self.artifact_spine_list then
        for _, spine in pairs(self.artifact_spine_list) do
            if spine and spine.DeleteMe then
                spine:DeleteMe()
            elseif spine and spine.removeFromParent then
                spine:removeFromParent()
            end
        end
        self.artifact_spine_list = nil
    end
end
