function HeroMainTabEquipPanel:layoutUI(power_click)
    local csbPath = PathTool.getTargetCSB("hero/hero_main_tab_equip_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    --那边传过来的战力node()
    -- self.power_click = power_click
    self.tab_panel = self.root_wnd:getChildByName("tab_panel")

    self.equip_node_list = {}
    self.artifact_item_list = {}
    self.is_new_equip_csb = self.tab_panel:getChildByName("equip_node9") ~= nil
    if self.is_new_equip_csb then
        self.equip_node_index_list = {1, 3, 2, 4, 7, 8}
        self.artifact_node_index_list = {5, 9, 6, 10, 11, 12}
        self.hero_slot_node_scale = 0.88
        self.hero_slot_item_scale = 0.82
        self.hero_slot_icon_size = 60
        self.hero_lock_scale = 0.78
        self.hero_artifact_bg_scale = 0.86
        self.hero_spine_scale = 0.92
    else
        self.equip_node_index_list = {1, 2, 3, 4}
        self.artifact_node_index_list = {5, 6}
        self.hero_slot_node_scale = 1
        self.hero_slot_item_scale = 0.8
        self.hero_slot_icon_size = 60
        self.hero_lock_scale = 0.8
        self.hero_artifact_bg_scale = 0.9
        self.hero_spine_scale = 0.75
    end

    for slot=1,#self.equip_node_index_list do
        local node_index = self.equip_node_index_list[slot]
        local equip_type = self.equip_type_list[slot] or slot
        self.equip_node_list[slot] = self.tab_panel:getChildByName("equip_node"..node_index)

        if self.equip_node_list[slot] then
            self.equip_node_list[slot]:setScale(self.hero_slot_node_scale)
            if self.enable_spine and createEffectSpine then
                local spine_name = self.equip_spine_config[slot]
                if spine_name and spine_name ~= "" then
                    local ok, spine = pcall(createEffectSpine, spine_name, cc.p(0,0), cc.p(0.5,0.5), true, PlayerAction.action_2)
                    if ok and spine then
                        spine:setScale(self.hero_spine_scale)
                        self.equip_node_list[slot]:addChild(spine, self.spine_z_order)
                        self.equip_spine_list[slot] = spine
                    end
                end
            end
            local item = BackPackItem.new(false,true,nil,self.hero_slot_item_scale,false)
            item:setName("guidesign_equip_item_"..node_index)
            self.equip_node_list[slot]:addChild(item,1)
            item:setPosition(cc.p(0,0))
            item:addCallBack(function() self:selectEquipByType(equip_type) end)
            local icon_name = self.equip_icon_name_list[equip_type] or "hero_info_7"
            local res= PathTool.getResFrame("hero", icon_name)
            local empty_icon = createImage(item:getRoot(), res,self.hero_slot_icon_size,self.hero_slot_icon_size, cc.p(0.5,0.5), true, 10, false)
            item.empty_icon = empty_icon
            self.equip_item_list[equip_type] = item
        end
    end
    self.img_lock = {}
    self.lab_lock = {}
    self.img_box = {}
    self.img_bg = {}

    self.artifact_slot_count = #self.artifact_node_index_list
    for i=1,self.artifact_slot_count do
        local ui_pos = self.artifact_node_index_list[i]
        self.img_lock[i] = self.tab_panel:getChildByName("img_lock"..ui_pos)
        if self.img_lock[i] then self.img_lock[i]:setScale(self.hero_lock_scale) end
        self.lab_lock[i] = self.tab_panel:getChildByName("lab_lock"..ui_pos)
        if self.lab_lock[i] then self.lab_lock[i]:setScale(self.hero_lock_scale) end
        self.img_box[i]  = self.tab_panel:getChildByName("artifacts_bg_"..i)
        if self.img_box[i] then self.img_box[i]:setScale(self.hero_artifact_bg_scale) end
        local equip_node = self.tab_panel:getChildByName("equip_node"..ui_pos)
        self.img_bg[i]  = equip_node and equip_node:getChildByName("box_34") or nil
        if self.img_bg[i] then self.img_bg[i]:setScale(self.hero_artifact_bg_scale) end
        if equip_node then
            equip_node:setScale(self.hero_slot_node_scale)
            local item = BackPackItem.new(false,true,nil,self.hero_slot_item_scale,false)
            item:setName("guidesign_equip_item_"..ui_pos)
            equip_node:addChild(item,1)
            item:setPosition(cc.p(0,0))
            item:addCallBack(function() self:selectArtifactByPos(i) end)
            local res= PathTool.getResFrame("hero", self.equip_icon_name_list[5] or "hero_info_11")
            local empty_icon = createImage(item:getRoot(), res,self.hero_slot_icon_size,self.hero_slot_icon_size, cc.p(0.5,0.5), true, 10, false)
            item.empty_icon = empty_icon
            item:setBackgroundOpacity(0)
            self.artifact_item_list[i] = item
            if self.enable_spine and createEffectSpine then
                local spine_name = self.artifact_spine_config[i]
                if spine_name and spine_name ~= "" then
                    local ok, spine = pcall(createEffectSpine, spine_name, cc.p(0,0), cc.p(0.5,0.5), true, PlayerAction.action_2)
                    if ok and spine then
                        spine:setScale(self.hero_spine_scale)
                        equip_node:addChild(spine, self.spine_z_order)
                        self.artifact_spine_list[i] = spine
                    end
                end
            end
        end
    end

    self.key_up_btn = self.tab_panel:getChildByName("key_up_btn")
    self.key_up_btn:getChildByName("label"):setString("Mặc nhanh")
    -- self.key_up_btn:setPosition(cc.p(158,355))
