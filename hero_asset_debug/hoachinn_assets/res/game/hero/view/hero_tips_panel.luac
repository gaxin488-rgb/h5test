HeroTipsPanel = HeroTipsPanel or BaseClass(BaseView)
local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort
local SPEC1_TYPE = (BackPackConst and BackPackConst.item_type and BackPackConst.item_type.SPEC1) or 110
local SPEC2_TYPE = (BackPackConst and BackPackConst.item_type and BackPackConst.item_type.SPEC2) or 111

local function normalizeHeroEquipVo(vo)
    if not vo then return nil end
    local cfg = vo.config
    if cfg == nil then
        local bid = vo.base_id or vo.bid or vo.id
        if bid and Config and Config.ItemData and Config.ItemData.data_get_data then
            cfg = Config.ItemData.data_get_data(bid)
            if cfg then vo.config = cfg end
        end
    end
    return cfg
end

local function getEquipTypeByKey(key, vo)
    key = tonumber(key) or key
    local cfg = normalizeHeroEquipVo(vo)
    local equip_type = vo and (vo.type or (cfg and cfg.type)) or nil
    equip_type = tonumber(equip_type) or equip_type
    if equip_type == nil then
        if key == 5 then
            equip_type = SPEC1_TYPE
        elseif key == 6 then
            equip_type = SPEC2_TYPE
        else
            equip_type = key
        end
    end
    return equip_type
end

local function createGemGoodsVo(gem_info)
    if not gem_info or not gem_info.item_bid or gem_info.item_bid == 0 then return nil end
    local item_cfg = Config.ItemData.data_get_data(gem_info.item_bid)
    if not item_cfg then return nil end
    local vo = GoodsVo.New(gem_info.item_bid)
    if vo and vo.initAttrData then
        vo:initAttrData({base_id = gem_info.item_bid, id = gem_info.id or 0})
    end
    if vo then
        vo.config = item_cfg
        vo.main_attr = gem_info.item_attr
        vo.item_attr = gem_info.item_attr
        vo.item_skill = gem_info.item_skill
        vo.extra_attr = gem_info.item_skill
        vo.extra = gem_info.extra
        vo.enchant = gem_info.lv or 0
    end
    return vo
end

local function normalizePowerValue(value)
    if value == nil then return 0 end
    if type(value) == "number" then return value end
    local num = tonumber(value)
    return num or tostring(value)
end

local function powerToString(value)
    if value == nil then return "0" end
    if type(value) == "number" then
        return string_format("%.0f", value)
    end
    return tostring(value)
end

