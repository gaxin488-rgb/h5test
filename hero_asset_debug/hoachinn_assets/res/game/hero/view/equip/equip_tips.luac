function EquipTips:register_event()
    --ç©¿æˆ´ å’Œæ›´æ¢
    self.tab_btn_3:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn3()
        end
    end)
    self.tab_btn_2:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn2()
        end
    end)
    --å¸ä¸‹å’Œå‡ºå”®
    self.tab_btn_1:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn1()
        end
    end)
    --æ»¡è¶³å¯åˆæˆæ¡ä»¶
    self.tab_btn_4:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn4(sender)
        end
    end)

    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn() end ,true, 1) 
    registerButtonEventListener(self.background, function() self:onClickCloseBtn() end ,false, 0) 

    registerButtonEventListener(self.pre_btn, function(param,sender, event_type) 
        if not self.data or not self.item_config then return end
        local config = Config.PartnerHolyEqmData.data_base_info(self.item_config.id)
        if config then
            TipsManager:getInstance():showCommonTips(config.tips_info, sender:getTouchBeganPosition())
        end
    end ,true, 2)

    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.PartnerHolyEqmData.data_const.game_rule_1
        if config then
            TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition())
        end
    end ,true, 2, nil, 0.8)
    --ç¥žè£…ä¿¡æ¯æ›´æ–°
    self:addGlobalEvent(HeroEvent.Holy_Equipment_Update_Event, function (hero_vo)
        if not hero_vo then return end
        if not self.data or not self.item_config then return end
        if hero_vo.partner_id and hero_vo.partner_id == self.partner_id then
            self:initData()
        end
    end)
    self:addGlobalEvent(HeroEvent.Equip_Update_Event, function()
        if not self.data or not self.item_config then return end
        if self.cloth_type ~= PartnerConst.EqmTips.partner then return end
        local equip_list = model:getHeroEquipList(self.partner_id)
        local item_id = self.data.id or 0
        for _, equip_vo in pairs(equip_list) do
            if equip_vo and equip_vo.id == item_id then
                self.data = equip_vo
                self.item_config = equip_vo.config or Config.ItemData.data_get_data(equip_vo.base_id or equip_vo.bid or equip_vo.id)
                self:initData()
                if self.eqm_enchant_layer then
                    self:openEqmEnchantConfirm(true)
                end
                break
            end
        end
    end)
end

function EquipTips:addDataBindEvent()
    --æ³¨å†Œé“å…· goodsvoçš„å˜åŒ–äº‹ä»¶..å±žæ€§å˜åŒ–äº†æ‰åˆ·æ–°
    if self.partner_id == nil or self.partner_id == 0 then
        if self.data and self.data.Bind and self.item_update_event == nil then
            self.item_update_event = self.data:Bind(GoodsVo.UPDATE_GOODS_ATTR, function(key, value) 
                if key == "holy_eqm_attr" then
                    self:initData()
                end
            end)
        end
    end
end

--å…³é—­
function EquipTips:onClickCloseBtn()
    controller:openEquipTips(false)
end


function EquipTips:openEqmEnchantConfirm(is_refresh)
    if not self.data or not self.item_config then return end
    local partner_id = self.partner_id or 0
    local item_id = self.data.id or 0
    if partner_id == 0 or item_id == 0 then return end

    local now_lev = self.data.enchant or self.data.enchant_level or 0
    local next_lev = now_lev + 1
    local max_cfg = Config.PartnerEqmData.data_partner_const_fun and Config.PartnerEqmData.data_partner_const_fun("max_lev")
    local max_lev = (max_cfg and max_cfg.val) or 100
    local is_max = now_lev >= max_lev

    local now_cfg = nil
    if now_lev > 0 then
        now_cfg = Config.PartnerEqmData.data_partner_eqm(getNorKey(self.item_config.type, now_lev))
    end
    local next_cfg = nil
    if not is_max then
        next_cfg = Config.PartnerEqmData.data_partner_eqm(getNorKey(self.item_config.type, next_lev))
    end
    if not is_max and not next_cfg then
        message("Thiếu cấu hình cường hóa")
        return
    end

    if self.eqm_enchant_layer then
        self.eqm_enchant_layer:removeFromParent()
        self.eqm_enchant_layer = nil
    end

    local screen_w = SCREEN_WIDTH or display.width
    local screen_h = SCREEN_HEIGHT or display.height
    local layer = ccui.Layout:create()
    layer:setContentSize(cc.size(screen_w, screen_h))
    layer:setBackGroundColorType(1)
    layer:setBackGroundColor(cc.c3b(0, 0, 0))
    layer:setBackGroundColorOpacity(165)
    layer:setTouchEnabled(true)
    self.root_wnd:addChild(layer, 999)
    self.eqm_enchant_layer = layer

    local panel = ccui.Layout:create()
    panel:setContentSize(cc.size(680, 840))
    panel:setAnchorPoint(cc.p(0.5, 0.5))
    panel:setPosition(cc.p(screen_w * 0.5, screen_h * 0.5))
    panel:setBackGroundColorType(1)
    panel:setBackGroundColor(cc.c3b(226, 204, 165))
    panel:setBackGroundColorOpacity(255)
    layer:addChild(panel)

    local function add_txt(text, x, y, size, color, ap, width)
        local label = createLabel(size or 22, color or cc.c3b(91, 54, 34), nil, x, y, text, panel, nil, ap or cc.p(0.5, 0.5))
        label:setLocalZOrder(10)
        if width and label.setDimensions then
            label:setDimensions(width, 0)
        end
        return label
    end

    local function format_num(num)
        num = tonumber(num) or 0
        if num >= 1000000000 then
            return string_format("%.1fB", num / 1000000000)
        elseif num >= 1000000 then
            return string_format("%.1fM", num / 1000000)
        elseif num >= 10000 then
            return string_format("%.1fK", num / 1000)
        else
            return tostring(num)
        end
    end

    local function attr_value_text(attr_key, attr_val)
        if PartnerCalculate.isShowPerByStr(attr_key) == true then
            return (attr_val * 0.1).."%"
        end
        return tostring(attr_val)
    end

    local function add_attr_line(v, x, y, width)
        local attr_key = v[1]
        local attr_val = v[2]
        local attr_name = Config.AttrData.data_key_to_name[attr_key] or tostring(attr_key)
        local icon = PathTool.getAttrIconByStr(attr_key)
        local label = createRichLabel(21, cc.c4b(0x21, 0x91, 0x2d, 0xff), cc.p(0, 0.5), cc.p(x, y), nil, nil, width or 230)
        panel:addChild(label, 10)
        local value_text = attr_value_text(attr_key, attr_val)
        local attr_str
        if icon then
            attr_str = string_format("<img src='%s' scale=0.9 /> <div fontcolor=#6b4b30>%s: </div><div fontcolor=#15912d>+%s</div>", PathTool.getResFrame("common", icon), attr_name, value_text)
        else
            attr_str = string_format("<div fontcolor=#6b4b30>%s: </div><div fontcolor=#15912d>+%s</div>", attr_name, value_text)
        end
        label:setString(attr_str)
        return label
    end

    local function add_cost_num(cost_map, bid, num)
        if bid == nil or num == nil then return end
        cost_map[bid] = (cost_map[bid] or 0) + num
    end

    local function get_reset_back_list(equip_type, lev)
        local cost_map = {}
        for i = 1, lev do
            local cfg = Config.PartnerEqmData.data_partner_eqm(getNorKey(equip_type, i))
            local expend_list = cfg and cfg.expend or {}
            for _, cost in ipairs(expend_list) do
                add_cost_num(cost_map, cost[1], cost[2])
            end
        end
        local list = {}
        for bid, num in pairs(cost_map) do
            table_insert(list, {bid = bid, num = num})
        end
        table.sort(list, function(a, b) return a.bid < b.bid end)
        return list
    end

    local function close_layer()
        if self.eqm_enchant_layer then
            self.eqm_enchant_layer:removeFromParent()
            self.eqm_enchant_layer = nil
        end
    end

    local title_bg = ccui.Layout:create()
    title_bg:setContentSize(cc.size(340, 56))
    title_bg:setAnchorPoint(cc.p(0.5, 0.5))
    title_bg:setPosition(cc.p(340, 825))
    title_bg:setBackGroundColorType(1)
    title_bg:setBackGroundColor(cc.c3b(37, 36, 48))
    title_bg:setBackGroundColorOpacity(245)
    panel:addChild(title_bg, 20)
    createLabel(28, cc.c3b(255, 236, 190), cc.c3b(82, 42, 21), 170, 28, "Cường Hóa Trang Bị", title_bg, 2, cc.p(0.5, 0.5))

    local close_btn = ccui.Layout:create()
    close_btn:setContentSize(cc.size(58, 58))
    close_btn:setAnchorPoint(cc.p(0.5, 0.5))
    close_btn:setPosition(cc.p(672, 806))
    close_btn:setTouchEnabled(true)
    panel:addChild(close_btn, 30)
    createLabel(44, cc.c3b(255, 219, 62), cc.c3b(105, 55, 0), 29, 29, "X", close_btn, 2, cc.p(0.5, 0.5))
    close_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            close_layer()
        end
    end)

    local equip_item = BackPackItem.new(true, true, nil, 0.95, false)
    equip_item:setBaseData(self.item_config.id)
    equip_item:setPosition(cc.p(340, 720))
    panel:addChild(equip_item, 12)
    equip_item:setScale(1.05)
    add_txt(self.item_config.name or "", 340, 632, 24, cc.c3b(105, 75, 48), cc.p(0.5, 0.5), 500)

    add_txt("Hiện Tại", 195, 590, 24, cc.c3b(105, 75, 48))
    add_txt("+"..now_lev, 195, 558, 34, cc.c3b(210, 92, 0))
    add_txt("Cấp Kế Tiếp", 485, 590, 24, cc.c3b(105, 75, 48))
    add_txt(is_max and "MAX" or ("+"..next_lev), 485, 558, 34, cc.c3b(210, 92, 0))

    local left_y = 485
    if now_cfg and now_cfg.add then
        for _, v in ipairs(now_cfg.add) do
            add_attr_line(v, 70, left_y, 280)
            left_y = left_y - 34
        end
    else
        add_txt("Cường hóa +0", 95, left_y, 21, cc.c3b(21, 145, 45), cc.p(0, 0.5), 220)
    end

    local right_y = 485
    if next_cfg and next_cfg.add then
        for _, v in ipairs(next_cfg.add) do
            add_attr_line(v, 370, right_y, 280)
            right_y = right_y - 34
        end
    elseif is_max then
        add_txt("Đã đạt cấp tối đa", 355, right_y, 21, cc.c3b(21, 145, 45), cc.p(0, 0.5), 220)
    end

    add_txt("Nguyên liệu", 340, 370, 25, cc.c3b(105, 75, 48))
    local cost_list = {}
    local backpack_model = BackpackController:getInstance():getModel()
    local expend = (next_cfg and next_cfg.expend) or {}
    local pos_list = {{255, 265}, {425, 265}, {255, 145}, {425, 145}}
    for i, v in ipairs(expend) do
        if i <= 4 then
            local bid = v[1]
            local num = v[2]
            local have_num = backpack_model:getItemNumByBid(bid) or 0
            table_insert(cost_list, {bid = bid, num = num, have = have_num})
            local px = pos_list[i][1]
            local py = pos_list[i][2]
            local item = BackPackItem.new(false, true, nil, 0.72, false)
            item:setBaseData(bid)
            item:setPosition(cc.p(px, py + 16))
            panel:addChild(item, 12)
            local color = cc.c3b(255, 255, 255)
            if have_num < num then color = cc.c3b(225, 45, 45) end
            local num_bg = ccui.Layout:create()
            num_bg:setContentSize(cc.size(112, 26))
            num_bg:setAnchorPoint(cc.p(0.5, 0.5))
            num_bg:setPosition(cc.p(px, py - 30))
            num_bg:setBackGroundColorType(1)
            num_bg:setBackGroundColor(cc.c3b(0, 0, 0))
            num_bg:setBackGroundColorOpacity(185)
            panel:addChild(num_bg, 20)
            createLabel(19, color, cc.c3b(30, 20, 10), 56, 13, format_num(have_num).."/"..format_num(num), num_bg, 2, cc.p(0.5, 0.5))
        end
    end

    local reset_have = backpack_model:getItemNumByBid(EQM_ENCHANT_RESET_ITEM) or 0
    local reset_item = BackPackItem.new(false, true, nil, 0.62, false)
    reset_item:setBaseData(EQM_ENCHANT_RESET_ITEM)
    reset_item:setPosition(cc.p(88, 430))
    panel:addChild(reset_item, 12)
    local reset_color = cc.c3b(255, 255, 255)
    if reset_have < EQM_ENCHANT_RESET_NUM then reset_color = cc.c3b(225, 45, 45) end
    add_txt("Đá phân giải: "..format_num(reset_have).."/"..format_num(EQM_ENCHANT_RESET_NUM), 142, 442, 18, reset_color, cc.p(0, 0.5), 220)

    local reset_back_list = get_reset_back_list(self.item_config.type, now_lev)
    local reset_back_text = "Hoàn trả: không có nguyên liệu"
    if #reset_back_list > 0 then
        reset_back_text = "Hoàn trả toàn bộ nguyên liệu đã nâng ("..#reset_back_list.." loại)"
    end
    add_txt(reset_back_text, 142, 414, 17, cc.c3b(21, 145, 45), cc.p(0, 0.5), 500)

    local function add_btn(text, x, cb)
        local btn = ccui.Layout:create()
        btn:setContentSize(cc.size(170, 58))
        btn:setAnchorPoint(cc.p(0.5, 0.5))
        btn:setPosition(cc.p(x, 45))
        btn:setBackGroundColorType(1)
        btn:setBackGroundColor(cc.c3b(247, 202, 76))
        btn:setBackGroundColorOpacity(255)
        btn:setTouchEnabled(true)
        panel:addChild(btn, 20)
        createLabel(24, cc.c3b(255, 255, 230), cc.c3b(95, 50, 0), 85, 29, text, btn, 2, cc.p(0.5, 0.5))
        btn:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                cb()
            end
        end)
        return btn
    end

    local function do_strength()
        if is_max then
            message("Đã cường hóa tối đa")
            return
        end
        for _, v in ipairs(cost_list) do
            if v.have < v.num then
                local item_cfg = Config.ItemData.data_get_data(v.bid)
                local lack_name = item_cfg and item_cfg.name or tostring(v.bid)
                message("Thiếu nguyên liệu: "..lack_name)
                return
            end
        end
        controller:sender11013(partner_id, item_id)
    end

    local function do_reset()
        if now_lev <= 0 then
            message("Trang bị đang +0")
            return
        end
        if reset_have < EQM_ENCHANT_RESET_NUM then
            local item_cfg = Config.ItemData.data_get_data(EQM_ENCHANT_RESET_ITEM)
            local lack_name = item_cfg and item_cfg.name or tostring(EQM_ENCHANT_RESET_ITEM)
            message("Thiếu đá phân giải: "..lack_name)
            return
        end
        local tips_str = "Phân giải sẽ đưa trang bị về +0 và hoàn trả toàn bộ nguyên liệu đã cường hóa. Tiếp tục?"
        CommonAlert.show(tips_str, TI18N("语言_c_63"), function()
            controller:sender11083(partner_id, item_id)
            close_layer()
        end, TI18N("语言_c_62"), nil, CommonAlert.type.common)
    end

    add_btn("Cường Hóa", 255, do_strength)
    add_btn("Tự Động", 425, do_strength)
    add_btn("Phân Giải", 595, do_reset)
end
function EquipTips:onTabBtn2()
    if not self.data then return end
    if not self.item_config then return end
    -- if self.is_need == false then 
    --     message(self.tab_btn_2.need_str)
    --     return
    -- end
    if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
        --ç¥žè£…çš„æ˜¯æ´—ç»ƒ
        HeroController:getInstance():openHolyequipmentRefreshAttPanel(true, self.data, self.partner_id)
    elseif self.cloth_type == PartnerConst.EqmTips.partner then
        self:openEqmEnchantConfirm()
    end
end

--å¸ä¸‹å’Œå‡ºå”®
function EquipTips:onTabBtn1()
    if not self.data or not self.data.id or not self.item_config then return end
    if self.cloth_type ==  PartnerConst.EqmTips.backpack then  --1æ˜¯å‡ºå”®
        if isNoSellEquipItemType(self.item_config.type or self.data.type, self.item_config) then
            message("Vật phẩm này không thể bán")
            return
        end
        
        if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
            local color = BackPackConst.getWhiteQualityColorStr(self.item_config.quality)
            local str = string.format(TI18N("语言_c_3050"), color,self.item_config.name)
            controller:openHeroResetOfferPanel(true, {{item_id=self.data.id}}, false, function()
                    if HeroController:getInstance():getModel():checkHolyEquipmentPalnByItemID(self.data.id) then
                        local tips_str = TI18N("语言_c_3051")
                        CommonAlert.show(tips_str, TI18N("语言_c_63"), function()
                            controller:sender11089({{item_id=self.data.id}})
                        end, TI18N("语言_c_62"), nil, CommonAlert.type.common)
                    else
                        controller:sender11089({{item_id=self.data.id}})
                    end
            end, HeroConst.ResetType.eHolyEquipSell, str)    
        else
            BackpackController:getInstance():openItemSellPanel(true, self.data, BackPackConst.Bag_Code.EQUIPS)
        end
        controller:openEquipTips(false) 
    elseif self.cloth_type ==  PartnerConst.EqmTips.partner then --2æ˜¯å¸ä¸‹
        --è£…å¤‡å”¯ä¸€id
        if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
            if self.holy_data and self.holy_data.list then --ç¥žè£…æ–¹æ¡ˆå¸ä¸‹è£…å¤‡
                local partner_id = self.holy_data.partner_id or 0
                local list = {}
                --æ–¹æ¡ˆä¸­å·²æœ‰çš„è£…å¤‡
                if self.holy_data.list and next(self.holy_data.list) ~= 0 then
                    for k,v in ipairs(self.holy_data.list) do
                        if v and v.item_id then
                            table.insert(list, {partner_id = v.partner_id, item_id = v.item_id})
                        end
                    end
                end
                --å¸ä¸‹çš„è£…å¤‡
                for i=#list,1,-1 do
                    if list[i] and list[i].item_id == self.data.id then
                        table.remove(list, i)
                    end
                end
                controller:sender25221(self.holy_data.id, partner_id, self.holy_data.name, list)
            else
                if HeroController:getInstance():getModel():isOpenHolyEquipMentByHerovo(self.partner) == false then
                    local str = TI18N("语言_c_3052")
                    local function fun()
                        controller:sender11093(self.partner_id, self.data.id, 0)
                        controller:openEquipTips(false)
                    end
                    CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, nil, nil, true)
                    return
                end
                controller:sender11093(self.partner_id, self.data.id, 0)
            end
        else 
            controller:sender11011(self.partner_id, self.data.id)
        end

        controller:openEquipTips(false)
    end
end
--ç©¿æˆ´å’Œæ›´æ¢
function EquipTips:onTabBtn3()
    if not self.data then return end
    if not self.item_config then return end
    local partner_id = self.partner_id or 0
    local item_id = self.data.id or 0
    local pos_id = self.item_config.type or 0
    if self.cloth_type ==  PartnerConst.EqmTips.backpack then  --1æ˜¯ç©¿æˆ´
        if partner_id == 0  then 
            MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.partner,1)
        else
            controller:sender11010(partner_id,item_id)
        end
        
    elseif self.cloth_type ==  PartnerConst.EqmTips.partner then --2æ˜¯æ›´æ¢
        if self.holy_data and self.holy_data.list then --ç¥žè£…æ–¹æ¡ˆæ›´æ¢è£…å¤‡
            controller:openHeroHolyEquipClothPanel(true, pos_id, 0, self.data, self.holy_data, HeroConst.EnterType.eHolyPlan,nil,self.holy_data.equip_list)
        else
            if BackPackConst.checkIsHolyEquipment(pos_id) then
                local is_open = HeroController:getInstance():getModel():isOpenHolyEquipMentByHerovo(self.partner)
                if not is_open then
                    message(TI18N("语言_c_4385"))
                    return
                end
                controller:openHeroHolyEquipClothPanel(true, pos_id, self.partner_id, self.data,nil,nil,self.partner)
            else
                controller:openEquipPanel(true, pos_id, self.partner_id, self.data)
            end
        end
    end
    controller:openEquipTips(false)
end

--æ»¡è¶³åˆæˆæ¡ä»¶
function EquipTips:onTabBtn4(sender)
    --å…ˆå¼¹å‡ºåˆæˆé¢„è§ˆ
    local _call_back = function()
        -- print("EquipTips--------- onTabBtn4 ===", self.partner_id, self.data.base_id)
        controller:sender11084(self.partner_id, self.data.base_id)
    end
    local data = {
        call_back = _call_back,
        coin = sender.up_equip.cost_coin,
        list = sender.up_equip.compose_list,
        cost_item_list = sender.up_equip.cost_list,
    }
    controller:openHeroTargetEquipmentSynthesisWindow(true,data)
    controller:openEquipTips(false) 
end
--[[
    @desc: æ‰“å¼€æ—¶å€™é™„åŠ çš„å‚æ•°
    author:{author}
    time:2019-05-19 19:48:51
    --@object: {data=data, open_type=open_type, partner=partner, holy_data=holy_data}
    @return:
]]
function EquipTips:openRootWnd(object)
    self.data = object.data
    self.cloth_type = object.open_type or PartnerConst.EqmTips.normal
    self.partner = object.partner
    if self.partner then
        self.partner_id = self.partner.partner_id
    end
    self.holy_data = object.holy_data
    -- å› ä¸ºä¼ å‚ä¸åŒ,è¿™è¾¹éœ€è¦èŽ·å–ä¸åŒçš„é…ç½®æ•°æ®
    local data = object.data
    local item_config = nil
    if type(data) == "number" then
        item_config = Config.ItemData.data_get_data(data)
    else
        if data.config then
            item_config = data.config
        else
            if data.bid then
                item_config = Config.ItemData.data_get_data(data.bid)
            elseif data.id then
                item_config = Config.ItemData.data_get_data(data.id)
            else
                item_config = data
            end
        end
    end
    self.item_config = item_config
    if self.item_config == nil then return end
    self:initData()
    self:addDataBindEvent()

    --é™è´­INXS
    -- self:initLimitBuyInfo()
end

--é™è´­ä¿¡æ¯
--data.limit_total_num = é™è´­æœ€å¤§æ•°é‡
--data.limit_day  æ¯æ—¥é™è´­æ•°é‡
--data.å…¶ä»–é™è´­æœªåŠ å…¥
function EquipTips:initLimitBuyInfo()
    if not self.data then return end
    if self.data.limit_day then --æ¯æ—¥é™è´­
        local total_count = self.data.limit_total_num or 0
        local label = self:getLimitBuytLabel()
        if lable then
            lable:setString(string_format(TI18N("语言_c_1713"), self.data.limit_day, total_count))
        end
    end
end

function EquipTips:getLimitBuytLabel()
    if self.limit_buy_label == nil then
        self.limit_buy_label = createRichLabel(22, cc.c4b(0xff,0xee,0xdd,0xff), cc.p(0, 0.5), cc.p(0, 36) ,nil,nil,1000)
        self.main_container:addChild(self.limit_buy_label)
    end
    return self.limit_buy_label
end

function EquipTips:getEqmEnchantAttrList()
    if not self.data or not self.item_config or not Config.PartnerEqmData then return {} end
    local enchant = self.data.enchant or self.data.enchant_level or 0
    if enchant <= 0 then return {} end
    local cfg = Config.PartnerEqmData.data_partner_eqm(getNorKey(self.item_config.type, enchant))
    if cfg and cfg.add then
        return cfg.add
    end
    return {}
end

function EquipTips:calcBaseAttrPanelHeight()
    if not self.item_config or not self.item_config.ext or not self.item_config.ext[1] then
        return self.baseattr_panel_height or 76
    end
    local base_count = 0
    for _, v in ipairs(self.item_config.ext[1][2] or {}) do
        if Config.AttrData.data_key_to_name[v[1]] then
            base_count = base_count + 1
        end
    end
    local enchant_count = #self:getEqmEnchantAttrList()
    local base_rows = math.max(1, math.ceil(base_count / 2))
    local total_rows = base_rows
    if enchant_count > 0 then
        total_rows = total_rows + 1 + math.ceil(enchant_count / 2)
    end
    local height = 52 + total_rows * 28
    return math.max(self.baseattr_panel_height or 76, height)
end

function EquipTips:initData()
     --åŽŸæœ¬é«˜åº¦
    local target_height  = self.container_init_size.height
    local baseattr_height = self:calcBaseAttrPanelHeight()
    if self.baseattr_panel and baseattr_height > (self.baseattr_panel_height or 0) then
        target_height = target_height + baseattr_height - (self.baseattr_panel_height or 0)
        self.baseattr_panel:setContentSize(cc.size(self.baseattr_panel:getContentSize().width, baseattr_height))
    end
    --æ˜¯å¦æ˜¾ç¤ºéšæœºå±žæ€§-------------å¼€å§‹ --ç¥žè£…æ‰æœ‰
    local need_show_randomattr = false
    if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
        need_show_randomattr = true
    end
    local randomattr_height = 0
    if need_show_randomattr then
        --éšæœºå±žæ€§ï¼ˆä»…å½“ä¸ºç¥žè£…å›¾é‰´çš„æ—¶å€™ä¼šå¸¦å‚æ•°ï¼‰
        randomattr_height = self:setRandomAttrInfo(self.data.lustr_status)
        if randomattr_height > 0 then
            target_height = target_height + randomattr_height
        else
            randomattr_height = 0
            self.randomattr_panel:setVisible(false)
            need_show_randomattr = false
        end
    else
        self.randomattr_panel:setVisible(false)
    end
    --æ˜¯å¦æ˜¾ç¤ºéšæœºå±žæ€§----------ç»“æŸ

    --æ˜¯å¦æ˜¾ç¤ºå¥—è£…å±žæ€§-----------å¼€å§‹
    local need_show_suitattr = false
    local need_show_skill = nil
    local suitattr_height = 0

    if self.item_config.eqm_set ~= 0 then
        if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
            self.suit_config = Config.PartnerHolyEqmData.data_suit_info[self.item_config.eqm_set]
        elseif self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--æ™®é€šè£…å¤‡ 
            self.suit_config = Config.PartnerEqmData.data_eqm_suit[self.item_config.eqm_set]
        end

        if self.suit_config then
            need_show_suitattr = true
            table_sort( self.suit_config, function(a, b) return a.num < b.num end)
        end
    end
    if need_show_suitattr then
        suitattr_height, need_show_skill = self:setSuitAttrInfo()
        if suitattr_height > 0 then
            target_height = target_height + suitattr_height
        else
            suitattr_height = 0
            self.suitattr_panel:setVisible(false)
            need_show_suitattr = false
        end
    else
        self.suitattr_panel:setVisible(false)
    end
    --æ˜¯å¦æ˜¾ç¤ºå¥—è£…å±žæ€§-----------ç»“æŸ
    
    --æ˜¯å¦æ˜¾ç¤ºæŠ€èƒ½ ------------ å¼€å§‹ ç¥žè£…æ‰æœ‰ å¿…é¡»åœ¨å¥—è£…å±žæ€§ä¹‹åŽ å› ä¸ºåˆ¤æ–­åœ¨å¥—è£…æ•°æ®é‡Œé¢
    if self.item_config.sub_type ~= BackPackConst.item_tab_type.HOLYEQUIPMENT then 
        --ä¸æ˜¯ç¥žè£…æ²¡æœ‰æŠ€èƒ½æ˜¾ç¤º
        need_show_skill = nil
    end
    if need_show_skill ~= nil then
        local config = Config.SkillData.data_get_skill(need_show_skill)
        if config then
            target_height = target_height + self.skill_panel_height
            if self.skill_item == nil then
                self.skill_item = self:createSkillItem(self.skill_panel)
            end
            self.skill_item.skill:showLockIcon(false)
            self.skill_item.skill:setData(config)
            -- self.skill_item.name:setString(config.name)
            self.skill_item.desc:setString(config.des)
        else
            need_show_skill = false
        end
    end

    --æ˜¯å¦æ˜¾ç¤ºæŠ€èƒ½ ------------ ç»“æŸ

    -- æ˜¯å¦æ˜¾ç¤ºæŒ‰é’®éƒ¨åˆ†
    local need_show_btn = (self.cloth_type == PartnerConst.EqmTips.backpack or self.cloth_type == PartnerConst.EqmTips.partner)   
    if need_show_btn then
        self:updateBtnList()
    else
        target_height = target_height - self.tab_panel_height
        self.tab_panel:setVisible(false)
    end

    --å…¬ä¼šå®åº“æ—¶é—´
    if self.data and self.data.is_market_place and next( self.data.end_time) ~= nil then
        self.market_time_label = createRichLabel(24, cc.c4b(0xff,0x9b,0x1e,0xff), cc.p(0, 1), cc.p(17, -10000), 8, nil, 1000) 
        self.container:addChild(self.market_time_label)
        local time = self.data.end_time[1].end_unixtime or 0
        local count = self.data.end_time[1].end_num or 1
        local str 
        local time = time - GameNet:getInstance():getTime()
        if time < 0 then
            time = 0
        end
        if time <= 0 then
            str = string.format(TI18N("语言_c_1715"), count)
        else
            str = string.format(TI18N("语言_c_1714"), count, TimeTool.GetTimeFormatDayIIIIII(time))    
        end 
        self.market_time_label:setString(str)
        local size = self.market_time_label:getContentSize()
        target_height = target_height + size.height
    end

    if target_height ~= self.container_init_size.height then
        self.container:setContentSize(cc.size(self.container_init_size.width, target_height))
        local y = target_height - 4
        self.base_panel:setPositionY(y) --åŸºæœ¬ä¿¡æ¯
        self.close_btn:setPositionY(y - 11)
        y = y - self.base_panel:getContentSize().height 
        self.baseattr_panel:setPositionY(y) --åŸºç¡€å±žæ€§
        y = y - self.baseattr_panel:getContentSize().height

        if need_show_randomattr then --éšæœºå±žæ€§
            self.randomattr_panel:setPositionY(y)
            y = y - randomattr_height
        end

        if need_show_suitattr then --å¥—è£…å±žæ€§
            self.suitattr_panel:setPositionY(y)
            y = y -  suitattr_height
        end

        if need_show_skill then --æŠ€èƒ½æ˜¾ç¤º
            self.skill_panel:setPositionY(y)
            y = y - self.skill_panel_height --æŠ€èƒ½æ˜¾ç¤ºçš„é«˜ç›®å‰æ˜¯å†™æ­»çš„
        end

        self.desc_panel:setPositionY(y)
        if need_show_btn then
            y = y - self.desc_panel:getContentSize().height
            self.tab_panel:setPositionY(y)
        end
        --å…¬ä¼šå®åº“æ—¶é—´ --å› ä¸ºä¸Ž need_show_btnæ˜¯äº’æ–¥çš„æ‰€ä»¥ä¸åšå…¼å®¹å¤„ç†äº†
        if self.data and self.data.is_market_place then
            y = y - self.desc_panel:getContentSize().height
            self.market_time_label:setPositionY(y)
        end
    end

    self:setBaseInfo()
    self:setBaseAttrInfo()
end

function EquipTips:updateBtnList()
    self.tab_btn_3:setVisible(true)
    self.tab_btn_2:setVisible(false)
    self.tab_btn_4:setVisible(false)
    if self.cloth_type == PartnerConst.EqmTips.backpack then  --ç©¿æˆ´
        self.tab_btn_1:setVisible(true)
        self.tab_btn_3:setTitleText(TI18N("语言_c_2959"))
        self.tab_btn_1:setTitleText(TI18N("语言_c_1319"))
        self.tab_btn_1:setTouchEnabled(true)
        setChildUnEnabled(false, self.tab_btn_1)
        if self.item_config and isNoSellEquipItemType(self.item_config.type or (self.data and self.data.type), self.item_config) then
            self.tab_btn_1:setTitleText("")
            self.tab_btn_1:setTouchEnabled(false)
            setChildUnEnabled(true, self.tab_btn_1)
        end
    elseif self.cloth_type == PartnerConst.EqmTips.partner then  --å¸ä¸‹
        --åˆ¤å®šçº¢ç‚¹
        --ä¸æ˜¯ç¥žè£…æ‰åˆ¤æ–­çº¢ç‚¹
        if self.item_config and self.item_config.sub_type ~= BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
            local is_redpoint = HeroCalculate.checkSingleHeroEachPosEquipRedPoint(self.data.type,self.data)
            addRedPointToNodeByStatus(self.tab_btn_3, is_redpoint, 5, 5)

            --èƒ½åˆæˆæ›´é«˜ä¸€çº§çš„è£…å¤‡æ‰æ˜¾ç¤º
            local is_redpoint, up_equip = HeroCalculate.checkSingleHeroEquipComposeRedPoint(self.data)
            addRedPointToNodeByStatus(self.tab_btn_4, is_redpoint, 5, 5)
            self.tab_btn_4:setVisible(is_redpoint and model:checkEquipComposeIsOpen())
            self.tab_btn_4.up_equip = up_equip
        end
        self.tab_btn_4:setVisible(false)
        self.tab_btn_4.up_equip = nil
        self.tab_btn_2:setVisible(true)
        self.tab_btn_2:setTouchEnabled(true)
        setChildUnEnabled(false, self.tab_btn_2)
        self.tab_btn_2:setTitleText("Cường Hóa")

        self.tab_btn_3:setTitleText(TI18N("语言_c_1966"))
        self.tab_btn_1:setTitleText(TI18N("语言_c_2964"))
    else
        self.tab_btn_3:setVisible(false)
        -- self.tab_btn_2:setVisible(false)
    end
    if self.item_config and self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
        self.tab_btn_2:setVisible(true)
        self.look_btn:setVisible(true)
        if self.item_config.eqm_jie <= 0 then
            setChildUnEnabled(true, self.tab_btn_2)
            self.tab_btn_2:setTitleText(TI18N("语言_c_3053"))
            self.tab_btn_2:setTouchEnabled(false)
        end
    end

    -- åªè¦ä¸æ˜¯æ¥è‡ªè‡ªå·±ä¼™ä¼´èº«ä¸Šçš„
    if self.cloth_type ~= PartnerConst.EqmTips.partner then
        -- self.tab_btn_1:setVisible(false)
    end
    
end

--==============================--
--desc:è®¾ç½®åŸºç¡€å±žæ€§
--time:2018-10-20 09:40:23
--@return 
--==============================--
function EquipTips:setBaseInfo()
    if self.data == nil or self.item_config == nil then return end
    local data = self.data

    if type(data) == "table" then
        self.equip_item:setData(data)
        self.equip_item:setEnchantLev(data.enchant or 0)
    else
        self.equip_item:setBaseData(self.item_config.id)
    end
    -- self.equip_item:setEquipJie(true)

    local name = self.item_config.name or ""
    local str = name
    local enchant = data.enchant or 0
    if enchant > 0 then 
        str = str .. "+" .. enchant
    end
    self.name:setString(str)

    local quality = 0
    if self.item_config.quality and self.item_config.quality >= 0 and self.item_config.quality <= 5 then
        quality = self.item_config.quality
    end
    local background_res = PathTool.getResFrame("tips", "tips_"..quality)
    if self.record_background_res == nil or self.record_background_res ~= background_res then
        self.record_background_res = background_res
        loadSpriteTexture(self.base_panel, background_res, LOADTEXT_TYPE_PLIST) 
    end
    local color = BackPackConst.getEquipTipsColor(quality)
    self.name:setTextColor(color) 
    
    if self.item_config.type_desc then
        self.equip_type:setString(TI18N("语言_c_1728")..self.item_config.type_desc)
    end

    if self.item_config.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --ç¥žè£…
        self.score_title:setVisible(true)
        self.power_label:setVisible(true)
        
        local sore = self:getHolyEquipScore() or 0
        self.power_label:setNum(sore)
        --æ˜¾ç¤ºæè¿°
        
        if self.chapter_label == nil then
            local config = Config.PartnerHolyEqmData.data_base_info(self.item_config.id)
            if config then
                self.chapter_label = createLabel(18, cc.c4b(0xd9,0x50,0x14,0xff), nil, 410, 66, config.unlock_desc, self.baseattr_panel, nil, cc.p(1,0.5))
            end
        end
        
        local id = math.floor(self.item_config.eqm_set/100)
        -- local config = Config.PartnerHolyEqmData.data_suit_res_prefix_fun(id)
        -- if config then
        --     local res = PathTool.getSuitRes(config.prefix)
        --     if self.record_suit_res == nil or self.record_suit_res ~= res then
        --         self.record_suit_res = res
        --         loadSpriteTexture(self.suit_icon, res, LOADTEXT_TYPE)
        --     end
        --     self.suit_name:setString(config.name)
        -- end
    else--if self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--æ™®é€šè£…å¤‡ 
        self.score_title:setVisible(true)
        self.power_label:setVisible(true)
        
        local score = data.score or 0
        if score <= 0 then 
            score = self:getBaseScore() or 0
        end
        local all_score = data.all_score or 0
        all_score = math.max(all_score,score)
        self.power_label:setNum(all_score)
    end

    -- æè¿°
    self.desc_label:setString(self.item_config.desc)
    local label_siez = self.desc_label:getContentSize()
    local max_height = math.max(label_siez.height, self.scroll_size.height)
    self.scroll_view:setInnerContainerSize(cc.size(self.scroll_size.width, max_height))
    self.desc_label:setPositionY(max_height-10)
end

--==============================--
--desc:è®¾ç½®åŸºç¡€å±žæ€§
--time:2018-10-20 11:42:16
--@return 
--==============================--
function EquipTips:setBaseAttrInfo()
    if not self.item_config or not self.item_config.ext or not self.item_config.ext[1] then return end
    local base_attr = self.item_config.ext[1][2] or {}
    local panel_h = self.baseattr_panel:getContentSize().height
    local title_label = self.baseattr_panel:getChildByName("label")
    if title_label then
        title_label:setString("Chỉ số cơ bản")
        title_label:setPositionY(panel_h - 17)
    end

    local index = 1
    local function set_attr_label(attr_key, attr_val, row_index, value_color)
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if not attr_name then return false end
        if not self.base_list[index] then
            self.base_list[index] = createRichLabel(18, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 28), nil, nil, 205)
            self.baseattr_panel:addChild(self.base_list[index])
        end
        local label = self.base_list[index]
        label:setVisible(true)
        local _x = 24 + ((row_index - 1) % 2) * 210
        local _y = panel_h - 50 - math.floor((row_index - 1) / 2) * 28
        label:setPosition(cc.p(_x, _y))

        local icon = PathTool.getAttrIconByStr(attr_key)
        local is_per = PartnerCalculate.isShowPerByStr(attr_key)
        if is_per == true then
            attr_val = (attr_val*0.1).."%"
        end
        local color = value_color or "#ffeedd"
        local attr_str = string_format("<img src='%s' scale=0.8 /> <div fontcolor=#c1b7ab> %s: </div><div fontcolor=%s>%s</div>", PathTool.getResFrame("common", icon), attr_name, color, attr_val)
        label:setString(attr_str)
        index = index + 1
        return true
    end

    local row_index = 1
    for _, v in ipairs(base_attr) do
        if set_attr_label(v[1], v[2], row_index) then
            row_index = row_index + 1
        end
    end

    local enchant_attr = self:getEqmEnchantAttrList()
    if #enchant_attr > 0 then
        local base_rows = math.max(1, math.ceil((row_index - 1) / 2))
        local ench_title_y = panel_h - 50 - base_rows * 28 - 8
        if not self.eqm_enchant_attr_title then
            self.eqm_enchant_attr_title = createLabel(18, cc.c4b(0xfe,0xee,0xba,0xff), nil, 24, ench_title_y, "Chỉ số cường hóa", self.baseattr_panel, nil, cc.p(0, 0.5))
        else
            self.eqm_enchant_attr_title:setVisible(true)
            self.eqm_enchant_attr_title:setPositionY(ench_title_y)
            self.eqm_enchant_attr_title:setString("Chỉ số cường hóa")
        end
        row_index = base_rows * 2 + 3
        for _, v in ipairs(enchant_attr) do
            if set_attr_label(v[1], v[2], row_index, "#2df05c") then
                row_index = row_index + 1
            end
        end
    elseif self.eqm_enchant_attr_title then
        self.eqm_enchant_attr_title:setVisible(false)
    end

    for i = index, #self.base_list do
        if self.base_list[i] then
            self.base_list[i]:setVisible(false)
        end
    end
end
--å›¾é‰´çš„éšæœºå±žæ€§
function EquipTips:setLustrAtt()
    if self.item_config.eqm_jie then
        local const = Config.PartnerHolyEqmData.data_const
        if self.item_config.eqm_jie == 0 then
            local pos = {29,-9}
            for i=1,2 do
                local lustr_att = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(24,pos[i]),-10,nil,500)
                self.randomattr_panel:addChild(lustr_att)
                local str = ""
                if i == 1 then
                    str = const.text_show_1.desc
                else
                    str = const.text_show_2.desc
                end
                lustr_att:setString(str)
            end
            self.pre_btn:setVisible(false)
        elseif self.item_config.eqm_jie == 1 then
            local lustr_att = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(24,33),-4,nil,200)
            self.randomattr_panel:addChild(lustr_att)
            local attr_icon = PathTool.getAttrIconByStr("random")
            local msg = string.format(TI18N("语言_c_4542"),PathTool.getResFrame("common", attr_icon))
            lustr_att:setString(msg)

            local lustr_att2 = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(24,-9),-10,nil,500)
            self.randomattr_panel:addChild(lustr_att2)
            lustr_att2:setString(const.text_show_2.desc)
            self.pre_btn:setVisible(true)
        elseif self.item_config.eqm_jie == 2 then
            local pos = {29,-9}
            for i=1,2 do
                local lustr_att = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(24,pos[i]),-10,nil,200)
                self.randomattr_panel:addChild(lustr_att)
                local attr_icon = PathTool.getAttrIconByStr("random")
                local msg = string.format(TI18N("语言_c_4542"),PathTool.getResFrame("common", attr_icon))
                lustr_att:setString(msg)
            end
            self.pre_btn:setVisible(true)
        end
    end
end
