local math_floor = math.floor
local EQM_ENCHANT_RESET_ITEM = 10099
local EQM_ENCHANT_RESET_NUM = 1

local function isNoSellEquipItemType(item_type, item_config)
    item_type = tonumber(item_type) or 0
    if item_type == 110 or item_type == 111 or (item_type >= 51 and item_type <= 55) then
        return true
    end
    if item_config and item_config.type_desc == "Ngọc" then
        return true
    end
    return false
end

