    -- local status = model:getHeroCampListHaveUr(0)
    -- local index_2 = 0
    -- if status then
    --     index_2 = 1
    -- end
    -- self:onClickBtnShowByIndex(0,index_2, true)
    self:onClickBtnShowByIndex(0,0, true)
