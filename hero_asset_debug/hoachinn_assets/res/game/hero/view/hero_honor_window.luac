-- Hero honor upgrade test UI
HeroHonorWindow = HeroHonorWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()

local HonorName = {
    [915011] = "Danh hieu Thap",
    [915012] = "Danh hieu A",
    [915013] = "Danh hieu B"
}

local HonorDefault = {
    {honor_id = 915011, icon_id = 915011, lev = 0, max_lev = 10, item_id = 10091, item_num = 1, atk = 0, hp = 0, def = 0, desc = "Tat ca thuoc tinh +0%", base_atk = 60, base_hp = 300, base_def = 45},
    {honor_id = 915012, icon_id = 915011, lev = 0, max_lev = 10, item_id = 10090, item_num = 1, atk = 0, hp = 0, def = 0, desc = "Tat ca thuoc tinh +0%", base_atk = 250, base_hp = 1200, base_def = 0},
    {honor_id = 915013, icon_id = 915011, lev = 0, max_lev = 10, item_id = 10091, item_num = 1, atk = 0, hp = 0, def = 0, desc = "Tat ca thuoc tinh +0%", base_atk = 150, base_hp = 800, base_def = 0},
}

local function getHonorItemName(item_id)
    local config = Config.ItemData.data_get_data[item_id]
    if config and config.name then
        return config.name
    end
    return "item "..tostring(item_id or 0)
end

function HeroHonorWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Mini
    self.is_full_screen = false
    self.layout_name = "tips/honor_level_tips"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("common", "common"), type = ResourcesType.plist}
    }
end

function HeroHonorWindow:open_callback()
    if self.root_wnd then
        self.root_wnd:setVisible(false)
    end

    self.honor_root = ccui.Layout:create()
    self.honor_root:setContentSize(cc.size(SCREEN_WIDTH, SCREEN_HEIGHT))
    self.honor_root:setAnchorPoint(cc.p(0.5, 0.5))
    self.honor_root:setPosition(SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5)
    self.honor_root:setTouchEnabled(true)
    self:addChild(self.honor_root, 10)

    local mask = ccui.Layout:create()
    mask:setContentSize(cc.size(SCREEN_WIDTH, SCREEN_HEIGHT))
    mask:setBackGroundColorType(ccui.LayoutBackGroundColorType.solid)
    mask:setBackGroundColor(cc.c3b(0, 0, 0))
    mask:setBackGroundColorOpacity(120)
    mask:setTouchEnabled(true)
    self.honor_root:addChild(mask)

    self.panel = ccui.Layout:create()
    self.panel:setContentSize(cc.size(620, 520))
    self.panel:setAnchorPoint(cc.p(0.5, 0.5))
    self.panel:setPosition(SCREEN_WIDTH * 0.5, SCREEN_HEIGHT * 0.5)
    self.panel:setBackGroundColorType(ccui.LayoutBackGroundColorType.solid)
    self.panel:setBackGroundColor(cc.c3b(72, 45, 28))
    self.panel:setBackGroundColorOpacity(245)
    self.honor_root:addChild(self.panel)

    createLabel(30, cc.c3b(255, 238, 188), cc.c3b(80, 40, 20), 310, 482, "Nang cap danh hieu", self.panel, 2, cc.p(0.5, 0.5))
    self.close_btn = createButton(self.panel, "X", 580, 482, cc.size(58, 52), PathTool.getResFrame("common", "common_1017"), 28, Config.ColorData.data_color4[1])

    self.items = {}
    for i = 1, 3 do
        local item = self:createHonorItem(i)
        self.items[i] = item
    end
end

function HeroHonorWindow:createHonorItem(index)
    local y = 390 - (index - 1) * 135
    local item = ccui.Layout:create()
    item:setContentSize(cc.size(560, 118))
    item:setAnchorPoint(cc.p(0.5, 0.5))
    item:setPosition(310, y)
    item:setBackGroundColorType(ccui.LayoutBackGroundColorType.solid)
    item:setBackGroundColor(cc.c3b(104, 72, 42))
    item:setBackGroundColorOpacity(245)
    self.panel:addChild(item)

    item.icon_bg = ccui.Layout:create()
    item.icon_bg:setContentSize(cc.size(78, 78))
    item.icon_bg:setAnchorPoint(cc.p(0.5, 0.5))
    item.icon_bg:setPosition(54, 59)
    item.icon_bg:setBackGroundColorType(ccui.LayoutBackGroundColorType.solid)
    item.icon_bg:setBackGroundColor(cc.c3b(35, 25, 18))
    item:addChild(item.icon_bg)
    item.icon_txt = createLabel(34, cc.c3b(255, 220, 80), cc.c3b(80, 40, 20), 39, 39, tostring(index), item.icon_bg, 2, cc.p(0.5, 0.5))

    item.name = createLabel(23, cc.c3b(255, 238, 188), nil, 105, 92, "", item, nil, cc.p(0, 0.5))
    item.level = createLabel(20, cc.c3b(255, 255, 255), nil, 105, 66, "", item, nil, cc.p(0, 0.5))
    item.attr = createLabel(19, cc.c3b(180, 255, 170), nil, 105, 40, "", item, nil, cc.p(0, 0.5))
    item.cost = createLabel(18, cc.c3b(255, 225, 150), nil, 105, 18, "", item, nil, cc.p(0, 0.5))
    item.up_btn = createButton(item, "Tang cap", 478, 58, cc.size(128, 58), PathTool.getResFrame("common", "common_1017"), 22, Config.ColorData.data_color4[1])

    registerButtonEventListener(item.up_btn, function()
        if item.data and self.partner_id then
            controller:sender11084(self.partner_id, item.data.honor_id, 1)
        end
    end, true, 1)

    return item
end

function HeroHonorWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        controller:openHeroHonorWindow(false)
    end, true, 2)

    HeroEvent.Hero_Honor_Update_Event = HeroEvent.Hero_Honor_Update_Event or "HeroEvent.Hero_Honor_Update_Event"
    if self.honor_event == nil then
        self.honor_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Honor_Update_Event, function(data)
            self:updateHonorData(data)
        end)
    end
end

function HeroHonorWindow:openRootWnd(hero_vo)
    self.hero_vo = hero_vo
    self.partner_id = (hero_vo and (hero_vo.partner_id or hero_vo.id)) or 0
    self:updateHonorList(HonorDefault)
    if self.partner_id and self.partner_id > 0 then
        controller:sender11084(self.partner_id, 0, 0)
    end
end

function HeroHonorWindow:updateHonorData(data)
    if data == nil then return end
    if self.partner_id ~= nil and data.partner_id ~= self.partner_id then return end
    self:updateHonorList(data.honors or HonorDefault)
end

function HeroHonorWindow:updateHonorList(list)
    for i, item in ipairs(self.items) do
        local data = list[i] or HonorDefault[i]
        item.data = data
        local name = HonorName[data.honor_id] or ("Danh hieu "..tostring(data.honor_id))
        item.name:setString(name)
        item.level:setString("Cap: "..tostring(data.lev or 0).."/"..tostring(data.max_lev or 0))
        item.attr:setString(data.desc or ("ATK +"..tostring(data.atk or 0).."  HP +"..tostring(data.hp or 0).."  DEF +"..tostring(data.def or 0)))
        if (data.lev or 0) >= (data.max_lev or 0) then
            item.cost:setString("Da max cap")
            item.up_btn:setTouchEnabled(false)
            item.up_btn:setBright(false)
        else
            item.cost:setString("Ton: "..getHonorItemName(data.item_id).." x"..tostring(data.item_num or 0))
            item.up_btn:setTouchEnabled(true)
            item.up_btn:setBright(true)
        end
    end
end

function HeroHonorWindow:close_callback()
    if self.honor_event then
        GlobalEvent:getInstance():UnBind(self.honor_event)
        self.honor_event = nil
    end
    controller:openHeroHonorWindow(false)
end
