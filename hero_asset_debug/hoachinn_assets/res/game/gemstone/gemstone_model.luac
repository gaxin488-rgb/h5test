GemstoneModel = GemstoneModel or BaseClass()

local table_insert = table.insert
local math_max = math.max

local function getGemBreakNumByLevel(pos, lv)
    local break_num = 0
    local break_cfg = Config.PartnerGemData.data_break[pos]
    local index = 0

    while break_cfg and break_cfg[index] do
        if lv > (break_cfg[index].enchant_max_lev or 0) then
            break_num = index + 1
            index = index + 1
        else
            break
        end
    end

    if break_cfg and not break_cfg[break_num] then
        break_num = math_max(0, index - 1)
    end
    return break_num
end

function GemstoneModel:__init(ctrl)
    self.ctrl = ctrl
    self.hero_ctrl = HeroController:getInstance()
    self.hero_model = self.hero_ctrl:getModel()
    self.gem_list = {}
    self:config()
end

function GemstoneModel:config()

end

function GemstoneModel:getGemBreakNumByLevel(pos, lv)
    return getGemBreakNumByLevel(pos, lv)
end

local function getLegacyGemAttrList(gem_vo)
    if not gem_vo then
        return {}
    end
    if gem_vo.item_attr and next(gem_vo.item_attr) then
        return deepCopy(gem_vo.item_attr)
    end
    if gem_vo.main_attr and next(gem_vo.main_attr) then
        return deepCopy(gem_vo.main_attr)
    end

    local item_config = gem_vo.config or Config.ItemData.data_get_data(gem_vo.base_id or 0)
    if item_config and item_config.ext then
        for _, ext in ipairs(item_config.ext) do
            if ext[1] == "main_attr" and ext[2] then
                return deepCopy(ext[2])
            end
        end
    end
    return {}
end

local function addLegacyAttrValue(attr_map, attr_key, attr_val)
    if not attr_key or not attr_val or attr_val == 0 then
        return
    end

    local attr_id = Config.AttrData.data_key_to_id[attr_key]
    if not attr_id and Config.AttrExtraData and Config.AttrExtraData.data_key_to_id then
        attr_id = Config.AttrExtraData.data_key_to_id[attr_key]
    end
    if attr_id then
        attr_map[attr_id] = (attr_map[attr_id] or 0) + attr_val
    end
end

local function collectLegacyAttrList(attr_map, attr_list)
    for _, attr_info in ipairs(attr_list or {}) do
        addLegacyAttrValue(attr_map, attr_info[1], attr_info[2] or 0)
    end
end

local function buildLegacyGemstoneSlotInfo(hero_vo, pos, gem_vo)
    if not hero_vo or not gem_vo then
        return nil
    end

    local item_bid = gem_vo.base_id or (gem_vo.config and gem_vo.config.id) or 0
    if item_bid == 0 then
        return nil
    end

    local lv = math_max(gem_vo.enchant or 0, 1)
    local item_attr = getLegacyGemAttrList(gem_vo)
    local item_skill = deepCopy(gem_vo.extra_attr or gem_vo.item_skill or {})
    return {
        pid = hero_vo.partner_id,
        id = gem_vo.id or 0,
        pos = pos,
        item_bid = item_bid,
        lv = lv,
        exp = 0,
        break_num = getGemBreakNumByLevel(pos, lv),
        item_attr = item_attr,
        main_attr = deepCopy(item_attr),
        item_skill = item_skill,
        extra_attr = deepCopy(item_skill),
        extra = deepCopy(gem_vo.extra or {})
    }
end

local function buildLegacyGemstoneInfo(hero_vo)
    if not hero_vo or not hero_vo.gem_list or next(hero_vo.gem_list) == nil then
        return nil
    end

    local list_info = {}
    local attr_map = {}
    for pos, gem_vo in pairs(hero_vo.gem_list) do
        local slot_info = buildLegacyGemstoneSlotInfo(hero_vo, pos, gem_vo)
        if slot_info then
            table_insert(list_info, slot_info)
            collectLegacyAttrList(attr_map, slot_info.item_attr)

            local lv_cfg = Config.PartnerGemData.data_lv_info[pos]
            local slot_cfg = lv_cfg and lv_cfg[slot_info.lv]
            if slot_cfg and slot_cfg.attr then
                collectLegacyAttrList(attr_map, slot_cfg.attr)
            end

            local break_cfg = Config.PartnerGemData.data_break[pos]
            local break_info = break_cfg and break_cfg[slot_info.break_num]
            if break_info and break_info.attr then
                collectLegacyAttrList(attr_map, break_info.attr)
            end
        end
    end

    if next(list_info) == nil then
        return nil
    end

    local all_attr = {}
    for attr_id, attr_val in pairs(attr_map) do
        table_insert(all_attr, {attr_id = attr_id, attr_val = attr_val})
    end
    return {pid = hero_vo.partner_id, list_info = list_info, all_attr = all_attr}
end
--功能屏蔽
function GemstoneModel:GemstoneIsHide()
    local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
    local featuresId = MainuiConst.FeaturesShield.gemstone
    if table.indexof(nohideIds,featuresId) then
        return true
    end
	return false
end
--功能单忍者屏蔽
function GemstoneModel:GemstoneIsHideForHero(bid)
    local hero_cfg = Config.PartnerData.data_partner_base[bid]
    if not hero_cfg then return false end
    if hero_cfg.gem_show then
        if hero_cfg.gem_show == 1 then
        else
            local hero_nohideIds = RoleController:getInstance():getModel():getSeverShowIds("gem_show")
            if not table.indexof(hero_nohideIds,hero_cfg.bid) then
                return false
            end
        end
    else
        return false
    end
    return true
end
--功能显示条件
function GemstoneModel:GemstoneIsOpen()
    if not self:GemstoneIsHide() then return false end
    local cfg = Config.PartnerGemData.data_constant.open_lv
    local open_day = Config.PartnerGemData.data_constant.open_day.val
	local role_vo = RoleController:getInstance():getRoleVo()
	if role_vo.lev < cfg.val or role_vo.open_day < open_day then
		return false
	else
        return true
	end
	return false
end
--功能开启条件
function GemstoneModel:GemstoneIsOpenForHero(hero_vo)
    if not self:GemstoneIsOpen() then return false end
    local cfg = Config.PartnerGemData.data_constant.open_ninja
	if hero_vo.star < cfg.val then
        return false
    else
        return true
    end
    return false
end
--功能是否开启
function GemstoneModel:GemstoneOpenstatus(hero_vo)
    if not self:GemstoneIsHide() then
        return false,TI18N("语言_c_1891"),1
    elseif not self:GemstoneIsHideForHero(hero_vo.bid) then
        return false,TI18N("语言_c_1891"),2
    elseif hero_vo.isResonateHero and hero_vo:isResonateHero() then
        return false,TI18N("语言_c_3288"),5
    elseif not self:GemstoneIsOpen() then
        local txt = LangStringFormat(TI18N("语言_c_7187"),Config.PartnerGemData.data_constant.open_day.val,Config.PartnerGemData.data_constant.open_lv.val)
        return false,txt,3
    elseif not self:GemstoneIsOpenForHero(hero_vo) then
        return false,string.format(TI18N("语言_c_6982"),Config.PartnerGemData.data_constant.open_ninja.val),4
    end
    return true,"",0
end
--发送获取所有英雄的宝石数据
function GemstoneModel:sendAllHeroGemstoneInfo()
    local hero_list = self.hero_model:getHeroList()
    if hero_list then
        local list = {}
        for k,v in pairs(hero_list) do
            table.insert(list, {pid = v.id})
        end
        if #list > 0 then
            --请求英雄详细信息
            self.ctrl:sender22800(list)
        end
    end
end
--获取共鸣技能是否满足生效

function GemstoneModel:getResonanceIsOpen(partner_id,skill_id)
    local hero_vo = self.hero_model:getHeroById(partner_id)
    if hero_vo then
        local config = Config.PartnerGemData.data_skill2[self.hero_model:getSelfConvertStaBid(hero_vo.bid)]
        if config and config[skill_id] then
            local data = self:getGemstoneInfo(partner_id)
            if data and data.list_info and next(data.list_info) then
                -- cfg.quality cfg.num
                local cfg = config[skill_id]
                local quality_list = {}
                local max_quality = 0
                for k,v in pairs(data.list_info) do
                    local back_cfg = Config.ItemData.data_get_data(v.item_bid)
                    if back_cfg then
                        max_quality = math.max(max_quality,back_cfg.quality)
                        if quality_list[back_cfg.quality] then
                            quality_list[back_cfg.quality] = quality_list[back_cfg.quality] + 1
                        else
                            quality_list[back_cfg.quality] = 1
                        end
                    end
                end
                local num = 0
                if max_quality >= cfg.quality then
                    for i=cfg.quality,max_quality do
                        if quality_list[i] then
                            num = num + quality_list[i]
                        end
                    end
                end 
                if num >= cfg.num then
                    return true
                end
            end
        end
    end
    return false
end
function GemstoneModel:getScore(data)
    local attr_list = {}
    attr_list = data.item_attr or data.main_attr or {}
    if not attr_list or not next(attr_list) then return 0 end
    local base_attr = {}
    for k, v in pairs(attr_list) do
        local attr_txt = Config.AttrData.data_id_to_key[v.attr_id]
        if not attr_txt then
            attr_txt = Config.AttrExtraData.data_id_to_key[v.attr_id]
        end
        local attr_num = v.attr_val
        table.insert(base_attr, {attr_txt, attr_num})
    end
    --宝石基础属性评分
    local num = self:calculatePower(base_attr)
    local item_id = data.item_bid or data.config.id
    local cfg = Config.PartnerGemData.data_base_info[item_id]
    --基础评分
    local base_num = cfg.score
    --槽位评分
    local pos_num = 0
    local pos_lv_cfg = Config.PartnerGemData.data_lv_info[data.pos]
    if pos_lv_cfg and pos_lv_cfg[data.lv] and pos_lv_cfg[data.lv].attr then
        pos_num = pos_num + self:calculatePower(deepCopy(pos_lv_cfg[data.lv].attr))
    end
    local break_cfg = Config.PartnerGemData.data_break[data.pos]
    if break_cfg and break_cfg[data.break_num] and break_cfg[data.break_num].attr then
        pos_num = pos_num + self:calculatePower(deepCopy(break_cfg[data.break_num].attr))
    end
    --技能评分
    local skill_num = 0
    local skill_list = {}
    skill_list = data.item_skill or data.extra_attr or {}
    for k, v in pairs(skill_list) do
        local lib = v.lib
        local skill_id = v.skill_id
        local cfg = Config.PartnerGemData.data_skill[lib]
        if cfg and cfg[skill_id] then
            skill_num = cfg[skill_id].score
        end
    end
    return base_num + num + pos_num + skill_num
end
--获取羁绊技能是否满足生效  评分
function GemstoneModel:getTrammelsIsOpenForScore(career,score)
    local cfg = Config.PartnerGemData.data_fetter[career]
    local status = false
    local list = {}
    local num = 0
    if cfg then
        for k,v in pairs(self.gem_list) do
            if v and v.list_info and next(v.list_info) then
                local hero_vo = self.hero_model:getHeroById(v.pid)
                if hero_vo and hero_vo.type == career then
                    local add_status = false
                    for key,value in pairs(v.list_info) do
                        local _score = self:getScore(value)
                        if _score > 0 then
                            add_status = true
                        end
                        num = num + _score
                        if num >= score then
                            status = true
                            break
                        end
                    end
                    if add_status then
                        table.insert(list,hero_vo)
                    end
                end
            end
        end
    end
    return status,list,num
end
--获取羁绊技能是否满足生效  职业 忍者数量 宝石数量 宝石品质
function GemstoneModel:getTrammelsIsOpen(career,gem_num,quality)
    local cfg = Config.PartnerGemData.data_fetter[career]
    local status = false
    local list = {}
    local num = 0
    if cfg then
        for k,v in pairs(self.gem_list) do
            if v and v.list_info and next(v.list_info) then
                local hero_vo = self.hero_model:getHeroById(v.pid)
                if hero_vo and hero_vo.type == career then
                    table.insert(list,hero_vo)
                    if num < gem_num then
                        for key,value in pairs(v.list_info) do
                            local back_cfg = Config.ItemData.data_get_data(value.item_bid)
                            if back_cfg and back_cfg.quality >= quality then
                                num = num + 1
                            end
                            if num >= gem_num then
                                status = true
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return status,list,num
end
-- 刷新宝石列表
function GemstoneModel:updateGemstoneList(list)
    for k, v in pairs(list.list_info) do
        self.gem_list[v.pid] = v
        GlobalEvent:getInstance():Fire(GemstoneEvent.Update_Hero_Info, v.pid)
        local hero_vo = HeroController:getInstance():getModel():getHeroById(v.pid)
        if HeroCalculate.isCheckHeroRedPointByHeroVo(hero_vo) then
            HeroCalculate.checkAllHeroRedPoint()
        end
    end
end
--获取单个忍者的宝石数据
function GemstoneModel:getGemstoneInfo(pid)
    if self.gem_list and self.gem_list[pid] then
        return self.gem_list[pid]
    end

    local hero_vo = self.hero_model and self.hero_model:getHeroById(pid)
    return buildLegacyGemstoneInfo(hero_vo)
end
--获取单个忍者的单个宝石数据
function GemstoneModel:getOneGemstoneInfo(pid,pos)
    local gem_info = self:getGemstoneInfo(pid)
    if gem_info and gem_info.list_info then
        for k, v in pairs(gem_info.list_info) do
            if v.pos == pos then
                return v
            end
        end
    end
    return nil
end

function GemstoneModel:createStar(num, star_con, star_setting)
	local num = num or 0
    local star_setting = star_setting or {}
	if star_setting.star_list == nil then
        star_setting.star_list = {}
    end
	for i,v in pairs(star_setting.star_list) do
        v:setVisible(false)
    end
	local _cStar = function(star_count, star_list,moveW)
        local width = 20
        local x = - star_count * width * 0.5 + width * 0.5
        if moveW then 
            x = x + moveW
        end
        for i=1,star_count do
            if not star_list[i] then 
				local res = PathTool.getResFrame("common","common_90074")
                local star = createImage(star_con,res,0,0,cc.p(0.5,0.5),true,star_count-i,false)
                star:setScale(1)
                star_list[i] = star
            end
            star_list[i]:setVisible(true)
            star_list[i]:setPositionX(x + (i-1) * width)
        end
    end
	_cStar(num, star_setting.star_list)
	return star_setting
end
