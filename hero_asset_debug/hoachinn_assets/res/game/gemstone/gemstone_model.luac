--获取自动分解设置
function GemstoneModel:setHeroSacrificeNum(num)
    self.one_key_sacrifice = num
    GlobalEvent:getInstance():Fire(GemstoneEvent.Gem_Sacrifice_Event)
end
function GemstoneModel:getHeroSacrificeNum()
    return self.one_key_sacrifice or 0
end
function GemstoneModel:setGemIsSacrifice(status)
    self.is_auto_sacrifice = status
    GlobalEvent:getInstance():Fire(GemstoneEvent.Gem_Sacrifice_Event)
end
function GemstoneModel:getGemIsSacrifice()
    return self.is_auto_sacrifice or false
end
--自动分解
function GemstoneModel:autoSacrifice()
    if not self:getGemIsSacrifice() then return end
    local auto_click = self:getHeroSacrificeNum()
    local const_cfg = Config.PartnerGemData.data_constant["gem_select"].val
    local max_quality = 0
    for k, v in pairs(const_cfg) do
        max_quality = math.max(max_quality,v[1])
    end
    local gem_data = {}
    local data = deepCopy(BackpackController:getInstance():getModel():getBagItemList(BackPackConst.item_tab_type.GEMSTONE))
	for i, v in pairs(data) do
        local config = Config.ItemData.data_get_data(v.base_id)
        if config.quality <= max_quality then
            local cfg = Config.PartnerGemData.data_base_info[v.base_id]
            if cfg then
                if not gem_data[cfg.pos] then
                    gem_data[cfg.pos] = {}
                end
                if not gem_data[cfg.pos][config.quality] then
                    gem_data[cfg.pos][config.quality] = {}
                end
                if v.main_attr and next(v.main_attr) and v.extra_attr and next(v.extra_attr) then
                    v.gem_sort = 3
                elseif (v.main_attr and next(v.main_attr)) or (v.extra_attr and next(v.extra_attr)) then
                    v.gem_sort = 2
                else
                    v.gem_sort = 1
                end
                table.insert(gem_data[cfg.pos][config.quality], v)
            end
        end
	end
    for key, value in pairs(gem_data) do
        for k, v in pairs(value) do
            table.sort(v, function(a, b) return a.gem_sort > b.gem_sort end)
        end
    end
    local auto_list = const_cfg[auto_click]
    local remove_list = {}
    if auto_list and auto_list[1] and auto_list[2] then
        local quality = auto_list[1]
        local num = auto_list[2]
        local have_num = 0
        for i=1, 6 do
            if gem_data[i] then
                for j=max_quality, 1,-1 do
                    if j <= quality then
                        if gem_data[i][j] and next(gem_data[i][j]) then
                            for index, value in ipairs(gem_data[i][j]) do
                                if have_num < num then
                                    have_num = have_num + 1
                                else
                                    table.insert(remove_list, {id=value.id, bid=value.config.id, num=1})
                                end
                            end
                        end
                    end
                end
            end
        end
        if #remove_list > 0 then
            BackpackController:getInstance():sender10522(BackPackConst.Bag_Code.GEMSTONE, remove_list)
        end
    end
end
--熔炼
function GemstoneModel:setGemArtifactNum(val)
    self.gem_artifact_num = val
    if Config.PartnerGemData and Config.PartnerGemData.data_constant and Config.PartnerGemData.data_constant.change_condition and Config.PartnerGemData.data_constant.change_condition.val then
        self.gem_artifact_red = self.gem_artifact_num >= Config.PartnerGemData.data_constant.change_condition.val
    else
        self.gem_artifact_red = false
    end
end
function GemstoneModel:getGemArtifactNum()
    return self.gem_artifact_num or 0
end
--查看该忍者身上的宝石是否可以返回至背包
--type 1通过数量直接比较是否满足 2通过忍者id查看宝石数量是否满足
--pid type2使用
--num type1使用
function GemstoneModel:checkGemBack(type,pid,num)
    local need_num = 0
    if type == 1 then
        need_num = num
    elseif type == 2 then
        local gem_list = self:getGemstoneInfo(pid)
        if gem_list and gem_list.list_info and next(gem_list.list_info) then
            local hero_vo = HeroController:getInstance():getModel():getHeroById(pid)
            if hero_vo and next(hero_vo) then
                if hero_vo.resonate_star ~= 0 then
                    if hero_vo.resonate_star < Config.PartnerGemData.data_constant.open_ninja.val then
                        for k,v in pairs(gem_list.list_info) do
                            if v.item_bid ~= 0 then
                                need_num = need_num + 1
                            end
                        end
                    else
                        for k,v in pairs(gem_list.list_info) do
                            if v.item_bid ~= 0 then
                                if hero_vo.resonate_star < Config.PartnerGemData.data_lv_info[v.pos][1].need_star then
                                    need_num = need_num + 1
                                end
                            end
                        end
                    end 
                else
                    for k,v in pairs(gem_list.list_info) do
                        if v.item_bid ~= 0 then
                            need_num = need_num + 1
                        end
                    end
                end
            end
        end
    end
    local back_model = BackpackController:getInstance():getModel()
    local have_num = 0
    local data = back_model:getBagItemList(BackPackConst.item_tab_type.GEMSTONE)
    if data and next(data) then
        have_num = tableLen(data)
    end
    local max_num = back_model:getGemSize()
    if max_num - have_num >= need_num then
        return true
    end
    return false
end
--合成跳过动画
function GemstoneModel:setSkipSmelt(num)
	if self.isshowVideo ~= num then
		self.isshowVideo = num
		ActionController:getInstance():sender16809(ActionStorageBool.gemIsSkipSmelt, num ,"")
	end
end
function GemstoneModel:getSkipSmelt()
	if MAKELIFEBETTER_NEW then return 1 end
	if GuideController:getInstance():isInGuide() then
		self:setSkipSmelt(0)
		return
	end
    if StoryController:getInstance():getModel():isStoryState() then
		self:setSkipSmelt(0)
		return 
	end 
	if self.isshowVideo then
		return self.isshowVideo
	end
	return 0
end
--------------------------------红点---------------------
--忍者红点
function GemstoneModel:checkRedPoint(pid)
    --熔炼值奖励红点
    if self:getGemArtifactRed() then return true end
    --宝石装备红点
    if self:getGemEquipRed(pid) then return true end
    --宝石强化红点
    if self:getGemStrengRed(pid) then return true end
end
--宝石装备红点
function GemstoneModel:getGemEquipRed(pid)
    local hero_vo = HeroController:getInstance():getModel():getHeroById(pid)
    if not hero_vo then return false end
    local cfg = Config.PartnerGemData.data_lv_info
    local status = false
    for i=1,6 do
        if cfg[i] and cfg[i][1] and type(hero_vo.star) == "number" and type(cfg[i][1].need_star) == "number" and hero_vo.star >= cfg[i][1].need_star then
            status = self:getGemEquipOneRed(pid,i)
            if status then return true end
        end
    end
    return status
end
--宝石装备红点单槽位
function GemstoneModel:getGemEquipOneRed(pid,pos)
    local list = self:getOneGemstoneInfo(pid,pos)
    if list and next(list) then
        if list.item_bid ~= 0 then
            return self:getIsEquipUpGem(list.item_bid,pos)
        else
            return self:getIsEquipGem(pos)
        end
    else
        return self:getIsEquipGem(pos)
    end
    return false
end
--是否有可装备的宝石
function GemstoneModel:getIsEquipGem(pos)
    local data = deepCopy(BackpackController:getInstance():getModel():getBagItemList(BackPackConst.item_tab_type.GEMSTONE))
    for k, v in pairs(data) do
        local cfg = Config.PartnerGemData.data_base_info[v.base_id]
        if cfg and cfg.pos and cfg.pos == pos then
            return true
        end
    end
    return false
end
--是否有比装备品质更高的宝石
function GemstoneModel:getIsEquipUpGem(item_bid,pos)
    local data = deepCopy(BackpackController:getInstance():getModel():getBagItemList(BackPackConst.item_tab_type.GEMSTONE))
    for k, v in pairs(data) do
        local cfg = Config.PartnerGemData.data_base_info[v.base_id]
        if cfg and cfg.pos and cfg.pos == pos then
            local item_cfg = Config.ItemData.data_get_data(item_bid)
            local item_cfg2 = Config.ItemData.data_get_data(v.base_id)
            if item_cfg and item_cfg2 then
                if item_cfg2.quality > item_cfg.quality then
                    return true
                elseif item_cfg2.quality == item_cfg.quality then
                    if v.base_id > item_bid then
                        return true
                    end
                end
            end
        end
    end
    return false
end
--宝石强化红点
function GemstoneModel:getGemStrengRed(pid)
    local status = false
    for i=1,6 do
        local list = self:getOneGemstoneInfo(pid,i)
        if list and next(list) and list.item_bid and list.item_bid ~= 0 then
            local cfg = Config.PartnerGemData.data_lv_info[i]
            if cfg and list.lv < tableLen(cfg) then
                status = self:getGemStrengOneRed(pid,i)
                if status then return true end
            end
        end
    end
    return status
end
--宝石强化红点单槽位
function GemstoneModel:getGemStrengOneRed(pid,pos)
    local list = self:getOneGemstoneInfo(pid,pos)
    if not list or not next(list) then return false end
    local lv = list.lv
    local break_num = list.break_num or getGemBreakNumByLevel(pos, lv)
    local break_cfg = Config.PartnerGemData.data_break[pos]
    local max_lv = 0
    if break_cfg and break_cfg[break_num] then
        max_lv = break_cfg[break_num].enchant_max_lev
    end
    if lv >= max_lv then --突破
        local cost_list = break_cfg[break_num].cost
        if break_cfg[break_num+1] then
            for k, v in pairs(cost_list) do
                local item_cfg = Config.ItemData.data_get_data(v[1])
                local have_num = 0
                if item_cfg and item_cfg.sub_type == BackPackConst.Bag_Code.GEMSTONE then
                    have_num = BackpackController:getInstance():getModel():getItemNumByBid(v[1],BackPackConst.Bag_Code.GEMSTONE)
                else
                    have_num = BackpackController:getInstance():getModel():getItemNumByBid(v[1])
                end
                if have_num < v[2] then
                    return false
                end
            end
            return true
        else
            return false
        end
    else--强化
        local cfg = Config.PartnerGemData.data_exp_info
        for k, v in pairs(cfg) do
            local have_num = BackpackController:getInstance():getModel():getItemNumByBid(v.id)
            if have_num > 0 then
                return true
            end
        end
    end
    return false
end
--熔炼值红点
function GemstoneModel:getGemArtifactRed()
    return self.gem_artifact_red or false
end
--宝石背包首次点击红点
function GemstoneModel:setGemStoneBackRed(gemStoneBackRed)
    self.gemStoneBackRed = gemStoneBackRed and self:GemstoneIsOpen()
    MainuiController:getInstance():setBtnRedPoint(MainuiConst.btn_index.backpack, {bid=BackPackConst.item_tab_type.SPECIAL,status=self.gemStoneBackRed})
    GlobalEvent:getInstance():Fire(GemstoneEvent.Gem_Back_Red_Event)
end
function GemstoneModel:getGemStoneBackRed()
    if self:GemstoneIsOpen() then
        return self.gemStoneBackRed or false
    else
        return false
    end
end
--宝石功能首次点击红点
function GemstoneModel:setGemStoneRed(gemStoneRed)
    self.gemStoneRed = gemStoneRed
    HeroCalculate.checkAllHeroRedPoint()
    GlobalEvent:getInstance():Fire(GemstoneEvent.Gem_First_Red_Event)
end
function GemstoneModel:getGemStoneRed()
    if self:GemstoneIsOpen() then
        return self.gemStoneRed or false
    else
        return false
    end
end
--==============================--
--desc:计算战力的接口
--time:2018-06-21 01:56:53
--@attr_list:
--@return 
--==============================--
function GemstoneModel:calculatePower(attr_list)
    local total_power = 0
    if attr_list == nil or tableLen(attr_list) == 0 then 
        return total_power
    end
    local key, value = nil, nil
    for k,v in pairs(attr_list) do
        if type(v) == "table" and #v >= 2 then
            key = v[1]
            value = v[2]
        else
            key = k
            value = v
        end
        local power_cinfig  = Config.AttrData.data_power[key]
        if power_cinfig then
            local radio = power_cinfig.power
            total_power = total_power + value*radio*0.001
        end
    end
    return math.floor(total_power)
end
function GemstoneModel:getAutoHide()
    local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	local featuresId = MainuiConst.FeaturesShield.GemAuto
    if table.indexof(nohideIds,featuresId) then
		return true
	end
    return false
end
function GemstoneModel:__delete()
end