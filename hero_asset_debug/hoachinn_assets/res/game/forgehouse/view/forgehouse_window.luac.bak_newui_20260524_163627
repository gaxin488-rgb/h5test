-- --------------------------------------------------------------------
-- @description:
--      Giao diện lò rèn (ForgeHouseWindow) - Đã sửa lỗi Rèn Nhanh & Đếm vật liệu
-- --------------------------------------------------------------------

ForgeHouseWindow = ForgeHouseWindow or BaseClass(BaseView)

local controller = ForgeHouseController:getInstance()
local model = controller:getModel()
local backpackModel = BackpackController:getInstance():getModel()
local partner_const = Config.PartnerEqmData.data_partner_const
local eqm_comp_list = Config.PartnerEqmData.data_eqm_compose_id

function ForgeHouseWindow:__init()
    self.is_full_screen = true
    self.layout_name = "forgehouse/forgehouse_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("forgehouse", "forgehouse"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("artifact","artifact"), type = ResourcesType.plist },
        {path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_64",true), type = ResourcesType.single },
        {path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_79",false), type = ResourcesType.single },
        {path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_80",false), type = ResourcesType.single }
    }
    
    self.tab_list = {}      -- Danh sách tab con (Bottom)
    self.top_tab_list = {}  -- Danh sách tab chính (Top)
    self.material_slots = {} -- Quản lý 6 slot vật liệu
    
    self.cur_index = nil    -- Index của tab con hiện tại
    self.current_mode = 1   -- 1: Trang bị, 2: Trang sức, 3: Thần khí, 4: Tạo sách
    self.id_offset = 0      -- Offset để lấy dữ liệu từ config
    
    self.composite_number = 1
    self.compCoinNumber = 0 
    self.role_vo = RoleController:getInstance():getRoleVo()
    
    self.touch_comp_base = 1
    self.is_selected = nil
    self.is_tab_touch = true
    
    -- Định nghĩa tên các Tab con cho từng chế độ
    self.sub_tab_names = {
        [1] = {TI18N("Vũ Khí"), TI18N("Áo"), TI18N("Mũ"), TI18N("Giày")},            -- Trang Bị
        [2] = {TI18N("Nhẫn"), TI18N("Dây"), TI18N("Vòng"), TI18N("Khuyên")},         -- Trang Sức
        [3] = {TI18N("Thần Binh"), TI18N("Thần Giáp"), TI18N("Thần Mão"), TI18N("Thần Hài")}, -- Thần Khí
        [4] = {} 
    }
end

function ForgeHouseWindow:open_callback()
    local bg = self.root_wnd:getChildByName("bg")
    bg:ignoreContentAdaptWithSize(true)
    bg:loadTexture(PathTool.getPlistImgForDownLoad("bigbg","bigbg_64",true), LOADTEXT_TYPE)
    bg:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    -- Container chính
    self.equip_container = self.main_container:getChildByName("equip_container")
    self.artifact_container = self.main_container:getChildByName("artifact_container")

    -- Load ảnh nền phụ
    local image_stage = self.equip_container:getChildByName("image_stage")
    local res = PathTool.getPlistImgForDownLoad("bigbg", "bigbg_80")
    if not self.item_load then
        self.item_load = createResourcesLoad(res, ResourcesType.single, function()
            if not tolua.isnull(image_stage) then
                image_stage:loadTexture(res,LOADTEXT_TYPE)
            end
        end,self.item_load)
    end

    -- =========================================================
    -- KHỞI TẠO 6 SLOT VẬT LIỆU
    -- =========================================================
    for i = 1, 6 do
        local slot = {}
        local suffix = (i == 1) and "" or "_" .. i 
        
        slot.bg = self.equip_container:getChildByName("gold_bg_" .. i)
        if not slot.bg then slot.bg = self.equip_container:getChildByName("gold_bg" .. suffix) end

        slot.num = self.equip_container:getChildByName("gold_num_" .. i)
        if not slot.num then slot.num = self.equip_container:getChildByName("gold_num" .. suffix) end

        slot.icon = self.equip_container:getChildByName("spriteGold_" .. i)
        if not slot.icon then slot.icon = self.equip_container:getChildByName("spriteGold" .. suffix) end
        
        if slot.bg then 
            slot.bg:setVisible(false) 
            slot.bg:setIgnoreAnchorPointForPosition(false)
        end
        if slot.num then slot.num:setVisible(false) end
        if slot.icon then slot.icon:setVisible(false) end
        
        self.material_slots[i] = slot
    end

    -- =========================================================
    -- KHỞI TẠO 4 TAB CHÍNH (TOP TABS)
    -- =========================================================
    local tab_container = self.main_container:getChildByName("tab_container")
    local tab_name_list = {
        [1] = TI18N("Trang Bị"),
        [2] = TI18N("Trang Sức"),
        [3] = TI18N("Thần Khí"),
        [4] = TI18N("Tạo Sách")
    }
    
    for i = 1, 4 do
        local tab_btn = tab_container:getChildByName("tab_btn_"..i)
        if tab_btn then
            local object = {}
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
            object.unselect_bg:setVisible(true)
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(false)
            object.lable = tab_btn:getChildByName("title")
            if tab_name_list[i] then
                object.lable:setString(tab_name_list[i])
            end
            object.tab_btn = tab_btn
            object.index = i
            object.tips = tab_btn:getChildByName("tips")
            
            if object.index == 4 then
                local red_status = HeroController:getInstance():getModel():getArtifactLuckyRedStatus()
                object.tips:setVisible(red_status)
            else
                object.tips:setVisible(false)
            end
            self.top_tab_list[i] = object
        end
    end

    self.close_btn = self.main_container:getChildByName("btn_return")
    AudioManager:getInstance():preLoadEffect(AudioManager.AUDIO_TYPE.COMMON, 'c_equipment_forging')
end

-- =========================================================
-- HÀM QUAN TRỌNG: LẤY TỔNG SỐ LƯỢNG NGUYÊN LIỆU (CẢ 2 TÚI)
-- =========================================================
function ForgeHouseWindow:getMaterialNum(bid)
    if bid == 1 then return self.role_vo.coin end
    if bid == 2 then return self.role_vo.gold end

    -- Lấy số lượng từ túi Đạo Cụ
    local num_bag = backpackModel:getPackItemNumByBid(BackPackConst.Bag_Code.BACKPACK, bid)
    
    -- Lấy số lượng từ túi Trang Bị
    local num_equip = backpackModel:getPackItemNumByBid(BackPackConst.Bag_Code.EQUIPS, bid)
    
    -- Cộng tổng
    local num_total = num_bag + num_equip
    if num_total == 0 and backpackModel.getItemNumByBid then
        num_total = backpackModel:getItemNumByBid(bid)
    end
    
    return num_total
end

-- =========================================================
-- TÍNH TOÁN SỐ LƯỢNG TỐI ĐA CÓ THỂ RÈN
-- =========================================================
function ForgeHouseWindow:calculateMaxMakeNum(expend_list)
    local max_num = 999999 
    for i, data in ipairs(expend_list) do
        local bid = data[1]
        local cost_one = data[2]
        
        -- Không tính tiền (Bạc/Vàng) vào giới hạn Max, chỉ tính vật liệu
        if bid ~= 1 and bid ~= 2 then
            local have = self:getMaterialNum(bid)
            local can_make = math.floor(have / cost_one)
            if can_make < max_num then
                max_num = can_make
            end
        end
    end
    if max_num == 999999 then max_num = 0 end
    return max_num
end

function ForgeHouseWindow:initEquipLayout()
    self.bar = self.equip_container:getChildByName("bar")
    self.bar:setScale9Enabled(true)
    self.bar_num = self.equip_container:getChildByName("bar_num")
    self.bar_num:setString("")
    
    self.btn_composite = self.equip_container:getChildByName("btn_composite")
    self.btn_composite:getChildByName("Text_1"):setString(TI18N("Rèn"))
    
    self.btn_comp = self.equip_container:getChildByName("btn_comp")
    self.btn_comp:getChildByName("Text_1"):setString(TI18N("Nhật ký"))

    -- TextField
    self.text_Field = self.equip_container:getChildByName("text_Field")
    local function textFieldEvent(sender, eventType)
        if eventType == ccui.TextFiledEventType.detach_with_ime then
            self:onInputEnd()
        end
    end
    self.text_Field:setTextColor(cc.c4b(0xff,0xff,0xff,0xff))
    self.text_Field:setPlaceHolderColor(cc.c4b(0xff,0xff,0xff,0xff))
    self.text_Field:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self.text_Field:addEventListener(textFieldEvent)

    -- Nút Rèn Nhanh
    self.btn_all_composite = self.equip_container:getChildByName("btn_all_composite")
    self.btn_all_composite_label = self.btn_all_composite:getChildByName("Text_1")
    self.btn_all_composite_label:setString(TI18N("Rèn nhanh"))

    if self.role_vo.vip_lev < partner_const.synthesis_vip_lev.val and self.role_vo.lev < partner_const.synthesis_character_lev.val then
        setChildUnEnabled(true, self.btn_all_composite)
        self.btn_all_composite_label:disableEffect(cc.LabelEffect.OUTLINE)
    end

    -- Khởi tạo 4 Tab Con
    local Image_1 = self.equip_container:getChildByName("Image_1")
    local tab_container = Image_1:getChildByName("tab_container")
    
    for i = 1, 4 do
        local tab = tab_container:getChildByName('tab_btn_'..i)
        if tab then
            tab.title = tab:getChildByName("title")
            tab.title:setTextColor(cc.c4b(0xEE, 0xD1, 0xAF, 0xff))
            tab.title:enableOutline(cc.c4b(0x53, 0x3D, 0x32, 0xff), 2)
            tab.normal = tab:getChildByName("normal")
            tab.select = tab:getChildByName("select")
            tab.select:setVisible(false)
            tab.redpoint = tab:getChildByName("redpoint")
            tab.redpoint:setVisible(false)
            tab.index = i
            self.tab_list[i] = tab
        end
    end

    -- ScrollView danh sách
    self.scroll = self.equip_container:getChildByName("goods_con")
    local scroll_view_size = self.scroll:getContentSize()
    local setting = {
        item_class = BackPackItem,
        start_x = 5, space_x = 7, start_y = 0, space_y = 10,
        item_width = BackPackItem.Width, item_height = BackPackItem.Height,
        row = 1, col = 5,
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.scroll, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)

    -- Item Nguồn & Đích
    self.last_item = BackPackItem.new(nil,true,nil,0.8)
    self.equip_container:addChild(self.last_item)
    self.last_item:setPosition(cc.p(207, 1006))
    self.last_item:setDefaultTip()

    self.cur_item = BackPackItem.new(nil,true,nil,0.8)
    self.equip_container:addChild(self.cur_item)
    self.cur_item:setPosition(cc.p(506, 1006))
    self.cur_item:setDefaultTip()

    self.btn_add = self.equip_container:getChildByName("btn_add")
    self.btn_redu = self.equip_container:getChildByName("btn_redu")
    
    -- Ẩn UI cũ nếu có
    local img_3 = self.equip_container:getChildByName("Image_3")
    if img_3 then
        local comp_num = img_3:getChildByName("composite_num")
        if comp_num then comp_num:setVisible(false) end
    end

    self:register_equip_event()
end

function ForgeHouseWindow:onInputEnd()
    if not self.cur_index or not self.touch_comp_base then return end
    
    local mapped_index = self.cur_index + self.id_offset
    local list = eqm_comp_list[mapped_index]
    if not list then return end
    local data = list[self.touch_comp_base]
    if not data then return end
    
    local max_can_make = self:calculateMaxMakeNum(data.expend)
    local input_str = self.text_Field:getString()
    
    if input_str == "" then
        self.composite_number = 1
    else
        local input_num = tonumber(input_str)
        if type(input_num) == "number" then
            if input_num < 0 then
                self.composite_number = 1
            elseif max_can_make > 0 and input_num > max_can_make then
                self.composite_number = max_can_make
            else
                self.composite_number = input_num
            end
        else
            self.composite_number = 1
        end
    end
    
    if self.composite_number == 0 and max_can_make > 0 then
        self.composite_number = 1
    end
    
    self.text_Field:setString(self.composite_number)
    self:updateMaterialRequirements(data.expend)
    
    -- Cập nhật nút (Logic NOT để Enable)
    self:setTouchEnable_Add(not (max_can_make > 0 and self.composite_number < max_can_make))
    self:setTouchEnable_Redu(not (self.composite_number > 1))
end

function ForgeHouseWindow:updateMaterialRequirements(expend_list)
    if not expend_list then return end
    
    -- Reset ẩn toàn bộ
    for _, slot in ipairs(self.material_slots) do
        if slot.bg then slot.bg:setVisible(false) end
        if slot.num then slot.num:setVisible(false) end
        if slot.icon then slot.icon:setVisible(false) end
    end

    self.compCoinNumber = 0 

    local slot_index = 1
    for i = 2, #expend_list do
        local data = expend_list[i]
        local slot = self.material_slots[slot_index]
        
        if slot and slot.bg and slot_index <= 6 then
            slot.bg:setVisible(true)
            slot.num:setVisible(true)
            slot.icon:setVisible(true)

            local item_bid = data[1]
            local need_num = data[2] * self.composite_number
            local item_config = Config.ItemData.data_get_data(item_bid)
            
            if item_config then
                loadSpriteTexture(slot.icon, PathTool.getItemRes(item_config.icon), LOADTEXT_TYPE)
                slot.icon:setScale(0.4)
            end

            if item_bid == 1 or item_bid == 2 then 
                slot.num:setString(MoneyTool.GetMoneyString(need_num))
                slot.num:setTextColor(cc.c4b(0xff, 0xff, 0xff, 0xff))
                if item_bid == 1 then self.compCoinNumber = need_num end
            else
                local have_num = self:getMaterialNum(item_bid)
                slot.num:setString(string.format("%d/%d", have_num, need_num))
                
                if have_num < need_num then
                    slot.num:setTextColor(cc.c4b(0xff, 0x4e, 0x4e, 0xff)) -- Đỏ
                else
                    slot.num:setTextColor(cc.c4b(0xff, 0xff, 0xff, 0xff)) -- Trắng
                end
            end
            
            local text_size = slot.num:getContentSize()
            local bg_width = text_size.width + 40
            if bg_width < 123 then bg_width = 123 end
            slot.bg:setContentSize(cc.size(bg_width, 34))
            
            slot_index = slot_index + 1
        end
    end
end

function ForgeHouseWindow:tabChangeView(index)
    if self.is_tab_touch == nil then return end
    if self.cur_index == index then return end
    
    if self.cur_tab ~= nil then
        self.cur_tab.select:setVisible(false)
        self.cur_tab.title:setTextColor(cc.c4b(0xEE, 0xD1, 0xAF, 0xff))
        self.cur_tab.title:enableOutline(cc.c4b(0x53, 0x3D, 0x32, 0xff), 2)
        self.cur_tab.title:setFontSize(24)
    end
    
    self.cur_index = index
    self.cur_tab = self.tab_list[self.cur_index]
    if self.cur_tab ~= nil then
        self.cur_tab.select:setVisible(true)
        self.cur_tab.title:disableEffect(cc.LabelEffect.OUTLINE)
        self.cur_tab.title:setTextColor(cc.c4b(0x60, 0x35, 0x1a, 0xff))
        self.cur_tab.title:setFontSize(26)
    end

    self.touch_comp_base = 1
    self:setTouchEnable_Add(true) -- Mặc định disable trước khi tính toán
    self:setTouchEnable_Redu(true)
    
    local mapped_index = self.cur_index + self.id_offset
    local list = eqm_comp_list[mapped_index]
    
    if not list or #list == 0 then return end
    local current_data = list[self.touch_comp_base]

    self.last_item:setBaseData(current_data.expend[1][1])
    self.cur_item:setBaseData(current_data.id)

    -- Tính số lượng Max có thể chế tạo
    local max_can_make = self:calculateMaxMakeNum(current_data.expend)
    if max_can_make > 0 then
        self.composite_number = max_can_make 
    else
        self.composite_number = 1 
    end

    -- Thanh Bar (Main Item)
    local main_mat_bid = current_data.expend[1][1]
    local main_mat_cost = current_data.expend[1][2]
    local num = self:getMaterialNum(main_mat_bid)
    
    self.bar_num:setString(num.."/"..main_mat_cost)
    self.bar:setPercent(math.floor(num/main_mat_cost*100))
    self.text_Field:setString(self.composite_number)

    self:updateMaterialRequirements(current_data.expend)
    
    -- LOGIC NÚT: Dùng NOT vì setChildUnEnabled(true) nghĩa là Disable
    self:setTouchEnable_Add(not (max_can_make > 0 and self.composite_number < max_can_make))
    self:setTouchEnable_Redu(not (self.composite_number > 1))

    -- ScrollView
    self.item_scrollview:setData(list, function(cell)
        if not self.is_selected then return end
        local data = cell:getData()
        local list_item = self.item_scrollview:getItemList()
        
        for k, v in pairs(list_item) do
            if v then
                if data and v:getData() and v:getData().id == data.id then
                    v:setMaskVisible(true)
                    self.touch_comp_base = v:getData()._index
                else
                    v:setMaskVisible(false)
                end
            end
        end

        self.last_item:setBaseData(data.expend[1][1])
        self.cur_item:setBaseData(data.id)

        local max_can = self:calculateMaxMakeNum(data.expend)
        local m_bid = data.expend[1][1]
        local m_cost = data.expend[1][2]
        local have = self:getMaterialNum(m_bid)
        
        self.bar_num:setString(have.."/"..m_cost)
        self.bar:setPercent(math.floor(have/m_cost *100))
        
        if max_can > 0 then
            self.composite_number = max_can
        else
            self.composite_number = 1
        end
        self.text_Field:setString(self.composite_number)
        
        self:updateMaterialRequirements(data.expend)
        
        self:setTouchEnable_Add(not (max_can > 0 and self.composite_number < max_can))
        self:setTouchEnable_Redu(not (self.composite_number > 1))
    end)

    self.item_scrollview:addEndCallBack(function()
        local list_items = self.item_scrollview:getItemList()
        local status = false
        for k, v in pairs(list_items) do
            if v then
                v:createSpriteMask()
                v:createSpriteRedPoint()
                if k == self.touch_comp_base then
                    v:setMaskVisible(true)
                else
                    v:setMaskVisible(false)
                end

                local data = v:getData()
                if data then
                    local item_max = self:calculateMaxMakeNum(data.expend)
                    if item_max >= 1 then
                        v:setVisibleResPoint(true)
                        status = true
                    else
                        v:setVisibleResPoint(false)
                    end
                end
            end
        end
        self.is_selected = true
        self.tab_list[self.cur_index].redpoint:setVisible(status)
    end)
end

function ForgeHouseWindow:setTouchEnable_Add(bool)
    -- True = Disabled, False = Enabled
    setChildUnEnabled(bool,self.btn_add)
    self.btn_add:setTouchEnabled(not bool)
end

function ForgeHouseWindow:setTouchEnable_Redu(bool)
    -- True = Disabled, False = Enabled
    setChildUnEnabled(bool,self.btn_redu)
    self.btn_redu:setTouchEnabled(not bool)
end

function ForgeHouseWindow:register_equip_event()
    for i,tab_btn in pairs(self.tab_list) do
        registerButtonEventListener(tab_btn, function()
            self:tabChangeView(tab_btn.index)
        end,false, 3)
    end

    if self.role_vo ~= nil then
        if self.role_assets_event == nil then
            self.role_assets_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE, function(key, value)
                if key == "lev" or key == "vip_lev" then
                    if self.role_vo.vip_lev >= partner_const.synthesis_vip_lev.val or 
                       self.role_vo.lev >= partner_const.synthesis_character_lev.val then
                        setChildUnEnabled(false, self.btn_all_composite)
                        self.btn_all_composite_label:enableOutline(Config.ColorData.data_color4[264], 2)
                    end
                end
            end)
        end
    end

    registerButtonEventListener(self.btn_comp, function()
        controller:openEquipmentCompRecordWindow(true)
    end,true,1)

    -- =========================================================
    -- NÚT RÈN NHANH (SỬA LỖI LOGIC)
    -- =========================================================
    registerButtonEventListener(self.btn_all_composite, function()
        if self.role_vo.vip_lev < partner_const.synthesis_vip_lev.val and self.role_vo.lev < partner_const.synthesis_character_lev.val then
            local str = string.format(TI18N("Đạt tới Lv.%d hoặc VIP%d để mở khóa"),partner_const.synthesis_character_lev.val,partner_const.synthesis_vip_lev.val)
            message(str)
            return
        end

        local mapped_index = self.cur_index + self.id_offset
        local list = eqm_comp_list[mapped_index]
        local action_done = false

        -- Quét từ trang bị cao cấp nhất xuống thấp nhất
        for i = #list, 1, -1 do
            local data = list[i]
            -- Dùng hàm tính toán đã fix (check cả 2 túi) để xem rèn được bao nhiêu
            local max_num = self:calculateMaxMakeNum(data.expend)
            
            if max_num > 0 then
                -- Kiểm tra đủ bạc không
                local cost = data.expend[2][2] * max_num
                if self.role_vo.coin < cost then
                     message(TI18N("Không đủ Bạc"))
                     return
                end
                
                -- Gửi lệnh rèn thường (11080) nhưng với số lượng Max
                -- Điều này giúp bypass lỗi server của lệnh 11079
                controller:send11080(data.id, max_num)
                action_done = true
                break
            end
        end

        if not action_done then
             message(TI18N("Không đủ nguyên vật liệu"))
        end
    end,true,1)

    -- Nút Rèn
    registerButtonEventListener(self.btn_composite, function()
        self.cur_index = self.cur_index or 1
        if self.touch_comp_base and self.cur_index then
            if self.role_vo.coin < self.compCoinNumber then
                message(TI18N("Không đủ Bạc"))
                return
            end
            
            local mapped_index = self.cur_index + self.id_offset
            local data = eqm_comp_list[mapped_index][self.touch_comp_base]
            local base_id = data.id
            
            local max_can = self:calculateMaxMakeNum(data.expend)
            if max_can <= 0 and self.composite_number > 0 then
                 message(TI18N("Không đủ nguyên vật liệu"))
                 return
            end

            if self.composite_number <= 0 then
                message(TI18N("Số lượng không hợp lệ"))
            else
                local function func()
                    controller:send11080(base_id,self.composite_number)
                end
                self.is_selected = nil
                self.is_tab_touch = nil
                self:releaseCompositeEffect()
                AudioManager:getInstance():playEffect(AudioManager.AUDIO_TYPE.COMMON, "c_equipment_forging")
                playEffectOnce(PathTool.getEffectRes(269), self.last_item:getPositionX()+165, self.last_item:getPositionY()-5, self.equip_container,func, nil, nil, nil, PlayerAction.action, 1,nil,2)
                
                if self.send_comp_ticket == nil then
                    self.send_comp_ticket = GlobalTimeTicket:getInstance():add(function()
                        self.is_tab_touch = true
                        self.is_selected = true
                        if self.send_comp_ticket ~= nil then
                            GlobalTimeTicket:getInstance():remove(self.send_comp_ticket)
                            self.send_comp_ticket = nil
                        end
                    end,1)
                end
            end
        end
    end,true, 1)

    -- Nút Tăng (+)
    registerButtonEventListener(self.btn_add, function()
        local mapped_index = self.cur_index + self.id_offset
        local data = eqm_comp_list[mapped_index][self.touch_comp_base]
        local max_can = self:calculateMaxMakeNum(data.expend)
        
        if self.composite_number < max_can then
            self.composite_number = self.composite_number + 1
            self.text_Field:setString(self.composite_number)
            self:updateMaterialRequirements(data.expend)
        end
        
        self:setTouchEnable_Add(not (max_can > 0 and self.composite_number < max_can))
        self:setTouchEnable_Redu(not (self.composite_number > 1))
    end,true, 1)

    -- Nút Giảm (-)
    registerButtonEventListener(self.btn_redu, function()
        if self.composite_number > 1 then
            self.composite_number = self.composite_number - 1
            self.text_Field:setString(self.composite_number)
            local mapped_index = self.cur_index + self.id_offset
            local data = eqm_comp_list[mapped_index][self.touch_comp_base]
            self:updateMaterialRequirements(data.expend)
        end
        
        local mapped_index = self.cur_index + self.id_offset
        local data = eqm_comp_list[mapped_index][self.touch_comp_base]
        local max_can = self:calculateMaxMakeNum(data.expend)
        
        self:setTouchEnable_Add(not (max_can > 0 and self.composite_number < max_can))
        self:setTouchEnable_Redu(not (self.composite_number > 1))
    end,true, 1)
end

function ForgeHouseWindow:releaseCompositeEffect()
    if self.composite_effect ~= nil then
        GlobalTimeTicket:getInstance():remove(self.composite_effect)
        self.composite_effect = nil
    end
end

function ForgeHouseWindow:register_event()
    self:addGlobalEvent(ForgeHouseEvent.Composite_Result, function()
        self.is_tab_touch = true
        self.is_selected = true
        self.cur_index = self.cur_index or 1
        
        local mapped_index = self.cur_index + self.id_offset
        local current_data = eqm_comp_list[mapped_index][self.touch_comp_base]
        local eqm_list = current_data.expend
        
        local max_can = self:calculateMaxMakeNum(eqm_list)
        if max_can > 0 then
            self.composite_number = max_can
        else
            self.composite_number = 1
        end
        
        local m_bid = eqm_list[1][1]
        local m_cost = eqm_list[1][2]
        local num = self:getMaterialNum(m_bid)
        
        self.bar_num:setString(num.."/"..m_cost)
        self.bar:setPercent(math.floor(num/m_cost*100))
        self.text_Field:setString(self.composite_number)
        
        self:updateMaterialRequirements(eqm_list)
        self:setTouchEnable_Add(not (max_can > 0 and self.composite_number < max_can))
        self:setTouchEnable_Redu(not (self.composite_number > 1))

        -- Refresh scroll list redpoint
        local list = self.item_scrollview:getItemList()
        local status = false
        for k, v in pairs(list) do
            local data = v:getData()
            if data and v then
                local item_max = self:calculateMaxMakeNum(data.expend)
                if item_max >= 1 then
                    v:setVisibleResPoint(true)
                    status = true
                else
                    v:setVisibleResPoint(false)
                end
            end
        end
        self.tab_list[self.cur_index].redpoint:setVisible(status)
    end)

    self:addGlobalEvent(HeroEvent.Artifact_Lucky_Red_Event, function ( )
        local object = self.top_tab_list[4] 
        if object then
            local red_status = HeroController:getInstance():getModel():getArtifactLuckyRedStatus()
            object.tips:setVisible(red_status)
        end
    end)

    registerButtonEventListener(self.close_btn, function()
        controller:openForgeHouseView(false)
    end,true, 2)

    for k, object in pairs(self.top_tab_list) do
        if object.tab_btn then
            object.tab_btn:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playTabButtonSound()
                    self:changeSelectedTab(object.index)
                end
            end)
        end
    end
end

function ForgeHouseWindow:openRootWnd(index)
    index = index or 1
    self:changeSelectedTab(index)
end

function ForgeHouseWindow:changeSelectedTab( index )
    if self.tab_object ~= nil and self.tab_object.index == index then return end

    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        self.tab_object = nil
    end
    self.tab_object = self.top_tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
    end

    self.current_mode = index

    if index == 4 then 
        self.equip_container:setVisible(false)
        self.artifact_container:setVisible(true)
        if not self.init_artifact then
            self.init_artifact = true
            self.artifact_layout = ForgeArtifactPanel.new()
            self.artifact_container:addChild(self.artifact_layout)
        end
    else
        self.equip_container:setVisible(true)
        self.artifact_container:setVisible(false)
        
        if index == 1 then
            self.id_offset = 0
        elseif index == 2 then
            self.id_offset = 4
        elseif index == 3 then
            self.id_offset = 8
        end
        
        if not self.init_equip then
            self:initEquipLayout()
            self.init_equip = true
        end

        self.cur_index = nil 
        self:refreshTabContents()
        self:tabChangeView(1)
    end
end

function ForgeHouseWindow:refreshTabContents()
    local current_names = self.sub_tab_names[self.current_mode]
    for i = 1, 4 do
        local tab = self.tab_list[i]
        if tab then
            if current_names and current_names[i] then
                tab.title:setString(current_names[i])
            else
                tab.title:setString("---")
            end
            
            local mapped_index = i + self.id_offset
            local list = eqm_comp_list[mapped_index]
            local status = false
            if list then
                for _, data in pairs(list) do
                    if data then
                        if self:calculateMaxMakeNum(data.expend) >= 1 then
                            status = true
                            break
                        end
                    end
                end
            end
            tab.redpoint:setVisible(status)
        end
    end
end

function ForgeHouseWindow:initRedPoint()
    self:refreshTabContents()
end

function ForgeHouseWindow:close_callback()
    self:releaseCompositeEffect()
    if self.send_comp_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.send_comp_ticket)
        self.send_comp_ticket = nil
    end
    
    if self.item_scrollview then 
       self.item_scrollview:DeleteMe()
       self.item_scrollview = nil
    end
    if self.artifact_layout then
        self.artifact_layout:DeleteMe()
        self.artifact_layout = nil
    end
    if self.cur_item then 
       self.cur_item:DeleteMe()
       self.cur_item = nil
    end
    if self.last_item then 
       self.last_item:DeleteMe()
       self.last_item = nil
    end
    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    if self.role_vo ~= nil then
        if self.role_assets_event ~= nil then
            self.role_vo:UnBind(self.role_assets_event)
            self.role_assets_event = nil
        end
    end

    controller:openForgeHouseView(false)
end