ForgehouseOrderWindow = ForgehouseOrderWindow or BaseClass(BaseView)

local controller = ForgeHouseController:getInstance()
local model = controller:getModel()
local table_sort = table.sort
local table_insert = table.insert
function ForgehouseOrderWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full

    self.layout_name = "forgehouse/forgehouse_order_window"
    self.res_list = {{
        path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"),
        type = ResourcesType.plist
    }, {
        path = PathTool.getPlistImgForDownLoad("oncewarorder", "oncewarorder"),
        type = ResourcesType.plist
    }}

    self.reward_list = {}
end

function ForgehouseOrderWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    -- if self.background ~= nil then
    --     self.background:loadTexture(PathTool.getPlistImgForDownLoad("bigbg", "bigbg_99", true), LOADTEXT_TYPE)
    -- end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    self.icon_img = self.main_container:getChildByName("icon_img")
    -- 解锁奖励总览
    self.btn_open_lock = self.main_container:getChildByName("btn_open_lock")
    self.btn_open_lock_label = self.btn_open_lock:getChildByName("name")
    setTextSpacing(self.btn_open_lock_label)
    self.btn_open_lock_label:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self.btn_open_lock_label:setString(TI18N("语言_c_5001"))

    self.btn_rule = self.main_container:getChildByName("btn_rule")
    self.btn_close = self.main_container:getChildByName("btn_close")
    local Image_1 = self.main_container:getChildByName("Image_1")
    local medal_title = Image_1:getChildByName("medal_title")
    medal_title:setString(TI18N("语言_c_5002"))
    setTextMaxWidth(medal_title, 260, -6)
    self.medal_num = Image_1:getChildByName("medal_num")
    self.medal_num:setString("")
    local Image_4 = self.main_container:getChildByName("Image_4")
    self.desc_txt = Image_4:getChildByName("Text_33")
    self.desc_txt:setString(TI18N("语言_c_5111"))
    setTextMaxWidth(self.desc_txt,330)
    self.go_btn = self.main_container:getChildByName("go_btn")--前往按钮
    self.go_btn:getChildByName("name_0"):setString(TI18N("语言_c_108"))
    local Image_7 = self.main_container:getChildByName("Image_7")
    Image_7:getChildByName("coin_label"):setString(TI18N("语言_hol_sta_pa_01_2"))
    local Image_15 = self.main_container:getChildByName("Image_15")
    self.title_txt = Image_15:getChildByName("Text_33_0")
    self.title_txt:setString(TI18N("语言_c_5000"))
    self.goods_item = self.main_container:getChildByName("goods_item")
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 720, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true,
        checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    ---进度条相关
    local scroll_view_size2 = cc.size(100, scroll_view_size.height)
    local setting = {
        start_x = 8, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 100, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.reward_num_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
    self.reward_num_item:setClickEnabled(false)
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell

    -- self:createProgress()
    self:initAwardConfig()
    controller:sender24711()
    -- self:adaptationScreen()
    -- self:updatePercent()
    -- self:updateIconImg() -- 背景
    -- self:upDataTips() -- 领奖提示
end

function ForgehouseOrderWindow:upDataTips()
    local order_info = model:getForgeHouseOrderInfo() or {}
    local now_score = order_info.id or 0
    local next_info = model:getNextForgeHouseRewardInfo()
    local str = string_format(TI18N("%d/%d"),now_score,next_info.progress[2])
    self.medal_num:setString(str)
end

-- 奖励列表
function ForgehouseOrderWindow:createTaskCell()
    local cell = ForgehouseOrderItem.new()
    return cell
end

function ForgehouseOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ForgehouseOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end

-- 进度条
-- 功勋数数列表
function ForgehouseOrderWindow:createTaskCell2()
    local cell = ForgehouseRewardItem.new()
    return cell
end

function ForgehouseOrderWindow:numberOfTaskCells2()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ForgehouseOrderWindow:updateTaskCellByIndex2(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end

-- 进度条
function ForgehouseOrderWindow:createProgress()
    if self.comp_bar == nil then
        local size = cc.size(315, 27)
        local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
        local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
        if self.reward_goods_item and not tolua.isnull(self.reward_goods_item) and self.reward_goods_item.container and
            not tolua.isnull(self.reward_goods_item.container) then
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.reward_goods_item.container:addChild(bar_layout, 999)
                self.bar_layout = bar_layout
            end
            local bg, comp_bar = createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true,0,1)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
        end
    end
end

function ForgehouseOrderWindow:register_event()
    if not self.update_dram_data_event then
        self.update_dram_data_event = GlobalEvent:getInstance():Bind(ForgeHouseEvent.UpdataOrdereInfo, function(data)
            self:initAwardConfig()
            self:updateIconImg() -- 背景
            self:upDataTips() -- 领奖提示
            self:setChangeLevelStatus()
        end)
    end

    registerButtonEventListener(self.btn_open_lock, function()
        controller:openOrderBuyWindow(true)
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        controller:openOrderWindow(false)
    end, true, 2)

    registerButtonEventListener(self.go_btn, function()
        controller:openOrderWindow(false)
        ForgeHouseController:getInstance():openForgeHouseView(true, ForgeHouseConst.Tab_Index.Artifact)
    end, true, 2)

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = Config.PartnerArtifactData.data_artifact_const.dungeon_pass_rule_desc
        if config then
            local config_desc = config.desc
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
end

-- 滑动的时候处理显示
function ForgehouseOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end

function ForgehouseOrderWindow:updateIconImg()
    local status = model:getOrderActStatus()
    if self.icon_img then
        local basecfg = Config.PartnerArtifactData.data_artifact_const
        local res = basecfg.dungeon_pass_icon.desc
        loadSpriteTexture(self.icon_img, PathTool.getResFrame("oncewarorder", res), LOADTEXT_TYPE_PLIST)
    end
    if status ~= 0 then
        setChildUnEnabled(false, self.icon_img)
    else
        setChildUnEnabled(true, self.icon_img)
    end
    if self.btn_open_lock then
        if status ~= 0 then
            self.btn_open_lock:setVisible(false)
        else
            self.btn_open_lock:setVisible(true)
        end
    end
end
-- 
function ForgehouseOrderWindow:setChangeLevelStatus()
    local getnum = 1
    local order_status = ForgeHouseController:getInstance():getModel():getOrderActStatus()
    local cfg = Config.PartnerArtifactData.data_artifact_war_order_level
    local order_info = model:getForgeHouseOrderInfo() or {}
    local now_score = order_info.id or 0
    for i, v in ipairs(cfg) do
        local s_score = v.progress[2]
        if now_score >= s_score then
            local get_status = ForgeHouseController:getInstance():getModel():getOrderRewardStatus(v.lev)
            if order_status ~= 0 then --战令已经解锁
                if get_status == 1 or get_status == 2 then -- 可领取
                    getnum = v.lev
                    break
                end
            else
                if get_status == 1 then -- 可领取
                    getnum = v.lev
                    break
                end
            end
        else
            getnum = v.lev - 1
            if getnum < 1 then
                getnum  = 1
            end
            break
        end
    end
    self:jumpToMoveByY(139 * (getnum - 1))
end

function ForgehouseOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end
    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
    self.reward_num_item:scrollToPercentVertical(pos_per, 0.5, true)
end

function ForgehouseOrderWindow:initAwardConfig()
    self.reward_list = {}
    local reward_data = Config.PartnerArtifactData.data_artifact_war_order_level
    self.reward_list = deepCopy(reward_data)
    self.reward_goods_item:reloadData(nil,nil,true)
    self.reward_num_item:reloadData(nil,nil,true)
    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
end

function ForgehouseOrderWindow:openRootWnd()

end

function ForgehouseOrderWindow:close_callback()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    controller:openOrderWindow(false)
end

