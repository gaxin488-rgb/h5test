-- 奖励子项
ForgehouseOrderItem = class("ForgehouseOrderItem", function()
    return ccui.Widget:create()
end)

function ForgehouseOrderItem:ctor()
    self:configUI()
    self:register_event()
end

function ForgehouseOrderItem:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("forgehouse/forgehouse_order_item"))
    self:setContentSize(cc.size(720, 139))
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.goods_item = main_container:getChildByName("goods_item") -- 付费礼物
    self.goods_item:setScrollBarEnabled(false)
    self.free_goods_item = main_container:getChildByName("free_goods_item") -- 免费礼物
    self.free_goods_item:setScrollBarEnabled(false)
    self.finish_img = main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_name = self.btn_get:getChildByName("name")
    self.btn_name:setString("")
end

function ForgehouseOrderItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        local order_status =  ForgeHouseController:getInstance():getModel():getOrderActStatus()
        local get_status = ForgeHouseController:getInstance():getModel():getOrderRewardStatus(self.data.lev)
        if order_status ~= 0 then --战令已经解锁
            if get_status == 1 or get_status == 2 then -- 可领取
                controller:sender24712(self.data.lev)
            elseif get_status == 0 then--前往过关
                controller:openOrderWindow(false)
                ForgeHouseController:getInstance():openForgeHouseView(true, ForgeHouseConst.Tab_Index.Artifact)
            end
        else --战令未解锁时
            if get_status == 1 then --可领取
                controller:sender24712(self.data.lev)
            elseif get_status == 0 then --前往过关
                controller:openOrderWindow(false)
                ForgeHouseController:getInstance():openForgeHouseView(true, ForgeHouseConst.Tab_Index.Artifact)
            elseif get_status == 2 then
                controller:openOrderBuyWindow(true)
            end
        end
    end, true, 1)
end

function ForgehouseOrderItem:setData(data)
    if not data then
        return
    end
    self.data = data
    local order_status = ForgeHouseController:getInstance():getModel():getOrderActStatus()
    local get_status = ForgeHouseController:getInstance():getModel():getOrderRewardStatus(self.data.lev)
    local free_effect_id
    local free_get_status = false
    local free_lock_ststus = false

    local pay_effect_id
    local is_pay_status = false
    local pay_lock_status = false
    if order_status ~= 0 then -- 战令已解锁
        if get_status == 0 then
            pay_lock_status = false
            free_lock_ststus = true
        elseif get_status == 1 then
            pay_effect_id = 263
            free_effect_id = 263
        elseif get_status == 2 then
            free_get_status = true
            pay_effect_id = 263
        elseif get_status == 3 then
            free_get_status = true
            is_pay_status = true
        end
    else
        if get_status == 0 then
            pay_lock_status = true
            free_lock_ststus = true
        elseif get_status == 1 then
            pay_lock_status = true
            free_effect_id = 263
        elseif get_status == 2 then
            free_get_status = true
            pay_lock_status = true
        elseif get_status == 3 then
            free_get_status = true
            is_pay_status = true
        end
    end
    --免费道具
    local free_data_list = self.data.reward or {}
    local setting1 = {}
    setting1.start_x = 10
    setting1.scale = 0.7
    setting1.is_tip = true
    setting1.show_effect_id = free_effect_id
    setting1.is_get_status = free_get_status
    setting1.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.free_item_list = commonShowSingleRowItemList(self.free_goods_item, self.free_item_list, free_data_list,setting1)
    -- 付费道具
    local data_list = self.data.rmb_reward or {}
    local setting = {}
    setting.start_x = 10
    setting.scale = 0.7
    setting.lock = pay_lock_status
    setting.is_tip = true
    setting.max_count = 2
    setting.show_effect_id = pay_effect_id
    setting.is_get_status = is_pay_status
    setting.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.item_list = commonShowSingleRowItemList(self.goods_item, self.item_list, data_list, setting)
    if self.btn_get then
        addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
        if order_status ~= 0 then --战令已经解锁
            if get_status == 1 or get_status == 2 then -- 可领取
                self.btn_name:enableOutline(Config.ColorData.data_color4[264], 2)
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 5, 5)
            elseif get_status == 3 then--已领取
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
            elseif get_status == 0 then--前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            end
        else --战令未解锁时
            if get_status == 1 then --可领取
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 5, 5)
            elseif get_status == 0 then --前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            elseif get_status == 2 then
                self.btn_name:setString(TI18N("语言_c_2684"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            elseif get_status == 3 then
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
            end
        end
    end
end

function ForgehouseOrderItem:DeleteMe()
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.free_item_list then
        for i, v in pairs(self.free_item_list) do
            v:DeleteMe()
        end
        self.free_item_list = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

