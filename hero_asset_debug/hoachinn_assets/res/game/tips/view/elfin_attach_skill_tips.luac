function ElfinAttachSkillTips:setPos(x, y)
    -- self.root_wnd:setPosition(cc.p(x, y))
end

function ElfinAttachSkillTips:getContentSize()
    return self.root_wnd:getContentSize()
end

--[[
@功能:打开技能tips
@参数:
@返回值:
]]
function ElfinAttachSkillTips:openRootWnd( config, data)
    self.__data = data
    self._elfinId = data.id
    self._targetElfinId = data.targetId
    self:updateVo(config, false, false, false, 0, 0, config.level)

    if not _model:checkSpriteIsOwn(self._targetElfinId) then
        setChildUnEnabled(true, self.attach_btn)
    else
        setChildUnEnabled(false, self.attach_btn)
    end

    delayRun(self.root_wnd, 114, function()
        TipsManager:getInstance():hideTips()
    end)
end

function ElfinAttachSkillTips:close_callback( ... )
    -- if self.root_root then
    --     self.root_root:removeAllChildren()
    --     self.root_root:removeFromParent()
    -- end
end
