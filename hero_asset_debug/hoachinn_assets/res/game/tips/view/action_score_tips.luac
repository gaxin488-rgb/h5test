-- --------------------------------------------------------------------
-- z物品tips
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
ActionScoreTips = ActionScoreTips or BaseClass(BaseView)
local table_insert = table.insert
function ActionScoreTips:__init()
    self.ctrl = BackpackController:getInstance()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "tips/action_score_tips"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("wonderland", "wonderland"),type = ResourcesType.plist },
    }
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
end

function ActionScoreTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.container = self.main_panel:getChildByName("container")
    self.container_init_size = self.container:getContentSize()

    -- 基础属性,名字,类型和评分等
    self.base_panel = self.container:getChildByName("base_panel")

    self.name = self.base_panel:getChildByName("name")
    self.score_img = self.base_panel:getChildByName("score_img")
    self.name:ignoreContentAdaptWithSize(true)
    self.name:setTextAreaSize(cc.size(240, 0))
    setTextSpacing(self.name, -6)

    -- 描述部分
    self.desc_panel = self.container:getChildByName("desc_panel")
    self.desc_panel_size = self.desc_panel:getContentSize()
    self.scroll_view = self.desc_panel:getChildByName("scroll_view")
    self.scroll_view:setScrollBarEnabled(false)
    self.scroll_size = self.scroll_view:getContentSize()
    self.desc_label = createRichLabel(22, cc.c4b(0xa1,0x97,0x8b,0xff), cc.p(0, 1), cc.p(20, 100), 8, nil, 380) 
    self.scroll_view:addChild(self.desc_label)

    self.close_btn = self.main_panel:getChildByName("close_btn")
end
function ActionScoreTips:register_event()
    if self.background then 
        self.background:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                self:close()
            end
        end)
    end
    if self.close_btn then 
        self.close_btn:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                self:close()
            end
        end)
    end
end

--引入 setting 
function ActionScoreTips:openRootWnd(res,name,desc)
    if not res then return end
    self.data = res
    self.desc = desc
    self.item_name = name
    self:setBaseInfo()
end

--==============================--
--desc:设置基础属性
--time:2018-10-22 10:18:13
--@return 
--==============================--
function ActionScoreTips:setBaseInfo()
    loadSpriteTexture(self.score_img, PathTool.getResFrame("wonderland", self.data), LOADTEXT_TYPE_PLIST)
    local color = BackPackConst.quality_color[5]
    self.name:setTextColor(color) 
    self.name:setString(self.item_name)
    -- 描述
    self.desc_label:setString(self.desc)
    local label_size = self.desc_label:getContentSize()
    self.item_scrollview_size = cc.size(410,0)
    local item_scrollview_height = 0
    local max_height = math.max(label_size.height+item_scrollview_height, self.scroll_size.height)
    self.scroll_view:setContentSize(cc.size(self.scroll_size.width, math.min(max_height, 320))) -- 600 - 252 - 32
    self.scroll_view:setInnerContainerSize(cc.size(self.scroll_size.width, max_height))
    self.desc_label:setPositionY(max_height)
end

function ActionScoreTips:close_callback()
    TipsController:getInstance():openActionScoreTips(false)
end
