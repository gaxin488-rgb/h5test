GoldequipProviewWindow = GoldequipProviewWindow or BaseClass(BaseView)

local _controller = ForgeHouseController:getInstance()

function GoldequipProviewWindow:__init()
    self.is_full_screen = false
    self.win_type = WinType.Mini  
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
	self.cell_data_list = {}
    self.layout_name = "forgehouse/goldequip_proview_window"
end

function GoldequipProviewWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(main_panel, 2)
	local main_container  = main_panel:getChildByName("main_container")

	local title_container = main_panel:getChildByName("title_container")
	local Image_1_0 = title_container:getChildByName("Image_1_0")
	local title_label = title_container:getChildByName("title_label")
	title_label:setString(TI18N("语言_c_6808"))
	Image_1_0:setContentSize(cc.size(title_label:getContentSize().width + 180,Image_1_0:getContentSize().height))

	self.close_btn = main_panel:getChildByName("close_btn")

	if self.item_scrollview == nil then
        local scroll_view_size = main_container:getContentSize()
        local setting = {
            start_x = 15, -- 第一个单元的X起点
            space_x = 10, -- x方向的间隔
            start_y = 20, -- 第一个单元的Y起点
            space_y = 10, -- y方向的间隔
            item_width = 130, -- 单元的尺寸width
            item_height = 130, -- 单元的尺寸height
			row = 0,                        -- 行数，作用于水平滚动类型
			col = 4,                         -- 列数，作用于垂直滚动类型
            once_num = 1 -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(main_container, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top,scroll_view_size,setting,cc.p(0, 0))
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.createNewCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.numberOfCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.updateCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    end
end
function GoldequipProviewWindow:createNewCell(width, height)
    local cell = GoldequipProviewItem.new()
    -- cell:addCallBack(function()
    --     self:onCellTouched(cell)
    -- end)
    return cell
end

function GoldequipProviewWindow:numberOfCells()
    if not self.cell_data_list then
        return 0
    end
    return #self.cell_data_list
end
-- 更新cell(拖动的时候.刷新数据时候会执行次方法)
-- cell :createNewCell的返回的对象
-- index :数据的索引
function GoldequipProviewWindow:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.cell_data_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end
function GoldequipProviewWindow:onCellTouched(cell)
end

function GoldequipProviewWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), false, 2)
	registerButtonEventListener(self.background, handler(self, self._onClickCloseBtn), false, 2)
end

function GoldequipProviewWindow:_onClickCloseBtn(  )
	_controller:openGoldequipProviewWindow(false)
end

function GoldequipProviewWindow:openRootWnd(  )
	self:setData()
end

function GoldequipProviewWindow:setData()
	local cfg = Config.PartnerGoldeqmData.data_get_top_preview
	for k, v in pairs(cfg) do
		local data = deepCopy(v)
		table.insert(self.cell_data_list,data)
	end
    table.sort(self.cell_data_list, function(a, b) return a.sort < b.sort end)
	self.item_scrollview:reloadData()
end

function GoldequipProviewWindow:close_callback(  )
	_controller:openGoldequipProviewWindow(false)
end


GoldequipProviewItem = class("GoldequipProviewItem", function() 
	return ccui.Layout:create()
end)

function GoldequipProviewItem:ctor(click, scale, effect, is_show_tips, swallow_touch)

	self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/cost_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
	self:setContentSize(cc.size(130, 130))

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setContentSize(cc.size(130, 130))
	self.root_wnd:setPosition(65, 65)
	self:addChild(self.root_wnd)

	self.main_container = self.root_wnd:getChildByName("main_container")
	self.main_container:setTouchEnabled(true)
	self.main_container:setSwallowTouches(false)
	self.main_container:setContentSize(cc.size(130, 130))
	self.main_container:setPosition(65, 65)
	self.item_node = self.main_container:getChildByName("item_node")
	self.item_node:setPosition(65, 65)

	local desc = self.main_container:getChildByName("desc")
    desc:setVisible(false)

	self:registerEvent()
end

function GoldequipProviewItem:getData()
	return self.data
end
function GoldequipProviewItem:getSendData()
    return self.send_data
end
function GoldequipProviewItem:addCallBack(callback)
	self.callback = callback
end

function GoldequipProviewItem:setData(data)
	self.data = data
	--{id=40118, lev1=5, lev2=400, attr1={{'atk',1477},{'atk_per',36}}, attr2=50},common_1_215
    if not self.item then
        self.item = BackPackItem.new(false, false, false, 0.95, false, true,false)
        self.item_node:addChild(self.item)
    end
    self.item:setBaseData(data.id)
    local res =  PathTool.getResFrame("common","common_1_216",false,"common_1")
	self.item:setStarCount(true, 6,res)
	self.item:setJieTxt(true,self.data.lev1)
end

function GoldequipProviewItem:registerEvent()
    registerButtonEventListener(self.main_container, function()
		HeroController:getInstance():openHighEquipFullPreviewWindow(true,self.data)
    end, false, 1)
end

function GoldequipProviewItem:DeleteMe()
    if self.item then 
        self.item:DeleteMe()
        self.item = nil
    end
	self:removeAllChildren()
    self:removeFromParent()
end
