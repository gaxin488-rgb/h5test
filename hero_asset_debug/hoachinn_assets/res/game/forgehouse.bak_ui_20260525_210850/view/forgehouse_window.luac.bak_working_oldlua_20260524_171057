	self.text_Field = self.equip_container:getChildByName("text_Field")
    local function textFieldEvent(sender, eventType)
        if eventType == ccui.TextFiledEventType.attach_with_ime then
        elseif eventType == ccui.TextFiledEventType.detach_with_ime then
	        	local data = self:getCurComposeData()
	        	if data == nil then return end

	        	local max_num = self:getComposeMaxNumber(data)
	        	if self.text_Field:getString() == "" then
	        		message(TI18N("语言_c_4363"))
	        		self.composite_number = 0
	        	else
		        	local input_num = tonumber(self.text_Field:getString())
		        	if type(input_num) == "number" and type(max_num) == "number" then
		        		input_num = math.floor(input_num)
		        		if input_num < 0 then
		        			input_num = 0
		        		end
		        		if input_num > max_num then
		        			input_num = max_num
		        		end
		        		self.composite_number = input_num
		        	else
		        		message(TI18N("语言_c_4517"))
		        	end
	        	end
