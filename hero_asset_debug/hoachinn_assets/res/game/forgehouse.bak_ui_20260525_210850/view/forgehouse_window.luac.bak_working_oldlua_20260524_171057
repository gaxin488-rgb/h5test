-- Chuyển nguồn dữ liệu cho equip tab (dùng chung equip_container)
function ForgeHouseWindow:switchEquipDataSource(comp_list, title_list)
	self.active_comp_list = comp_list
	-- Cập nhật sub-tab titles và visibility
	for i = 1, 4 do
		local tab = self.tab_list[i]
		if tab then
			local has_data = comp_list[i] and #comp_list[i] > 0
			tab:setVisible(has_data)
			if has_data and tab.title and title_list[i] then
				tab.title:setString(title_list[i])
			end
		end
	end
	-- Reset state
	if self.cur_tab then
		self.cur_tab.select:setVisible(false)
		self.cur_tab.title:setTextColor(cc.c4b(0xEE, 0xD1, 0xAF, 0xff))
		self.cur_tab.title:enableOutline(cc.c4b(0x53, 0x3D, 0x32, 0xff), 2)
		self.cur_tab.title:setFontSize(24)
		self.cur_tab = nil
	end
	self.cur_index = nil
	self.touch_comp_base = 1
	self.composite_number = 0
	self.is_selected = nil
	if self.text_Field then
		self.text_Field:setString("0")
	end
	-- Tìm sub-tab đầu tiên có data
	local first_tab = nil
	for i = 1, 4 do
		if comp_list[i] and #comp_list[i] > 0 then
			first_tab = i
			break
		end
	end
	if first_tab then
		self:tabChangeView(first_tab)
	else
		if self.last_item then self.last_item:setDefaultTip() end
		if self.cur_item then self.cur_item:setDefaultTip() end
	end
	self:initRedPoint()
end

-- 切换顶部标签页
function ForgeHouseWindow:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end

    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        if self.tab_object.unselect_bg then self.tab_object.unselect_bg:setVisible(true) end
        -- Reset về unselected: scale bình thường + màu trắng
        if self.tab_object.tab_btn then
            self.tab_object.tab_btn:stopAllActions()
            self.tab_object.tab_btn:setScale(1.0)
        end
        if self.tab_object.lable then
            self.tab_object.lable:setTextColor(cc.c4b(0xFF, 0xFF, 0xFF, 0xFF))
            self.tab_object.lable:enableOutline(cc.c4b(0x6D, 0x35, 0x07, 0xFF), 2)
        end
        self.tab_object = nil
    end
    self.tab_object = self.top_tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        if self.tab_object.unselect_bg then self.tab_object.unselect_bg:setVisible(false) end
        -- Selected: bounce animation nhẹ + màu vàng sáng
        if self.tab_object.tab_btn then
            self.tab_object.tab_btn:stopAllActions()
            local bounce = cc.Sequence:create(
                cc.ScaleTo:create(0.08, 1.08),
                cc.ScaleTo:create(0.06, 1.03)
            )
            self.tab_object.tab_btn:runAction(bounce)
        end
        if self.tab_object.lable then
            self.tab_object.lable:setTextColor(cc.c4b(0xFF, 0xE8, 0x4D, 0xFF))
            self.tab_object.lable:enableOutline(cc.c4b(0x8B, 0x45, 0x00, 0xFF), 2)
        end
    end

    -- Ẩn tất cả container
    self.equip_container:setVisible(false)
    self.artifact_container:setVisible(false)

	if index == ForgeHouseConst.Tab_Index.Equip then
		self.equip_container:setVisible(true)
		if not self.init_equip then
			self:initEquipLayout()
			self.init_equip = true
		end
		self:switchEquipDataSource(eqm_comp_list, equip_sub_titles)
	elseif index == ForgeHouseConst.Tab_Index.SpecialEquip then
		self.equip_container:setVisible(true)
		if not self.init_equip then
			self:initEquipLayout()
			self.init_equip = true
		end
		self:switchEquipDataSource(special_comp_list, special_sub_titles)
	elseif index == ForgeHouseConst.Tab_Index.DivinEquip then
		self.equip_container:setVisible(true)
		if not self.init_equip then
			self:initEquipLayout()
			self.init_equip = true
		end
		self:switchEquipDataSource(divine_comp_list, divine_sub_titles)
	elseif index == ForgeHouseConst.Tab_Index.ForgeStone then
		self.equip_container:setVisible(true)
		if not self.init_equip then
			self:initEquipLayout()
			self.init_equip = true
		end
		self:switchEquipDataSource(forge_stone_comp_list, forge_stone_sub_titles)
	elseif index == ForgeHouseConst.Tab_Index.Artifact then
		self.artifact_container:setVisible(true)
		if not self.init_artifact then
			self.init_artifact = true
			self.artifact_layout = ForgeArtifactPanel.new()
			self.artifact_container:addChild(self.artifact_layout)
		end
	end
end

function ForgeHouseWindow:openRootWnd(index)
	index = index or ForgeHouseConst.Tab_Index.Equip
	self:changeSelectedTab(index)
end

--红点
function ForgeHouseWindow:initRedPoint()
	if not self.active_comp_list then return end
	for i=1,4 do
		local list = self.active_comp_list[i]
		local tab = self.tab_list[i]
		if tab and tab.redpoint then
			if list and #list > 0 then
				local status = false
				for k,data in pairs(list) do
					if data then
						if self:getComposeMaxNumber(data) > 0 then
							status = true
							break
						end
					end
				end
				tab.redpoint:setVisible(status)
			else
				tab.redpoint:setVisible(false)
			end
		end
	end
end

function ForgeHouseWindow:close_callback()
	self:releaseCompositeEffect()
	if self.send_comp_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.send_comp_ticket)
        self.send_comp_ticket = nil
    end
    
	if self.item_scrollview then 
       self.item_scrollview:DeleteMe()
       self.item_scrollview = nil
    end
    if self.artifact_layout then
    	self.artifact_layout:DeleteMe()
    	self.artifact_layout = nil
    end
    if self.cur_item then 
       self.cur_item:DeleteMe()
       self.cur_item = nil
    end
    if self.last_item then 
       self.last_item:DeleteMe()
       self.last_item = nil
    end
    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    if self.role_vo ~= nil then
        if self.role_assets_event ~= nil then
            self.role_vo:UnBind(self.role_assets_event)
            self.role_assets_event = nil
        end
    end

    controller:openForgeHouseView(false)
end
