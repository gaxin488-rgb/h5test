function ForgeHouseWindow:open_callback()
	local bg = self.root_wnd:getChildByName("bg")
	bg:ignoreContentAdaptWithSize(true)
	bg:loadTexture(PathTool.getPlistImgForDownLoad("bigbg","bigbg_64",true), LOADTEXT_TYPE)
    bg:setScale(display.getMaxScale())

	self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)
	-- 装备
	self.equip_container = self.main_container:getChildByName("equip_container")
	-- 符文
	self.artifact_container = self.main_container:getChildByName("artifact_container")

	local image_stage = self.equip_container:getChildByName("image_stage")
	local res = PathTool.getPlistImgForDownLoad("bigbg", "bigbg_80")
    if not self.item_load then
        self.item_load = createResourcesLoad(res, ResourcesType.single, function()
            if not tolua.isnull(image_stage) then
                image_stage:loadTexture(res,LOADTEXT_TYPE)
            end
        end,self.item_load)
    end

	-- 顶部标签页 (5 tab: Trang Bị | T.Bị Đ.Biệt | Thần Trang | Đá Rèn | Tạo Sách)
	local tab_container = self.main_container:getChildByName("tab_container")

    local TOP_TAB_COUNT = 5
    local tab_name_list = {
        [1] = TI18N("语言_c_2295"),
        [2] = "T.Bị Đ.Biệt",
        [3] = "Thần Trang",
        [4] = "Đá Rèn",
        [5] = TI18N("语言_c_2296"),
    }

    -- ============ LAYOUT PARAMS ============
    local TAB_SPACING  = 6
    local TAB_FONT     = 18
    local TAB_H        = 48      -- chiều cao cố định mỗi tab

    -- Mở rộng tab_container để 5 tab rộng rãi, căn giữa theo main_container
    local orig_size = tab_container:getContentSize()
    local main_w = self.main_container:getContentSize().width
    local new_w  = math.floor(main_w * 0.92)  -- chiếm 92% chiều rộng cửa sổ chính
    tab_container:setContentSize(cc.size(new_w, orig_size.height))
    -- Căn giữa tab_container trong main_container
    tab_container:setAnchorPoint(cc.p(0.5, 0.5))
    local main_h = self.main_container:getContentSize().height
    local tc_y = tab_container:getPositionY()
    tab_container:setPositionX(main_w / 2)
    -- Tắt clipping để tab không bị cắt
    pcall(function() tab_container:setClippingEnabled(false) end)

    local tc_size = tab_container:getContentSize()

    -- Texture: seerpalace_10018 (unselected) / seerpalace_10019 (selected)
    -- Kiểu thanh trang trí có viền, phong cách đặc biệt hơn
    local UNSEL_FRAME = PathTool.getResFrame("common_2", "seerpalace_10018.png")
    local SEL_FRAME   = PathTool.getResFrame("common_2", "seerpalace_10019.png")
    -- Scale9 CapInsets cho 186×63 texture
    local CAP_INSETS = cc.rect(25, 15, 136, 33)

    -- Chia đều 5 tab
    local avail_w = tc_size.width - (TOP_TAB_COUNT - 1) * TAB_SPACING
    local tab_w   = math.floor(avail_w / TOP_TAB_COUNT)
    local total_w = TOP_TAB_COUNT * tab_w + (TOP_TAB_COUNT - 1) * TAB_SPACING
    local offset_x = math.floor((tc_size.width - total_w) / 2)

    -- Lấy tab_btn_1 làm mẫu clone, ẩn tab_btn_2 gốc nếu có
    local template_btn = tab_container:getChildByName("tab_btn_1")
    local old_btn2 = tab_container:getChildByName("tab_btn_2")
    if old_btn2 then old_btn2:setVisible(false) end

    for i=1, TOP_TAB_COUNT do
        local tab_btn
        if i == 1 then
            tab_btn = template_btn
        else
            tab_btn = template_btn:clone()
            tab_btn:setName("tab_btn_"..i)
            tab_container:addChild(tab_btn)
        end

        -- Size & position
        tab_btn:setContentSize(cc.size(tab_w, TAB_H))
        tab_btn:setAnchorPoint(cc.p(0, 0))
        local y_offset = math.floor((tc_size.height - TAB_H) / 2)
        tab_btn:setPosition(cc.p(offset_x + (i - 1) * (tab_w + TAB_SPACING), y_offset))
        tab_btn:setTouchEnabled(true)
        tab_btn:setSwallowTouches(true)

        -- Background: seerpalace_10018 (unselected) / seerpalace_10019 (selected)
        local unselect_bg = tab_btn:getChildByName('unselect_bg')
        if unselect_bg then
            unselect_bg:loadTexture(UNSEL_FRAME, LOADTEXT_TYPE_PLIST)
            pcall(function()
                unselect_bg:setScale9Enabled(true)
                unselect_bg:setCapInsets(CAP_INSETS)
            end)
            unselect_bg:setContentSize(cc.size(tab_w, TAB_H))
            unselect_bg:setAnchorPoint(cc.p(0.5, 0.5))
            unselect_bg:setPosition(cc.p(tab_w / 2, TAB_H / 2))
        end
        local select_bg = tab_btn:getChildByName('select_bg')
        if select_bg then
            select_bg:loadTexture(SEL_FRAME, LOADTEXT_TYPE_PLIST)
            pcall(function()
                select_bg:setScale9Enabled(true)
                select_bg:setCapInsets(CAP_INSETS)
            end)
            select_bg:setContentSize(cc.size(tab_w, TAB_H))
            select_bg:setAnchorPoint(cc.p(0.5, 0.5))
            select_bg:setPosition(cc.p(tab_w / 2, TAB_H / 2))
        end

        local object = {}
        object.unselect_bg = unselect_bg
        if object.unselect_bg then object.unselect_bg:setVisible(true) end
        object.select_bg = select_bg
        if object.select_bg then object.select_bg:setVisible(false) end

        -- Label: căn giữa, 1 dòng (không giới hạn vùng text → không xuống hàng)
        object.lable = tab_btn:getChildByName("title")
        if object.lable then
            object.lable:setString(tab_name_list[i])
            object.lable:setAnchorPoint(cc.p(0.5, 0.5))
            object.lable:setPosition(cc.p(tab_w / 2, TAB_H / 2))
            object.lable:setFontSize(TAB_FONT)
            object.lable:setTextAreaSize(cc.size(0, 0))
            object.lable:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
            object.lable:setTextVerticalAlignment(cc.VERTICAL_TEXT_ALIGNMENT_CENTER)
            -- Unselected style: trắng kem nhẹ + viền nâu đậm
            object.lable:setTextColor(cc.c4b(0xFF, 0xFF, 0xFF, 0xFF))
            object.lable:enableOutline(cc.c4b(0x6D, 0x35, 0x07, 0xFF), 2)
        end

        object.tab_btn = tab_btn
        object.index = i

        -- Red-dot: đặt góc trên-phải
        object.tips = tab_btn:getChildByName("tips")
        if object.tips then
            object.tips:setPosition(cc.p(tab_w - 10, TAB_H - 6))
        end
        if object.index == ForgeHouseConst.Tab_Index.Artifact then
            local red_status = HeroController:getInstance():getModel():getArtifactLuckyRedStatus()
            if object.tips then object.tips:setVisible(red_status) end
        else
            if object.tips then object.tips:setVisible(false) end
        end
        self.top_tab_list[i] = object
    end

	self.close_btn = self.main_container:getChildByName("btn_return")

	--预加载音效
	AudioManager:getInstance():preLoadEffect(AudioManager.AUDIO_TYPE.COMMON, 'c_equipment_forging')
end

