function ForgeHouseWindow:getCurComposeData()
	local index = self.cur_index or 1
	local base = self.touch_comp_base or 1
	local comp_list = self.active_comp_list or eqm_comp_list
	if comp_list[index] then
		return comp_list[index][base]
	end
end

function ForgeHouseWindow:getExpendOwnNum(expend, expend_index)
	if expend == nil then return 0 end
	local item_cfg = Config.ItemData.data_get_data(expend[1])
	local gain_type = item_cfg and item_cfg.gain_type or 1
	local bag_code = BackPackConst.Gain_To_Bag_Code[gain_type] or BackPackConst.Bag_Code.BACKPACK
	return backpackModel:getItemNumByBid(expend[1], bag_code) or 0
end

function ForgeHouseWindow:getComposeMaxNumber(data)
	if data == nil or data.expend == nil then return 0 end
	local max_num = nil
	for expend_index, expend in ipairs(data.expend) do
		if expend and expend[2] and expend[2] > 0 then
			local own_num = self:getExpendOwnNum(expend, expend_index)
			local cur_max = math.floor(own_num / expend[2])
			if max_num == nil or cur_max < max_num then
				max_num = cur_max
			end
		end
	end
	return math.max(max_num or 0, 0)
end

function ForgeHouseWindow:refreshSourceDisplay(data)
	if data == nil or data.expend == nil or data.expend[1] == nil then return end
	local base_expend = data.expend[1]
	local num = self:getExpendOwnNum(base_expend, 1)
	self.bar_num:setString(num.."/"..base_expend[2])
	self.bar:setPercent(math.floor(num/base_expend[2]*100))
end

function ForgeHouseWindow:setCostNodeSize(bg_node, label_node)
	if bg_node == nil or label_node == nil then return end
	local size = label_node:getContentSize()
	local width = size.width
	if width < 100 then
		width = 120
	end
	bg_node:setContentSize(cc.size(width+15, bg_node:getContentSize().height))
end

function ForgeHouseWindow:updateCostNodeLayout()
	-- Thu thập các item đang hiển thị (mỗi item chỉ thêm 1 lần)
	local items = {}
	local function try_add(icon, label)
		if icon and icon:isVisible() then
			table.insert(items, {icon = icon, label = label})
		end
	end
	try_add(self.spriteGold,        self.gold_num)
	try_add(self.extra_spriteGold,  self.extra_gold_num)
	try_add(self.extra2_spriteGold, self.extra2_gold_num)
	try_add(self.extra3_spriteGold, self.extra3_gold_num)
	try_add(self.extra4_spriteGold, self.extra4_gold_num)
	try_add(self.extra5_spriteGold, self.extra5_gold_num)

	-- Ẩn bg clone (không dùng)
	if self.extra_bg  then self.extra_bg:setVisible(false)  end
	if self.extra2_bg then self.extra2_bg:setVisible(false) end
	if self.extra3_bg then self.extra3_bg:setVisible(false) end

	local n = #items
	if n == 0 then return end

	-- ============ THÔNG SỐ LAYOUT ============
	local ICON_SIZE   = 28   -- kích thước icon hiển thị (px)  → scale = 28/80 = 0.35
	local ICON_GAP    = 5    -- khoảng cách icon → label
	local LABEL_W     = 96   -- chiều rộng dành cho label
	local SLOT_W      = ICON_SIZE + ICON_GAP + LABEL_W  -- 129px
	local SLOT_H      = 32
	local MAX_PER_ROW = 4    -- tối đa 4 item / hàng → 4 item vẫn hiển thị 1 hàng duy nhất
	local H_GAP       = 8    -- khoảng cách ngang giữa các slot
	local V_GAP       = 8    -- khoảng cách dọc giữa các hàng
	local PAD_X       = 10   -- padding trái/phải của nền
	local PAD_Y       = 8    -- padding trên/dưới của nền
	-- Với 4 item: bg_w = 4*129 + 3*8 + 2*10 = 556px

	local cx = self.cost_bg_center.x
	local cy = self.cost_bg_center.y

	-- Số hàng cần thiết
	local num_rows = math.ceil(n / MAX_PER_ROW)

	-- Kích thước nền
	local max_cols = math.min(n, MAX_PER_ROW)
	local bg_w = math.max(self.cost_bg_default_size.width,
	                      max_cols * SLOT_W + (max_cols - 1) * H_GAP + PAD_X * 2)
	local bg_h = math.max(self.cost_bg_default_size.height,
	                      num_rows * SLOT_H + (num_rows - 1) * V_GAP + PAD_Y * 2)
	self.gold_bg:setContentSize(cc.size(bg_w, bg_h))

	-- Tổng chiều cao nội dung
	local total_h  = num_rows * SLOT_H + (num_rows - 1) * V_GAP
	local first_y  = cy + total_h / 2 - SLOT_H / 2

	-- Đặt vị trí từng item
	for i = 1, n do
		local item = items[i]
		local row  = math.ceil(i / MAX_PER_ROW)
		local col  = (i - 1) % MAX_PER_ROW + 1

		-- Số item trong hàng này (hàng cuối có thể ít hơn MAX_PER_ROW)
		local row_start = (row - 1) * MAX_PER_ROW + 1
		local row_end   = math.min(row * MAX_PER_ROW, n)
		local row_count = row_end - row_start + 1

		-- Căn giữa hàng theo nền
		local row_w     = row_count * SLOT_W + (row_count - 1) * H_GAP
		local start_x   = cx - row_w / 2

		-- Y của hàng hiện tại
		local iy = first_y - (row - 1) * (SLOT_H + V_GAP)

		-- X của slot hiện tại
		local ix = start_x + (col - 1) * (SLOT_W + H_GAP)

		-- Scale icon đồng nhất
		item.icon:setScale(ICON_SIZE / 80)
		item.icon:setAnchorPoint(cc.p(0, 0.5))
		item.label:setAnchorPoint(cc.p(0, 0.5))
		item.icon:setPosition(ix, iy)
		item.label:setPosition(ix + ICON_SIZE + ICON_GAP, iy)
	end
end

function ForgeHouseWindow:updateSingleCostDisplay(icon_node, label_node, bg_node, expend, expend_index)
	if icon_node == nil or label_node == nil then return end
	if expend == nil then
		if bg_node then
			bg_node:setVisible(false)
		end
		icon_node:setVisible(false)
		label_node:setVisible(false)
		return
	end

	local display_count = self.composite_number or 0
	if display_count <= 0 then
		display_count = 1
	end

	local need_num = (expend[2] or 0) * display_count
	local own_num = self:getExpendOwnNum(expend, expend_index)
	local item_config = Config.ItemData.data_get_data(expend[1])
	if item_config then
		local res = PathTool.getItemRes(item_config.icon)
		if icon_node.loadTexture then
			icon_node:loadTexture(res, LOADTEXT_TYPE)
		else
			loadSpriteTexture(icon_node, res, LOADTEXT_TYPE)
		end

		-- Scale down icons to make them look uniform
		if icon_node ~= self.spriteGold then
			icon_node:setScale(0.35)
        else
            -- Scale main gold icon as well
            icon_node:setScale(0.40)
		end
	end

	local str = MoneyTool.GetMoneyString(own_num) .. "/" .. MoneyTool.GetMoneyString(need_num)
	label_node:setString(str)
	if own_num < need_num then
		label_node:setTextColor(cc.c4b(0xff, 0x4f, 0x4f, 0xff))
	else
		label_node:setTextColor(cc.c4b(0xff, 0xff, 0xff, 0xff))
	end

	if bg_node then
		bg_node:setVisible(true)
		self:setCostNodeSize(bg_node, label_node)
	end
	icon_node:setVisible(true)
	label_node:setVisible(true)
end

function ForgeHouseWindow:refreshCostDisplay(data)
	if data == nil or data.expend == nil then return end

	local main_cost = data.expend[2]
	self.compCoinNumber = 0
	if main_cost then
		self.compCoinNumber = (main_cost[2] or 0) * (self.composite_number or 0)
	end

	self:updateSingleCostDisplay(self.spriteGold, self.gold_num, nil, main_cost, 2)

	local extra1 = data.expend[3]
	if extra1 then
		self:updateSingleCostDisplay(self.extra_spriteGold, self.extra_gold_num, nil, extra1, 3)
	else
		self.extra_spriteGold:setVisible(false)
		self.extra_gold_num:setVisible(false)
	end

	local extra2 = data.expend[4]
	if extra2 then
		self:updateSingleCostDisplay(self.extra2_spriteGold, self.extra2_gold_num, nil, extra2, 4)
	else
		if self.extra2_spriteGold then self.extra2_spriteGold:setVisible(false) end
		if self.extra2_gold_num then self.extra2_gold_num:setVisible(false) end
	end

	local extra3 = data.expend[5]
	if extra3 then
		self:updateSingleCostDisplay(self.extra3_spriteGold, self.extra3_gold_num, nil, extra3, 5)
	else
		if self.extra3_spriteGold then self.extra3_spriteGold:setVisible(false) end
		if self.extra3_gold_num then self.extra3_gold_num:setVisible(false) end
	end

	local extra4 = data.expend[6]
	if extra4 then
		self:updateSingleCostDisplay(self.extra4_spriteGold, self.extra4_gold_num, nil, extra4, 6)
	else
		if self.extra4_spriteGold then self.extra4_spriteGold:setVisible(false) end
		if self.extra4_gold_num then self.extra4_gold_num:setVisible(false) end
	end

	local extra5 = data.expend[7]
	if extra5 then
		self:updateSingleCostDisplay(self.extra5_spriteGold, self.extra5_gold_num, nil, extra5, 7)
	else
		if self.extra5_spriteGold then self.extra5_spriteGold:setVisible(false) end
		if self.extra5_gold_num then self.extra5_gold_num:setVisible(false) end
	end

	self:updateCostNodeLayout()
end

function ForgeHouseWindow:updateComposeButtonStatus(data)
	local max_num = self:getComposeMaxNumber(data)
	self:setTouchEnable_Add(max_num <= 0 or self.composite_number >= max_num)
	self:setTouchEnable_Redu(self.composite_number <= 1)
end

function ForgeHouseWindow:refreshComposeInfo(data, keep_input_num)
	if data == nil then return end
	self:refreshSourceDisplay(data)

	local max_num = self:getComposeMaxNumber(data)
	if keep_input_num == true then
		self.composite_number = math.max(math.min(self.composite_number or 0, max_num), 0)
	else
		self.composite_number = max_num
	end
	self.text_Field:setString(self.composite_number)
	self:refreshCostDisplay(data)
	self:updateComposeButtonStatus(data)
end

function ForgeHouseWindow:checkComposeResources(data, compose_number, show_tips)
	if data == nil or data.expend == nil then return false end
	compose_number = compose_number or self.composite_number or 0
	if compose_number <= 0 then
		if show_tips == true then
			message(TI18N("语言_c_2304"))
		end
		return false
	end

	for expend_index, expend in ipairs(data.expend) do
		local need_num = (expend[2] or 0) * compose_number
		local own_num = self:getExpendOwnNum(expend, expend_index)
		if own_num < need_num then
			if show_tips == true then
				if expend_index == 2 and Config.ItemData.data_assets_id2label[expend[1]] == "coin" then
					message(TI18N("语言_c_2303"))
				else
					local item_config = Config.ItemData.data_get_data(expend[1])
					if item_config and item_config.name then
						message(item_config.name.."不足")
					else
						message(TI18N("资源不足"))
					end
				end
			end
			return false
		end
	end
	return true
end

function ForgeHouseWindow:tabChangeView(index)
	if self.is_tab_touch == nil then return end
	if self.cur_index == index then return end
	if self.cur_tab ~= nil then
		self.cur_tab.select:setVisible(false)
		self.cur_tab.title:setTextColor(cc.c4b(0xEE, 0xD1, 0xAF, 0xff))
		self.cur_tab.title:enableOutline(cc.c4b(0x53, 0x3D, 0x32, 0xff), 2)
		self.cur_tab.title:setFontSize(24)
	end
	self.cur_index = index
	self.cur_tab = self.tab_list[self.cur_index]
	if self.cur_tab ~= nil then
		self.cur_tab.select:setVisible(true)
		self.cur_tab.title:disableEffect(cc.LabelEffect.OUTLINE)
		self.cur_tab.title:setTextColor(cc.c4b(0x60, 0x35, 0x1a, 0xff))
		self.cur_tab.title:setFontSize(26)
	end

	self.touch_comp_base = 1
	local list = (self.active_comp_list or eqm_comp_list)[self.cur_index]
			local data = list and list[self.touch_comp_base]
			if data == nil then return end

		  self.last_item:setBaseData(data.expend[1][1])
		  self.cur_item:setBaseData(data.id)
			self:refreshComposeInfo(data)

	self.item_scrollview:setData(list, function(cell)
		if not self.is_selected then return end
		local data = cell:getData()
		local list_item = self.item_scrollview:getItemList()
		for k, v in pairs(list_item) do
			if v then
				if data and v:getData() and v:getData().id == data.id then
					v:setMaskVisible(true)
					self.touch_comp_base = v:getData()._index
				else
					v:setMaskVisible(false)
				end
			end
		end

		if data == nil then return end
		self.last_item:setBaseData(data.expend[1][1])
		self.cur_item:setBaseData(data.id)
		self:refreshComposeInfo(data)
	end)

	self.item_scrollview:addEndCallBack(function()
		local list = self.item_scrollview:getItemList()
		local status = false

		for k, v in pairs(list) do
			if v then
				v:createSpriteMask()
				v:createSpriteRedPoint()
				if k == self.touch_comp_base then
					v:setMaskVisible(true)
				else
					v:setMaskVisible(false)
				end

				local data = v:getData()
				if data then
					local can_compose = self:getComposeMaxNumber(data) > 0
					v:setVisibleResPoint(can_compose)
					if can_compose == true then
						status = true
					end
				end
			end
		end
		self.is_selected = true
		self.tab_list[self.cur_index].redpoint:setVisible(status)
	end)
end


