--设置两边带有装饰的文本自适应
--text      文本
--leftImg   左侧装饰图片
--rightImg  右侧装饰图片
--bgImg     文本底部背景图（可无）
--space     两边预留间距
--isTurn    右侧图片是否是通过翻转
function setTextTweenBg(text,leftImg,rightImg,bgImg,space,isTurn)
    if not text or not text or not leftImg or not rightImg then return  end
    local space = space or 0
    local isTurn = isTurn or false
    text:setAnchorPoint(cc.p(0.5, 0.5))
    leftImg:setAnchorPoint(cc.p(1, 0.5))
    if isTurn then
        rightImg:setAnchorPoint(cc.p(1, 0.5))
    else
        rightImg:setAnchorPoint(cc.p(0, 0.5))
    end
    local text_width = text:getContentSize().width
    local text_x = text:getPositionX()
    local text_y = text:getPositionY()
    local text_half_width = text_width * 0.5
    leftImg:setPositionY(text_y)
    rightImg:setPositionY(text_y)
    local leftImg_x = text_x - text_half_width - space
    local rightImg_x = text_x + text_half_width + space
    leftImg:setPositionX(leftImg_x)
    rightImg:setPositionX(rightImg_x)
    if bgImg then
        local leftImg_width = leftImg:getContentSize().width
        local rightImg_width = rightImg:getContentSize().width
        local bgimg_height = bgImg:getContentSize().height
        local bgimg_width = space * 2 +leftImg_width + rightImg_width + text_width
        bgImg:setAnchorPoint(cc.p(0.5, 0.5))
        bgImg:setContentSize(bgimg_width,bgimg_height)
    end
end

--设置一个文本或图片一个跟着一个的布局，Y不改变
--{oneitem,twoitem}   两个或多个
--space     两边预留间距
function setItemXOneByOne(itemarr,space)
    space = space or 5
    local len = #itemarr
    local anchor_point
    local anchorMW = 0
    local itenW
    if len > 1 then
        local newX = nil
        local item
        for i=1,len,1 do
            item = itemarr[i]
            if newX then
                item:setPositionX(newX)
            end
            itenW = item:getContentSize().width
            anchor_point = item:getAnchorPoint()
            if anchor_point and anchor_point.x then
                anchorMW = itenW * (1 - anchor_point.x)
            else 
                anchorMW = itenW
            end
            newX = item:getPositionX() + anchorMW + space
        end
    end
end

-- 中间文本不变的情况下，左边图和右边图自动调整
function setLeftRightImg(leftimg,txt,rightimge,space)
    if not space then space = 0 end
	local txtsize = txt:getContentSize()
	local scaleX = math.abs(txt:getScaleX())
	local leftsize = leftimg:getContentSize()
	local rightsize = rightimge:getContentSize()
    local leftS = leftimg:getAnchorPoint().x
    local ritghtS = rightimge:getAnchorPoint().x
    local txtS = txt:getAnchorPoint().x
	local leftx = txt:getPositionX() - (txtsize.width*txtS * scaleX) - (leftsize.width*leftS)
	local rightx = txt:getPositionX() + (txtsize.width*txtS * scaleX) + (rightsize.width*ritghtS)
	leftimg:setPositionX(leftx-space)
	rightimge:setPositionX(rightx+space)
end

--给文本添加点击事件，查看文本完整信息（文本点击后弹出TIPS）
--target        添加事件的文本
--str           文本完整信息
--maxChar       文本超过最大字符后生效
--tips_width    tips宽度
--off_width     自定义背景框缩减宽度
--off_height    自定义背景框缩减高度
--is_new        是否自定义缩减背景框
--add_widget    是否强制增加点击区域
--备注：新增兼容类似createLabel创建出来的文本添加点击事件（在外部添加一个可点击容器）
function addEvt2showAllTextTips(target,str,maxChar,tips_width,off_width,off_height,is_new,add_widget)
    local maxChar = maxChar or 15
    local tips_width = tips_width or 400
    local off_width = off_width or 50
    local off_height = off_height or 50
    local is_new = is_new or true
    local add_widget = add_widget or false
    if target then
        if target.addTouchEventListener and add_widget == false then
            target:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    if StringUtil.SubStringGetTotalIndex(str) > maxChar then
                        playButtonSound2()
                        TipsManager:getInstance():showCommonTips(str, sender:getTouchBeganPosition(),nil,nil,tips_width,true,off_width,off_height,is_new)
                    end
                end
            end)
        else
            local click_widget = ccui.Widget:create()
            local click_width = target:getContentSize().width
            local click_height = target:getContentSize().height
            click_widget:setContentSize(click_width,click_height)
		    click_widget:setAnchorPoint(target:getAnchorPoint())
            target:getParent():addChild(click_widget)
            click_widget:setPosition(target:getPosition())
            click_widget:setTouchEnabled(true)
            click_widget:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    if StringUtil.SubStringGetTotalIndex(str) > maxChar then
                        playButtonSound2()
                        TipsManager:getInstance():showCommonTips(str, sender:getTouchBeganPosition(),nil,nil,tips_width,true,off_width,off_height,is_new)
                    end
                end
            end)
        end
    end
end

