function updateLimitEffect(type, bid, parent, special_id, force_id, scale)
    if not type or not bid or not parent then
        return
    end
    parent:removeAllChildren()
    local spine_id = 0
    if type == 1 then
        spine_id = Config.PartnerData.data_partner_base[bid].holiday_limit
    elseif type == 2 then
        if not next(spriteCfg) then
            local config_list = deepCopy(Config.SpriteData.data_elfin_data_table)
            for i,bid in pairs(config_list) do
                local item_cfg = Config.SpriteData.data_elfin_data(i)
                spriteCfg[item_cfg.id] = item_cfg
            end
        end
        spine_id = spriteCfg[bid] and spriteCfg[bid].holiday_limit
    elseif type == 3 then
        spine_id = Config.ProhibitorData.data_get_prohibitor[bid].holiday_limit
    end
    --英雄碎片弹窗界面使用固定id
    if spine_id ~= "0" and special_id then
        spine_id = special_id
    end
    spine_id = force_id and force_id or spine_id    --快速测试用
    if spine_id ~= "0" then
        local spine = createEffectSpine(spine_id, cc.p(0, 0), cc.p(0.5, 0.5), true, PlayerAction.action_1)
        spine:setAnimation(0, PlayerAction.action_1, true)
        parent:addChild(spine)
        if scale then
            spine:setScale(scale)
        end
    end
end

function doVerticalLayoutNode(nodes, params, anchorPoint)
    if not params then
        params = {}
    end
    local gap = params.gap or 0
    local headGap = params.headGap or 0
    local tailGap = params.tailGap or 0
    local minHeight = params.minHeight or 0

    local nodeNum = #nodes
    local ht = {}
    local totalHeight = headGap + tailGap
    for i, child in ipairs(nodes) do
        if child:isVisible() then
            local size = child:getContentSize()
            ht[i] = size.height
            totalHeight = totalHeight + size.height + gap
        end
    end
    
    if anchorPoint then
        for i, child in ipairs(nodes) do
            child:setAnchorPoint(anchorPoint)
        end
    end

    totalHeight = totalHeight - gap
    if totalHeight < minHeight then
        totalHeight = minHeight
    end

    local tempHeight = totalHeight - headGap
    for i, child in ipairs(nodes) do
        if child:isVisible() then
            tempHeight = tempHeight - ht[i]
            child:setPositionY(tempHeight)
            tempHeight = tempHeight - gap
        end
    end
    return totalHeight
end

function createStar(num, star_con, star_setting, star_width)
    local num = num or 0
    local star_setting = star_setting or {}
    if star_setting.star_list == nil then
        star_setting.star_list = {}
    end

    if star_setting.star_list2 == nil then
        star_setting.star_list2 = {}
    end

    for i,v in pairs(star_setting.star_list) do
        if v and not tolua.isnull(v) then
            v:setVisible(false)
        end
    end
    for i,v in pairs(star_setting.star_list2) do
        if v and not tolua.isnull(v) then
            v:setVisible(false)
        end
    end
    if star_setting.star10 and not tolua.isnull(star_setting.star10) then
        star_setting.star10:setVisible(false)
    end

    if star_setting.moon and not tolua.isnull(star_setting.moon) then
        star_setting.moon:setVisible(false)
    end

    local width_s = star_width or (29 + 3)
    local _cStar = function(star_count, res, star_list,moveW)
        local width = star_width or (29 + 3)
        local x = - star_count * width * 0.5 + width * 0.5
        if moveW then 
            x = x + moveW
        end
        for i=1,star_count do
            if not star_list[i] or tolua.isnull(star_list[i]) then 
                local star = createImage(star_con,res,0,0,cc.p(0.5,0.5),true,1,false)
                star:setScale(1)
                star_list[i] = star
            end
            star_list[i]:setVisible(true)
            star_list[i]:setPositionX(x + (i-1) * width)
        end
    end
    if num > 0 and num <= 5 then
        local res = PathTool.getResFrame("common","common_90074")
        _cStar(num, res, star_setting.star_list)
    elseif num >= 6 and num <= 9 then
        local res = PathTool.getResFrame("common","common_90074")
        local moonres = PathTool.getResFrame("common","common_90075_1")
        if star_setting.moon == nil or tolua.isnull(star_setting.moon) then 
            local star = createImage(star_con,moonres,0, 0,cc.p(0.5,0.5),true,0,false)
            star_setting.moon = star
            star_setting.moon:setScale(1.2)
        else
            star_setting.moon:setVisible(true)
        end
        local count = num - 5
        _cStar(count, res, star_setting.star_list,width_s*0.5)

        local startmoon = - count * width_s * 0.5 + width_s * 0.5 -width_s*0.5
        star_setting.moon:setPositionX(startmoon)
    elseif num >= 10 then
        local new_num  = num - 10
        local res = PathTool.getResFrame("common","common_90073_1")
        if star_setting.star10 == nil or tolua.isnull(star_setting.star10) then 
            local star = createImage(star_con,res,0, 0,cc.p(0.5,0.5),true,0,false)
            star:setScale(1.2)
            star:setCascadeOpacityEnabled(true)
            star_setting.star10 = star
        else
            star_setting.star10:setVisible(true)
        end

        local res = PathTool.getResFrame("common","common_90074")
        _cStar(new_num, res, star_setting.star_list,width_s*0.5+4)
        local startsun = - new_num * width_s * 0.5 + width_s * 0.5 -width_s*0.5
        star_setting.star10:setPositionX(startsun)
    end
    return star_setting
end

-- 对子节点进行居中显示
-- node 需要进行排序的父节点
-- gap 子节点的间隔
-- exceptNodes 需要忽略的节点
-- direction 排序方向(1-横向 2-纵向)
-- padding 左右/上下的内边距(左右的总边距)
-- offset 子节点整体的偏移
-- anchor 子节点对齐的方向(0, 1, 2 分别对应 左中右 或者 上中下)
function autoPos(node, gap, exceptNodes, direction, padding, offset, anchor, childList, isAdapt)
    gap = gap or 0
    direction = direction or 1
    offset = offset or 0
    anchor = anchor or 1
    local totalLength = 0
    local willSort = childList or node:getChildren()
    local index = 1

    local function checkExisted(name)
        if exceptNodes then
            for _, value in ipairs(exceptNodes) do
                if value == name then
                    return true
                end
            end
            return false
        else
            return false
        end
    end

    while index <= #willSort do
        willSort[index].idx = willSort[index].idx or -1
        if willSort[index]:isVisible() and not checkExisted(willSort[index]:getName()) then
            if direction == 1 then
                totalLength = totalLength + willSort[index]:getContentSize().width * willSort[index]:getScaleX()
            else
                totalLength = totalLength + willSort[index]:getContentSize().height * willSort[index]:getScaleY()
            end
            totalLength = totalLength + gap

            index = index + 1
        else
            table.remove(willSort, index)
        end
    end
    --以水平为例，让应该在左侧的子节点可以后加入到父节点上
    local needSort = false
    for k, v in ipairs(willSort) do
        if v.idx ~= -1 then
            needSort = true
            break
        end
    end
    if needSort then
        table.sort(willSort, function(a, b)
            if a.idx ~= b.idx then
                return a.idx < b.idx
            end
        end)
    end
    
    totalLength = totalLength - gap
    if padding then
        if direction == 1 then
            if totalLength + padding > node:getContentSize().width or isAdapt then
                totalLength = totalLength + padding
                offset = offset + padding / 2
                node:setContentSize(cc.size(totalLength, node:getContentSize().height))
            end
        else
            if totalLength + padding > node:getContentSize().height or isAdapt then
                totalLength = totalLength + padding
                offset = offset + padding / 2
                node:setContentSize(cc.size(node:getContentSize().width, totalLength))
            end
        end
    end

    if direction == 1 then
        local startX = node:getContentSize().width / 2 - totalLength / 2 + offset
        if anchor == 0 then
            startX = offset
        elseif anchor == 2 then
            startX = node:getContentSize().width - offset
        end
        for index, value in ipairs(willSort) do
            local valueWidth = value:getContentSize().width * value:getScaleX() 
            if anchor == 2 then
                value:setPositionX(startX - valueWidth * value:getAnchorPoint().x)--这里锚点不要为0或1否则有问题，有空再改
                startX = startX - valueWidth - gap
            else
                value:setPositionX(startX + valueWidth * value:getAnchorPoint().x)
                startX = startX + valueWidth + gap
            end
        end
    else
        local startY = node:getContentSize().height / 2 - totalLength / 2 + offset
        if anchor == 0 then
            startY = node:getContentSize().height - offset
        elseif anchor == 2 then
            startY = offset
        end
        for index, value in ipairs(willSort) do
            local valueWidth = value:getContentSize().height * value:getScaleY() 
            if anchor == 2 then
                value:setPositionY(startY - valueWidth * value:getAnchorPoint().y)
                startY = startY - valueWidth - gap
            else
                value:setPositionY(startY + valueWidth * value:getAnchorPoint().y)
                startY = startY + valueWidth + gap
            end
        end
    end
end
--创建星星显示
--@num 星星数量
--@star_con 星星父类
--@star_setting 星星设置结构
