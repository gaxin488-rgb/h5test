    local delay_time = cc.DelayTime:create(delay_time)
    local remain_time = cc.DelayTime:create(remain_time)
	obj:runAction(cc.RepeatForever:create(cc.Sequence:create(delay_time,fadein,remain_time,fadeout)))
end


