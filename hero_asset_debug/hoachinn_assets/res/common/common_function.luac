            star:setScale(1)
            star:setCascadeOpacityEnabled(true)
            star_setting.star10 = star
        else
            star_setting.star10:loadTexture(res, LOADTEXT_TYPE_PLIST)
            star_setting.star10:setVisible(true)
        end
        local res = PathTool.getResFrame("common_1","common_1_580")
        local step = step or 0
        if step > 0 then
            _cStar2(step, res, star_setting.star_list,0,-14,0.8)
        end
    elseif num >= 10 then
        local new_num  = num - 10
        local res = PathTool.getResFrame("common","common_90073_1")
        if star_setting.star10 == nil or tolua.isnull(star_setting.star10) then 
            local star = createImage(star_con,res,0, 0,cc.p(0,0.5),true,0,false)
            star:setScale(1.2)
            star:setCascadeOpacityEnabled(true)
            star_setting.star10 = star
        else
            star_setting.star10:setVisible(true)
        end

        local res = PathTool.getResFrame("common","common_90074")
        _cStar(new_num, res, star_setting.star_list,width_s*0.5+16)
    end
    return star_setting
end
--属性去重
-- data = {{'atk',11},{'hp_max',174},{'atk',11},{'hp_max',174}}
function getAttrRemovalOfDuplicatesList(data)
	local attr_list = {}
	local list = {}
	if data and next(data) then
		for k,v in pairs(data) do
			if not list[v[1]] then
				list[v[1]] = v[2]
			else
				list[v[1]] = list[v[1]] + v[2]
			end
		end
	end
	if list and next(list) then
		for k,v in pairs(list) do
			table.insert(attr_list,{k,v})
		end
	end
	return attr_list
end

function get_new_send_str(args)
    local list = {}
    if args and next(args) then
        for k, v in pairs(args) do
            local key = tostring(k)
            local value = tostring(v or "")
            if log_url_encode then
                value = log_url_encode(value)
            end
            table.insert(list, key .. "=" .. value)
        end
        table.sort(list)
    end
    return table.concat(list, "&")
end
