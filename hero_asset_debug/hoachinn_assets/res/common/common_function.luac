-- 检测某一点的像素值
function AlphaTouchCheck(image, pos)
    local sprite = image
    local oldPos = cc.p(sprite:getPosition())
    local size = sprite:getContentSize()
    local spriteTouchPos = sprite:convertToNodeSpace(pos)
    local renderTexture1 = cc.RenderTexture:create(size.width, size.height, cc.TEXTURE2_D_PIXEL_FORMAT_RGB_A8888)
    sprite:setPosition(cc.p(size.width/2, size.height/2))
	renderTexture1:begin()
	sprite:visit()
	renderTexture1:endToLua()
    cc.Director:getInstance():doOnceRender()
    sprite:setPosition(oldPos)
	local pos = pos  --点击到的坐标
    local spriteBox = sprite:getBoundingBox()
    local pImage = renderTexture1:newImage()
	local i = spriteTouchPos.x
    local j = spriteBox.height - spriteTouchPos.y  --坐标系原点转换
    local rgba = pImage:getPixelColor(cc.p(i, j))
    pImage:release()
	if rgba.a ~= 0 then
        --点击非透明区域
        return true
    end
    return false
end
function moveTextBg3(text,bgimg,speedx,original)
    if not text or not bgimg then return  end
    local speedx = speedx or 0
    local text_width = text:getContentSize().width
    local bgimg_height = bgimg:getContentSize().height
    local original = original or 0
    bgimg:setContentSize(cc.size(text_width + speedx * 2,bgimg_height))
end
--文字背景自适应
--文本在背景之上 文本，背景 , 一边留白宽度 , 原始宽度 
function moveTextBg(text,bgimg,speedx,original)
    if not text or not bgimg then return  end
    local speedx = speedx or 0
    local text_width = text:getContentSize().width
    local bgimg_width = bgimg:getContentSize().width
    local bgimg_height = bgimg:getContentSize().height
    local original = original or bgimg:getContentSize().width
    if bgimg_width / 2 - speedx < text_width / 2 then
        bgimg:setContentSize(cc.size(text_width + speedx * 2,bgimg_height))
    else
        bgimg:setContentSize(cc.size(original,bgimg_height))
    end
end
--文本在两张图片之间 文本与图片有单独的父级容器  父级容器 ， 文本，图片1 ， 图片2 , 一边留白宽度 
function moveTextBg2(panel,text,bgimg1,bgimg2,speedx)
    if not text or not text or not bgimg1 or not bgimg2 then return  end
    local speedx = speedx or 0
    local text_width = text:getContentSize().width
    local text_height = text:getContentSize().height
    local bgimg_width = bgimg1:getContentSize().width
    local bgimg_height = bgimg1:getContentSize().height
    if text_height > bgimg_height then
        panel:setContentSize(cc.size(text_width + bgimg_width * 2 + speedx * 2 , text_height))
    else
        panel:setContentSize(cc.size(text_width + bgimg_width * 2 + speedx * 2 , bgimg_height))
    end
    text:setPositionX(bgimg_width + speedx + text_width / 2)
    bgimg1:setPositionX(text_width / 2 + bgimg_width /2 + speedx)
    bgimg2:setPositionX(text_width + speedx * 2 + bgimg_width)
end
-- 文本自适应  换行
function setTextBg(text, bg, maxWidth, LineSpacing, maxheight)
    local maxWidth = maxWidth or bg:getContentSize().width - 30
    local maxheight = maxheight or 0
    local LineSpacing = LineSpacing or 0
    --最大宽度
    text:ignoreContentAdaptWithSize(true)
    text:setTextAreaSize(cc.size(maxWidth,maxheight))
    --行间距
    text:getVirtualRenderer():setLineSpacing(LineSpacing)
    -- if text:getContentSize().height ~= text_height then
    bg:setContentSize(cc.size(bg:getContentSize().width,text:getContentSize().height+10))
    -- end
end

--设置文本最大宽度
function setTextMaxWidth(text,maxWidth,lineSpace)
    if text == nil then
            return
    end
    text:ignoreContentAdaptWithSize(true)
    text:setTextAreaSize(cc.size(maxWidth,0))
    --行间距
    local LineSpacing = lineSpace or -4
    text:getVirtualRenderer():setLineSpacing(LineSpacing)
end
-- 统一设定Text字体行间距 space可以不设
function setTextSpacing(txt,space)
    local space = space or -4
    if txt then
        txt:getVirtualRenderer():setLineSpacing(space)
    end
end

