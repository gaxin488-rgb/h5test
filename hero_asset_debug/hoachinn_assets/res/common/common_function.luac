--重写防止报错
function overwrite_cocos_function()
    if not first_overwrite_cocos_function then
        game_print("overwrite_function")
        first_overwrite_cocos_function = true
        local Widget = ccui.Widget
        local overwrite_function_names = {"setTouchEnabled"}
        local function overwrite_widget_function(func_name)
            if Widget[func_name] then
                Widget["_" .. func_name] = Widget[func_name]
                Widget[func_name] = function(self, ...)
                    if tolua.isnull(self) then
                        if not first_send_widget_setTouchEnabled then
                            first_send_widget_setTouchEnabled = true
                            send_error_to_pf(simpleTrace(debug.traceback()))
                        end
                        return
                    end
                    return Widget["_" .. func_name](self, ...)
                end
            end
        end
        for _, func_name in ipairs(overwrite_function_names) do
            if not Widget["_" .. func_name] then
                overwrite_widget_function(func_name)
            end
        end
        local Node = cc.Node
        local overwrite_function_names_node = {"setVisible","addChild"}
        local function overwrite_node_function(func_name)
            if Node[func_name] then
                Node["_" .. func_name] = Node[func_name]
                Node[func_name] = function(self, ...)
                    if tolua.isnull(self) then
                        if not first_send_node_setVisible then
                            first_send_node_setVisible = true
                            local error_str = simpleTrace(debug.traceback())
                            if GAME_LOAD_ERROR_TRACE then
                                error_str = GAME_LOAD_ERROR_TRACE .. "_____" .. func_name .. "|" .. error_str
                            end
                            send_error_to_pf(error_str)
                        end
                        return
                    end
                    return Node["_" .. func_name](self, ...)
                end
            end
        end
        for _, func_name in ipairs(overwrite_function_names_node) do
            if not Node["_" .. func_name] then
                overwrite_node_function(func_name)
            end
        end
        local ImageView = ccui.ImageView
        local overwrite_function_names = {"loadTexture"}
        local function overwrite_widget_function(func_name)
            if ImageView[func_name] then
                ImageView["_" .. func_name] = ImageView[func_name]
                ImageView[func_name] = function(self, ...)
                    if tolua.isnull(self) then
                        if not first_send_imageView_loadTexture then
                            first_send_imageView_loadTexture = true
                            local error_str = simpleTrace(debug.traceback())
                            if GAME_LOAD_ERROR_TRACE then
                                error_str = GAME_LOAD_ERROR_TRACE .. "_____" .. error_str
                            end
                            send_error_to_pf(error_str)
                        end
                        return
                    end
                    return ImageView["_" .. func_name](self, ...)
                end
            end
        end
        for _, func_name in ipairs(overwrite_function_names) do
            if not ImageView["_" .. func_name] then
                overwrite_widget_function(func_name)
            end
        end
    end
end


--由于string_util被引入太晚，所以在这里也加一下
function encodeBase64(source_str)
    local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local s64 = ''
    local str = source_str
 
    while #str > 0 do
        local bytes_num = 0
        local buf = 0
 
        for byte_cnt=1,3 do
            buf = (buf * 256)
            if #str > 0 then
                buf = buf + string.byte(str, 1, 1)
                str = string.sub(str, 2)
                bytes_num = bytes_num + 1
            end
        end
 
        for group_cnt=1,(bytes_num+1) do
            local b64char = math.fmod(math.floor(buf/262144), 64) + 1
            s64 = s64 .. string.sub(b64chars, b64char, b64char)
            buf = buf * 64
        end
 
        for fill_cnt=1,(3-bytes_num) do
            s64 = s64 .. '='
        end
    end
    return s64
end

-- 下划线 _ 开头的被导出
function getAllCsbExportChildren(parent, output, ignoreList)
    if not output then
        output = {}
    end
    local c = parent:getChildren()
    local name
    for k, v in ipairs(c) do
        name = v:getName()
        if string.byte(name, 1) == 95 then
            if output[name] then
                print("warn var already exist", name)
            else
                output[name] = v
            end
        end
        if not (ignoreList and ignoreList[name]) then
            getAllCsbExportChildren(v, output, ignoreList)
        end
    end
    return output
end
-- 绑定类
---@param node cc.Node
---@param cls table @ lua class 类 
function nativeBindClass(node, cls, ...)
    local peer = tolua.getpeer(node)
    if not peer then
        peer = {}
        tolua.setpeer(node, peer)
    end
    setmetatable(peer, { __index = cls })
    if node.ctor then
        node:ctor(...)
    end
    return node
end
