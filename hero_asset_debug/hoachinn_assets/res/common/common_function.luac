-- 设置文本最大宽度， 超长裁剪 显示为 ...
---@param labelNode Node cocos节点
---@param text string 文本内容
---@param maxWidth number 最大宽度
---@return boolean 是否裁剪了
function transformTextToShortByWidth(labelNode, text, maxWidth)
    labelNode:setString(text)
    local s = labelNode:getContentSize()
    if s.width <= maxWidth then
        return false
    end
    local stringLen = StringUtil.getStrLen(text)
    local originLen = math.floor(stringLen * maxWidth/s.width)
    local step = 1
    local tempText = ""
    local tempText2 = ""
    local startLen = originLen
    local s2

    tempText = StringUtil.SubStringUTF8(text, 1, startLen) .. "..."
    labelNode:setString(tempText)
    s = labelNode:getContentSize()
    if s.width <= maxWidth then
        while true do
            if startLen > stringLen then
                labelNode:setString(text)
                return false
            end
            tempText2 = StringUtil.SubStringUTF8(text, 1, startLen + 1) .. "..."
            labelNode:setString(tempText2)
            s2 = labelNode:getContentSize()
            if s2.width > maxWidth then
                labelNode:setString(tempText)
                return true
            end
            tempText = tempText2
            startLen = startLen + 1
        end
    else
        while true do
            if startLen < 0 then
                return false
            end
            tempText2 = StringUtil.SubStringUTF8(text, 1, startLen - 1) .. "..."
            labelNode:setString(tempText2)
            s2 = labelNode:getContentSize()
            if s2.width < maxWidth then
                return true
            end
            startLen = startLen - 1
        end
    end
    return true
end
-- 切换父节点
---@param cobj cc.Node 子节点
---@param newParent cc.Node 新的父节点
---@param zOrder number|nil
function switchParent(cobj, newParent, zOrder)
    cobj:retain()
    cobj:removeFromParent(false)
    newParent:addChild(cobj, zOrder or 0)
    cobj:release()
end
-- 下划线 _ 开头的被导出
function getAllCsbExportChildren(parent, output, ignoreList)
    if not output then
        output = {}
    end
    local c = parent:getChildren()
    local name
    for k, v in ipairs(c) do
        name = v:getName()
        if string.byte(name, 1) == 95 then
            if output[name] then
                print("warn var already exist", name)
            else
                output[name] = v
            end
        end
        if not (ignoreList and ignoreList[name]) then
            getAllCsbExportChildren(v, output, ignoreList)
        end
    end
    return output
end
--相对1280界面设计的高，游戏区域的变化值
function getScreenAddHeight()
    local height = (display.getTop() - display.getBottom()) - 1280
    return height
end
-- math.min math.max
---@param v number 值
---@param min number 最小值
---@param max number 最大值
function MathRange(v, min, max)
    if v < min then
        return min
    end

    if v > max then
        return max
    end
    return v
end
function labelAutoFixBgSize(label, str, offsetX, offsetY)
    local  parentNode = label:getParent()
    if not parentNode then
        return
    end
    offsetX = offsetX or 10
    offsetY = offsetY or 0
    label:getVirtualRenderer():setChangeScaleOffWidth(-500)
    label:setString(str)
  
    local pSize = parentNode:getContentSize()
    local cSize = label:getContentSize()
    local maxWidth = math.max(cSize.width + offsetX * 2, pSize.width)
    local maxHeight =  math.max(cSize.height + offsetY * 2, pSize.height)

    parentNode:setContentSize(cc.size(maxWidth, maxHeight))
    label:setPosition(cc.p(maxWidth/2, maxHeight/2))
end

