--==============================--
--desc:动态加载资源的接口.适应小包处理
--time:2018-07-22 11:05:34
--@path:
--@type:
--@callback:
--@load:
--@lock:
--@return 
--==============================--
function createResourcesLoad(path, type, callback, load, lock)
    if load ~= nil then
        load:DeleteMe()
        load = nil
    end
    local load = ResourcesLoad.New()
    load:addDownloadList(path, type, function() 
        callback()
    end)

    return load
end

--==============================--
--desc:动态加载资源的接口.适应小包处理
--time:2018-07-22 11:05:34
--@node:显示对象,只针对sprite
--@path:路径
--@type:
--@load:
--@delete_time 自定移除时间
--@return 
--==============================--
function loadSpriteTextureFromCDN(node, path, type, load, delete_time, load_callback)
    if load ~= nil then
        load:DeleteMe()
        load = nil
    end

    if tolua.isnull(node) then return end
    
    local load = ResourcesLoad.New()
    load:addDownloadList(path, type, function() 
        if not tolua.isnull(node) then
            loadSpriteTexture(node, path, LOADTEXT_TYPE)
            if load_callback then
                load_callback()
            end
        end
    end, delete_time)
    return load
end

--==============================--
--desc:动态加载资源的接口.适应小包处理
--time:2018-07-22 11:05:34
--@node:显示对象,只针对Image
--@path:路径
--@type:
--@load:
--@delete_time 自定移除时间
--@return 
--==============================--
function loadImageTextureFromCDN(node, path, type, load, delete_time, load_callback)
    if load ~= nil then
        load:DeleteMe()
        load = nil
    end

    if tolua.isnull(node) then return end
    
    local load = ResourcesLoad.New()
    load:addDownloadList(path, type, function() 
        if not tolua.isnull(node) then
            node:loadTexture(path,LOADTEXT_TYPE)
            if load_callback then
                load_callback()
            end
        end
    end, delete_time)
    return load
end

-- φ  %sφ
function TI18N(msg)
    if not Lang then
        local lang_namd = "lang_" .. DEF_LANG
        if CUR_LANG then
            lang_namd = "lang_" .. CUR_LANG
        end
        -- if not cc.FileUtils:getInstance():isFileExist(lang_namd) then
        --     print("没找到语言包，",lang_namd)
        --     lang_namd = "lang"
        -- end
        require(lang_namd)
    end
    local str = Lang[msg] or msg or "";
    -- if str == "unknow" then
    --     str = ""
    -- end
    str = string.gsub(str,"φ",DEF_MONETARY_SYMBOLS)
    str = string.gsub(str,"α", "")
    str = string.gsub(str,"语言_", "lang_")
    return str
end

function MONEY_MARK(str)
    return string.gsub(str,"φ",DEF_MONETARY_SYMBOLS)
end

-- 制定当前语言
function SetGameChooseLang(lan)
    if CUR_LANG and CUR_LANG ~= lan then
        cc.UserDefault:getInstance():setStringForKey("user_choose_lang", lan)
        cc.UserDefault:getInstance():flush()
    end
    CUR_LANG = lan
    if CHOOSE_LANG_CURRENCY then DEF_CURRENCY = CHOOSE_LANG_CURRENCY[CUR_LANG] end
    if CHOOSE_LANG_MONETARY then DEF_MONETARY = CHOOSE_LANG_MONETARY[CUR_LANG] end
    if CHOOSE_LANG_MONETARY_SYMBOLS then DEF_MONETARY_SYMBOLS = CHOOSE_LANG_MONETARY_SYMBOLS[CUR_LANG] end
end

-- GetMoneyNum(config[id],"recharge")
-- 获得语言对应货币数据
function GetMoneyNum(obj, name)
    if not obj then return 0 end;
    local newname = name .. DEF_MONETARY;
    local objstr = obj[newname]
    if objstr and objstr ~= "" then
        return objstr;
    end
    return obj[name];
end

-- 解析后端发过来的语言包
function GetLangSeverStr(str)
    local oldstr = str
    local t = type(str);
    if t ~= "string" then return str end
    if not str then return "" end
    str = string.gsub(str,"α", "")
    str = string.gsub(str,"\n", "∑");
    local strarr = Split(str,"β")
    local allstr = ""
    local strA = nil
    local strArr = nil
    local regstr = "%d,"
    local alen = #strarr
    if alen > 1 or (alen and string.match(str,regstr)) then
        local i, j;
        if alen > 1 then
            for k,v in ipairs(strarr) do
                strA = v;
                if string.match(strA,"ζ") then
                    strArr = Split(strA,"ζ");
                    if strArr[1] and strArr[1] ~= "" then
                        local tobj = nil
                        if LANGE_NOT_USE_PCALL then
                            tobj = loadstring("return " .. strArr[1])()
                        else
                            local g, h = pcall(loadstring("return " .. strArr[1]))
                            if g then
                                tobj = h
                            else
                                send_error_to_pf("error_langN"..oldstr)
                            end
                        end
                        allstr = allstr .. GetLangOneSeverStr(tobj, str);
                        if #strArr > 1 then allstr = allstr .. strArr[2] end
                    end
                else
                    allstr = allstr .. strA;
                end
            end
        else
            if strarr[1] then
                local tobj = loadstring("return " .. strarr[1])()
                allstr = allstr .. GetLangOneSeverStr(tobj, str);
            end
        end
    else
        local lanstr = Lang[str];
        if (lanstr) then
            allstr = lanstr;
        else
            allstr = str;
        end
    end
    allstr = string.gsub(allstr, "∑","\n");
    allstr = string.gsub(allstr,"φ", DEF_MONETARY_SYMBOLS)
    return allstr;
end

-- 服务端语言包解析规则
-- 0:--普通  {0,"@文本"}
-- 1:--拼接字符  {1,"sss_257"}  {1,"sss_257",{0,"@文本"}}
-- 2:--基础副本配置表 {2,"LoginDaysData","data_day",1,"name"} 表名1 表名2 ID  字段名     （表名2不需要时可以填空字符""）
-- 3:--后端定义文本   {3,"%s,%s,%s",{1,\"sss_257\",{0,\"xxx\"},{1,10001}},{0,"@文本"},{0,"@文本"}};
-- 4:--道具配置表id  {4,110001}

--β{1,\"sss_257\",{0,\"xxx\"},{4,10001}}ζ
function GetLangOneSeverStr(strBArr, oldstr)
    if type(strBArr) ~= "table" then
        return strBArr or ""
    end
    local allstr = "";
    local strlen = #strBArr
    if next(strBArr) then
        local itemObj;
        local type = strBArr[1]
        if type == 0 then--普通
            allstr = strBArr[2] or "";
        elseif type == 1 then--拼接字符  {1,"sss_257"}  {1,"sss_257",{0,"@文本"}}
            if strlen > 1 then
                local keystr = GetLangSeverStr(strBArr[2]);
                local keyarrA = {};
                for i = 3,strlen do
                    table.insert(keyarrA,GetLangOneSeverStr(strBArr[i], oldstr))
                end
                if next(keyarrA) then 
                    if LANGE_NOT_USE_PCALL then
                        keystr = string.format(keystr, unpack(keyarrA))
                    else
                        function string_format_for_arr2()
                            return string.format(keystr, unpack(keyarrA))
                        end
                        local g, h = pcall(string_format_for_arr2)
                        if g then
                            keystr = h
                        else
                            send_error_to_pf("error_langC"..oldstr)
                        end
                    end
                end
                allstr = keystr;
            end
        elseif type == 2 then--3   --基础副本配置表  表名1 表名2 ID  字段名
            if strlen >= 4 then
                if strBArr[3] and strBArr[3] ~= "" then
                    itemObj = Config[strBArr[2]][strBArr[3]] or nil;
                else
                    itemObj = Config[strBArr[2]] or nil;
                end
                if itemObj and itemObj[strBArr[4]] then
                    allstr = itemObj[strBArr[4]][strBArr[5]];
                else
                    print(strBArr[1], oldstr);
                end
            end
        elseif type == 3 then--也是一个serverkey
            if strlen > 1 then
                local keystr = strBArr[2];
                local keyarrA = {};
                for i=3,strlen do
                    table.insert(keyarrA,GetLangOneSeverStr(strBArr[i], oldstr))
                end
                if next(keyarrA) then 
                    if LANGE_NOT_USE_PCALL then
                        keystr = string.format(keystr, unpack(keyarrA)) 
                    else
                        function string_format_for_arr()
                            return string.format(keystr, unpack(keyarrA))
                        end
                        local g, h = pcall(string_format_for_arr)
                        if g then
                            keystr = h
                        else
                            send_error_to_pf("error_langB"..oldstr)
                        end
                    end
                end
                allstr = keystr;
            end
        elseif type == 4 then--道具配置表
            local itemobjA = Config.ItemData.data_get_data and Config.ItemData.data_get_data(strBArr[2]);
            if itemobjA then
                local itemname = itemobjA.name
                -- local quality = itemobjA.quality
                -- if (quality == 7) then
                --     allstr = PetXilianPanel.GetItemNameColor(itemname)
                -- else
                    allstr = itemobjA.name;
                -- end
            else
                print(strBArr[1], oldstr);
            end
        end
    end
    return allstr;
end

-- 增加一张可以动态替换内容方式 用法LangStringFormat("tttt{1}{2}{3}{4}","一","二","三","四")
function LangStringFormat(formatstr,...)
	local args = { ... }
	local len = #args
    local str = ""
	for i=1,len do
		if args[i] or args[i] == 0 then
			str = "" .. args[i]
			if str and formatstr then
				formatstr = string.gsub(formatstr,"{" .. i .. "}",str)
			end
		end
	end
    return formatstr
end


