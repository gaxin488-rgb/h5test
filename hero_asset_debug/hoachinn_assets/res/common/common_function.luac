-- 生成一个用不重复的ID 字符串格式的数字
function getUuid(randomLength)
    return tostring(tonumber(string.sub(tostring(math.random()),3, randomLength))+os.time())
end
-- 权重
function getRamdomDataByWeight(cfg,num)
    -- 定义值和权重
    local items = cfg
    local id_list = {}
    local index = 1
    -- 计算权重总和
    local totalWeight = 0
    for _, item in ipairs(items) do
        totalWeight = totalWeight + item.weight
    end
    local function selectItems(count)
        local selectedItems = {}
        local availableItems = {}
        -- 初始化可用项
        for _, item in ipairs(items) do
            table.insert(availableItems, item)
        end

        for i = 1, count do
            local randomValue = math.random(0, totalWeight - 1)-- 生成一个随机数
            local cumulativeWeight = 0
            for j = #availableItems, 1, -1 do
                cumulativeWeight = cumulativeWeight + availableItems[j].weight
                if randomValue < cumulativeWeight then
                    -- 选择该项并从可用项中移除
                    table.insert(selectedItems, availableItems[j].value)
                    -- totalWeight = totalWeight - availableItems[j].weight  -- 更新总权重
                    -- table.remove(availableItems, j)  -- 移除已选择的项
                    break
                end
            end
        end
        return selectedItems
    end

    local result = selectItems(num)
    return result
end
--检查两个数组是否一样
function arraysEqual(arr1, arr2)
    -- 首先检查两个数组的长度
    if #arr1 ~= #arr2 then
        return false
    end
    -- 遍历数组并比较每个元素
    for i = 1, #arr1 do
        local v1, v2 = arr1[i], arr2[i]
        if type(v1) == "table" and type(v2) == "table" then
            -- 如果元素都是表，则递归比较
            if not arraysEqual(v1, v2) then
                return false
            end
        elseif v1 ~= v2 then
            -- 如果元素不相等且不是表，则返回 false
            return false
        end
    end
    return true
end

function loadCsbWithExportUI(csbPath)
    local csloaderIns = cc.CSLoader:getInstance()
    if csloaderIns.getCsbExtendInfo then
        csloaderIns:setEnableRecordExtendInfo(true)
        local node = cc.CSLoader:createNode(csbPath)
        csloaderIns:setEnableRecordExtendInfo(false)
        local extendInfo = csloaderIns:getCsbExtendInfo(csbPath)
        csloaderIns:clearCsbExtendInfo()
        return node, extendInfo.keyNodeMap
    else
        local node = cc.CSLoader:createNode(csbPath)
        return node, getAllCsbExportChildren(node)
    end
end

