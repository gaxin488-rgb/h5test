function setChildUnEnabledCopy(bool, parent)
    setChildUnEnabled(bool, parent,cc.c4b(0x53,0x53,0x53,0xff))
end
-- 设置文本最大宽度， 超长自动缩放
---@param labelNode Node cocos节点
---@param maxWidth number 最大宽度
---@param originScale number|nil 原始缩放
---@return nil
function adaptTextByMaxWidth(labelNode, maxWidth, originScale)
    local s = labelNode:getContentSize()
    if s.width > maxWidth then
        local scale = maxWidth / s.width
        if scale < 0.3 then
            scale = 0.3
        end
        labelNode:setScale(scale * (originScale or 1))
    else
        labelNode:setScale(originScale or 1)
    end
end


-- ljj test 卡顿优化
-- 获取缓存数据逻辑 
-- 1.controller类
-- 2.send_data 发送函数数据 [1]函数名 [2]参数
-- 3.get_data 获取函数数据  [1]函数名 [2]参数
-- 4.refresh_func 刷新函数 
-- 5.b_refresh_data 是否每次发送协议 
function getDataForProtoId( controller, send_data,get_data,refresh_func, b_refresh_data)

    if not controller then    
        print("error controller is nil ") 
        return 
    end 

    local model = controller:getModel()
    if not model then    
        print("error model is nil ") 
        return  
    end      

    local data = nil

    local function analysisFunc( analysis_data,parent )
        if analysis_data and next(analysis_data) then
            local func_name = analysis_data[1]
            local parm = analysis_data[2]
            if func_name and parent[func_name] then    
                return parent[func_name](parent,parm)  
            end
        end
        return nil
    end

    data = analysisFunc(get_data,model) 
 
	if not data or b_refresh_data then
        analysisFunc(send_data,controller)
	end 

    if data and refresh_func then 
        refresh_func( data )   	    
    end 

	return data   
end 
-- proto_id  123456 
-- 例 set123456Data()
-- 例 get123456Data()
-- proto_123456data
function createSetGetProtoIdFunc( controller,proto_id,data )
    local model = controller:getModel()
    if not model then
        print("error cant find model proto_id ",proto_id) 
        return   
    end 

    local setFuncName = "set".. proto_id .. "Data"
    if not model[setFuncName] then 
        model[setFuncName] = function( data )
            model["proto_" .. proto_id .." data "] = data
        end     
    end             
    model[setFuncName](data)        
 
    local getFuncName = "get".. proto_id .. "Data"
    if not model[getFuncName] then  
        model[getFuncName] = function( ) 
            local data = model["proto_" .. proto_id .." data "]
            return model["proto_" .. proto_id .." data "]
        end
    end          
        
end    
-- math.min math.max
---@param v number 值
---@param min number 最小值
---@param max number 最大值
function MathRange(v, min, max)
    if v < min then
        return min
    end

    if v > max then
        return max
    end
    return v
end 
function setChildrenOpacityEnable(parent, bool)
    local cascadeOpacityEnabled, opacityEnabled

    opacityEnabled = function(parent, bool)
        local desc = parent:getDescription()
        -- if string.find(desc, "Layout") or string.find(desc, "Widget") then
            parent:setCascadeOpacityEnabled(bool)
        -- end
    end

    cascadeOpacityEnabled =  function (parent, bool)
        if parent:getChildrenCount() > 0 then
            opacityEnabled(parent, bool)
            local children = parent:getChildren()
            for k, v in pairs(children) do
                cascadeOpacityEnabled(v, bool)
            end
        else
            opacityEnabled(parent, bool)
        end
    end
    cascadeOpacityEnabled(parent, bool)
end

