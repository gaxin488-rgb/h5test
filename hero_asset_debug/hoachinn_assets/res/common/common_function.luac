-- 适配界面标题和图片
function autoSizeTitleBg(titletxt,titlebg,spaceW,minWidth,maxWidth)
    spaceW = spaceW or 120
    minWidth = minWidth or 332
    if titletxt and titlebg then
        local bwidth = math.max(titletxt:getContentSize().width*titletxt:getScale() + spaceW, minWidth)
        if maxWidth then
            bwidth = math.min(bwidth,maxWidth)
        end
        local bheight = titlebg:getContentSize().height
        titlebg:setContentSize(cc.size(bwidth,bheight))
    end
end

