function ConfigDataGetData(key)
    local itemdata = Config.ItemData.data_get_data(key)
    if DEF_MONETARY then
        local payval = itemdata["payval"..DEF_MONETARY]
        if payval and payval ~= "" then
            if itemdata.name then itemdata.name = string.format(payval) end
            if itemdata.desc then itemdata.desc = string.format(payval) end
        end
    end
    return itemdata
end

function getMoneyLangNum(num)
    if not num then num = 0 end
    if num == 0 then 
        return num
    else
        num = math.round((num / 100) * 100)
        return num
    end
end

function getMoneyLangNumADD(num)
    if not num then num = 0 end
    if num == 0 then 
        return num
    else
        return math.round(tonumber(num) * 100)
    end
end

function isPayActBid(oldbid)
    local bid = oldbid
    local role_vo = RoleController:getInstance():getRoleVo()
    if role_vo then
        if bid > 9990000 then bid = bid - 9990000 end
        if bid > 990000 then bid = bid - 990000 end
        if bid > 90000 then bid = bid - 90000 end
        if bid >= 1000 and bid <=1999 then
            print("isPayActBid",oldbid)
            return true
        end
    end
    return false
end

