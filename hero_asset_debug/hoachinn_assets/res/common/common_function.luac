-- 转化地址,传进来如果是http就转https，如是https就转http
-- time == 100 为必转
function switchHttpUrl(url,time,bl_init)
    local newurl = url
    if url and time then 
        local t_num = time-1
        if bl_init then t_num = time end
        local num = math.floor(t_num/2) % 2
        if num == 1 or time == 100 then 
            if string.find(url,"https://") then
                newurl = string.gsub(url,"https://","http://")
            else
                newurl = string.gsub(url,"http://","https://")
            end
        end
    end
    return newurl
end

