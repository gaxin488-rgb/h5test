-- -------------------partner_eqm_start-------------------
Config.PartnerEqmData.data_partner_eqm_length = 700
Config.PartnerEqmData.data_partner_eqm_cache = {}
local function normalize_partner_eqm_key(key)
if type(key) ~= "string" then return key end
local eqm_type, lev = key:match("^(%d+)_(%d+)$")
if not eqm_type then return key end
eqm_type = tonumber(eqm_type)
if eqm_type == 110 then
return "1_" .. lev
elseif eqm_type == 111 then
return "4_" .. lev
elseif eqm_type == 52 then
return "51_" .. lev
elseif eqm_type == 55 then
return "54_" .. lev
end
return key
end
local function parse_partner_eqm_key(key)
if type(key) ~= "string" then return end
local eqm_type, lev = key:match("^(%d+)_(%d+)$")
if not eqm_type then return end
return tonumber(eqm_type), tonumber(lev)
end
local function clone_partner_eqm_entries(entries)
local result = {}
for i, entry in ipairs(entries or {}) do
result[i] = {entry[1], entry[2]}
end
return result
end
local function normalize_partner_eqm_cost_entries(entries)
if type(entries) ~= "table" then return entries end
local refine_cost
for _, entry in ipairs(entries) do
if entry[1] == 39052 then
refine_cost = entry[2]
break
end
end
if refine_cost == nil then
return clone_partner_eqm_entries(entries)
end
local result = {}
for i, entry in ipairs(entries) do
local count = entry[2]
if entry[1] == 39053 then
count = refine_cost
end
result[i] = {entry[1], count}
end
return result
end
local function normalize_partner_eqm_cost_fields(data)
if not data then return data end
if data.expend ~= nil then
data.expend = normalize_partner_eqm_cost_entries(data.expend)
end
if data.sell ~= nil then
data.sell = normalize_partner_eqm_cost_entries(data.sell)
end
if data.cost ~= nil then
data.cost = normalize_partner_eqm_cost_entries(data.cost)
end
return data
end
local function build_special_partner_eqm_cost(lev)
local cost_num = lev * 500
local stone_num = lev * 100
return {
{39052, cost_num},
{39053, cost_num},
{10090, stone_num},
{10091, stone_num},
}
end
local function build_special_partner_eqm_add(eqm_type, lev)
if eqm_type == 1 or eqm_type == 110 or eqm_type == 51 or eqm_type == 52 then
return {{"atk", lev * 100000}}
elseif eqm_type == 2 then
return {{"speed", lev * 200}}
elseif eqm_type == 3 then
return {{"def", lev * 10000}}
elseif eqm_type == 4 or eqm_type == 111 then
return {{"hp_max", lev * 400000}}
elseif eqm_type == 53 then
return {{"hp_max", lev * 400000}, {"speed", lev * 40}}
elseif eqm_type == 54 or eqm_type == 55 then
return {{"speed", lev * 100}}
end
end
local function is_special_partner_eqm_type(eqm_type)
return eqm_type == 1 or eqm_type == 2 or eqm_type == 3 or eqm_type == 4
or eqm_type == 51 or eqm_type == 52 or eqm_type == 53 or eqm_type == 54 or eqm_type == 55
or eqm_type == 110 or eqm_type == 111
end
local function apply_special_partner_eqm_override(key, data)
local eqm_type, lev = parse_partner_eqm_key(key)
if not eqm_type or not lev then return data end
if not is_special_partner_eqm_type(eqm_type) then return data end

local special_cost = build_special_partner_eqm_cost(lev)
local special_add = build_special_partner_eqm_add(eqm_type, lev)
local new_data = {}
for k, v in pairs(data or {}) do
new_data[k] = v
end
if new_data.expend ~= nil then
new_data.expend = clone_partner_eqm_entries(special_cost)
end
if new_data.sell ~= nil then
new_data.sell = clone_partner_eqm_entries(special_cost)
end
if new_data.cost ~= nil then
new_data.cost = clone_partner_eqm_entries(special_cost)
end
if special_add ~= nil then
if new_data.add ~= nil then
new_data.add = clone_partner_eqm_entries(special_add)
end
if new_data.attr ~= nil then
new_data.attr = clone_partner_eqm_entries(special_add)
end
end
new_data.type = eqm_type
new_data.lev = lev
return new_data
end
Config.PartnerEqmData.data_partner_eqm = function(key)
if Config.PartnerEqmData.data_partner_eqm_cache[key] == nil then
local base = Config.PartnerEqmData.data_partner_eqm_table[normalize_partner_eqm_key(key)]
if not base then return end
base = loadstring(string.format('return %s',base))()
if not base then return end
local data = {
type = base[1],
lev = base[2],
expend = base[3],
add = base[4],
sell = base[5],
}
data = apply_special_partner_eqm_override(key, data)
data = normalize_partner_eqm_cost_fields(data)
Config.PartnerEqmData.data_partner_eqm_cache[key] = data
end
return Config.PartnerEqmData.data_partner_eqm_cache[key] 
end
