Config.PartnerEqmData.data_get_eqm_refine_length = 1100
Config.PartnerEqmData.data_get_eqm_refine_cache = {}
Config.PartnerEqmData.data_get_eqm_refine = function(key)
	if Config.PartnerEqmData.data_get_eqm_refine_cache[key] == nil then
		local base = Config.PartnerEqmData.data_get_eqm_refine_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		local data = {
			type = base[1],
			lev = base[2],
			cost = base[3],
			attr = base[4],
		}
		data = apply_special_partner_eqm_override(key, data)
		data = normalize_partner_eqm_cost_fields(data)
		Config.PartnerEqmData.data_get_eqm_refine_cache[key] = data
	end
	return Config.PartnerEqmData.data_get_eqm_refine_cache[key]
end
