Config.PartnerEqmData.data_eqm_compose_id_by_item = {}
for group_index = 1, Config.PartnerEqmData.data_eqm_compose_id_length do
local group_list = Config.PartnerEqmData.data_eqm_compose_id[group_index]
if type(group_list) == "table" then
for _, compose_cfg in ipairs(group_list) do
if compose_cfg and compose_cfg.id then
Config.PartnerEqmData.data_eqm_compose_id_by_item[compose_cfg.id] = compose_cfg
end
end
end
end
Config.PartnerEqmData.data_eqm_compose_item = function(id)
return Config.PartnerEqmData.data_eqm_compose_id_by_item[id]
end
