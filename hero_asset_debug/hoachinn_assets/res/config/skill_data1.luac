-- Both standalone Sasuke forms use the merged spine: normal attacks action1/action2, Susanoo attacks action4/action5. action3 is transform-only.
	[7436004] = [[{7436004, 74360, 4, 2, {20001}, "", "action1", {}, {}, {}, {}, {}, {}, 0, "", "", "", 0, "", "no-hurt", 0, 0, 0, "", 1, 1, "", ""}]],
	[7437015] = [[{7437015, 74370, 1, 1, {{10006,10003,10044},10007}, "action5", "action1", {}, {}, {405295}, {}, {}, {}, 29, "", "", "b_hit_susanoo3", 0, "", "hurt", 0, 0, 0, "", 1, 1, "", ""}]],
	[7446004] = [[{7446004, 74460, 4, 2, {20001}, "", "action1", {}, {}, {}, {}, {}, {}, 0, "", "", "", 0, "", "no-hurt", 0, 0, 0, "", 1, 1, "", ""}]],
	[7447015] = [[{7447015, 74470, 1, 1, {{10006,10003,10044},10007}, "action5", "action1", {}, {}, {405295}, {}, {}, {}, 29, "", "", "b_hit_susanoo3", 0, "", "hurt", 0, 0, 0, "", 1, 1, "", ""}]],
	[7437095] = [[{7437095, 74370, 1, 1, {{10003,10026}}, "", "action1", {}, {}, {}, {}, {}, {}, 7, "", "", "b_hit_susanoo3", 0, "", "hurt", 0, 0, 0, "", 1, 1, "", ""}]],
	[7447095] = [[{7447095, 74470, 1, 1, {{10003,10026}}, "", "action1", {}, {}, {}, {}, {}, {}, 7, "", "", "b_hit_susanoo3", 0, "", "hurt", 0, 0, 0, "", 1, 1, "", ""}]],
}
-- Standalone Sasuke 60941/60942: clone the complete 407 presentation
-- into new 743/744 ids. No combat skill/effect id is shared with 50526.
local function sasuke_indra_clone_value(value, family)
    if type(value) == "number" then
        if value >= 4070000 and value <= 4079999 then
            return family * 10000 + (value % 10000)
        elseif value >= 407000 and value <= 407999 then
            return family * 1000 + (value % 1000)
        elseif value >= 40700 and value <= 40799 then
            return family * 100 + (value % 100)
        end
        return value
    elseif type(value) ~= "table" then
        return value
    end
    local result = {}
    for k, v in pairs(value) do
        result[sasuke_indra_clone_value(k, family)] =
            sasuke_indra_clone_value(v, family)
    end
    return result
end

local function sasuke_indra_clone_range(source, min_id, max_id, family, factor)
    local pending = {}
    for id, value in pairs(source) do
        if type(id) == "number" and id >= min_id and id <= max_id then
            local new_id = family * factor + (id % factor)
            pending[new_id] = sasuke_indra_clone_value(value, family)
        end
    end
    for id, value in pairs(pending) do
        source[id] = value
    end
end

for _, family in ipairs({743, 744}) do
    sasuke_indra_clone_range(Config.SkillData1.data_get_effect_table,
        4070000, 4079999, family, 10000)
    sasuke_indra_clone_range(Config.SkillData1.data_get_skill_table,
        407000, 407999, family, 1000)
    sasuke_indra_clone_range(Config.SkillData1.data_get_skill_group,
        40700, 40799, family, 100)
end
