[582303] = [[{582303, "Địa Ngục Hỏa", "Phượng Hoàng Mã Hồng Tuấn", 58230, 582304, 3, 0, 4, "active_skill", 0, 0, 1, 1, {5823003,5821005,5823008}, {}, 0, "Phượng Hoàng Mã Hồng Quân gây ra 480% sát thương phép thuật cho tất cả  kẻ địch, nếu có 【Phượng vũ】 trên mục tiêu, xác suất chí mạng của mục tiêu sẽ tăng 30% và kèm 40% khả năng hồi máu.", "Kích hoạt điều kiện: Anh hùng đến <div fontcolor=45a536>1 Giai </div> Tự động kích hoạt", "", "23330", 0, 1, 1, {}, 0, 0, 0, 0}]],
