	[782303] = [[{782303, "Ngọc vĩ thú hợp kích", "Hinata: The Last", 78230, 0, 3, 0, 4, "active_skill", 0, 0, 1, 1, {7823003,7823013}, {}, 0, TI18N("Gây ra 200% sát thương nhẫn thuật cho toàn bộ phe địch, có 100% xác suất tẩy phép tất cả các bổ trợ tăng của toàn bộ mục tiêu; mỗi lần tẩy phép 1 bổ trợ lợi gây ra lượng sát thương bằng 8% giới hạn sinh mệnh, lượng sát thương gây ra không vượt quá 4.5 lần tấn công của bản thân"), "", "", "605823", 0, 1, 1, {}, 0, 0, 2, 0}]],
