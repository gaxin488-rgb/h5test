-- Decode cloned Sasuke data into its real standalone namespace.  The source
-- strings deliberately keep the original TI18N keys so the Vietnamese 407
-- descriptions are reused, but no runtime skill/effect/group id remains 407.
local function sasuke_standalone_decode(value, key)
	local family
	if (key >= 7430000 and key <= 7439999) or (key >= 743000 and key <= 743999) then
		family = 743
	elseif (key >= 7440000 and key <= 7449999) or (key >= 744000 and key <= 744999) then
		family = 744
	else
		return value
	end
	local function remap(v)
		if type(v) == "number" then
			if v >= 4070000 and v <= 4079999 then
				return family * 10000 + (v % 10000)
			elseif v >= 407000 and v <= 407999 then
				return family * 1000 + (v % 1000)
			elseif v >= 40700 and v <= 40799 then
				return family * 100 + (v % 100)
			end
			return v
		elseif type(v) ~= "table" then
			return v
		end
		for k, item in pairs(v) do
			v[k] = remap(item)
		end
		return v
	end
	value = remap(value)
	-- H60941/H60942 only ship action1..action5, and every separate skel
	-- contains a single animation named action1.  The original 407 rows call
	-- H50526 action6..action9 and internal action2/action3, which otherwise
	-- freeze or displace the unit on mobile clients.
	if key >= family * 10000 and key <= family * 10000 + 9999 then
		local action_res = value[6]
		if action_res == "action6" then
			value[6] = "action5"
		elseif action_res == "action7" or action_res == "action8" or action_res == "action9" then
			value[6] = "action4"
		end
		if type(value[6]) == "string" and value[6] ~= "" then
			value[7] = "action1"
		end
	end
	if key == 7447291 then
		value[1], value[2] = 7447291, 74472
	end
	if key >= family * 1000 and key <= family * 1000 + 999 then
		local suffix = key % 1000
		-- Sub-skills invoked by the two active phases must stay real active
		-- groups. Old appended rows used the full skill id as their group,
		-- which made the battle renderer collapse the second animation.
		if suffix >= 461 and suffix <= 464 then
			value[4], value[6], value[9] = family * 100 + 46, suffix - 460, "active_skill"
		elseif suffix >= 501 and suffix <= 503 then
			value[4], value[6], value[9] = family * 100 + 50, suffix - 500, "active_skill"
		end
		value[3] = family == 743 and "\083\097\115\117\107\101\032\195\130\109\058\032\072\225\186\175\099\032\086\105\195\170\109" or "\083\097\115\117\107\101\032\068\198\176\198\161\110\103\058\032\083\117\115\097\110\111\111\032\072\225\186\175\099\032\086\105\195\170\109"
		if suffix >= 101 and suffix <= 106 then value[2] = "\075\225\187\179\032\076\195\162\110"
		elseif suffix >= 201 and suffix <= 204 then value[2] = "\196\144\225\187\147\110\103\032\076\225\187\177\099\032\084\114\195\160\110\032\196\144\225\186\167\121"
		elseif suffix >= 301 and suffix <= 305 then value[2] = "Susanoo: Indra"
		elseif suffix >= 401 and suffix <= 405 then value[2] = "\083\225\187\169\099\032\077\225\186\161\110\104\032\076\225\187\165\099\032\196\144\225\186\161\111"
		elseif suffix >= 501 and suffix <= 503 then value[2] = "\076\195\180\105\032\084\104\225\186\167\110\032\082\225\187\177\099\032\067\104\195\161\121"
		elseif suffix >= 601 and suffix <= 603 then value[2] = "\196\144\225\187\139\097\032\066\225\186\161\111\032\084\104\105\195\170\110\032\084\105\110\104"
		elseif suffix >= 701 and suffix <= 707 then value[2] = "\067\104\198\176\225\187\155\099\032\196\144\225\187\153\110\058\032\072\225\186\175\099\032\086\105\195\170\109"
		elseif suffix >= 801 and suffix <= 804 then value[2] = "\076\195\180\105\032\196\144\195\172\110\104\032\067\104\225\186\165\110\032\196\144\225\187\153\110\103"
		elseif suffix >= 901 and suffix <= 905 then value[2] = "\084\104\225\186\167\110\032\084\104\111\225\186\161\105\032\078\104\225\186\171\110\032\071\105\225\187\155\105"
		end
	end
	-- Public slot 407 is intentionally backed by a different source passive.
	if key == 743407 or key == 744407 then
		value[1], value[4], value[5], value[6] = key, family * 100 + 40, 0, 5
		if key == 743407 then
			value[2] = "\067\104\198\176\225\187\155\099\032\196\144\225\187\153\110\032\195\129\112\032\067\104\225\186\191"
			value[17] = "\196\144\225\186\167\117\032\109\225\187\151\105\032\118\195\178\110\103\044\032\195\161\112\032\091\071\105\225\186\163\109\032\084\104\117\225\187\153\099\032\084\195\173\110\104\093\032\108\195\170\110\032\116\111\195\160\110\032\098\225\187\153\032\107\225\186\187\032\196\145\225\187\139\099\104\058\032\103\105\225\186\163\109\032\049\048\037\032\065\084\075\032\118\195\160\032\049\048\037\032\068\069\070\044\032\099\225\187\153\110\103\032\100\225\187\147\110\032\116\225\187\145\105\032\196\145\097\032\053\032\116\225\186\167\110\103\044\032\100\117\121\032\116\114\195\172\032\049\032\118\195\178\110\103\032\118\195\160\032\107\104\195\180\110\103\032\116\104\225\187\131\032\103\105\225\186\163\105\032\116\114\225\187\171\046"
		else
			value[14] = {7447291}
			value[2] = "\068\117\110\103\032\072\225\187\163\112\032\078\104\225\186\171\110\032\084\104\117\225\186\173\116"
			value[17] = "\196\144\225\186\167\117\032\109\225\187\151\105\032\118\195\178\110\103\044\032\098\097\110\032\091\068\117\110\103\032\072\225\187\163\112\032\078\104\225\186\171\110\032\084\104\117\225\186\173\116\093\032\099\104\111\032\050\032\196\145\225\187\147\110\103\032\109\105\110\104\032\099\195\179\032\065\084\075\032\099\097\111\032\110\104\225\186\165\116\058\032\116\196\131\110\103\032\049\048\048\037\032\067\082\073\084\059\032\109\225\187\151\105\032\108\225\186\167\110\032\104\195\160\110\104\032\196\145\225\187\153\110\103\032\099\195\179\032\050\048\037\032\120\195\161\099\032\115\117\225\186\165\116\032\103\105\195\186\112\032\083\097\115\117\107\101\032\110\104\225\186\173\110\032\049\032\116\225\186\167\110\103\032\091\083\225\187\169\099\032\077\225\186\161\110\104\032\073\110\100\114\097\093\046\032\068\117\121\032\116\114\195\172\032\050\032\118\195\178\110\103\032\118\195\160\032\107\104\195\180\110\103\032\116\104\225\187\131\032\103\105\225\186\163\105\032\116\114\225\187\171\046"
		end
	end
	-- Full presentation for the merged H60941/H60942 spine.
	-- action1: normal form, action2: human Hac Viem, action4: Susanoo,
	-- action5: large Susanoo/round skill. action3 stays transform-only.
	if key >= family * 10000 and key <= family * 10000 + 9999 then
		local effect_suffix = key % 10000
		if effect_suffix == 1 then
			value[6], value[7] = "action1", "action1"
		elseif effect_suffix >= 1001 and effect_suffix <= 1007 then
			value[6], value[7], value[10] = "action2", "action1", {405292}
		elseif effect_suffix >= 4001 and effect_suffix <= 4005 then
			value[10] = {405294}
		elseif effect_suffix >= 7001 and effect_suffix <= 7007 then
			value[6], value[7], value[10] = "action5", "action1", {405298}
		end
		if key == 7431081 then
			value[6], value[7], value[10] = "action4", "action1", {405297}
		elseif key >= 7433081 and key <= 7433084 then
			value[6], value[7], value[10] = "action5", "action1", {405295}
		elseif key == 7441081 then
			value[6], value[7], value[10] = "action4", "action1", {405297}
		elseif key >= 7443081 and key <= 7443084 then
			value[6], value[7], value[10] = "action5", "action1", {405295}
		elseif key == 7431091 then
			value[6], value[7], value[10] = "", "", {}
		elseif key >= 7433091 and key <= 7433094 then
			value[6], value[7], value[10] = "", "", {}
		elseif key == 7441091 then
			value[6], value[7], value[10] = "", "", {405294}
		elseif key == 7442091 then
			value[10] = {405292, 405294}
		elseif key >= 7443091 and key <= 7443093 then
			value[6], value[7], value[10] = "", "", {405294}
		elseif key == 7444091 then
			value[10] = {405294}
		elseif key == 7444191 then
			value[6], value[7], value[10] = "action5", "action1", {405298}
		end
	end
	-- Keep the Sasuke LR detail panel concise and independent from missing
	-- legacy language keys. Each row points only at standalone Vietnamese
	-- buff records declared in skill_data.luac.
	if key >= family * 1000 and key <= family * 1000 + 999 then
		local group_suffix = (value[4] or 0) % 100
		if family == 743 then
			local yin_buff_ui = {
				[10] = {{70431, 70383}},
				[20] = {{70433, 70383}},
				[30] = {{70383}},
				[40] = {{70432, 70383}},
				[41] = {{70432, 70383}},
