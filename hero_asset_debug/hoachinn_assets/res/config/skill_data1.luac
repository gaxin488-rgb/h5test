	[571103] = [[{571103, "Lửa tư bạo liệt", "Mạc Phàm", 57110, 0, 3, 0, 2, "active_skill", 0, 0, 1, 1, {5711043,5711003,5711013,5711023,5711033,5714113}, {}, 0, "Triệu hồi một quả cầu lửa tấn công toàn bộ kẻ địch, gây 125% sát thương phép, sau đó quả cầu lửa phát nổ, gây 82% sát thương phép cho toàn bộ kẻ địch, đồng thời có 50% khả năng giảm 30% khả năng né tránh của mục tiêu và 15% tấn công. Đòn sát thương có 60% cơ hội trúng mục tiêu, gắn [Thiêu đốt], sau đó nhận được [Hỏa linh hộ kiên], dưới [Ác ma hình thái], kỹ năng này được cường hóa thành [Liệt quyền cửu cung]", "", "", "24631", 0, 1, 1, {{95221,20091,21011,30511,28500,28600}}, 0, 1, 0, 0}]],
	[571102] = [[{571102, "Lửa tư bạo liệt", "Mạc Phàm", 57110, 571103, 2, 0, 2, "active_skill", 0, 0, 1, 1, {5711042,5711002,5711012,5711022,5711032,5714112}, {}, 0, "Triệu hồi một quả cầu lửa tấn công toàn bộ kẻ địch, gây 104% sát thương phép, sau đó quả cầu lửa phát nổ, gây 70% sát thương phép cho toàn bộ kẻ địch, đồng thời có 50% khả năng giảm 20% khả năng né tránh của mục tiêu và 10% tấn công. Đòn sát thương có 50% xác suất trúng mục tiêu, gắn [Thiêu đốt], sau đó nhận được [Hỏa linh hộ kiên], dưới [Ác ma hình thái], kỹ năng này được cường hóa thành [Liệt quyền cửu cung]", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "24631", 0, 1, 1, {{95221,20091,21011,30511,28500,28600}}, 0, 1, 0, 0}]],
	[571101] = [[{571101, "Lửa tư bạo liệt", "Mạc Phàm", 57110, 571102, 1, 0, 2, "active_skill", 0, 0, 1, 1, {5711041,5711001,5711011,5711021,5711031,5714111}, {}, 0, "Triệu hồi một quả cầu lửa tấn công toàn bộ kẻ địch, gây 72% sát thương phép, sau đó quả cầu lửa phát nổ, gây 58% sát thương phép cho toàn bộ kẻ địch, đồng thời có 50% cơ hội giảm 10% khả năng né tránh của mục tiêu. Mỗi đoạn sát thương có 40 điểm. % cơ hội thêm [Thiêu đốt] vào mục tiêu, rồi nhận được [Hỏa linh hộ kiên], dưới [Ác ma hình thái], kỹ năng này được nâng cấp thành [Liệt quyền cửu cung]", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24631", 0, 1, 1, {{95221,20091,21011,30511,28500,28600}}, 0, 1, 0, 0}]],
