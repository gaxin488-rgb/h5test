Config.SkillData1.data_get_effect_cache = {}
Config.SkillData1.data_get_effect = function(key)
	if Config.SkillData1.data_get_effect_cache[key] == nil then
		local base = Config.SkillData1.data_get_effect_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		base = sasuke_standalone_decode(base, key)
		Config.SkillData1.data_get_effect_cache[key] = {
			bid = base[1],
			group = base[2],
			target_type = base[3],
			effect_type = base[4],
			action_list = base[5],
			anime_res = base[6],
			anime_user_atk = base[7],
			bact_effect_list = base[8],
			act_effect_list = base[9],
			area_effect_list = base[10],
			hit_effect_list = base[11],
			hurt_effect_list = base[12],
			trc_effect_list = base[13],
			shake_id = base[14],
			ready_sound = base[15],
			attack_sound = base[16],
			hit_sound = base[17],
			is_play_hit_sound = base[18],
			effect_desc = base[19],
			hit_action = base[20],
			act_hurt_type = base[21],
			is_move_map = base[22],
			is_must_die = base[23],
			shout_trick = base[24],
			split_hurt = base[25],
			play_stand = base[26],
			final_skill_shout = base[27],
			choose_name = base[28],
		}
	end
	return Config.SkillData1.data_get_effect_cache[key] 
end
