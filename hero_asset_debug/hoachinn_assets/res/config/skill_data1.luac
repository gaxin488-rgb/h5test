	[782301] = [[{782301, "Ngọc vĩ thú hợp kích", "Hinata: The Last", 78230, 782302, 1, 0, 4, "active_skill", 0, 0, 1, 1, {7823001,7823011}, {}, 0, TI18N("Gây ra 150% sát thương nhẫn thuật cho toàn bộ phe địch, có 60% xác suất tẩy phép tất cả các bổ trợ tăng của toàn bộ mục tiêu; mỗi lần tẩy phép 1 bổ trợ lợi gây ra lượng sát thương bằng 5% giới hạn sinh mệnh, lượng sát thương gây ra không vượt quá 3.5 lần tấn công của bản thân"), "", "", "605823", 0, 1, 1, {}, 0, 0, 2, 0}]],
