Config.AvatarData.data_avatar_effect_fun = function(key)
	local data=Config.AvatarData.data_avatar_effect[key]
	if DATA_DEBUG and data == nil then
		print('(Config.AvatarData.data_avatar_effect['..key..'])not found') return
	end
	return data
end
