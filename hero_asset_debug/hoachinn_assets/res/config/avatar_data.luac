Config.AvatarData.data_avatar_fun = function(key)
	local data=Config.AvatarData.data_avatar[key]
	if DATA_DEBUG and data == nil then
		print('(Config.AvatarData.data_avatar['..key..'])not found') return
	end
	return data
end
