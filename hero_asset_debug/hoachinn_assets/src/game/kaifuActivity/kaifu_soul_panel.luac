function KaifuSoulPanel:clickFight()
    local setting = {}
    setting.fbId = self.select_boss
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.kaifuSoul, setting, 1)
end

function KaifuSoulPanel:updateSelect()
    if self.fubenItemList then
        for i=1,tableLen(self.fubenItemList) do
            self.fubenItemList[i]:setSelectStatus(false)
            if self.fubenItemList[i].config.id == self.select_boss then
                self.fubenItemList[i]:setSelectStatus(true)
            end
        end
    end
end

function KaifuSoulPanel:dataHandler(arr)
    
end

function KaifuSoulPanel:DeleteMe()
    doStopAllActions(self.time_txt)
    if self.background_load then
        self.background_load:DeleteMe()
        self.background_load = nil
    end
    if self.resources_load ~= nil then
        self.resources_load:DeleteMe()
        self.resources_load = nil
    end
    self.select_boss = 1
    if self.selectEvent then
        GlobalEvent:getInstance():UnBind(self.selectEvent)
        self.selectEvent = nil
    end

    if self.updateEvent then
        GlobalEvent:getInstance():UnBind(self.updateEvent)
        self.updateEvent = nil
    end

    if self.updateVideoEvent then
        GlobalEvent:getInstance():UnBind(self.updateVideoEvent)
        self.updateVideoEvent = nil
    end

    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end

    if self.fubenItemList then
        for i, v in pairs(self.fubenItemList) do
            v:DeleteMe()
        end
        self.fubenItemList = nil
    end
end

--开服武魂试炼item
KaifuSoulItem = class("KaifuSoulItem", function() 
    return ccui.Layout:create()
end)

function KaifuSoulItem:ctor()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("kaifuactivity/kaifu_soul_item"))
    self.size = self.root_wnd:getContentSize()
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setTouchEnabled(true)
    self:setAnchorPoint(0,0)
    self:setContentSize(self.size)
    self.root_wnd:setPosition(0, 0)

    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.bg = self.main_panel:getChildByName("bg")
    self.hero_icon = self.main_panel:getChildByName("hero_icon")
    self.camp_icon = self.main_panel:getChildByName("camp_icon")
    self.level = self.main_panel:getChildByName("level")
    self.level_name = self.main_panel:getChildByName("level_name")
    self.effect = self.main_panel:getChildByName("select_img")
    self:registerEvent()
end

function KaifuSoulItem:registerEvent()
    self.main_panel:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            GlobalEvent:getInstance():Fire(ActionEvent.KaifuSoulSelect ,self.config.id)
        end
    end)
end

--@config 结构是 Config.PartnerData.data_partner_base
function KaifuSoulItem:setData(config)
    if not config then return end
    self.config = config
    --英雄头像
    local res = PathTool.getHeadIcon(config.face_id)
    loadSpriteTexture(self.hero_icon,res,LOADTEXT_TYPE)

    local cfg = Config.UnitData3.data_unit1(config.boss_id)
    if not cfg then return end
    local temp_config = Config.UnitData3.data_unit2(cfg.monster3)
    local camp_type = temp_config.camp_type
    local camp_res = PathTool.getHeroCampTypeIcon(camp_type)
    loadSpriteTexture(self.camp_icon, camp_res, LOADTEXT_TYPE_PLIST)

    if config.mode == 1 then
        self.level_name:setString(TI18N("语言_c_243"))
        self.level_name:setColor(cc.c4b(255,255,255,255))
    elseif config.mode == 2 then
        self.level_name:setString(TI18N("语言_c_244"))
        self.level_name:setColor(cc.c4b(255,0,255,255))
    elseif config.mode == 3 then
        self.level_name:setString(TI18N("语言_c_246"))
        self.level_name:setColor(cc.c4b(255,25,25,255))
    end
    self:setPassMark()
end

function KaifuSoulItem:setSelectStatus(status)
    self.effect:setVisible(status)
    -- if self.effect then
    -- else
    -- self.effect:setScale(1)
    -- self.main_panel:addChild(self.effect)
    --     self.effect:setVisible(status)
    -- end
end
--@判断是否已经通关
function KaifuSoulItem:setPassMark()
    local isPass = model:getFubenIsPassById(self.config.id)
    if isPass>0 then
        addRedPointToNodeByStatus(self.main_panel,false)
        if self.passEffect then
            self.passEffect:setVisible(true)
        else
            self.passEffect = createEffectSpine("E50068", cc.p(self.main_panel:getContentSize().width/2,self.main_panel:getContentSize().height/2), cc.p(0.5, 0.5), false,  PlayerAction.action_3)
            self.passEffect:setVisible(true)
            self.main_panel:addChild(self.passEffect)
            local function eventFunc(event)
                self:showPassMv(true)
            end
            self.passEffect:registerSpineEventHandler(eventFunc, sp.EventType.ANIMATION_COMPLETE)
        end
    else
        addRedPointToNodeByStatus(self.main_panel,true,10,10)
        if self.passEffect then
            self.passEffect:setVisible(false)
        end
    end
end

function KaifuSoulItem:showPassMv(status)
    if status == true then
        if self.pass_mv == nil then
            self.pass_mv = createEffectSpine("E50068", cc.p(self.main_panel:getContentSize().width/2,self.main_panel:getContentSize().height/2), cc.p(0.5, 0.5), true, PlayerAction.action_3)
            self.main_panel:addChild(self.pass_mv)
        end
        self.pass_mv:setVisible(true)
    else
        if self.pass_mv then
            self.pass_mv:clearTracks()
            self.pass_mv:removeFromParent()
            self.pass_mv = nil
        end
    end
end

function KaifuSoulItem:DeleteMe()
    if self.passEffect then
        self.passEffect:clearTracks()
        self.passEffect:removeFromParent()
        self.passEffect = nil
    end
    self:showPassMv(false)
    self:removeAllChildren()
    self:removeFromParent()
end
