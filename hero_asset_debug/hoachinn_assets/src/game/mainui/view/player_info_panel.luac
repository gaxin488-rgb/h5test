--==============================--
function PlayerInfoPanel:adaptScreen()
    self.top_container:setPositionY(display.getTop())
end

--==============================--
--desc:注册事件
--time:2017-09-09 02:23:00
--@return
--==============================--
function PlayerInfoPanel:registerEvent()
    if self.role_vo then
        if self.role_update_event == nil then
            self.role_update_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE, function(key, value)
                if key == "power" or key == "match_rank" then 		--段位分
                    self:updateRoleFc()
                elseif key == "lev" then 	--等级
                    self:updateRoleLev()
                    self:updataVIPRedPoint()
                    self.overLev = false
                    if value >= Config.MergeVotingData.data_const.level_limit.val then
                        self.overLev = true
                        MergeserverController:getInstance():sender10991()
                    end
                    self:updataExchangeRedPoint()
                elseif key == "name" then 	-- 改名的时候
                    self:updateRoleName()
                elseif key == "face_id" or key == "face_update_time" or key == "custom_face_file" then
                    self:updateRoleHead()
                elseif key == "avatar_base_id" then
                    self:updateRoleHeadCircle()
                elseif key == "coin" or key == "gold" or key == "red_gold" or key == "silver_coin" or key == "hero_exp" then
                    self:updateRoleAssets()
                elseif key == "vip_lev" then
                    self:updateRoleVip()
                elseif key == "gid" and value == 0 then
                    -- self:showRedBagEffect(false)
                end
            end)
        end
    end
    --vip图标红点
    if self.vip_image_redpoint == nil then
        self.vip_image_redpoint = GlobalEvent:getInstance():Bind(VipEvent.SUPRE_CARD_GET, function(status)
            self:updataVIPRedPoint()
        end)
    end

    if self.role_head then
        self.role_head:addCallBack(function()
            RoleController:getInstance():openRolePersonalSpacePanel(true)
        end, false)
    end

    if self.gold_touch then
        self.gold_touch:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()

                if self.wealth_item_key[2]  then
                    if self.wealth_item_key[2] == "hero_exp" then --英雄经验 
                        local config = Config.ItemData.data_get_data(Config.ItemData.data_assets_label2id.hero_exp)
                        if config then
                            BackpackController:getInstance():openTipsSource(true, config)
                        end
                    else --默认钻石的
                        --MallController:getInstance():openChargeShopWindow(true, MallConst.Charge_Shop_Type.Diamond)
                        VipController:getInstance():openVipMainWindow(true, VIPTABCONST.CHARGE)
                    end
                else
                    --MallController:getInstance():openChargeShopWindow(true, MallConst.Charge_Shop_Type.Diamond)
                    VipController:getInstance():openVipMainWindow(true, VIPTABCONST.CHARGE)    
                end
            end
        end)
    end

    if self.coin_touch and not MAKELIFEBETTER_NEW then
        self.coin_touch:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                if self.wealth_item_key[1] then
                    --目前只有默认金币的.还没有其他需求
                    ExchangeController:getInstance():openExchangeMainView(true)
                else
                    ExchangeController:getInstance():openExchangeMainView(true)    
                end
                
            end
        end)
    end

    if self.fight_panel then
        self.fight_panel:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                self.fight_value:setString(MoneyTool.moneyFormat(self.role_vo.power))
                self.fight_layer:setVisible(true)
                self.Panel_2:setVisible(true)
            end
        end)
    end
    
    if self.gold_num_touch then
        self.gold_num_touch:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                self.gold_value:setString(MoneyTool.moneyFormat(self.role_vo[self.wealth_item_key[2]]))
                local item_id = Config.ItemData.data_assets_label2id[self.wealth_item_key[2]]
                local config = Config.ItemData.data_get_data(item_id)
                if config then
                    local res = PathTool.getItemRes(config.icon, false)
                    loadSpriteTexture(self.gold_icon, res, LOADTEXT_TYPE)
                    self:updateValuePanel(self.gold_num_layer,self.gold_bg,self.gold_icon,self.gold_value)
                    self.gold_num_layer:setVisible(true)
                    self.Panel_2:setVisible(true)
                end
            end
        end)
    end
    
    if self.coin_num_touch then
        self.coin_num_touch:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                self.coin_value:setString(MoneyTool.moneyFormat(self.role_vo.coin))
                self:updateValuePanel(self.coin_num_layer,self.coin_bg,self.coin_icon,self.coin_value)
                self.coin_num_layer:setVisible(true)
                self.Panel_2:setVisible(true)
            end
        end)
    end
    if self.Panel_2 then
        self.Panel_2:addTouchEventListener(function()
            self.fight_layer:setVisible(false)
            self.gold_num_layer:setVisible(false)
            self.coin_num_layer:setVisible(false)
            self.Panel_2:setVisible(false)
        end)
    end
    if self.time_panel then
        self.time_panel:addTouchEventListener(function()
            controler:openTimeView(true)
        end)
    end

    --点金红点
    if self.coin_touch_redpoint == nil then
        self.coin_touch_redpoint = GlobalEvent:getInstance():Bind(ExchangeEvent.Extra_Reward, function(data)
            -- self.exchange_data = data
            self:updataExchangeRedPoint()
        end)
    end

    --头部资产更新事件
    if self.update_wealth_event == nil then
        self.update_wealth_event = GlobalEvent:getInstance():Bind(MainuiEvent.HEAD_UPDATE_WEALTH_EVENT, function(index, id)
            if index and id  then
                if self.wealth_item_key then
                    self.wealth_item_key[index] = Config.ItemData.data_assets_id2label[id]
                    self:updateRoleAssets()
                end
            end
        end)
    end
    
    if self.customer_new_msg_event == nil then
        self.customer_new_msg_event = GlobalEvent:getInstance():Bind(NoticeEvent.Get_Customer_Close_Info_Event_Data, function()  --
            self:updateCustomerRed()
        end)
    end
    if self.info_red_event == nil then
        self.info_red_event = GlobalEvent:getInstance():Bind(RoleEvent.UPDATE_RED_EVENT, function()  --
            self:updateCustomerRed()
        end)
    end
end

function PlayerInfoPanel:updateCustomerRed()
    local red_status = NoticeController:getInstance():getModel():checkRedStatus() or false
    addRedPointToNodeByStatus( self.role_head, red_status or RoleController:getInstance():getModel():getRedForInfo(), 6, -5, nil)
    MainuiController:getInstance():setFunctionTipsStatus(MainuiConst.icon.customer, red_status)
end

--更新VIP红点
function PlayerInfoPanel:updataVIPRedPoint()
    if not self.role_vo then return end
    if MAKELIFEBETTER ~= true then
        if self.role_vo.lev < 6 then return end
    end
end

--更新点金红点
function PlayerInfoPanel:updataExchangeRedPoint() 
    self.exchange_data = ExchangeController:getInstance():getModel():get23606Data()
    if not self.exchange_data then
        return
    end
    local red_lev_min =  Config.ConvertData.data_trade_cost.red_lev_min
    for i,v in ipairs(self.exchange_data.list) do
        if v.id == 1 and self.coin_touch then
            local status = false
            if (v.max - v.num) > 0 and self.role_vo and red_lev_min and red_lev_min.val <= self.role_vo.lev then
                status = true
            end
            addRedPointToNodeByStatus(self.coin_touch,status,11,7,nil,nil,PathTool.getResFrame("mainui","mainui_1009"))
        end
    end
end

function PlayerInfoPanel:DeleteMe()
    doStopAllActions(self.server_time) --停止计时器
    if self.resources_load ~= nil then
		self.resources_load:DeleteMe()
		self.resources_load = nil
	end
    if self.function_time_ticket then
        GlobalTimeTicket:getInstance():remove(self.function_time_ticket)
        self.function_time_ticket = nil
    end
    for k, layer in pairs(self.icon_container_list) do
        if layer ~= nil and not tolua_isnull(layer) then
            layer:stopAllActions()
        end
    end
    if self.vip_label then
        self.vip_label:DeleteMe()
        self.vip_label = nil
    end
    if self.add_function_timer ~= nil then
        GlobalTimeTicket:getInstance():remove(self.add_function_timer)
        self.add_function_timer = nil
    end
    if self.role_vo then
        if self.role_update_event ~= nil then
            self.role_vo:UnBind(self.role_update_event)
            self.role_update_event = nil
        end
        self.role_vo = nil
    end
    if self.update_acc then
        GlobalEvent:getInstance():UnBind(self.update_acc)
        self.update_acc = nil
    end

    if self.red_bag_event then 
        GlobalEvent:getInstance():UnBind(self.red_bag_event)
        self.red_bag_event = nil
    end
    if self.petard_red_bag_event then
        GlobalEvent:getInstance():UnBind(self.petard_red_bag_event)
        self.petard_red_bag_event = nil
    end

    if self.year_red_bag_event then
        GlobalEvent:getInstance():UnBind(self.year_red_bag_event)
        self.year_red_bag_event = nil
    end

    if self.main_ui_banner_next_event then
        GlobalEvent:getInstance():UnBind(self.main_ui_banner_next_event)
        self.main_ui_banner_next_event = nil
    end
    
    if self.return_red_bag_event then
        GlobalEvent:getInstance():UnBind(self.return_red_bag_event)
        self.return_red_bag_event = nil
    end

    if self.time_collect_event then
        GlobalEvent:getInstance():UnBind(self.time_collect_event)
        self.time_collect_event = nil
    end
    
    
    if self.new_msg_add_event then
        GlobalEvent:getInstance():UnBind(self.new_msg_add_event)
        self.new_msg_add_event = nil
    end
    if self.update_recharge_red then
        GlobalEvent:getInstance():UnBind(self.update_recharge_red)
        self.update_recharge_red = nil
    end
    if self.vote_mergeServer_event then
        GlobalEvent:getInstance():UnBind(self.vote_mergeServer_event)
        self.vote_mergeServer_event = nil
    end
    if self.vote_mergeSuccess_event then
        GlobalEvent:getInstance():UnBind(self.vote_mergeSuccess_event)
        self.vote_mergeSuccess_event = nil
    end
        if self.vote_mergeAction_event then
        GlobalEvent:getInstance():UnBind(self.vote_mergeAction_event)
        self.vote_mergeAction_event = nil
    end
    if self.update_drama_max_event then
        GlobalEvent:getInstance():UnBind(self.update_drama_max_event)
        self.update_drama_max_event = nil
    end
    if self.update_wealth_event then
        GlobalEvent:getInstance():UnBind(self.update_wealth_event)
        self.update_wealth_event = nil
    end
    if self.update_prompt_tips then
        GlobalEvent:getInstance():UnBind(self.update_prompt_tips)
        self.update_prompt_tips = nil
    end
    if self.remove_prompt_tips then
        GlobalEvent:getInstance():UnBind(self.remove_prompt_tips)
        self.remove_prompt_tips = nil
    end
    if self.coin_touch_redpoint then
        GlobalEvent:getInstance():UnBind(self.coin_touch_redpoint)
        self.coin_touch_redpoint = nil
    end
    if self.customer_new_msg_event then
        GlobalEvent:getInstance():UnBind(self.customer_new_msg_event)
        self.customer_new_msg_event = nil
    end
    if self.info_red_event then
        GlobalEvent:getInstance():UnBind(self.info_red_event)
        self.info_red_event = nil
    end
    if self.vip_image_redpoint then
        GlobalEvent:getInstance():UnBind(self.vip_image_redpoint)
        self.vip_image_redpoint = nil
    end
    if self.update_hero_red then
        GlobalEvent:getInstance():UnBind(self.update_hero_red)
        self.update_hero_red = nil
    end
    if self.fly_item_event then
        GlobalEvent:getInstance():UnBind(self.fly_item_event)
        self.fly_item_event = nil
    end
    if self.fly_item_shake_event then
        GlobalEvent:getInstance():UnBind(self.fly_item_shake_event)
        self.fly_item_shake_event = nil
    end
    if self.treasure_red_event then
        GlobalEvent:getInstance():UnBind(self.treasure_red_event)
        self.treasure_red_event = nil
    end
    if self.update_action_data_event then
        GlobalEvent:getInstance():UnBind(self.update_action_data_event)
        self.update_action_data_event = nil
    end
    if self.update_holiday_tab_status then
        GlobalEvent:getInstance():UnBind(self.update_holiday_tab_status)
        self.update_holiday_tab_status = nil
    end
    if self.hero_pros_switch_back_event then
        GlobalEvent:getInstance():UnBind(self.hero_pros_switch_back_event)
        self.hero_pros_switch_back_event = nil
    end
    if self.update_trainingcamp_data then
        GlobalEvent:getInstance():UnBind(self.update_trainingcamp_data)
        self.update_trainingcamp_data = nil
    end
    if self.updateEvent then
        GlobalEvent:getInstance():UnBind(self.updateEvent)
        self.updateEvent = nil
    end
    if self.vip_image_effect then
        self.vip_image_effect:clearTracks()
        self.vip_image_effect:removeFromParent()
        self.vip_image_effect = nil
    end

    for k, v in pairs(self.function_list) do
        if v.DeleteMe then
            v:DeleteMe()
        end
    end

    if not tolua_isnull(self.item_container) then
        self.item_container:removeAllChildren()
    end

    self.function_list = {}
    self.render_list = {}
    self.render_list_dic = {}
    
    self:removeAllChildren()
    self:removeFromParent()
end