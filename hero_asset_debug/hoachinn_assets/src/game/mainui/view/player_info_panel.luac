-- --------------------------------------------------------------------
-- 项目的主UI,包含了头像,图标,经验,聊天等
--
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-xx-xx
-- --------------------------------------------------------------------
PlayerInfoPanel = class("PlayerInfoPanel", function()
    return ccui.Widget:create()
end)

local string_format = string.format
local controler = MainuiController:getInstance()
local tolua_isnull = tolua.isnull
local action_controler = ActionController:getInstance()
local table_insert = table.insert
local unfold_ani_time = 0.1
local bg_unfold_time = 0.01
-- mainui_1 = nil
-- mainui_2 = nil
function PlayerInfoPanel:ctor()
    self.res_list = {
    }
    -- PathTool.checkRes("resource/bondskill/bondskill/bondskill_40.png")
    if self.resources_load == nil then
        self.resources_load = ResourcesLoad.New(true) 
    end
    self.resources_load:addAllList(self.res_list,function()
        if self then
            self.img_is_load = true
            self:updateNoticePage()
            self:runUpdateNoticePageData()
        end
    end)
    self:initConfig()
    self:createRootWnd()
    self:registerEvent()
    self:updateRoleData()
end

function PlayerInfoPanel:initConfig()
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.bottom_btn_list = {}					-- 下方的功能按钮
    self.treasure_btn_list = {}					-- 编年史的功能按钮
    self.special_btn_list = {}					-- 潜能释放的功能按钮
    self.pros_btn_list = {}					-- 禁术的功能按钮
    self.icon_container_list = {}				-- 根据方位保存需要储存的图标的父节点
    self.wealth_item_key = {"coin", "gold"}     --资产icon显示数据 key 是self.role_vo里面的变量
    self.record_wealth_icon_res = {}            --记录当前资产的icon
    self.wealth_icon_list = {}                 -- 资产的数值icon
    self.wealth_label_list = {}					-- 资产的数值按钮
    self.is_open = true 						-- 是否是打开状态下
    self.cur_select_index = 0					-- 当前选中的按钮id

    self.render_list = {}						-- 待添加的实例对象
    self.render_list_dic = {}					-- 但添加实例字典
    self.function_list = {}						-- 显示的实例对象
    self.cur_vip_lev = nil                      -- VIP等级
    self.top_left_off = 15
    self.left_off = 20
    self.right_off = 20
    self.top_left_max_sum = 4
    self.left_max_sum = 5

    self.is_in_shrink = false
    self.is_shrink = false

    self.layout_list = {}
    for k, v in pairs(FunctionIconVo.type) do
        self.layout_list[v] = {}
    end
    self.btn_cache_tips = {}    --红点缓存

    self.hide_container_status = true

    self.dungeon_item_label = {}

    self.left_icon_unfold = true -- 左侧图标展开状态
    self.right_icon_unfold = true -- 右侧图标展开状态
    self.func_show_status = true
    self.red_bag_2_type = 0 --1：花火红包 2：年兽红包  用于点击事件判断
    self.training_camp_lev_limit = Config.TrainingCampData.data_const.training_camp_lev_limit
    self.bool = false
    self.is_can_click_tip = true
    self.tab_list = {}
    self.notice_index = 0
    self.mainui_list = {}
    self.bottom_setting = {}
end

function PlayerInfoPanel:createRootWnd()
    local csbPath = PathTool.getTargetCSB("mainui/player_info_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
    self:setContentSize(self.size)

    self.top_container = self.root_wnd:getChildByName("top_container")
    local head_container = self.top_container:getChildByName("head_container")
    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.role_head:setPosition(40, 40)
    head_container:addChild(self.role_head)

    self.info_container = self.top_container:getChildByName("info_container")
    self.lev_label = self.info_container:getChildByName("lev_label")
    self.name_g = self.info_container:getChildByName("name_g")
    self.name_label = self.name_g:getChildByName("name_label")
    for i = 1, 2 do
        self.wealth_label_list[i] = self.info_container:getChildByName("wealth_label_"..i)
        self.wealth_icon_list[i] = self.info_container:getChildByName("wealth_icon_"..i)
    end
    self.fight_label = self.info_container:getChildByName("fight_label")

    self.coin_num_touch = self.top_container:getChildByName("coin_num_touch")
    self.gold_num_touch = self.top_container:getChildByName("gold_num_touch")
    self.gold_touch = self.top_container:getChildByName("gold_touch")
    self.coin_touch = self.top_container:getChildByName("coin_touch")
    --头顶的
    self.vip_label = CommonNum.new(19, self.info_container, 1, -2, cc.p(0, 0.5))
    self.vip_label:setPosition(22, 56)
    --显示服务器时间
    self.time_layer = self.top_container:getChildByName("time_layer")
    self.time_panel = self.top_container:getChildByName("time_panel")
    self.server_time = self.time_layer:getChildByName("server_time")
    self:showServerTime()
    self.fight_panel = self.top_container:getChildByName("fight_panel")
    self.Panel_2 = self.root_wnd:getChildByName("Panel_2")
    --显示战斗力
    self.fight_layer = self.top_container:getChildByName("fight_layer")
    self.fight_layer:setVisible(false)
    self.Panel_2:setVisible(false)
    self.fight_bg = self.fight_layer:getChildByName("bg")
    self.fight_icon = self.fight_layer:getChildByName("icon")
    self.fight_txt = self.fight_layer:getChildByName("fight_txt")
    self.fight_value = self.fight_layer:getChildByName("fight_value")
    self.fight_value:setString(MoneyTool.moneyFormat(self.role_vo.power))
    self.fight_value:setPositionX(self.fight_txt:getContentSize().width + self.fight_txt:getPositionX()+10)
    
    --显示银币数量
    self.coin_num_layer = self.top_container:getChildByName("coin_num_layer")
    self.coin_num_layer:setVisible(false)
    self.coin_bg = self.coin_num_layer:getChildByName("bg")
    self.coin_icon = self.coin_num_layer:getChildByName("icon")
    self.coin_value = self.coin_num_layer:getChildByName("coin_num_value")
    
    --显示金币数量
    self.gold_num_layer = self.top_container:getChildByName("gold_num_layer")
    self.gold_num_layer:setVisible(false)
    self.gold_bg = self.gold_num_layer:getChildByName("bg")
    self.gold_icon = self.gold_num_layer:getChildByName("icon")
    self.gold_value = self.gold_num_layer:getChildByName("gold_num_value")
end

function PlayerInfoPanel:updateValuePanel(layer,bg,icon,value)
    local value_w = value:getContentSize().width
    local _w = math.max(177,value_w + 63)
    layer:setContentSize(cc.size(_w,layer:getContentSize().height))
    bg:setContentSize(cc.size(_w,bg:getContentSize().height))
    icon:setPositionX(6)
    value_w = math.max(value_w,114)
    value:setPositionX(_w-16-value_w*0.5)
end
function PlayerInfoPanel:showServerTime()
    if tolua.isnull(self.server_time) then return end
    local time_fun = function()
        local timezone = 0
        if InviteCodeController:getInstance() and  InviteCodeController:getInstance():getModel() and InviteCodeController:getInstance().getModel then
            timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
        end
        local nowtime = GameNet:getInstance():getTime()
        -- self.server_time:setString(TimeTool.getHM(nowtime))
        self.server_time:setString(TimeTool.xsdate("%H:%M",nowtime,timezone))
    end
    time_fun()
    doStopAllActions(self.server_time)
    self.server_time:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1), cc.CallFunc:create(function()
        time_fun()
    end))))
end

-- ---------------------- 资产部分 start---------------------- -- 
function PlayerInfoPanel:updateRoleData()
    self:updateRoleLev()
    self:updateRoleFc()
    self:updateRoleName()
    self:updateRoleHead()
    self:updateRoleHeadCircle()
    self:updateRoleVip()
    self:updateRoleAssets()
    self:updataExchangeRedPoint()
    self:updateCustomerRed()
end

function PlayerInfoPanel:updateRoleLev()
    if self.role_vo == nil then return end
    if self.cur_lev == self.role_vo.lev then return end
    self.cur_lev = self.role_vo.lev
    self.lev_label:setString(self.cur_lev)
    -- 判断等级是否需要显示气泡
    -- self:createChatBubble()
end

function PlayerInfoPanel:updateRoleFc()
    if self.role_vo == nil then return end
    if self.cur_fc == self.role_vo.power then return end
    self.cur_fc = self.role_vo.power
    self.fight_label:setString(MoneyTool.moneyFormat(self.cur_fc))
end

function PlayerInfoPanel:updateRoleName()
    if self.role_vo == nil then return end
    if self.cur_name == self.role_vo.name then return end
    self.cur_name = self.role_vo.name
    self.name_label:setString(self.cur_name)
end

--- 更新角色头像,这里要特殊处理了,有可能是自定义头像,也有可能是系统头像,优先判断系统头像,这里应该需要判断如果还没有初始化cos，就不处理
function PlayerInfoPanel:updateRoleHead()
    local check_status_str = TencentCos:getInstance():getSecretid()
    if check_status_str == nil or check_status_str == "" then return end
    if self.role_vo == nil then return end
    local res_id = self.role_vo.face_id
    local face_update_time = self.role_vo.face_update_time
    self.role_head:setHeadRes(res_id, false, LOADTEXT_TYPE, self.role_vo.face_file, self.role_vo.face_update_time)
end

function PlayerInfoPanel:updateRoleHeadCircle()
    if self.role_vo == nil then return end
    if self.avatar_base_id == self.role_vo.avatar_base_id then return end
    self.avatar_base_id = self.role_vo.avatar_base_id
    local vo = Config.AvatarData.data_avatar[self.role_vo.avatar_base_id]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.role_head:showBg(res, nil, false, vo.offy)
    end
end

function PlayerInfoPanel:updateRoleVip()
    if self.role_vo == nil then return end
    
    self.vip_label:setNum(self.role_vo.vip_lev)
    -- self.vip_image_label:setNum(self.role_vo.vip_lev)
end

function PlayerInfoPanel:updateRoleAssets()
    if self.role_vo == nil then return end
    for i,key in ipairs(self.wealth_item_key) do
        local label = self.wealth_label_list[i]
        local key_value = self.role_vo[key] or 0
        label:setString(MoneyTool.GetMoneyString(key_value))
        local item_id = Config.ItemData.data_assets_label2id[key]
        local config = Config.ItemData.data_get_data(item_id)
        if config then 
            local res = PathTool.getItemRes(config.icon, false)
            if self.record_wealth_icon_res[i] == nil or self.record_wealth_icon_res[i] ~= res then
                self.record_wealth_icon_res[i] = res
                if self.wealth_icon_list[i] then
                    loadSpriteTexture(self.wealth_icon_list[i], res, LOADTEXT_TYPE)
                end
            end
        end
    end
end
-- ---------------------- 资产部分 end---------------------- --

