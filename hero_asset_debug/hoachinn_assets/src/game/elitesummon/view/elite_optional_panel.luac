local controller = ActionController:getInstance()
local model = controller:getModel()

EliteOptionalPanel = class("EliteOptionalPanel", function()
    return ccui.Widget:create()
end)

function EliteOptionalPanel:ctor(bid)
	self.holiday_bid = bid
	self.res_list = {
        -- { path = PathTool.getPlistImgForDownLoad("elitesummon","elitesummon"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("num","battle_num"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("recruit_ninja","recruit_ninja"), type = ResourcesType.plist },
    } 

    self.config = Config.RecruitHolidayHeroData
    
    self.touch_recruit_10 = true --点击延迟
    self.is_can_award = false --是否有可领取的保底奖励
    self.recruit_type_1 = nil --单抽  3 是钻石 4 是道具 1是免费单抽
    self.recruit_type_10 = nil --10抽
    self.isEnd = 0 --活动是否结束
    self.groupId = 0
    self.item_node_list = {}
    self.resources_load = ResourcesLoad.New(true)
    self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
        	self:loadResListCompleted()
        end
    end)
end
-- 资源加载完成
function EliteOptionalPanel:loadResListCompleted()
	self:configUI()
	self:register_event()
end

