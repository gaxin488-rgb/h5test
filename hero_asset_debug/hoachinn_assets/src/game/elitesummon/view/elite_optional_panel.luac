function EliteOptionalPanel:setAutoSacrificeStatus()
    local status = NewPartnersummonController:getInstance():getModel():getignoreMp4()
    if status ~= 0 then
        self.checkBox:setSelected(true)
    else
        self.checkBox:setSelected(false)
    end
end

--计时器
function EliteOptionalPanel:showServerTime()
    if tolua.isnull(self.surplus_time) then return end
    doStopAllActions(self.surplus_time)
    self.surplus_time:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1), cc.CallFunc:create(function()
       self:setTime() 
    end))))
end
function EliteOptionalPanel:setTime()
    if not self.endtime then return end
    local endtime = self.endtime
    local nowtime = GameNet:getInstance():getTime()
    if endtime > nowtime then
        local time = endtime - nowtime
        self:setBtn(true)
        controller:getModel():setCountDownTime(self.surplus_time,time or 0)
    else
        self.surplus_time:setString(TI18N("语言_s_11"))
        self:setBtn(false)
        doStopAllActions(self.surplus_time)
    end
end
function EliteOptionalPanel:setBtn(status)
    self.btn_go:setVisible(not status)
    self.Text_32:setVisible(not status)
    self.btn_summon_1:setVisible(status)
    self.btn_summon_10:setVisible(status)
    self.checkBox:setVisible(status)
end
function EliteOptionalPanel:setData()
    local baseData = controller:getActionSubTabVo(self.holiday_bid)
    self.actId = baseData.camp_id --唯一活动id
    if not self.config then 
        send_error_to_pf("EliteOptionalPanel_noconfig2_bid" .. tostring(self.holiday_bid))
        return 
    end
    self.actCfgBaseInfo = self.config.data_action_fun(self.actId) --活动基础信息
    -- printLuaTable(self.actCfgBaseInfo)
    if not self.actCfgBaseInfo then return end
    self.groupId = self.groupId == 0 and self.actCfgBaseInfo.group_id or self.groupId
    self.actCfgInfo = self.config.data_summon_fun( self.groupId) --活动详细信息
    -- printLuaTable(self.actCfgInfo)
    if not self.actCfgInfo then return end
    --重载一下界面背景
    local image_bg = self.main_container:getChildByName("image_bg")
    local bgName = self.actCfgInfo.bg_res or "recruit_hero_back"
    if self.actCfgInfo.bg_res == "" then
        bgName = "recruit_hero_back"
    end
    local bg_res =  PathTool.getTargetRes("recruit_ninja",bgName,false,false)
	loadSpriteTexture(image_bg, bg_res, LOADTEXT_TYPE)

    local tlt_str = "txt_cn_recruit_hero_lang"
    if self.actCfgInfo and  self.actCfgInfo.desc ~= "" then
        tlt_str = self.actCfgInfo.desc
    end
    local title_res =  PathTool.getResFrame("recruit_ninja",tlt_str)
    loadSpriteTexture(self.title_img, title_res, LOADTEXT_TYPE_PLIST)

    self.summon_item_bid = self.actCfgInfo.common_s
    local itemConfig = Config.ItemData.data_get_data(self.summon_item_bid)
    if itemConfig then
        local icon_res = PathTool.getItemRes(itemConfig.icon)
        loadSpriteTexture(self.icon, icon_res, LOADTEXT_TYPE)
        self.icon:setScale(0.6)
    end
    -- setTextSpacing(self.icon_name,-10)
    -- self.icon_name:setString(self.actCfgInfo.skip1_name)
    if self.actCfgInfo.skip2_id and self.actCfgInfo.skip2_id ~= 0 then
        self.act_tip_bg:setVisible(true)
        self.act_icon:loadTexture(PathTool.getFunctionRes(self.actCfgInfo.skip2_title), LOADTEXT_TYPE)
        setTextSpacing(self.act_name,-10)
        local data = HeroController:getInstance():getModel():getTopLevHeroInfoByBidNoResona(self.actCfgInfo.skip1_hero_id)
        -- print(vardump(data),"+++++++++++++++++++++")
        local star = data and data.star or 0
        if data and data.resonate_star ~= 0 then
            star = data.resonate_star
        end
        local max_star = Config.PartnerData.data_partner_max_star[self.actCfgInfo.skip1_hero_id] or 5
        self.star_txt:setString(string.format("%s/%s",star,max_star))
        self.star_bar:setPercent(star/max_star*100)
        self.act_name:setString(self.actCfgInfo.skip2_name)
    else
        self.act_tip_bg:setVisible(false)
    end
    local summon_have_num = BackpackController:getInstance():getModel():getItemNumByBid(self.summon_item_bid)
    self.icon_count:setString(summon_have_num)
    self:recruitBtnStatus(1)
    self:recruitBtnStatus(10)
    self:setItemData()
    self:showGuideEffect(true)
    self:setServerData()
    --选择框
    local cfg = Config.RecruitHolidayHeroData.data_chose_info[self.campid]
    if cfg and cfg[self.groupId] then
        self.box_icon:setVisible(true)
        self.box_add:setVisible(false)
        self.box_chose:setVisible(true)
        if not self.hero_item then
            self.hero_item = BackPackItem.new(false,true)
            self.hero_item:setAnchorPoint(cc.p(0.5,0.5))
            -- self.hero_item:setScale(1)
            self.hero_item:setDefaultTip()
            self.box_icon:addChild(self.hero_item)
        end
        if self.hero_item then
            self.hero_item:setVisible(true)
            self.hero_item:setBaseData(cfg[self.groupId].hero_id,1)
        end
        local item_cfg = Config.ItemData.data_get_data(cfg[self.groupId].hero_id)
        if item_cfg then
            local id = item_cfg.effect[1].val[1]
            local hero_cfg = Config.PartnerData.data_partner_base[id]
            if hero_cfg then
                self.hero_name_bg:setVisible(true)
                self.act_tip_bg:setVisible(true and self.actCfgInfo.skip2_id and self.actCfgInfo.skip2_id ~= 0)
                self.hero_up:setVisible(cfg[self.groupId].num ~= 0)
                if cfg[self.groupId].num ~= 0 then
                    loadSpriteTexture(self.hero_up, PathTool.getTargetRes("selectelitesummon","txt_cn_selectelitesummon2_"..cfg[self.groupId].num,false,false), LOADTEXT_TYPE)
                end
                self.hero_name:setString(hero_cfg.name)
                loadSpriteTexture(self.hero_type, PathTool.getHeroCampTypeIcon(hero_cfg.camp_type), LOADTEXT_TYPE_PLIST)
                local _w = math.max(self.hero_name_bg:getContentSize().width,self.hero_name:getContentSize().width + 100)
                self.hero_name_bg:setContentSize(cc.size(_w,self.hero_name_bg:getContentSize().height))
                self.hero_type:setPositionX(42.5)
                -- self.hero_name:setPositionX(_w-27-self.hero_name:getContentSize().width*0.5)
                self.hero_name:setPositionX(_w*0.5+12)
            end
        end
    else
        self.box_icon:setVisible(false)
        self.box_add:setVisible(true)
        self.box_chose:setVisible(false)
        if self.hero_item then
            self.hero_item:setVisible(false)
        end
        self.hero_name_bg:setVisible(false)
        self.act_tip_bg:setVisible(false)
        self.hero_up:setVisible(false)
    end
end

function EliteOptionalPanel:setServerData()
    if not self.actCfgInfo then return end
    local serverData = model:geteliteDataByBid(self.actId)
    if not serverData then return end
    -- self:setTime() 
    local txt = ""
    local txt_list = {}
    local str = ""
    if serverData.must_count == 0 then
        str = TI18N("语言_c_6762")
    else
        if serverData.must_count >= 0 and serverData.must_count < 10 then
            txt = TI18N("语言_c_6759")
            local num = serverData.must_count % 10
            txt_list = {PathTool.getResFrame("num/battle_num","type20_"..num)}
        elseif serverData.must_count >= 10 and serverData.must_count < 100 then
            txt = TI18N("语言_c_6760")
            local num = serverData.must_count % 10
            local num_10 = math.floor(serverData.must_count / 10)
            txt_list = {PathTool.getResFrame("num/battle_num","type20_"..num_10),PathTool.getResFrame("num/battle_num","type20_"..num)}
        elseif serverData.must_count >= 100 and serverData.must_count < 1000 then
            txt = TI18N("语言_c_6761")
            local num = serverData.must_count % 10
            local num_10 = math.floor(serverData.must_count%100/10)
            local num_100 = math.floor(serverData.must_count / 100)
            txt_list = {PathTool.getResFrame("num/battle_num","type20_"..num_100),PathTool.getResFrame("num/battle_num","type20_"..num_10),PathTool.getResFrame("num/battle_num","type20_"..num)}
        end
        str = LangStringFormat(txt,txt_list)
    end
    self.Image_2:setContentSize(cc.size(546,48))
    self.remain_up:setString(str)
    self.str = str
    moveTextBg(self.remain_up,self.Image_2,40)
    self.endtime = serverData.end_time
    local freeTime = serverData.free_time
    self:setCountDownTime(freeTime)
    local num = serverData.times
    if num then
        local str = string.format(TI18N("语言_c_4730"),num,self.actCfgInfo.times_limit)
        self.frequency:setString(str)
    else
        self.frequency:setVisible(false)
    end
    local str_time = string.format("%s-%s",TimeTool.getMD4(serverData.start_time),TimeTool.getMD4(serverData.end_time))
    self.holiday_time:setString(str_time)
    self:recruitBtnStatus(1)
    self:recruitBtnStatus(10)
end
--获取金币次数够不够
function EliteOptionalPanel:getGoldIsEnough(model_type)
    local serverData = model:geteliteDataByBid(self.actId)
    local num = serverData.times
    if num + model_type <= self.actCfgInfo.times_limit then
        return true
    end
    return false
end

--设置招募按钮的状态 model = 1 表示单抽
function EliteOptionalPanel:recruitBtnStatus(model_type)
    local serverData = model:geteliteDataByBid(self.actId)
    if not serverData then return end
    local freeTime = serverData.free_time

    if self.actCfgInfo then
        local summon_have_num = BackpackController:getInstance():getModel():getItemNumByBid(self.summon_item_bid)
        if summon_have_num >= model_type or not self:getGoldIsEnough(model_type) then --道具抽取
            local config
            if model_type == 1 then
                self.recruit_type_1 = 4
                config = Config.ItemData.data_get_data(self.actCfgInfo.loss_item_once[1][1])
            elseif model_type == 10 then
                self.recruit_type_10 = 4
                config = Config.ItemData.data_get_data(self.actCfgInfo.loss_item_ten[1][1])
            end
            if config then
                local icon_res = PathTool.getItemRes(config.icon)
                loadSpriteTexture(self.icon_10, icon_res, LOADTEXT_TYPE)
                self.icon_10:setScale(0.30)
                if model_type == 1 then
                    if self.less_time ~= 0 then
                        self.count_11:setString(self.actCfgInfo.loss_item_once[1][2])
                        loadSpriteTexture(self.icon_11, icon_res, LOADTEXT_TYPE)
                        self.icon_11:setScale(0.30)
                    end
                elseif model_type == 10 then
                    self.count_10:setString(self.actCfgInfo.loss_item_ten[1][2])
                end
            end
        else --钻石抽取
            local config
            if model_type == 1 then
                self.recruit_type_1 = 3
                config = Config.ItemData.data_get_data(self.actCfgInfo.loss_gold_once[1][1])
            elseif model_type == 10 then
                self.recruit_type_10 = 3
                config = Config.ItemData.data_get_data(self.actCfgInfo.loss_gold_ten[1][1])
            end
            if config then
                local icon_res = PathTool.getItemRes(config.icon)
                loadSpriteTexture(self.icon_10, icon_res, LOADTEXT_TYPE)
                self.icon_10:setScale(0.30)
                if model_type == 1 then
                    if freeTime ~= 0 then
                        self.count_11:setString(self.actCfgInfo.loss_gold_once[1][2])
                        loadSpriteTexture(self.icon_11, icon_res, LOADTEXT_TYPE)
                        self.icon_11:setScale(0.30)
                    end
                elseif model_type == 10 then
                    self.count_10:setString(self.actCfgInfo.loss_gold_ten[1][2])
                end
            end
        end
        --单抽免费的时候
        if freeTime == 0 then
            self.recruit_type_1 = 1
        end
    end
end

function EliteOptionalPanel:setCountDownTime(less_time)
    if less_time == 0 then
        self.remain_time:setString(TI18N("语言_c_1057"))
        self.icon_11:setVisible(false)
        self.count_11:setVisible(false)
    else
        self.remain_time:setString("")
        self.icon_11:setVisible(true)
        self.count_11:setVisible(true)
    end    
end

function EliteOptionalPanel:register_event()

    if not self.update_elite_panel then
        self.update_elite_panel = GlobalEvent:getInstance():Bind(ActionEvent.UpdateElitePanel,function()
            self:setServerData()
        end)
    end
    if not self.update_elite_optional then
        self.update_elite_optional = GlobalEvent:getInstance():Bind(ActionEvent.ElitePanelOptional,function(data)
            if data.bid == self.holiday_bid then
                if Config.RecruitHolidayHeroData.data_summon[data.group_id] then
                    self.groupId = data.group_id
                else
                    self.groupId = 0
                end
                self:setData()
            end
        end)
    end
    --跳转夺宝商城
    registerButtonEventListener(self.add_btn, function()
        if not self.actCfgInfo then return end
        local action_controller = ActionController:getInstance()
        local tab_vo = action_controller:getActionSubTabVo(self.actCfgInfo.shop_id or ActionRankCommonType.trause_grade_shop)
        if tab_vo and action_controller.action_operate and action_controller.action_operate.tab_list[tab_vo.bid] then
            action_controller.action_operate:handleSelectedTab(action_controller.action_operate.tab_list[tab_vo.bid])
        else
            message(TI18N("语言_c_2604"))
        end
    end, true)

    registerButtonEventListener(self.act_icon, function()
        if not self.actCfgInfo then return end
        local action_controller = ActionController:getInstance()
        local tab_vo = action_controller:getActionSubTabVo(self.actCfgInfo.skip2_id or ActionRankCommonType.trause_grade_shop)
        if tab_vo and action_controller.action_operate and action_controller.action_operate.tab_list[tab_vo.bid] then
            action_controller.action_operate:handleSelectedTab(action_controller.action_operate.tab_list[tab_vo.bid])
        else
            message(TI18N("语言_c_2604"))
        end
    end, true)

    registerButtonEventListener(self.reward_btn, function(param,sender, event_type)
        if self.actId and self.groupId then
            local probabily_data = self.config.data_probability[self.groupId]
            local serverData = model:geteliteDataByBid(self.actId)
            local type = TimesummonConst.ActonInfoType.Elite
            TimesummonController:getInstance():openTimeSummonAwardView(true, self.groupId, serverData,type)
        end
    end, true)

    --商店
    registerButtonEventListener(self.btn_shop, function()
        self:onComfirmBtn() 
    end, true)
    --商店
    registerButtonEventListener(self.btn_go, function()
        self:onComfirmBtn() 
    end, true)
    --帮助说明
    registerButtonEventListener(self.btn_rule, function(param,sender, event_type)   
        local config = self.actCfgBaseInfo
        if config then
            TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition())
        end
    end, true,nil,nil,0.8)
    --单抽
    registerButtonEventListener(self.btn_summon_1, function()
        if self.recruit_type_1 then --钻石
            if self.recruit_type_1 == 3 then
                if self.actCfgBaseInfo and self.actCfgBaseInfo.camp_id then
                    self:RecruitDaimond(1)
                end
            else
                local cfg = Config.RecruitHolidayHeroData.data_chose_info[self.campid]
                if cfg and cfg[self.groupId] then
                    controller:sender23268(self.holiday_bid,1,self.recruit_type_1)
                else
                    message(TI18N("语言_c_6762"))
                end
            end
        end
    end, true)
    --十连抽
    registerButtonEventListener(self.btn_summon_10, function()
        if not self.touch_recruit_10 then
            message(TI18N("语言_c_4414"))
            return
        end
        if self.recruit_10_ticket == nil then
            self.recruit_10_ticket = GlobalTimeTicket:getInstance():add(function()
                self.touch_recruit_10 = true
                if self.recruit_10_ticket ~= nil then
                    GlobalTimeTicket:getInstance():remove(self.recruit_10_ticket)
                    self.recruit_10_ticket = nil
                end
            end,2)
        end
        self.touch_recruit_10 = nil
        if self.recruit_type_10 then
            if self.recruit_type_10 == 3 then
                self:RecruitDaimond(10)
            else
                local cfg = Config.RecruitHolidayHeroData.data_chose_info[self.campid]
                if cfg and cfg[self.groupId] then
                    controller:sender23268(self.holiday_bid,10,self.recruit_type_10)
                else
                    message(TI18N("语言_c_6762"))
                end
            end
        end
    end, true)

    --看录像
    registerButtonEventListener(self.video_btn, function()
		TimesummonController:getInstance():send23219(self.holiday_bid)
	end, true, 2, nil,nil, 2)
    registerButtonEventListener(self.box_add, function()
        controller:openEliteOptionalSelectWindow(true,self.campid,self.groupId,self.holiday_bid)
	end, true, 2)
    self.box_chose:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type, 1)
        if event_type == ccui.TouchEventType.ended then
            controller:openEliteOptionalSelectWindow(true,self.campid,self.groupId,self.holiday_bid)
        end
    end)
	-- 道具数量更新
    if not self.update_add_good_event then
        self.update_add_good_event = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS,function(bag_code, data_list)
            if self.updateItemNum then
                self:updateItemNum(bag_code,data_list)
            end
        end)
    end
    if not self.update_delete_good_event then
        self.update_delete_good_event = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS,function(bag_code, data_list)
            if self.updateItemNum then
                self:updateItemNum(bag_code,data_list)
            end
        end)
    end
    if not self.update_modify_good_event then
        self.update_modify_good_event = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM,function(bag_code, data_list)
            if self.updateItemNum then
                self:updateItemNum(bag_code,data_list)
            end
        end)
    end

    self:registerCheckBoxEvent(self.checkBox)

    if not self.eliteTips then
        self.eliteTips = GlobalEvent:getInstance():Bind(ActionEvent.ElitePanelTips ,function(data)
            if not data then
                return
            end
            if data.cur_day <= 2 then
                if data.is_pop == 1 then
                    controller:openEndWarnView(true, data.cur_day,TI18N("语言_c_5198"))
                end
            end
        end)
    end
end

--注册选项框事件
function EliteOptionalPanel:registerCheckBoxEvent(btn)
    if not btn then return end
	btn:addEventListener(function(sender,event_type)
	    if event_type == ccui.CheckBoxEventType.selected then
            playButtonSound2()
            NewPartnersummonController:getInstance():getModel():setignoreMp4(1)
	        btn:setSelected(true)
	    elseif event_type == ccui.CheckBoxEventType.unselected then 
            playButtonSound2()
            NewPartnersummonController:getInstance():getModel():setignoreMp4(0)
            btn:setSelected(false)
	    end
    end)
end

--前往兑换
function EliteOptionalPanel:onComfirmBtn()
    MallController:getInstance():openMallActionWindow(true, self.holiday_bid)
end

--用钻石招募的提示
function EliteOptionalPanel:RecruitDaimond(model)
    local config = self.actCfgBaseInfo
    if config then
        local role_vo = RoleController:getInstance():getRoleVo()
        if self.actCfgInfo then
            local data = self.actCfgInfo
            -- printLuaTable(data)
            local num
            if model == 1 then
                num = data.loss_gold_once[1][2]
            else
                num = data.loss_gold_ten[1][2]
            end
            if not num then return end

            local have_gold = role_vo.gold
            if have_gold < num then
                message(TI18N("语言_c_4415"))
                return
            end
            local str = string.format(TI18N("语言_c_3583"),PathTool.getItemRes(3),num,have_gold)
            local str_
            local val_num = 0
            if model == 1 then
                val_num = data.gain_once[1][2]
            elseif model == 10 then
                val_num = data.gain_ten[1][2]
            end
            str_ = str..string.format(TI18N("语言_c_4908"), model)
            local function call_back()
                local cfg = Config.RecruitHolidayHeroData.data_chose_info[self.campid]
                if cfg and cfg[self.groupId] then
                    local serverData = ActionController:getInstance():getModel():geteliteDataByBid(self.actId)
                    local num = serverData.times
                    local is_jump = false
                    if model == 1 then
                        is_jump = num+1 > self.actCfgInfo.times_limit
                    elseif model == 10 then
                        is_jump = num+10 > self.actCfgInfo.times_limit
                    end
                    if is_jump then
                        if not self.actCfgInfo then return end
                        local action_controller = ActionController:getInstance()
                        local tab_vo = action_controller:getActionSubTabVo(self.actCfgInfo.shop_id or ActionRankCommonType.trause_grade_shop)
                        if tab_vo and action_controller.action_operate and action_controller.action_operate.tab_list[tab_vo.bid] then
                            action_controller.action_operate:handleSelectedTab(action_controller.action_operate.tab_list[tab_vo.bid])
                        else
                            message(TI18N("语言_c_2604"))
                        end
                    else
                        controller:sender23268(self.holiday_bid,model,3)
                    end
                else
                    message(TI18N("语言_c_6762"))
                end
            end
            CommonAlert.show(str_, TI18N("语言_c_63"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich)
        end
    end
end

-- 刷新道具数量
function EliteOptionalPanel:updateItemNum(bag_code, data_list)
    if self.summon_item_bid then
        if bag_code and data_list then
            if bag_code == BackPackConst.Bag_Code.BACKPACK then
                for i,v in pairs(data_list) do
                    if v and v.base_id and self.summon_item_bid == v.base_id then
                        local summon_have_num = BackpackController:getInstance():getModel():getItemNumByBid(self.summon_item_bid)
                        if self.icon_count then
                            self.icon_count:setString(summon_have_num)
                        end
                        self:recruitBtnStatus(1)
                        self:recruitBtnStatus(10)
                        break
                    end
                end
            end
        end
    end
end
-- 设置奖励列表
function EliteOptionalPanel:setItemData()
    if not self.actCfgInfo then return end
    local reward_show = self.actCfgInfo.reward_prview
    for k,v in pairs(self.item_node_list) do
        v:setData(reward_show[v.index])
    end
end

--人物特效 展示立绘 模型不要了
function EliteOptionalPanel:showGuideEffect(status)
    if not self.actCfgInfo then return end
    local drawId = self.actCfgInfo.model
    local res_id = ""
    if drawId and drawId ~= "" then
        res_id = PathTool.getPlistImgForDownLoad("herodraw/herodrawres",drawId)
    else
        res_id = PathTool.getPlistImgForDownLoad("recruit_ninja","recruit_ninja_shadow_1")
    end
    self.item_load = createResourcesLoad(res_id, ResourcesType.single, function()
        if self.heroimg then
            loadSpriteTexture(self.heroimg, res_id, LOADTEXT_TYPE)
        end
        if self.actCfgInfo and self.actCfgInfo.move_pos and next(self.actCfgInfo.move_pos) then
            local _scale = self.actCfgInfo.move_pos[1][1]
            local _x = self.actCfgInfo.move_pos[1][2] + 345
            local _y = self.actCfgInfo.move_pos[1][3] + 301
            self.heroimg:setScale(_scale)
            self.heroimg:setPosition(cc.p(_x,_y))
        end
    end, self.item_load)
end


function EliteOptionalPanel:DeleteMe()
    self:showGuideEffect(false)
    doStopAllActions(self.remain_time)
    doStopAllActions(self.surplus_time)
    self.touch_recruit_10 = true --点击延迟
    self.is_can_award = false --是否有可领取的保底奖励
    self.recruit_type_1 = nil --单抽  3 是钻石 4 是道具 1是免费单抽
    self.recruit_type_10 = nil --10抽
    self.up_hero_id = 0
    if self.resources_load then
        self.resources_load:DeleteMe()
        self.resources_load = nil
    end
	if self.bg_load then
		self.bg_load:DeleteMe()
		self.bg_load = nil
	end
    for k,v in pairs(self.item_node_list) do
        v:removeFromParent()
        v=nil
    end
    if self.update_elite_panel then
        GlobalEvent:getInstance():UnBind(self.update_elite_panel)
        self.update_elite_panel = nil
    end
    if self.update_elite_optional then
        GlobalEvent:getInstance():UnBind(self.update_elite_optional)
        self.update_elite_optional = nil
    end
    if self.update_add_good_event then
        GlobalEvent:getInstance():UnBind(self.update_add_good_event)
        self.update_add_good_event = nil
    end
    if self.update_delete_good_event then
        GlobalEvent:getInstance():UnBind(self.update_delete_good_event)
        self.update_delete_good_event = nil
    end
    if self.update_modify_good_event then
        GlobalEvent:getInstance():UnBind(self.update_modify_good_event)
        self.update_modify_good_event = nil
    end
    if self.recruit_10_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.recruit_10_ticket)
        self.recruit_10_ticket = nil
    end
    if self.eliteTips then
        GlobalEvent:getInstance():UnBind(self.eliteTips)
        self.eliteTips = nil
    end
end