    if self.holiday_bid == ActionRankCommonType.elite_palance or self.holiday_bid == ActionRankCommonType.copyelite_palance1 then
        controller:sender23240()
    elseif self.holiday_bid == ActionRankCommonType.elite_skin or self.holiday_bid == ActionRankCommonType.elite_skin2 then
        controller:sender23242()
    elseif self.holiday_bid == ActionRankCommonType.copyelite_palance2 then
        controller:sender23250()
    elseif self.holiday_bid == ActionRankCommonType.copyelite_palance3 then
        controller:sender23260()
    elseif self.holiday_bid == ActionRankCommonType.copyelite_palance4 then
        controller:sender23262()
    else
