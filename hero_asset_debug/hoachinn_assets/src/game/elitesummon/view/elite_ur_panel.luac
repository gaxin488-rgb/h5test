local controller = ActionController:getInstance()
local model = controller:getModel()
local table_insert = table.insert
local table_remove = table.remove

EliteUrPanel = class("EliteUrPanel", function()
    return ccui.Widget:create()
end)

function EliteUrPanel:ctor(bid)
	self.holiday_bid = bid
	self.res_list = {
        -- { path = PathTool.getPlistImgForDownLoad("elitesummon","elitesummon"), type = ResourcesType.plist },
        -- { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("recruit_ninja","recruit_ninja"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("forgehouse","forgehouse"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("num","type22"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon_ur_01"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon_ur_02"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon_ur_03"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon_ur_04"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("selectelitesummon","selectelitesummon_ur_05"), type = ResourcesType.single },
    } 
    
    if self.holiday_bid == ActionRankCommonType.elite_palance or self.holiday_bid == ActionRankCommonType.copyelite_palance1 or self.holiday_bid == ActionRankCommonType.copyelite_palance2 or self.holiday_bid == ActionRankCommonType.copyelite_palance3 or self.holiday_bid == ActionRankCommonType.copyelite_palance4
    or self.holiday_bid == ActionRankCommonType.copyelite_palance5 or self.holiday_bid == ActionRankCommonType.copyelite_palance6
    or self.holiday_bid == ActionRankCommonType.copyelite_palance7 or self.holiday_bid == ActionRankCommonType.copyelite_palance8 or self.holiday_bid == ActionRankCommonType.copyelite_palance9 or self.holiday_bid == ActionRankCommonType.copyelite_palance10 
    or self.holiday_bid == ActionRankCommonType.copyelite_palance11 or self.holiday_bid == ActionRankCommonType.copyelite_palance12
    or self.holiday_bid == ActionRankCommonType.copyelite_palance13 or self.holiday_bid == ActionRankCommonType.copyelite_palance14
    or self.holiday_bid == ActionRankCommonType.copyelite_palance15 or self.holiday_bid == ActionRankCommonType.copyelite_palance16
    or self.holiday_bid == ActionRankCommonType.copyelite_palance17 or self.holiday_bid == ActionRankCommonType.copyelite_palance18
    or self.holiday_bid == ActionRankCommonType.copyelite_palance19 or self.holiday_bid == ActionRankCommonType.copyelite_palance20 then
        self.config = Config.RecruitHolidayHeroData
    elseif self.holiday_bid == ActionRankCommonType.elite_skin or self.holiday_bid == ActionRankCommonType.elite_skin2 then 
        self.config = Config.RecruitHolidaySkinData
    else
        send_error_to_pf("ElitePanel_noconfig_bid" .. tostring(self.holiday_bid))
    end
    
    self.touch_recruit_10 = true --点击延迟
    self.is_can_award = false --是否有可领取的保底奖励
    self.recruit_type_1 = nil --单抽  3 是钻石 4 是道具 1是免费单抽
    self.recruit_type_10 = nil --10抽
    self.isEnd = 0 --活动是否结束
    self.resources_load = ResourcesLoad.New(true)
    self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
        	self:loadResListCompleted()
        end
    end)
    -- ActionController:getInstance():sender16808(ActionStorageBool.SpElitePanel)
end
-- 资源加载完成
function EliteUrPanel:loadResListCompleted()
	self:configUI()
	self:register_event()
end

