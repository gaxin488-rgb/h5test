    self.btn_rule = main_container:getChildByName("btn_rule")
    --奖励详情
    self.reward_btn = main_container:getChildByName("reward_btn")
    local label = self.reward_btn:getChildByName("label")
    label:setChangeScaleOffWidth(-9999)
    label:setString(TI18N("语言_c_21"))
    setTextMaxWidth(label,100,-10)
    --忍者详情
    self.btn_look = main_container:getChildByName("btn_look")
    local label = self.btn_look:getChildByName("label")
    label:setChangeScaleOffWidth(-9999)
    label:setString(TI18N("语言_c_1267"))
    setTextMaxWidth(label,100,-10)
    self.add_btn = main_container:getChildByName("add_btn")
    self.icon = main_container:getChildByName("icon")
    self.icon_count = main_container:getChildByName("icon_count")
