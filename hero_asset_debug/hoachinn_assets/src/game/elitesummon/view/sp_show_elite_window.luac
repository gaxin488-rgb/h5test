SpShowEliteWindow = SpShowEliteWindow or BaseClass(BaseView)
local table_insert = table.insert
local _controller = EliteSummonController:getInstance()
local action_controller = ActionController:getInstance()
local model = action_controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()
function SpShowEliteWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "elitesummon/sp_show_elite_window"
    -- self.res_list = {
    --     { path = PathTool.getPlistImgForDownLoad("actioneightlogin", "actioneightlogin"), type = ResourcesType.plist },
    --     { path = PathTool.getPlistImgForDownLoad("hero", "hero"), type = ResourcesType.plist}
    -- }
    self.skill_item_list = {}
end

function SpShowEliteWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_panel = self.main_container:getChildByName("main_panel")
    self.model_icon = self.main_panel:getChildByName("model_icon")
    self.model_icon:ignoreContentAdaptWithSize(true)
    self.title_2 = self.main_panel:getChildByName("title_2")
    self.container = self.main_panel:getChildByName("container")
    self.skill_container = self.container:getChildByName("skill_container")
    self.desc_txt = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(0,0),nil,nil,418)
    self.skill_container:addChild(self.desc_txt)
    self.skill_container:setScrollBarEnabled(false)
    self.close_btn = self.main_panel:getChildByName("close_btn")
end
-- type 1活动2常驻抽奖
function SpShowEliteWindow:openRootWnd(bid,type)
    self.holiday_bid = bid
    self.type = type
    if self.type == 1 then
        self.tab_vo = action_controller:getActionSubTabVo(bid)
        local config = Config.RecruitHolidayHeroData.data_action[self.tab_vo.camp_id]
        if config then
            self.cfg = config.flash_show[1]
        end
        if self.cfg and next(self.cfg) then
            self.desc_txt:setString(self.cfg[2])
            

            self.model_icon:loadTexture(PathTool.getTargetRes("ninjacontract",self.cfg[3],false),LOADTEXT_TYPE)
            self.model_icon:setScale(self.cfg[5])
            -- self.model_icon:setPosition(cc.p(self.cfg[5],self.cfg[6]))
        end
        loadSpriteTexture(self.title_2,PathTool.getResFrame("recruit_ninja", self.cfg[4]),LOADTEXT_TYPE_PLIST)
    elseif self.type == 2 then
        self.desc_txt:setString(TI18N("语言_c_6859"))
        loadSpriteTexture(self.title_2,PathTool.getResFrame("newpartnersummon", "txt_cn_newpartnersummon_5"),LOADTEXT_TYPE_PLIST)
        if self.holiday_bid and self.holiday_bid ~= 0 then
            local vo = deepCopy(Config.ItemData.data_get_data(self.holiday_bid))
            local item_id = vo.effect[1].val[1]
            local item_cfg = Config.PartnerData.data_partner_base[item_id]
            self.model_icon:loadTexture(PathTool.getPlistImgForDownLoad("ninjacontract","ninjacontract_"..item_cfg.bid, false),LOADTEXT_TYPE)
        else
            local txt = Config.RecruitData.data_partnersummon_const["hint_summon"].val
            self.model_icon:loadTexture(PathTool.getPlistImgForDownLoad("ninjacontract",txt, false),LOADTEXT_TYPE)
        end
    end
    local _h = math.max(self.desc_txt:getContentSize().height,self.skill_container:getContentSize().height)
    self.skill_container:setInnerContainerSize(cc.size(self.skill_container:getContentSize().width,_h))
    self.desc_txt:setPositionY(_h)
end
function SpShowEliteWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        _controller:openSpShowEliteWindow(false)
        if self.type == 1 then
            ActionController:getInstance():sender16809(ActionStorageBool.SpElitePanel,1,"")
        else
            ActionController:getInstance():sender16809(ActionStorageBool.SpSummon,1,"")
        end
    end, true, 2)
    registerButtonEventListener(self.background, function()
        _controller:openSpShowEliteWindow(false)
        if self.type == 1 then
            ActionController:getInstance():sender16809(ActionStorageBool.SpElitePanel,1,"")
        else
            ActionController:getInstance():sender16809(ActionStorageBool.SpSummon,1,"")
        end
    end, false, 2)
end


function SpShowEliteWindow:close_callback()
    _controller:openSpShowEliteWindow(false)
    if self.type == 1 then
        ActionController:getInstance():sender16809(ActionStorageBool.SpElitePanel,1,"")
    else
        ActionController:getInstance():sender16809(ActionStorageBool.SpSummon,1,"")
    end
end

