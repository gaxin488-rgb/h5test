function NewHeroOrderWindow:register_event()
    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_Init_Event,
        function(data)
            local cfg = Config.HolidayNewWarOrderData.data_lev_reward_list
            local index = self.page_index or data.order_id
            if cfg[data.period] and cfg[data.period][1] and cfg[data.period][1]["id"..index] and cfg[data.period][1]["id"..index] ~= 0 then
                self:tabChargeView(index, data.period)
            else
                self:tabChargeView(1, data.period)
            end
            self:initAwardConfig()
            self:setBookmarkNum()
            self:setBasicInitData()
            self:updateConfirmPanel()
            self:updateTabView()
            local time = data.end_time - GameNet:getInstance():getTime()
            controll_action:getModel():setCountDownTime(self.time_text, time)
            local _w = self.time_title:getContentSize().width + self.time_text:getContentSize().width + 10
            self.time_title:setPositionX(360-_w*0.5)
            setItemXOneByOne({self.time_title,self.time_text})
            local card_list = Config.HolidayNewWarOrderData.data_advance_card_list
            local charge_list = Config.ChargeData.data_charge_data
            local period = model:getCurPeriod()
            local _id = model:getChooseId()
            if _id ~= 0 then
                local order_id = 0
                if cfg and cfg[period] and cfg[period][1] and cfg[period][1]["id".._id] then
                    order_id = cfg[period][1]["id".._id]
                end
                local charge_id = card_list[period][order_id].charge_id or nil
                if charge_id and charge_list and charge_list[charge_id] then
                    self.btn_open_lock_label:setString(string.format(TI18N("语言_c_4440"),GetMoneyNum(charge_list[charge_id],"val"))..TI18N("语言_c_2680"))
                end
            end
        end
    )

    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_IsPopWarn_Event,
        function(data)
            if data then
                local totle_day = 30
                if (totle_day - data.cur_day) == 7 or (totle_day - data.cur_day) <= 3 then
                    if data.is_pop == 1 then
                        controller:openEndWarnView(true, data.cur_day)
                    end
                end
            end
        end
    )
    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_Updata_LevExp_Event,
        function(data)
            self:setBasicInitData()
            model:setRewardLevRedPoint()
        end
    )
    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_LevReward_Event,
        function()
            self:setBasicInitData()
        end
    )
    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_BuyGiftCard_Event,
        function()
            if not self.is_canUpdate then
                self.is_canUpdate = true
            end
            self:setBasicInitData()
        end
    )

    for i, v in pairs(self.tab_view) do
        registerButtonEventListener(
            v.btn_tab_view,
            function()
                local day = model:getCurDay()
                local period = model:getCurPeriod()
                self:tabChargeView(v.index, period)
                if next(self.reward_list) ~= nil then
                    self.reward_goods_item:reloadData()
                end
            end,
            false,
            3
        )
    end

    registerButtonEventListener(
        self.btn_open_lock,
        function()
            if not self.is_canUpdate then return end
            controller:openBuyCardNewView(true)
        end,
        true,
        1
    )

    registerButtonEventListener(self.go_week,function()
            TaskController:getInstance():openTaskMainWindow(true,TaskConst.type.week)
        end,true,1
    )

    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openNewHeroOrderWindow(false)
        end,
        true,
        2
    )

    registerButtonEventListener(
        self.btn_rule,
        function(param, sender, event_type)
            local config = Config.HolidayNewWarOrderData.data_constant
            if config then
                local config_desc = config.action_rule
                TipsManager:getInstance():showCommonTips(config_desc.desc, sender:getTouchBeganPosition(), nil, nil, 500)
            end
        end,
        false,
        1
    )
    registerButtonEventListener(self.confirm_btn,function()
        if not self.is_canUpdate then return end
        local str = TI18N("语言_c_5487")
            CommonAlert.show( str, TI18N("语言_c_63"), function()
                controller:send28709(self.cur_index)
            end, TI18N("语言_c_62"),nil,nil,nil,{timer=5, timer_for=true, off_y = 10, title = TI18N("语言_c_5488"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
    end,true,1)
end

function NewHeroOrderWindow:tabChargeView(index, period)
    index = index or 1
    if self.cur_index == index then
        return
    end
    self.cur_index = index
    self:tabHeadTitle(index)
    local cur_period = model.cur_period or 0 -- 周期
    local level = model:getexp()
    local list = {}
    local cfg = Config.HolidayNewWarOrderData.data_lev_reward_list[cur_period]
    if index ~= 0 then
        local str = ""
        if index == 1 then
            str = "rmb_reward"
        elseif index == 2 then
            str = "rmb_reward_2"
        elseif index == 3 then
            str = "rmb_reward_3"
        elseif index == 4 then
            str = "rmb_reward_4"
        end
        for key, value in pairs(cfg) do
            for k, v in pairs(value[""..str]) do
                table.insert(list,v)
            end
        end
    end
    local data_list = model:getrewardList(list)
    local setting = {}
    setting.scale = 0.7
    setting.max_count = 4
    setting.is_center = true
    self.item_list2 = commonShowSingleRowItemList(self.order_scroll, self.item_list2, data_list, setting)
end

function NewHeroOrderWindow:createTaskView(period)
    if self.task_view == nil then
        local pos_x, pos_y = self.goods_item:getPosition()
        self.task_view = NewOrderActionTaskPanel.new(period)
        self.task_view:setPosition(cc.p(pos_x, pos_y))
        self.main_container:addChild(self.task_view)
        self.task_view:setVisibleStatus(false)
    end
end

function NewHeroOrderWindow:tabHeadTitle(index)
    if self.cur_herd_title ~= nil then
        self.cur_herd_title.select:setVisible(false)
        self.cur_herd_title.normal:setScale(1)
        -- self.cur_herd_title.name:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
    end
    self.cur_herd_title = self.tab_view[index]
    if self.cur_herd_title ~= nil then
        self.cur_herd_title.select:setVisible(true)
        self.cur_herd_title.normal:setScale(1.2)
        -- self.cur_herd_title.name:setTextColor(cc.c4b(0xff, 0xed, 0xd6, 0xff))
    end
end

--奖励列表
function NewHeroOrderWindow:createTaskCell()
    local cell = NewOrderActiodRewardItem3.new()
    return cell
end

function NewHeroOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function NewHeroOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    local id = model:getChooseId()
    if id == 0 then
        id = self.cur_index
    end
    -- cell:setLocalZOrder(#self.reward_list - index)
    cell:setLocalZOrder(index + 1)
    cell:setData(cell_data,id,index)
end

function NewHeroOrderWindow:updateIconImg(status)
    if tolua.isnull(self.icon_img) or tolua.isnull(self.btn_open_lock) then
        return
    end
    loadSpriteTexture(self.icon_img, PathTool.getResFrame("neworderaction", "neworderaction_1"), LOADTEXT_TYPE_PLIST)

    if status == 1 then
        setChildUnEnabled(false, self.icon_img)
        self.open_tip:setVisible(true)
        self.tip_panel:setVisible(false)
        self.goods_item:setContentSize(cc.size(698,792 + self.add_y))
        self.goods_line_item:setContentSize(cc.size(698,792 + self.add_y))
    else
        setChildUnEnabled(true, self.icon_img)
        self.open_tip:setVisible(false)
        self.tip_panel:setVisible(true)
        self.goods_item:setContentSize(cc.size(698,680 + self.add_y))
        self.goods_line_item:setContentSize(cc.size(698,680 + self.add_y))
    end

    if status ~= 1 and model:getChooseId() ~= nil and model:getChooseId() > 0 then
        self.btn_open_lock:setVisible(true)
    else
        self.btn_open_lock:setVisible(false)
        controller:openBuyCardNewView(false)
    end
    self:updateScroll()
end

function NewHeroOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / ((len-0.5) * 119 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.7, true)
end

--当等级变化的时候
function NewHeroOrderWindow:setChangeLevelStatus(cur_lev)
    local cur_period = model:getCurPeriod()
    local jump_num
    if lev_reward_list and lev_reward_list[cur_period] then
        self.reward_list = {}
        for i, v in pairs(lev_reward_list[cur_period]) do
            v.cur_lev = cur_lev
            v.status = 0
            v.rmb_status = 0
            v.is_locak = model:getGiftStatus()
            local lev_list = model:getLevShowData(v.lev)
            if lev_list then
                v.status = lev_list.status
                v.rmb_status = lev_list.rmb_status
            end
            if cur_lev >= v.lev and (v.status == 0 or (v.rmb_status == 0 and v.is_locak == 1)) and (jump_num == nil or v.lev < jump_num) then
                jump_num = v.lev
            end
            table_insert(self.reward_list, v)
        end
        if next(self.reward_list) == nil then
            self.reward_goods_item:reloadData()
        else
            table_sort(
                self.reward_list,
                function(a, b)
                    return a.lev < b.lev
                end
            )
            self.reward_goods_item:reloadData()
        end

        if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and self.bar_layout and not tolua.isnull(self.bar_layout) then
            local len = #self.reward_list or 1
            self.comp_bar_bg:setContentSize(cc.size(119 * (len - 1), 27))
            self.comp_bar:setContentSize(cc.size(119 * (len - 1), 15))
            self.bar_layout:setPosition(cc.p(50, 119 * (len - 1) + 119 / 2))
        end
    end
    local title_pos = jump_num or cur_lev
    if title_pos > 1 then
        local len = #self.reward_list or 1
        if title_pos + 2 >= len then
            title_pos = len + 1
        end
        self:jumpToMoveByY(119 * (title_pos - 1))
    end
end

--设置数据
function NewHeroOrderWindow:setBasicInitData()
    if not self.is_canUpdate then return end
    --当前等级
    local lev_num = model:getCurLev() or 0
    local exp = model:getCurExp() or 0
    local cur_period = model:getCurPeriod()
    local rmb_status = model:getRMBStatus()
    if self.medal_num and not tolua.isnull(self.medal_num) then
        self.medal_num:setString(exp)
        local _w = self.medal_title:getContentSize().width + self.medal_num:getContentSize().width + 10
        self.medal_title:setPositionX(360-_w*0.5)
        setItemXOneByOne({self.medal_title,self.medal_num})
        local image_w = math.max(_w+20,212)
        self.Image_1:setContentSize(cc.size(image_w,self.Image_1:getContentSize().height))
    end
    self:updateIconImg(rmb_status)
    self:setChangeLevelStatus(lev_num)
end

function NewHeroOrderWindow:setBookmarkNum()
    local num = 0
    if self.temp_reward_list then
        if #self.temp_reward_list[1].reward ~= 0 and #self.temp_reward_list[1].rmb_reward ~= 0 then
            num = num + 1
        end
        if #self.temp_reward_list[1].reward_2 ~= 0 and #self.temp_reward_list[1].rmb_reward_2 ~= 0 then
            num = num + 1
        end
        if #self.temp_reward_list[1].reward_3 ~= 0 and #self.temp_reward_list[1].rmb_reward_3 ~= 0 then
            num = num + 1
        end
        if self.temp_reward_list[1].reward_4 and #self.temp_reward_list[1].reward_4 ~= 0 and #self.temp_reward_list[1].rmb_reward_4 ~= 0 then
            num = num + 1
        end
    end
    self:setPanelSize()
    local chooseId = model:getChooseId()
    if chooseId and chooseId > 0 then
        for key, value in pairs(self.tab_view) do
            value.btn_tab_view:setVisible(false)
        end
    else
        for key, value in pairs(self.tab_view) do
            if key > num then
                value.btn_tab_view:setVisible(false)
            else
                value.btn_tab_view:setVisible(true)
            end
        end
    end
end

function NewHeroOrderWindow:updateTabView()
    local cur_period = model:getCurPeriod()
    local cfg = Config.HolidayNewWarOrderData.data_period_list[cur_period]
    for i=1,#cfg.tab_style do
        self.tab_view[i].name:setString(cfg.tab_style[i][1])
        local res = PathTool.getResFrame("neworderaction", "neworderaction_tab_"..cfg.tab_style[i][2])
        self.tab_view[i].normal:loadTexture(res, LOADTEXT_TYPE_PLIST)
    end
end

function NewHeroOrderWindow:updateConfirmPanel()
    if not model:getChooseId() or model:getChooseId() == 0 then
        self.confirm_panel:setVisible(true)
    else
        self.confirm_panel:setVisible(false)
    end
end

function NewHeroOrderWindow:initAwardConfig()
    local temp_reward_list = Config.HolidayNewWarOrderData.data_lev_reward_list
    local cur_period = model:getCurPeriod()
    local period_lev = model:getPeriodLev()
    lev_reward_list[cur_period] = {}
    if temp_reward_list and temp_reward_list[cur_period] then
        for k, v in ipairs(temp_reward_list[cur_period]) do
            if period_lev >= v.min_lev and period_lev <= v.max_lev then
                table_insert(lev_reward_list[cur_period], v)
            end
        end
    end
    self.temp_reward_list = temp_reward_list[cur_period]
end

function NewHeroOrderWindow:openRootWnd(page_index)
    self.page_index = page_index
    controller:send28700()
    controller:send28707()
    controller:send28703()
    controller:send28706()
end

function NewHeroOrderWindow:close_callback()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end

    if self.task_view and self.task_view["DeleteMe"] then
        self.task_view:DeleteMe()
        self.task_view = nil
    end
	if self.player_info_panel then
		self.player_info_panel:DeleteMe()
		self.player_info_panel = nil
	end

    controller:openNewHeroOrderWindow(false)
end

