NewHeroOrderWindow = NewHeroOrderWindow or BaseClass(BaseView)

local controller = NeworderactionController:getInstance()
local model = controller:getModel()
local controll_action = ActionController:getInstance()
-- local lev_reward_list = Config.HolidayNewWarOrderData.data_lev_reward_list
local lev_reward_list = {}
local table_sort = table.sort
local table_insert = table.insert
function NewHeroOrderWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "neworderaction/new_hero_order_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("neworderaction", "neworderaction"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("bigbg", "bigbg_11", true), type = ResourcesType.single}
    }

    self.reward_list = {}
    self.cur_index = nil
    self.tab_view = {}
    self.is_canUpdate = false

    model:setNeworderactionLoginRed(false)
end

function NewHeroOrderWindow:open_callback()
    model:setPeriodRed(false)
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    if self.background ~= nil then
        self.background:loadTexture(PathTool.getPlistImgForDownLoad("bigbg", "bigbg_11", true), LOADTEXT_TYPE)
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container_size = self.main_container:getContentSize()
    self.bottom_bg = self.main_container:getChildByName("bottom_bg")
    self:playEnterAnimatianByObj(self.main_container , 1) 

    -- 标签
    self.tab_view_panel = self.main_container:getChildByName("tab_view")
    local title_name = {TI18N("语言_c_5483"), TI18N("语言_c_5484"), TI18N("语言_c_5485")}
    for i = 1, 4 do
        local tab = {}
        tab.btn_tab_view = self.tab_view_panel:getChildByName("tab_" .. i)
        tab.btn_tab_view:setVisible(false)
        tab.normal = tab.btn_tab_view:getChildByName("normal")
        tab.select = tab.btn_tab_view:getChildByName("select")
        tab.select:setVisible(false)
        tab.name = tab.btn_tab_view:getChildByName("name")
        tab.name:setChangeScaleOffWidth(-9999)
        setTextMaxWidth(tab.name,100,-10)
        tab.name:setString(title_name[i])
        tab.index = i
        self.tab_view[i] = tab
    end

    self.open_tip = self.main_container:getChildByName("open_tip")
    self.open_tip:setString(TI18N("语言_c_7352"))
    --解锁奖励总览
    self.btn_open_lock = self.main_container:getChildByName("btn_open_lock")
    self.btn_open_lock_label = self.btn_open_lock:getChildByName("name")
    self.btn_open_lock_label:setString(TI18N("语言_c_2680"))
    setTextMaxWidth(self.btn_open_lock_label,260,-10)

    --活动时间与领取
    self.time_title = self.main_container:getChildByName("time_title")
    self.time_title:setString(TI18N("语言_c_2681"))
    self.time_text = self.main_container:getChildByName("time_text")
    self.time_text:setString("")

    self.btn_rule = self.main_container:getChildByName("btn_rule")
    self.scroll_bg = self.main_container:getChildByName("scroll_bg")
    self.free_bg = self.main_container:getChildByName("free_bg")
    self.free_txt = self.main_container:getChildByName("free_txt")
    self.free_txt:setString(TI18N("语言_c_6434"))
    self.order_bg = self.main_container:getChildByName("order_bg")
    self.btn_close = self.main_container:getChildByName("btn_close")

    self.medal_title = self.main_container:getChildByName("medal_title")
    self.medal_title:setString(TI18N("语言_c_2682"))
    self.medal_num = self.main_container:getChildByName("medal_num")
    self.medal_num:setString("")

    self.icon_img = self.main_container:getChildByName("icon_img")

    self.Image_1 = self.main_container:getChildByName("Image_1")
    self.Image_2 = self.main_container:getChildByName("Image_2")
    self.Image_4 = self.main_container:getChildByName("Image_4")
    self.Text_33 = self.main_container:getChildByName("Text_33")
    self.Text_33:setString(transformTextToShort(TI18N("语言_c_2683"),60))
    addEvt2showAllTextTips(self.Text_33,TI18N("语言_c_2683"),60,600)
    
    self.go_week = self.main_container:getChildByName("go_week")
    local name = self.go_week:getChildByName("name")
    name:setString(TI18N("语言_c_4590"))
    setTextMaxWidth(name,100,-10)
    
    self.goods_item = self.main_container:getChildByName("goods_item")
    self.goods_line_item = self.main_container:getChildByName("goods_line_item")
    self.order_line_bg = self.main_container:getChildByName("order_line_bg")
    self.tip_panel = self.main_container:getChildByName("tip_panel")
    self.order_title = self.tip_panel:getChildByName("order_title")
    self.order_title:setString(TI18N("语言_c_7351"))
	setTextMaxWidth(self.order_title,200,-10)
    self.order_scroll = self.tip_panel:getChildByName("order_scroll")
    self.order_scroll:setScrollBarEnabled(false)
    self.confirm_panel = self.main_container:getChildByName("confirm_panel")
    self.confirm_btn = self.confirm_panel:getChildByName("confirm_btn")
    self.confirm_txt = self.confirm_btn:getChildByName("confirm_txt")
    self.confirm_txt:setString(TI18N("语言_c_5486"))
    self.confirm_tip = createRichLabel(26,cc.c3b(0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(360,50),-6,nil,500)
    self.confirm_panel:addChild(self.confirm_tip)
    self.confirm_tip:setHorizontalLayoutType(2)
    self.confirm_tip:setString(TI18N("语言_c_7353"))
    self.player_info_panel = PlayerInfoPanel.new()
   	self.main_container:addChild(self.player_info_panel)
    local top_y = display.getTop(self.main_container)
    self.player_info_panel:setPositionY(top_y)
    self:setPanelSize()
    local period = model:getCurPeriod()
    self:createTaskView(period)
    self:adaptationScreen()
end
function NewHeroOrderWindow:updateScroll()

    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.comp_bar then
        self.comp_bar = nil
    end
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 698, -- 单元的尺寸width
        item_height = 119, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true,
        -- checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)

    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell), ScrollViewFuncType.CreateNewCell) --创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells), ScrollViewFuncType.NumberOfCells) --获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
end
function NewHeroOrderWindow:setPanelSize()
    local order_id = model:getChooseId()
    if order_id and order_id > 0 then
        self.btn_open_lock:setVisible(true)
        self.open_tip:setVisible(false)
    else
        self.btn_open_lock:setVisible(false)
        self.open_tip:setVisible(false)
        controller:openBuyCardNewView(false)
    end
    self:updateScroll()
end

--设置适配屏幕
function NewHeroOrderWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)

    local add_y = (top_y-bottom_y - self.main_container_size.height)*0.5
    self.add_y = add_y*2

    local tab_y = self.btn_rule:getPositionY()
    self.btn_rule:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.go_week:getPositionY()
    self.go_week:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.Image_4:getPositionY()
    self.Image_4:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.Text_33:getPositionY()
    self.Text_33:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.Image_1:getPositionY()
    self.Image_1:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.medal_num:getPositionY()
    self.medal_num:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.medal_title:getPositionY()
    self.medal_title:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.icon_img:getPositionY()
    self.icon_img:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.Image_2:getPositionY()
    self.Image_2:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.time_text:getPositionY()
    self.time_text:setPositionY(top_y - (self.main_container_size.height - tab_y))
    local tab_y = self.time_title:getPositionY()
    self.time_title:setPositionY(top_y - (self.main_container_size.height - tab_y))

    local tab_y = self.free_bg:getPositionY()
    self.free_bg:setPositionY(tab_y + add_y)
    local tab_y = self.free_txt:getPositionY()
    self.free_txt:setPositionY(tab_y + add_y)
    local tab_y = self.order_bg:getPositionY()
    self.order_bg:setPositionY(tab_y + add_y)
    local tab_y = self.goods_item:getPositionY()
    self.goods_item:setPositionY(tab_y + add_y)
    local tab_y = self.order_line_bg:getPositionY()
    self.order_line_bg:setPositionY(tab_y + add_y)
    local tab_y = self.goods_line_item:getPositionY()
    self.goods_line_item:setPositionY(tab_y + add_y)
    local tab_y = self.scroll_bg:getPositionY()
    self.scroll_bg:setPositionY(tab_y + add_y)
    self.order_line_bg:setContentSize(cc.size(88,680+self.add_y))
    self.scroll_bg:setContentSize(cc.size(741,858+self.add_y))



    local close_btn_y = self.bottom_bg:getPositionY()
    self.bottom_bg:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.btn_close:getPositionY()
    self.btn_close:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.btn_open_lock:getPositionY()
    self.btn_open_lock:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.open_tip:getPositionY()
    self.open_tip:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.tab_view_panel:getPositionY()
    self.tab_view_panel:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.tip_panel:getPositionY()
    self.tip_panel:setPositionY(bottom_y + close_btn_y)
