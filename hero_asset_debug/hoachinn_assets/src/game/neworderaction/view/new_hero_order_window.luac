-- 奖励子项
NewOrderActiodRewardItem3 =
    class(
    "NewOrderActiodRewardItem3",
    function()
        return ccui.Widget:create()
    end
)

function NewOrderActiodRewardItem3:ctor()
    self:configUI()
    self:register_event()
end

function NewOrderActiodRewardItem3:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("neworderaction/neworderaction_reward_item2"))
    self:setContentSize(cc.size(698, 119))
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.goods_item = main_container:getChildByName("goods_item")
    self.goods_item:setScrollBarEnabled(false)
    self.finish_img = main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_name = self.btn_get:getChildByName("name")
    self.btn_name:setString("")
    self.btn_choose = main_container:getChildByName("btn_choose")
    if self.btn_choose then
        self.btn_choose:setVisible(false)
        self.btn_choose_name = self.btn_choose:getChildByName("name")
        self.btn_choose_name:setString(TI18N("语言_c_5486"))
    end
    self.common_goods_item = BackPackItem.new(nil, true, nil, 0.7, nil, true)
    main_container:addChild(self.common_goods_item)
    self.common_goods_item:setPosition(cc.p(100, 119 / 2))
    local size = cc.size(60, 27)
    local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
    local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
    local bar_layout = ccui.Layout:create()
    bar_layout:setContentSize(cc.size(27, 27))
    bar_layout:setAnchorPoint(cc.p(0, 0))
    bar_layout:setPosition(cc.p(243, 144))
    bar_layout:setRotation(90)
    if bar_layout then
        main_container:addChild(bar_layout)
        -- bar_layout:setLocalZOrder(1)
        self.bar_layout = bar_layout
        self.bar_layout:setName("bar_layout")
    end

    local bg, comp_bar = createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true)

    self.comp_bar_bg = bg
    self.comp_bar = comp_bar
    self.comp_bar:setPercent(0)

    self.order_item = NewOrderActiodRewardItem2.new()
    main_container:addChild(self.order_item)
    self.order_item:setPosition(cc.p(243,62))
end

function NewOrderActiodRewardItem3:register_event()
    registerButtonEventListener(
        self.btn_get,
        function()
            if self.data then
                if self.data.cur_lev < self.data.lev or not model:getChooseId() or model:getChooseId() == 0 then--不可领取
                    TaskController:getInstance():openTaskMainWindow(true,TaskConst.type.week)
                else
                    if self.data.status == 0 or (self.data.rmb_status == 0 and self.data.is_locak == 1) then
                        controller:send28704(self.data.lev)
                    elseif self.data.status == 1 and self.data.rmb_status == 1 then
                        message(TI18N("语言_c_2523"))
                    else
                        controller:openBuyCardNewView(true)
                    end
                end
            end
        end,
        true,
        1
    )
end

function NewOrderActiodRewardItem3:setData(data,cur_index,index)
    if not data then
        return
    end
    self.data = data
    if index == 1 then
        self.comp_bar_bg:setVisible(false)
        self.comp_bar:setVisible(false)
    else
        self.comp_bar_bg:setVisible(true)
        self.comp_bar:setVisible(true)
        local last_cfg = Config.HolidayNewWarOrderData.data_lev_reward_list[data.period][data.lev-1]
        if last_cfg then
            local have_exp = model:getCurExp() - last_cfg.exp
            if have_exp <= 0 then
                self.comp_bar:setPercent(0)
            else
                local need_exp = self.data.exp - last_cfg.exp
                if have_exp >= need_exp then
                    self.comp_bar:setPercent(100)
                else
                    self.comp_bar:setPercent(have_exp / need_exp * 100)
                end
            end
        end
    end

    self.cur_index = cur_index or 0
    self.order_item:setData(data)
    local common = true
    if self.common_goods_item and not tolua.isnull(self.common_goods_item) then
        local list = {}
        if self.cur_index > 1 then
            list = data["reward_"..self.cur_index]
        else
            list = data.reward
        end
        if list and list[1] then
            self.common_goods_item:setBaseData(list[1][1], list[1][2])
            self.common_goods_item:setVisible(true)
        else
            self.common_goods_item:setVisible(false)
        end

        --领取状态
        if data.status == 1 then
            self.common_goods_item:IsGetStatus(true, nil, PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1"))
        else
            self.common_goods_item:IsGetStatus(false)
        end
    end

    local is_locak_status = true
    if model:getRMBStatus() == 1 then
        is_locak_status = false
    else
        is_locak_status = true
    end
    if data.cur_lev >= data.lev then
        common = false
    else
        common = true
    end
    if common == false then
        if data.status == 1 then
            self.common_goods_item:showItemEffect(false)
        else
            self.common_goods_item:showItemEffect(true, 263, PlayerAction.action_1, true, 1.1)
        end
    else
        self.common_goods_item:showItemEffect(false)
    end

    --进阶奖励
    local advance = true
    local effect_id
    if model:getGiftStatus() == 1 then
        if data.rmb_status == 0 then
            if data.cur_lev >= data.lev then
                advance = false
            end
        end
    end
    if advance == false then
        effect_id = 263
    end

    local is_get_status = false
    if data.rmb_status == 1 then
        is_get_status = true
    end

    local data_list = data.rmb_reward or {}
    if self.cur_index > 1 then
        data_list = data["rmb_reward_"..self.cur_index] or {}
    end
    local setting = {}
    setting.start_x = 10
    setting.scale = 0.7
    setting.max_count = 2
    setting.lock = is_locak_status
    setting.is_tip = true
    setting.show_effect_id = effect_id
    setting.is_get_status = is_get_status
    setting.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.item_list = commonShowSingleRowItemList(self.goods_item, self.item_list, data_list, setting)
    if self.btn_get then
        addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
        if data.cur_lev < data.lev or not model:getChooseId() or model:getChooseId() == 0 then--不可领取
            self.btn_name:setString(TI18N("语言_c_7"))
            self.btn_name:setTextColor(cc.c3b(0xff,0xff,0xff))
			self.btn_name:enableOutline(cc.c3b(0x18,0x31,0x5b),2)
            local res = PathTool.getResFrame("common", "common_1098")
            self.btn_get:loadTexture(res, LOADTEXT_TYPE_PLIST)
            self.btn_get:setVisible(true)
            self.finish_img:setVisible(false)
        else
            if data.status == 0 or (data.rmb_status == 0 and data.is_locak == 1) then --可领取
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_name:setTextColor(cc.c3b(0xf8,0xef,0x76))
                self.btn_name:enableOutline(cc.c3b(0x5c,0x27,0x05),2)
                local res = PathTool.getResFrame("common", "common_1027")
                self.btn_get:loadTexture(res, LOADTEXT_TYPE_PLIST)
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 15, 15)
            elseif data.status == 1 and data.rmb_status == 1 then
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
            else --前往购买
                self.btn_name:setString(TI18N("语言_c_7"))
                self.btn_name:setTextColor(cc.c3b(0xff,0xff,0xff))
                self.btn_name:enableOutline(cc.c3b(0x18,0x31,0x5b),2)
                local res = PathTool.getResFrame("common", "common_1098")
                self.btn_get:loadTexture(res, LOADTEXT_TYPE_PLIST)
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            end
        end
    end
end

function NewOrderActiodRewardItem3:DeleteMe()
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.common_goods_item then
        self.common_goods_item:DeleteMe()
        self.common_goods_item = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

