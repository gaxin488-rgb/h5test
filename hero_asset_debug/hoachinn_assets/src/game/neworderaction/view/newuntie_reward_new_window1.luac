NewUntieRewardNewWindow1 = NewUntieRewardNewWindow1 or BaseClass(BaseView)

local controller = NeworderactionController:getInstance()
local model = controller:getModel()
local config = Config.HolidayNewWarOrderData
function NewUntieRewardNewWindow1:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "neworderaction/neworderaction_untie_reward_new_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("get_ninja", "get_ninja"), type = ResourcesType.plist},
        -- {path = PathTool.getPlistImgForDownLoad("get_ninja", "getninjaorder_banner_1"), type = ResourcesType.plist}
    }
end

function NewUntieRewardNewWindow1:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2) 

    main_container:getChildByName("Text_3"):setString(TI18N("语言_c_741"))
    local title_bg = main_container:getChildByName("title_bg")
    local title_width = main_container:getChildByName("Text_3"):getContentSize().width
    local title_bg_width = math.max(title_width+130, 266)
    title_bg:setContentSize(cc.size(title_bg_width,44))

    local text_bg = main_container:getChildByName("text_bg")
    local Text_3_0 = main_container:getChildByName("Text_3_0")
    Text_3_0:setString(TI18N("语言_c_5480"))
    text_bg:setContentSize(cc.size(500,20))
    Text_3_0:ignoreContentAdaptWithSize(true)
    Text_3_0:setTextAreaSize(cc.size(260,0))
    setTextSpacing(Text_3_0)
    local text_bg_0 = main_container:getChildByName("text_bg_0")
    local Text_3_0_0 = main_container:getChildByName("Text_3_0_0")
    Text_3_0_0:setString(TI18N("语言_c_5481"))
    text_bg_0:setContentSize(cc.size(500,20))
    Text_3_0_0:ignoreContentAdaptWithSize(true)
    Text_3_0_0:setTextAreaSize(cc.size(260,0))
    setTextSpacing(Text_3_0_0)
    local Text_3_1 = main_container:getChildByName("Text_3_1")
    self.Text_3_1 = Text_3_1
    Text_3_1:setString(TI18N("语言_c_5482"))
    Text_3_1:ignoreContentAdaptWithSize(true)
    Text_3_1:setTextAreaSize(cc.size(260,0))
    self.bg_3 = main_container:getChildByName("getninjaorder_back_1_5_0")

    local label_lock = createRichLabel(22, cc.c4b(0x2b, 0x19, 0x5e, 0xff), cc.p(0.5, 0.5), cc.p(325, 136), -8, nil, 400)
    local str = string.format(TI18N("语言_c_4774"))
    label_lock:setString(str)
    main_container:addChild(label_lock)
    self.label_lock = label_lock

    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_label = self.btn_change:getChildByName("Text_6")

    if model:getGiftStatus() == 1 then
        self.btn_change:setTouchEnabled(false)
        setChildUnEnabled(true, self.btn_change)
        self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
    end
    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    self.goods_3 = main_container:getChildByName("goods_3")
    self.goods_3:setScrollBarEnabled(false)
    -- local image_bg = main_container:getChildByName("Sprite_1")
    -- local res = PathTool.getPlistImgForDownLoad("get_ninja", "getninjaorder_banner_1",false)
    -- if not self.image_bg_load then
    --     self.image_bg_load = loadSpriteTextureFromCDN(image_bg, res, ResourcesType.plist, self.image_bg_load)
    -- end
    self.btn_close = main_container:getChildByName("btn_close")
    self:setData()
end

function NewUntieRewardNewWindow1:setData()
    local card_list = config.data_advance_card_list
    local period = model:getCurPeriod()
    local _id = model:getChooseId()
    local cfg = config.data_lev_reward_list
    local order_id = 0
    if cfg and cfg[period] and cfg[period][1] and cfg[period][1]["id".._id] then
        order_id = cfg[period][1]["id".._id]
    end
    if card_list and card_list[period] and card_list[period][order_id] then
        local data_list = model:getReward2()
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, data_list, setting)

        local data_list = card_list[period][order_id].reward or {}
        local setting = {}
        setting.scale = 0.7
        setting.max_count = 4
        setting.is_center = true
        self.item_list3 = commonShowSingleRowItemList(self.goods_3, self.item_list3, data_list, setting)
        
        local data_list = model:getReward3()
        local setting = {}
        setting.scale = 0.7
        setting.max_count = 4
        setting.is_center = true
        self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, data_list, setting)
        if #data_list == 0 then
            self.Text_3_1:setVisible(false)
            self.bg_3:setVisible(false)
            self.goods_2:setVisible(false)
            self.label_lock:setPositionY(236)
            self.btn_change:setPositionY(174)
        else
            self.Text_3_1:setVisible(true)
            self.bg_3:setVisible(true)
            self.goods_2:setVisible(true)
            self.label_lock:setPositionY(136)
            self.btn_change:setPositionY(74)
        end

        local charge_list = Config.ChargeData.data_charge_data
        local charge_id = card_list[period][order_id].charge_id or nil
        if charge_id and charge_list and charge_list[charge_id] then
            self.btn_change_label:setString(string.format(TI18N("语言_c_4441"),GetMoneyNum(charge_list[charge_id],"val")))
        end
    end
end

function NewUntieRewardNewWindow1:register_event()
    self:addGlobalEvent(
        NeworderactionEvent.OrderAction_BuyGiftCard_Event,
        function()
            if model:getGiftStatus() == 1 then
                self.btn_change:setTouchEnabled(false)
                setChildUnEnabled(true, self.btn_change)
                self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
            end
        end
    )

    registerButtonEventListener(
        self.background,
        function()
            controller:openBuyCardNewView(false)
        end,
        false,
        2
    )
    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openBuyCardNewView(false)
        end,
        true,
        2
    )

    registerButtonEventListener(
        self.btn_change,
        function()
            self:changeWarn()
        end,
        true,
        1
    )

    self:addGlobalEvent(
        ActionEvent.Is_Charge_Event,
        function(data)
            if self.cur_charge_id and data and self.cur_charge_id == data.charge_id and data.status == 1 then
                local charge_list = Config.ChargeData.data_charge_data
                local card_list = config.data_advance_card_list
                local period = model:getCurPeriod()
                local _id = model:getChooseId()
                local cfg = config.data_lev_reward_list
                local order_id = 0
                if cfg and cfg[period] and cfg[period][1] and cfg[period][1]["id".._id] then
                    order_id = cfg[period][1]["id".._id]
                end
                if card_list and card_list[period] and card_list[period] and card_list[period][order_id] then
                    local charge_id = card_list[period][order_id].charge_id or nil
                    if charge_id and charge_list and charge_list[charge_id] then
                        sdkOnPay(charge_list[charge_id].val, 1, charge_list[charge_id].id, charge_list[charge_id].name)
                    end
                end
            end
        end
    )
end

function NewUntieRewardNewWindow1:changeWarn()
    local day = model:getCurDay()
    local charge_list = Config.ChargeData.data_charge_data
    local card_list = config.data_advance_card_list
    local period = model:getCurPeriod()
    local _id = model:getChooseId()
    local cfg = config.data_lev_reward_list
    local order_id = 0
    if cfg and cfg[period] and cfg[period][1] and cfg[period][1]["id".._id] then
        order_id = cfg[period][1]["id".._id]
    end

    if card_list and card_list[period] and card_list[period] and card_list[period][order_id] then
        local str = nil
        if day >= 27 then
            if day == 30 then
                str = TI18N("语言_c_745")
            else
                str = string.format(TI18N("语言_c_746"), 30 - day)
            end
        end

        if str then
            CommonAlert.show(
                str,
                TI18N("语言_c_63"),
                function()
                    local charge_id = card_list[period][order_id].charge_id or nil
                    if charge_id and charge_list[charge_id] then
                        self.cur_charge_id = charge_list[charge_id].id
                        ActionController:getInstance():sender21016(self.cur_charge_id)
                    end
                end,
                TI18N("语言_c_62"),
                nil,
                CommonAlert.type.common,
                nil,
                {timer = 5, timer_for = true},
                26
            )
        else
            local charge_id = card_list[period][order_id].charge_id or nil
            if charge_id and charge_list[charge_id] then
                self.cur_charge_id = charge_list[charge_id].id
                ActionController:getInstance():sender21016(self.cur_charge_id)
            end
        end
    end
end
function NewUntieRewardNewWindow1:openRootWnd()
end
function NewUntieRewardNewWindow1:close_callback()
    -- if self.image_bg_load then
    --     self.image_bg_load:DeleteMe()
    -- end
    -- self.image_bg_load = nil
    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.item_list3 then
        for i, v in pairs(self.item_list3) do
            v:DeleteMe()
        end
        self.item_list3 = nil
    end
    controller:openBuyCardNewView(false)
end
