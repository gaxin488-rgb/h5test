-- 奖励列表
function MonopolyWarOrderWindow:createTaskCell()
    local cell = MonopolyWarOrderIten.new()
    return cell
end

function MonopolyWarOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function MonopolyWarOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,self.comp_id,self.OrderBid,index)
end

-- 进度条
-- 功勋数数列表
function MonopolyWarOrderWindow:createTaskCell2()
    local cell = MonopolyRewardItem.new(self.type)
    return cell
end

function MonopolyWarOrderWindow:numberOfTaskCells2()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function MonopolyWarOrderWindow:updateTaskCellByIndex2(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,self.OrderBid,self.comp_id,index)
end

-- 设置适配屏幕
function MonopolyWarOrderWindow:adaptationScreen()
end

function MonopolyWarOrderWindow:register_event()
    if not self.get_monopoly_war_order_data then
        self.get_monopoly_war_order_data = GlobalEvent:getInstance():Bind(MonopolyEvent.Get_Monopoly_War_Order_Data, function (  )
            self:setData()
        end)
    end
    registerButtonEventListener(self.btn_open_lock, function()
        local config = Config.MonopolyOrderData.data_constant[self.comp_id]
        if config.recharge_id2 == 0 then
            controller:openMonopolyWarOrderBuyCardWindow(true,self.comp_id)
        else
            controller:openMonopolyWarOrderBuyCardWindow2(true,self.comp_id)
        end
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        controller:openWarOrderWindow(false)
    end, true, 2)

    registerButtonEventListener(self.exp_buy_btn, function()
        controller:openWarOrderBuyexpPanel(true,self.OrderBid,self.comp_id)
	end, true)
    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = Config.MonopolyOrderData.data_constant[self.comp_id]
        if config then
            local config_desc = config.dis
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
end

-- 滑动的时候处理显示
function MonopolyWarOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end

function MonopolyWarOrderWindow:updateIconImg()
    if tolua.isnull(self.icon_img) or tolua.isnull(self.btn_open_lock) then
        return
    end
    local cfg = Config.MonopolyOrderData.data_constant[self.comp_id]
    loadSpriteTexture(self.icon_img, PathTool.getResFrame("monopolyenter", cfg.icon), LOADTEXT_TYPE_PLIST)
    local status = model:getOrderStatus()
    
    if status then
        setChildUnEnabled(false, self.icon_img)
    else
        setChildUnEnabled(true, self.icon_img)
    end
    if status then
        self.btn_open_lock:setVisible(false)
    else
        self.btn_open_lock:setVisible(true)
    end
end

function MonopolyWarOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
end
--设置倒计时
function MonopolyWarOrderWindow:setLessTime(less_time)
    if tolua.isnull(self.time_txt) then
        return
    end
    local less_time = less_time or 0
    self.time_txt:stopAllActions()
    if less_time > 0 then
        self:setTimeFormatString(less_time)
        self.time_txt:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1),
            cc.CallFunc:create(function()
                less_time = less_time - 1
                if less_time < 0 then
                    self.time_txt:stopAllActions()
                else
                    self:setTimeFormatString(less_time)
                end
            end))))
    else
        self:setTimeFormatString(less_time)
    end
end

function MonopolyWarOrderWindow:setTimeFormatString( time )
    if time > 0 then
        self.time_txt:setString(string.format(TI18N("语言_c_2397"),TimeTool.GetTimeFormatDay(time)))
    else
        self.time_txt:setString(TI18N("语言_c_233"))
    end
    self.time_bg:setContentSize(cc.size(math.max(self.time_txt:getContentSize().width+20,self.time_bg:getContentSize().width),self.time_bg:getContentSize().height))
end

function MonopolyWarOrderWindow:setChangeLevelStatus()
    local title_pos = 1
    local data = model:getOrderData()
    self.login_day:setString(string.format(TI18N("语言_c_5237"),data.day))
    self.login_bg:setContentSize(cc.size(self.login_day:getContentSize().width+30,self.login_day:getContentSize().height+2))
    self.login_bg:setVisible(false)
    local end_time = data.end_time
    local cur_time = GameNet:getInstance():getTime()
    local less_time = end_time - cur_time
    self:setLessTime(less_time)
    for key, value in pairs(data.quest_list) do
        if value.reward == 1 or value.rmb_reward == 1 then
            title_pos = key
            break
        end
    end
    self:jumpToMoveByY(139 * (title_pos - 1))
end

-- 红点
function MonopolyWarOrderWindow:setTabRedPoint()
end

function MonopolyWarOrderWindow:initAwardConfig()
    self.reward_list = {}
    local temp_reward_list = Config.MonopolyOrderData.data_quest_list[self.comp_id]
    for k, v in pairs(temp_reward_list) do
        table.insert(self.reward_list, v)
    end
    local id = model:getReceiveFinish()
    local finalid= table.maxn(temp_reward_list)
    self.exp_buy_btn:setVisible(id~=finalid)
    table.sort(self.reward_list, SortTools.KeyLowerSorter("goal_id"))
    self.reward_goods_item:reloadData()
    self.reward_num_item:reloadData()

    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
    self:setChangeLevelStatus()
    -- local cfg=temp_reward_list[id]
    local nextCfg= temp_reward_list[model:getReceiveFinishNext()]    
    -- local num1=cfg~=nil and cfg.progress[1].target_val or 0
    local num1=RoleController:getInstance():getRoleVo():getActionAssetsNumByBid(80354)
    local num2=nextCfg.progress[1].target_val
    local str = num1.."/"..num2
    self.medal_num:setString(str)
end

function MonopolyWarOrderWindow:openRootWnd(type)
    self.type=type
    if type==1 then
        self.OrderBid=model:getOrderBid()
        self.comp_id=model:getCamp_id()
    else
        self.OrderBid=model:getOrderBid1()
        self.comp_id=model:getCamp_id1()
    end
    controller:sender27507(self.OrderBid)
end

function MonopolyWarOrderWindow:close_callback()
    self.time_txt:stopAllActions()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.get_monopoly_war_order_data then
        GlobalEvent:getInstance():UnBind(self.get_monopoly_war_order_data)
        self.get_monopoly_war_order_data = nil
    end
    controller:openWarOrderWindow(false)
end

