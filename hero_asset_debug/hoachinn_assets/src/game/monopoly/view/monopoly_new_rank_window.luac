MonopolyNewRankWindow = MonopolyNewRankWindow or BaseClass(BaseView)

local controller = MonopolyController:getInstance()
local model = controller:getModel()

function MonopolyNewRankWindow:__init()
	self.win_type = WinType.Full
	self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("monopoly","monopoly_enter_bg_1", true), type = ResourcesType.single },
        {path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_3"), type = ResourcesType.single },
	}
	self.layout_name = "monopoly/monopoly_rank_window"
	self.tab_list = {}
	self.tab_btn_list_1 = {}
	self.tab_info_list_1 = {}
	self.tab_panel_list_1 = {}
    self.panel_list_1 = {}
	self.tab_btn_list_2 = {}
	self.tab_info_list_2 = {}
	self.tab_panel_list_2 = {}
	self.panel_list_2 = {}

end

function MonopolyNewRankWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	self.background:loadTexture(PathTool.getPlistImgForDownLoad("monopoly","monopoly_enter_bg_1", true), LOADTEXT_TYPE)
    self.background:setScale(display.getMaxScale())

    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 1)
	self.bg_1 = main_container:getChildByName("bg_1")
	self.bg_2 = main_container:getChildByName("bg_2")
	self.close_btn = main_container:getChildByName("close_btn")
	self.imgTitleBg = main_container:getChildByName("imgTitleBg")
	self.win_title = main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_2411"))
	local _w = math.max(self.win_title:getContentSize().width + 120,self.imgTitleBg:getContentSize().width)
	self.imgTitleBg:setContentSize(cc.size(_w,63))
	-- self.tip_txt = main_container:getChildByName("tip_txt")
	self.tip_txt = createRichLabel(24, cc.c3b(0x5c,0x27,0x05), cc.p(0,0), cc.p(40,253), -10, nil, 640)
	main_container:addChild(self.tip_txt)

	-- setTextMaxWidth(self.tip_txt,640,-8)
	self.tip_txt:setString(TI18N("语言_c_2415"))
	self.container_1 = main_container:getChildByName("container_1")
	self.tab_container_1 = self.container_1:getChildByName("tab_container")
	self.tab_info_list_1 = {
        {label = TI18N("语言_c_2412"), index = MonopolyConst.Rank_Type.Guild , status = true},
        {label = TI18N("语言_c_2413"), index = MonopolyConst.Rank_Type.Personal , status = true},
        {label = TI18N("语言_c_2414"),index = MonopolyConst.Rank_Type.Award, status = true},
    }
	for i=1,4 do
		local tab_btn = self.tab_container_1:getChildByName("tab_btn_"..i)
		if tab_btn then
			if self.tab_info_list_1[i] then
				local object = {}
				object.unselect_bg = tab_btn:getChildByName('unselect_bg')
				object.unselect_bg:setVisible(true)
				object.select_bg = tab_btn:getChildByName('select_bg')
				object.select_bg:setVisible(false)
				object.tab_tips = tab_btn:getChildByName('tab_tips')
				object.tab_tips:setVisible(false)
				object.panel = tab_btn:getChildByName("panel")
				object.lable = object.panel:getChildByName("title")
				object.lable:setChangeScaleOffWidth(0)
				setTextSpacing(object.lable,-10)
				object.lable:setString(self.tab_info_list_1[i].label)
				object.tab_btn = tab_btn
				object.index = i
				self.tab_btn_list_1[i] = object
			else
				tab_btn:setVisible(false)
			end
		end
	end
	self.container_panel_1 = self.container_1:getChildByName("container_panel")
	self.container_2 = main_container:getChildByName("container_2")
	self.tab_container_2 = self.container_2:getChildByName("tab_container")
	self.tab_info_list_2 = {
        {label = TI18N("语言_c_2411"), index = MonopolyConst.Cross_Rank_Type.Personal , status = true},
        {label = TI18N("语言_c_1069"),index = MonopolyConst.Cross_Rank_Type.Award, status = true},
    }
	for i=1,4 do
		local tab_btn = self.tab_container_2:getChildByName("tab_btn_"..i)
		if tab_btn then
			if self.tab_info_list_2[i] then
				local object = {}
				object.unselect_bg = tab_btn:getChildByName('unselect_bg')
				object.unselect_bg:setVisible(true)
				object.select_bg = tab_btn:getChildByName('select_bg')
				object.select_bg:setVisible(false)
				object.tab_tips = tab_btn:getChildByName('tab_tips')
				object.tab_tips:setVisible(false)
				object.panel = tab_btn:getChildByName("panel")
				object.lable = object.panel:getChildByName("title")
				object.lable:setChangeScaleOffWidth(0)
				object.lable:setString(self.tab_info_list_2[i].label)
				object.tab_btn = tab_btn
				object.index = i
				self.tab_btn_list_2[i] = object
			else
				tab_btn:setVisible(false)
			end
		end
	end
	self.container_panel_2 = self.container_2:getChildByName("container_panel")
    local tab_container = main_container:getChildByName("tab_container")
	self.tab_container = tab_container
    local tab_name_list = {
        [1] = TI18N("语言_c_5911"),
        [2] = TI18N("语言_c_5912")
    }
    for i=1,2 do
        local tab_btn = tab_container:getChildByName("tab_btn_"..i)
        if tab_btn then
            local object = {}
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
            object.unselect_bg:setVisible(true)
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(true)
			object.lable = tab_btn:getChildByName("title")
			object.lable:setChangeScaleOffWidth(75)
			setTextSpacing(object.lable,-10)
            object.lable:setString(tab_name_list[i])
            object.tab_btn = tab_btn
            object.index = i
            self.tab_list[i] = object
        end
    end
end

function MonopolyNewRankWindow:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		controller:openMonopolyNewRankWindow(false)
	end, nil, REGISTER_BUTTON_SOUND_CLOSED_TYPY)
	for k, object in pairs(self.tab_list) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab(object.index)
				end
			end)
		end
    end
	for k, object in pairs(self.tab_btn_list_1) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab1(object.index)
				end
			end)
		end
    end
	for k, object in pairs(self.tab_btn_list_2) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab2(object.index)
				end
			end)
		end
    end
end

-- 切换标签页
function MonopolyNewRankWindow:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end
    
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        self.tab_object = nil
    end
    self.tab_object = self.tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
    end

	if index == MonopolyConst.Tab_Index.Single then
		self.container_1:setVisible(true)
		self.container_2:setVisible(false)
		self:changeSelectedTab1(1)
		self.tip_txt:setString(TI18N("语言_c_2415"))
	elseif index == MonopolyConst.Tab_Index.Cross then
		self.container_1:setVisible(false)
		self.container_2:setVisible(true)
		self:changeSelectedTab2(1)
		self.tip_txt:setString(TI18N("语言_c_5921"))
	end
end
--本服排行页签切换
function MonopolyNewRankWindow:changeSelectedTab1( index )
	if self.tab_object_1 ~= nil and self.tab_object_1.index == index then return end
    
    if self.tab_object_1 then
        self.tab_object_1.select_bg:setVisible(false)
        self.tab_object_1 = nil
    end
    self.tab_object_1 = self.tab_btn_list_1[index]
    if self.tab_object_1 then
        self.tab_object_1.select_bg:setVisible(true)
    end

	for i=1, tableLen(self.tab_btn_list_1) do
		local object = self.tab_btn_list_1[i]
		if i == index then
			object.lable:setTextColor(cc.c3b(248,239,118))
			object.lable:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		else
			object.lable:setTextColor(cc.c3b(249,239,208))
			object.lable:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		end
	end

    if self.cur_panel_1 ~= nil then
        self.cur_panel_1:setNodeVisible(false)
        self.cur_panel_1 = nil
    end
	self.cur_panel_1 = self.panel_list_1[index]
	if self.cur_panel_1 == nil then
		if index == MonopolyConst.Rank_Type.Guild then
			self.cur_panel_1 = MonopolyGuildRankPanel.new(self.step_id)
		elseif index == MonopolyConst.Rank_Type.Personal then
			self.cur_panel_1 = MonopolyPersonalRankPanel.new(self.step_id)
		elseif index == MonopolyConst.Rank_Type.Award then
			self.cur_panel_1 = MonopolyRankAwardPanel.new(MonopolyConst.Tab_Index.Single)
		end
		self.panel_list_1[index] = self.cur_panel_1
        self.container_panel_1:addChild(self.cur_panel_1)
        if self.cur_panel_1.addToParent then
            self.cur_panel_1:addToParent()
        end
	end
	for k, v in pairs(self.panel_list_1) do
		if k == index then
			v:setVisible(true)
		else
			v:setVisible(false)
		end
	end
    self.cur_panel_1:setNodeVisible(true)
end
--跨服排行页签切换
function MonopolyNewRankWindow:changeSelectedTab2( index )
	if self.tab_object_2 ~= nil and self.tab_object_2.index == index then return end
    
    if self.tab_object_2 then
        self.tab_object_2.select_bg:setVisible(false)
        self.tab_object_2 = nil
    end
    self.tab_object_2 = self.tab_btn_list_2[index]
    if self.tab_object_2 then
        self.tab_object_2.select_bg:setVisible(true)
    end

	for i=1, tableLen(self.tab_btn_list_2) do
		local object = self.tab_btn_list_2[i]
		if i == index then
			object.lable:setTextColor(cc.c3b(248,239,118))
			object.lable:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		else
			object.lable:setTextColor(cc.c3b(249,239,208))
			object.lable:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		end
	end

    if self.cur_panel_2 ~= nil then
        self.cur_panel_2:setNodeVisible(false)
        self.cur_panel_2 = nil
    end
	self.cur_panel_2 = self.panel_list_2[index]
	if self.cur_panel_2 == nil then
		if index == MonopolyConst.Cross_Rank_Type.Personal then
			self.cur_panel_2 = MonopolyCrossPersonalRankPanel.new(self.step_id)
		elseif index == MonopolyConst.Cross_Rank_Type.Award then
			self.cur_panel_2 = MonopolyRankAwardPanel.new(MonopolyConst.Tab_Index.Cross,self.step_id)
		end
		self.panel_list_2[index] = self.cur_panel_2
        self.container_panel_2:addChild(self.cur_panel_2)
        if self.cur_panel_2.addToParent then
            self.cur_panel_2:addToParent()
        end
	end
	for k, v in pairs(self.panel_list_2) do
		if k == index then
			v:setVisible(true)
		else
			v:setVisible(false)
		end
	end
    self.cur_panel_2:setNodeVisible(true)
end

function MonopolyNewRankWindow:openRootWnd( step_id, view_type )
	self.step_id = step_id or 1
	view_type = view_type or MonopolyConst.Rank_Type.Guild
	self:changeSelectedTab(1)
	self:changeSelectedTab1(1)
	self.holidayId= MonopolyController:getInstance():getModel():getCamp_id1()
	local cfg = Config.MonopolyDungeonsData.data_const[self.holidayId]
	if cfg["open_cross"] and cfg["open_cross"].val[1] == 1 then
		self:changeSelectedTab2(1)
		self.tab_container:setVisible(true)
	else
		self.tab_container:setVisible(false)
	end
	local cfg = Config.MonopolyMapsData.data_const[self.holidayId]
	self.background:loadTexture(PathTool.getPlistImgForDownLoad("monopoly",cfg.monopoly_enter_bg.val, true), LOADTEXT_TYPE)	
end

function MonopolyNewRankWindow:close_callback(  )
	for k, panel in pairs(self.panel_list_1) do
        panel:DeleteMe()
    end
    self.panel_list_1 = {}
	for k, panel in pairs(self.panel_list_2) do
        panel:DeleteMe()
    end
    self.panel_list_2 = {}
	controller:openMonopolyNewRankWindow(false)
end