MonopolyWarOrderBuyCardWindow2 = MonopolyWarOrderBuyCardWindow2 or BaseClass(BaseView)

local controller = MonopolyController:getInstance()
local model = controller:getModel()
function MonopolyWarOrderBuyCardWindow2:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "monopoly/monopoly_war_order_buy_card_window2"
end

function MonopolyWarOrderBuyCardWindow2:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2)
    local baseCfg = Config.DungeonData.data_drama_const
    self.title = main_container:getChildByName("Text_3")

    self.title_bg= main_container:getChildByName("title_bg")
    -- local title_width = main_container:getChildByName("Text_3"):getContentSize().width
    -- local title_bg_width = math.max(title_width+130, 266)
    -- self.title_bg:setContentSize(cc.size(title_bg_width,44))
    
    self.title_1 = main_container:getChildByName("Text_3_0")
    setTextMaxWidth(self.title_1,250)
    setTextSpacing(self.title_1,-10)
    self.title_2 = main_container:getChildByName("Text_3_1")
    setTextSpacing(self.title_2,-10)
    self.title_3 = main_container:getChildByName("Text_3_2")
    setTextSpacing(self.title_3,-10)
    -- self.Text_3_1_0 = main_container:getChildByName("Text_3_1_0")
    --(font_size,text_color,line_color,x,y,text_content,parent_wnd,line_num, anchorpoint,font)
    self.label_lock = createLabel(20, cc.c4b(0xfe,0xde,0x6e,0xff),cc.c4b(0x53,0x2d,0x1d,0xff),325,-10,nil,main_container,-10, cc.p(0.5,0.5))
    self.label_lock:setWidth(400)
    local str = string.format(baseCfg.dungeon_pass_introduce.desc)
    -- main_container:addChild(label_lock)
    -- local orderId = baseCfg.dungeon_pass.val
    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_2 = main_container:getChildByName("btn_change_2")
    self.btn_change_label_2 = self.btn_change_2:getChildByName("Text_6")
    self.old_price_line = main_container:getChildByName("old_price_line")
    self.old_price = main_container:getChildByName("old_price")
    self.old_price_line:setVisible(false)
    self.old_price:setVisible(false)
    self.btn_close = main_container:getChildByName("btn_close")
    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    self.goods_3 = main_container:getChildByName("goods_3")
    self.goods_3:setScrollBarEnabled(false)
    self.goods_4 = main_container:getChildByName("goods_4")
    self.goods_4:setScrollBarEnabled(false)    
end

function MonopolyWarOrderBuyCardWindow2:setData()
	if self.cfg and self.cfg.desc_reward and self.cfg.rmb_reward then
		local data_list = self.cfg.rmb_reward or {}
		local setting = {}
		setting.scale = 0.6
        setting.space_x = 3
		setting.max_count = 4
		setting.is_center = true
		self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, data_list, setting)

		local data_list = self.cfg.desc_reward or {}
		local setting = {}
		setting.scale = 0.6
		setting.max_count = 4
		setting.is_center = true
		self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, data_list, setting)
	end
    if self.cfg and self.cfg.desc_reward2 then
        local data_list = self.cfg.desc_reward2 or {}
        local setting = {}
		setting.scale = 0.6
		setting.max_count = 4
		setting.is_center = true
		self.item_list3 = commonShowSingleRowItemList(self.goods_3, self.item_list3, data_list[1][2], setting)

		local setting = {}
		setting.scale = 0.6
		setting.max_count = 4
		setting.is_center = true
		self.item_list4 = commonShowSingleRowItemList(self.goods_4, self.item_list4, data_list[2][2], setting)
    end
end

function MonopolyWarOrderBuyCardWindow2:register_event()
    if not self.update_order_event then --更新战令解锁信息
        self.update_order_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.BattleDrama_Top_Update_Data, function(data)
            if model:getOrderStatus() ~= 0 then
                if not tolua.isnull(self.btn_change) then
                    self.btn_change:setTouchEnabled(false)
                    setChildUnEnabled(true, self.btn_change)
                end
                if not tolua.isnull(self.btn_change_label) then
                    self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
                end
            end
        end)
    end

    if not self.update_holiday_signle then --活动刷新
        self.update_holiday_signle = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE, function(data)
            if data.bid == self.OrderBid and data.finish ~= 0 then
                self.old_price:setString(string.format(TI18N("语言_c_4440"),data.finish*0.01))
                self.old_price_line:setVisible(true)
                self.old_price:setVisible(true)
            end
        end)
    end

	registerButtonEventListener(self.btn_close, function()
        controller:openMonopolyWarOrderBuyCardWindow2(false)
    end,true, 2)

    registerButtonEventListener(self.background, function()
        controller:openMonopolyWarOrderBuyCardWindow2(false)
    end,false, 2)

    registerButtonEventListener(self.btn_change, function()
        self:changeWarn()
    end,true, 1)
    
    registerButtonEventListener(self.btn_change_2, function()
        self:changeWarn2()
    end,true, 1)
end

function MonopolyWarOrderBuyCardWindow2:changeWarn2()
    local act_status = model:getOrderStatusNum()
    if act_status >= 2 then
    elseif act_status == 1 then
        local chargeId = self.cfg.recharge_id3
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
    else
        local chargeId = self.cfg.recharge_id2
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
    end        
end

function MonopolyWarOrderBuyCardWindow2:changeWarn()
    local act_status = model:getOrderStatusNum()
    if act_status >= 1 then
    else
        local chargeId = self.cfg.recharge_id
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
    end        
end
function MonopolyWarOrderBuyCardWindow2:openRootWnd(comp_id)
    self.comp_id=comp_id
    self.cfg = Config.MonopolyOrderData.data_constant[self.comp_id]
    if not self.cfg then
        return
    end
    self.OrderBid=MonopolyController:getInstance():getModel():getOrderBid()
    if self.cfg and self.cfg.recharge_id2 ~= 0 then
        ActionController:getInstance():cs16603(self.OrderBid)
    end
    self.title:setString(self.cfg.name)
    autoSizeTitleBg(self.title,self.title_bg)
    self.title_1:setString(self.cfg.txt1)
    self.title_2:setString(TI18N("语言_c_6776"))
    self.title_2:setPositionX(325)
    self.title_3:setString(TI18N("语言_c_6777"))
    self.label_lock:setString(TI18N("语言_c_6778"))
    self.label_lock:setAlignment(cc.TEXT_ALIGNMENT_CENTER)
    local chargeId = self.cfg.recharge_id
    local cdata = Config.ChargeData.data_charge_data[chargeId]
    local val = 198
    if cdata then
        val = GetMoneyNum(cdata,"val")
    end
    self.btn_change_label = self.btn_change:getChildByName("Text_6")
    self.btn_change_label:setString(string.format(TI18N("语言_c_4440"),val))

    if model:getOrderStatusNum() == 1 then
        if not tolua.isnull(self.btn_change_label) then
            self.btn_change:setTouchEnabled(false)
            setChildUnEnabled(true, self.btn_change)
            -- self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
        end
        local chargeId = self.cfg.recharge_id3
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        local val = 198
        if cdata then
            val = GetMoneyNum(cdata,"val")
        end
        self.btn_change_label_2:setString(string.format(TI18N("语言_c_4440"),val))
        
        if not tolua.isnull(self.btn_change_2) then
            self.btn_change_2:setTouchEnabled(true)
            setChildUnEnabled(false, self.btn_change_2)
            -- self.btn_change_label_2:disableEffect(cc.LabelEffect.OUTLINE)
        end
    elseif model:getOrderStatusNum() == 2 then
        if not tolua.isnull(self.btn_change_label) then
            self.btn_change:setTouchEnabled(false)
            setChildUnEnabled(true, self.btn_change)
            -- self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
        end
        local chargeId = self.cfg.recharge_id2
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        local val = 198
        if cdata then
            val = GetMoneyNum(cdata,"val")
        end
        self.btn_change_label_2:setString(string.format(TI18N("语言_c_4440"),val))
        if not tolua.isnull(self.btn_change_2) then
            self.btn_change_2:setTouchEnabled(false)
            setChildUnEnabled(true, self.btn_change_2)
            -- self.btn_change_label_2:disableEffect(cc.LabelEffect.OUTLINE)
        end
    else
        local chargeId = self.cfg.recharge_id2
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        local val = 198
        if cdata then
            val = GetMoneyNum(cdata,"val")
        end
        self.btn_change_label_2:setString(string.format(TI18N("语言_c_4440"),val))
        if not tolua.isnull(self.btn_change_2) then
            self.btn_change_2:setTouchEnabled(true)
            setChildUnEnabled(false, self.btn_change_2)
            -- self.btn_change_label_2:disableEffect(cc.LabelEffect.OUTLINE)
        end

        if not tolua.isnull(self.btn_change) then
            self.btn_change:setTouchEnabled(true)
            setChildUnEnabled(false, self.btn_change)
            -- self.btn_change_label_2:disableEffect(cc.LabelEffect.OUTLINE)
        end
    end
    self:setData()
end

function MonopolyWarOrderBuyCardWindow2:close_callback()
	if self.image_bg_load then
        self.image_bg_load:DeleteMe()
    end
    self.image_bg_load = nil
	if self.item_list1 then
        for i,v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.update_order_event then
        GlobalEvent:getInstance():UnBind(self.update_order_event)
        self.update_order_event = nil
    end
    if self.update_holiday_signle then
        GlobalEvent:getInstance():UnBind(self.update_holiday_signle)
        self.update_holiday_signle = nil
    end
    if self.item_list2 then
        for i,v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.item_list3 then
        for i,v in pairs(self.item_list3) do
            v:DeleteMe()
        end
        self.item_list3 = nil
    end
    if self.item_list4 then
        for i,v in pairs(self.item_list4) do
            v:DeleteMe()
        end
        self.item_list4 = nil
    end
	controller:openMonopolyWarOrderBuyCardWindow2(false)
end
