CommonRankWindow = CommonRankWindow or BaseClass(BaseView)

local controller = RankController:getInstance()
local model = controller:getModel()

function CommonRankWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = true
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("holiday_og_turntable", "holiday_og_turntable"), type = ResourcesType.plist},
    }
    self.layout_name = "rank/common_rank_window"
    self.three_rank_item = {}
end

function CommonRankWindow:open_callback(  )
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.item = self.root_wnd:getChildByName("item")

    local total_height = getGameShowHeigth()
    local add_height = total_height - 1280

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title_txt = self.main_container:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_c_271"))
    autoSizeTitleBg(self.title_txt, self.title_bg, 360)

    for i = 1, 3 do
        local object = {}
        local rank = self.main_container:getChildByName("rank_"..i)
        local head_node = rank:getChildByName("head_node")
        local value_txt = rank:getChildByName("value_txt")
        local value_name = rank:getChildByName("value_name")
        local name_txt = rank:getChildByName("name_txt")
        object.rank = rank
        object.head_node = head_node
        object.value_txt = value_txt
        object.value_txt:setString(0)
        object.name_txt = name_txt
        object.value_name = value_name
        object.name_txt:setString(TI18N("语言_c_526"))
        -- object.value_name:setString(RankConstant.RankRewardValTips[])
        self.three_rank_item[i] = object
    end

    self.Image_6 = self.main_container:getChildByName("Image_6")
    local img_height = self.Image_6:getContentSize().height
    local img_width = self.Image_6:getContentSize().width
    self.Image_6:setContentSize(cc.size(img_width, img_height+add_height/2))

    self.bottom_bg = self.main_container:getChildByName("bottom_bg")
    self.rank_bg = self.main_container:getChildByName("rank_bg")
    local rank_bg_height = self.rank_bg:getContentSize().height
    local rank_bg_width = self.rank_bg:getContentSize().width
    self.rank_bg:setContentSize(cc.size(rank_bg_width, rank_bg_height+add_height/2))

    self.btn_close = self.main_container:getChildByName("btn_close")
    self.my_container = self.main_container:getChildByName("my_container")
    self.my_head = self.my_container:getChildByName("rank_node")
    self.my_rank_img = self.my_container:getChildByName("rank_img")
    self.my_rank_title_bg = self.my_container:getChildByName("Image_11")
    self.my_rank_title = self.my_container:getChildByName("my_rank_title")
    self.my_rank_title:setString(TI18N("语言_c_258"))
    autoSizeTitleBg(self.my_rank_title, self.my_rank_title_bg, 65, 125)
    self.my_role_name = self.my_container:getChildByName("role_name")
    self.no_rank = self.my_container:getChildByName("no_rank")
    self.no_rank:setString(TI18N("语言_c_285"))
    self.role_value = self.my_container:getChildByName("role_value")
    self.value_tip = self.my_container:getChildByName("value_tip")
    self.no_log_image = self.rank_bg:getChildByName("no_log_image")
    self.no_log_label = self.no_log_image:getChildByName("no_log_label")
    self.no_log_label:setString(TI18N("语言_c_260"))

    self.gift_btn = self.main_container:getChildByName("gift_btn")
    local gift_label = self.gift_btn:getChildByName("value")
    setTextMaxWidth(gift_label, 115, -4)
    gift_label:setString(TI18N("语言_c_5441"))
    gift_label:setScale(1)
    self.history_btn = self.main_container:getChildByName("history_btn")
    local history_label = self.history_btn:getChildByName("value")
    setTextMaxWidth(history_label, 115, -4)
    history_label:setString(TI18N("语言_c_7741"))
    history_label:setScale(1)
    self.history_btn:setVisible(false)
    
    local tips = self.main_container:getChildByName("tips")
    tips:setString("")
	self.tips = createRichLabel(20, cc.c4b(0x68, 0x45, 0x2a, 0xff), cc.p(0.5, 0.5), cc.p(360, 120), -4, nil, 390)
	self.main_container:addChild(self.tips)
    -- local const_val = Config.HolidayOgTurntableData.data_const.common_rank_times.val
	-- self.tips:setString(LangStringFormat(TI18N("语言_og_tur_4"),const_val))


    self.rank_list = self.rank_bg:getChildByName("rank_list")
    self.rank_list:setPositionY(0)
    local rank_height = self.rank_list:getContentSize().height
    local rank_width = self.rank_list:getContentSize().width
    self.rank_list:setContentSize(cc.size(rank_width, rank_height+add_height/2))

    local size = self.rank_list:getContentSize()
    local setting = {
        item_class = CommonRankItem,
        start_x = 3,
        space_x = 0,
        start_y = 3,
        space_y = 0,
        item_width = 685,
        item_height = 130,
        row = 0,
        col = 1,
        need_dynamic = true
    }
    self.scroll_view = CommonScrollViewLayout.new(self.rank_list, nil, nil, nil, size, setting)
    self:adaptationScreen()
    
    self.player_info_panel = PlayerInfoPanel.new()
    self.main_container:addChild(self.player_info_panel)
    local top_y = display.getTop(self.main_container)
    self.player_info_panel:setPositionY(top_y)

end

--设置适配屏幕
function CommonRankWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)

    local close_btn_y = self.btn_close:getPositionY()
	self.btn_close:setPositionY(bottom_y + close_btn_y)

    self.bottom_bg:setPositionY(bottom_y-52)
    self.gift_btn:setPositionY(bottom_y+106)
    self.history_btn:setPositionY(bottom_y+106)
    self.tips:setPositionY(bottom_y+120)
    self.my_container:setPositionY(bottom_y+157)
    self.Image_6:setPositionY(bottom_y+47)
    self.rank_bg:setPositionY(bottom_y+295)

    local posy = bottom_y + 47 + self.Image_6:getContentSize().height
    for i, v in ipairs(self.three_rank_item) do
        v.rank:setPositionY(posy-27)
    end

    self.title_bg:setPositionY(top_y-85)
    self.title_txt:setPositionY(top_y-88)
end


function CommonRankWindow:register_event(  )
    registerButtonEventListener(self.btn_close, handler(self, self.onClickCloseBtn), true, 2)
    registerButtonEventListener(self.gift_btn, handler(self, self.onClickGiftBtn), true, 2)
    registerButtonEventListener(self.history_btn, handler(self, self.onClickHistoryBtn), true, 2)
    
    self:addGlobalEvent(RankEvent.RankEvent_Get_Rank_data, function(data)
        if data and data.type == self.rank_type then
            self.rank_data = data
            self:setSelfRankInfo()
            self:setRankListData()
        end
    end)
    self:addGlobalEvent(NinjaVillageCombatEvent.Update_Ninja_Village_Rank_Data_Event, function(round)
        if self.rank_type == RankConstant.RankType.ninja_village_combat then
            self.rank_data = NinjaVillageCombatController:getInstance():getModel():getRankData(round)
            self:setSelfRankInfo()
            self:setRankListData()
        end
    end)
end

-- 关闭
function CommonRankWindow:onClickCloseBtn(  )
    controller:openCommonRankWindow(false)
end
function CommonRankWindow:onClickGiftBtn(  )
    controller:openCommonRankRewardWindow(true,self.rank_type)
end
function CommonRankWindow:onClickHistoryBtn(  )
    NinjaVillageCombatController:getInstance():openRankHistoryWindow(true)
end

function CommonRankWindow:openRootWnd(_type,setting)
    self.setting = setting or {}
    self.rank_type = _type or RankConstant.RankType.drama
    if self.rank_type == RankConstant.RankType.ninja_village_combat then
        NinjaVillageCombatController:getInstance():sender11723(self.setting.round)
        self.tips:setVisible(false)
        self.history_btn:setVisible(true)
    else
        RankController:getInstance():send_12900(self.rank_type)
    end
    self.title_txt:setString(RankConstant.TitleName[self.rank_type])
    self.tips:setString(RankConstant.RankTips[self.rank_type])
    for i, v in ipairs(self.three_rank_item) do
        v.value_name:setString(RankConstant.RankRewardValTips[self.rank_type] or "")
    end
end
function CommonRankWindow:setRankListData()
    local rank_list = self.rank_data.rank_list
    local top_three_list = {}
    local four_list = {}
    for i, v in ipairs(rank_list) do
        if v and (v.idx or v.rank) <= 3 then
            table.insert(top_three_list,v)
        else
            table.insert(four_list,v)
        end
    end
    table.sort(top_three_list,function(a,b) return (a.idx or a.rank) < (b.idx or b.rank) end)
    table.sort(four_list,function(a,b) return (a.idx or a.rank) < (b.idx or b.rank) end)

    if next(four_list) ~= nil then
        self.scroll_view:setData(four_list, nil, nil, {self.item,self.rank_type}) --, view_type=self.view_type
        self.no_log_image:setVisible(false)
    else
        self.no_log_image:setVisible(true)
    end

    for i, v in ipairs(self.three_rank_item) do
        local rank_data = top_three_list[i]
        local item = v
        if rank_data then
            local value = rank_data.val1 or rank_data.max_hurt_str
            item.value_txt:setString(value)
            local srv_name = getServerName(rank_data.srv_id)
            item.name_txt:setString(string_format("[%s]",srv_name)..rank_data.name)

            if not item.role_head then
                item.role_head = PlayerHead.new(PlayerHead.type.circle)
                item.role_head:setHeadLayerScale(0.95)
                item.role_head:setLev(99)
                item.head_node:addChild(item.role_head)
                -- item.role_head:addCallBack(handler(self, self.openChatMessage))
                item.role_head:addCallBack(function() self:openChatMessage(rank_data) end)
            end
            item.role_head:setHeadRes(rank_data.face_id or rank_data.face, false, LOADTEXT_TYPE, rank_data.face_file, rank_data.face_update_time)
            item.role_head:setLev(rank_data.lev)
            local avatar_bid = rank_data.avatar_base_id or rank_data.lookid
            local vo = Config.AvatarData.data_avatar[avatar_bid]
            if vo then
                local res_id = vo.res_id or 1
                local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
                item.role_head:showBg(res, nil, false, vo.offy)
            end
            item.head_node:setVisible(true)
        else
            item.head_node:setVisible(false)
            item.name_txt:setString(TI18N("语言_c_526"))
            item.value_txt:setString("0")
        end
    end

end
function CommonRankWindow:openChatMessage(rank_data)
	local roleVo = RoleController:getInstance():getRoleVo()
	local rid = rank_data.rid
	local srv_id  = rank_data.srv_id
	if rank_data.srv_id and rank_data.srv_id == "robot" then 
		message(TI18N("语言_c_476"))
		return
	end
	if rid and srv_id and roleVo.rid== rid and roleVo.srv_id == srv_id then 
		message(TI18N("语言_c_349"))
		return 
	end
	if rank_data then 
		local vo = {rid = rid, srv_id = srv_id}
		ChatController:getInstance():openFriendInfo(vo,cc.p(0,0))
	end
end

function CommonRankWindow:setSelfRankInfo()
    if not self.role_head then
        self.role_head = PlayerHead.new(PlayerHead.type.circle)
        self.role_head:setHeadLayerScale(0.95)
        self.role_head:setLev(99)
        self.my_head:addChild(self.role_head)
    end

    local role_vo = RoleController:getInstance():getRoleVo()
    if self.rank_data and role_vo then
        self.my_role_name:setString(role_vo.name)
        local my_idx = self.rank_data.my_idx or self.rank_data.my_rank
        if my_idx and my_idx <= 3 then
            if self.rank_num ~= nil then
                self.rank_num:setVisible(false)
            end
            if my_idx == 0 then
                self.my_rank_img:setVisible(false)
                self.no_rank:setVisible(true)
            else
                self.no_rank:setVisible(false)
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", my_idx))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id  = res_id
                    loadSpriteTexture(self.my_rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.my_rank_img:setVisible(true)
            end
        else
            if self.rank_num == nil then
                self.rank_num = CommonNum.new(1, self.my_container, 1, -2, cc.p(0.5, 0.5))
                self.rank_num:setPosition(59,77)
            end
            self.rank_num:setVisible(true)
            self.rank_num:setNum(my_idx)
            self.my_rank_img:setVisible(false)
        end
        local my_val1 = self.rank_data.my_val1 or self.rank_data.my_hurt
        self.role_value:setString(my_val1)
        self.value_tip:setString(RankConstant.RankRewardValTips[self.rank_type] or "")

        self.role_head:setHeadRes(role_vo.face_id, false, LOADTEXT_TYPE, role_vo.face_file, role_vo.face_update_time)
        self.role_head:setLev(role_vo.lev)
        local avatar_bid = role_vo.avatar_base_id
        local vo = Config.AvatarData.data_avatar[avatar_bid]
        if vo then
            local res_id = vo.res_id or 1
            local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
            self.role_head:showBg(res, nil, false, vo.offy)
        end
    end
end


function CommonRankWindow:close_callback(  )
    if self.scroll_view then
        self.scroll_view:DeleteMe()
        self.scroll_view = nil
    end
    if self.player_info_panel then
        self.player_info_panel:DeleteMe()
        self.player_info_panel = nil
    end
    controller:openCommonRankWindow(false)
end


CommonRankItem = CommonRankItem or class("CommonRankItem", function()
	return ccui.Widget:create()
end)

function CommonRankItem:ctor()
end

function CommonRankItem:setExtendData(list)
    local node = list[1]
    local rank_type = list[2]
    if not tolua.isnull(node) and self.root_wnd == nil then
		local size = node:getContentSize()
		self:setAnchorPoint(cc.p(0.5, 0.5))
		self:setContentSize(size)
		self.root_wnd = node:clone()
		self.root_wnd:setVisible(true)
		self.root_wnd:setAnchorPoint(0.5, 0.5)
		self.root_wnd:setPosition(size.width * 0.5, size.height * 0.5) 
        self:addChild(self.root_wnd)

        self.rank_img = self.root_wnd:getChildByName("rank_img")
        self.rank_img:ignoreContentAdaptWithSize(true)
        self.role_name = self.root_wnd:getChildByName("role_name")
        self.role_value = self.root_wnd:getChildByName("role_value")
        self.value_tip = self.root_wnd:getChildByName("value_tip")
        self.value_tip:setString(RankConstant.RankRewardValTips[rank_type] or "")
    end
end

function CommonRankItem:setData(data)
        self.data = data
		local srv_name = getServerName(data.srv_id)
        self.role_name:setString(string_format("[%s]",srv_name)..data.name)

        if not self.role_head then
            self.role_head = PlayerHead.new(PlayerHead.type.circle)
            self.role_head:setHeadLayerScale(0.95)
            self.role_head:setLev(99)
            self.role_head:setPosition(185, 65)
            self.root_wnd:addChild(self.role_head)
        end
        self.role_head:setHeadRes(data.face_id or data.face, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
        self.role_head:setLev(data.lev)
        self.role_head:addCallBack(handler(self, self.openChatMessage))

        local avatar_bid = data.avatar_id or data.lookid 
        local vo = Config.AvatarData.data_avatar[avatar_bid]
        if vo then
            local res_id = vo.res_id or 1
            local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
            self.role_head:showBg(res, nil, false, vo.offy)
        end
        local _rank = data.idx or data.rank
        if _rank <= 3 then
            if self.rank_num ~= nil then
                self.rank_num:setVisible(false)
            end
            if _rank == 0 then
                self.rank_img:setVisible(false)
            else
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", _rank))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id = res_id
                    -- loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                    self.rank_img:loadTexture(res_id, LOADTEXT_TYPE_PLIST)
                    self.rank_img:ignoreContentAdaptWithSize(true)
                end
                self.rank_img:setVisible(true)
            end
        else
            if self.rank_num == nil then
                self.rank_num = CommonNum.new(1, self.root_wnd, 1, -2, cc.p(0.5, 0.5))
                self.rank_num:setPosition(59, 77)
            end
            self.rank_num:setVisible(true)
            self.rank_num:setNum(_rank)
            self.rank_img:setVisible(false)
        end
        self.role_value:setString(data.val1 or data.max_hurt_str)
end

function CommonRankItem:openChatMessage()
	local roleVo = RoleController:getInstance():getRoleVo()
	local rid = self.data.rid
	local srv_id  = self.data.srv_id
	if self.data.srv_id and self.data.srv_id == "robot" then 
		message(TI18N("语言_c_476"))
		return
	end
	if rid and srv_id and roleVo.rid== rid and roleVo.srv_id == srv_id then 
		message(TI18N("语言_c_349"))
		return 
	end
	if self.data then 
		local vo = {rid = rid, srv_id = srv_id}
		ChatController:getInstance():openFriendInfo(vo,cc.p(0,0))
	end
end

function CommonRankItem:DeleteMe()
	self:removeAllChildren()
	self:removeFromParent()
end
