-- --------------------------------------------------------------------
-- 失落之塔铭刻行界面
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
RankLostTowerWindow = RankLostTowerWindow or BaseClass(BaseView)
function RankLostTowerWindow:__init(index)
    self.ctrl = RankController:getInstance()
    self.win_type = WinType.Mini   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG   
    self.layout_name = "rank/rank_lostTower_window"
    self.click_index = index or 1
    self.periods_list = {}
    self.page_index = 0
    self.hero_item_list = {}
    self.cell_width = 119*0.54
    self.nine_position = {
        [1] = cc.p(self.cell_width * 2.5 + 6, self.cell_width * 0.5 + 2),
        [2] = cc.p(self.cell_width * 2.5 + 6, self.cell_width * 1.5 + 5),
        [3] = cc.p(self.cell_width * 2.5 + 6, self.cell_width * 2.5 + 7),
        [4] = cc.p(self.cell_width * 1.5 + 4, self.cell_width * 0.5 + 2),
        [5] = cc.p(self.cell_width * 1.5 + 4, self.cell_width * 1.5 + 5),
        [6] = cc.p(self.cell_width * 1.5 + 4, self.cell_width * 2.5 + 7),
        [7] = cc.p(self.cell_width * 0.5 + 2, self.cell_width * 0.5 + 2),
        [8] = cc.p(self.cell_width * 0.5 + 2, self.cell_width * 1.5 + 5),
        [9] = cc.p(self.cell_width * 0.5 + 2, self.cell_width * 2.5 + 7),
    }
    self.role_vo = RoleController:getInstance():getRoleVo()
end

function RankLostTowerWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_panel , 1)
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.title_con = self.main_panel:getChildByName("title_con")
    self.Image_17 = self.title_con:getChildByName("Image_17")
    self.title_label = self.title_con:getChildByName("title_label")
    self.title_label:setString(RankConstant.TitleName[self.click_index] or "")
    self.Image_17:setContentSize(cc.size(self.title_label:getContentSize().width + 100,63))

    self.choose_txt = self.main_panel:getChildByName("choose_txt")
    self.choose_txt:setString(TI18N("语言_c_130"))
    self.right_btn = self.main_panel:getChildByName("right_btn")
    self.right_btn:setVisible(false)
    self.left_btn = self.main_panel:getChildByName("left_btn")
    self.left_btn:setVisible(false)
    self.date_txt = self.main_panel:getChildByName("date_txt")

    self.rank_panel = self.main_panel:getChildByName("rank_panel")
    self.one_img = self.rank_panel:getChildByName("txt_cn_lost_tower_rank_7_3")
    self.opponent_panel = self.rank_panel:getChildByName("opponent_panel")
    self.opponent_model = self.opponent_panel:getChildByName("opponent_model")
    self.opponent_name = self.opponent_panel:getChildByName("opponent_name")
    self.opponent_power_bg = self.opponent_panel:getChildByName("opponent_power_bg")
    self.opponent_power_icon = self.opponent_panel:getChildByName("opponent_power_icon")
    self.opponent_power = self.opponent_panel:getChildByName("opponent_power")
    self.vacant_position_txt = self.opponent_panel:getChildByName("vacant_position_txt")
    self.vacant_position_txt:setString(TI18N("语言_c_526"))
    self.fight_panel = self.rank_panel:getChildByName("fight_panel")
    local pos = {2,4,6,7,9,1}--一开始默认 第一个阵法位置
    for index=1,6 do
        self.hero_item_list[index] = HeroExhibitionItem.new(0.5, false)
        self.hero_item_list[index]:setPosition(self.nine_position[pos[index]])
        self.fight_panel:addChild(self.hero_item_list[index])
		self.hero_item_list[index]:setSwallowTouches(false)
    end

    self.my_panel = self.main_panel:getChildByName("my_panel")
    self.my_title_bg = self.my_panel:getChildByName("my_title_bg")
    self.my_title_txt = self.my_panel:getChildByName("my_title_txt")
    self.my_title_txt:setString(TI18N("语言_c_5932"))
    self.my_attk_label = self.my_panel:getChildByName("my_attk_label")
    self.my_name_label = self.my_panel:getChildByName("my_name_label")
    self.my_rank = self.my_panel:getChildByName("my_rank")
    self.head = PlayerHead.new(PlayerHead.type.circle)
	self.head:setPosition(120, 60)
	self.my_panel:addChild(self.head)
	self.head:setSwallowTouches(false)
    self.head:setHeadRes(self.role_vo.face_id,false, LOADTEXT_TYPE, self.role_vo.face_file, self.role_vo.face_update_time)
	self.head:setLev(self.role_vo.lev)
    self.my_name_label:setString(self.role_vo.name)
    self.my_attk_label:setString(MoneyTool.moneyFormat(self.role_vo.power))
end

function RankLostTowerWindow:register_event()
    self.background:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self.ctrl:openRankLostTowerView(false)
        end
    end)
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self.ctrl:openRankLostTowerView(false)
        end
    end)
    self.right_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self:clickPageBtn(true)
        end
    end)
    self.left_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self:clickPageBtn(false)
        end
    end)
    if not self.LostTowerChallengerData then
        self.LostTowerChallengerData = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerChallengerData,function(data)
            if not data then return end
            self:setData(data)
        end
        )
    end
    if not self.LostTowerPeriodsData then
        self.LostTowerPeriodsData = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerPeriodsData,function(data)
            if not data then return end
            self:setmyRank(data)
        end
        )
    end
end

function RankLostTowerWindow:openRootWnd(data)
    self:setData(data)
    -- ActionController:getInstance():sender21913()
end

function RankLostTowerWindow:clickPageBtn(status)
    if status then
        self.page_index = self.page_index + 1
    else
        self.page_index = self.page_index - 1
    end
    self:setPageBtn()
    self:setPanel(self.show_list[self.page_index])
    self:setTitle()
end

function RankLostTowerWindow:setTitle()
    self.choose_txt:setString(string.format(TI18N("语言_c_5931"),self.page_index))
end

function RankLostTowerWindow:setPageBtn()
    self.right_btn:setVisible(true)
    self.left_btn:setVisible(true)
    if self.page_index <= 1 then
        self.left_btn:setVisible(false)
    end
    if self.page_index >= tableLen(self.show_list) then
        self.right_btn:setVisible(false)
    end
end

function RankLostTowerWindow:setData(data)
    if not data then return end
    self.data = data
    local list = deepCopy(data.winner_list)
    table.sort(list,function(a,b)
        return a.end_time < b.end_time
    end)
    self.show_list = list or {}
    self.page_index = tableLen(self.show_list)
    self:setPageBtn()
    self:setPanel(self.show_list[self.page_index])
    self:setTitle()
end

function RankLostTowerWindow:setmyRank(data)
    local stage = data.stage
    if stage == 0 or not stage then
        stage = 1
    end
    self.camp_id = data.camp_id 
    local cfg = Config.HolidayLostTowerData.data_lv_info[self.camp_id]
    if cfg then
        for key, value in pairs(cfg) do
            if value.lv == stage then
                local res = PathTool.getResFrame("lost_tower",value.lv_icon)
                loadSpriteTexture(self.my_rank,res,LOADTEXT_TYPE_PLIST)
            end        
        end
    end
end

function RankLostTowerWindow:setPanel(data)
    if not data then return end
    if data.face_id ~= 0 then
        self.opponent_name:setVisible(true)
        self.opponent_power:setVisible(true)
        self.opponent_power_icon:setVisible(true)
        self.opponent_power_bg:setVisible(true)
        ActionController:getInstance():sender21915(data.end_time)
        self.vacant_position_txt:setVisible(false)
        self.opponent_name:setString(string.format("[%s]%s", getServerName(data.srv_id),data.name))
        self.opponent_power:setString(MoneyTool.moneyFormat(data.power or 0))
        self:updateSpine(data.look_id)
        self:updateFormation(data)
    else
        self.vacant_position_txt:setVisible(true)
        self.opponent_name:setVisible(false)
        self.opponent_power:setVisible(false)
        self.opponent_power_icon:setVisible(false)
        self.opponent_power_bg:setVisible(false)
    end
	self.camp_id = data.camp_id
    local cfg = Config.HolidayLostTowerData.data_lv_info[self.camp_id]
    if cfg then
        local res = PathTool.getResFrame("lost_tower",cfg[#cfg].lv_icon)
        loadSpriteTexture(self.one_img,res,LOADTEXT_TYPE_PLIST)
    end
    if data.end_time ~= 0 and data.start_time ~= 0 then
        local str = TI18N("%s - %s")
        self.date_txt:setString(string.format(str,TimeTool.getZoneYMD(data.start_time),TimeTool.getZoneYMD(data.end_time)))
    end
end

--布阵
function RankLostTowerWindow:updateFormation(data)
    table.sort(data.p_list,function(a,b)
        return a.pos < b.pos
    end)
    local formation_config = Config.FormationData.data_six_form_data[data.formation_type or 1]
    if formation_config then
        self:initFormationData(formation_config,data)
    end
end

function RankLostTowerWindow:initFormationData( formation_config, data)
    if not formation_config then return end
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
	local width = self.cell_width - 10
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        dic_pos_index[pos] = index
        --更新位置
        if self.hero_item_list[index] then
            self.hero_item_list[index]:setPosition(self.nine_position[pos])
        end
        if pos <= 3 then
            self.pos_name_list[index] = 1 --位置 前
        elseif pos > 3 and pos <= 6 then
            self.pos_name_list[index] = 2 --位置 中
        else
            self.pos_name_list[index] = 3 --位置 后
        end

        local x = self.nine_position[pos].x
        local y = self.nine_position[pos].y
        local rect = cc.rect( x - width*0.6 ,y - width*0.6 , width, width)
        self.pos_rect_list[index] = rect
        local hero_data = data.p_list[index]
		self.hero_item_list[index]:setData(hero_data)
    end
end

--更新模型,也是初始化模型
function RankLostTowerWindow:updateSpine(look_id, pos_index)
    if not self.opponent_model then return end
    local fun = function()
        if not self.opponent_model.spine then
            self.opponent_model.spine = BaseRole.new(BaseRole.type.role, look_id)
            self.opponent_model.spine:setAnimation(0,PlayerAction.show,true) 
            self.opponent_model.spine:setCascade(true)
            self.opponent_model.spine:setPosition(cc.p(100,220))
            self.opponent_model.spine:setAnchorPoint(cc.p(0.5,0.5)) 
            self.opponent_model.spine:setScale(0.8)
            self.opponent_model:addChild(self.opponent_model.spine) 
            self.opponent_model.spine:setCascade(true)
            self.opponent_model.spine:setOpacity(0)
            local action = cc.FadeIn:create(0.2)
            self.opponent_model.spine:runAction(action)
        end
    end
    if self.opponent_model.spine then
        self.opponent_model.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        self.opponent_model.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
            doStopAllActions(self.opponent_model.spine)
            self.opponent_model.spine:removeFromParent()
            self.opponent_model.spine = nil
            fun()
        end)))
    else
        fun()
    end
end

function RankLostTowerWindow:close_callback()
    if self.LostTowerChallengerData then
        GlobalEvent:getInstance():UnBind(self.LostTowerChallengerData)
        self.LostTowerChallengerData = nil
    end
    if self.LostTowerPeriodsData then
        GlobalEvent:getInstance():UnBind(self.LostTowerPeriodsData)
        self.LostTowerPeriodsData = nil
    end
end
