MinigameFollowBattleResult = class("MinigameFollowBattleResult", function()
    return ccui.Widget:create()
end)
local controller = MinigameFollowController:getInstance()

function MinigameFollowBattleResult:ctor()
    local scene = cc.Director:getInstance():getRunningScene()
    scene:addChild(self)
    self:setPosition(cc.p(display.width/2, display.height/2))
    self.confirm_callback = confirm_callback or {}
    self.effect_cache_list = {}
    self.item_list = {}
    self:configUI()
    self:register_event()
end

function MinigameFollowBattleResult:configUI()
    local csbPath = PathTool.getTargetCSB("minigamefollow/minigamefollow_battle_result")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setAnchorPoint(cc.p(0.5, 0.5))

    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")

    self.fail_bg = container:getChildByName("fail_bg")
    self.fail_bg.text_des = self.fail_bg:getChildByName("text_des")
    self.fail_bg.text_des:setTextAreaSize(cc.size(700,0))
    self.fail_bg.text_des:setString(TI18N("语言_c_g_94"))
    self.fail_bg.text_des:setVisible(false)

    self.success_bg = container:getChildByName("success_bg")
    local Sprite_7 = self.success_bg:getChildByName("Sprite_7")
    -- self.wins_label = self.success_bg:getChildByName("wins_label")

    -- self.text_level = self.success_bg:getChildByName("text_level")
    -- self.sp_up = self.success_bg:getChildByName("sp_up")
    
    self.text_reward_des = self.success_bg:getChildByName("text_reward_des")
    self.text_reward_des:setString(TI18N("语言_c_g_79"))
    local image_mark_1 = self.success_bg:getChildByName("image_mark_1")
    image_mark_1:setPositionX(self.text_reward_des:getPositionX() - self.text_reward_des:getContentSize().width/2 - 50)
    local image_mark_2 = self.success_bg:getChildByName("image_mark_2")
    image_mark_2:setPositionX(self.text_reward_des:getPositionX() + self.text_reward_des:getContentSize().width/2 + 50)
    self.layout_item = self.success_bg:getChildByName("layout_item")

    self.title_container = self.root_wnd:getChildByName("title_container")
    self.title_width = self.title_container:getContentSize().width
    self.title_height = self.title_container:getContentSize().height

    self.container = container

    self.Sprite_1 = self.success_bg:getChildByName("Sprite_1")
    if self.sprite_1_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_97")
        self.sprite_1_load = loadSpriteTextureFromCDN(self.Sprite_1, res, ResourcesType.single, self.sprite_1_load)
    end
    
    self.Sprite_2 = self.success_bg:getChildByName("Sprite_2")
    if self.sprite_2_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_98")
        self.sprite_2_load = loadSpriteTextureFromCDN(self.Sprite_2, res, ResourcesType.single, self.sprite_2_load)
    end

    self.next_btn = self.success_bg:getChildByName("next_btn") 
    self.next_btn:setName("next_btn")
    local label = self.next_btn:getChildByName("label") 
    label:setString(TI18N("语言_c_g_130"))
    self.back_btn = self.success_bg:getChildByName("back_btn") 
    self.back_btn:setName("back_btn")
    local label = self.back_btn:getChildByName("label") 
    label:setString(TI18N("语言_c_g_129"))
end

function MinigameFollowBattleResult:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            if self.data.result == 2 then
                playCloseSound()
                controller:openMinigameFollowBattleResult(false)
                MinigameFollowController:getInstance():openMinigameFollowview(false)
                GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
            end
        end
    end)
    registerButtonEventListener(self.next_btn, function()
        MinigameFollowController:getInstance():openMinigameFollowBattleResult(false)
        local level_id = MinigameMainController:getInstance():getMinigameFollowWindows():getSelectLevel()
        local config =  Config.MinigameMainData.data_new_level_info[level_id + 1]
        if config then
            local cur_level_id = MinigameMainController:getInstance():getModel():getCurLevel()
            local role_vo = RoleController:getInstance():getRoleVo()
            local lock_lv = true--role_vo.lev >= config.unlock_condition
            if level_id + 1 > cur_level_id or not lock_lv then
                MinigameFollowController:getInstance():openMinigameFollowview(false)
                GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
                message(TI18N("语言_c_g_145"))
                return
            end
            MinigameMainController:getInstance():getMinigameFollowWindows():setSelectLevel(level_id + 1)
            -- MinigameMainController:getInstance():sender29511(level_id + 1)
            local status = MinigameMainController:getInstance():getModel():launchBattle()
            if not status then
                message(TI18N("语言_s_64"))
                MinigameFollowController:getInstance():openMinigameFollowview(false)
                GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
                return
            end
            MinigameMainController:getInstance():startMinigame(level_id + 1)
        else
            MinigameFollowController:getInstance():openMinigameFollowview(false)
            GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
        end
    end,true, 1)
    -- registerButtonEventListener(self.back_btn, function()
    --     playCloseSound()
    --     controller:openMinigameFollowBattleResult(false)
    --     local level_id = MinigameMainController:getInstance():getMinigameFollowWindows():getSelectLevel()
    --     local config =  Config.MinigameMainData.data_new_level_info[level_id + 1]
    --     if config then
    --         MinigameMainController:getInstance():getMinigameFollowWindows():setSelectLevel(level_id + 1)
    --     end
    --     MinigameFollowController:getInstance():openMinigameFollowview(false)
    --     GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
    -- end,true, 1)
    self.back_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            if sender.guide_call_back ~= nil then
                sender.guide_call_back(sender)
            end
            controller:openMinigameFollowBattleResult(false)
            local fwindow = MinigameMainController:getInstance():getMinigameFollowWindows()
            if fwindow then
                local level_id = fwindow:getSelectLevel()
                local config =  Config.MinigameMainData.data_new_level_info[level_id + 1]
                if config then
                    fwindow:setSelectLevel(level_id + 1)
                end
            end
            MinigameFollowController:getInstance():openMinigameFollowview(false)
            GlobalEvent:getInstance():Fire(MinigameMainEvent.game_finish_event)
        end
    end)
end


function MinigameFollowBattleResult:handleEffect(status)
    if status == false then
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
        if self.play_effect2 then
            self.play_effect2:clearTracks()
            self.play_effect2:removeFromParent()
            self.play_effect2 = nil
        end
    else
        local effect_id = 103
        local action = PlayerAction.action_2
        local effect_partner = self.title_container
        if self.data.result == 2 then
            effect_id = 104
            action = PlayerAction.action
            effect_partner = self.fail_bg
        end
        if not tolua.isnull(effect_partner) and self.play_effect == nil then
            self.play_effect = createEffectSpine(PathTool.getEffectRes(effect_id), cc.p(effect_partner:getContentSize().width*0.5,effect_partner:getContentSize().height*0.5), cc.p(0.5, 0.5), false, action)
            effect_partner:addChild(self.play_effect, 1)
        end
        if not tolua.isnull(self.title_container) and self.play_effect2 == nil then
			if self.data.result == 1 then
				self.play_effect2 = createEffectSpine("E51022", cc.p(self.title_width * 0.5, self.title_height * 0.5), cc.p(0.5, 0.5), true, PlayerAction.action)
				self.title_container:addChild(self.play_effect2, 1)
			end
		end
        
    end
end

function MinigameFollowBattleResult:open(data)
    if data ~= nil then
        self.data = data
        -- self:setBaseInfo()
        self:setRewardsList()
        self.success_bg:setVisible(data.result == 1)
        self.fail_bg:setVisible(data.result == 2)
        self:handleEffect(true)
        -- if data.result == 2 then
        --     playOtherSound("b_win", AudioManager.AUDIO_TYPE.BATTLE)
        -- end
    end
end

