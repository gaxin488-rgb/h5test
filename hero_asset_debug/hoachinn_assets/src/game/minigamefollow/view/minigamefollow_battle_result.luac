function MinigameFollowBattleResult:setRewardsList()
    -- if self.data == nil or self.data.items == nil or next(self.data.items) == nil then return end
    local config = Config.MinigameMobcontrol2Data.data_level_dif_info[self.data.level]
    local items = self.data.item_rewards or {} -- config.up_award
    local scale = 0.8
    local off = 40
    local _x, _y = 0, 35
    local item_conf = nil
    local index = 1
    local item = nil
    local total_width = #items*BackPackItem.Width * scale + off*(#items-1)
    local start_x = (self.layout_item:getContentSize().width - total_width)/2
    for i, v in ipairs(items) do
        item_conf = Config.ItemData.data_get_data(v.bid)
        if item_conf then
            if self.item_list[index] == nil then
                item = BackPackItem.new(false, false, false, scale, false, true)
                self.layout_item:addChild(item)
                table.insert(self.item_list, item)
            end
            item = self.item_list[index]
            
            _x = start_x + (BackPackItem.Width * scale + off) * (index-1) + BackPackItem.Width*scale*0.5
            item:setPosition(_x, _y)
            item:setBaseData(v.bid, v.num)
            -- item:setExtendDesc(true, item_conf.name, 1)
            index = index + 1
        end
    end 
end

function MinigameFollowBattleResult:DeleteMe()
end

function MinigameFollowBattleResult:close()
    if self.sprite_1_load then
        self.sprite_1_load:DeleteMe()
        self.sprite_1_load = nil
    end

    if self.sprite_2_load then
        self.sprite_2_load:DeleteMe()
        self.sprite_2_load = nil
    end

    for k,v in pairs(self.item_list) do
        v:DeleteMe()
    end
    self.item_list = nil
    doStopAllActions(self.container)
    self:handleEffect(false)
    self:removeFromParent()
end