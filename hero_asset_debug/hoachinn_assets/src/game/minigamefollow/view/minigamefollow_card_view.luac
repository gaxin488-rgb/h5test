MinigameFollowCardItem = class("MinigameFollowCardItem", function()
	return ccui.Layout:create()
end)

local lv_star_pos = {
    [1] = {cc.p(78, 20)},
    [2] = {cc.p(68, 15),cc.p(89, 25)},
    [3] = {cc.p(58, 15),cc.p(73, 25),cc.p(88, 15),cc.p(103, 25)},
    [4] = {cc.p(51, 15),cc.p(60, 25),cc.p(69, 15),cc.p(78, 25),cc.p(87, 15),cc.p(96, 25),cc.p(105, 15),cc.p(114, 25)},
    [5] = {},
}

function MinigameFollowCardItem:ctor(info)
    self.card_id = info.card_id
    self.index = info.index
    self.partner = info.partner
    self.up_num = info.up_num

    self.cd_time = 0
    self.can_use = true

    local size = cc.size(129, 171)
    self:setContentSize(size)
    self:setAnchorPoint(0.5, 0.5)
    info.partner:addChild(self)
    self:setCascadeOpacityEnabled(true)

    local csbPath = PathTool.getTargetCSB("minigame/minigame_battle_card")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.image_skill_icon = self.root_wnd:getChildByName("image_skill_icon") 
    self.level_label = self.image_skill_icon:getChildByName("level_label") 
    self.level_label.level_label_num = self.level_label:getChildByName("level_label_num")  
    self.sp_level = self.image_skill_icon:getChildByName("sp_level") 

    self.layout_cd = self.image_skill_icon:getChildByName("layout_cd") 
    self.layout_cd.size = self.layout_cd:getContentSize()
    self.layout_cd:setContentSize(cc.size(self.layout_cd.size.width, 0))

    self.sp_star_list = {}
    for i = 1, 8, 1 do
        local sp_star_dark = self.image_skill_icon:getChildByName("sp_star_dark"..i) 
        sp_star_dark.sp_star_bright = sp_star_dark:getChildByName("sp_star_bright") 
        sp_star_dark.sp_star_bright:setVisible(false)
        sp_star_dark:setVisible(false)
        self.sp_star_list[#self.sp_star_list + 1] = sp_star_dark
    end
    self.sp_star_max = self.image_skill_icon:getChildByName("sp_star_max")

    self:updateUI()
end

function MinigameFollowCardItem:updateUI()
    if self.card_id then
        local config = Config.MinigameMobcontrol2Data.data_strategy_info[self.card_id]
        if config.res and config.res ~= "" then
            local image_name, image_type,image_plist = minigamefolowModel:getImageType(config.res)
            self.image_skill_icon:loadTexture(PathTool.getMinigameFollowRes(image_name,image_type, image_plist), image_type)
            self.level_label:setString(TI18N("语言_c_g_109")) 
            self.level_label.level_label_num:setString(self.card_id%10)
            ccui.Helper:doLayout(self.level_label)
            local res = "minigame_mobcontrol2_"..self.card_id%10
            loadSpriteTexture(self.sp_level, PathTool.getMinigameFollowRes(res,1), 1)
        end
        self.level_label:setVisible(true)
        self.sp_level:setVisible(true)

        local pos_list = lv_star_pos[self.card_id%10]
        local dark_star_num = #pos_list
        local bright_star_num = self.up_num
        for i, v in ipairs(self.sp_star_list) do
            if pos_list[i] then
                v:setPosition(pos_list[i])
            end
            v:setVisible(dark_star_num >= i)
            v.sp_star_bright:setVisible(bright_star_num >= i)
        end
    else
        self.level_label:setVisible(false)
        self.sp_level:setVisible(false)
        self.image_skill_icon:loadTexture(PathTool.getMinigameFollowRes("minigame_mobcontrol2_12",1), 1)
    end

    -- self.label = createLabel(30, cc.c3b(100,100,100), nil, size.width/2, 15, "self.card_id", self, nil, cc.p(0.5, 0.5))

    self:setPosition(cc.p(720, self.partner:getContentSize().height/2))
    local pos = cc.p(86 + 138*(self.index - 1), self.partner:getContentSize().height/2 + 40)
    -- self:runAction(cc.MoveTo:create(0.1, pos))
    self:setPosition(pos)
end
 
function MinigameFollowCardItem:updateIndex(index)
    self.index = index
end

function MinigameFollowCardItem:updatePos()
    local pos = cc.p(720/5/2 + 720/5*(self.index - 1), self.partner:getContentSize().height/2 + 40)
    self:stopAllActions()
    self:setPosition(pos)
end

function MinigameFollowCardItem:fusingSuccess()
    self.card_id = self.card_id + 1
    -- self.label:setString(self.card_id)
    local config = Config.MinigameMobcontrol2Data.data_strategy_info[self.card_id]
    local image_name, image_type,image_plist = minigamefolowModel:getImageType(config.res)
    self.image_skill_icon:loadTexture(PathTool.getMinigameFollowRes(image_name,image_type, image_plist), image_type)
    self.level_label:setString("Lv.") 
    ccui.Helper:doLayout(self.level_label)
    local res = "minigame_mobcontrol2_"..self.card_id%10
    loadSpriteTexture(self.sp_level, PathTool.getMinigameFollowRes(res,1), 1)
end

function MinigameFollowCardItem:addCardCount(callback)
    self.up_num = self.up_num + 1
    local cost_list = {0, 1, 2, 4, 8}
    local target_id = self.card_id + 1
    local config = Config.MinigameMobcontrol2Data.data_strategy_info[target_id]
    self:updateUI()
    if config then
        local cost_num = cost_list[target_id%10]
        if self.up_num >= cost_num then -- synthetic success
            self.can_use = false
            callback(1, function()
                self.card_id = self.card_id + 1
                self.up_num = 0
                self:updateUI() 
                self.can_use = true
            end)
            -- self:runAction(cc.Sequence:create(cc.DelayTime:create(0.2),cc.FadeOut:create(0.2), cc.CallFunc:create(function()
            --     self.card_id = self.card_id + 1
            --     self.up_num = 0
            --     self:updateUI() 
            -- end), cc.FadeIn:create(0.2), cc.CallFunc:create(function()
            --     self.can_use = true
            -- end)))

        end
        callback(0)
    else -- reduce cd time
        callback(0)
    end
end

function MinigameFollowCardItem:updateCdTime()
    self.cd_time = GameNet:getInstance():getTimeFloat()
end

function MinigameFollowCardItem:getCdCount()
    local cur_time = GameNet:getInstance():getTimeFloat()
    local config = Config.MinigameMobcontrol2Data.data_strategy_info[self.card_id]
    local cd_list = Config.MinigameMobcontrol2Data.data_const["card_skill_cd"].val
    local cd_count = cd_list[config.type]/1000
    local next_cfg = Config.MinigameMobcontrol2Data.data_strategy_info[self.card_id + 1]
    local extra_cd = Config.MinigameMobcontrol2Data.data_const["extra_cd"].val
    local extra_cd_cap = Config.MinigameMobcontrol2Data.data_const["extra_cd_cap"].val
    if not next_cfg then
        cd_count = cd_count - math.min(self.up_num*extra_cd, extra_cd_cap)
    end
    return cd_count
end

function MinigameFollowCardItem:checkUseTime()
    local cur_time = GameNet:getInstance():getTimeFloat()
    local cd_count = self:getCdCount()
    if cur_time - self.cd_time >= cd_count then
        self.cd_time = GameNet:getInstance():getTimeFloat()
        return true
    end
    return false
end

function MinigameFollowCardItem:updateCdUI()
    local size = clone(self.layout_cd.size)
    local cd_count = self:getCdCount()
    local cur_time = GameNet:getInstance():getTimeFloat()
    local cur_count = cur_time - self.cd_time
    local percent = math.min(cur_count/cd_count, 1)
    size.height = size.height*(1 - percent)
    self.layout_cd:setContentSize(size)
end