

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- @description:
--      
-- <br/>Create: new Date().toISOString()
--
-- --------------------------------------------------------------------
MinigameFollowAlert = class("MinigameFollowAlert", function()
    return ccui.Widget:create()
end)
local controller = MinigameFollowController:getInstance()

function MinigameFollowAlert:ctor(parent, confirm_callback, label_list)
    self.parent = parent
    self.label_list = label_list or {}
    self.parent:addChild(self, 1000)
    self:setPosition(cc.p(self.parent:getContentSize().width/2, self.parent:getContentSize().height/2))
    self.confirm_callback = confirm_callback
    self:configUI()
    self:register_event()
end

function MinigameFollowAlert:configUI()
    local csbPath = PathTool.getTargetCSB("common/common_alert")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setAnchorPoint(cc.p(0.5, 0.5))

    self.background_panel = self.root_wnd:getChildByName("background_panel")
    self.background_panel:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_panel")
    
    local mainsize = self.main_panel:getContentSize()
    self.MAIN_WIDTH = mainsize.width
    self.MAIN_HEIGHT = mainsize.height

    self.alert_panel = self.main_panel:getChildByName("main_container")
    self.alert_panel:setTouchEnabled(true)
    self.WIDTH = self.alert_panel:getContentSize().width
    local pos = cc.p(self.alert_panel:getContentSize().width/2, self.alert_panel:getContentSize().height/2)
    self.alert_txt = createRichLabel(22, 175, cc.p(0.5, 0.5), pos, nil, nil, 560)
    self.alert_panel:addChild(self.alert_txt)
    local str = self.label_list.content or TI18N("语言_c_g_147")
    self.alert_txt:setString(str)
    
    self.title_contaier = self.main_panel:getChildByName("title_container")
    self.title_contaier:setVisible(true)
    self.title_label = self.title_contaier:getChildByName("title_label")
    self.title_label:setString( self.label_list.title or TI18N("语言_c_154"))

    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_btn.label = self.ok_btn:getChildByName("label")
    self.ok_btn.label:setString(self.label_list.ok_label or TI18N("语言_c_1118"))
    self.ok_btn.x = self.ok_btn:getPositionX()

    self.cancel_btn = self.main_panel:getChildByName("cancel_btn")
    self.cancel_btn.label = self.cancel_btn:getChildByName("label")
    self.cancel_btn.label:setString(self.label_list.cancel_label or TI18N("语言_c_1119"))
    self.cancel_btn.x = self.cancel_btn:getPositionX()

    self.ok_btn_0 = self.main_panel:getChildByName("ok_btn_0")
    self.ok_btn_0:setVisible(false)

    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.close_btn:setVisible(self.external_close_callback ~= nil)
end
function MinigameFollowAlert:register_event()
    self.ok_btn:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            local confirm_callback = self.confirm_callback
            self:close()
            if confirm_callback then
                confirm_callback()
            end
            self.confirm_callback = nil
        end
    end)

    if self.cancel_btn then
        self.cancel_btn:addTouchEventListener(function(sender, event_type)
            customClickAction_2(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                self:close()
            end
        end)
    end

    self.close_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playCloseSound() 
            self:close()
        end
    end)

    -- self.background_panel:addTouchEventListener(function(sender, event_type)
    --     if event_type == ccui.TouchEventType.ended then
    --         playCloseSound() 
    --         self:close()
    --     end
    -- end)
end

function MinigameFollowAlert:DeleteMe()
end

function MinigameFollowAlert:close()
    self:DeleteMe()
    self:removeFromParent()
end