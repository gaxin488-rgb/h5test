function MinigameFollowController:openMinigameFollowview(status, data)
    if not status then
        if self.minigamefollow_view ~= nil then
            self.minigamefollow_view:close()
            self.minigamefollow_view = nil
        end
    else
        if self.minigamefollow_view == nil then
            self.minigamefollow_view = MinigameFollowview.New(data)
        end
        self.minigamefollow_view:open()
    end
end

function MinigameFollowController:getMinigameFollowview()
    return self.minigamefollow_view
end

function MinigameFollowController:openMinigameFollowBattleResult(status, setting)
    if not status then
        if self.minigame_battle_result ~= nil then
            self.minigame_battle_result:close()
            self.minigame_battle_result = nil
        end
    else
        if self.minigame_battle_result == nil then
            self.minigame_battle_result = MinigameFollowBattleResult.new()
        end
        self.minigame_battle_result:open(setting)
    end
end
function MinigameFollowController:getMinigameResultWindowsRoot()
    if self.minigame_battle_result ~= nil then
        return self.minigame_battle_result.root_wnd
    end
    return 
end
function MinigameFollowController:checkCanPlayGuide()
    return self.minigame_battle_result ~= nil or self.minigamefollow_view ~= nil
end