MinigameFollowController = MinigameFollowController or BaseClass(BaseController)

function MinigameFollowController:config()
    self.model = MinigameFollowModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function MinigameFollowController:getModel()
    return self.model
end

