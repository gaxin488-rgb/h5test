MinigameFollowModel = MinigameFollowModel or BaseClass()


function MinigameFollowModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function MinigameFollowModel:config()
    self.base_data = {}

end

function MinigameFollowModel:setBaseData(data)
    -- {
    --     level = 1,
    -- }
    self.base_data = data
end

function MinigameFollowModel:getBaseData()
    return self.base_data
end

function  MinigameFollowModel:getCurLevel()
    return self.base_data.level or 1
end

function MinigameFollowModel:getCurChapter(level)
    local level = level or self:getCurLevel()
    local chapter_id = 1
    return chapter_id
end

function MinigameFollowModel:beginRun(data)
    -- {
    --     level_id = 101,
    -- }
    self.level_data = data
end

function MinigameFollowModel:getLevelId()
    return self.level_data.level_id
end

----tool
function MinigameFollowModel:getImageType(res)
    local str = string.split(res, ",")
    local image_name, image_type, image_plist = str[1], str[2], str[3]
    return image_name or "", tonumber(image_type or 0), image_plist or ""
end

function MinigameFollowModel:__delete()
end
