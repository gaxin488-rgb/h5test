    FirstReward = 6, --同国家第一奖励
    OverlordForm = 7, --本期天道战是否布阵
    Turntable = 8, --转盘可抽奖
    Worship = 9, --可点赞
    OrderTask = 10, --战令和任务
}
ArenaworldbullyConst.PreselectionRedType = {
