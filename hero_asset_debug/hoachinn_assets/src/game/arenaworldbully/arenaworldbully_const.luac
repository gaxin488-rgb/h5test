ArenaworldbullyConst = ArenaworldbullyConst or {} 

--忍者大师赛页签
ArenaworldbullyConst.Tab_Index ={
    Preselection = 1,  --预选赛
    Overlord   = 2   --争霸赛
} 
-- 忍者大师赛阶段
ArenaworldbullyConst.stage = {
    preview = 0,--预告
    signUp = 1,--报名
    preliminariesTruce = 2,--预选赛-休战
    preliminariesBattle = 3,--预选赛-战斗
    prepare = 4,--争霸赛-准备
    guess = 5,--争霸赛-竞猜
    match = 6,--争霸赛-匹配
    battle = 7,--争霸赛-战斗
    battle_settlement = 8,--争霸赛-战斗结算
    settlement = 9,--争霸赛-结算
    award = 10,--领奖
    close = 11,--关闭
    over = 99,--结束
}
