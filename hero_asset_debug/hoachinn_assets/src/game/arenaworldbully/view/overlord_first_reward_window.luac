OverlordFirstRewardWindow = OverlordFirstRewardWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function OverlordFirstRewardWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/overlord_first_reward_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function OverlordFirstRewardWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.imgTitleBg = self.main_container:getChildByName("image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_5062"))
	autoSizeTitleBg(self.win_title,self.imgTitleBg)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.my_log_panel = self.main_container:getChildByName("my_log_panel")
	self.no_log_image = self.main_container:getChildByName("no_log_image")
	self.tip = self.main_container:getChildByName("tip")
	setTextMaxWidth(self.tip,600)
	self.tip:setString(transformTextToShort(TI18N("语言_c_6757"),60))
	addEvt2showAllTextTips(self.tip,TI18N("语言_c_6757"),60)

	self.no_log_label = self.main_container:getChildByName("no_log_label")
	self.no_log_label:setString(TI18N("语言_c_273"))
	self.no_log_image:setVisible(false)
	self.no_log_label:setVisible(false)
	self.reward_btn = self.main_container:getChildByName("reward_btn")
	self.reward_txt = self.reward_btn:getChildByName("label")
	self.reward_txt:setString(TI18N("语言_c_8"))
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.enemy_title = self.title_bg:getChildByName("enemy_title")
	self.enemy_title:setString(TI18N("语言_c_6613"))
	self.more_title = self.title_bg:getChildByName("more_title")
	self.more_title:setString(TI18N("语言_c_5062"))
end

function OverlordFirstRewardWindow:openRootWnd()
	controller:sender14530()
end
function OverlordFirstRewardWindow:setData(data)
	self.data = data
	local list = {}
	if data and data.ext_list and next(data.ext_list) then
		for k, v in pairs(data.ext_list) do
			if v.state == 1 then
				table.insert(list,v)
			end
		end
	end
	if next(list) then
		if self.group_view == nil then
			local scroll_view_size = self.my_log_panel:getContentSize()
			local setting = {
				item_class = OverlordFirstRewardItem,      -- 单元类
				start_x = 0,                  -- 第一个单元的X起点
				space_x = 0,                    -- x方向的间隔
				start_y = 0,                    -- 第一个单元的Y起点
				space_y = 2,                   -- y方向的间隔
				item_width = 612,               -- 单元的尺寸width
				item_height = 165,              -- 单元的尺寸height
				row = 0,                        -- 行数，作用于水平滚动类型
				col = 1            
			}
			self.group_view = CommonScrollViewLayout.new(self.my_log_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
		end
		self.group_view:setData(list)
		self.no_log_image:setVisible(false)
		self.no_log_label:setVisible(false)
		self.my_log_panel:setVisible(true)
		self.group_view:setVisible(true)
		setChildUnEnabled(false,self.reward_btn)
		self.reward_btn:setTouchEnabled(true)
		addRedPointToNodeByStatus(self.reward_btn,true,10,10)
	else
		self.no_log_image:setVisible(true)
		self.no_log_label:setVisible(true)
		self.my_log_panel:setVisible(false)
		if self.group_view then
			self.group_view:setVisible(false)
		end
		setChildUnEnabled(true,self.reward_btn)
		self.reward_btn:setTouchEnabled(false)
		addRedPointToNodeByStatus(self.reward_btn,false)
	end
end
function OverlordFirstRewardWindow:_onClickBtnClose()
	controller:openOverlordFirstRewardWindow(false)
end
function OverlordFirstRewardWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.reward_btn, handler(self, self._onClickBtnReward), false, 2)
	if not self.update_over_first_reward then
        self.update_over_first_reward = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateOverFirstReward,function(data)
            self:setData(data)
        end)
    end
end

function OverlordFirstRewardWindow:_onClickBtnReward(  )
	controller:sender14531()
end

function OverlordFirstRewardWindow:close_callback(  )	
    if self.update_over_first_reward ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_over_first_reward)
        self.update_over_first_reward = nil
    end
	self:_onClickBtnClose()
end

--子项
OverlordFirstRewardItem = class("OverlordFirstRewardItem", function()
    return ccui.Widget:create()
end)

function OverlordFirstRewardItem:ctor()
    self:configUI()
    self:register_event()
end

function OverlordFirstRewardItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/overlord_first_reward_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(612,165))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("container")
    self.bg = self.main_container:getChildByName("bg")
	self.icon = self.main_container:getChildByName("icon")
	self.icon2 = self.main_container:getChildByName("icon_2")
	self.reward_panel = self.main_container:getChildByName("reward_panel")
    self.reward_panel:setScrollBarEnabled(false)
end

function OverlordFirstRewardItem:register_event( )
end

function OverlordFirstRewardItem:setData(data)
	self.data = deepCopy(data)
	local group_cfg = Config.ArenaTimeWarpData.data_group[data.group]
	if group_cfg then
		loadSpriteTexture(self.icon, PathTool.getResFrame("time_warp",group_cfg.fst_icon,false,"qualifier"), LOADTEXT_TYPE_PLIST)
	end
	local nation_cfg = Config.ArenaTimeWarpData.data_nation[model:getnation()]
	if nation_cfg then
		loadSpriteTexture(self.icon2, PathTool.getTargetRes("time_warp/region",nation_cfg.icon,false), LOADTEXT_TYPE)
	end
	local list = {}
	for k, v in pairs(self.data.item_list) do
		local _list = {}
		_list[1] = v.item_id
		_list[2] = v.item_num
		table.insert(list,_list)
	end
	local setting = {}
    setting.scale = 0.7
    setting.space_x = 2
    setting.max_count = 2
    self.item_list1 = commonShowSingleRowItemList(self.reward_panel, self.item_list1, list, setting)
end

function OverlordFirstRewardItem:DeleteMe()

end