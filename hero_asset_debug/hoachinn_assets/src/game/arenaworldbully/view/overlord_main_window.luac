--战区按钮切换
function OverlordMainWindow:_onClickBtnChange(  )
    local cfg = Config.ArenaTimeWarpData.data_zone
    local new_zone = 0
    if model:getLookZone() == #cfg then
        new_zone = 1
    else
        new_zone = model:getLookZone() + 1
    end
    model:setLookZone(new_zone)
    self.scroll_list = {}
    self:updateBagList()
    self:updateBtnChange()
    self.battle_group_date = Config.ArenaTimeWarpData.data_group[model:getOverGroupId(new_zone)]
    self:updateRaceSchedule()
    self:updateChangeBtnRed()
end
function OverlordMainWindow:updateChangeBtnRed()
    local new_zone = 1
    if model:getLookZone() == 1 then
        new_zone = 2
    end
    addRedPointToNodeByStatus(self.change_btn,model:getRankRed(new_zone),10,10)
end
function OverlordMainWindow:updateBtnChange(  )
    self.change_label:setString(model:getZoneName(model:getLookZone()))
end
function OverlordMainWindow:registerEvent()
    -- 分组第一转动
    if self.top5_change_event == nil then
        self.top5_change_event = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.Top5ChangeEvent, function(index)
            if not index then return end
            local num = 0
            if index > 4 then
                num = 8 - index
                for i = 1, num do
                    delayRun(self.list_panel,0.22*(i-1),function()
                        self.list_view:runRightPostion()
                    end)
                end
            else
                num = index - 1
                for i = 1, num do
                    delayRun(self.list_panel,0.22*(i-1),function()
                        self.list_view:runLeftPostion()
                    end)
                end
            end
        end)
    end
    self.into_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playTabButtonSound()
            if model:getStatus() == ArenaworldbullyConst.stage.battle or model:getStatus() == ArenaworldbullyConst.stage.match or model:getStatus() == ArenaworldbullyConst.stage.battle_settlement then
                controller:openOverlordWindow(true,{index=ArenaworldbullyConst.guessing_tab.eOverlord})
            elseif model:getStatus() == ArenaworldbullyConst.stage.guess or model:getStatus() == ArenaworldbullyConst.stage.settlement then
                controller:openOverlordWindow(true,{index=ArenaworldbullyConst.guessing_tab.eGuessing})
            else
                message(TI18N("语言_c_6632"))
            end
        end
    end)
    self.btn_log:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playTabButtonSound()
            controller:openOverlordRaceScheduleWindow(true,RoleController:getInstance():getRoleVo())
        end
    end)
    self.touch_scroll:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = 0 -- 0不动 1左滑 2右滑
            if self.touch_began ~= nil then
                if math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                math.abs(self.touch_end.y - self.touch_began.y) <= 20 then
                    is_click = 0
                elseif self.touch_end.x > self.touch_began.x then
                    is_click = 1
                elseif self.touch_end.x < self.touch_began.x then
                    is_click = 2
                end
                self:updateScrollBtnVis(is_click)
            end
        elseif event_type == ccui.TouchEventType.moved then
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        elseif event_type == ccui.TouchEventType.canceled then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = 0 -- 0不动 1左滑 2右滑
            if self.touch_began ~= nil then
                if math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                math.abs(self.touch_end.y - self.touch_began.y) <= 20 then
                    is_click = 0
                elseif self.touch_end.x > self.touch_began.x then
                    is_click = 1
                elseif self.touch_end.x < self.touch_began.x then
                    is_click = 2
                end
                self:updateScrollBtnVis(is_click)
            end
        end
    end)
    -- registerButtonEventListener(self.btn_rule, function (  )
    --     MainuiController:getInstance():openCommonExplainView(true, Config.ArenaTimeWarpData.data_explain_champion)
    -- end, true)
    registerButtonEventListener(self.btn_lineup, function (  )
        HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.WorldOverlord, {}, HeroConst.FormShowType.eFormSave)
    end, true)
    registerButtonEventListener(self.btn_rank, function (  )
        if self.list_view and self.list_view.getSelectItem then
            local item = self.list_view:getSelectItem()
            local vo = nil
            if item then 
                vo = item:getData() or {}
            end
            controller:openOverlordRankWindow(true,{group_id=vo and vo.group or 1})
        end
    end, true)
    registerButtonEventListener(self.btn_turntable, function (  )
        controller:openArenaworldbullyTurntablePanel(true)
    end, true)
    registerButtonEventListener(self.btn_first_reward, function (  )
        controller:openOverlordFirstRewardWindow(true)
    end, true)
    registerButtonEventListener(self.btn_fabulous, handler(self, self._onClickBtnFabulous), true, 2)
    
    registerButtonEventListener(self.group_img, function (  )
        self:onClickGroupBtn()
    end, true)

    registerButtonEventListener(self.btn_shop, function (  )
        controller:openArenaworldbullyMallWindow(true)
    end, true)

    registerButtonEventListener(self.right_btn, function (  )
        self.role_scroll:getInnerContainer():setPositionX(self.role_scroll:getContentSize().width - self.role_scroll:getInnerContainerSize().width)
        self:updateScrollBtnVis()
    end, true)
    registerButtonEventListener(self.left_btn, function (  )
        self.role_scroll:getInnerContainer():setPositionX(0)
        self:updateScrollBtnVis()
    end, true)
    registerButtonEventListener(self.change_btn, handler(self, self._onClickBtnChange), true, 2)

    if self.update_overlord_data == nil then
        self.update_overlord_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateOverlordData, function()
            self.period_date = Config.ArenaTimeWarpData.data_period_date[model:getPeriod()]
            self.group_date = Config.ArenaTimeWarpData.data_group[model:getPreGroupId()]
            self.nation_cfg = Config.ArenaTimeWarpData.data_nation[model:getnation()]
            self.battle_group_date = Config.ArenaTimeWarpData.data_group[model:getOverGroupId(model:getLookZone())]
            self:updatePage()
        end)
    end
    
    if self.update_top5_data_event == nil then
        self.update_top5_data_event = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateTop5DataEvent, function(data)
            local zone_list = {}
            local cfg = Config.ArenaTimeWarpData.data_zone
            for k, v in pairs(data.rank_list) do
                local zone = model:getZoneForGroup(v.group)
                v.zone = zone
                if not zone_list[zone] then
                    zone_list[zone] = {}
                end
                local group = 0
                if zone == 2 then
                    group = v.group
                else
                    group = v.group - 5
                end
                zone_list[zone][group] = v
            end
            local _zone_list = {}
            for j=1, #cfg do
                local list = zone_list[j] or {}
                if tableLen(list) > 1 then
                    table.sort(list,function(a,b)
                        if a and b and a.group and b.group then
                            return a.group < b.group
                        end
                        return false
                    end)
                end
                local num = 0
                for key, value in pairs(cfg[j]) do
                    if num == 0 then
                        num = value.id
                    else
                        num = math.min(num,value.id)
                    end
                end
                for i = 1,5 do
                    if not list[i] then
                        list[i] = {rid = 0,srv_id = "",name = "",gname = "",face_id = 0,lookid = 0,power = 0,honor = 0,nation = 0,group = i+num-1,worship = 0,worship_status = 1,partner_infos={},zone=j}
                    end
                end
                _zone_list[j] = {}
                for i = 1,5 do
                    local statr_num = model:getOverChampionOrder()
                    -- if model:getStatus() ~= ArenaworldbullyConst.stage.prepare and 
                    if model:getStatus() ~= ArenaworldbullyConst.stage.guess and 
                        model:getStatus() ~= ArenaworldbullyConst.stage.match and 
                        model:getStatus() ~= ArenaworldbullyConst.stage.battle and 
                        model:getStatus() ~= ArenaworldbullyConst.stage.battle_settlement and 
                        model:getStatus() ~= ArenaworldbullyConst.stage.settlement then
                            statr_num = 5
                    end
                    local num = i-1+statr_num
                    if num <= 5 then
                        _zone_list[j][i] = list[num]
                    else
                        _zone_list[j][i] = list[num-5]
                    end
                end
            end
            self.rank_list = _zone_list
            for k, v in ipairs(self.rank_list) do
                for key, value in pairs(v) do
                    value.index = key
                end
            end
            self:updateBagList()
            self:updateChangeBtnRed()
        end)
    end
    
	if not self.update_arenaworldbully_red then
        self.update_arenaworldbully_red = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateArenaworldbullyRed,function()
            self:updateIntoRed()
            self:updateFirstReward()
            self:updateFormReward()
        end)
    end
    
    if self.add_goods == nil then
        self.add_goods = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function()
            self:updateTurntableRed()
        end)
    end
    if self.delete_goods == nil then
        self.delete_goods = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function()
            self:updateTurntableRed()
        end)
    end
    if self.modify_goods_num == nil then
        self.modify_goods_num = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function()
            self:updateTurntableRed()
        end)
    end
    if self.update_zone == nil then
        self.update_zone = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateZone, function()
            self.scroll_list = {}
            self:updateBagList()
            self:updateBtnChange()
            self.battle_group_date = Config.ArenaTimeWarpData.data_group[model:getOverGroupId(new_zone)]
        end)
    end
end
function OverlordMainWindow:updateScrollBtnVis(index)
    local lick_index = index or 0
    local action = nil
    if lick_index == 2 then
        action = cc.MoveTo:create(0.2,cc.p(self.role_scroll:getContentSize().width - self.role_scroll:getInnerContainerSize().width, self.role_scroll:getInnerContainer():getPositionY()))
    elseif lick_index == 1 then
        action = cc.MoveTo:create(0.2,cc.p(0, self.role_scroll:getInnerContainer():getPositionY()))
    end
    local fun = function()
        if self.role_scroll:getInnerContainerSize().width > self.role_scroll:getContentSize().width then        
            local _x = self.role_scroll:getInnerContainer():getPositionX()
            if _x >= 0 then
                self.left_btn:setVisible(false)
                self.right_btn:setVisible(true)
            elseif _x <= self.role_scroll:getContentSize().width - self.role_scroll:getInnerContainerSize().width then
                self.right_btn:setVisible(false)
                self.left_btn:setVisible(true)
            end
        else
            self.right_btn:setVisible(false)
            self.left_btn:setVisible(false)
        end
    end
    if lick_index ~= 0 then
        self.role_scroll:getInnerContainer():runAction(cc.Sequence:create(action,cc.CallFunc:create(function(  )
            fun()
            return
        end)))
    end
    fun()
    -- self.role_scroll:getInnerContainer():setPositionX(self.role_scroll:getContentSize().width - self.role_scroll:getInnerContainerSize().width)
end
function OverlordMainWindow:onClickGroupBtn(  )
    controller:openPreselectionGroupingInfoWindow(true)
end

function OverlordMainWindow:_onClickBtnFabulous()
    RoleController:getInstance():requestWorshipRole(self.select_item_vo.rid, self.select_item_vo.srv_id, self.select_item_vo.group,WorshipType.arenaworldbully)
end
function OverlordMainWindow:updateTurntableRed()
    addRedPointToNodeByStatus(self.btn_turntable,model:getBtnTurntableRed(),10,10)
end
function OverlordMainWindow:updateFirstReward()
    addRedPointToNodeByStatus(self.btn_first_reward,model:getRedForIndex(ArenaworldbullyConst.RedType.FirstReward),10,10)
end
function OverlordMainWindow:updateFormReward()
    addRedPointToNodeByStatus(self.btn_lineup,model:getRedForIndex(ArenaworldbullyConst.RedType.OverlordForm),10,10)
end
function OverlordMainWindow:updateIntoRed()
    local status = model:getRedForIndex(ArenaworldbullyConst.RedType.Guess) or model:getRedForIndex(ArenaworldbullyConst.RedType.GuessReward)
    addRedPointToNodeByStatus(self.into_btn,status,10,10)
end
function OverlordMainWindow:updateBagList(data)
    if not self.list_view then
        local scroll_view_size = cc.size(286,700)
        local posx_list = {[1]=139,[2]=98,[3]=55,[4]=10,[5]=10,[6]=55,[7]=98}
        local posy_list = {[1]=720,[2]=606,[3]=492,[4]=378,[5]=1062,[6]=948,[7]=834}
        local rotation_list = {[1]=0,[2]=7,[3]=14,[4]=21,[5]=-21,[6]=-14,[7]=-7}
        local zorder_list = {[1]=7,[2]=6,[3]=5,[4]=1,[5]=2,[6]=3,[7]=4}
        local setting = {
            item_class = ArenaworldbullyItem,      -- 单元类
            start_x = 9,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 268,               -- 单元的尺寸width
            item_height = 148,              -- 单元的尺寸height
            row = 1,                        -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            posx_list = posx_list,           --x位置
            posy_list = posy_list,           --y位置
            rotation_list = rotation_list,    --旋转
            zorder_list = zorder_list,        --层级
            visible_item = self.choose_img,   --转动时需要隐藏的东西
        }
        self.list_view = ArenaworldBullyListPanel.new(self.list_panel, cc.p(0, 0) , ScrollViewDir.vertical, ScrollViewStartPos.bottom, scroll_view_size, setting)
    end 
    -- self.rank_list = {
    --     [1] = {rid = 5,srv_id = "dev_24",name = "南门照",gname = "njlkjb",face_id = 20401,lookid = 110401,power = 2757745,honor = 0,nation = 1,group = 2,worship = 3,worship_status = 1},
    --     [2] = {rid = 0,srv_id = "",name = "",gname = "",face_id = 0,lookid = 0,power = 0,honor = 0,nation = 0,group = 3,worship = 0,worship_status = 1},
    --     [3] = {rid = 10,srv_id = "dev_24",name = "njhdkj",gname = "njlkjb",face_id = 20403,lookid = 110403,power = 2757745,honor = 0,nation = 1,group = 5,worship = 88,worship_status = 1},
    --     [4] = {rid = 13,srv_id = "dev_24",name = "哦哦哦哦哦",gname = "njlkjb",face_id = 20404,lookid = 110404,power = 2757745,honor = 0,nation = 1,group = 1,worship = 4,worship_status = 0},
    --     [5] = {rid = 17,srv_id = "dev_24",name = "乒乒乓乓",gname = "njlkjb",face_id = 20405,lookid = 110405,power = 2757745,honor = 0,nation = 1,group = 4,worship = 9999,worship_status = 0},
    -- }
    if not model:getLookZone() or not self.rank_list[model:getLookZone()] then return end
    if not next(self.scroll_list) then
        self.scroll_list = deepCopy(self.rank_list[model:getLookZone()])
        table.insert(self.scroll_list,4,self.rank_list[model:getLookZone()][4])
        table.insert(self.scroll_list,4,self.rank_list[model:getLookZone()][3])
        self.list_view:setData(self.scroll_list)
        self.list_view:addEndCallBack(function()
            self:updateMessage()
        end)
    else
        for k, v in ipairs(self.rank_list[model:getLookZone()]) do
            for key, value in ipairs(self.scroll_list) do
                if v.group == value.group then
                    for a, av in pairs(v) do
                        self.scroll_list[key][a] = deepCopy(av)
                    end
                end
            end
        end
        -- local item_data = {}
        local item = self.list_view:getSelectItem()
        local list = self.list_view:getItemList()
        for k, v in ipairs(self.scroll_list) do
            for key, value in ipairs(list or {}) do
                local _list = deepCopy(value:getData())
                if v.group == _list.group then
                    for a, av in pairs(v) do
                        _list[a]=deepCopy(av)
                    end
                    value:setData(_list)
                end
                if v.group == item:getData().group then
                    for a, av in pairs(v) do
                        _list[a]=deepCopy(av)
                    end
                    self.select_item_vo = {} 
                    self:updateMessage(_list)
                end
            end
        end
    end
end
function OverlordMainWindow:updateRaceSchedule()
    if model:getStatus() == ArenaworldbullyConst.stage.prepare then
        self.race_schedule_value:setString(TI18N("语言_c_6633"))
        self.time_label:setVisible(true)
        self.time_val:setVisible(true)
        local endtime = model:getSignUpEndTime()
        local nowtime = GameNet:getInstance():getTime()
        if endtime > nowtime then
            local time = endtime - nowtime
            ActionController:getInstance():getModel():setCountDownTime(self.time_val,time or 0)
        else
            self.time_label:setVisible(false)
            self.time_val:setVisible(false)
            self.time_val:setString(TI18N("语言_c_233"))
            doStopAllActions(self.time_val)
        end
        self.open_time_txt:setPositionY(135)
        self.open_time_value:setPositionY(135)
        self.condition_txt:setPositionY(107)
        self.condition_value:setPositionY(107)
    elseif model:getStatus() == ArenaworldbullyConst.stage.guess or model:getStatus() == ArenaworldbullyConst.stage.match or model:getStatus() == ArenaworldbullyConst.stage.battle then
        self.race_schedule_value:setString(string.format(TI18N("语言_c_6634"),self.battle_group_date.name))
    elseif model:getStatus() == ArenaworldbullyConst.stage.settlement or model:getStatus() == ArenaworldbullyConst.stage.battle_settlement then
        self.race_schedule_value:setString(string.format(TI18N("语言_c_6635"),self.battle_group_date.name))
    else
        self.race_schedule_value:setString(TI18N("语言_c_6632"))
    end 
end
function OverlordMainWindow:updatePage()
    if model:getOverRank() and model:getOverRank() ~= 0 then
        self.my_rank_txt:setString(string.format(TI18N("语言_c_1392"),model:getOverRank()))
    else
        self.my_rank_txt:setString(string.format(TI18N("语言_c_1392"),TI18N("语言_c_5410")))
    end
    local _w = math.max(self.rank_bg:getContentSize().width,self.my_rank_txt:getContentSize().width + 50)
    self.rank_bg:setContentSize(cc.size(_w,self.rank_bg:getContentSize().height))
    self.time_label:setVisible(false)
    self.time_val:setVisible(false)
    self.open_time_txt:setPositionY(163)
    self.open_time_value:setPositionY(163)
    self.condition_txt:setPositionY(135)
    self.condition_value:setPositionY(135)
    self:updateRaceSchedule()
    if self.period_date then
        local start_time = LangStringFormat(TI18N("{1}.{2}.{3}"),self.period_date.champion_start_time)
        local end_time = LangStringFormat(TI18N("{1}.{2}.{3}"),self.period_date.champion_end_time)
        self.open_time_value:setString(string.format(TI18N("%s-%s"),start_time,end_time))
    end
    self.condition_value:setString(transformTextToShort(TI18N("语言_c_6636"),35))
    local reward_list = {}
    for k,v in pairs(self.const_cfg.competition_reward_preview.val) do
        if v[1] == model:getPreGroupId() then
            reward_list = v[2]
        end
    end
    local setting = {}
    setting.scale = 0.7
    setting.space_x = 2
    setting.max_count = 3
    setting.is_center = false
    if self.item_list then
        for i,v in pairs(self.item_list) do
            if v then
                v:DeleteMe()
            end
        end
        self.item_list = nil
    end
    self.item_list = commonShowSingleRowItemList(self.reward_scrollView, self.item_list, reward_list, setting)
    self.group_img:loadTexture(PathTool.getResFrame("time_warp",self.group_date.icon,false,"qualifier"),LOADTEXT_TYPE_PLIST)
    self.group_img:ignoreContentAdaptWithSize(true)
    self.group_txt:setString(self.group_date.name)
    loadSpriteTexture(self.group_bg, PathTool.getResFrame("time_warp","qualifier_txt_"..self.group_date.id,false,"qualifier"), LOADTEXT_TYPE_PLIST)
    if self.nation_cfg then
        self.region_img:loadTexture(PathTool.getTargetRes("time_warp/region",self.nation_cfg.icon,false),LOADTEXT_TYPE)
        self.region_img:ignoreContentAdaptWithSize(true)
        self.region_img:setVisible(true)
    else
        self.region_img:setVisible(false)
    end
end

function OverlordMainWindow:updateItemData()
    local list = self.list_view:getItemList()
    for k, v in pairs(list or {}) do
        if v.item_index == 4 then
            local index = 0
            for key, value in pairs(list) do
                if value.item_index == 3 then
                    index = value:getData().index
                end
            end
            local data = {}
            if index == 5 then
                data = self.rank_list[model:getLookZone()][1]
            else
                data = self.rank_list[model:getLookZone()][index + 1]
            end
            v:setData(data)
        elseif v.item_index == 5 then
            local index = 0
            for key, value in pairs(list) do
                if value.item_index == 6 then
                    index = value:getData().index
                end
            end
            local data = {}
            if index == 1 then
                data = self.rank_list[model:getLookZone()][5]
            else
                data = self.rank_list[model:getLookZone()][index - 1]
            end
            v:setData(data)
    
        end
    end
end
function OverlordMainWindow:updateMessage(data)
    local item = self.list_view:getSelectItem()
    local vo = data
    if item and not data then 
        vo = item:getData()
    end
    if self.select_item_vo == vo then return end
    self.select_item_vo = vo
    self:updateItemData()
    if vo.rid ~= 0 and vo.srv_id ~= "" then
        self.no_info_label:setVisible(false)
        self.name:setVisible(true)
        self.name_bg:setVisible(true)
        self.my_region_img:setVisible(true)
        self.my_group_img:setVisible(true)
        self.role_node:setVisible(true)
        self.time_tip:setVisible(true)
        self.name:setString(transformNameByServ(vo.name, vo.srv_id))
        self.time_tip:setString(string.format(TI18N("语言_c_6750"),TimeTool.getZoneYMD(vo.season_start_time).."-"..TimeTool.getZoneYMD(vo.season_end_time)))
        local cfg = Config.ArenaTimeWarpData.data_group[vo.group]
        if cfg then
            loadSpriteTexture(self.my_group_img,PathTool.getResFrame("time_warp",cfg.fst_icon,false,"competition"),LOADTEXT_TYPE_PLIST)
            if self.spine ~= nil then
                self.spine:removeFromParent() 
                self.spine = nil		
            end
            if cfg.res_honor and cfg.res_honor ~= "" then
                if not self.spine then
                    self.spine = createEffectSpine(cfg.res_honor,cc.p(0,0),cc.p(0.5,0.5),true,PlayerAction.action)
                    self.title_img:addChild(self.spine)
                end
            end
        end
        local nation_cfg = Config.ArenaTimeWarpData.data_nation[vo.nation]
        if nation_cfg then
            loadSpriteTexture(self.my_region_img,PathTool.getTargetRes("time_warp/region",nation_cfg.icon,false),LOADTEXT_TYPE)
            -- local honor_data = Config.HonorData.data_title[nation_cfg.honor_id]
            -- if honor_data then
            --     local res = PathTool.getPlistImgForDownLoad("honor","txt_cn_honor_"..honor_data.res_id,false,false)
            --     self.title_img_load = loadSpriteTextureFromCDN(self.title_img, res, ResourcesType.single, self.title_img_load)
            -- end   
        end
        if self.role_spine then
            self.role_spine:DeleteMe()
            self.role_spine = nil
        end
        if not self.role_spine then
            self.role_spine = BaseRole.new(BaseRole.type.role, vo.lookid)
            self.role_spine:setAnimation(0,PlayerAction.show,true)
            self.role_spine:setPosition(cc.p(0,45))
            self.role_spine:setAnchorPoint(cc.p(0.5,0.5))
            -- self.role_spine:setScale(0.8)
            self.role_node:addChild(self.role_spine)
        end
    else
        self.no_info_label:setVisible(true)
        self.name:setVisible(false)
        self.time_tip:setVisible(false)
        self.name_bg:setVisible(false)
        self.my_region_img:setVisible(false)
        self.my_group_img:setVisible(false)
        self.role_node:setVisible(false)
        if self.spine ~= nil then
            self.spine:removeFromParent() 
            self.spine = nil		
        end
    end
    self.fabulous_txt:setString(vo.worship)
    setChildUnEnabled(vo.worship_status == 1, self.btn_fabulous)
    addRedPointToNodeByStatus(self.btn_fabulous,vo.worship_status == 0 and not model:getIsFabulousNumMax(),10,10)
    self.btn_fabulous:setTouchEnabled(vo.worship_status == 0)
    self:setLineUp(vo)
    if vo.group and vo.group > 0 then
        self.btn_rank:loadTexture(PathTool.getResFrame("time_warp","competition_rank_"..vo.group,false,"competition"), LOADTEXT_TYPE_PLIST)
    end
end
function OverlordMainWindow:setLineUp(data)
    for k, v in pairs(self.role_list) do
        doStopAllActions(v)
        v:removeFromParent()
        v = nil
    end
    self.role_list = {}
    if next(data) and next(data.partner_infos) then
        for k, v in pairs(data.partner_infos) do
            local spine = BaseRole.new(BaseRole.type.partner, v , nil, {scale = 0.5, skin_id = v.use_skin})
            spine:setAnimation(0,PlayerAction.show,true) 
            spine:setCascade(true)
            spine:setAnchorPoint(cc.p(0.5,0.5)) 
            spine:setPosition(75 + (k-1)*160,self.role_scroll:getContentSize().height*0.5)
            table.insert(self.role_list,spine)
            self.role_scroll:addChild(spine)
        end
        self.role_scroll:setInnerContainerSize(cc.size(tableLen(data.partner_infos)*160,self.role_scroll:getContentSize().height))
        self:updateScrollBtnVis()
    else
        self.right_btn:setVisible(false)
        self.left_btn:setVisible(false)
    end
end
function OverlordMainWindow:DeleteMe(  )
    if self.list_view then 
        self.list_view:DeleteMe()
        self.list_view = nil
    end
    doStopAllActions(self.time_val)
    if self.top5_change_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.top5_change_event)
        self.top5_change_event = nil
    end
    if self.update_overlord_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_overlord_data)
        self.update_overlord_data = nil
    end
    for k, v in pairs(self.role_list) do
        doStopAllActions(v)
        v:removeFromParent()
        v = nil
    end
    if self.update_top5_data_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_top5_data_event)
        self.update_top5_data_event = nil
    end
    if self.update_arenaworldbully_red ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_arenaworldbully_red)
        self.update_arenaworldbully_red = nil
    end
    
    if self.add_goods ~= nil then
        GlobalEvent:getInstance():UnBind(self.add_goods)
        self.add_goods = nil
    end
    if self.delete_goods ~= nil then
        GlobalEvent:getInstance():UnBind(self.delete_goods)
        self.delete_goods = nil
    end
    if self.modify_goods_num ~= nil then
        GlobalEvent:getInstance():UnBind(self.modify_goods_num)
        self.modify_goods_num = nil
    end
    if self.update_zone ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_zone)
        self.update_zone = nil
    end
    if self.spine ~= nil then
        self.spine:removeFromParent() 
        self.spine = nil		
    end
    if not tolua.isnull(self.choose_spine) then
        self.choose_spine:clearTracks()
        self.choose_spine = nil
    end
    if not tolua.isnull(self.leaf_spine) then
        self.leaf_spine:clearTracks()
        self.leaf_spine = nil
    end
end