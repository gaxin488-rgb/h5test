PreselectionLogsWindow = PreselectionLogsWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function PreselectionLogsWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/preselection_logs_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function PreselectionLogsWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.imgTitleBg = self.main_container:getChildByName("image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_2595"))
	autoSizeTitleBg(self.win_title,self.imgTitleBg)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.my_log_panel = self.main_container:getChildByName("my_log_panel")
	self.no_log_label = self.main_container:getChildByName("no_log_label")
	self.no_log_label:setString(TI18N("语言_c_5410"))
	self.no_log_image = self.main_container:getChildByName("no_log_image")
	self.no_log_label:setVisible(false)
	self.no_log_image:setVisible(false)
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.enemy_title = self.title_bg:getChildByName("enemy_title")
	self.enemy_title:setString(TI18N("语言_c_4124"))
	self.more_title = self.title_bg:getChildByName("more_title")
	self.more_title:setString(TI18N("语言_c_4125"))
end

function PreselectionLogsWindow:openRootWnd()
	controller:sender14512()
end
function PreselectionLogsWindow:setData(data)
	self.data = data
	if self.group_view == nil then
        local scroll_view_size = self.my_log_panel:getContentSize()
        local setting = {
            item_class = PreselectionLogsItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 564,               -- 单元的尺寸width
            item_height = 140,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.my_log_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	if next(data.log_list) then
		self.group_view:setData(data.log_list)
		self.group_view:setVisible(true)
		self.no_log_label:setVisible(false)
		self.no_log_image:setVisible(false)
	else
		self.group_view:setVisible(false)
		self.no_log_label:setVisible(true)
		self.no_log_image:setVisible(true)
	end
end
function PreselectionLogsWindow:_onClickBtnClose()
	controller:openPreselectionLogsWindow(false)
end
function PreselectionLogsWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	if self.update_logs_data == nil then
        self.update_logs_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateLogsData, function(data)
            if not data then return end
			for k, v in pairs(data.log_list) do
				v.replay_srv_id = data.replay_srv_id
			end
			table.sort(data.log_list,function(a,b) return a.time > b.time end)
            self:setData(data)
        end)
    end
end

function PreselectionLogsWindow:close_callback(  )
	if self.update_logs_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_logs_data)
        self.update_logs_data = nil
    end
	self:_onClickBtnClose()
end

--子项
PreselectionLogsItem = class("PreselectionLogsItem", function()
    return ccui.Widget:create()
end)

function PreselectionLogsItem:ctor()
    self:configUI()
    self:register_event()
end

function PreselectionLogsItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_logs_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(564,140))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("container")
    self.bg = self.main_container:getChildByName("bg")
	self.flag_image = self.main_container:getChildByName("flag_image")
	self.attk_label = self.main_container:getChildByName("attk_label")
	self.name_label = self.main_container:getChildByName("name_label")
	self.defend_label = self.main_container:getChildByName("defend_label")
	self.time_label = self.main_container:getChildByName("time_label")
	self.btn_watch = self.main_container:getChildByName("btn_watch")
	self.score_txt = createRichLabel(20,cc.c3b(0xa9,0x5f,0x0f),cc.p(0, 0.5),cc.p(275,36))
	self.main_container:addChild(self.score_txt)
end

function PreselectionLogsItem:register_event( )
	registerButtonEventListener(self.btn_watch, handler(self, self._onClickBtnWatch), true, 2)
end
function PreselectionLogsItem:_onClickBtnWatch()
	controller:openPreselectionFightVedioPanel(true,self.data,1)
end

function PreselectionLogsItem:setData(data)
	self.data = data
	-- print("data",vardump(data))
	if not self.head_node then
		self.head_node = PlayerHead.new(PlayerHead.type.circle)
		self.head_node:setScale(0.8)
		self.head_node:setPosition(60 , 86)
		self.main_container:addChild(self.head_node)
	end
	self.head_node:setHeadRes(data.face_id,false,LOADTEXT_TYPE,data.face_file, data.face_update_time)
	self.head_node:setLev(data.lev)
	local avatar_bid = data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.head_node:showBg(res, nil, false, vo.offy)
    end
	self.head_node:showWarldBullyRegion(data.nation or 0,0.8,cc.p(103,15))
	self.name_label:setString(transformNameByServ(data.name, data.srv_id))
	self.attk_label:setString(MoneyTool.moneyFormat(data.power))
	local txt = ""
	local txt_color = cc.c3b(0xff,0x58,0x0e)
	--type 1:进攻 2:防守  ret 1:胜利 2:失败
	if data.type == 1 then
		if data.ret == 1 then
			txt = TI18N("语言_c_455")
			txt_color = cc.c3b(0x0e,0xa8,0x0e)
		elseif data.ret == 2 then
			txt = TI18N("语言_c_456")
			txt_color = cc.c3b(0xff,0x58,0x0e)
		end
	elseif data.type == 2 then
		if data.ret == 1 then
			txt = TI18N("语言_c_6663")
			txt_color = cc.c3b(0x0e,0xa8,0x0e)
		elseif data.ret == 2 then
			txt = TI18N("语言_c_6664")
			txt_color = cc.c3b(0xff,0x58,0x0e)
		end
	end
	self.defend_label:setString(txt)
	self.defend_label:setTextColor(txt_color)
	local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
	local e_dZoneDiff = (timezone - TimeTool.getTimeZone())*3600
	local time = TimeTool.getYMDHM(data.time + e_dZoneDiff)
	self.time_label:setString(time)
	local str = ""
	-- score_type 0:不变 1:上升 2:下降
	if data.score_type == 1 then
		str = string.format(TI18N("语言_c_6665"),data.score)
	elseif data.score_type == 2 then
		str = string.format(TI18N("语言_c_6666"),data.score)
	elseif data.score_type == 0 then
		str = TI18N("语言_c_6667")
	end
	self.score_txt:setString(str)
end

function PreselectionLogsItem:DeleteMe()

end