-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      争霸赛总奖励面板
-- <br/>Create: 2020-03-19
-- --------------------------------------------------------------------
OverlordRankAwardsPanel = class("OverlordRankAwardsPanel", function()
    return ccui.Layout:create()
end)

local table_insert = table.insert
local table_sort = table.sort
local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel() 

function OverlordRankAwardsPanel:ctor(group_id)
    self.group_id = group_id or model:getOverGroupId(model:getLookZone())
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/overlord_rank_awards_panel"))

    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    local rank_title = container:getChildByName("rank_title")
    rank_title:setString(TI18N("语言_c_255"))
    local award_title = container:getChildByName("award_title")
    award_title:setString(TI18N("语言_c_282"))

    local scroll_container = container:getChildByName("scroll_container")
    local size = scroll_container:getContentSize()
    local setting = {
        start_x = 0,
        space_x = 0,
        start_y = 0,
        space_y = 2,
        item_width = 600,
        item_height = 135,
        row = 0,
        col = 1,
        need_dynamic = true
    }
    self.scroll_view = CommonScrollViewSingleLayout.new(scroll_container,  cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, size, setting)
    self.scroll_view:registerScriptHandlerSingle(handler(self, self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
    self.scroll_view:registerScriptHandlerSingle(handler(self, self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
    self.scroll_view:registerScriptHandlerSingle(handler(self, self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    
    local my_container = container:getChildByName("my_container")
    self.title_bg = my_container:getChildByName("title_bg")
    self.title_txt = my_container:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_c_5062"))
    self.title_bg:setContentSize(cc.size(self.title_txt:getContentSize().width + 20,self.title_bg:getContentSize().height))
    self.tips_lab = my_container:getChildByName("tips_lab")
    self.tips_lab:setString(TI18N("语言_c_6654"))
    self.item_scrollview = my_container:getChildByName("item_scrollview")
    self.item_scrollview:setScrollBarEnabled(false)
    local cfg = Config.ArenaTimeWarpData.data_group[self.group_id]
    if cfg then
        local setting = {}
        setting.scale = 0.9
        setting.max_count = 3
        self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, cfg.extra_reward, setting)
    end
    self:registerEvent()
    self:addToParent()
end


--创建cell
--@width 是setting.item_width
--@height 是setting.item_height
function OverlordRankAwardsPanel:createNewCell()
    local cell = OverlordRankAwardsItem.new(self.group_id)
    return cell
end

--获取数据数量
function OverlordRankAwardsPanel:numberOfCells()
    if not self.award_list then
        return 0
    end
    return #self.award_list
end

--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--index :数据的索引
function OverlordRankAwardsPanel:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.award_list[index]
    if not cell_data then
        return
    end
    local time_desc = cell:setData(cell_data)
end


function OverlordRankAwardsPanel:registerEvent()
end

function OverlordRankAwardsPanel:setVisibleStatus(status)
	self:setVisible(status)
end 

function OverlordRankAwardsPanel:addToParent()
    self.award_list = {} 
    local tmp_list = deepCopy(Config.ArenaTimeWarpData.data_award)
    local award_list = {}
    for i,v in pairs(tmp_list) do
        for key,value in pairs(v) do
            if value.group == self.group_id then
                table_insert(award_list,value)
            end
        end
    end
    table_sort(award_list, SortTools.KeyLowerSorter("min"))
    self.award_list = award_list
    self.scroll_view:reloadData()
end

function OverlordRankAwardsPanel:DeleteMe()
    if self.scroll_view then
        self.scroll_view:DeleteMe()
        self.scroll_view = nil
    end

    if self.item_list then
        for i,v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
end


OverlordRankAwardsItem = class("OverlordRankAwardsItem",function()
    return ccui.Layout:create()
end)

function OverlordRankAwardsItem:ctor(group_id)
    self.group_id = group_id
    self.item_list = {}

    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/overlord_rank_awards_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    self.rank_img = self.root_wnd:getChildByName("rank_img")
    self.rank_label = self.root_wnd:getChildByName("rank_label")
    self.item_container = self.root_wnd:getChildByName("item_container")
    self.item_container:setSwallowTouches(false)
    self.item_container:setScrollBarEnabled(false)


    self:registerEvent()
end

function OverlordRankAwardsItem:registerEvent()
end

function OverlordRankAwardsItem:setData(data)
    if data ~= nil then
        if data.min == data.max then
            if data.max <= 3 and data.max ~= 0 then
                self.rank_img:setVisible(true)
                self.rank_label:setVisible(false)
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.max))
			    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
            else
                self.rank_label:setVisible(true)
                self.rank_label:setString(data.max)
                self.rank_img:setVisible(false)
            end
        else
            self.rank_label:setVisible(true)
            self.rank_label:setString(string.format(TI18N("%s-%s"),data.min,data.max))
            self.rank_img:setVisible(false)
        end
        local data_list = data["show_reward"]
        local setting = {}
        setting.scale = 0.9
        setting.max_count = 3
        self.item_list = commonShowSingleRowItemList(self.item_container, self.item_list, data_list, setting)
        
    end
end

function OverlordRankAwardsItem:DeleteMe()
    if self.item_list then
        for i,v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end

    self:removeAllChildren()
    self:removeFromParent()
end
