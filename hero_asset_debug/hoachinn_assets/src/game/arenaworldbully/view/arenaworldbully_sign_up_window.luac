-- 
-- 
-- @Date    : 2019-08-13 15:36:39
-- @description    : 
		-- 时空争霸赛报名地区组件
---------------------------------
--子项
ArenaworldbullySignupItem = class("ArenaworldbullySignupItem", function()
    return ccui.Widget:create()
end)

function ArenaworldbullySignupItem:ctor()
    self:configUI()
    self:register_event()
end

function ArenaworldbullySignupItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/arenaworldbully_sign_up_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(290,59))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
	self.main_container:setSwallowTouches(false)
    self.bg = self.main_container:getChildByName("bg")
	self.icon = self.main_container:getChildByName("icon")
	self.name = self.main_container:getChildByName("name")
end
function ArenaworldbullySignupItem:register_event( )
	self.main_container:addTouchEventListener(function(sender, event_type)
		if event_type == ccui.TouchEventType.began then
			self.touch_began = sender:getTouchBeganPosition()
			self.can_touch = true
		elseif event_type == ccui.TouchEventType.moved then
			local touch_began = self.touch_began
			local touch_move = sender:getTouchMovePosition()
			if touch_began and touch_move and (math.abs(touch_move.x - touch_began.x) > 20 or math.abs(touch_move.y - touch_began.y) > 20) then 
				self.can_touch = false
			end 
		elseif event_type == ccui.TouchEventType.ended then
			if self.can_touch then
				GlobalEvent:getInstance():Fire(ArenaworldbullyEvent.SignUpChooseNation,self.data.id)
			end
		elseif event_type == ccui.TouchEventType.canceled then
			if self.can_touch then
				GlobalEvent:getInstance():Fire(ArenaworldbullyEvent.SignUpChooseNation,self.data.id)
			end
		end
    end)
end
function ArenaworldbullySignupItem:_onClickSelf( )
end
function ArenaworldbullySignupItem:setData(data)
	if data then
		self.data = data
		self.name:setString(data.name)
		setTextMaxWidth(self.name,170,-10)
		loadSpriteTexture(self.icon, PathTool.getTargetRes("time_warp/region",data.icon,false), LOADTEXT_TYPE)
	end
end
function ArenaworldbullySignupItem:DeleteMe()

end