ArenaworldbullySignupWindow = ArenaworldbullySignupWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function ArenaworldbullySignupWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/arenaworldbully_sign_up_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("time_warp", "competition"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("time_warp", "qualifier"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("common", "common_1"), type = ResourcesType.plist},
	}
	self.choose_id = model:getnation()
end

function ArenaworldbullySignupWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.bg = self.main_container:getChildByName("bg")
	self.reward_panel = self.main_container:getChildByName("reward_panel")
	self.reward_txt = self.reward_panel:getChildByName("reward_txt")
	self.reward_txt:setString(TI18N("语言_c_21"))
	self.reward_list = self.reward_panel:getChildByName("reward_list")
	self.reward_list:setScrollBarEnabled(false)
	self.sign_up_panel = self.main_container:getChildByName("sign_up_panel")
	self.tip = self.sign_up_panel:getChildByName("tip")
	setTextMaxWidth(self.tip,190)
	self.tip:setString(TI18N("语言_c_6590"))
	self.btn_rule = self.sign_up_panel:getChildByName("btn_rule")
	self.nosign_up = self.sign_up_panel:getChildByName("nosign_up")
	setTextMaxWidth(self.nosign_up,450)
	self.nosign_up:setString(TI18N("语言_c_6591"))
	self.region_bg = self.main_container:getChildByName("region_bg")
	self.region_bg:setVisible(false)
	self.region_list_panel = self.region_bg:getChildByName("region_list_panel")
	self.region_panel = self.sign_up_panel:getChildByName("region_panel")
	self.registered_panel = self.region_panel:getChildByName("registered_panel")
	self.registered_icon = self.registered_panel:getChildByName("registered_icon")
	self.change_icon = self.registered_panel:getChildByName("change_icon")
	self.noregistered_panel = self.region_panel:getChildByName("noregistered_panel")
	self.open_time_txt = self.sign_up_panel:getChildByName("open_time_txt")
	self.open_time_txt:setString(TI18N("语言_c_6592"))
	self.open_time_value = self.sign_up_panel:getChildByName("open_time_value")
	self.condition_txt = self.sign_up_panel:getChildByName("condition_txt")
	self.condition_txt:setString(TI18N("语言_c_6593"))
    self.power_txt = self.sign_up_panel:getChildByName("power_txt")
    self.power_txt:setString(TI18N("语言_c_7052"))
    self.power_value = self.sign_up_panel:getChildByName("power_value")
    self.power_value:setString(model:getMaxPower())
	self.power_value:setPositionX(self.power_txt:getPositionX() + self.power_txt:getContentSize().width + 10)
	self.condition_value = self.sign_up_panel:getChildByName("condition_value")
	self.surplus_txt = self.sign_up_panel:getChildByName("surplus_txt")
	self.surplus_txt:setString(TI18N("语言_c_6594"))
	self.surplus_value = self.sign_up_panel:getChildByName("surplus_value")
	self.btn_form = self.sign_up_panel:getChildByName("btn_form")
	self.form_txt = self.btn_form:getChildByName("label")
	setTextMaxWidth(self.form_txt,150)
	self.form_txt:setString(TI18N("语言_c_6598"))
	self.btn_form2 = self.sign_up_panel:getChildByName("btn_form2")
	self.form_txt2 = self.btn_form2:getChildByName("label")
	setTextMaxWidth(self.form_txt,150)
	self.form_txt2:setString(TI18N("语言_c_6587"))
	self.btn_shop = self.sign_up_panel:getChildByName("btn_shop")
	self.turntable_txt = self.btn_shop:getChildByName("label")
	setTextMaxWidth(self.turntable_txt,150)
	self.turntable_txt:setString(TI18N("语言_c_3347"))
	self.sign_up_btn = self.sign_up_panel:getChildByName("sign_up_btn")
	self.sign_up_txt = self.sign_up_btn:getChildByName("label")
	self.sign_up_txt:setString(TI18N("语言_c_6595"))
end

function ArenaworldbullySignupWindow:openRootWnd()
	self.const_cfg = Config.ArenaTimeWarpData.data_const
	self.period_date = Config.ArenaTimeWarpData.data_period_date[model:getPeriod()]
	self.nation_cfg = Config.ArenaTimeWarpData.data_nation
	self:setData()
end
function ArenaworldbullySignupWindow:setData()
	local setting = {}
    setting.scale = 0.6
    setting.space_x = 2
    setting.max_count = 3
    setting.is_center = false
    self.item_list = commonShowSingleRowItemList(self.reward_list, self.item_list, self.period_date.registration_reward_preview, setting)
	self.change_icon:setVisible(true)
	self.nosign_up:setVisible(false)
	self.region_panel:setVisible(true)
	self.tip:setVisible(true)
	if model:getSignupState() == ArenaworldbullyConst.SingUpType.notRegistered then
		self.sign_up_txt:setString(TI18N("语言_c_6595"))
		setChildUnEnabled(true,self.sign_up_btn)
		self.sign_up_btn:setTouchEnabled(false)
		addRedPointToNodeByStatus(self.sign_up_btn,false,10,10)
		self.nosign_up:setVisible(true)
		self.region_panel:setVisible(false)
		self.tip:setVisible(false)
	elseif model:getSignupState() == ArenaworldbullyConst.SingUpType.canRegister then
		self.sign_up_txt:setString(TI18N("语言_c_6595"))
		setChildUnEnabled(false,self.sign_up_btn)
		self.sign_up_btn:setTouchEnabled(true)
	elseif model:getSignupState() == ArenaworldbullyConst.SingUpType.registered then
		self.sign_up_txt:setString(TI18N("语言_c_6596"))
		setChildUnEnabled(true,self.sign_up_btn)
		self.sign_up_btn:setTouchEnabled(false)
		addRedPointToNodeByStatus(self.sign_up_btn,false,10,10)
		self.change_icon:setVisible(false)
	end
	if self.choose_id ~= 0 then
		self.tip:setString(self.nation_cfg[self.choose_id].name)
		self.registered_panel:setVisible(true)
		self.noregistered_panel:setVisible(false)
	else
		self.tip:setString(TI18N("语言_c_6590"))
		self.registered_panel:setVisible(false)
		self.noregistered_panel:setVisible(true)
	end
	local cfg = self.nation_cfg[self.choose_id]
	if cfg then
		loadSpriteTexture(self.registered_icon, PathTool.getTargetRes("time_warp/region",cfg.icon,false), LOADTEXT_TYPE)
	end
	local start_time = LangStringFormat(TI18N("{1}.{2}.{3}"),self.period_date.score_start_time)
	local end_time = LangStringFormat(TI18N("{1}.{2}.{3}"),self.period_date.score_end_time)
	self.open_time_value:setString(string.format(TI18N("%s-%s"),start_time,end_time))
	self.open_time_value:setPositionX(self.open_time_txt:getPositionX() + self.open_time_txt:getContentSize().width + 10)
	local txt = string.format(TI18N("语言_c_6597"),self.const_cfg.registration_condition.val)
	self.condition_value:setString(txt)
	setTextMaxWidth(self.condition_value,480 - self.condition_txt:getContentSize().width,-10)
	self.condition_value:setPositionX(self.condition_txt:getPositionX() + self.condition_txt:getContentSize().width + 10)

	self:showServerTime()
	
	if self.region_view == nil then
        local scroll_view_size = self.region_list_panel:getContentSize()
        local setting = {
            item_class = ArenaworldbullySignupItem,      -- 单元类
            start_x = 5,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 5,                    -- 第一个单元的Y起点
            space_y = 5,                   -- y方向的间隔
            item_width = 290,               -- 单元的尺寸width
            item_height = 59,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.region_view = CommonScrollViewLayout.new(self.region_list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	self.region_view:setData(self.nation_cfg)
	self:updateSignUpRed()
end

--计时器
function ArenaworldbullySignupWindow:showServerTime()
    if tolua.isnull(self.surplus_value) then return end
    doStopAllActions(self.surplus_value)
    self.surplus_value:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(0), cc.CallFunc:create(function()
        self:setTime()
    end))))
end
function ArenaworldbullySignupWindow:setTime()
    local endtime = model:getSignUpEndTime()
    local nowtime = GameNet:getInstance():getTime()
    if endtime > nowtime then
        local time = endtime - nowtime
        ActionController:getInstance():getModel():setCountDownTime(self.surplus_value,time or 0)
    else
        self.surplus_value:setString(TI18N("语言_c_233"))
        doStopAllActions(self.surplus_value)
    end
	local _w = self.surplus_txt:getContentSize().width + self.surplus_value:getContentSize().width
		self.surplus_txt:setPositionX((self.sign_up_panel:getContentSize().width - _w)*0.5)
		self.surplus_value:setPositionX(self.surplus_txt:getPositionX() + self.surplus_txt:getContentSize().width)
end
function ArenaworldbullySignupWindow:_onClickBtnClose()
	controller:openArenaworldbullySignupWindow(false)
end
function ArenaworldbullySignupWindow:_onClickBtnRule()
	local data = {}
	local list1 = {}
	local data_explain_score = Config.ArenaTimeWarpData.data_explain_score
	list1.name = TI18N("语言_c_6598")
	list1.list = data_explain_score
	table.insert(data, list1)
	local list2 = {}
	local data_explain_champion = Config.ArenaTimeWarpData.data_explain_champion
	list2.name = TI18N("语言_c_6587")
	list2.list = data_explain_champion
	table.insert(data, list2)
	MainuiController:getInstance():openCommonMoreExplainWindow(true, data)
end
function ArenaworldbullySignupWindow:_onClickBtnNation()
	self.region_bg:setVisible(true)
end
function ArenaworldbullySignupWindow:_onClickBtnNationBg()
	self.region_bg:setVisible(false)
end
function ArenaworldbullySignupWindow:_onClickBtnSignUp()
	if self.choose_id == 0 then
		message(TI18N("语言_c_6590"))
	else
		controller:sender14501(self.choose_id)
	end
end
function ArenaworldbullySignupWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.btn_rule, handler(self, self._onClickBtnRule), true, 2)
	registerButtonEventListener(self.noregistered_panel, handler(self, self._onClickBtnNation), true, 2)
	registerButtonEventListener(self.change_icon, handler(self, self._onClickBtnNation), true, 2)
	registerButtonEventListener(self.region_bg, handler(self, self._onClickBtnNationBg), true, 2)
	registerButtonEventListener(self.sign_up_btn, handler(self, self._onClickBtnSignUp), true, 2)
    registerButtonEventListener(self.btn_form, function (  )
        HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.WorldPreselection, {}, HeroConst.FormShowType.eFormSave)
    end, true)
	registerButtonEventListener(self.btn_form2, function (  )
        HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.WorldOverlord, {}, HeroConst.FormShowType.eFormSave)
    end, true)
	registerButtonEventListener(self.btn_shop, function (  )
        controller:openArenaworldbullyMallWindow(true)
    end, true)
	-- 道具数量更新
    if not self.signUp_choose_nation then
        self.signUp_choose_nation = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.SignUpChooseNation,function(id)
            self.choose_id = id
			self:setData()
			self:_onClickBtnNationBg()
        end)
    end
	if not self.update_preselection_data then
        self.update_preselection_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdatePreselectionData,function()
			self:setData()
			self:_onClickBtnNationBg()
        end)
    end
	if not self.update_self_data then
        self.update_self_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateSelfData,function()
			self:setData()
			self:_onClickBtnNationBg()
        end)
    end
	if not self.update_arenaworldbully_red then
        self.update_arenaworldbully_red = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateArenaworldbullyRed,function()
			self:updateSignUpRed()
        end)
    end
end
function ArenaworldbullySignupWindow:updateSignUpRed()
	addRedPointToNodeByStatus(self.sign_up_btn,model:getRedForIndex(ArenaworldbullyConst.RedType.Signup),10,10)
	addRedPointToNodeByStatus(self.btn_lineup,model:getRedForIndex(ArenaworldbullyConst.RedType.OverlordForm),10,10)
end
function ArenaworldbullySignupWindow:close_callback(  )
	
    if self.signUp_choose_nation then
        GlobalEvent:getInstance():UnBind(self.signUp_choose_nation)
        self.signUp_choose_nation = nil
    end
	if self.update_preselection_data then
        GlobalEvent:getInstance():UnBind(self.update_preselection_data)
        self.update_preselection_data = nil
    end
	if self.update_self_data then
        GlobalEvent:getInstance():UnBind(self.update_self_data)
        self.update_self_data = nil
    end
	if self.update_arenaworldbully_red then
        GlobalEvent:getInstance():UnBind(self.update_arenaworldbully_red)
        self.update_arenaworldbully_red = nil
    end
	if self.region_view then
        self.region_view:DeleteMe()
        self.region_view = nil
    end
	self:_onClickBtnClose()
end





