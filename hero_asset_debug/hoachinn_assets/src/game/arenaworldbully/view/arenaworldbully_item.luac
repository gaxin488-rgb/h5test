-- 红包子项
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
ArenaworldbullyItem = class("ArenaworldbullyItem", function()
    return ccui.Widget:create()
end)

function ArenaworldbullyItem:ctor()
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function ArenaworldbullyItem:config()
    self.size = cc.size(268,148)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)
    self:setAnchorPoint(cc.p(0.5,0.5))
    self.is_show_point = false
    self.open_type = 0
    self.star_list = {}
    self.is_can_get = true
end
function ArenaworldbullyItem:layoutUI()
    local csbPath = PathTool.getTargetCSB("arenaworldbully/arenaworldbully_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    
    self.container = self.root_wnd:getChildByName("container")
    self.container:setSwallowTouches(false)
    self.bg = self.container:getChildByName("bg")
    self.bg:ignoreContentAdaptWithSize(true)
    self.group_icon = self.container:getChildByName("group_icon")
    self.name = createRichLabel(22,cc.c3b(0xf5,0xd3,0x06),cc.p(0.5,0.5),cc.p(139,26),nil,nil,600)
    self.container:addChild(self.name)
    self.name_bg = self.container:getChildByName("name_bg")
end

function ArenaworldbullyItem:setData(data)
    if not data then return end
    self.data = data
    local cfg = Config.ArenaTimeWarpData.data_group
    local min = cfg[data.group].min
    local max = cfg[data.group].max
    if max == 9999999999 then
        self.name:setString(string.format(TI18N("<img src=%s visible=true scale=0.7 /><div>%s↑</div>"),PathTool.getResFrame("common", "common_90001"),min))
    else
        if min == max then
            self.name:setString(string.format(TI18N("<img src=%s visible=true scale=0.7 /><div>%s</div>"),PathTool.getResFrame("common", "common_90001"),min,max))
        else
            self.name:setString(string.format(TI18N("<img src=%s visible=true scale=0.7 /><div>%s-%s</div>"),PathTool.getResFrame("common", "common_90001"),cfg[data.group].min,cfg[data.group].max))
        end
    end
    self.name_bg:setVisible(true)
    -- local _w = math.max(113,self.name:getContentSize().width + 30)
    -- self.name_bg:setContentSize(cc.size(_w,self.name_bg:getContentSize().height))
    loadSpriteTexture(self.group_icon,PathTool.getResFrame("time_warp",cfg[data.group].icon,false,"competition"),LOADTEXT_TYPE_PLIST)
    
    self:updateBg()
end

--事件
function ArenaworldbullyItem:registerEvents()
    self.container:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        elseif event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                math.abs(self.touch_end.y - self.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                GlobalEvent:getInstance():Fire(ArenaworldbullyEvent.Top5ChangeEvent,self.item_index)
            end
        end
    end)
end
--是否是中间那个
function ArenaworldbullyItem:setIsMiddle(status)
    self.is_middle = status
    self:updateBg()
end
function ArenaworldbullyItem:updateBg()
    if self.data and next(self.data) then
        if self.is_middle then
            self.bg:loadTexture(PathTool.getResFrame("time_warp","competition_option_2_"..self.data.group,false,"competition"), LOADTEXT_TYPE_PLIST)
        else
            self.bg:loadTexture(PathTool.getResFrame("time_warp","competition_option_1_"..self.data.group,false,"competition"), LOADTEXT_TYPE_PLIST)
        end
        local _x = 0
        local _y = 0
        local zorder = self:getZOrder()
        if zorder == 3 then --268 148
            _x = 0
            _y = -38
        elseif zorder == 5 then
            _x = 0
            _y = -14
        elseif zorder == 6 then
            _x = 0
            _y = -20
        else
            _x = 0
            _y = 0
        end
        addRedPointToNodeByStatus(self,self.data.worship_status == 0 and not self.is_middle,_x,_y)
    end
    
end
function ArenaworldbullyItem:getData(  )
    return self.data
end

function ArenaworldbullyItem:DeleteMe()
end



