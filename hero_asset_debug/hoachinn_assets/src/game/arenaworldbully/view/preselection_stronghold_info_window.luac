PreselectionStrongholdInfoWindow = PreselectionStrongholdInfoWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function PreselectionStrongholdInfoWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/preselection_stronghold_info_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function PreselectionStrongholdInfoWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.title = self.main_container:getChildByName("title")
	self.win_panle = self.main_container:getChildByName("win_panle")
	self.win_title_bg = self.win_panle:getChildByName("win_title_bg")
	self.win_title = self.win_panle:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_3850"))
	self.win_reward_txt = self.win_panle:getChildByName("win_reward_txt")
	self.win_reward_txt:setString(TI18N("语言_c_6602"))
	self.win_score_txt = self.win_panle:getChildByName("win_score_txt")
	self.win_score_txt:setString(TI18N("语言_c_2758"))
	self.win_score_value = self.win_panle:getChildByName("win_score_value")
	self.win_score_value:setPositionX(self.win_score_txt:getPositionX() + self.win_score_txt:getContentSize().width + 10)
	self.win_item_list = self.win_panle:getChildByName("win_item_list")
	self.win_item_list:setPositionX(self.win_reward_txt:getPositionX() + self.win_reward_txt:getContentSize().width + 10)
	self.win_item_list:setContentSize(cc.size(388-self.win_reward_txt:getContentSize().width,self.win_item_list:getContentSize().height))
	self.win_item_list:setScrollBarEnabled(false)
	self.lose_panle = self.main_container:getChildByName("lose_panle")
	self.lose_title_bg = self.lose_panle:getChildByName("lose_title_bg")
	self.lose_title = self.lose_panle:getChildByName("lose_title")
	self.lose_title:setString(TI18N("语言_c_3849"))
	self.lose_reward_txt = self.lose_panle:getChildByName("lose_reward_txt")
	self.lose_reward_txt:setString(TI18N("语言_c_6602"))
	self.lose_score_txt = self.lose_panle:getChildByName("lose_score_txt")
	self.lose_score_txt:setString(TI18N("语言_c_2758"))
	self.lose_score_value = self.lose_panle:getChildByName("lose_score_value")
	self.lose_score_value:setPositionX(self.lose_score_txt:getPositionX() + self.lose_score_txt:getContentSize().width + 10)
	self.lose_item_list = self.lose_panle:getChildByName("lose_item_list")
	self.lose_item_list:setPositionX(self.lose_reward_txt:getPositionX() + self.lose_reward_txt:getContentSize().width + 10)
	self.lose_item_list:setContentSize(cc.size(388-self.lose_reward_txt:getContentSize().width,self.lose_item_list:getContentSize().height))
	self.lose_item_list:setScrollBarEnabled(false)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.list_panel = self.main_container:getChildByName("list_panel")
end

function PreselectionStrongholdInfoWindow:openRootWnd(index)
	self.index = index
	self.group_cfg = Config.ArenaTimeWarpData.data_group[model:getPreGroupId()]
	self:setData()
end
function PreselectionStrongholdInfoWindow:setData()
	self.title:setString(string.format(TI18N("语言_c_6697"),self.index))
	self.title_bg:setContentSize(cc.size(self.title:getContentSize().width + 40, self.title_bg:getContentSize().height))
	self.win_score_value:setString("+"..self.group_cfg.win_score[self.index])
	self.lose_score_value:setString("-"..self.group_cfg.lose_score[self.index])
	local setting = {}
    setting.scale = 1
    setting.space_x = 2
    setting.max_count = 4
    setting.is_backpack_item = true
    self.item_list1 = commonShowSingleRowItemList(self.win_item_list, self.item_list1, self.group_cfg.win_reward[self.index], setting)
	local setting = {}
    setting.scale = 1
    setting.space_x = 2
    setting.max_count = 4
    setting.is_backpack_item = true
    self.item_list2 = commonShowSingleRowItemList(self.lose_item_list, self.item_list2, self.group_cfg.lose_reward[self.index], setting)
end
function PreselectionStrongholdInfoWindow:_onClickBtnClose()
	controller:openPreselectionStrongholdInfoWindow(false)
end
function PreselectionStrongholdInfoWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
end

function PreselectionStrongholdInfoWindow:close_callback(  )
	self:_onClickBtnClose()
end