PreselectionMatchingWindow = PreselectionMatchingWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()
function PreselectionMatchingWindow:__init()
	self.is_full_screen = true
	self.layout_name = "arenaworldbully/preselection_matching_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("form","form"), type = ResourcesType.plist },
	}
	self.tab_list = {}
	self.cur_tab_index = ArenaworldbullyConst.Tab_Index.Preselection  -- 当前选中的tab按钮
    self.const_cfg = Config.ArenaTimeWarpData.data_const
	self.group_cfg = Config.ArenaTimeWarpData.data_group[model:getPreGroupId()]
end

