function PreselectionMatchingWindow:openRootWnd()
	controller:sender14517(1)
	controller:sender14505()
	self.match_type = ArenaworldbullyConst.Tab_Index.Preselection
	self:setData()
end
--刷新自己的分数和挑战次数
function PreselectionMatchingWindow:updateScoreCount()
	self.matching_valu:setString(string.format("%s/%s",model:getPreCanCombatNum(),self.const_cfg.match_count.val))
	self.matching_buy:setPositionX(self.matching_valu:getPositionX() + self.matching_valu:getContentSize().width + 40)
	self.buy_txt:setString(string.format(TI18N("语言_c_6693"),self.const_cfg.buy_count.val - model:getPreBuyCombatNum()))
	self.my_score:setString(string.format(TI18N("语言_c_2586"),model:getPreScore()))
end
function PreselectionMatchingWindow:setData()
	self:setSelfInfoPanel()
	local win_list = self.group_cfg.win_score
	local lose_list = self.group_cfg.lose_score
	if next(win_list) and next(lose_list) then
		self.score_tip:setString(string.format(TI18N("语言_c_6694"),win_list[model:getPreRoomId()] or 0,lose_list[model:getPreRoomId()] or 0))
	else
		self.score_tip:setString(string.format(TI18N("语言_c_6694"),0,0))
	end
	self:updateScoreCount()
end
function PreselectionMatchingWindow:setSelfInfoPanel()
	if role_vo.look_id then
		local config = Config.LooksData.data_data[role_vo.look_id]
		if config==nil then
			config = Config.LooksData.data_data[110401]
		end
		if config then
			local mask_res = PathTool.getResFrame("time_warp","match_3",false,"match")
			self.vSize = cc.size(184,399)
			self.mask = createSprite(mask_res, 184/2, 399/2, nil, cc.p(0.5, 0.5))--模板
			self.clipNode = cc.ClippingNode:create(self.mask)
			self.clipNode:setAnchorPoint(cc.p(0.5,0.5))
			self.clipNode:setContentSize(self.vSize)
			self.clipNode:setCascadeOpacityEnabled(true)
			self.clipNode:setPosition(182, 204)
			self.clipNode:setAlphaThreshold(0)
			self.my_panel:addChild(self.clipNode,2)
			
			self.icon = ccui.ImageView:create()
			self.icon:setCascadeOpacityEnabled(true)
			self.icon:setAnchorPoint(0.5,0.5)
			self.icon:setPosition(self.vSize.width/2,self.vSize.height/2)--底板
			self.icon:setScale(1.1)
			self.clipNode:addChild(self.icon,3)
			local id = config.partner_id
			if config.skin_id ~= 0 then
				id = config.mvp_res
			end
			local res_id = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_" .. id)
			self.icon:loadTexture(res_id,LOADTEXT_TYPE)
		end
	end
	if not self.my_head then
		self.my_head = PlayerHead.new(PlayerHead.type.circle)
		self.my_head:setPosition(0 , 0)
		self.my_head_node:addChild(self.my_head)
	end
	self.my_head:setHeadRes(role_vo.face_id,false,LOADTEXT_TYPE,role_vo.face_file, role_vo.face_update_time)
	self.my_head:setLev(role_vo.lev)
	self.my_head:showWarldBullyRegion(model:getnation(),0.8,cc.p(103,15))
	local avatar_bid = role_vo.avatar_base_id
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.my_head:showBg(res, nil, false, vo.offy)
    end
	self.my_name:setString(transformNameByServ(role_vo.name, role_vo.srv_id))
end
function PreselectionMatchingWindow:setSelfLinePanel()
	-- self.line_up_data
	for k, v in pairs(self.line_up_data.formations) do
		if v.team_id == 1 then
			self:setLinePanel(v,self.my_form_icon,self.my_fight_num,self.my_hero_view,self.my_hero_list,self.my_hero_panel_size)
		elseif v.team_id == 2 then
			self:setLinePanel(v,self.my_form_icon2,self.my_fight_num2,self.my_hero_view2,self.my_hero_list2,self.my_hero_panel_size2)
		end
	end
end
function PreselectionMatchingWindow:setLinePanel(data,form_icon,power_txt,hero_list,list,size)
	loadSpriteTexture(form_icon, PathTool.getResFrame("form", "form_icon_"..data.formation_type + 7), LOADTEXT_TYPE_PLIST)
	local power = 0
	local temp = {}
	for k, v in pairs(data.pos_info) do
		local hero_vo = HeroController:getInstance():getModel():getHeroById(v.id)
		if hero_vo then
			power = power + (hero_vo.power or 0)
		end
		table.insert(temp,hero_vo)
	end
	power_txt:setNum(power)


	for k, v in pairs(list) do
        v:setVisible(false)
    end
    -- list = {}
    local width = 119*0.6
    local p_list_size = #temp
    local total_width = p_list_size * width 
    local start_x = 0
    -- local partner_item = nil
    local max_width = math.max(total_width,size.width) 
    hero_list:setInnerContainerSize(cc.size(max_width,size.height))
    
    for i,v in ipairs(temp) do
        delayRun(self.lineup_panel, i/60, function() 
            if list[i] == nil then 
                local partner_item = HeroExhibitionItem.new(0.6, false)
                partner_item:setPosition(start_x + width * 0.5 + (i-1) * width, size.height*0.5)
                partner_item:setData(v)
                hero_list:addChild(partner_item)
				partner_item:setVisible(true)
                list[i] = partner_item
            else
                list[i]:setData(v)
				list[i]:setVisible(true)
            end
        end)
    end
end
function PreselectionMatchingWindow:setOpponentPanel()
	if not self.other_clipNode then
		local mask_res = PathTool.getResFrame("time_warp","match_3",false,"match")
		self.vSize = cc.size(184,399)
		self.other_mask = createSprite(mask_res, 184/2, 399/2, nil, cc.p(0.5, 0.5))--模板
		self.other_clipNode = cc.ClippingNode:create(self.other_mask)
		self.other_clipNode:setScaleX(-1)
		self.other_clipNode:setAnchorPoint(cc.p(0.5,0.5))
		self.other_clipNode:setContentSize(self.vSize)
		self.other_clipNode:setCascadeOpacityEnabled(true)
		self.other_clipNode:setPosition(188, 204)
		self.other_clipNode:setAlphaThreshold(0)
		self.opponent_panel:addChild(self.other_clipNode,2)
	end
	self.other_clipNode:setVisible(true)
	if not self.other_icon then
		self.other_icon = ccui.ImageView:create()
		self.other_icon:setCascadeOpacityEnabled(true)
		self.other_icon:setAnchorPoint(0.5,0.5)
		self.other_icon:setPosition(self.vSize.width/2,self.vSize.height/2)--底板
		self.other_icon:setScale(1.1)
		self.other_clipNode:addChild(self.other_icon,3)
	end
end
function PreselectionMatchingWindow:setOpponentInfoPanel()
	self:setOpponentPanel()
	if self.enemy_scdata.lookid then
		local config = Config.LooksData.data_data[self.enemy_scdata.lookid]
		if config then
			local id = config.partner_id
			if config.skin_id ~= 0 then
				id = config.mvp_res
			end
			local res_id = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_" .. id)
			self.other_icon:loadTexture(res_id,LOADTEXT_TYPE)
		else
			if self.other_icon then
				local res_id = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_0")
				self.other_icon:loadTexture(res_id,LOADTEXT_TYPE)
			end
		end
	else
		if self.other_icon then
			local res_id = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_0")
			self.other_icon:loadTexture(res_id,LOADTEXT_TYPE)
		end
	end
	if not self.other_head then
		self.other_head = PlayerHead.new(PlayerHead.type.circle)
		self.other_head:setPosition(0 , 0)
		self.other_head_node:addChild(self.other_head)
	end
	self.other_head:setHeadRes(self.enemy_scdata.face_id,false,LOADTEXT_TYPE,self.enemy_scdata.face_file, self.enemy_scdata.face_update_time)
	self.other_head:setLev(self.enemy_scdata.lev)
	self.other_head:showWarldBullyRegion(self.enemy_scdata.nation,0.8,cc.p(103,15))
	local avatar_bid = self.enemy_scdata.avatar_bid or 0
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.other_head:showBg(res, nil, false, vo.offy)
    end
	self.other_name:setString(transformNameByServ(self.enemy_scdata.name, self.enemy_scdata.srv_id))
	self.other_score:setString(string.format(TI18N("语言_c_2586"),self.enemy_scdata.score))
end
function PreselectionMatchingWindow:setOpponentLinePanel()
	-- self.line_up_data
	for k, v in pairs(self.enemy_scdata.defense) do
		if v.order == 1 then
			for k, v in pairs(self.other_hero_list) do
				v:removeFromParent()
				v = nil
			end
			self.other_hero_list = {}
			self:setOppLinePanel(v,self.other_form_icon,self.other_fight_num,self.other_hero_view,self.other_hero_list,self.other_hero_panel_size)
		elseif v.order == 2 then
			for k, v in pairs(self.other_hero_list2) do
				v:removeFromParent()
				v = nil
			end
			self.other_hero_list2 = {}
			self:setOppLinePanel(v,self.other_form_icon2,self.other_fight_num2,self.other_hero_view2,self.other_hero_list2,self.other_hero_panel_size2)
		end
	end
end
function PreselectionMatchingWindow:setOppLinePanel(data,form_icon,power_txt,hero_list,list,size)
	loadSpriteTexture(form_icon, PathTool.getResFrame("form", "form_icon_"..data.formation_type + 7), LOADTEXT_TYPE_PLIST)
	local power = 0
	local temp = {}
	for k, v in pairs(data.partner_infos) do
		local vo = HeroVo.New()
		vo:updateHeroVo(v)
		vo.pos = v.pos
		if vo then
			power = power + vo.power
		end
		table.insert(temp,vo)
	end
	power_txt:setNum(power)

    local width = 119*0.6
    local p_list_size = #temp
    local total_width = p_list_size * width 
    local start_x = 0
    local partner_item = nil
    local max_width = math.max(total_width,size.width) 
    hero_list:setInnerContainerSize(cc.size(max_width,size.height))
    
    for i,v in ipairs(temp) do
        delayRun(self.lineup_panel, i/60, function() 
            if list[i] == nil then 
                partner_item = HeroExhibitionItem.new(0.6, true)
                partner_item:setPosition(start_x + width * 0.5 + (i-1) * width, size.height*0.5)
                partner_item:setData(v)
				partner_item:setVisible(true)
                hero_list:addChild(partner_item)
                list[i] = partner_item
                partner_item:addCallBack(function(item)
                    local vo = item:getData()
                    if vo and next(vo) ~=nil then 
                        local rid = self.enemy_scdata.rid
                        local srv_id = self.enemy_scdata.srv_id
						controller:sender14506(rid,srv_id,data.order,data.pos)
                    end
                end)
            else
                list[i]:setData(v)
				list[i]:setVisible(true)
            end
        end)
    end
end
function PreselectionMatchingWindow:onClickAddBtn(  )
    if model:getStatus() == ArenaworldbullyConst.stage.preliminariesBattle then
        local buy_combat_num = model:getPreBuyCombatNum()
        if buy_combat_num < self.const_cfg.buy_count.val then
            local msg =string.format(TI18N("语言_c_2844"),PathTool.getItemRes(self.const_cfg.buy_cost.val[1]),self.const_cfg.buy_cost.val[2])
            CommonAlert.show(
                msg,
                TI18N("语言_c_63"),
                function()
                    controller:sender14509()
                end,
                TI18N("语言_c_62"),
                nil,
                CommonAlert.type.rich
            )
        else
            message(TI18N("语言_c_6695"))
        end
    else
        local week_time = LangStringFormat(TI18N("语言_c_6686"),self.const_cfg.qualifier_day.val)
        local hour_time = LangStringFormat(TI18N("{1}:00-{2}:00"),self.const_cfg.qualifier_start_time.val[1],self.const_cfg.qualifier_end_time.val[1])
        local txt = string.format(TI18N("语言_c_6753"),week_time,hour_time)
        message(txt)
    end
end
function PreselectionMatchingWindow:_onClickBtnClose()
	controller:openPreselectionMatchingWindow(false)
end
function PreselectionMatchingWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.arranging_btn, handler(self, self._onClickBtnArranging), true, 2)
	registerButtonEventListener(self.matching_buy, handler(self, self.onClickAddBtn), true, 2)
	registerButtonEventListener(self.matching_btn, handler(self, self.onClickMatchingBtn), true, 2)
	registerButtonEventListener(self.fight_btn, handler(self, self.onClickFightBtn), true, 2)
	-- 时空争霸赛预选赛 请求布阵
    self:addGlobalEvent(ArenaworldbullyEvent.GetArenaTeamData, function ( data )
		if data.type == 1 then
			self.line_up_data = data
			self:setSelfLinePanel()
		end
    end)
	-- 时空争霸赛预选赛 匹配
    self:addGlobalEvent(ArenaworldbullyEvent.UpdatePreselectionOpponentData, function ( data )
		if data then
			self:setEnemyData(data)
		end
    end)	
	-- 时空争霸赛预选赛 积分变化
    self:addGlobalEvent(ArenaworldbullyEvent.UpdatePreselectionData, function ( data )
		if data then
			self:updateScoreCount()
		end
    end)
	
    if self.update_preselection_data == nil then
        self.update_preselection_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdatePreselectionData, function(data)
            self:setData()
        end)
    end
end
function PreselectionMatchingWindow:setEnemyData(data)
	if not data then return end
    self.enemy_scdata = data
    if self.enemy_scdata.is_match == 1 then
        --在匹配中
        self.matching_btn_txt:setString(TI18N("语言_c_3918"))
		self.matching_btn:setVisible(true)
		self.fight_btn:setVisible(false)
		self.other_lineup_panel:setVisible(false)
        self:updateMatchBtn(true)
        self:playMatchEffect(true)
        self.is_matching = true
        self.is_data_back = false
        self:setBtnTime()
        return
    end
    if #self.enemy_scdata.defense > 0 then
        --已有匹配对手
        self.is_data_back = true
        local time = data.to_combat_time - GameNet:getInstance():getTime()
        if time < 0 then
            time = 0 
        end
        self:setDataByCondition(time)
        -- self.enemy_scdata
    else
        self:playMatchEffect(false)
        self:updateMatchBtn(true)
        self.is_matching = false
        self:reloadMatchUI()
		-- if self.other_clipNode then
		-- 	self.other_clipNode:setVisible(false)
		-- end
		self:setOpponentPanel()
		if self.other_icon then
			local res_id = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_0")
			self.other_icon:loadTexture(res_id,LOADTEXT_TYPE)
		end
    end
end
function PreselectionMatchingWindow:reloadMatchUI()
    
    self.step_time:stopAllActions()
    self.step_time:setString("")

    self.matching_btn_txt:stopAllActions()
    self.matching_btn_txt:setString(TI18N("语言_c_3918"))
	self.other_lineup_panel:setVisible(false)
	self.fight_btn:setVisible(false)
	self.matching_btn:setVisible(true)
end
function PreselectionMatchingWindow:setDataByCondition(time)
    -- if not self.is_matching then end
    -- if self.is_time_out and self.is_data_back then
	if self.is_data_back then
		self.fight_btn:setVisible(true)
		self.matching_btn:setVisible(false)
        self.matching_btn_txt:stopAllActions()

        self:updateMatchBtn(false)
        self:playMatchEffect(false)

        if self.enemy_scdata then
			self.other_lineup_panel:setVisible(true)
            self:setOpponentInfoPanel()
			self:setOpponentLinePanel()
        end
        self.is_matching = false
        local time = time or 5
        self:setStepTime(time)
    end
end

--设置倒计时
function PreselectionMatchingWindow:setStepTime(less_time)
    local less_time =  less_time or 0
    if tolua.isnull(self.step_time) then
        return
    end
    self.step_time:stopAllActions()
    if less_time > 0 then
        self:setStepTimeFormatString(less_time)
        self.step_time:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1),
            cc.CallFunc:create(function()
                less_time = less_time - 1
                if less_time < 0 then
                    self.step_time:stopAllActions()
                    -- self:onClickRightBtn()
                    self.step_time:setString("")
                else
                    self:setStepTimeFormatString(less_time)
                end
            end))))
    else
        self:setStepTimeFormatString(less_time)
    end
end

function PreselectionMatchingWindow:setStepTimeFormatString(time)
    local str = string.format(TI18N("语言_c_3926"), time)
    self.step_time:setString(str)
end
--设置倒计时
function PreselectionMatchingWindow:setBtnTime()
    if tolua.isnull(self.matching_btn_txt) then
        return 
    end
    self.matching_btn_txt:stopAllActions()
    local btn_time = 1
    self:setBtnTimeFormatString(btn_time)
    self.matching_btn_txt:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(0.5),
    cc.CallFunc:create(function()
            btn_time = btn_time + 1
            if btn_time > 4 then
                btn_time = 1
            end
            self:setBtnTimeFormatString(btn_time)
    end))))
   
end

function PreselectionMatchingWindow:setBtnTimeFormatString(time)
    if time == 1 then
        self.matching_btn_txt:setString(TI18N("语言_c_2572"))
    elseif time == 2 then
        self.matching_btn_txt:setString(TI18N("语言_c_2573"))
    elseif time == 3 then
        self.matching_btn_txt:setString(TI18N("语言_c_2567"))
    else
        self.matching_btn_txt:setString(TI18N("语言_c_2566"))
    end

end
--播放匹配的效果
function PreselectionMatchingWindow:playMatchEffect(status)
	if self.play_effect then
		self.play_effect:clearTracks()
		self.play_effect:removeFromParent()
		self.play_effect = nil
	end
    if status == false then
        if self.scroll_audio_effect then
            AudioManager:getInstance():removeEffectBySoundId(self.scroll_audio_effect)
            self.scroll_audio_effect = nil
        end
		if self.other_icon then
			self.other_icon:setVisible(true)
		end
    else
        -- self.play_effect = createEffectSpine(Config.EffectData.data_effect_info[681], cc.p(0, 0), cc.p(0.5, 0.5), false, PlayerAction.action_2)
        if self.scroll_audio_effect == nil then
            self.scroll_audio_effect = AudioManager:getInstance():playEffectForHandAudoRemove(AudioManager.AUDIO_TYPE.COMMON,"c_scroll", true)
        end
		if not self.other_clipNode then
			local mask_res = PathTool.getResFrame("time_warp","match_3",false,"match")
			self.vSize = cc.size(184,399)
			self.other_mask = createSprite(mask_res, 184/2, 399/2, nil, cc.p(0.5, 0.5))--模板
			self.other_clipNode = cc.ClippingNode:create(self.other_mask)
			self.other_clipNode:setScaleX(-1)
			self.other_clipNode:setAnchorPoint(cc.p(0.5,0.5))
			self.other_clipNode:setContentSize(self.vSize)
			self.other_clipNode:setCascadeOpacityEnabled(true)
			self.other_clipNode:setPosition(188, 204)
			self.other_clipNode:setAlphaThreshold(0)
			self.opponent_panel:addChild(self.other_clipNode,2)
		end
		if not self.play_effect then
			self.play_effect = createEffectSpine("E24178", cc.p(95,45), cc.p(0.5, 0.5), true, PlayerAction.action)
			self.play_effect:setScaleX(-1)
			self.play_effect:setZOrder(999999)
			self.other_clipNode:addChild(self.play_effect, 1)
		end
		if self.other_icon then
			self.other_icon:setVisible(false)
		end
    end
end

function PreselectionMatchingWindow:updateMatchBtn(status)
    if not self.enemy_scdata then return end
    if status then
        local cur_time = GameNet:getInstance():getTime()
        if cur_time < self.enemy_scdata.match_cd_time then
            --说明有冷却时间
            self.matching_btn_txt:disableEffect(cc.LabelEffect.OUTLINE)
            setChildUnEnabled(true, self.matching_btn)
			self.matching_btn:setTouchEnabled(false)
            --变灰按钮中
            self.unenble_right_btn = true
            local time = self.enemy_scdata.match_cd_time - cur_time
            -- self:setCoolTime(time)
        end
    else
        self.unenble_right_btn = false
        setChildUnEnabled(false, self.matching_btn)
		self.matching_btn:setTouchEnabled(true)
        self.matching_btn_txt:enableOutline(Config.ColorData.data_color4[264], 2)
    end
end

--设置冷却时间的倒计时
function PreselectionMatchingWindow:setCoolTime(less_time)
    local less_time =  less_time or 0
	if less_time < 0 then
		self:updateMatchBtn(false)
	end
end

function PreselectionMatchingWindow:onClickFightBtn()
	MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.WorldPreselection)
	controller:sender14507()
	-- self:_onClickBtnClose()
end
function PreselectionMatchingWindow:onClickMatchingBtn()
	
    if model:getPreCanCombatNum() < 1 then
        self:onClickAddBtn()
        return
    end
	controller:sender14504(0)
	self:playMatchEffect(true)
	delayRun(self.container, 1, function() 
		self:setDataByCondition()
	end)
end
function PreselectionMatchingWindow:_onClickBtnArranging()
	-- if self.enemy_scdata.is_match == 1 or #self.enemy_scdata.defense > 0 then
	-- 	message(TI18N("无法布阵"))
	-- else
		HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.WorldPreselection, {}, HeroConst.FormShowType.eFormSave)
	-- end
end
function PreselectionMatchingWindow:close_callback(  )
	if self.update_preselection_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_preselection_data)
        self.update_preselection_data = nil
    end
	if self.my_fight_num then
        self.my_fight_num:DeleteMe()
    end
    self.my_fight_num = nil
	if self.my_fight_num2 then
        self.my_fight_num2:DeleteMe()
    end
    self.my_fight_num2 = nil
	if self.other_fight_num then
        self.other_fight_num:DeleteMe()
    end
    self.other_fight_num = nil
	if self.other_fight_num2 then
        self.other_fight_num2:DeleteMe()
    end
    self.other_fight_num2 = nil
    self.matching_btn_txt:stopAllActions()
	self:_onClickBtnClose()
end