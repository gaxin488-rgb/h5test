PreselectionRankWindow = PreselectionRankWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()
function PreselectionRankWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/preselection_rank_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function PreselectionRankWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.bg = self.main_container:getChildByName("bg")
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.Image_2 = self.main_panel:getChildByName("Image_2")
	self.win_title = self.main_panel:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_271"))
	autoSizeTitleBg(self.win_title,self.Image_2)
	self.close_btn = self.main_panel:getChildByName("close_btn")
	self.container = self.main_container:getChildByName("container")
	self.title_1 = self.container:getChildByName("title_1")
	self.title_1:setString(TI18N("语言_c_255"))
	self.title_2 = self.container:getChildByName("title_2")
	self.title_2:setString(TI18N("语言_c_5107"))
	self.title_3 = self.container:getChildByName("title_3")
	self.title_3:setString(TI18N("语言_c_452"))
	self.tip = self.container:getChildByName("tip")
	self.tip:setString(TI18N("语言_c_6696"))
	self.scroll_container = self.container:getChildByName("scroll_container")
	self.empty_bg = self.scroll_container:getChildByName("empty_bg")
	self.desc_label = self.empty_bg:getChildByName("desc_label")
	self.desc_label:setString(TI18N("语言_c_5410"))
	self.my_container = self.container:getChildByName("my_container")
	self.Image_11 = self.my_container:getChildByName("Image_11")
	self.rank_img = self.my_container:getChildByName("rank_img")
	self.score_num = self.my_container:getChildByName("score_num")
	self.my_rank_title = self.my_container:getChildByName("my_rank_title")
	self.my_rank_title:setString(TI18N("语言_c_258"))
	self.role_name = self.my_container:getChildByName("role_name")
	self.role_power = self.my_container:getChildByName("role_power")
	self.no_rank = self.my_container:getChildByName("no_rank")
	self.no_rank:setString(TI18N("语言_c_285"))
	self.rank_id = self.my_container:getChildByName("rank_id")
end

function PreselectionRankWindow:openRootWnd()
	controller:sender14511()
	self:setData()
end
function PreselectionRankWindow:setData(data)
	self.data = data
	self:UpdateSelfPanel()
	if self.group_view == nil then
        local scroll_view_size = self.scroll_container:getContentSize()
        local setting = {
            item_class = PreselectionRankItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 5,                    -- 第一个单元的Y起点
            space_y = 3,                   -- y方向的间隔
            item_width = 600,               -- 单元的尺寸width
            item_height = 130,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.scroll_container, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	if self.data and self.data.rank_list and next(self.data.rank_list) then
		self.group_view:setData(data.rank_list)
		self.group_view:setVisible(true)
		self.empty_bg:setVisible(false)
	else
		self.group_view:setVisible(false)
		self.empty_bg:setVisible(true)
	end
end

function PreselectionRankWindow:UpdateSelfPanel()
	if not self.data then return end
	self.score_num:setString(model:getPreScore())
	self.role_name:setString(role_vo.name)
	local list = {}
    for k, v in pairs(self.data.rank_list) do
        if v.rid == role_vo.rid and v.srv_id == role_vo.srv_id then
            list = v
        end
    end
	if list.power then
		self.role_power:setString(MoneyTool.moneyFormat(list.power))
	else
		self.role_power:setString(MoneyTool.moneyFormat(role_vo.power))
	end
	if not self.head_node then
		self.head_node = PlayerHead.new(PlayerHead.type.circle)
		self.head_node:setHeadLayerScale(0.9)
		self.head_node:setPosition(cc.p(160, 80))
		self.head_node:setTouchEnabled(true)
		self.head_node:addCallBack( function()
			local role_vo = RoleController:getInstance():getRoleVo()
			if role_vo and role_vo.srv_id and role_vo.rid then
				FriendController:getInstance():openFriendCheckPanel(true, {srv_id = role_vo.srv_id, rid = role_vo.rid})
			end
		end,false)
		self.my_container:addChild(self.head_node)
	end
	self.head_node:showWarldBullyRegion(model:getnation(),0.8,cc.p(55,15))
	self.head_node:setHeadRes(role_vo.face_id, false, LOADTEXT_TYPE, role_vo.face_file, role_vo.face_update_time)
	self.head_node:setLev(role_vo.lev)
	local avatar_bid = role_vo.avatar_base_id
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.head_node:showBg(res, nil, false, vo.offy)
    end
	if self.data and self.data.rank ~= 0 then
		self.no_rank:setVisible(false)
		if self.data.rank <= 3 then
			local res_id = PathTool.getResFrame("common", string.format("common_200%s", self.data.rank))
			loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
			self.rank_img:setVisible(true)
			self.rank_id:setVisible(false)
		else
			self.rank_img:setVisible(false)
			self.rank_id:setVisible(true)
			self.rank_id:setString(self.data.rank)
		end
	else
		self.rank_img:setVisible(false)
		self.rank_id:setVisible(false)
		self.no_rank:setVisible(true)
	end
end

function PreselectionRankWindow:_onClickBtnClose()
	controller:openPreselectionRankWindow(false)
end
function PreselectionRankWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	if self.update_rank_data == nil then
        self.update_rank_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateRankData, function(data)
            if not data then return end
            self:setData(data)
        end)
    end
end

function PreselectionRankWindow:close_callback(  )
	if self.update_rank_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_rank_data)
        self.update_rank_data = nil
    end
	self:_onClickBtnClose()
end

--子项
PreselectionRankItem = class("PreselectionRankItem", function()
    return ccui.Widget:create()
end)

function PreselectionRankItem:ctor()
    self:configUI()
    self:register_event()
end

function PreselectionRankItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_rank_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(660,130))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_panel")
    self.bg = self.main_container:getChildByName("bg")
	self.rank_id = self.main_container:getChildByName("rank_id")
	self.rank_image = self.main_container:getChildByName("rank_image")
	self.my_guild_label = self.main_container:getChildByName("my_guild_label")
	self.my_attk_label = self.main_container:getChildByName("my_attk_label")
	self.my_name_label = self.main_container:getChildByName("my_name_label")
end

function PreselectionRankItem:register_event( )

end

function PreselectionRankItem:setData(data)
	if data.rank_score > 3 or data.rank_score == 0 then
		self.rank_image:setVisible(false)
		self.rank_id:setVisible(true)
		self.rank_id:setString(data.rank_score)
	else
		self.rank_image:setVisible(true)
		self.rank_id:setVisible(false)
		self.rank_image:loadTexture(PathTool.getResFrame("common", "common_"..3000+data.rank_score),LOADTEXT_TYPE_PLIST)
	end
	if not self.head_icon then
		self.head_icon = PlayerHead.new(PlayerHead.type.circle)
		self.main_container:addChild(self.head_icon)
		self.head_icon:setPosition(cc.p(151, 70))
        self.head_icon:setScale(0.8)
		self.head_icon:setTouchEnabled(true)		
		self.head_icon:addCallBack( function()
			if data ~= nil then
				if data and data.srv_id and data.rid then 
					FriendController:getInstance():openFriendCheckPanel(true, {srv_id = data.srv_id, rid = data.rid})
				end
			end
		end,false)
	end
	self.head_icon:setHeadRes(data.face_id, false, LOADTEXT_TYPE)
	local avatar_bid = data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.head_icon:showBg(res, nil, false, vo.offy)
    end
	self.head_icon:showWarldBullyRegion(data.nation,0.8,cc.p(54,7))
	self.my_name_label:setString(transformNameByServ(data.name,data.srv_id))
	self.my_attk_label:setString(MoneyTool.moneyFormat(data.power))
	self.my_guild_label:setString(data.score)
end

function PreselectionRankItem:DeleteMe()

end