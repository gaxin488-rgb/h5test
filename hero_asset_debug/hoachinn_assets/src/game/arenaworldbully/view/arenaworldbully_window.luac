function ArenaworldbullyWindow:openRootWnd()
    self.const_cfg = Config.ArenaTimeWarpData.data_const
    self.period = model:getPeriod()
	self.period_date = Config.ArenaTimeWarpData.data_period_date[self.period]
    if self.period_date then
        controller:sender14510()
        controller:sender14503()
        controller:sender14520()
        controller:sender14530()
        self:setData()
    end
    self:updateBtnTurntableRed()
    self:updateBtnReward()
    self:updateOrderRed()
end
function ArenaworldbullyWindow:setData()
    if model:getStatus() == ArenaworldbullyConst.stage.award then
        self.btn_panel:setVisible(false)
        self.bottom_panel:setVisible(false)
        self.reward_panel:setVisible(true)
        self.close_panel:setVisible(false)
        self.btn_shop:setVisible(false)
        self.btn_turntable:setVisible(false)
        self.btn_rank:setVisible(true)
        self.btn_order:setPositionY(1023)
        if model:getSignUpEndTime() then
            ActionController:getModel():setCountDownTime(self.reward_time_value,model:getSignUpEndTime() - GameNet:getInstance():getTime())
        end
    elseif model:getStatus() == ArenaworldbullyConst.stage.preview then
        self.btn_panel:setVisible(true)
        self.btn_shop:setVisible(true)
        self.btn_turntable:setVisible(true)
        self.bottom_panel:setVisible(true)
        self.reward_panel:setVisible(false)
        self.close_panel:setVisible(false)
        self.btn_rank:setVisible(false)
        local start_time = LangStringFormat(TI18N("语言_c_6611"),self.period_date.signup_start_time)
        local end_time = LangStringFormat(TI18N("语言_c_6611"),self.period_date.signup_end_time)
        self.sign_up_value:setString(string.format(TI18N("%s-%s"),start_time,end_time))
        local start_time = LangStringFormat(TI18N("语言_c_6611"),self.period_date.score_start_time)
        local end_time = LangStringFormat(TI18N("语言_c_6611"),self.period_date.award_end_time)
        self.open_time_value:setString(string.format(TI18N("%s-%s"),start_time,end_time))
        local txt = TI18N("语言_c_6612")
        self.one_condition_value:setString(transformTextToShort(txt,22))
        addEvt2showAllTextTips(self.one_condition_value,txt,22)
        local txt_1 = string.format(TI18N("语言_c_6597"),self.const_cfg.registration_condition.val)
        self.cross_condition_value:setString(transformTextToShort(txt_1,22))
        addEvt2showAllTextTips(self.cross_condition_value,txt_1,22)
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 2
        setting.max_count = 6
        setting.is_center = false
        self.item_list1 = commonShowSingleRowItemList(self.reward_scrollView, self.item_list1, self.period_date.registration_reward_preview, setting)
        self.btn_order:setPositionY(1132)
    elseif model:getStatus() == ArenaworldbullyConst.stage.close or model:getStatus() == ArenaworldbullyConst.stage.over then
        self.btn_panel:setVisible(false)
        self.btn_shop:setVisible(true)
        self.btn_turntable:setVisible(true)
        self.bottom_panel:setVisible(false)
        self.reward_panel:setVisible(false)
        self.close_panel:setVisible(true)   
        self.btn_rank:setVisible(true)   
        self.btn_order:setPositionY(805)
    end
    self.btn_order:setVisible(model:getOrderIsOpen())
    self:updateBattleReward()
    self:updateGuessReward()
    -- self:updateFirstReward()
end
function ArenaworldbullyWindow:updateBtnReward()
    local status = model:getRedForIndex(ArenaworldbullyConst.RedType.Strongpoint) or model:getRedForIndex(ArenaworldbullyConst.RedType.GuessReward) or model:getRedForIndex(ArenaworldbullyConst.RedType.FirstReward)
    self.btn_reward:setVisible(status)
    addRedPointToNodeByStatus(self.btn_reward,status,10,10)
    if not status then
        self.fight_scrollView:setVisible(false)
        self.fight_tip:setVisible(true)
    end
end
function ArenaworldbullyWindow:updateBattleReward()
    if model:getPrePeriodReward() == 1 then
        local group_cfg = Config.ArenaTimeWarpData.data_group[model:getPreGroupId()].period_reward
        local list = {}
        for k, v in pairs(group_cfg) do
            if v[1] == model:getPreRoomId() then
                list = v[2]
            end
        end
        self.fight_list = list
    else
        self.fight_list = {}
    end
    self:setRewardPanel()
end
function ArenaworldbullyWindow:setRewardPanel()
    local list = {}
    for k, v in pairs(self.fight_list) do
        table.insert(list,v)
    end
    for k, v in pairs(self.guess_list) do
        table.insert(list,v)
    end
    for k, v in pairs(self.first_list) do
        table.insert(list,v)
    end
    if next(list) then
        self.fight_tip:setVisible(false)
        self.fight_scrollView:setVisible(true)
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 2
        setting.max_count = 4
        setting.is_center = false
        self.item_list = commonShowSingleRowItemList(self.fight_scrollView, self.item_list, list, setting)
        self.btn_reward:setVisible(true)
    else
        self.fight_tip:setVisible(true)
        self.fight_scrollView:setVisible(false)
        self.btn_reward:setVisible(false)
    end
end
function ArenaworldbullyWindow:updateGuessReward()
    self.guess_list = {}
    if model:getOverBetReward() > 0 then
        local list = {}
        list[1] = Config.ArenaTimeWarpData.data_const["happy_coin_item"].val
        list[2] = model:getOverBetReward()
        table.insert(self.guess_list,list)
    else
        self.guess_list = {}
    end
    self:setRewardPanel()
end

function ArenaworldbullyWindow:updateOrderRed(  )
    addRedPointToNodeByStatus(self.btn_order,model:getRedForIndex(ArenaworldbullyConst.RedType.OrderTask),10,10)
end

function ArenaworldbullyWindow:updateFirstReward(data)
    self.first_list = {}
    if data and data.ext_list and next(data.ext_list) then
        for k, v in pairs(data.ext_list) do
            if v.state == 1 then
                for key, value in pairs(v.item_list) do
                    local _list = {}
                    _list[1] = value.item_id
                    _list[2] = value.item_num
                    table.insert(self.first_list,_list)
                end
            end
        end
    end
    self:setRewardPanel()
end
function ArenaworldbullyWindow:_onClickBtnForm()
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.WorldPreselection, {}, HeroConst.FormShowType.eFormSave)
end
function ArenaworldbullyWindow:_onClickBtnClose()
	controller:openArenaworldbullyWindow(false)
end
function ArenaworldbullyWindow:_onClickBtnTurntable()
	controller:openArenaworldbullyTurntablePanel(true,4)
end
function ArenaworldbullyWindow:_onClickBtnFabulous()
    RoleController:getInstance():requestWorshipRole(self.select_item_vo.rid, self.select_item_vo.srv_id, self.select_item_vo.group,WorshipType.arenaworldbully)
end
