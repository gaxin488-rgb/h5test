ArenaworldbullyWindow = ArenaworldbullyWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function ArenaworldbullyWindow:__init()
	self.is_full_screen = true
	self.layout_name = "arenaworldbully/arenaworldbully_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("time_warp", "competition"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("time_warp", "qualifier"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("common", "common_1"), type = ResourcesType.plist},
	}
    self.select_item_vo = {}
    self.role_list = {}
    self.fight_list = {}
    self.guess_list = {}
    self.first_list = {}
    self.rank_list = {}
    self.scroll_list = {}
end

