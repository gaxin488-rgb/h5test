ArenaworldbullyMallWindow = ArenaworldbullyMallWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function ArenaworldbullyMallWindow:__init()
	self.is_full_screen = true
	self.layout_name = "arenaworldbully/arenaworldbully_mall_window"

	self.res_list = {
		
	}
	self.tab_list = {}
	self.cur_tab_index = ArenaworldbullyConst.Shop_Tab_Index.Arenaworld  -- 当前选中的tab按钮
end

function ArenaworldbullyMallWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_panel = self.main_container:getChildByName("main_panel")
	self.close_btn = self.main_panel:getChildByName("close_btn")
    self.Image_2 = self.main_panel:getChildByName("Image_2")
    self.win_title = self.main_panel:getChildByName("win_title")
    self.panel = self.main_panel:getChildByName("panel")
    self.win_title:setString(TI18N("语言_c_3347"))
    autoSizeTitleBg(self.win_title,self.Image_2)
    self:playEnterAnimatianByObj(self.main_container , 1) 
	local tab_container = self.main_panel:getChildByName("tab_container")
	for i=1,2 do
		local tab_btn = tab_container:getChildByName("tab_btn_" .. i)
		if tab_btn then
			local object = {}
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(true)
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
			object.text = tab_btn:getChildByName('title')
			setTextMaxWidth(object.text,160)
			object.tip = tab_btn:getChildByName('tab_tips')
			object.tip:setVisible(false)
            object.tab_btn = tab_btn
            object.index = i
            self.tab_list[i] = object
		end
	end
    self.tab_list[1].text:setString(TI18N("语言_c_6588"))
	self.tab_list[2].text:setString(TI18N("语言_c_6589"))
	setTextSpacing(self.tab_list[1].text,-10)
	setTextSpacing(self.tab_list[2].text,-10)

	-- 适配
	local top_off = display.getTop(self.main_container)
    local container_size = self.main_container:getContentSize()
	local bottom_off = display.getBottom(self.main_container)
    
    -- local tab_y = tab_container:getPositionY()
    -- tab_container:setPositionY(top_off - (container_size.height - tab_y))
	-- local tab_y = self.close_btn:getPositionY()
	-- self.close_btn:setPositionY(bottom_off + tab_y)
end

function ArenaworldbullyMallWindow:openRootWnd(index)
	self.cur_tab_index = index or ArenaworldbullyConst.Shop_Tab_Index.Arenaworld
	self:changeSelectedTab(self.cur_tab_index)
	-- if model:getStatus() == ArenaworldbullyConst.stage.close or model:getStatus() == ArenaworldbullyConst.stage.over then
		-- self.tab_list[2].tab_btn:setVisible(false)
	-- end
end

function ArenaworldbullyMallWindow:_onClickBtnClose()
	controller:openArenaworldbullyMallWindow(false)
end
function ArenaworldbullyMallWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	-- tab按钮
	for k, object in pairs(self.tab_list) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab(object.index)
				end
			end)
		end
	end
end

-- 切换标签页
function ArenaworldbullyMallWindow:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end
    for k, object in pairs(self.tab_list) do
        object.select_bg:setVisible(false)
    end
    self.tab_object = self.tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
    end
	
	self.cur_tab_index = index
	if index == ArenaworldbullyConst.Shop_Tab_Index.Arenaworld then
        if self.action_mall_panel then
            self.action_mall_panel:setVisible(false)
        end
        if not self.mall_panel then
            self.mall_panel = MallPanel.new()
            self.panel:addChild(self.mall_panel)
        end
        self.mall_panel:setVisible(true)
    elseif index == ArenaworldbullyConst.Shop_Tab_Index.Action then
        if self.mall_panel then
            self.mall_panel:setVisible(false)
        end
        if not self.action_mall_panel then
            self.action_mall_panel = ActionMallPanel.new()
            self.panel:addChild(self.action_mall_panel)
        end
        self.action_mall_panel:setVisible(true)
    end
end
function ArenaworldbullyMallWindow:close_callback(  )
	if self.mall_panel then
        self.mall_panel:DeleteMe()
        self.mall_panel = nil
    end
	if self.action_mall_panel then
        self.action_mall_panel:DeleteMe()
        self.action_mall_panel = nil
    end
	self:_onClickBtnClose()
end