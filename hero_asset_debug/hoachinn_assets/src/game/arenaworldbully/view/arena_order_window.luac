ArennRewardItem = class("ArennRewardItem", function()
    return ccui.Widget:create()
end)

function ArennRewardItem:ctor(type)
    self.size = cc.size(100, 139)
    self:configUI(type)
    self:register_event()
end

function ArennRewardItem:configUI(type)
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_11"),
        self.size.width / 2, self.size.height / 5 + 11, cc.p(0.5, 0.5), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(71, 37))
    self.num_txt = createLabel(20, Config.ColorData.data_color4[1], nil, self.size.width / 2 - 2,
        self.size.height / 5 + 11, "", self.root_wnd, nil, cc.p(0.5, 0.5))
end

function ArennRewardItem:register_event()
end

function ArennRewardItem:setData(data,OrderBid,comp_id,index)
    if not data then
        return
    end
    self.data = data
    self.orderReceive = arena_model:getOrderReceive(index)
    self.holiday_bid=OrderBid
    self.camp_id=comp_id
    if not self.select_img then 
        local resid= Config.MonopolyOrderData.data_constant[comp_id].item_id
        local itemcfg = Config.ItemData.data_get_data(resid)
        self.select_bg = createSprite(PathTool.getItemRes(itemcfg.icon),self.size.width / 2, self.size.height / 2 + 6,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE)
        setChildUnEnabled(true,self.select_bg)
        self.select_img = createSprite(PathTool.getItemRes(itemcfg.icon),self.size.width / 2, self.size.height / 2 + 6,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE)
    end
    self.select_img:setVisible(false)
    -- 进度条相关
    local cfg = Config.MonopolyOrderData.data_quest_list[self.camp_id]
    -- local id = self.data.id
    -- local last_id = id + 1
    if cfg[self.data.goal_id+1] then
        if self.comp_bar == nil then
            local size = cc.size(139, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(50, 77))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 0, 0)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(139, 27))
            self.comp_bar:setContentSize(cc.size(139, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        local id = arena_model:getReceiveFinish()
        if self.orderReceive then
            if self.orderReceive.id < id then
                self.comp_bar:setPercent(100)
                self.select_img:setVisible(true)
            elseif self.orderReceive.id == id then
                self.select_img:setVisible(true)
                local nextData = arena_model:getOrderReceive(index+1)
                if nextData then
                    self.comp_bar:setPercent((nextData.value - self.orderReceive.value)/(nextData.target_val - self.orderReceive.target_val)*100)
                else
                    self.comp_bar:setPercent(0)
                end
            else
                self.comp_bar:setPercent(0)
            end
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
        local id = arena_model:getReceiveFinish()
        if self.orderReceive and self.orderReceive.id == id then
            self.select_img:setVisible(true)
        end
    end
    self.num_txt:setString(cfg[self.data.goal_id].progress[1].target_val)
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(self.data.goal_id)
end

function ArennRewardItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end


ArenaOrderRewardItem = class("ArenaOrderRewardItem", function()
    return ccui.Widget:create()
end)

function ArenaOrderRewardItem:ctor()
    self:configUI()
    self:register_event()
end

function ArenaOrderRewardItem:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("arenaworldbully/arena_order_reward_item"))
    self:setContentSize(cc.size(720, 139))
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.goods_item = main_container:getChildByName("goods_item") -- 付费礼物
    self.goods_item:setScrollBarEnabled(false)
    self.free_goods_item = main_container:getChildByName("free_goods_item") -- 免费礼物
    self.free_goods_item:setScrollBarEnabled(false)
    self.finish_img = main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_name = self.btn_get:getChildByName("name")
    self.btn_name:setString("")
end

function ArenaOrderRewardItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        local is_unlock = arena_model:getOrderStatus()
        if is_unlock then -- 战令已解锁
            if self.orderReceive.reward == 1 or self.orderReceive.rmb_reward == 1 then
                if arena_model:canReceiveMax(self.data.goal_id,self.camp_id) then -- 达到活动天数
                    controller:sender27508(self.orderid,self.orderReceive.id)
                else
                    message(TI18N("语言_c_5278"))
                end
            elseif self.orderReceive.reward == 0 or self.orderReceive.rmb_reward == 0 then
                arena_controller:openArenaOrderWindow(false)
            end
        else -- 未解锁
            if self.orderReceive.reward == 1 then -- 可领取
                if arena_model:canReceiveMax(self.data.goal_id,self.camp_id) then -- 达到活动天数
                    controller:sender27508(self.orderid,self.orderReceive.id)
                else
                    message(TI18N("语言_c_5278"))
                end
            elseif self.orderReceive.reward == 2 then -- 前往购买
                local config = Config.MonopolyOrderData.data_constant[self.camp_id]
                if config.recharge_id2 == 0 then
                    arena_controller:openArenaOrderBuyCardWindow(true,self.camp_id)
                else
                    arena_controller:openArenaOrderBuyCardWindow2(true,self.camp_id)
                end
            elseif self.orderReceive.reward == 0 then -- 前往过关
                arena_controller:openArenaOrderWindow(false)
            end
        end
    end, true, 1)
end

function ArenaOrderRewardItem:setData(data,comp_id,orderid,index)
    if not data then
        return
    end
    self.data = data
    self.camp_id=comp_id
    self.orderid=orderid
    self.orderReceive = arena_model:getOrderReceive(index) or {}
    local free_effect_id = false
    local free_data_list = data.award or {}
    local status = self.orderReceive.reward == 0
    local setting1 = {}
    setting1.start_x = 10
    setting1.scale = 0.7
    setting1.is_tip = true
    setting1.lock = status
    setting1.is_lock_bg = status
    setting1.show_effect_id = free_effect_id
    setting1.is_get_status = self.orderReceive.reward == 2
    setting1.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.free_item_list = commonShowSingleRowItemList(self.free_goods_item, self.free_item_list, free_data_list,setting1)

    -- 进阶奖励
    local is_locak_status = arena_model:getOrderStatus() -- 战令解锁状态
    local pay_effect_id = false
    -- 付费道具
    local data_list = data.rmb_award or {}
    local rmbStatus = self.orderReceive.rmb_reward == 0
    local setting = {}
    setting.start_x = 10
    setting.scale = 0.7
    setting.lock = rmbStatus
    setting.is_lock_bg = rmbStatus
    setting.is_tip = true
    setting.show_effect_id = pay_effect_id
    setting.is_get_status = self.orderReceive.rmb_reward == 2
    setting.max_count = 2
    setting.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.item_list = commonShowSingleRowItemList(self.goods_item, self.item_list, data_list, setting)

    if self.btn_get then
        addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
        if is_locak_status then -- 战令已经解锁
            if self.orderReceive.rmb_reward == 1 then -- 可领取
                self.btn_name:enableOutline(Config.ColorData.data_color4[264], 2)
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 10, 10)
                setChildUnEnabled(false,self.btn_get)
            elseif self.orderReceive.rmb_reward == 2 then -- 已领取
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
                addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
            elseif self.orderReceive.rmb_reward == 0 then -- 前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
            end
        else -- 战令未解锁时
            if self.orderReceive.reward == 1 then -- 可领取
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 10, 10)
                setChildUnEnabled(false,self.btn_get)
            elseif self.orderReceive.reward == 2 then -- 前往购买
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
            elseif self.orderReceive.reward == 0 then
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
            end
        end
    end
end

function ArenaOrderRewardItem:DeleteMe()
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.common_goods_item then
        self.common_goods_item:DeleteMe()
        self.common_goods_item = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end


------------------------------------------
-- 子项
ArenaOrderPrivilegeItem = class("ArenaOrderPrivilegeItem", function()
    return ccui.Widget:create()
end)

function ArenaOrderPrivilegeItem:ctor()
    self:configUI()
    self:register_event()
end

function ArenaOrderPrivilegeItem:configUI(  )
    self.size = cc.size(680,140)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)

    local csbPath = PathTool.getTargetCSB("arenaworldbully/arena_order_privilege_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.name_bg = self.main_container:getChildByName("name_bg")
    self.name = self.main_container:getChildByName("name")
    self.desc_scroll = self.main_container:getChildByName("desc_scroll")
    self.desc_scroll:setScrollBarEnabled(false)
    self.desc = self.desc_scroll:getChildByName("desc")
    self.back_item = BackPackItem.new(true,true,false,0.7,true,true)
    self.main_container:addChild(self.back_item)
    self.back_item:setPosition(cc.p(73,62))
    self.over_img = self.main_container:getChildByName("over_img")
    self.over_img:setVisible(false)
end

function ArenaOrderPrivilegeItem:register_event( )
end

function ArenaOrderPrivilegeItem:setData(data,num,index)
    local cfg = Config.ItemData.data_get_data(data)
    self.back_item:setBaseData(data,1)
    self.desc:setChangeScaleOffWidth(-9999999)
    self.name:setString(string.format(TI18N("语言_c_6780"),index))
    local _w = math.max(self.name:getContentSize().width+50,self.name_bg:getContentSize().width)
    self.name_bg:setContentSize(cc.size(_w,self.name_bg:getContentSize().height))
    local desc_str = ""
    if cfg and cfg.desc then
        desc_str = cfg.desc
    end
    self.desc:setString(desc_str)
    setTextMaxWidth(self.desc,500)
    local _h = math.max(self.desc_scroll:getContentSize().height,self.desc:getContentSize().height)
    self.desc_scroll:setInnerContainerSize(cc.size(self.desc_scroll:getContentSize().width,_h))
    self.desc:setPositionY(_h)
    if num == 2 then
        self.over_img:setVisible(true)
    else
        self.over_img:setVisible(false)
    end
end

function ArenaOrderPrivilegeItem:DeleteMe( )
    
    self:removeAllChildren()
    self:removeFromParent()
end