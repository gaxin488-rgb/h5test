end

function ArenaOrderRankItemItem:configUI(  )
    self.size = cc.size(688,152)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)

    local csbPath = PathTool.getTargetCSB("arenaworldbully/arena_order_rank_item_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.btn_goto = main_container:getChildByName("btn_goto")
    self.btn_goto:getChildByName("Text_6"):setString(TI18N("语言_c_108"))
    self.btn_goto:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_get:getChildByName("Text_5"):setString(TI18N("语言_c_109"))
    self.btn_get:setVisible(false)
    self.btn_has = main_container:getChildByName("btn_has")
    self.btn_has:setVisible(false)

    self.goods_con = main_container:getChildByName("good_cons")

    self.Image_1 = main_container:getChildByName("Image_1")
    self.line = main_container:getChildByName("line")

    self.btn_goto:setPositionY(63)
    self.btn_get:setPositionY(63)
    self.btn_has:setPositionY(63)
    self.line:setPositionY(55)

    --标题
    self.title_desc = createRichLabel(28, cc.c4b(0x64,0x32,0x23,0xff), cc.p(0,0.5), cc.p(20,130), -15, nil, 500)
    main_container:addChild(self.title_desc)
    --小标题
    self.little_desc = createRichLabel(22, cc.c4b(0x95,0x53,0x22,0xff), cc.p(0,0.5), cc.p(160,58), -5, nil, 280)
    main_container:addChild(self.little_desc)

    self.time_desc = createRichLabel(22, cc.c4b(0x93,0x53,0x22,0xff), cc.p(0.5,0.5), cc.p(594,130), nil, nil, 400)
    main_container:addChild(self.time_desc)

    local size = self.goods_con:getContentSize()
    self.item_scrollview = createScrollView(size.width, size.height+1, 0, 0, self.goods_con, ScrollViewDir.horizontal) 
end

function ArenaOrderRankItemItem:register_event( )
    registerButtonEventListener(self.btn_get, function()
        if not self.data then return end
        arena_controller:sender14535(self.data.config.id)
    end,true, 1)

    registerButtonEventListener(self.btn_goto, function() self:onGotoBtn() end,true, 1)
end

function ArenaOrderRankItemItem:onGotoBtn()
    if not self.data then return end
    if not self.data.config then return end
    local config = Config.SourceData.data_source_data[self.data.config.source_id]
    if config then
        BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
    else
        StrongerController:getInstance():clickCallBack(self.data.config.source_id)
    end
end

function ArenaOrderRankItemItem:gotoActionByID(jump_id)
    local tab_vo = _controller:getActionSubTabVo(jump_id)
    if tab_vo and _controller.action_operate and _controller.action_operate.tab_list[tab_vo.bid] then
        _controller.action_operate:handleSelectedTab(_controller.action_operate.tab_list[tab_vo.bid])
    else
        message(TI18N("语言_c_1472"))
    end
end
function ArenaOrderRankItemItem:setActionRankCommonType(holiday_bid, type)
    self.holiday_bid = holiday_bid
    self.type = type
end

function ArenaOrderRankItemItem:setData( data )
    self.data = data
    self.btn_goto:setVisible(data.status == TaskConst.task_status.un_finish)
    self.btn_get:setVisible(data.status == TaskConst.task_status.finish)
    addRedPointToNodeByStatus(self.btn_get, data.status == TaskConst.task_status.finish,10,10)
    self.btn_has:setVisible(data.status == TaskConst.task_status.completed)
    if self.time_desc then
        self.time_desc:setVisible(data.status ~= TaskConst.task_status.completed)
    end
    if self.action_id == ActionLimitYuanZhenPanel.action_yuanzhen_id then
        self.title_desc:setString(data.desc)
        if data.status == TaskConst.task_status.finish then
            self.goal_desc:setString(string.format("<div fontColor=#249003>%s</div>", data.goal))
        else
            self.goal_desc:setString(data.goal)
        end

        local data_list = data.item_list
        local setting = {}
        setting.scale = 0.8
        setting.max_count = 4
        -- setting.is_center = true
        self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, data_list, setting)
        
    else
        self.title_desc:setString(data.title)
        local desc =data.desc..data.goal
        if data.status == TaskConst.task_status.finish then
            self.little_desc:setString(string.format("<div fontColor=#249003>%s</div>", desc))
        else
            self.little_desc:setString(desc)
        end

        local data_list = data.item_list
        local setting = {}
        setting.scale = 0.8
        setting.max_count = 2
        self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, data_list, setting)

        -- if self.item and data.item_list ~= nil and next(data.item_list) ~= nil then
        --     self.item:setBaseData(data.item_list[1][1], data.item_list[1][2], true)         
        -- end
    end
    return self.time_desc
end

function ArenaOrderRankItemItem:DeleteMe( )
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list = nil

    if self.item then
        self.item:DeleteMe()
        self.item = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

