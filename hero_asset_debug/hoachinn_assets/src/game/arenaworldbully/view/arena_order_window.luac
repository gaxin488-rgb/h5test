ArenaOrderWindow = ArenaOrderWindow or BaseClass(BaseView)

local controller = MonopolyController:getInstance()
local model = controller:getModel()
local _controller = ActionController:getInstance()
local arena_controller = ArenaworldbullyController:getInstance()
local arena_model = arena_controller:getModel()

function ArenaOrderWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full

    self.layout_name = "arenaworldbully/arena_order_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"),type = ResourcesType.plist}, 
        {path = PathTool.getPlistImgForDownLoad("oncewarorder", "oncewarorder"),type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("monopoly", "monopolyenter"),type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("monopoly","monopolyboard"),type = ResourcesType.plist }
    }
    self.reward_list = {}
end

function ArenaOrderWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.background:ignoreContentAdaptWithSize(true)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)
    self.order_panel=self.main_container:getChildByName("order_panel")
    self.icon_img = self.order_panel:getChildByName("icon_img")
    -- 解锁奖励总览
    self.btn_open_lock = self.order_panel:getChildByName("btn_open_lock")
    self.btn_open_lock_label = self.btn_open_lock:getChildByName("name")
    self.Image_15=self.main_container:getChildByName("Image_15")
    self.Text_33_0 = self.Image_15:getChildByName("Text_33_0")

    self.type_btn_panel = self.main_container:getChildByName("type_btn_panel")

    self.Image_1 =self.order_panel:getChildByName("Image_1")
    local medal_title=self.Image_1:getChildByName("medal_title")
    self.medal_num=self.Image_1:getChildByName("medal_num")
    medal_title:setString(TI18N("语言_c_5311"))
    setTextMaxWidth(medal_title,210)

    self.btn_rule = self.order_panel:getChildByName("btn_rule")
    self.btn_close = self.main_container:getChildByName("btn_close")
    
    local tips_bg = self.order_panel:getChildByName("Image_7")
    tips_bg:getChildByName("coin_label"):setString(TI18N("语言_hol_sta_pa_01_2"))
    self.Image_4=self.order_panel:getChildByName("Image_4")
    self.Text_33 =self.Image_4:getChildByName("Text_33")
    setTextMaxWidth(self.Text_33, 330)
    self.goods_item = self.order_panel:getChildByName("goods_item")
    self.time_bg = self.main_container:getChildByName("time_bg")
    self.time_txt = self.main_container:getChildByName("time_txt")
    self.task_panel=self.main_container:getChildByName("task_panel")
    self.icon_img_2 = self.task_panel:getChildByName("icon_img_2")
    self.task_con = self.task_panel:getChildByName("task_con")
    self.preview_panel=self.order_panel:getChildByName("preview_panel")
    self.preview_bg=self.preview_panel:getChildByName("preview_bg")
    self.name_bg=self.preview_panel:getChildByName("name_bg")
    self.name=self.preview_panel:getChildByName("name")
    self.attr_add=self.preview_panel:getChildByName("attr_add")
    self.attr_add:setString(TI18N("语言_c_6781"))
    self.reward_txt=self.preview_panel:getChildByName("reward_txt")
    self.reward_txt:setString(TI18N("语言_c_6782"))
    -- self.attr_bg=self.preview_panel:getChildByName("attr_bg")
    self.item_scroll=self.preview_panel:getChildByName("item_scroll")
    self.item_scroll:setScrollBarEnabled(false)
    self.privilege_panel=self.preview_panel:getChildByName("privilege_panel")
    self.preview_panel:setZOrder(15)
    self.task_panel:setVisible(true)
	self.order_panel:setVisible(false)
    self.preview_panel:setVisible(false)
    self.limit_list = {}
    --self.dic_limit_list[id] = self.limit_list[n] 用于刷新数据用
    self.dic_limit_list = {}

    self.time_desc_list = {}
    --根据任务id 保存的列表
    self.dic_task_list = {}
    self.preview_list = {}
    self:initOrderPanel()
    self:initTaskPanel()
    self:initTypeBtnList()
end

-- 初始化Tab按钮列表
function ArenaOrderWindow:initTypeBtnList()
    self.tab_array = {
        TI18N("语言_c_5333"),
        TI18N("语言_c_5334"),
        TI18N("语言_c_6766"),
    }
    self.tab_btn_list = {}
    for i=1,3 do
        local tab_btn = {}
        local item = self.type_btn_panel:getChildByName("tab_btn_"..i)
        tab_btn.btn = item
        tab_btn.index = i
        tab_btn.select_bg = item:getChildByName("select_img")
        tab_btn.select_bg:setVisible(false)
        tab_btn.title = item:getChildByName("label")
        tab_btn.title:getVirtualRenderer():setLineSpacing(-10)
        tab_btn.title:setTextColor(cc.c4b(247,238,117,255))
        tab_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
        tab_btn.title:setFontSize(25)
        tab_btn.title:setChangeScaleOffWidth(60)
        tab_btn.title:setString(self.tab_array[i])
        tab_btn.red_point = item:getChildByName("red_point")
        tab_btn.red_point:setVisible(false)
        self.tab_btn_list[tab_btn.index] = tab_btn
    end
    self.tab_btn_list[3].btn:setVisible(false)
    self.tab_btn_list[2].btn:setVisible(false)
    for index, tab_btn in ipairs(self.tab_btn_list) do
        registerButtonEventListener(tab_btn.btn, function() self:_onClickTabBtn(tab_btn.index) end ,false, 2) 
    end
end

-- 更新红点显示
function ArenaOrderWindow:updateTaskAwardRedStatus(  )
    if not self.tab_btn_list then return end
    for k,tab_btn in pairs(self.tab_btn_list) do
        local red_status
        if tab_btn.index == 1 then
            red_status = self:GetYuanZhengRed() 
        elseif tab_btn.index == 3 then
            red_status = false
        else
            red_status= self:GetOrderRed()
        end
        tab_btn.red_point:setVisible(red_status)
    end
end

function ArenaOrderWindow:GetYuanZhengRed()
    if self.limit_list then
        for i,v in ipairs(self.limit_list) do
            if v.status ==1 then 
                return true
            end
        end
    end
    return  false
end
function ArenaOrderWindow:GetOrderRed()
    local data = arena_model:getOrderData()
    if data then
        for key, value in pairs(data.quest_list or {}) do
            if arena_model:canReceiveMax(value.id,self.camp_id) and (value.reward == 1 or value.rmb_reward == 1) then
                return true
            end
        end
    end
    return false
end

-- 点击Tab按钮
function ArenaOrderWindow:_onClickTabBtn( index )
    if self.select_btn and self.select_btn.index == index then return end

    if self.select_btn then 
        self.select_btn.select_bg:setVisible(false)
        self.select_btn.title:setTextColor(cc.c4b(249,238,208,255))
        self.select_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
    end
    self.select_btn = self.tab_btn_list[index]
    if self.select_btn then 
        self.select_btn.select_bg:setVisible(true)
        self.select_btn.title:setTextColor(cc.c4b(248,239,118,255))
        self.select_btn.title:enableOutline(cc.c4b(92,39,5,255), 2)
        self:updateSubTabBtn(index)
    end
end

function ArenaOrderWindow:updateSubTabBtn( index )
    self.task_panel:setVisible(index ==1)
	self.order_panel:setVisible(index ==2 or index ==3)
    self.preview_panel:setVisible(index ==3)
    local cfg = Config.MonopolyOrderData.data_constant[self.camp_id]
    if not cfg then return end
    local source=""
    local less_time=0
    if index==1 then
        source=cfg.task_bg2
        self.Text_33_0:setString(cfg.task_title)
        local tab_vo = _controller:getActionSubTabVo(self.holiday_bid)
        if tab_vo then
           less_time= tab_vo.remain_sec
        else
           less_time=0
        end
    else
        local data= arena_model:getOrderData()
        if data then
            local end_time= data.end_time
            source=cfg.task_bg
            self.Text_33_0:setString(cfg.name)
            local cur_time = GameNet:getInstance():getTime()
            less_time = end_time - cur_time
        end
    end
    local res_id = PathTool.getPlistImgForDownLoad("monopoly",source)
    self.item_load = createResourcesLoad(res_id, ResourcesType.single, function()
        if self.background and not tolua.isnull(self.background) then
            self.background:loadTexture(res_id, LOADTEXT_TYPE)
        end
    end, self.item_load)
    --local res= PathTool.getPlistImgForDownLoad("monopoly", source)--

    self:setLessTime(less_time)
end

function  ArenaOrderWindow:initOrderPanel()
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔 k, 
        item_width = 720, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true,
        checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,
        ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    ---进度条相关
    local scroll_view_size2 = cc.size(100, scroll_view_size.height)
    local setting = {
        start_x = 8, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 100, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.reward_num_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
    self.reward_num_item:setClickEnabled(false)
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
end

function ArenaOrderWindow:initTaskPanel()
    if self.item_scrollview == nil then
        local scroll_view_size = self.task_con:getContentSize()
        local setting = {
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 0,                     -- y方向的间隔
            item_width = 688,                -- 单元的尺寸width
            item_height = 152,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 1,                    -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(self.task_con, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.CreateNewCell3), ScrollViewFuncType.CreateNewCell) --创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.NumberOfCells3), ScrollViewFuncType.NumberOfCells) --获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.UpdateyIndexCell), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
end

--奖励列表
function ArenaOrderWindow:CreateNewCell3()
    local cell = ArenaOrderRankItemItem.new(self.action_id)
    cell:setActionRankCommonType(self.holiday_bid,15)
    return cell
end

function ArenaOrderWindow:NumberOfCells3()
    if not self.limit_list then return 0 end
    return #self.limit_list
end

function ArenaOrderWindow:UpdateyIndexCell(cell, index)
    cell.index = index
    local cell_data = self.limit_list[index]
    if not cell_data then return end
    local time_desc = cell:setData(cell_data)
    self.time_desc_list[index] = time_desc
    self:updateTimeByIndex(index, time_desc)
end

function ArenaOrderWindow:updateTimeByIndex(index, time_desc)
    -- body 
    local cell_data = self.limit_list[index]
    if cell_data then
        if time_desc then
            local time = cell_data.end_time - GameNet:getInstance():getTime()
            if time < 0 then
                time = 0
            end
            time_desc:setString(string.format("%s%s", TI18N("语言_c_131"), TimeTool.getDayOrHour(time)))
        end
    end
end

function ArenaOrderWindow:setData()
    if self.is_open_buy and self.is_first then
        self.is_first = false
        arena_controller:openArenaOrderBuyCardWindow(true,self.camp_id)
    end
    local cfg = Config.MonopolyOrderData.data_constant[self.camp_id]
    self.btn_open_lock_label:setString(TI18N("语言_c_2680"))
    local desc_str = ""
    if cfg and cfg.desc then
        desc_str = cfg.desc
    end
    self.Text_33:setString(desc_str)  
    self.Image_15:setVisible(true)
    self.time_txt:setVisible(true)
    self.time_bg:setVisible(true)
    self:initAwardConfig()
    self:adaptationScreen()
    self:updateIconImg() -- 背景
    self:updateTaskAwardRedStatus()
    if cfg.recharge_id2 ~= 0 then
        self.tab_btn_list[3].btn:setVisible(true)
        self:updatePreviewPanel()
    else
        self.tab_btn_list[3].btn:setVisible(false)
    end
end

function  ArenaOrderWindow:setPreviewPanel()
    local cfg = Config.MonopolyOrderData.data_constant[self.camp_id]

end

-- 奖励列表
function ArenaOrderWindow:createTaskCell()
    local cell = ArenaOrderRewardItem.new()
    return cell
end

function ArenaOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ArenaOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,self.camp_id,self.holiday_bid,index)
end

