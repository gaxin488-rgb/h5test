-- 设置适配屏幕
function ArenaOrderWindow:adaptationScreen()
end

function ArenaOrderWindow:register_event()
    if not self.get_monopoly_war_order_data then
        self.get_monopoly_war_order_data = GlobalEvent:getInstance():Bind(MonopolyEvent.Get_Monopoly_War_Order_Data, function (data)
           -- print("MonopolyEvent.Get_Monopoly_War_Order_Data",vardump(data))
            arena_model:setOrderData(data)
            self.tab_btn_list[2].btn:setVisible(true)
            self:setData()
        end)
    end
    registerButtonEventListener(self.btn_open_lock, function()
        local config = Config.MonopolyOrderData.data_constant[self.camp_id]
        if config.recharge_id2 == 0 then
            arena_controller:openArenaOrderBuyCardWindow(true,self.camp_id)
        else
            arena_controller:openArenaOrderBuyCardWindow2(true,self.camp_id)
        end
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        arena_controller:openArenaOrderWindow(false)
    end, true, 2)

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = Config.MonopolyOrderData.data_constant[self.camp_id]
        if config then
            local config_desc = config.dis
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
    if not self.order_data_event  then
        self.order_data_event = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.OrderData,function (data)
            if not data then return end
            local sort_func = SortTools.tableLowerSorter({"id"})
            table.sort(data.quest_list, sort_func)
            self.action_id = data.camp_id
            self:initYuanZhenData(data.quest_list, true)
            self:updateTaskAwardRedStatus()
            self:_onClickTabBtn(self.curindex)
        end)
    end
    if not self.update_order_data_event  then
        self.update_order_data_event = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateOrderData,function (data)
            if not data then return end
            self:initYuanZhenData({data})
        end)
    end
    if not self.update_order_task_event  then
        self.update_order_task_event = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.OrderTaskEvent,function (data)
            if not data then return end
            if not self.action_id then return end
            --后端要求我模拟完成条件
            local key = getNorKey(self.action_id, data.id)
            local config = Config.HolidayLantermAdventureData.data_lanterm_adventure_fun(key)
            if config and self.dic_limit_list[config.f_id] then
                self.dic_limit_list[config.f_id].status = TaskConst.task_status.completed
                self.dic_limit_list[config.f_id].sort = TaskConst.task_status.completed

                local config_list = Config.HolidayLantermAdventureData.data_lanterm_adventure_task_list[self.action_id][config.f_id]
                --如果有下一个任务档次
                if config_list[config.s_id + 1] then
                    local key = getNorKey(self.action_id, config_list[config.s_id + 1].id)
                    local new_config = Config.HolidayLantermAdventureData.data_lanterm_adventure_fun(key)
                    if new_config and self.dic_task_list[new_config.id] then
                        self:initYuanZhenData({self.dic_task_list[new_config.id]})
                    else   
                        self:sortYuanZhenInfo()
                    end
                else
                    self:sortYuanZhenInfo()
                end
            end
            self:updateTaskAwardRedStatus()
        end)
    end
end

--元宵冒险数据
--@is_reset 是否重置
function ArenaOrderWindow:initYuanZhenData(quest_list)
    if not self.action_id then return end
    if not quest_list then return end
    for i,v in ipairs(quest_list) do
        self.dic_task_list[v.id] = v
        local key = getNorKey(self.action_id, v.id)
        if not Config.HolidayLantermAdventureData then
            require("config.holiday_lanterm_adventure_data")
        end
        local config = Config.HolidayLantermAdventureData.data_lanterm_adventure_fun(key)
        if config and v.finish ~= TaskConst.task_status.over then
            local task = self.dic_limit_list[config.f_id] --父类id
            if task == nil then
                task = {}
                self.dic_limit_list[config.f_id] = task
                table.insert(self.limit_list, task)
            end
            local is_chang = true
            if task.config then
                if config.s_id > task.config.s_id then
                    --当前 序号比记录大 那么如果记录 未领取奖励 不能替换 
                    if task.status ~= TaskConst.task_status.completed then
                        is_chang = false
                    end
                elseif config.s_id < task.config.s_id then
                    --当前 序号比记录小  如果 当前已领取奖励 不能替换
                    if v.finish == TaskConst.task_status.completed  then
                        is_chang = false
                    end 
                end
            end
            if is_chang then
                -- task.id = config.id
                task.config = config
                task.f_id = config.f_id
                if v.finish == TaskConst.task_status.finish then
                    task.sort = 0
                elseif v.finish == TaskConst.task_status.un_finish then
                    task.sort = 1
                else
                    task.sort = v.finish
                end
                
                task.status = v.finish --总状态 (0:未完成 1:已完成 2:已奖励, 3:已过期)"}
                task.title = config.title
                task.desc = config.desc
                --目标值当前值(x/n)
                local target_val 
                local value
                if v.progress[1] then
                    target_val = v.progress[1].target_val
                    value = v.progress[1].value
                end
                task.goal = string.format("(%s/%s)",value, target_val)
                task.end_time = v.end_time 
                task.item_list = config.award
            end
        end 
    end
    self:sortYuanZhenInfo()
end

--元宵冒险排序
function ArenaOrderWindow:sortYuanZhenInfo()
    local sort_func = SortTools.tableLowerSorter({"sort","f_id"})
    table.sort(self.limit_list, sort_func)
    self.item_scrollview:reloadData()
end

-- 滑动的时候处理显示
function ArenaOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end

function ArenaOrderWindow:updateIconImg()
    if tolua.isnull(self.icon_img) or tolua.isnull(self.icon_img_2) or tolua.isnull(self.btn_open_lock) then
        return
    end
    local cfg = Config.MonopolyOrderData.data_constant[self.camp_id]
    loadSpriteTexture(self.icon_img, PathTool.getResFrame("monopolyenter", cfg.icon), LOADTEXT_TYPE_PLIST)
    loadSpriteTexture(self.icon_img_2, PathTool.getResFrame("monopolyenter", cfg.icon), LOADTEXT_TYPE_PLIST)
    if cfg.recharge_id2 ~= 0 then
        local status = arena_model:getOrderStatusNum()
        
        if status >= 1 then
            setChildUnEnabled(false, self.icon_img)
            setChildUnEnabled(false, self.icon_img_2)
        else
            setChildUnEnabled(true, self.icon_img)
            setChildUnEnabled(true, self.icon_img_2)
        end
        if status >= 2 then
            self.btn_open_lock:setVisible(false)
        else
            self.btn_open_lock:setVisible(true)
        end
    else
        local status = arena_model:getOrderStatus()
    
        if status then
            setChildUnEnabled(false, self.icon_img)
            setChildUnEnabled(false, self.icon_img_2)
        else
            setChildUnEnabled(true, self.icon_img)
            setChildUnEnabled(true, self.icon_img_2)
        end
        if status then
            self.btn_open_lock:setVisible(false)
        else
            self.btn_open_lock:setVisible(true)
        end
    end
end

function ArenaOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
end
--设置倒计时
function ArenaOrderWindow:setLessTime(less_time)
    if tolua.isnull(self.time_txt) then
        return
    end
    local less_time = less_time or 0
    self.time_txt:stopAllActions()
    if less_time > 0 then
        self:setTimeFormatString(less_time)
        self.time_txt:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1),
            cc.CallFunc:create(function()
                less_time = less_time - 1
                if less_time < 0 then
                    self.time_txt:stopAllActions()
                    arena_controller:openArenaOrderWindow(false)
					Actionyearmonster2Controller:getInstance():openActionyearmonster2MainWindow(false)
                else
                    self:setTimeFormatString(less_time)
                end
            end))))
    else
        self:setTimeFormatString(less_time)
    end
end

function ArenaOrderWindow:setTimeFormatString( time )
    if time > 0 then
        local str = string.format(TI18N("语言_c_2397"),TimeTool.GetTimeFormatDay(time))
        self.time_txt:setString(str)
    else
        self.time_txt:setString(TI18N("语言_c_233"))
    end
    self.time_bg:setContentSize(cc.size(math.max(self.time_txt:getContentSize().width + 20,self.time_bg:getContentSize().width),self.time_bg:getContentSize().height))
end

function ArenaOrderWindow:setChangeLevelStatus()
    local title_pos = 1
    local data = arena_model:getOrderData()
    for key, value in pairs(data.quest_list) do
        if data.is_charge >= 1 then --已购买
            if value.reward == 1 or value.rmb_reward == 1 or value.reward == 0 or value.rmb_reward == 0 then
                title_pos = key
                break
            end
        else --未购买
            if value.reward == 1 or value.reward == 0 then
                title_pos = key
                break
            end
        end
    end
    self:jumpToMoveByY(139 * (title_pos - 1))
end

-- 红点
function ArenaOrderWindow:setTabRedPoint()
end

function ArenaOrderWindow:initAwardConfig()
    self.reward_list = {}
    local temp_reward_list = Config.MonopolyOrderData.data_quest_list[self.camp_id]
    for k, v in pairs(temp_reward_list) do
        table.insert(self.reward_list, v)
    end
    self.Image_4:setVisible(false)
    local y=951
    self.time_bg:setPositionY(y)
    self.time_txt:setPositionY(y)
    table.sort(self.reward_list, SortTools.KeyLowerSorter("goal_id"))
    self.reward_goods_item:reloadData()
    self.reward_num_item:reloadData()

    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
    self:setChangeLevelStatus()
    local Receive = arena_model:getCurOrderReceive()
    if arena_model:getReceiveFinishNext() then
        local nextCfg= temp_reward_list[arena_model:getReceiveFinishNext()]
        local num1= Receive and Receive.value or 0
        local num2=nextCfg and nextCfg.progress[1].target_val or 0
        local str = num1.."/"..num2
        self.medal_num:setString(str)
    end
end

--is_open_buy 是否自动打开购买界面
function ArenaOrderWindow:openRootWnd(index,is_open_buy)
    self.is_open_buy = is_open_buy or false
    self.is_first = true
    self.holiday_bid = ActionRankCommonType.ArenaworldbullyOrder
    self.holiday_vo = _controller:getActionSubTabVo(self.holiday_bid)
    --print("self.holiday_vo",vardump(self.holiday_vo))
    if not self.holiday_vo then return end
    self.camp_id = self.holiday_vo.camp_id
    local cfg = Config.MonopolyOrderData.data_constant[self.camp_id]
    local source=cfg.task_bg2
    local res_id = PathTool.getPlistImgForDownLoad("monopoly",source)
    self.item_load = createResourcesLoad(res_id, ResourcesType.single, function()
        if self.background and not tolua.isnull(self.background) then
            self.background:loadTexture(res_id, LOADTEXT_TYPE)
        end
    end, self.item_load)
    --print("sender27507",vardump(self.holiday_bid))
    controller:sender27507(self.holiday_bid)
    arena_controller:sender14533()  --24815
    self.curindex=index or 1
end

function ArenaOrderWindow:updatePreviewPanel()
    local cfg = Config.MonopolyOrderData.data_shows[self.camp_id]
    loadSpriteTexture(self.preview_bg, PathTool.getPlistImgForDownLoad("get_ninja", cfg.show), LOADTEXT_TYPE)
    local training_cfg = Config.TrainingCampData.data_get_sec[cfg.sci_id]
    self.name:setString(TI18N("语言_c_6765"))
    local setting = {}
    setting.scale = 0.7
    setting.max_count = 2
    setting.is_center = false
    self.item_list = commonShowSingleRowItemList(self.item_scroll, self.item_list, cfg.items1, setting)
    for k, v in pairs(self.preview_list) do
        v:removeFromParent()
        v = nil
    end
    self.preview_list = {}
    if not next(training_cfg.attr) then
        -- self.attr_bg:setVisible(false)
    else
        -- self.attr_bg:setVisible(true)
        for i=1,tableLen(training_cfg.attr) do
            local attr = training_cfg.attr[i]
            local label = self.preview_list[i]
            if not label then
                label = createRichLabel(20, cc.c4b(0x08,0xe9,0x08,0xff), cc.p(0,1), cc.p(0,0))
                self.name_bg:addChild(label)
                self.preview_list[i] = label
            end
            local name = Config.AttrData.data_key_to_name[attr[1]]
            local is_per = PartnerCalculate.isShowPerByStr(attr[1])
            if is_per then
                label:setString(string.format("<div fontcolor=#08e908 outline=2,#000000>%s: %s%%</div>", name, attr[2]/10))
            else
                label:setString(string.format("%s: %s", name, attr[2]))
            end
            label:setVisible(true)
        end
        for i=1, tableLen(self.preview_list), 2 do
            if self.preview_list[i+1] then
                local _w = self.preview_list[i]:getContentSize().width + self.preview_list[i+1]:getContentSize().width + 10
                self.preview_list[i]:setPositionX(130 - _w*0.5)
                self.preview_list[i+1]:setPositionX(self.preview_list[i]:getPositionX() + self.preview_list[i]:getContentSize().width + 10)
            else
                if i == 1 then
                    self.preview_list[i]:setPositionX(130-self.preview_list[i]:getContentSize().width*0.5)
                else
                    self.preview_list[i]:setPositionX(self.preview_list[i-2]:getPositionX())
                end
            end
            local _y = 180 - math.floor((i-1)/2)*30
            self.preview_list[i]:setPositionY(_y)
            self.preview_list[i+1]:setPositionY(_y)
        end
    end
    if self.privilege_scroll == nil then
        local scroll_view_size = self.privilege_panel:getContentSize()
        local setting = {
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 0,                     -- y方向的间隔
            item_width = 688,                -- 单元的尺寸width
            item_height = 140,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 1,                    -- 每次创建的数量
        }
        self.privilege_scroll = CommonScrollViewSingleLayout.new(self.privilege_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.privilege_scroll:registerScriptHandlerSingle(handler(self,self.CreateNewCell4), ScrollViewFuncType.CreateNewCell) --创建cell
        self.privilege_scroll:registerScriptHandlerSingle(handler(self,self.NumberOfCells4), ScrollViewFuncType.NumberOfCells) --获取数量
        self.privilege_scroll:registerScriptHandlerSingle(handler(self,self.UpdateyIndexCell4), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    self.privilege_list = cfg.items2[1]
    self.privilege_scroll:reloadData()
end

--奖励列表
function ArenaOrderWindow:CreateNewCell4()
    local cell = ArenaOrderPrivilegeItem.new()
    return cell
end

function ArenaOrderWindow:NumberOfCells4()
    if not self.privilege_list then return 0 end
    return #self.privilege_list
end

function ArenaOrderWindow:UpdateyIndexCell4(cell, index)
    cell.index = index
    local cell_data = self.privilege_list[index]
    if not cell_data then return end
    local time_desc = cell:setData(cell_data,arena_model:getOrderStatusNum(),index)
end

function ArenaOrderWindow:close_callback()
    self.time_txt:stopAllActions()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.privilege_scroll then
        self.privilege_scroll:DeleteMe()
        self.privilege_scroll = nil
    end
    if self.get_monopoly_war_order_data then
        GlobalEvent:getInstance():UnBind(self.get_monopoly_war_order_data)
        self.get_monopoly_war_order_data = nil
    end
    if self.order_data_event then
        GlobalEvent:getInstance():UnBind(self.order_data_event)
        self.order_data_event = nil
    end
    if self.update_order_task_event then
        GlobalEvent:getInstance():UnBind(self.update_order_task_event)
        self.update_order_task_event = nil
    end
    if self.update_order_data_event then
        GlobalEvent:getInstance():UnBind(self.update_order_data_event)
        self.update_order_data_event = nil
    end
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
    end
    self.item_scrollview = nil
    
	if self.item_list then
        for i,v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    for k, v in pairs(self.preview_list) do
        v:removeFromParent()
        v = nil
    end
    arena_controller:openArenaOrderWindow(false)
end

