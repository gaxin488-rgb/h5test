OverlordOutsWindow = OverlordOutsWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function OverlordOutsWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/overlord_outs_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function OverlordOutsWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.imgTitleBg = self.main_container:getChildByName("image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_6644"))
	autoSizeTitleBg(self.win_title,self.imgTitleBg,60,330)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.my_log_panel = self.main_container:getChildByName("my_log_panel")
	self.no_log_label = self.main_container:getChildByName("no_log_label")
	self.no_log_label:setString(TI18N("语言_c_5410"))
	self.no_log_image = self.main_container:getChildByName("no_log_image")
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.rank_title = self.title_bg:getChildByName("rank_title")
	self.rank_title:setChangeScaleOffWidth(520)
	self.rank_title:setString(TI18N("语言_c_255"))
	self.player_title = self.title_bg:getChildByName("player_title")
	self.player_title:setChangeScaleOffWidth(377)
	self.player_title:setString(TI18N("语言_c_1434"))
	self.win_title = self.title_bg:getChildByName("win_title")
	self.win_title:setChangeScaleOffWidth(510)
	self.win_title:setString(TI18N("语言_c_6645"))
	self.lose_title = self.title_bg:getChildByName("lose_title")
	self.lose_title:setChangeScaleOffWidth(520)
	self.lose_title:setString(TI18N("语言_c_6646"))
	self.details_title = self.title_bg:getChildByName("details_title")
	self.details_title:setChangeScaleOffWidth(520)
	self.details_title:setString(TI18N("语言_c_6647"))
end

function OverlordOutsWindow:openRootWnd()
	controller:sender14525(0)
end
function OverlordOutsWindow:setData(data)
	self.data = data
	if self.group_view == nil then
        local scroll_view_size = self.my_log_panel:getContentSize()
        local setting = {
            item_class = OverlordOutsItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 600,               -- 单元的尺寸width
            item_height = 120,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.my_log_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	local list = {}
	local cfg = Config.ArenaTimeWarpData.data_group
	for i,v in ipairs(data.group_rank_list) do
		if cfg[v.group].zone == model:getLookZone() then
			list = v
		end
	end
	self.group_view:setData(list.rank_list)
	if list.rank_list and next(list.rank_list) then
		self.no_log_label:setVisible(false)
		self.no_log_image:setVisible(false)
	else
		self.no_log_label:setVisible(true)
		self.no_log_image:setVisible(true)
	end
end
function OverlordOutsWindow:_onClickBtnClose()
	controller:openOverlordOutsWindow(false)
end
function OverlordOutsWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	if self.update_over_rank_list == nil then
        self.update_over_rank_list = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdateOverRankList, function(data)
			if not data then return end
            self:setData(data)
        end)
    end
end

function OverlordOutsWindow:close_callback(  )
    if self.update_over_rank_list ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_over_rank_list)
        self.update_over_rank_list = nil
    end
	self:_onClickBtnClose()
end

--子项
OverlordOutsItem = class("OverlordOutsItem", function()
    return ccui.Widget:create()
end)

function OverlordOutsItem:ctor()
    self:configUI()
    self:register_event()
end

function OverlordOutsItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/overlord_outs_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(600,120))
	self:setTouchEnabled(true)
	self.container = self.root_wnd:getChildByName("container")
	self.rank_icon = self.container:getChildByName("rank_icon")
    self.rank_txt = self.container:getChildByName("rank_txt")
	self.head_node = self.container:getChildByName("head_node")
	self.name = self.container:getChildByName("name")
	self.power_icon = self.container:getChildByName("power_icon")
	self.power_txt = self.container:getChildByName("power_txt")
	self.win_txt = self.container:getChildByName("win_txt")
	self.lose_txt = self.container:getChildByName("lose_txt")
	self.btn_details = self.container:getChildByName("btn_details")
	self.details_txt = self.container:getChildByName("details_txt")
	self.details_txt:setString(TI18N("语言_c_6647"))
end

function OverlordOutsItem:register_event( )
	registerButtonEventListener(self.btn_details, handler(self, self._onClickBtnDetails), true, 2)
end

function OverlordOutsItem:_onClickBtnDetails()
	controller:openOverlordRaceScheduleWindow(true,self.data)
end

function OverlordOutsItem:setData(data)
	-- print("data",vardump(data))
	self.data = data
	if data.rank_champion <= 3 then
		self.rank_icon:setVisible(true)
		self.rank_txt:setVisible(false)
		loadSpriteTexture(self.rank_icon,PathTool.getResFrame("common","common_200"..data.rank_champion),LOADTEXT_TYPE_PLIST)
	else
		self.rank_icon:setVisible(false)
		self.rank_txt:setVisible(true)
		self.rank_txt:setString(data.rank_champion)
	end
	if not self.head_item then
		self.head_item = PlayerHead.new(PlayerHead.type.circle)
		self.head_node:addChild(self.head_item)
        self.head_item:setPosition(0, 0)
        self.head_item:setScale(0.8)
	end
	self.head_item:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
	--头像框
    local vo = Config.AvatarData.data_avatar[data.avatar_bid or 0]
    if vo then
        local res_id = vo.res_id or 1 
        local res = PathTool.getTargetRes("headcircle","txt_cn_headcircle_"..res_id,false,false)
        self.head_item:showBg(res,nil,false,vo.offy)
    end
    self.head_item:setLev(data.lev)
    self.head_item:showWarldBullyRegion(data.nation,0.8,cc.p(54,1))
	self.name:setString(transformNameByServ(data.name,data.srv_id))
	self.power_txt:setString(MoneyTool.moneyFormat(data.power))
	self.win_txt:setString(string.format(TI18N("语言_c_6648"),data.win_num))
	self.lose_txt:setString(string.format(TI18N("语言_c_6648"),data.lose_num))
end

function OverlordOutsItem:DeleteMe()

end