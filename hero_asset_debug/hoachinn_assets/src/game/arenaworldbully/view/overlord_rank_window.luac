-- --------------------------------------------------------------------
-- 
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      争霸赛排行榜主界面
-- <br/>Create: 2020-03-19
-- --------------------------------------------------------------------
OverlordRankWindow = OverlordRankWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()
local string_format = string.format


function OverlordRankWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.res_list = {
        
    }
    self.layout_name = "arenaworldbully/overlord_rank_window"

    self.view_list = {}
end

function OverlordRankWindow:open_callback(  )
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)

    
    local main_panel = self.main_container:getChildByName("main_panel")
    self.container = main_panel:getChildByName("container")
    self.Image_2 = main_panel:getChildByName("Image_2")
    self.title = main_panel:getChildByName("win_title")
    self.time_lab = main_panel:getChildByName("time_lab")
    self.time_lab:setChangeScaleOffWidth(-10000)
    local txt = TI18N("语言_c_6656")
    self.time_lab:setString(transformTextToShort(txt,60))
    setTextMaxWidth(self.time_lab,600,-10)
    addEvt2showAllTextTips(self.time_lab,txt,60)

    self.close_btn = main_panel:getChildByName("close_btn")

    self.tab_container = self.main_container:getChildByName("tab_container")
    local tab_name_list = {
        [1] = TI18N("语言_c_271"),
        [2] = TI18N("语言_c_264"),
    }
    self.tab_item_type = {
        [1] = ArenaworldbullyConst.overlord_rank_tab.rank,
        [2] = ArenaworldbullyConst.overlord_rank_tab.reward,
    }
    self.tab_list = {}
    for i=1,2 do
        local tab_btn = self.tab_container:getChildByName("tab_btn_"..i)
        if tab_btn then
            local object = {}
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(false)
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
            object.title = tab_btn:getChildByName("title")
            object.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
            if tab_name_list[i] then
                object.title:setString(tab_name_list[i])
            end
            setTextSpacing(object.title,-10)
            object.tab_btn = tab_btn
            object.index = self.tab_item_type[i] or ArenaworldbullyConst.overlord_rank_tab.rank
            self.tab_list[i] = object
        end
    end
end

function OverlordRankWindow:register_event(  )
    registerButtonEventListener(self.background, function() self:onClosedBtn() end,false, 2)
    registerButtonEventListener(self.close_btn, function() self:onClosedBtn() end ,true, 2)
    for k, object in pairs(self.tab_list) do
        if object.tab_btn then
            object.tab_btn:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playTabButtonSound()
                    self:changeSelectedTab(object.index)
                end
            end)
        end
    end

end

--关闭
function OverlordRankWindow:onClosedBtn()
    controller:openOverlordRankWindow(false)
end

-- 切换标签页
function OverlordRankWindow:changeSelectedTab( index )
    if self.tab_object and self.tab_object.index == index then return end

    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        self.tab_object.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
        self.tab_object = nil
    end
    self.cur_tab_index = index
    self.tab_object = self.tab_list[index]

    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        self.tab_object.title:setTextColor(cc.c4b(0xff, 0xed, 0xd6, 0xff))
    end
    if self.pre_panel then
        if self.pre_panel.setVisibleStatus then
            self.pre_panel:setVisibleStatus(false)
        else
            self.pre_panel:setVisible(false)
        end
    end

    self.pre_panel = self:createSubPanel(self.cur_tab_index)
    if self.pre_panel ~= nil then
        if self.pre_panel.setVisibleStatus then
            self.pre_panel:setVisibleStatus(true)
        else
            self.pre_panel:setVisible(true)
        end
    end
    if index == ArenaworldbullyConst.overlord_rank_tab.rank then
        self.time_lab:setVisible(false)
    else
        self.time_lab:setVisible(true)
    end
end

function OverlordRankWindow:createSubPanel(index)
    if not self.view_list then return end

    local panel = self.view_list[index]
    if panel == nil then
        if index == ArenaworldbullyConst.overlord_rank_tab.rank then --排行榜
            panel = OverlordRankPanel.new(self.group_id) 
        elseif index == ArenaworldbullyConst.overlord_rank_tab.reward then --排行奖励
            panel = OverlordRankAwardsPanel.new(self.group_id)
        end
        
        self.container:addChild(panel)
        self.view_list[index] = panel
    end
    return panel
end

--setting.tab_type = ArenaManyPeopleConst.RankType
function OverlordRankWindow:openRootWnd(setting)
    if not self.tab_item_type then return end
    local setting = setting or {}
    local index = setting.index or ArenaworldbullyConst.overlord_rank_tab.rank
    self.group_id = setting.group_id or model:getOverGroupId(model:getLookZone())
    self.look_index = setting.look_index or 1
    self:changeSelectedTab(index)
    local cfg = Config.ArenaTimeWarpData.data_group[self.group_id]
    self.title:setString(string.format(TI18N("语言_c_6735"),cfg.name))
    autoSizeTitleBg(self.title,self.Image_2)
end


function OverlordRankWindow:close_callback()
    if self.view_list then
        for i,v in pairs(self.view_list) do 
            if v and v["DeleteMe"] then
                v:DeleteMe()
            end
        end
    end
    self.view_list = nil
    controller:openOverlordRankWindow(false)
end
