PreselectionStrongholdRewardWindow = PreselectionStrongholdRewardWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function PreselectionStrongholdRewardWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/preselection_stronghold_reward_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function PreselectionStrongholdRewardWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.imgTitleBg = self.main_container:getChildByName("image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_6669"))
	autoSizeTitleBg(self.win_title,self.imgTitleBg)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.my_log_panel = self.main_container:getChildByName("my_log_panel")
	self.tips = self.main_container:getChildByName("tips")
	self.tips:setString(TI18N("语言_c_6698"))
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.enemy_title = self.title_bg:getChildByName("enemy_title")
	setTextMaxWidth(self.enemy_title,180,-10)
	self.enemy_title:setString(TI18N("语言_c_6699"))
	self.more_title = self.title_bg:getChildByName("more_title")
	self.more_title:setString(TI18N("语言_c_11"))
end

function PreselectionStrongholdRewardWindow:openRootWnd(data)
	self.id = data.id
	self.data = data
	self:setData()
end
function PreselectionStrongholdRewardWindow:setData()
	if self.group_view == nil then
        local scroll_view_size = self.my_log_panel:getContentSize()
        local setting = {
            item_class = PreselectionStrongholdRewardItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 564,               -- 单元的尺寸width
            item_height = 140,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.my_log_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	table.sort(self.data.period_reward,function(a,b) return a[1] > b[1] end)
	self.group_view:setData(self.data.period_reward)
	self.group_view:addEndCallBack(function (  )
		for k, v in pairs(self.group_view:getItemList()) do
			v:setId(self.id)
		end
    end)
end
function PreselectionStrongholdRewardWindow:_onClickBtnClose()
	controller:openPreselectionStrongholdRewardWindow(false)
end
function PreselectionStrongholdRewardWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	
    if self.update_preselection_data == nil then
        self.update_preselection_data = GlobalEvent:getInstance():Bind(ArenaworldbullyEvent.UpdatePreselectionData, function()
			self:setData()
        end)
    end
end

function PreselectionStrongholdRewardWindow:close_callback(  )	
    if self.update_preselection_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_preselection_data)
        self.update_preselection_data = nil
    end
	self:_onClickBtnClose()
end

--子项
PreselectionStrongholdRewardItem = class("PreselectionStrongholdRewardItem", function()
    return ccui.Widget:create()
end)

function PreselectionStrongholdRewardItem:ctor()
    self:configUI()
    self:register_event()
end

function PreselectionStrongholdRewardItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_stronghold_reward_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(564,140))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("container")
    self.bg = self.main_container:getChildByName("bg")
	self.icon = self.main_container:getChildByName("icon")
	self.reward_panel = self.main_container:getChildByName("reward_panel")
    self.reward_panel:setScrollBarEnabled(false)
	self.my_group = self.main_container:getChildByName("my_group")
	self.txt = self.main_container:getChildByName("txt")
	self.txt:setString(TI18N("语言_c_1294"))
	self.my_group:setContentSize(cc.size(self.txt:getContentSize().width + 50,self.my_group:getContentSize().height))
	self.my_group:setVisible(false)
	self.txt:setVisible(false)
	self.receive_btn = self.main_container:getChildByName("receive_btn")
	self.receive_txt = self.receive_btn:getChildByName("label")
	self.receive_txt:setString(TI18N("语言_c_8"))
end

function PreselectionStrongholdRewardItem:register_event( )
	registerButtonEventListener(self.receive_btn, handler(self, self._onClickBtnReceive), true, 2)
end

function PreselectionStrongholdRewardItem:_onClickBtnReceive()
	controller:sender14518()
end
function PreselectionStrongholdRewardItem:setReceive()
	self.receive_btn:setTouchEnabled(false)
	if self.data and self.data[1] == model:getPreRoomId() and self.id and self.id == model:getPreGroupId() then
		self.my_group:setVisible(true)
		self.txt:setVisible(true)
		if model:getPrePeriodReward() == 0 then
			self.receive_txt:setString(TI18N("语言_c_8"))
			setChildUnEnabled(true,self.receive_btn)
			addRedPointToNodeByStatus(self.receive_btn,false,10,10)
		elseif model:getPrePeriodReward() == 1 then
			self.receive_txt:setString(TI18N("语言_c_8"))
			setChildUnEnabled(false,self.receive_btn)
			self.receive_btn:setTouchEnabled(true)
			addRedPointToNodeByStatus(self.receive_btn,true,10,10)
		elseif model:getPrePeriodReward() == 2 then
			self.receive_txt:setString(TI18N("语言_c_15"))
			setChildUnEnabled(true,self.receive_btn)
			addRedPointToNodeByStatus(self.receive_btn,false,10,10)
		end
	else
		setChildUnEnabled(true,self.receive_btn)
		self.my_group:setVisible(false)
		self.txt:setVisible(false)
		self.receive_txt:setString(TI18N("语言_c_8"))
	end
end
function PreselectionStrongholdRewardItem:setId(id)
	self.id = id
	self:setReceive()
end
--策划需求写死各个据点的缩放值
function PreselectionStrongholdRewardItem:setIconScale(index)
	local scale = 1
	if index == 1 then
		scale = 1
	elseif index == 2 then
		scale = 1.4
	elseif index == 3 then
		scale = 0.8
	elseif index == 4 then
		scale = 0.7
	elseif index == 5 then
		scale = 0.35
	end
	self.icon:setScale(scale)
end
function PreselectionStrongholdRewardItem:setData(data)
	self.data = deepCopy(data)
    local index = model:getSelfIsCross() and 2 or 1
	local room_cfg = Config.ArenaTimeWarpData.data_room_info[index][self.data[1]]
	if room_cfg then
		loadSpriteTexture(self.icon, PathTool.getResFrame("time_warp",room_cfg.icon,false,"qualifier"), LOADTEXT_TYPE_PLIST)
		self:setIconScale(self.data[1])
	end
	-- local list = {}
	-- for k, v in pairs(self.data) do
	-- 	if type(v) == "table" then
	-- 		table.insert(list,v)
	-- 	end
	-- end
	local setting = {}
    setting.scale = 0.7
    setting.space_x = 2
    setting.max_count = 3
    self.item_list1 = commonShowSingleRowItemList(self.reward_panel, self.item_list1, self.data[2], setting)
	self:setReceive()
end

function PreselectionStrongholdRewardItem:DeleteMe()

end