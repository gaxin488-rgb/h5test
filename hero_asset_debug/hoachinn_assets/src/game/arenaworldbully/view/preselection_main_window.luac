PreselectionMainWindow = class("PreselectionMainWindow",function()
    return ccui.Layout:create()
end)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()

function PreselectionMainWindow:ctor()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_main_window"))

    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    -- 初始化数据
    self:initElfinData()

    -- 资源加载
    local res_list = {}
    table.insert(res_list, {path = PathTool.getPlistImgForDownLoad("tips", "tips"), type = ResourcesType.plist})
    table.insert(res_list, {path = PathTool.getPlistImgForDownLoad("common", "common_1"), type = ResourcesType.plist})
    table.insert(res_list, {path = PathTool.getPlistImgForDownLoad("elitematch", "elitematch"), type = ResourcesType.plist})
    if self.init_res_load then
        self.init_res_load:DeleteMe()
        self.init_res_load = nil
    end
    self.stronghold_list = {}
    self.init_res_load = ResourcesLoad.New()
    self.init_res_load:addAllList(res_list, function()
        if not tolua.isnull(self.root_wnd) then
            self:loadResListCompleted()
        end
    end)
end

function PreselectionMainWindow:loadResListCompleted( )
	self:initView()
    self:registerEvent()
    self:updateRewardRed()
    self:updateBattleRed()
    self:updateOrderRed()
    controller:sender14503()
    self:setBackpack()
    self:updatePage()
    self:updateStronghold()
    self.btn_order:setVisible(model:getOrderIsOpen())
end


-- 初始化数据
function PreselectionMainWindow:initElfinData(  )
    self.is_cross = false
    self.const_cfg = Config.ArenaTimeWarpData.data_const
	self.period_date = Config.ArenaTimeWarpData.data_period_date[model:getPeriod()]
    self.group_date = Config.ArenaTimeWarpData.data_group[model:getPreGroupId()]
    self.nation_cfg = Config.ArenaTimeWarpData.data_nation[model:getnation()]
    self.room_list = {}
end

-- 初始化界面
function PreselectionMainWindow:initView(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end
    self.background_2 = self.root_wnd:getChildByName("background_2")
    self.main_container = self.root_wnd:getChildByName("main_container")
