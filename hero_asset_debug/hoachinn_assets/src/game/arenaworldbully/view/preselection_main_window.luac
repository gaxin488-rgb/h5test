-- 
-- 
-- @Date    : 2019-08-13 15:36:39
-- @description    : 
		-- 据点
---------------------------------
--子项
ArenaworldbullySignupItem = class("ArenaworldbullySignupItem", function()
    return ccui.Widget:create()
end)

function ArenaworldbullySignupItem:ctor()
    self:configUI()
    self:register_event()
end

function ArenaworldbullySignupItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_main_item"))
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(200,200))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.stronghold_img = self.main_container:getChildByName("stronghold_img")
    self.score_img = self.main_container:getChildByName("score_img")
	self.score_txt = self.main_container:getChildByName("score_txt")
    self.num_img = self.main_container:getChildByName("num_img")
	self.num_txt = self.main_container:getChildByName("num_txt")
    self.my_head = self.main_container:getChildByName("my_head")
	self.lock_bg = self.main_container:getChildByName("lock_bg")
    self.lock = self.lock_bg:getChildByName("lock")
    self.lock_tip = self.lock_bg:getChildByName("lock_tip")
end

function ArenaworldbullySignupItem:register_event( )
    registerButtonEventListener(self.stronghold_img, function (  )
        controller:openPreselectionStrongholdInfoWindow(true,self.index)
    end, true)
end

function ArenaworldbullySignupItem:updatePos(i)
    if self.choose_spine then
        self.choose_spine:setVisible(false)
    end
    if i == 1 then
        self.lock_bg:setPosition(cc.p(100,56))
        self.my_head:setPosition(cc.p(109,163))
        self.num_txt:setPosition(cc.p(191,143))
        self.num_img:setPosition(cc.p(185,122))
        self.score_txt:setPosition(cc.p(23,101))
        self.score_img:setPosition(cc.p(27,94))
    elseif i == 2 then
        self.lock_bg:setPosition(cc.p(89,54))
        self.my_head:setPosition(cc.p(100,183))
        self.num_txt:setPosition(cc.p(185,137))
        self.num_img:setPosition(cc.p(178,118))
        self.score_txt:setPosition(cc.p(28,83))
        self.score_img:setPosition(cc.p(32,78))
    elseif i == 3 then
        self.lock_bg:setPosition(cc.p(91,37))
        self.my_head:setPosition(cc.p(89,166))
        self.num_txt:setPosition(cc.p(167,157))
        self.num_img:setPosition(cc.p(164,137))
        self.score_txt:setPosition(cc.p(19,101))
        self.score_img:setPosition(cc.p(21,94))
    elseif i == 4 then
        self.lock_bg:setPosition(cc.p(131,54))
        self.my_head:setPosition(cc.p(86,201))
        self.num_txt:setPosition(cc.p(167,157))
        self.num_img:setPosition(cc.p(164,137))
        self.score_txt:setPosition(cc.p(19,101))
        self.score_img:setPosition(cc.p(21,94))
    elseif i == 5 then
        self.lock_bg:setPosition(cc.p(153,-4))
        self.my_head:setPosition(cc.p(163,228))
        self.num_txt:setPosition(cc.p(284,171))
        self.num_img:setPosition(cc.p(281,150))
        self.score_txt:setPosition(cc.p(59,83))
        self.score_img:setPosition(cc.p(65,79))
        if not self.choose_spine then
            self.choose_spine = createEffectSpine("E24914",cc.p(291,185),cc.p(0,0),true,PlayerAction.action)
            self.stronghold_img:addChild(self.choose_spine)
        end
        self.choose_spine:setVisible(true)
    end
end

function ArenaworldbullySignupItem:setData(i)
    self.index = i
    self:updatePos(i)
    local index = model:getSelfIsCross() and 2 or 1
    self.cfg = Config.ArenaTimeWarpData.data_room_info[index][i]
    if not self.cfg then return end
    local data = model:getPreRoomDataForId(i)
    self.num_txt:setString(string.format(TI18N("语言_c_6688"),data.num or 0))
    self.score_txt:setString(string.format(TI18N("语言_c_2586"),self.cfg.unlock_score))
    if model:getPreRoomLockForId(i) then
        self.lock_bg:setVisible(false)
    else
        self.lock_bg:setVisible(true)
        local txt = ""
        if self.cfg.unlock_rank == 0 then
            txt = string.format(TI18N("语言_c_6689"),self.cfg.unlock_score)
        else
            txt = string.format(TI18N("语言_c_6690"),self.cfg.unlock_score,self.cfg.unlock_rank)
        end
        self.lock_tip:setString(transformTextToShort(txt,10))
        addEvt2showAllTextTips(self.lock_tip,txt,10)
    end
    self.stronghold_img:loadTexture(PathTool.getResFrame("time_warp",self.cfg.icon,false,"qualifier"),LOADTEXT_TYPE_PLIST)
    self.stronghold_img:ignoreContentAdaptWithSize(true)
    if model:getPreRoomId() == i then
        self.my_head:setVisible(true)
        if not self.head_node then
            self.head_node = PlayerHead.new(PlayerHead.type.circle)
            self.head_node:setHeadRes(role_vo.face_id, false, LOADTEXT_TYPE, role_vo.face_file, role_vo.face_update_time)
            self.head_node:setScale(0.6)
            self.my_head:addChild(self.head_node)
        end
        doStopAllActions(self.treasure_icon)
        local act_1 = cc.MoveBy:create(1, cc.p(0, 5))
        local act_2 = cc.MoveBy:create(1, cc.p(0, -5))
        self.my_head:runAction(cc.RepeatForever:create(cc.Sequence:create(act_1, act_2)))
    else
        self.my_head:setVisible(false)
        doStopAllActions(self.treasure_icon)
    end
end

function ArenaworldbullySignupItem:DeleteMe()
    if not tolua.isnull(self.choose_spine) then
        self.choose_spine:clearTracks()
        self.choose_spine = nil
    end
end