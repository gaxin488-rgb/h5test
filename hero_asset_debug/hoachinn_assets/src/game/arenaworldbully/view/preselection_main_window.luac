    self.stone_bg = self.middle_panel:getChildByName("stone_bg")
    for i = 1, 5 do
        local item = self.middle_panel:getChildByName("stronghold_"..i)
        self.stronghold_list[i] = item
    end
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.black_bg = self.bottom_panel:getChildByName("black_bg")
    self.rank_bg = self.bottom_panel:getChildByName("rank_bg")
    self.my_rank_txt = self.bottom_panel:getChildByName("my_rank_txt")
    self.race_schedule_txt = self.bottom_panel:getChildByName("race_schedule_txt")
    self.race_schedule_txt:setString(TI18N("语言_c_551"))
    self.open_time_txt = self.bottom_panel:getChildByName("open_time_txt")
    self.open_time_txt:setString(TI18N("语言_c_5261"))
    self.condition_txt = self.bottom_panel:getChildByName("condition_txt")
    self.condition_txt:setString(TI18N("语言_c_5262"))
    self.reward_txt = self.bottom_panel:getChildByName("reward_txt")
    self.reward_txt:setString(TI18N("语言_c_5980"))
    self.race_schedule_value = self.bottom_panel:getChildByName("race_schedule_value")
    self.race_schedule_value:setPositionX(self.race_schedule_txt:getPositionX()+self.race_schedule_txt:getContentSize().width + 5)
    self.open_time_value = self.bottom_panel:getChildByName("open_time_value")
    self.open_time_value:setPositionX(self.open_time_txt:getPositionX()+self.open_time_txt:getContentSize().width + 5)
    self.condition_value = self.bottom_panel:getChildByName("condition_value")
    setTextSpacing(self.condition_value,-10)
    self.condition_value:setPositionX(self.condition_txt:getPositionX()+self.condition_txt:getContentSize().width + 5)
    self.reward_scrollView = self.bottom_panel:getChildByName("reward_scrollView")
    self.reward_scrollView:setPositionX(self.reward_txt:getPositionX()+self.reward_txt:getContentSize().width + 5)
    self.reward_scrollView:setScrollBarEnabled(false)
    self.group_panel = self.bottom_panel:getChildByName("group_panel")
    self.group_bg = self.group_panel:getChildByName("group_bg")
    self.group_txt = self.group_panel:getChildByName("group_txt")
    self.group_img = self.group_panel:getChildByName("group_img")
    self.region_img = self.group_panel:getChildByName("region_img")
    self.score_txt = self.group_panel:getChildByName("score_txt")
    self.score_txt:setString(TI18N("语言_c_6668"))
    self.score_value = self.group_panel:getChildByName("score_value")    
    self.power_txt = self.group_panel:getChildByName("power_txt")
    self.power_txt:setString(TI18N("语言_c_7052"))
    self.power_value = self.group_panel:getChildByName("power_value")
    self.power_value:setString(model:getMaxPower())
    local _w = self.power_txt:getContentSize().width + self.power_value:getContentSize().width + 20
    self.power_txt:setPositionX(self.group_panel:getContentSize().width - _w)
    self.power_value:setPositionX(self.power_txt:getPositionX() + self.power_txt:getContentSize().width + 5)
    self.matching_btn = self.bottom_panel:getChildByName("matching_btn")
    self.matching_txt = self.matching_btn:getChildByName("label")
    self.matching_txt:setString(TI18N("语言_c_3867"))
    self.count_title = self.bottom_panel:getChildByName("count_title")
    self.count_title:setString(TI18N("语言_c_3868"))
    self.count_label = self.bottom_panel:getChildByName("count_label")
    self.count_label:setPositionX(self.count_title:getPositionX()+self.count_title:getContentSize().width+5)
    self.add_btn = self.bottom_panel:getChildByName("add_btn")
    self.surplus_count_txt = createRichLabel(18,cc.c3b(0xff,0xff,0xff),cc.p(0,0.5),cc.p(25,-63))
    self.bottom_panel:addChild(self.surplus_count_txt)
    self.btn_log = self.main_container:getChildByName("btn_log")
    self.log_txt = self.btn_log:getChildByName("label")
    self.log_txt:setString(TI18N("语言_c_2595"))
    setTextMaxWidth(self.log_txt,120,-10)
    self.btn_shop = self.main_container:getChildByName("btn_shop")
    self.shop_txt = self.btn_shop:getChildByName("label")
