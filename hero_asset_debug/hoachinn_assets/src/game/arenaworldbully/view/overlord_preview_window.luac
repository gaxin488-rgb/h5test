OverlordPreviewWindow = OverlordPreviewWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function OverlordPreviewWindow:__init()
	self.is_full_screen = true
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/overlord_preview_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function OverlordPreviewWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.main_panel = self.main_container:getChildByName("main_panel")
	self.imgTitleBg = self.main_container:getChildByName("image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_6619"))
	moveTextBg(self.win_title,self.imgTitleBg,60,332)
	self.rank_panel = self.main_container:getChildByName("rank_panel")
	self.rank_txt = self.rank_panel:getChildByName("rank_txt")
	-- setTextMaxWidth(self.rank_txt,160,-10)
	self.rank_txt:setString(transformTextToShort(TI18N("语言_c_6649"),15))
	addEvt2showAllTextTips(self.rank_txt,TI18N("语言_c_6649"),15)
	self.rank_1 = self.rank_panel:getChildByName("rank_1")
	setTextMaxWidth(self.rank_1,100,-10)
	self.rank_2 = self.rank_panel:getChildByName("rank_2")
	setTextMaxWidth(self.rank_2,100,-10)
	self.rank_3 = self.rank_panel:getChildByName("rank_3")
	setTextMaxWidth(self.rank_3,100,-10)
	self.rank_4 = self.rank_panel:getChildByName("rank_4")
	setTextMaxWidth(self.rank_4,100,-10)
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.my_log_panel = self.main_container:getChildByName("my_log_panel")
	self.title_bg = self.main_container:getChildByName("title_bg")
	self.enemy_title = self.title_bg:getChildByName("enemy_title")
	self.enemy_title:setString(transformTextToShort(TI18N("语言_c_6650"),15))
	addEvt2showAllTextTips(self.enemy_title,TI18N("语言_c_6650"),15)
	self.more_title = self.title_bg:getChildByName("more_title")
	self.more_title:setString(transformTextToShort(TI18N("语言_c_6651"),35))
	addEvt2showAllTextTips(self.more_title,TI18N("语言_c_6651"),35)
end

function OverlordPreviewWindow:openRootWnd()
	local cfg = Config.ArenaTimeWarpData.data_const["guess_option"].val
	if cfg[1][1] == cfg[1][2] then
		self.rank_1:setString(string.format(TI18N("语言_c_1082"),1))
	else
		self.rank_1:setString(string.format(TI18N("语言_c_1082"),string.format("%s-%s",cfg[1][1], cfg[1][2])))
	end
	if cfg[2][1] == cfg[2][2] then
		self.rank_2:setString(string.format(TI18N("语言_c_1082"),1))
	else
		self.rank_2:setString(string.format(TI18N("语言_c_1082"),string.format("%s-%s",cfg[2][1], cfg[2][2])))
	end
	if cfg[3][1] == cfg[3][2] then
		self.rank_3:setString(string.format(TI18N("语言_c_1082"),1))
	else
		self.rank_3:setString(string.format(TI18N("语言_c_1082"),string.format("%s-%s",cfg[3][1], cfg[3][2])))
	end
	if cfg[4][1] == cfg[4][2] then
		self.rank_4:setString(string.format(TI18N("语言_c_1082"),1))
	else
		self.rank_4:setString(string.format(TI18N("语言_c_1082"),string.format("%s-%s",cfg[4][1], cfg[4][2])))
	end
	self:setData()
end
function OverlordPreviewWindow:setData()
	if self.group_view == nil then
        local scroll_view_size = self.my_log_panel:getContentSize()
        local setting = {
            item_class = OverlordPreviewItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 611,               -- 单元的尺寸width
            item_height = 50,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.my_log_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	local list = {}
	local cfg = deepCopy(Config.ArenaTimeWarpData.data_rate_list)
	for k, v in pairs(cfg) do
		table.insert(list,v)
	end
	table.sort(list,function(a,b) return a.min < b.min end)
	self.group_view:setData(list)
end
function OverlordPreviewWindow:_onClickBtnClose()
	controller:openOverlordPreviewWindow(false)
end
function OverlordPreviewWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	
end

function OverlordPreviewWindow:close_callback(  )
	if self.update_logs_data ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_logs_data)
        self.update_logs_data = nil
    end
	self:_onClickBtnClose()
end

--子项
OverlordPreviewItem = class("OverlordPreviewItem", function()
    return ccui.Widget:create()
end)

function OverlordPreviewItem:ctor()
    self:configUI()
    self:register_event()
end

function OverlordPreviewItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/overlord_preview_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(611,50))
	self:setTouchEnabled(true)
	self.container = self.root_wnd:getChildByName("container")
    self.rank_txt = self.container:getChildByName("rank_txt")
	self.txt_list = {}
	local pos_list = {
		[1] = cc.p(232,25),
		[2] = cc.p(337,25),
		[3] = cc.p(443,25),
		[4] = cc.p(547,25)
	}
    for i = 1, 4 do
		local item = createRichLabel(24,cc.c3b(0x68,0x45,0x2a),cc.p(0.5,0.5),pos_list[i])
		self.container:addChild(item)
		item.index = i
		self.txt_list[i] = item
	end
end

function OverlordPreviewItem:register_event( )
	
end

function OverlordPreviewItem:setData(data)
	if data.min == data.max then
		self.rank_txt:setString(data.min)
	else
		self.rank_txt:setString(data.min.."~"..data.max)
	end
	local id = Config.ArenaTimeWarpData.data_const["happy_coin_item"].val
	local res = PathTool.getItemRes(id)
	for k, v in pairs(data.rate) do
		local txt = string.format(TI18N("<img src=%s scale=0.35 />%s"),res,v[2])
		self.txt_list[v[1]]:setString(txt)
	end
end

function OverlordPreviewItem:DeleteMe()

end