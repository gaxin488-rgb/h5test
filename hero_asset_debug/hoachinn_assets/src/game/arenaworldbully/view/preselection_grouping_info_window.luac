--------------------------------------------
-- 
-- 
-- @Date    : 2018-11-01 14:19:50
-- @description    : 
		-- 预选赛分组信息
---------------------------------
PreselectionGroupingInfoWindow = PreselectionGroupingInfoWindow or BaseClass(BaseView)

local controller = ArenaworldbullyController:getInstance()
local model = controller:getModel()

function PreselectionGroupingInfoWindow:__init()
	self.is_full_screen = false
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworldbully/preselection_grouping_info_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}
	
end

function PreselectionGroupingInfoWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.title_panel = self.main_container:getChildByName("title_panel")
	self.imgTitleBg = self.title_panel:getChildByName("imgTitleBg")
	self.win_title = self.title_panel:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_6657"))
	autoSizeTitleBg(self.win_title,self.imgTitleBg)
	self.close_btn = self.title_panel:getChildByName("close_btn")
	self.list_panel = self.main_container:getChildByName("list_panel")
end

function PreselectionGroupingInfoWindow:openRootWnd()
	self:setData()
end
function PreselectionGroupingInfoWindow:setData()
	if self.group_view == nil then
        local scroll_view_size = self.list_panel:getContentSize()
        local setting = {
            item_class = PreselectionGroupingInfoItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 607,               -- 单元的尺寸width
            item_height = 135,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.group_view = CommonScrollViewLayout.new(self.list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
	local cfg = Config.ArenaTimeWarpData.data_group
	self.data = {}
	for k, v in pairs(cfg) do
		table.insert(self.data,v)
	end
	table.sort(self.data,function(a,b) return a.group_sort < b.group_sort end)
	self.group_view:setData(self.data)
end
function PreselectionGroupingInfoWindow:_onClickBtnClose()
	controller:openPreselectionGroupingInfoWindow(false)
end
function PreselectionGroupingInfoWindow:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
end

function PreselectionGroupingInfoWindow:close_callback(  )
	self:_onClickBtnClose()
end





--------------------------------------------
-- 
-- 
-- @Date    : 2019-08-13 15:36:39
-- @description    : 
		-- 预选赛分组信息组件
---------------------------------
--子项
PreselectionGroupingInfoItem = class("PreselectionGroupingInfoItem", function()
    return ccui.Widget:create()
end)

function PreselectionGroupingInfoItem:ctor()
    self:configUI()
    self:register_event()
end

function PreselectionGroupingInfoItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("arenaworldbully/preselection_grouping_info_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(607,135))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.bg = self.main_container:getChildByName("bg")
	self.icon = self.main_container:getChildByName("icon")
	self.name = self.main_container:getChildByName("name")
	self.power = self.main_container:getChildByName("power")
	self.power_bg = self.main_container:getChildByName("power_bg")
	self.my_group = self.main_container:getChildByName("my_group")
	self.txt = self.main_container:getChildByName("txt")
	self.txt:setString(TI18N("语言_c_1294"))
	self.my_group:setContentSize(cc.size(self.txt:getContentSize().width + 30,self.my_group:getContentSize().height))
	self.my_group:setVisible(false)
	self.txt:setVisible(false)
	local res = PathTool.getResFrame("common", "common_1093")
	self.reward_txt = createRichLabel(20,cc.c3b(0xff,0xff,0xff),cc.p(0, 0.5),cc.p(153,65),nil,nil,450)
	self.reward_txt:setString(string.format(TI18N("语言_c_6658"),res))
	self.main_container:addChild(self.reward_txt)
	self.rank_txt = createRichLabel(20,cc.c3b(0xff,0xff,0xff),cc.p(0, 0.5),cc.p(153,30),nil,nil,450)
	self.rank_txt:setString(string.format(TI18N("语言_c_6659"),res))
	self.main_container:addChild(self.rank_txt)
end

function PreselectionGroupingInfoItem:register_event( )
	registerButtonEventListener(self.btn_watch, handler(self, self._onClickBtnWatch), true, 2)
end
function PreselectionGroupingInfoItem:_onClickBtnWatch()
	controller:openPreselectionFightVedioPanel(true,self.data,1)
end

function PreselectionGroupingInfoItem:setData(data)
	if data.id == 0 then
		self.rank_txt:setVisible(false)
		self.power:setString(TI18N("语言_c_6660"))
	else
		self.rank_txt:setVisible(true)
		if data.max == 9999999999 then
			self.power:setString(string.format(TI18N("语言_c_6661"),MoneyTool.moneyFormat(data.min)))
		else
			self.power:setString(string.format(TI18N("语言_c_6662"),MoneyTool.moneyFormat(data.min),MoneyTool.moneyFormat(data.max)))
		end
	end
	self.power_bg:setContentSize(cc.size(self.power:getContentSize().width+20,self.power_bg:getContentSize().height))
	if data.id == model:getPreGroupId() then
		self.my_group:setVisible(true)
		self.txt:setVisible(true)
	else
		self.my_group:setVisible(false)
		self.txt:setVisible(false)
	end
	local function clickLinkCallBack( _type, value )
		if _type == "href" then
			controller:openPreselectionStrongholdRewardWindow(true,data)
		end
	end
	self.reward_txt:addTouchLinkListener(clickLinkCallBack,{"href"})
	local function clickRankCallBack( _type, value )
		if _type == "href" then
			local setting = {}
			setting.index = ArenaworldbullyConst.overlord_rank_tab.reward
			setting.group_id = data.id
			controller:openOverlordRankWindow(true,setting)
		end
	end
	self.rank_txt:addTouchLinkListener(clickRankCallBack,{"href"})
	loadSpriteTexture(self.icon,PathTool.getResFrame("time_warp",data.icon,false,"qualifier"),LOADTEXT_TYPE_PLIST)
	self.name:setString(transformTextToShort(data.name,10))
	addEvt2showAllTextTips(self.name,data.name,10)

end

function PreselectionGroupingInfoItem:DeleteMe()

end