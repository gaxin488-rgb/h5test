----------------------@ 打开界面
--打开时空争霸赛
function ArenaworldbullyController:openWindow()
	local is_open = self:isOpenStatus()
	if not is_open then return end
	local status = self.model:getStatus()
	if status == ArenaworldbullyConst.stage.signUp then
		self:openArenaworldbullySignupWindow(true)
	elseif status == ArenaworldbullyConst.stage.preliminariesTruce or status == ArenaworldbullyConst.stage.preliminariesBattle then
		self:openMainWindow(true,ArenaworldbullyConst.Tab_Index.Preselection)
	elseif status == ArenaworldbullyConst.stage.prepare or status == ArenaworldbullyConst.stage.guess or status == ArenaworldbullyConst.stage.match or status == ArenaworldbullyConst.stage.battle or status == ArenaworldbullyConst.stage.battle_settlement or status == ArenaworldbullyConst.stage.settlement then
		if (self.arenaworldbully_main_window and self.arenaworldbully_main_window:isOpen() == false or not self.arenaworldbully_main_window) and (self.overlord_window and self.overlord_window:isOpen() == false or not self.overlord_window) then
			self:openMainWindow(true,ArenaworldbullyConst.Tab_Index.Overlord)
			if self.model:getRedForIndex(ArenaworldbullyConst.RedType.GuessReward) then
				delayOnce(function()
					self:openOverlordWindow(true,{index=ArenaworldbullyConst.guessing_tab.eGuessing})
				end,0.3)
			end
		end
	elseif status == ArenaworldbullyConst.stage.preview or status == ArenaworldbullyConst.stage.award or status == ArenaworldbullyConst.stage.close or status == ArenaworldbullyConst.stage.over then
		self:openArenaworldbullyWindow(true)
	else
		message(TI18N("语言_c_130"))
	end
end
function ArenaworldbullyController:isOpenStatus()
	local open_config = Config.ArenaTimeWarpData.data_const
    if open_config == nil then return end
	local role_vo = RoleController:getInstance():getRoleVo()
	local world_lev = RoleController:getInstance():getModel():getWorldLev() or 0
	if role_vo.lev < open_config.character_level.val or world_lev < open_config.world_level.val then
		message(string.format(TI18N("语言_c_6700"),open_config.character_level.val,open_config.world_level.val))
		return false
	end
	return true
end
-- 争霸赛主界面主界面
function ArenaworldbullyController:openMainWindow(status,index)
	if status == true then
		if self.arenaworldbully_main_window == nil then
			self.arenaworldbully_main_window = ArenaworldbullyMainWindow.New()
		end
		if self.arenaworldbully_main_window:isOpen() == false then
			self.arenaworldbully_main_window:open(index)
		end
	else
		if self.arenaworldbully_main_window then
			self.arenaworldbully_main_window:close()
			self.arenaworldbully_main_window = nil
			self.model:setLookZone(1)
		end
	end
end
-- 时空争霸赛预告 功能结束 领奖页面
function ArenaworldbullyController:openArenaworldbullyWindow(status)
	if status == true then
		if self.arenaworldbully_window == nil then
			self.arenaworldbully_window = ArenaworldbullyWindow.New()
		end
		if self.arenaworldbully_window:isOpen() == false then
			self.arenaworldbully_window:open()
		end
	else
		if self.arenaworldbully_window then
			self.arenaworldbully_window:close()
			self.arenaworldbully_window = nil
			self.model:setLookZone(1)
		end
	end
end
-- 时空争霸赛报名页面
