-- 战斗结算处理
function ArenaworldbullyController:handle14508(data)
	self:printData(14508,data)
	data.item_rewards = data.reward
	table.sort(data.all_hurt_statistics, function(a, b) return a.round < b.round end)
	data.hurt_statistics=data.all_hurt_statistics
	BattleController:getInstance():openFinishView(true,BattleConst.Fight_Type.WorldPreselection, data)
end
