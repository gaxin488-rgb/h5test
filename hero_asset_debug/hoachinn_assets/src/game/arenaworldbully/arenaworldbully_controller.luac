function ArenaworldbullyController:openPreselectionLogsWindow(status)
	if status == true then
		if self.preselection_logs_window == nil then
			self.preselection_logs_window = PreselectionLogsWindow.New()
		end
		if self.preselection_logs_window:isOpen() == false then
			self.preselection_logs_window:open()
		end
	else
		if self.preselection_logs_window then
