CommentPopupWindow = CommentPopupWindow or BaseClass(BaseView) 

local controller = WelfareController:getInstance()
function CommentPopupWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "welfare/comment_gift_window"  
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("commentgift","commentgift"), type = ResourcesType.plist },
    } 
end

function CommentPopupWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local container = self.root_wnd:getChildByName("container")
    container:getChildByName("Sprite_2"):getChildByName("Text_5"):setString(TI18N("小助手"))

    self.btn_close = container:getChildByName("btn_close")
    self.btn_close:getChildByName("Text_6"):setString("Not Now")

    self.btn_sure = container:getChildByName("btn_sure")
    self.btn_sure:getChildByName("Text_6_0"):setString("Go Now")

    self.desc = createRichLabel(26,cc.c3b(0x69,0x37,0x05),cc.p(0,1),cc.p(50,185),nil,nil,700)
    container:addChild(self.desc)

    local effect_node = container:getChildByName("effect_node")
    self.effect = createEffectSpine(PathTool.getEffectRes(235), cc.p(0, 0), cc.p(0.5,0), true, PlayerAction.action_1)
    effect_node:addChild(self.effect)
end
function CommentPopupWindow:register_event()
	registerButtonEventListener(self.btn_close, function()
        controller:openCommentPopupWindow(false)
    end,true, 2)
    registerButtonEventListener(self.btn_sure, function()
        if self.data_info then
        	if IS_IOS_PLATFORM == true then
		        sdkCallFunc("openSyW", self.data_info.jump_url)
		    else
		        sdkCallFunc("openUrl", self.data_info.jump_url)
		    end
        end
    end,true, 2)
end
function CommentPopupWindow:openRootWnd(data)
    if not data then return end
    local channel = LoginPlatForm:getInstance():getChannel()
    for i,v in pairs(data) do
        if type(v) == "table" then
            if v and v.key and v.key == channel then
                self.data_info = v      
                break
            end
        end
    end
	if self.desc and self.data_info then
		self.desc:setString(self.data_info.text_label)
	end
end
function CommentPopupWindow:close_callback()
	if self.effect then
		self.effect:clearTracks()
		self.effect:removeFromParent()
		self.effect = nil
	end
	controller:openCommentPopupWindow(false)
end


