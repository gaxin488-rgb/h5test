LingtDarkOptionalGiftChose = LingtDarkOptionalGiftChose or BaseClass(BaseView)
local controller = WelfareController:getInstance()
local model = controller:getModel()

function LingtDarkOptionalGiftChose:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "welfare/lingt_dark_optional_gift_chose"
    self.choose_cfg = deepCopy(Config.MiscData.data_gift_chose)
    self.reward_cfg = Config.MiscData.data_cycle_gift_reward
    self.reward_item = {}
    self.select_num = 1
    self.item_num = 0
end

function LingtDarkOptionalGiftChose:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_4780"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 100,63))
    self.image_bottom = self.main_container:getChildByName("image_bottom")
    self.right_btn = self.main_container:getChildByName("right_btn")
    self.right_label = self.right_btn:getChildByName("label")
    self.right_label:setString(TI18N("语言_c_3"))
    self.left_btn = self.main_container:getChildByName("left_btn")
    self.left_label = self.left_btn:getChildByName("label")
    self.left_label:setString(TI18N("语言_act_02_5"))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.list_info_panel = self.main_container:getChildByName("list_info_panel")
    self.name_txt = self.list_info_panel:getChildByName("name_txt")
    self.name_txt:setString(TI18N("语言_c_4781"))
    self.hero_list = self.list_info_panel:getChildByName("hero_list")

    self.reward_item_1 = BackPackItem.new(true, true, false, 1)
    self.reward_item_1:setDefaultTip()
    self.reward_item_1:setPosition(cc.p(170,398))
    self.main_container:addChild(self.reward_item_1)
    self.reward_item_2 = BackPackItem.new(true, true, false, 1)
    self.reward_item_2:setDefaultTip()
    self.reward_item_2:setPosition(cc.p(340,398))
    self.main_container:addChild(self.reward_item_2)
    self.reward_item_3 = BackPackItem.new(true, true, false, 1)
    self.reward_item_3:setDefaultTip()
    self.reward_item_3:setPosition(cc.p(510,398))
    self.main_container:addChild(self.reward_item_3)
    table.insert(self.reward_item, self.reward_item_1)
    table.insert(self.reward_item, self.reward_item_2)
    table.insert(self.reward_item, self.reward_item_3)


    self.click_select = self.main_container:getChildByName("click_select")
end
function LingtDarkOptionalGiftChose:register_event()
    registerButtonEventListener(self.background, function()
        self:clickClose()
    end,false, 1)
    registerButtonEventListener(self.close_btn, function()
        self:clickClose()
    end,true, 1)
    registerButtonEventListener(self.right_btn, function()
        local list = {}
        for i=1,tableLen(self.choose_list) do
            local reward_list = {}
            reward_list.pos = i
            local id = 0
            for j=1,tableLen(self.choose_cfg[self.charge_id][i]) do
                if self.choose_cfg[self.charge_id][i][j].reward[1][1] == self.choose_list[i][1] then
                    id = self.choose_cfg[self.charge_id][i][j].id
                end
            end
            reward_list.rewardid = id
            if not self.choose_list[i][1] then
                message(TI18N("语言_c_4770"))
                return
            end
            table.insert(list,reward_list)
        end
        controller:sender21036(self.charge_id,list)
    end,true, 1)
    registerButtonEventListener(self.left_btn, function()
        self:clickClose()
    end,true, 1)
    for i=1,tableLen(self.reward_item) do
        if self.reward_item[i] then
            registerButtonEventListener(self.reward_item[i], function()
                self.select_num = i
                self:updateRewardScroll(self.pond_list[i])
                self.click_select:setPosition(self.reward_item[i]:getPosition())
                GlobalEvent:getInstance():Fire(WelfareEvent.Optional_UpSe_Data,self.choose_list[self.select_num])
            end,true, 1)
        end
    end
    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(WelfareEvent.Optional_Select_Data,function (data)
            self:updateData(data)
        end)
    end  
    if not self.Optional_Int then
        self.Optional_Int = GlobalEvent:getInstance():Bind(WelfareEvent.Optional_Int,function (data)
            self.item_num = self.item_num + 1
            if self.pond_list and self.pond_list[self.select_num] and self.item_num >= tableLen(self.pond_list[self.select_num]) then
                GlobalEvent:getInstance():Fire(WelfareEvent.Optional_UpSe_Data,self.choose_list[self.select_num]) 
                self.item_num = 0
            end
        end)
    end 
end

--选择更改后刷新
function LingtDarkOptionalGiftChose:updateData(data)
    if data[1] and data[2]  then
        local list = {data[1],data[2]}
        self.choose_list[self.select_num] = list
    end
    self:setOptionalReward(self.choose_list)
end

function LingtDarkOptionalGiftChose:openRootWnd(charge_id,num,_index,type,son_type)
    self.charge_id = charge_id
    self.select_num = _index - tableLen(self.reward_cfg[charge_id][num].reward)
    self.type = type
    self.son_type = son_type
    self:setData(charge_id)
end

function LingtDarkOptionalGiftChose:setData(charge_id)
    self.choose_list = {}
    for key, value in pairs(self.choose_cfg[charge_id]) do
        table.insert(self.choose_list, {})
    end
    local list = model:getWeekOptionalData(self.type,self.son_type)
    for key, value in pairs(list.chose_gift) do
        if value.charge_id == charge_id then
            table.sort(value.pos_reward,function(a,b) return a.pos < b.pos end)
            for k, v in pairs(value.pos_reward) do
                local id = v.rewardid
                for i, j in pairs(self.choose_cfg[charge_id][v.pos]) do
                    if j.id == id then
                        self.choose_list[k] = self.choose_cfg[charge_id][v.pos][i].reward[1]
                    end
                end
            end
        end
    end
    self:setOptionalRewardpond(charge_id)
    self:setOptionalRewardItem(charge_id)
    self:setOptionalReward(self.choose_list)
end

--设置上部自选框的显示
function LingtDarkOptionalGiftChose:setOptionalRewardItem(charge_id)
    local cfg = self.choose_cfg[charge_id]
    for i=1,tableLen(self.reward_item) do
        if cfg[i] then
            self.reward_item[i]:setVisible(true)
        else
            self.reward_item[i]:setVisible(false)
        end
    end
    if tableLen(cfg) == 1 then
        self.reward_item_1:setPositionX(340)
    elseif tableLen(cfg) == 2 then
        self.reward_item_1:setPositionX(170)
        self.reward_item_2:setPositionX(510)
    elseif tableLen(cfg) == 3 then
        self.reward_item_2:setPositionX(170)
        self.reward_item_2:setPositionX(340)
        self.reward_item_3:setPositionX(510)
    end
    self.click_select:setPosition(self.reward_item[self.select_num]:getPosition())
end

--得到已经选择的自选物品数据 设置显示
function LingtDarkOptionalGiftChose:setOptionalReward(list)
    for i=1,tableLen(list) do
        self.reward_item[i]:setData(list[i])
    end
end

--设置自选池
function LingtDarkOptionalGiftChose:setOptionalRewardpond(charge_id)
    local cfg = deepCopy(self.choose_cfg[charge_id])
    for key, value in pairs(cfg) do
        table.sort(value, function(a,b)
            return a.sort_num < b.sort_num
        end)
    end
    --获取屏蔽表
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("misc_data")
    self.pond_list = {}
    for i=1,tableLen(cfg) do
        local list = {}
        for j=1,tableLen(cfg[i]) do
            if cfg[i][j].reward and cfg[i][j].reward[1] then
                if cfg[i][j].is_pid == 1 or table.indexof(nohideIds,cfg[i][j].reward[1][1]) then
                    table.insert(list,cfg[i][j].reward[1])
                end
            end
        end
        table.insert(self.pond_list,list)
    end
    self:updateRewardScroll(self.pond_list[self.select_num])
end

function LingtDarkOptionalGiftChose:updateRewardScroll(list)
    if self.item_scrollview == nil then
        local scroll_view_size = self.hero_list:getContentSize()
        local setting = {
            item_class = LingtDarkOptionalGiftChoseItem,
            start_x = 30,                     -- 第一个单元的X起点
            space_x = 20,                     -- x方向的间隔
            start_y = 10,                     -- 第一个单元的Y起点
            space_y = 5,                     -- y方向的间隔
            item_width = 120,                -- 单元的尺寸width
            item_height = 148,               -- 单元的尺寸height
            col = 4,                         -- 列数，作用于垂直滚动类型
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.hero_list,cc.p(0,0),ScrollViewDir.vertical,ScrollViewStartPos.top,scroll_view_size,setting)
        self.item_scrollview:setSwallowTouches(false)
    end
    self.item_scrollview:setData(list)
end

function LingtDarkOptionalGiftChose:clickClose()
    controller:openLingtDarkOptionalGiftChose(false)
end

function LingtDarkOptionalGiftChose:close_callback()
    for key, v in pairs(self.reward_item) do
        if v then 
            v:DeleteMe()
            v = nil
        end
    end
    self.reward_item = {}
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    if self.Optional_Int then
        GlobalEvent:getInstance():UnBind(self.Optional_Int)
        self.Optional_Int = nil
    end
    if self.item_scrollview then
		self.item_scrollview:DeleteMe()
		self.item_scrollview = nil
	end
    controller:openLingtDarkOptionalGiftChose(false)
end


--------------------------@ item
LingtDarkOptionalGiftChoseItem = class("LingtDarkOptionalGiftChoseItem", function()
    return ccui.Widget:create()
end)

function LingtDarkOptionalGiftChoseItem:ctor(width, height)
	self.size = cc.size(width,height)
	self:configUI(width, height)
	self:register_event()
end

function LingtDarkOptionalGiftChoseItem:configUI( width, height )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_optional_gift_chose_item"))
    self:setAnchorPoint(cc.p(0, 0))
    self:setContentSize(cc.size(width, height))
	self:setTouchEnabled(false)
    
    GlobalEvent:getInstance():Fire(WelfareEvent.Optional_Int)
	self:addChild(self.root_wnd)
	self.container = self.root_wnd:getChildByName("container")
    self.Node_1 = self.container:getChildByName("Node_1")
    self.select = self.container:getChildByName("select")
    self.select_1 = self.container:getChildByName("select_1")
    self.select:setVisible(false)

    self.item_node = BackPackItem.new(false, true, false, 1, nil, nil, false)
    self.Node_1:addChild(self.item_node)
end
--==============================--
--desc:设置选中状态
--time:2017-07-03 09:07:12
--@status:
--==============================--
function LingtDarkOptionalGiftChoseItem:setSelected(status)
    if status then
        self.select:setVisible(true)
    else
        self.select:setVisible(false)
    end
end
function LingtDarkOptionalGiftChoseItem:clearTimeTicket()
    if self.sequence_action then
        self.item_node:stopActionByTag(10086)
        self.sequence_action = nil
    end
    if self.time_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_ticket)
        self.time_ticket = nil
    end
end
function LingtDarkOptionalGiftChoseItem:register_event(  )
    -- registerButtonEventListener(self.item_node, function()
    self.item_node:addTouchEventListener(function (sender, event_type)
        if event_type == ccui.TouchEventType.began then
            GlobalEvent:getInstance():Fire(WelfareEvent.Optional_Select_Data,self.data)
            local action = cc.Sequence:create(cc.DelayTime:create(0.3), cc.CallFunc:create(function() 
                TipsManager:getInstance():showGoodsTips(self.data[1],nil,nil,nil,true,true)
            end))
            self.sequence_action = self.item_node:runAction(action)
            self.sequence_action:setTag(10086)
        elseif event_type == ccui.TouchEventType.canceled then
            self:clearTimeTicket()
        elseif event_type == ccui.TouchEventType.ended then
            self:clearTimeTicket()
        end
    end)
    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(WelfareEvent.Optional_Select_Data,function (data)
            if data["_index"] == self.data["_index"] then
                self:setSelected(true)
            else
                self:setSelected(false)
            end
        end)
    end  
    if not self.update_sele then
        self.update_sele = GlobalEvent:getInstance():Bind(WelfareEvent.Optional_UpSe_Data,function (data)
            if data and data[1] and data[2] and self.data and self.data[1] and self.data[2] and data[1] == self.data[1] and data[2] == self.data[2] then
                self:setSelected(true)
            else
                self:setSelected(false)
            end
        end)
    end  
end

function LingtDarkOptionalGiftChoseItem:setData( data)
    self.data = data
	if self.item_node then
		-- self.item_node:setBaseData(data[1], data[2])
        local list = {}
        list.bid = data[1]
        list.num = data[2] 
        self.item_node:setData(list,nil,true)
        local cfg = Config.ItemData.data_get_data(data[1])
        if cfg.type == BackPackConst.item_type.HERO_HUN then
            self.item_node:initCamp(cfg.camp_type)
        end
	end
end

function LingtDarkOptionalGiftChoseItem:DeleteMe(  )
    self:clearTimeTicket()
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    if self.update_sele then
        GlobalEvent:getInstance():UnBind(self.update_sele)
        self.update_sele = nil
    end
    if self.item_node then
		self.item_node:DeleteMe()
		self.item_node = nil
	end
end