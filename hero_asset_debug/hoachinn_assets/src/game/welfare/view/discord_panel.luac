-- --------------------------------------------------------------------
-- discord facebook 礼包
--
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-06-12
-- --------------------------------------------------------------------
DiscordPanel = class("DiscordPanel", function()
    return ccui.Widget:create()
end)

function DiscordPanel:ctor()
	self.ctrl = WelfareController:getInstance()
	self.model = self.ctrl:getModel()
	self.role_vo = RoleController:getInstance():getRoleVo()
    self.type_list = {
        facebook = 1,
        discord = 2,
    }
    self.pageIndex = self.type_list.facebook
    self.config = Config.HolidayClientData.data_info[WelfareIcon.discord]
	self:configUI()
	self:register_event()
end

function DiscordPanel:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("welfare/discord_panel"))
    self:addChild(self.root_wnd)
    self:setPosition(-40,-80)
    self:setAnchorPoint(0,0)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.background = self.main_container:getChildByName("background")
    self.discord_btn = self.main_container:getChildByName("discord_btn")
    self.facebook_btn = self.main_container:getChildByName("facebook_btn")
    self.tip_img = self.main_container:getChildByName("tip_img")
    self.reward_bg = self.main_container:getChildByName("reward_bg")
    self.reward_panel = self.main_container:getChildByName("reward_panel")
    self.describe_img = self.main_container:getChildByName("describe_img")
    self.btn_go = self.main_container:getChildByName("btn_go")
    self.go_txt = self.btn_go:getChildByName("go_txt")    
    self.go_txt:setString(TI18N("语言_c_7"))
    self:updatepage(self.type_list.discord)
end
function DiscordPanel:updatepage(type)
    local type = type or self.type_list.discord
    self.pageIndex = type
    local item_list = self.config.items[type]
    -- print("type",type)
    -- printLuaTable(item_list)
    local reward_list={}
    if tableLen(item_list) ~= 0 then
        for index, value in ipairs(item_list) do
            local list = {}
            list.id = value[1]
            list.quantity = value[2]
            table.insert(reward_list,index,list)
        end
    end
    if tableLen(reward_list) == 0 then
        self.reward_bg:setVisible(false)
        if self.good_scrollview then
            self.good_scrollview:setVisible(false)
        end
    else
        self.reward_bg:setVisible(true)
        if self.good_scrollview then
            self.good_scrollview:setVisible(true)
        end
        self:updateRewardList(reward_list)
    end
    loadSpriteTexture(self.tip_img,PathTool.getResFrame("discord","txt_cn_discord_"..type),LOADTEXT_TYPE_PLIST)
    loadSpriteTexture(self.describe_img,PathTool.getResFrame("discord","txt_cn_discord_"..(type+2)),LOADTEXT_TYPE_PLIST)
end
function DiscordPanel:updateRewardList(list)
    if not self.good_scrollview then
        local scroll_view_size = self.reward_panel:getContentSize()
        local setting = {
            item_class = BackPackItem,
            start_x = 0,
            space_x = 10,
            start_y = 12,
            space_y = 0,
            item_width = BackPackItem.Width*0.80,
            item_height = BackPackItem.Height*0.80,
            row = 1,
            col = 0,
            scale = 0.80
        }
        self.good_scrollview = CommonScrollViewLayout.new(self.reward_panel, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
        self.good_scrollview:setSwallowTouches(false)
    end
    self.good_scrollview:setData(list)
 	self.good_scrollview:addEndCallBack(function()
        local list = self.good_scrollview:getItemList()
        for k,v in pairs(list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
        end
    end)
end
function DiscordPanel:register_event( )
	registerButtonEventListener(self.discord_btn, function()
        self:updatepage(self.type_list.discord)
	end, true,1)
    registerButtonEventListener(self.facebook_btn, function()
        self:updatepage(self.type_list.facebook)
	end, true,1)
    registerButtonEventListener(self.btn_go, function()
        if self.pageIndex == self.type_list.discord then
            local url = URL_DISCORD
            sdkCallFunc("openUrl", url)
        elseif self.pageIndex == self.type_list.facebook then
            local url = URL_FACEBOOK
            sdkCallFunc("openUrl", url)
        end
	end, true,1)
end

function DiscordPanel:DeleteMe()
	
end