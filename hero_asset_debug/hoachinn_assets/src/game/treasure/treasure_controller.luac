--速度属性开关  0开启1关闭
function TreasureController:sender22315(id,close_speed)
	local protocal = {}
	protocal.id = id
	protocal.close_speed = close_speed
	self.close_speed = close_speed
    self:SendProtocal(22315, protocal)
end

function TreasureController:handle22315( data )
	if data.result == 0 then
		message(data.msg)
	else
		if self.close_speed == 0 then
			message(TI18N("语言_c_6268"))
		elseif self.close_speed == 1 then
			message(TI18N("语言_c_6269"))
		end
	end
end

