TreasureController = TreasureController or BaseClass(BaseController)

-- DO_NOT_REALNAME_STATUS              是不是没有实名认证
-- OPEN_SDK_VISITIOR_WINDOW            是否打开了可取消的实名认证窗体
-- NEED_OPEN_OPEN_SDK_VISITIOR_WINDOW  是否需要打开无取消的实名认证窗体

function TreasureController:config()
    self.model = TreasureModel.New(self)
    self.dispather = GlobalEvent:getInstance()
    -- self.treasure_awards = {}
	self.click_type = 0 --0升级 1升星 2激活 3觉醒
end

function TreasureController:getModel()
    return self.model
end

function TreasureController:registerEvents()
	
    --物品道具增加 判断红点
    if not self.add_goods_event then
        self.add_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function(bag_code,temp_add)
            if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                for i,item in pairs(temp_add) do
                    if item.config and item.config.id and item.config.sub_type == BackPackConst.item_tab_type.TREASURE then
                        self.model:updateTreasureRedForOne(item.config.id)
                    end
                end
            end
        end)
    end
    --物品道具删除 判断红点
    if not self.del_goods_event then
        self.del_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function(bag_code,temp_del)
            if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                for i,item in pairs(temp_del) do
                    if item.config and item.config.id and item.config.sub_type == BackPackConst.item_tab_type.TREASURE then
                        self.model:updateTreasureRedForOne(item.config.id)
                    end
                end
            end
        end)
    end

    --物品道具改变 判断红点
    if not self.modify_goods_event then
        self.modify_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_list)
            if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                for i,item in pairs(temp_list) do
                    if item.config and item.config.id and item.config.sub_type == BackPackConst.item_tab_type.TREASURE then
                        self.model:updateTreasureRedForOne(item.config.id)
                    end
                end
            end
        end)
    end
end

function TreasureController:registerProtocals()
    self:RegisterProtocal(22300, "handle22300")     -- 精灵孵化信息
	self:RegisterProtocal(22301, "handle22301")     -- 精灵孵化信息更新
	self:RegisterProtocal(22303, "handle22303")     -- 开始孵化(成功推送22301)
	self:RegisterProtocal(22306, "handle22306")     -- 领取孵化产物
	self:RegisterProtocal(22307, "handle22307")     -- 购买精灵道具
	self:RegisterProtocal(22308, "handle22308")     -- 合成
	self:RegisterProtocal(22309, "handle22309")     -- 升级
	self:RegisterProtocal(22310, "handle22310")     -- 升星
	self:RegisterProtocal(22311, "handle22311")     -- 觉醒
	self:RegisterProtocal(22312, "handle22312")     -- 编年史基本信息(信息变动推送)
	self:RegisterProtocal(22313, "handle22313")     -- 已有编年史列表  初始化用
	self:RegisterProtocal(22314, "handle22314")     -- 寻访道具合成
	self:RegisterProtocal(22315, "handle22315")     -- 速度属性开关
	self:RegisterProtocal(22316, "handle22316")     -- 效果加成情况
	self:RegisterProtocal(22317, "handle22317")     -- 请求召唤信息
	self:RegisterProtocal(22318, "handle22318")     -- 请求召唤
	self:RegisterProtocal(22319, "handle22319")     -- 弹出礼包
	self:RegisterProtocal(22320, "handle22320")     -- 许愿（成功推送22321）
	self:RegisterProtocal(22321, "handle22321")     -- 请求召唤信息(单个卡池)
	self:RegisterProtocal(22322, "handle22322")     -- 召唤结果
	self:RegisterProtocal(22323, "handle22323")     -- 礼包信息列表
	self:RegisterProtocal(22324, "handle22324")     -- 战令基本信息
	self:RegisterProtocal(22325, "handle22325")     -- 战令一键领取
	self:RegisterProtocal(22326, "handle22326")     -- 战令金币购买
	self:RegisterProtocal(22335, "handle22335")     -- 精灵孵化器激活

	self:RegisterProtocal(22336, "handle22336")     -- 魔导器构成全部信息
	self:RegisterProtocal(22337, "handle22337")     -- 魔导器构成某一期信息
	self:RegisterProtocal(22338, "handle22338")     -- 魔导器构成某一期某一个信息
	self:RegisterProtocal(22339, "handle22339")     -- 选择魔导器
	self:RegisterProtocal(22340, "handle22340")     -- 提交构成任务
	self:RegisterProtocal(22341, "handle22341")     -- 完成构成
	self:RegisterProtocal(22342, "handle22342")     -- 构成任务红点消失
	self:RegisterProtocal(22343, "handle22343")     -- 构成任务提交道具
	self:RegisterProtocal(22344, "handle22344")     -- 研发任务列表
	self:RegisterProtocal(22345, "handle22345")     -- 某个位置的研发任务列表
	self:RegisterProtocal(22346, "handle22346")     -- 提交研发任务
	self:RegisterProtocal(22347, "handle22347")     -- 编年研究室构成领取奖励

	self:RegisterProtocal(22327, "handle22327")     
	self:RegisterProtocal(22328, "handle22328")     --获取忍者专属战力加成

	self:RegisterProtocal(16821, "handle16821")     --获取忍者专属战力加成
end

-- 请求精灵孵化信息
function TreasureController:sender22300(  )
    self:SendProtocal(22300, {})
end

function TreasureController:handle22300( data )
	if data.annals_hatchs then
		self.model:setTreasureHatchList(data.annals_hatchs)
		
		GlobalEvent:getInstance():Fire(TreasureEvent.Get_Treasure_Hatch_Data_Event)
	end
	if data.info then
		self.model:setTreasureBuyInfo(data.info)
	end
end

-- 更新灵窝数据（也可能是新增）
function TreasureController:handle22301( data )
	if data.annals_hatch then
		self.model:updateTreasureHatchData(data.annals_hatch)
		GlobalEvent:getInstance():Fire(TreasureEvent.Get_Treasure_Hatch_Data_Event)
	end
end

-- 请求开始孵化
function TreasureController:sender22303( id, item_bid )
	local protocal = {}
    protocal.id = id
    protocal.item_bid = item_bid
    self:SendProtocal(22303, protocal)
end

function TreasureController:handle22303( data )
	if data.msg then
		message(data.msg)
	end
end

-- 请求领取孵化产物
function TreasureController:sender22306( id )
	local protocal = {}
    protocal.id = id
    self:SendProtocal(22306, protocal)
end

function TreasureController:handle22306( data )
	if data.msg then
		message(data.msg)
	end
	local reward_list = {}
	for key, value in pairs(data.awards) do
		local list = {}
		list.id = value.item_bid
		list.num = value.item_num
		table.insert(reward_list,list)
	end
	MainuiController:getInstance():openGetItemView(true,reward_list,0,nil, MainuiConst.item_open_type.treasure,TreasureItem)
end

-- 购买精灵道具
function TreasureController:sender22307(_type,item_id,num,hatch_id)
	-- 标识是否购买成功后直接孵化
	if hatch_id then
		self.hatch_egg_bid_flag = item_id
		self.hatch_id_flag = hatch_id
	end

	local protocal = {}
    protocal.type = _type
	protocal.item_id = item_id
	protocal.num = num
    self:SendProtocal(22307, protocal)
end

function TreasureController:handle22307( data )
	if data.msg then
		message(data.msg)
	end
	if data.result == 1 and data.count and data.item_id then
		self.model:updateTreasureBuyInfoByBid(data.item_id, data.count)
		GlobalEvent:getInstance():Fire(TreasureEvent.Buy_Treasure_Item_Success_Event, data.item_id)

		-- 购买成功后直接开始孵化
		if self.hatch_id_flag and self.hatch_egg_bid_flag and self.hatch_egg_bid_flag == data.item_id then
			self:sender22303(self.hatch_id_flag, data.item_id)
			self.hatch_egg_bid_flag = nil
			self.hatch_id_flag = nil
			self:openTreasureSelectItemWindow(false)
		end
	end
end

