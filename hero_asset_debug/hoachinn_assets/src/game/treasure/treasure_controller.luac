-- 打开魔导器获得界面
function TreasureController:openTreasurGainWindow( status, data)
	if status == true then
		if not self.treasure_gain_wnd then
			self.treasure_gain_wnd = TreasureGainWindow.New()
		end
		if self.treasure_gain_wnd:isOpen() == false then
			self.treasure_gain_wnd:open(data,self.click_type)
		end
	else
		if self.treasure_gain_wnd then
			self.treasure_gain_wnd:close()
			self.treasure_gain_wnd = nil
			-- delayOnce(function()
			-- 	self:checkTreasureGain()
			-- end, 0.2)
		end
	end
end

-- 是否打开秘宝主界面
function TreasureController:getTreasureMainWindowIsOpen()
	if self.treasure_main_window then
		return self.treasure_main_window:isOpen()
	end
end
--- 打开秘宝主界面
function TreasureController:openTreasureMainWindow(status,index)
    if status == false then
        if self.treasure_main_window ~= nil then
            self.treasure_main_window:close()
            self.treasure_main_window = nil
        end
        MainuiController:getInstance():getMainUi():changeBottomShowStatus(1)
    else
        if self.treasure_main_window == nil then
            self.treasure_main_window = TreasureMainWindow.New(index)
        end
        self.treasure_main_window:open()
    end
end
--- 打开秘宝寻访
function TreasureController:openTreasureSearchWindow(status)
    if status == false then
        if self.treasure_search_window ~= nil then
            self.treasure_search_window:close()
            self.treasure_search_window = nil
        end
    else
        if self.treasure_search_window == nil then
