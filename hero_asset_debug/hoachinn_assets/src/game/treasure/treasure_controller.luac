-- 编年史基本信息(单个信息变动推送)
function TreasureController:sender22312(item_bid)
	local protocal = {}
	protocal.item_bid = item_bid
    self:SendProtocal(22312, protocal)
end

function TreasureController:handle22312( data )
	self.model:setTreasurePower(data.all_power)
	local list = {}
	table.insert(list,data)
	GlobalEvent:getInstance():Fire(TreasureEvent.One_Treasure_data_Event,data)
	if self.click_type ~= 0 then
		local vo = TreasureVo.New()
    	vo:setUpData(data)
		self:openTreasurGainWindow(true,vo)
		self.model:setTreasureList(list)
		if next(self.model.treasure_change_list) then
			self.model.treasure_change_list = list
		end
	else
		self.model.treasure_change_list = list
	end
end

