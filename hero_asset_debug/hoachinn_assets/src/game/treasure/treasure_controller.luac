-- 特权提示弹窗
function TreasureController:openTreasurePrivilegeWindow( status )
	if status == true then
		if not self.treasure_privilege_wnd then
			self.treasure_privilege_wnd = TreasurePrivilegeWindow.New()
		end
		if self.treasure_privilege_wnd:isOpen() == false then
			self.treasure_privilege_wnd:open()
		end
	else
		if self.treasure_privilege_wnd then
			self.treasure_privilege_wnd:close()
			self.treasure_privilege_wnd = nil
		end
	end
end

-- 打开魔导器选择界面
function TreasureController:openTreasureSelectItemWindow( status, setting )
	if status == true then
		if not self.treasure_select_item_wnd then
			self.treasure_select_item_wnd = TreasureSelectItemWindow.New()
		end
		if self.treasure_select_item_wnd:isOpen() == false then
			self.treasure_select_item_wnd:open(setting)
		end
	else
		if self.treasure_select_item_wnd then
			self.treasure_select_item_wnd:close()
			self.treasure_select_item_wnd = nil
		end
		self.hatch_egg_bid_flag = nil
		self.hatch_id_flag = nil
	end
end

-- 打开魔导器解锁界面
function TreasureController:openTreasureHatchUnlockPanel( status ,data)
	if status == true then
		if not self.treasure_hatch_unlock_wnd then
			self.treasure_hatch_unlock_wnd = TreasureHatchUnlockPanel.New()
		end
		if self.treasure_hatch_unlock_wnd:isOpen() == false then
			self.treasure_hatch_unlock_wnd:open(data)
		end
	else
		if self.treasure_hatch_unlock_wnd then
			self.treasure_hatch_unlock_wnd:close()
			self.treasure_hatch_unlock_wnd = nil
		end
	end
end

-- 魔导器升级升星觉醒界面 index 1升级2升星3觉醒
function TreasureController:openTreasureUpWindow( status, data, index)
	if status == true then
		if not self.treasure_up_window then
			self.treasure_up_window = TreasureUpWindow.New()
		end
		if self.treasure_up_window:isOpen() == false then
			self.treasure_up_window:open(data,index)
		end
	else
		if self.treasure_up_window then
			self.treasure_up_window:close()
			if self.model.treasure_change_list and next(self.model.treasure_change_list) then
				self.model:setTreasureList(self.model.treasure_change_list)
			end
			self.treasure_up_window = nil
		end
	end
end

