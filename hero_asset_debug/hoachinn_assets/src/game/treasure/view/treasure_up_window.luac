TreasureUpWindow = TreasureUpWindow or BaseClass(BaseView)

local controller = TreasureController:getInstance()
local model = controller:getModel()

function TreasureUpWindow:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "treasure/treasure_up_window"

	-- self.res_list = {
	-- 	{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	-- }
	self.tab_list = {}
	self.tab_txt = {
		[1] = TI18N("语言_c_6081"),
		[2] = TI18N("语言_c_6082"),
		[3] = TI18N("语言_c_6083")
	}
	self.btn_index = 1
	self.click_hero = 0 --随机卡选中数量
	self.click_list = {} --随机卡选中忍者列表
	self.click_list2 = {} --随机卡选中忍魂列表
	self.click_list3 = {} --指定卡
	self.click_one_hero = 0 --指定卡选中数量
	self.base_item_list = {}
	self.node_item_list = {}
	self.eff_item_list = {}
	self.wake_item_list = {}
	self.cost_list = {}
	self.tip_list = {}
	self.left_item = nil
	self.right_item = nil
	self.exc_list = {}
	self.wake_cho_list = {}
	self.hero_index = false --是否是专属忍者页面
end

function TreasureUpWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end
	self.tip_panel = self.root_wnd:getChildByName("tip_panel")
	self.atr_panel = self.tip_panel:getChildByName("atr_panel")
	self.tip_panel:setVisible(false)
	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 

	self.image_bg_1 = self.main_container:getChildByName("image_bg_1")
	-- self.image_bg_2 = self.main_container:getChildByName("image_bg_2")
	self.title_panel = self.main_container:getChildByName("title_panel")
	self.Image_2 = self.title_panel:getChildByName("Image_2")
	self.win_title = self.title_panel:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_6112"))
	self.Image_2:setContentSize(self.win_title:getContentSize().width + 100, self.Image_2:getContentSize().height)
	self.close_btn = self.title_panel:getChildByName("close_btn")
	self.top_panel = self.main_container:getChildByName("top_panel")
	self.change_img = self.top_panel:getChildByName("change_img")
	self.top_1 = self.top_panel:getChildByName("top_1")
	self.name_bg_1 = self.top_1:getChildByName("name_bg_1")
	self.name_1 = self.top_1:getChildByName("name_1")
	setTextMaxWidth(self.name_1,180,-10)
	self.item_1 = self.top_1:getChildByName("item_1")
	self.top_2 = self.top_panel:getChildByName("top_2")
	self.name_bg_2 = self.top_2:getChildByName("name_bg_2")
	self.name_2 = self.top_2:getChildByName("name_2")
	setTextMaxWidth(self.name_2,180,-10)
	self.item_2 = self.top_2:getChildByName("item_2")
	self.attr_panel = self.main_container:getChildByName("attr_panel")
	self.base_panel = self.attr_panel:getChildByName("base_panel")
	self.base_txt = self.base_panel:getChildByName("base_txt")
	self.base_txt:setString(TI18N("语言_c_6071"))
	self.change_btn = self.base_panel:getChildByName("change_btn")
	self.change_btn:setPositionX(self.base_txt:getPositionX() + self.base_txt:getContentSize().width + 30)
	self.base_scroll = self.base_panel:getChildByName("base_scroll")
	self.base_scroll:setScrollBarEnabled(false)
	self.node_panel = self.attr_panel:getChildByName("node_panel")
	self.node_bg = self.node_panel:getChildByName("node_bg")
	self.node_txt = self.node_panel:getChildByName("node_txt")
	self.node_txt:setString(TI18N("语言_c_6076"))
	self.eff_panel = self.attr_panel:getChildByName("eff_panel")
	self.eff_bg = self.eff_panel:getChildByName("eff_bg")
	self.eff_txt = self.eff_panel:getChildByName("eff_txt")
	self.eff_txt:setString(TI18N("语言_c_6077"))
	self.wake_panel = self.attr_panel:getChildByName("wake_panel")
	self.wake_bg = self.wake_panel:getChildByName("wake_bg")
	self.wake_txt = self.wake_panel:getChildByName("wake_txt")
	self.wake_txt:setString(TI18N("语言_c_6078"))
	self.eff_tip = createRichLabel(24,cc.c3b(0x0e,0xa8,0x0e),cc.p(1,1),cc.p(630,180))
	self.eff_tip:setString(TI18N("语言_c_6093"))
	local function clickLinkCallBack( type, value )
		if type == "href" then
			self:setTipPanel()
			self.tip_panel:setVisible(true)
		end
	end
	self.eff_tip:addTouchLinkListener(clickLinkCallBack,{"href"})
	self.eff_panel:addChild(self.eff_tip)
	self.bot_panel = self.main_container:getChildByName("bot_panel")
	self.tab_btn = self.bot_panel:getChildByName("tab_btn")
	for i = 1, 3 do
		local tab = self.tab_btn:getChildByName("tab_btn_"..i)
		tab.normal_img = tab:getChildByName("normal_img")
		tab.select_img = tab:getChildByName("select_img")
		tab.txt = tab:getChildByName("label")
		tab.txt:setString(self.tab_txt[i])
		self.tab_list[i] = tab
	end
	self.cost_panel = self.bot_panel:getChildByName("cost_panel")
	self.cost_tip = self.cost_panel:getChildByName("cost_tip")
	self.cost_tip:setVisible(false)
	self.cost_txt = self.cost_panel:getChildByName("cost_txt")
	self.cost_txt:setString(TI18N("语言_c_6094"))
	self.item_scroll = self.cost_panel:getChildByName("item_scroll")
	self.up_btn = self.bot_panel:getChildByName("up_btn")
	self.up_txt = self.up_btn:getChildByName("label")
	self.Sprite_1 = self.main_container:getChildByName("Sprite_1")
end

function TreasureUpWindow:setData()
	local data1 = deepCopy(self.data)
	local data2 = deepCopy(self.data)
	self.data_star_info = Config.NinjaTreasureData.data_star_info[self.data.id]
	self.data_lv_info = Config.NinjaTreasureData.data_lv_info[self.data.quality]
	self.vo1 = TreasureVo.New()
	self.vo1:setUpData(data1) --左边
	if self.btn_index == 1 then
		if self.vo1.lev < self.data_star_info[self.vo1.star].lv_max then
			data2.lev = data2.lev + 1
		end
	elseif self.btn_index == 2 then
		if self.vo1.star < tableLen(self.data_star_info) then
			data2.star = data2.star + 1
		end
	elseif self.btn_index == 3 then
		data2.is_wakeup = 1
	end
	self.skill_cfg = Config.NinjaTreasureData.data_skill_info[self.data_star_info[data2.star].skill_id]
	self.vo2 = TreasureVo.New()
	self.vo2:setUpData(data2) -- 右边
	self:setTopPanel()
	self:setAttrPanel()
	local base_cfg = Config.NinjaTreasureData.data_base_info[self.vo1.id]
	local hatch_open_limit = Config.NinjaTreasureData.data_constant["hatch_open_limit"].val
	local ex_cfg = Config.NinjaTreasureData.data_awake_info[self.vo1.id]
	local is_wake = true
	if base_cfg and base_cfg.quality == 5 and hatch_open_limit == 1 then
		is_wake = false
	end
	if ex_cfg and is_wake then
		self.tab_list[3]:setVisible(true)
		if ex_cfg.limit[1][1] == "star" then
			if ex_cfg.limit[1][2] <= self.vo1.star then
				setChildUnEnabled(false,self.tab_list[3])
			else
				setChildUnEnabled(true,self.tab_list[3])
			end
		end
	else
		self.tab_list[3]:setVisible(false)
	end
end
function TreasureUpWindow:setTipPanel()
	if self.tip_title then else
		self.tip_title = createLabel(24,cc.c3b(0xf1,0xe2,0xc7),nil,0,0,TI18N("语言_c_6095"),self.atr_panel,nil,cc.p(0.5,1))
	end
	for key, value in pairs(self.tip_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.atr_panel) then
			self.atr_panel:removeChild(value)
		end
		value = nil
	end
	self.tip_list = {}
	local effect = {}
    local cfg = deepCopy(Config.NinjaTreasureData.data_star_info[self.vo1.id])
    table.sort(cfg,function(a,b) return a.star < b.star end)
    if cfg then
        for k, v in pairs(cfg) do
            if v.skill_txt and v.skill_txt ~= "" then
                local data = {}
				data.txt = v.skill_txt
				data.is_open = self.vo1.star == v.star
				data.skill_id = v.skill_id
				table.insert(effect,data)
            end
        end
    end
	local _width = 0
	local _height = 0
    for key, value in pairs(effect) do
		local star_res = PathTool.getResFrame("common", "common_90012")
		local txt_col = "#f1e2c7"
		if value.is_open then
			star_res = PathTool.getResFrame("common", "common_90011")
			txt_col = "#0ea80e"
		end
		local item = createRichLabel(20,txt_col,cc.p(0.5,1),cc.p(0,0),nil,nil,500)
		self.atr_panel:addChild(item)
		local eff_cfg = Config.NinjaTreasureData.data_skill_info[value.skill_id]
		-- local str = LangStringFormat(value.txt,eff_cfg.show_num[1])
		local list = {}
		for key, value in pairs(eff_cfg.show_num) do
			for k, v in pairs(value) do
				table.insert(list,v)
			end
		end
		local str = LangStringFormat(value.txt,list)
		local attr_str = string.format("<img src='%s' scale=0.5 /><div fontcolor=%s>%s</div>", star_res, txt_col, str)
		item:setString(attr_str)
		table.insert(self.tip_list,item)
		_width = math.max(item:getContentSize().width,_width)
		_height = _height + item:getContentSize().height + 10
	end
	self.atr_panel:setContentSize(cc.size(_width + 50,_height + 70))
	self.tip_title:setPosition(cc.p(self.atr_panel:getContentSize().width * 0.5,self.atr_panel:getContentSize().height - 10))
	for key, value in pairs(self.tip_list) do
		value:setPositionX(self.atr_panel:getContentSize().width * 0.5)
		value:setPositionY(_height)
		_height = _height - value:getContentSize().height-10
	end

end
function TreasureUpWindow:setTopPanel()
	-- if self.left_item then
	-- 	self.left_item:DeleteMe()
	-- end
	-- self.left_item = nil
	if not self.left_item then
		self.left_item = TreasureItem.new(false,1)
		self.item_1:addChild(self.left_item)
	end
	self.left_item:setData(self.vo1)
	-- if self.right_item then
	-- 	self.right_item:DeleteMe()
	-- end
	-- self.right_item = nil
	if not self.right_item then
		self.right_item = TreasureItem.new(false,1)
		self.item_2:addChild(self.right_item)
	end
	self.right_item:setData(self.vo2)
	local base_cfg = Config.NinjaTreasureData.data_base_info[self.vo2.id]
	local spine_name = "E31310"
	local action_name = "action"
	if base_cfg and base_cfg.quality >= 5 then
		spine_name = "E50104"
		action_name = "action1"
	end
	if not self.item_effect then
		self.item_effect = createEffectSpine(spine_name,cc.p(0, 0),cc.p(0.5, 0.5),true,action_name)
		self.item_effect:setScale(1.2, 1.2)
		self.item_2:addChild(self.item_effect,20)
	end
	local name_str = ""
	if self.vo1 and self.vo1.name then
		name_str = self.vo1.name
	end
	self.name_1:setString(name_str)
	self.name_bg_1:setContentSize(cc.size(self.name_1:getContentSize().width+70,51))
	local name_str_2 = ""
	if self.vo2 and self.vo2.name then
		name_str_2 = self.vo2.name
	end
	self.name_2:setString(name_str_2)
	self.name_bg_2:setContentSize(cc.size(self.name_2:getContentSize().width+70,51))
end
function TreasureUpWindow:setAttrPanel()
	local status = false
	local cfg = Config.NinjaTreasureData.data_base_info[self.vo1.id]
	if cfg and cfg.hero_id and cfg.hero_id ~= 0 then
		status = true
	end
	if self.btn_index == 1 then
		self.node_panel:setVisible(not self.hero_index)
		self.eff_panel:setVisible(false)
		self.wake_panel:setVisible(false)
		self.up_height = self:setNodePanel()
	elseif self.btn_index == 2 then
		self.node_panel:setVisible(false)
		if status then
			self.eff_panel:setVisible(self.hero_index)
		else
			self.eff_panel:setVisible(true)
		end
		self.wake_panel:setVisible(false)
		self.up_height = self:setEffPanel()
	elseif self.btn_index == 3 then
		self.node_panel:setVisible(false)
		self.eff_panel:setVisible(false)
		if status then
			self.wake_panel:setVisible(self.hero_index)
		else
			self.wake_panel:setVisible(true)
		end
		self.up_height = self:setWakePanel()
	end
	self.base_height = self:setBasePanel()
	self.attr_panel:setContentSize(cc.size(self.attr_panel:getContentSize().width,self.up_height + self.base_height + 30))
	self.attr_height = self.attr_panel:getContentSize().height
	self.base_panel:setPositionY(self.attr_height)
	self.node_panel:setPositionY(15)
	self.eff_panel:setPositionY(15)
	self.main_container:setContentSize(cc.size(self.main_container:getContentSize().width,self.top_panel:getContentSize().height+self.attr_height+self.bot_panel:getContentSize().height))
	self.image_bg_1:setContentSize(cc.size(self.main_container:getContentSize().width,self.top_panel:getContentSize().height+self.attr_height+self.bot_panel:getContentSize().height))
	self.image_bg_1:setPositionY(self.main_container:getContentSize().height*0.5)
	self.top_panel:setPositionY(self.main_container:getContentSize().height)
	self.title_panel:setPositionY(self.main_container:getContentSize().height - 10)
	self.attr_panel:setPositionY(self.bot_panel:getContentSize().height)
	self.bot_panel:setPositionY(0)
	self.Sprite_1:setPositionY(-24)
end
function TreasureUpWindow:setBasePanel()
	self.base_list = {}
	if self.hero_index then
		self.base_txt:setString(TI18N("语言_c_6720"))
	else
		self.base_txt:setString(TI18N("语言_c_6071"))
	end
	self.change_btn:setPositionX(self.base_txt:getPositionX() + self.base_txt:getContentSize().width + 30)
	local cfg = Config.NinjaTreasureData.data_base_info[self.vo1.id]
	if cfg and cfg.hero_id and cfg.hero_id ~= 0 then
		self.change_btn:setVisible(true)
	else
		self.change_btn:setVisible(false)
	end
	local list = self.hero_index and self.vo1.only_attr or self.vo1.attr
	for k, v in pairs(list) do
		local list = {}
		list[k] = {}
		table.insert(list[k],1,v)
		table.insert(self.base_list,list)
	end
	local list2 = self.hero_index and self.vo2.only_attr or self.vo2.attr
	for k, v in pairs(list2) do
		local is_have = false
		for key, value in pairs(self.base_list) do
			if value[k] then
				table.insert(value[k],2,v)
				is_have = true
			end
		end
		if not is_have then
			local list = {}
			list[k] = {}
			table.insert(list[k],1,0)
			table.insert(list[k],2,v)
			table.insert(self.base_list,list)
		end
	end
	if self.btn_index == 2 then
		local cfg = Config.NinjaTreasureData.data_star_info
		local list = {}
		list["lev_max"] = {}
		list["lev_max"][1] = cfg[self.vo1.id][self.vo1.star].lv_max
		list["lev_max"][2] = cfg[self.vo2.id][self.vo2.star].lv_max
		table.insert(self.base_list,list)
	end
	self.base_panel:setContentSize(cc.size(self.base_panel:getContentSize().width,120+40))
	-- self.base_panel:setContentSize(cc.size(self.base_panel:getContentSize().width,tableLen(self.base_list)*40+40))
	self.base_txt:setPositionY(self.base_panel:getContentSize().height)
	self.change_btn:setPositionY(self.base_panel:getContentSize().height - 18)
	self.base_scroll:setPositionY(self.base_panel:getContentSize().height - 35)
	for key, value in pairs(self.base_item_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.base_scroll) then
			self.base_scroll:removeChild(value)
		end
		value = nil
	end
	self.base_item_list = {}
	for k, v in pairs(self.base_list) do
		local item = nil
		for key, val in pairs(v) do
			item = self:setBaseItem(key,val,k)		
		end
		self.base_item_list[k] = item
		self.base_scroll:addChild(item)
	end
	local _scroll_h = 135
	if self.btn_index == 1 then
		_scroll_h = self.hero_index and _scroll_h + self.node_panel:getContentSize().height or _scroll_h
	elseif self.btn_index == 2 then
		_scroll_h = self.hero_index and _scroll_h or _scroll_h + self.node_panel:getContentSize().height
	elseif self.btn_index == 3 then
		_scroll_h = self.hero_index and _scroll_h or _scroll_h + self.node_panel:getContentSize().height
	end
	self.base_scroll:setContentSize(cc.size(self.base_scroll:getContentSize().width,_scroll_h))
	local _h = math.max(self.base_scroll:getContentSize().height,tableLen(self.base_item_list) * 40)
	if _h > self.base_scroll:getContentSize().height then
		self.base_scroll:setTouchEnabled(true)
	else
		self.base_scroll:setTouchEnabled(false)
	end
	self.base_scroll:setInnerContainerSize(cc.size(self.base_scroll:getContentSize().width,_h))
	for k, v in ipairs(self.base_item_list) do
		v:setPosition(cc.p(0,_h))
		_h = _h - 40
	end
	return self.base_panel:getContentSize().height
end
function TreasureUpWindow:setBaseItem(k,v,index)
	local item = ccui.Layout:create()
	item:setAnchorPoint(cc.p(0, 1))
	item:setContentSize(cc.size(self.base_panel:getContentSize().width, 40))
	local bg = createImage(item,PathTool.getResFrame("common", "common_1002"),10,0,cc.p(0,0),true,nil,true)
	bg:setContentSize(cc.size(self.base_panel:getContentSize().width-20, 40))
	if index%2 == 0 then
		bg:setVisible(true)
	else
		bg:setVisible(false)
	end
	local icon = PathTool.getAttrIconByStr(k)
	local res = PathTool.getResFrame("common", icon)
	local attr_icon = createSprite(res,40,20,item,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
	local str = ""
	if Config.AttrData.data_key_to_name[k] then
		str = string.format("%s", Config.AttrData.data_key_to_name[k])
	elseif k == "lev_max" then
		str = string.format("%s", TI18N("语言_c_6096"))
	end
	local txt_1 = createLabel(24,cc.c3b(0x7c,0x55,0x36),nil,70,20,str,item,nil,cc.p(0,0.5))
	local txt_2 = createLabel(24,cc.c3b(0x7c,0x55,0x36),nil,170,20,v[1],item,nil,cc.p(0,0.5))
	local up_icon = createSprite(PathTool.getResFrame("common", "common_1001"),326,20,item,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
	up_icon:setRotation(-90)
	local str2 = v[2]
	if self.btn_index == 2 then
		if self.vo1.lev == self.vo2.lev and self.vo1.star == self.vo2.star then
			str2 = TI18N("语言_c_6097")
		end
	end
	local txt_2 = createLabel(24,cc.c3b(0x0e,0xa8,0x0e),nil,480,20,str2,item,nil,cc.p(0.5,0.5))
	if k == "speed" then
		local checkBox = ccui.CheckBox:create(
			PathTool.getResFrame("common", "common_1044"),
			PathTool.getResFrame("common", "common_1044"),
			PathTool.getResFrame("common", "common_1043"),
			PathTool.getResFrame("common", "common_1044"),
			PathTool.getResFrame("common", "common_1043"),
			LOADTEXT_TYPE_PLIST
		)
		item:addChild(checkBox)
		checkBox:setPosition(cc.p(item:getContentSize().width - 50,20))
		checkBox:setSelected(self.vo1.is_speed == 0)
		checkBox:addEventListener(function ( sender,event_type )
			playButtonSound2()
			self:onCheckboxSelect(checkBox)
		end)
	end
	return item
end
function TreasureUpWindow:onCheckboxSelect(item)
	local status = item:isSelected()
	if status then
		controller:sender22315(self.vo1.id,0)
	else
		controller:sender22315(self.vo1.id,1)
	end
end
function TreasureUpWindow:setNodePanel()
	self.node_list = self.vo1.node_effect
	local _h = 0
	for key, value in pairs(self.node_item_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.node_panel) then
			self.node_panel:removeChild(value)
		end
		value = nil
	end
	if tableLen(self.node_list) == 0 then
		if not self.noNode then
			self.noNode = createLabel(25,cc.c3b(0x7c,0x55,0x36),nil,self.node_panel:getContentSize().width*0.5,(self.node_panel:getContentSize().height - 40)*0.5,TI18N("语言_c_6113"),self.node_panel,nil,cc.p(0.5,0.5))
		end
		self.node_bg:setContentSize(cc.size(self.node_panel:getContentSize().width-20,self.node_panel:getContentSize().height-40))
	else
		for k, v in pairs(self.node_list) do
			local item = self:setNodeItem(v)
			self.node_item_list[k] = item
			self.node_panel:addChild(item)
			_h = _h + item:getContentSize().height
		end
		_h = math.max(_h+40,180)
		self.node_panel:setContentSize(cc.size(self.node_panel:getContentSize().width,_h))
		self.node_bg:setContentSize(cc.size(self.node_panel:getContentSize().width-20,_h - 40))
		self.node_txt:setPositionY(self.node_panel:getContentSize().height)
		if _h > 180 then
			_h = _h - 40
			for k, v in pairs(self.node_item_list) do
				v:setPosition(cc.p(0,_h - v:getContentSize().height))
				_h = _h - v:getContentSize().height
			end
		else
			for k, v in pairs(self.node_item_list) do
				if (tableLen(self.node_item_list)*0.5) % 1 ~= 0 then
					local _h = (_h - 40)*0.5 - v:getContentSize().height*0.5
					if k > math.ceil(tableLen(self.node_item_list)*0.5) then
						v:setPosition(cc.p(0,_h - (tableLen(self.node_item_list)-k+1)*v:getContentSize().height))
					elseif k == math.ceil(tableLen(self.node_item_list)*0.5) then
						v:setPosition(cc.p(0,_h))
					else
						v:setPosition(cc.p(0,_h + (tableLen(self.node_item_list)-k-1)*v:getContentSize().height))
					end
				else
					local _h = (_h - 40)*0.5
					if k > tableLen(self.node_item_list)*0.5 then
						v:setPosition(cc.p(0,_h - v:getContentSize().height))
					else
						v:setPosition(cc.p(0,_h))
					end
				end	
			end
		end
	end
	return self.node_panel:getContentSize().height
end
function TreasureUpWindow:setNodeItem(data)
	local item = ccui.Layout:create()
	item:setAnchorPoint(cc.p(0, 0))
	local star_res = PathTool.getResFrame("common", "common_90012")
	local txt_col = "#7c5536"
	if data.is_open then
		star_res = PathTool.getResFrame("common", "common_90011")
		txt_col = "#0ea80e"
	end
	item.txt = createRichLabel(25,txt_col,cc.p(0,0),cc.p(50,0),nil,nil,580)
	item:addChild(item.txt)
	local attr_str = string.format("<img src='%s' scale=0.5 /><div fontcolor=%s>%s</div>", star_res, txt_col, data.txt)
	item.txt:setString(attr_str)
	item:setContentSize(cc.size(self.node_panel:getContentSize().width, item.txt:getContentSize().height))
	return item
end

function TreasureUpWindow:setEffPanel()
	self.eff_up = self.vo2.exclusive_effect
	for key, value in pairs(self.eff_item_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.eff_panel) then
			self.eff_panel:removeChild(value)
		end
		value = nil
	end
	for k, v in pairs(self.eff_up) do
		local item = self:setEffItem(v)
		self.eff_item_list[k] = item
		self.eff_panel:addChild(item)
		local _h = math.max(item:getContentSize().height+80,180)
		self.eff_panel:setContentSize(cc.size(self.eff_panel:getContentSize().width,_h))
		self.eff_txt:setPositionY(self.eff_panel:getContentSize().height)
		self.eff_bg:setContentSize(cc.size(self.eff_panel:getContentSize().width-20,self.eff_panel:getContentSize().height-40))
		item:setPosition(cc.p(self.eff_panel:getContentSize().width*0.5,self.eff_panel:getContentSize().height*0.5-20))
	end
	self.eff_tip:setPositionY(self.eff_panel:getContentSize().height)
	return self.eff_panel:getContentSize().height
end
function TreasureUpWindow:setEffItem(data)
	local item = ccui.Layout:create()
	item:setAnchorPoint(cc.p(0.5, 0.5))
	local star_res = PathTool.getResFrame("common", "common_90012")
	local txt_col = "#7c5536"
	if self.vo1.star == self.vo2.star then
		star_res = PathTool.getResFrame("common", "common_90011")
		txt_col = "#0ea80e"
	end
	item.txt = createRichLabel(25,txt_col,cc.p(0,0),cc.p(50,0),nil,nil,self.eff_panel:getContentSize().width-100)
	item:addChild(item.txt)
	local attr_str = string.format("<img src='%s' scale=0.5 /><div fontcolor=%s>%s</div>", star_res, txt_col, data.txt)
	item.txt:setString(attr_str)
	item:setContentSize(cc.size(self.eff_panel:getContentSize().width, item.txt:getContentSize().height))
	return item
end
function TreasureUpWindow:setWakePanel()
	self.wake_up = self.vo2.wakeup_effect
	for key, value in pairs(self.wake_item_list) do
		if value and not tolua.isnull(value) and not tolua.isnull(self.wake_panel) then
			self.wake_panel:removeChild(value)
		end
		value = nil
	end
	local item = self:setWakeItem(self.wake_up)
	self.wake_item_list[1] = item
	self.wake_panel:addChild(item)
	local _h = math.max(item:getContentSize().height+80,180)
	self.wake_panel:setContentSize(cc.size(self.wake_panel:getContentSize().width,_h))
	self.wake_txt:setPositionY(self.wake_panel:getContentSize().height)
	self.wake_bg:setContentSize(cc.size(self.wake_panel:getContentSize().width-20,self.wake_panel:getContentSize().height-40))
	item:setPosition(cc.p(self.wake_panel:getContentSize().width*0.5,self.wake_panel:getContentSize().height*0.5-20))
	return self.wake_panel:getContentSize().height
end
function TreasureUpWindow:setWakeItem(data)
	local item = ccui.Layout:create()
	item:setAnchorPoint(cc.p(0.5, 0.5))
	local star_res = PathTool.getResFrame("common", "common_90012")
	local txt_col = "#7c5536"
	if self.vo1.is_wakeup == 1 then
		star_res = PathTool.getResFrame("common", "common_90011")
		txt_col = "#0ea80e"
	end
	item.txt = createRichLabel(25,txt_col,cc.p(0,0),cc.p(50,0),nil,nil,self.eff_panel:getContentSize().width-100)
	item:addChild(item.txt)
	local attr_str = string.format("<img src='%s' scale=0.5 /><div fontcolor=%s>%s</div>", star_res, txt_col, data.txt)
	item.txt:setString(attr_str)
	item:setContentSize(cc.size(self.eff_panel:getContentSize().width, item.txt:getContentSize().height))
	return item
end


--点击事件
function TreasureUpWindow:startTimeTicket()
    if self.time_ticket == nil then
        self.time_idnex = 0
        local _callback = function()
            if self.onClickLevelUpBtn then
                self.is_click_btn = true
                -- playButtonSound2()
                self:onClickLevelUpBtn()
                self.time_idnex = self.time_idnex + 1
                if self.time_idnex > 5 then
                    self.time_idnex = 0
                end
            end
        end
        self.time_ticket = GlobalTimeTicket:getInstance():add(_callback, 5 / display.DEFAULT_FPS)
    end
end

function TreasureUpWindow:clearTimeTicket()
    if self.sequence_action then
        self.up_btn:stopActionByTag(1)
        -- self.level_up_btn:stopAction(self.sequence_action)
        self.sequence_action = nil
    end
    if self.time_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_ticket)
        self.time_ticket = nil
    end
end 

--升级或者进阶
function TreasureUpWindow:onClickLevelUpBtn()
    local function func()
			if self.btn_index ~= 3 then
				for k, v in pairs(self.cost_list) do
					if tableLen(v) <= 3 then
						local have_num = BackpackController:getInstance():getModel():getItemNumByBid(v[1]) or 0
						if have_num < v[2] then
							local item_config = Config.ItemData.data_get_data(v[1])
							BackpackController:getInstance():openTipsSource(true, item_config)
							return
						end
					else
						if self.click_hero < v[3] then
							message(TI18N("语言_c_6098"))
							return
						end						
					end
				end
			end
			if self.btn_index == 1 then
				local base_cfg = Config.NinjaTreasureData.data_base_info[self.data.id]
				local data_cfg = Config.NinjaTreasureData.data_lv_info[base_cfg.quality]
				if self.data.lev < tableLen(data_cfg) then
					controller:sender22309(self.data.id)
				else
					message(TI18N("语言_c_6176"))
				end
			elseif self.btn_index == 2 then
				if BattleDramaController:getInstance():getModel():checkDispatchIsUp(self.data.id) then
					local str = TI18N("语言_spr_det_1_14")
					CommonAlert.show( str, TI18N("语言_c_63"), function()
						BattleDramaController:getInstance():openBattleDramaDispatchWindow(true)
						controller:openTreasureUpWindow(false)
					end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
					return
				end
				local star_cfg = Config.NinjaTreasureData.data_star_info[self.data.id]
				if self.data.star < tableLen(star_cfg) then
					local cfg = star_cfg[self.data.star]
					if next(cfg.cost_card_mine) then
						if self.click_one_hero < cfg.cost_card_mine[1][3] then
							message(TI18N("语言_c_6098"))
							return
						end
					end
					if tableLen(cfg.limit) ~= 0 then
						local lev = HeroController:getInstance():getModel().resonate_cystal_lev
						if lev >= cfg.limit[1][2] then
							controller:sender22310(self.data.id,self.click_list,self.click_list2,self.click_list3)	
						else
							message(string.format(TI18N("语言_c_6099"),cfg.limit[1][2]))
						end
					else
						controller:sender22310(self.data.id,self.click_list,self.click_list2,self.click_list3)
					end
				else
					message(TI18N("语言_c_6177"))
				end
			elseif self.btn_index == 3 then
				local ex_cfg = Config.NinjaTreasureData.data_awake_info[self.vo1.id]
				if ex_cfg then
					if next(ex_cfg.cost_card_mine) then
						if self.click_one_hero < ex_cfg.cost_card_mine[1][3] then
							message(TI18N("语言_c_6098"))
							return
						end
					end
					if ex_cfg.limit[1][1] == "star" then
						if ex_cfg.limit[1][2] <= self.vo1.star then
							if self.data.is_wakeup == 1 then
								message(TI18N("语言_c_6084"))
								return
							end
							if next(self.wake_cho_list) then
								local can_up = true
								for a, b in pairs(self.cost_list) do
									if b.type == "sp" then
										local need_num = b[2]
										if self.wake_cho_list[a] then
											local choose_num = 0
											for c, d in pairs(self.wake_cho_list[a]) do
												choose_num = choose_num + d["item_num"]
											end
											if choose_num < need_num then
												can_up = false
												break
											end
										else
											can_up = false
											break
										end
									end
								end
								if can_up then
									local wake_cho_list = {}
									for k, v in pairs(self.wake_cho_list) do
										for j, w in pairs(v) do
											table.insert( wake_cho_list,w)
										end
									end
									controller:sender22311(self.vo1.id,wake_cho_list,self.click_list3)
								else
									message(TI18N("语言_c_3021"))
								end
							else
								message(TI18N("语言_c_3021"))
							end
						else
							message(LangStringFormat(TI18N("语言_c_6100"),ex_cfg.limit[1][2]))
						end
						return
					end
				end
				if self.data.is_wakeup == 1 then
					message(TI18N("语言_c_6084"))
					return
				end
				controller:openTreasureWekeChoWindow(true,self.data.id)
			end
        end
		if self.btn_index ~= 1 then
			AudioManager:getInstance():playEffect(AudioManager.AUDIO_TYPE.COMMON, "c_equipment_forging")
			playEffectOnce(PathTool.getEffectRes(269), 326, 126, self.top_panel,func, nil, nil, nil, PlayerAction.action, 1,nil,2)
		else
			func()
		end
end
function TreasureUpWindow:touchChange()
	if self.hero_index then
		self.hero_index = false
	else
		self.hero_index = true
	end
	self:setAttrPanel()
	-- self:clickBtn(self.btn_index)
end
function TreasureUpWindow:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openTreasureUpWindow(false)
    end,true,3)
    
	registerButtonEventListener(self.background, function ( )
		controller:openTreasureUpWindow(false)
	end,false,3)
	registerButtonEventListener(self.tip_panel, function ( )
		self.tip_panel:setVisible(false)
	end,false,3)
	registerButtonEventListener(self.change_btn, function ( )
		self:touchChange()
	end,true,2)
	self.up_btn:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.began then
            self.is_click_btn = false --标志只点一次btn
			if self.btn_index == 1 then
				local sequence_action = cc.Sequence:create(cc.DelayTime:create(0.3), cc.CallFunc:create(function() 
					self:startTimeTicket()
				end))
				self.sequence_action = self.up_btn:runAction(sequence_action)
				self.sequence_action:setTag(1)
			end
        elseif event_type == ccui.TouchEventType.moved then

        elseif event_type == ccui.TouchEventType.canceled then
            self:clearTimeTicket()
        elseif event_type == ccui.TouchEventType.ended then
            self:clearTimeTicket()
            if not self.is_click_btn then
                playButtonSound2()
                self:onClickLevelUpBtn()
            end
        end
    end)

	-- registerButtonEventListener(self.up_btn, function ( )
        
	-- end,true,3)

	for k, v in pairs(self.tab_list) do
		registerButtonEventListener(v, function ( )
			self:clickBtn(k)
		end,true,3)
	end

	if not self.one_treasure_data then
        self.one_treasure_data = GlobalEvent:getInstance():Bind(TreasureEvent.One_Treasure_data_Event, function (data)
            if data.item_bid == self.vo1.id then
				local vo = TreasureVo.New()
				vo:setUpData(data)
				self.data = vo
				self:setData()
				self:clickBtn(self.btn_index)
			end
        end)
	end

	if not self.treasure_atr_event then
        self.treasure_atr_event = GlobalEvent:getInstance():Bind(TreasureEvent.Treasure_Atr_Event, function (data)
			for key, value in pairs(data.annals_list) do
				if value.item_bid == self.vo1.id then
					local vo = TreasureVo.New()
					vo:setUpData(value)
					self.data = vo
					self:setData()
					self:clickBtn(self.btn_index)
				end
			end
        end)
	end

	if not self.treasure_click_hero_data then
        self.treasure_click_hero_data = GlobalEvent:getInstance():Bind(TreasureEvent.Treasure_Click_Hero_Event, function (data)
			if not data then return end
            self.click_hero = 0
			self.click_list = {} --忍者
			self.click_list2 = {} --忍魂
			for key, value in pairs(data.dic_select_list ) do
				self.click_hero = self.click_hero + 1
				local list = {}
				if key > 0 then
					list.id =key
					table.insert(self.click_list,list)
				else
					if value.good_vo then
						local status = true
						for k, v in pairs(self.click_list2) do
							if v.item_id == value.good_vo.base_id then
								status = false
								v.num = v.num + 1
							end
						end
						if status then
							list.item_id = value.good_vo.base_id
							list.num = 1
							table.insert(self.click_list2,list)
						end
					end
				end
			end
        end)
	end
	
	if not self.treasure_click_one_hero_data then
        self.treasure_click_one_hero_data = GlobalEvent:getInstance():Bind(TreasureEvent.Treasure_Click_One_Hero_Event, function (data)
			if not data then return end
            self.click_one_hero = 0
			self.click_list3 = {} --指定卡
			for key, value in pairs(data.dic_select_list ) do
				self.click_one_hero = self.click_one_hero + 1
				local list = {}
				if key > 0 then
					list.partner_id =key
					table.insert(self.click_list3,list)
				end
			end
        end)
	end


	if not self.open_treasure_list then
        self.open_treasure_list = GlobalEvent:getInstance():Bind(TreasureEvent.Open_Treasure_List_Event, function (data)
            self:updateRed()
        end)
    end
	if not self.treasure_wake_cho_data then
        self.treasure_wake_cho_data = GlobalEvent:getInstance():Bind(TreasureEvent.Treasure_Wake_Cho_Event, function (data)
            self.wake_cho_list[data.quality] = data.list
        end)
	end

	-- -- 道具数量更新
    -- self:addGlobalEvent(BackpackEvent.ADD_GOODS,function(bag_code, data_list)
    --     self:refreshExchangeItemNum(bag_code,data_list)
    -- end)
    -- self:addGlobalEvent(BackpackEvent.DELETE_GOODS,function(bag_code, data_list)
    --     self:refreshExchangeItemNum(bag_code,data_list)
    -- end)
    -- self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM,function(bag_code, data_list)
    --     self:refreshExchangeItemNum(bag_code,data_list)
    -- end)
end

function TreasureUpWindow:updateRed()
	for key, value in pairs(self.tab_list) do
		if key == 1 then
			addRedPointToNodeByStatus(value,model:getCanUpLevForIdRed(self.vo1),15,10)
		elseif key == 2 then
			addRedPointToNodeByStatus(value,model:getCanUpstarForIdRed(self.vo1),15,10)
		elseif key == 3 then
			addRedPointToNodeByStatus(value,model:getCanWakeUpForIdRed(self.vo1),15,10)
		end
	end
	-- addRedPointToNodeByStatus(self.tab_list[self.btn_index],false)
end

function TreasureUpWindow:clickBtn(index)
	self.is_max_tip = false	
	self.cost_list = {}
	self.click_hero = 0
	self.click_list = {} --忍者
	self.click_list2 = {} --忍魂
	if index == 1 then -- 升级
		self.btn_index = 1
		self.up_txt:setString(TI18N("语言_c_6081"))
		local star_cfg = Config.NinjaTreasureData.data_star_info[self.vo1.id][self.vo1.star]
		local lev_cfg = Config.NinjaTreasureData.data_lv_info[self.vo1.quality]
		local cfg = lev_cfg[self.vo1.lev]
		if self.vo1.lev >= tableLen(lev_cfg) or self.vo1.lev >= star_cfg.lv_max then
			self.is_max_tip = true
		else
			for key, value in pairs(cfg.need) do
				table.insert(self.cost_list,value)
			end
		end
	elseif index == 2 then -- 升星
		self.btn_index = 2
		self.up_txt:setString(TI18N("语言_c_6082"))
		local star_cfg = Config.NinjaTreasureData.data_star_info[self.vo1.id]
		local cfg = star_cfg[self.vo1.star]
		if self.vo1.star >= tableLen(star_cfg) then
			self.is_max_tip = true
		else
			for key, value in pairs(cfg.cost) do
				table.insert(self.cost_list,value)
			end
			table.insert(self.cost_list,cfg.cost_card[1])
			if next(cfg.cost_card_mine) then
				for key, value in pairs(cfg.cost_card_mine) do
					local cost_obj = deepCopy(value)
					cost_obj.type = "hero_id"
					table.insert(self.cost_list,cost_obj)
				end
			end
		end
	elseif index == 3 then -- 觉醒
		local ex_cfg = Config.NinjaTreasureData.data_awake_info[self.vo1.id]
		if ex_cfg then
			if ex_cfg.limit[1][1] == "star" then
				if ex_cfg.limit[1][2] <= self.vo1.star then
					if self.vo1.is_wakeup == 1 then
						self.is_max_tip = true
					else
						for key, value in pairs(ex_cfg.cost_item) do
							table.insert(self.cost_list,value)
						end
						for key, value in pairs(ex_cfg.cost_card_mine) do
							local cost_obj = deepCopy(value)
							cost_obj.type = "hero_id"
							table.insert(self.cost_list,cost_obj)
						end
						for key, value in pairs(ex_cfg.cost) do
							local cost_obj = deepCopy(value)
							cost_obj.type = "sp"
							cost_obj.cost_item = ex_cfg.cost_item
							table.insert(self.cost_list,cost_obj)
						end
						-- table.insert(self.cost_list,ex_cfg.cost)
					end
				else
					message(LangStringFormat(TI18N("语言_c_6100"),ex_cfg.limit[1][2]))
					return
				end
			end
			self.btn_index = 3
			self.up_txt:setString(TI18N("语言_c_6083"))
		end
	end
	for key, value in pairs(self.tab_list) do
		if key == index then
			value.normal_img:setVisible(false)
			value.select_img:setVisible(true)
		else
			value.normal_img:setVisible(true)
			value.select_img:setVisible(false)
		end
	end
	self:setData()
	self:updateRed()
	if self.is_max_tip then
		self.cost_txt:setVisible(false)
		self.cost_tip:setVisible(true)
		if index == 1 then
			self.cost_tip:setString(TI18N("语言_c_6101"))
		elseif index == 2 then
			self.cost_tip:setString(TI18N("语言_c_6102"))
		elseif index == 3 then
			self.cost_tip:setString(TI18N("语言_c_6084"))
		end
		if self.cost_view then
			self.cost_view:setVisible(false)
		end
	else
		self.cost_txt:setVisible(true)
		self.cost_tip:setVisible(false)
		if self.cost_view == nil then
			local scroll_view_size = self.item_scroll:getContentSize()
			local setting = {
				item_class = TreasureUpItem,      -- 单元类
				start_x = 0,                  -- 第一个单元的X起点
				space_x = 20,                    -- x方向的间隔
				start_y = 0,                    -- 第一个单元的Y起点
				space_y = 0,                   -- y方向的间隔
				item_width = 96,               -- 单元的尺寸width
				item_height = 96,              -- 单元的尺寸height
				row = 1,                        -- 行数，作用于水平滚动类型  
			}
			self.cost_view = CommonScrollViewLayout.new(self.item_scroll, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
		end
		if self.cost_view and not tolua.isnull(self.cost_view) then
			self.cost_view:setVisible(true)
			self.cost_view:setData(self.cost_list)
		end
	end
end
function TreasureUpWindow:openRootWnd( data, index)
	self.btn_index = index
	self.data = data
	self:setData()
	self:clickBtn(index)
end

function TreasureUpWindow:close_callback(  )
	if self.cost_view then 
        self.cost_view:DeleteMe()
        self.cost_view = nil
    end
	if self.one_treasure_data then
        GlobalEvent:getInstance():UnBind(self.one_treasure_data)
        self.one_treasure_data = nil
    end
	if self.treasure_atr_event then
        GlobalEvent:getInstance():UnBind(self.treasure_atr_event)
        self.treasure_atr_event = nil
    end
	if self.treasure_click_hero_data then
        GlobalEvent:getInstance():UnBind(self.treasure_click_hero_data)
        self.treasure_click_hero_data = nil
    end
	if self.treasure_click_one_hero_data then
        GlobalEvent:getInstance():UnBind(self.treasure_click_one_hero_data)
        self.treasure_click_one_hero_data = nil
    end
	if self.open_treasure_list then
        GlobalEvent:getInstance():UnBind(self.open_treasure_list)
        self.open_treasure_list = nil
    end
	if self.treasure_wake_cho_data then
        GlobalEvent:getInstance():UnBind(self.treasure_wake_cho_data)
        self.treasure_wake_cho_data = nil
    end
	if self.left_item then
		self.left_item:DeleteMe()
		self.left_item = nil
	end
	
	if self.right_item then
		self.right_item:DeleteMe()
		self.right_item = nil
	end

	if self.item_effect then
        self.item_effect:clearTracks()
        self.item_effect:removeFromParent()
        self.item_effect = nil
    end
	
    -- if self.treasure_attr_event then
    --     GlobalEvent:getInstance():UnBind(self.treasure_attr_event)
    --     self.treasure_attr_event = nil
    -- end
end

--------------------------@ item
TreasureUpItem = class("TreasureUpItem", function()
    return ccui.Widget:create()
end)

function TreasureUpItem:ctor()
	self:configUI()
	self:registerEvent()
end

function TreasureUpItem:configUI(  )
	self.size = cc.size(96, 96)
	self.wake_cho_list = {}
	self:setTouchEnabled(false)
    self:setContentSize(self.size)
end

function TreasureUpItem:registerEvent(  )
	--添加英雄选择返回事件
	if self.update_hero_select_event == nil then
		self.update_hero_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event, function(data)
			if self.data and self.data[1] == 0 and data.bid == 0 then
				self.lock_cost_hero_data = data
				self:updateSelectHeroInfo()
			elseif self.data.type == "hero_id" and data.bid ~= 0 then
				self.lock_one_cost_hero_data = data
				self:updateSelectOneHeroInfo()
			end
		end)
	end

	if not self.treasure_wake_cho_data then
        self.treasure_wake_cho_data = GlobalEvent:getInstance():Bind(TreasureEvent.Treasure_Wake_Cho_Event, function (data)
			if not self.wake_cho_list then
				self.wake_cho_list = {}
			end
            self.wake_cho_list[data.quality] = data.list
			local choose_num = {}
			choose_num[data.quality] = 0
			for k, v in pairs(self.wake_cho_list[data.quality]) do
				if self.data and data.quality == self.data[1] then
					choose_num[data.quality] = choose_num[data.quality] + v.item_num
				end
			end
			if self.trea_num then
				if self.data and data.quality == self.data[1] then
					self.trea_num:setString(string.format("%s/%s",choose_num[data.quality],self.data[2]))
					self.trea_num:setTextColor(cc.c3b(0xff,0xff,0xff))
				end
			end
        end)
	end
end

function TreasureUpItem:setData( data )	
	self.lock_cost_hero_data = {}  -- 解锁消耗的英雄数据
	self.lock_one_cost_hero_data = {}
	self.data = data
	if self.item then 
		self.item:DeleteMe()
	end
	self.item = nil
	if self.hero_item then 
		self.hero_item:DeleteMe()
	end
	self.hero_item = nil
	if self.hero_one_item then 
		self.hero_one_item:DeleteMe()
	end
	self.hero_one_item = nil
	if self.trea_item then 
		self.trea_item:DeleteMe()
	end
	self.trea_item = nil	
	self.trea_num = nil
	if data.type and data.type == "sp" then
		if not self.trea_item then
			self.trea_item = TreasureItem.new()
			self:addChild(self.trea_item)
		end
		self.trea_item:setSwallowTouches(false)
		self.trea_item:setScale(0.80)
		self.trea_item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
		self.trea_item:setData({data[1],0,data.type})
		self.trea_item:setRandImg()
		if not self.trea_num then
			self.trea_num = createLabel(24,cc.c3b(0xff,0xff,0xff),Config.ColorData.data_color4[9],self.trea_item:getContentSize().width*0.5,0,"",self.trea_item,2,cc.p(0.5,1))
		end
		self.trea_num:setTextColor(cc.c3b(0xff,0x00,0x00))
		self.trea_num:setString(string.format("%s/%s",0,data[2]))
		self.trea_item:addCallBack(function() 
			controller:openTreasureWekeChoWindow(true,{data[1],data[2],self.data.cost_item})
		end)
	elseif data.type and data.type == "hero_id" then
		if not self.hero_one_item then
			self.hero_one_item = HeroExhibitionItem.new(0.8,true)
			self:addChild(self.hero_one_item)
		end
		self.hero_one_item:setSwallowTouches(false)
		self.hero_one_item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
		local base_config = Config.PartnerData.data_partner_base[data[1]]
		if tableLen(self.lock_one_cost_hero_data) == 0 then
			self.lock_one_cost_hero_data = {}
			self.lock_one_cost_hero_data.bid = data[1]
			self.lock_one_cost_hero_data.camp_type = base_config.camp_type
			self.lock_one_cost_hero_data.star = data[2] or 0
			self.lock_one_cost_hero_data.count = data[3] or 0
			self.lock_one_cost_hero_data.lev = string.format("%s/%s", 0, data[3] or 0)
			self.lock_one_cost_hero_data.dic_select_list = {}
		end
		local hero_list_num = self:getOneHeroList()
		if hero_list_num >= data[3] then
			self.hero_one_item:showRedPoint(true)
		else 
			self.hero_one_item:showRedPoint(false)
		end
		self.hero_one_item:setData(self.lock_one_cost_hero_data)
		self.hero_one_item:setLevPos(cc.p(0.5,1),cc.p(self.hero_one_item:getContentSize().width*0.5,0))
		self.hero_one_item:setHeadUnEnabled(true)
		self.hero_one_item:addCallBack(function() self:_onClickOneItemData() end)
	else
		if tableLen(data) == 3 then
			if Config.ItemData.data_get_data(data[1]) and Config.ItemData.data_get_data(data[1]).sub_type ~= BackPackConst.item_tab_type.TREASURE then
				if not self.item then
					self.item = BackPackItem.new()
				end
				self.item:setDefaultTip()
				self.item:setSwallowTouches(false)
				self.item:setScale(0.80)
				self.item:setData(data)
				self.item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
				self:addChild(self.item)
				self.item:setNumLabel(false)
			else
				if not self.item then
					self.item = TreasureItem.new()
				end
				self.item:setSwallowTouches(false)
				self.item:setScale(0.80)
				self.item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
				self:addChild(self.item)
				if tableLen(data) == 1 then
					self.need_item:setData({data[1][1],0})
					self.need_item:setRandImg()
				else
					self.item:setData(data)
					self.item:setNum(0)
				end
			end
			local num_txt = createLabel(24,cc.c3b(0xff,0xff,0xff),Config.ColorData.data_color4[9],self.item:getContentSize().width*0.5,0,"",self.item,2,cc.p(0.5,1))
			local have_num = BackpackController:getInstance():getModel():getItemNumByBid(data[1])
			if have_num >= data[2] then
				num_txt:setTextColor(cc.c3b(0xff,0xff,0xff))
			else
				num_txt:setTextColor(cc.c3b(0xff,0x00,0x00))
			end
			num_txt:setString(string.format("%s/%s",MoneyTool.GetMoneyString(have_num,false),MoneyTool.GetMoneyString(data[2],false)))
		elseif tableLen(data) == 2 then
			if not self.trea_item then
				self.trea_item = TreasureItem.new()
				self:addChild(self.trea_item)
			end
			self.trea_item:setSwallowTouches(false)
			self.trea_item:setScale(0.80)
			self.trea_item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
			self.trea_item:setData({data[1][1],0})
			self.trea_item:setRandImg()
			if not self.trea_num then
				self.trea_num = createLabel(24,cc.c3b(0xff,0xff,0xff),Config.ColorData.data_color4[9],self.trea_item:getContentSize().width*0.5,0,"",self.trea_item,2,cc.p(0.5,1))
			end
			self.trea_num:setTextColor(cc.c3b(0xff,0x00,0x00))
			self.trea_num:setString(string.format("%s/%s",0,data[1][2]))
			self.trea_item:addCallBack(function() 
				controller:openTreasureWekeChoWindow(true,data[1])
			end)
		else
			if not self.hero_item then
				self.hero_item = HeroExhibitionItem.new(0.8,true)
			end
			self.hero_item:setSwallowTouches(false)
			self.hero_item:setPosition(cc.p(self.size.width*0.5,self.size.height*0.5))
			self:addChild(self.hero_item)
			if tableLen(self.lock_cost_hero_data) == 0 then
				self.lock_cost_hero_data = {}
				self.lock_cost_hero_data.bid = 0
				self.lock_cost_hero_data.camp_type = data[1]
				self.lock_cost_hero_data.star = data[2] or 0
				self.lock_cost_hero_data.count = data[3] or 0
				self.lock_cost_hero_data.lev = string.format("%s/%s", 0, data[3] or 0)
				self.lock_cost_hero_data.dic_select_list = {}
			end
			local hero_list_num = self:getHeroList()
			if self.lock_cost_hero_data.bid == 0 then
				--随机卡的头像id
				local default_head_id = HeroController:getInstance():getModel():getRandomHeroHeadByQuality(self.lock_cost_hero_data.star)
				self.hero_item:setData(self.lock_cost_hero_data)
				self.hero_item:setDefaultHead(default_head_id)
				if hero_list_num >= data[3] then
					self.hero_item:showRedPoint(true)
				else 
					self.hero_item:showRedPoint(false)
				end
			else
				self.hero_item:showRedPoint(false)
				self.hero_item:setData(self.lock_cost_hero_data)
			end
			self.hero_item:setLevPos(cc.p(0.5,1),cc.p(self.hero_item:getContentSize().width*0.5,0))
			-- self.hero_item:setLevOutline(cc.c3b(0xff,0xff,0xff),1)
			self.hero_item:setHeadUnEnabled(true)
			self.hero_item:addCallBack(function() self:_onClickItemData() end)
			
		end
	end
end

--点击材料数据
function TreasureUpItem:_onClickItemData()
	if not self.lock_cost_hero_data then return end
    --标志点击了那个
    self.lock_cost_hero_data.is_select = true
    self.lock_cost_hero_data.is_ignore_hero_hun = false
	HeroController:getInstance():openHeroUpgradeStarSelectPanel(true, deepCopy(self.lock_cost_hero_data), {}, HeroConst.SelectHeroType.eTreasure)
end
--点击材料数据
function TreasureUpItem:_onClickOneItemData()
	if not self.lock_one_cost_hero_data then return end
    --标志点击了那个
    self.lock_one_cost_hero_data.is_select = true
    self.lock_one_cost_hero_data.is_ignore_hero_hun = false
	HeroController:getInstance():openHeroUpgradeStarSelectPanel(true, deepCopy(self.lock_one_cost_hero_data), {}, HeroConst.SelectHeroType.eTreasure)
end

function TreasureUpItem:getHeroList(dic_other_selected)
	local hero_list = {}
	local select_data = deepCopy(self.lock_cost_hero_data)
    --别人已选
    local dic_other_selected = dic_other_selected or {}
    --自己已选
    local dic_select = select_data.dic_select_list
    --过滤
    local hero_array =  HeroController:getInstance():getModel():getAllHeroArray()
    local size = hero_array:GetSize()
	if select_data.bid == 0 then
		--表示选择同阵营的随机卡
		for j=1, size do
			local hero_vo = hero_array:Get(j-1)
			if hero_vo  and not hero_vo:isResonateHero() and (select_data.camp_type == 0 or hero_vo.camp_type == select_data.camp_type) and (hero_vo.camp_type ~= HeroConst.CampType.eAlien) and --默认排除异能英雄
				hero_vo.star == select_data.star and
				dic_other_selected[hero_vo.id] == nil then
				table.insert(hero_list, hero_vo)
			end
		end
	end
	local hero_list_num = #hero_list
	return hero_list_num
end

function TreasureUpItem:getOneHeroList(dic_other_selected)
	local hero_list = {}
	local select_data = deepCopy(self.lock_one_cost_hero_data)
    --别人已选
    local dic_other_selected = dic_other_selected or {}
    --自己已选
    local dic_select = select_data.dic_select_list
    --过滤
    local hero_array =  HeroController:getInstance():getModel():getAllHeroArray()
    local size = hero_array:GetSize()
	--表示指定卡
	for j=1, size do
		local hero_vo = hero_array:Get(j-1)
		if hero_vo and not hero_vo:isResonateHero() and select_data.bid == hero_vo.bid and select_data.star == hero_vo.star and --默认排除异能英雄
			dic_other_selected[hero_vo.id] == nil then
			table.insert(hero_list, hero_vo)
		end
	end
	local hero_list_num = #hero_list
	return hero_list_num
end

-- 刷新选择英雄数据
function TreasureUpItem:updateSelectHeroInfo()
	local count = 0
	for k,v in pairs(self.lock_cost_hero_data.dic_select_list) do
		count = count + 1
	end
	self.lock_cost_hero_data.lev = string.format("%s/%s", count, self.lock_cost_hero_data.count)
	if self.hero_item then
		self.hero_item:setLev(self.lock_cost_hero_data.lev)
		GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Click_Hero_Event,self.lock_cost_hero_data)
		if count > 0 then
			self.hero_item:setHeadUnEnabled(false)
		else
			self.hero_item:setHeadUnEnabled(true)
		end
		if count >=  self.lock_cost_hero_data.count then
			self.hero_item:showRedPoint(false)
		else
			local hero_list_num = self:getHeroList()
			if hero_list_num - count > 0 then
				self.hero_item:showRedPoint(true)
			else 
				self.hero_item:showRedPoint(false)
			end
		end
	end
end


-- 刷新选择英雄数据
function TreasureUpItem:updateSelectOneHeroInfo()
	local count = 0
	for k,v in pairs(self.lock_one_cost_hero_data.dic_select_list) do
		count = count + 1
	end
	self.lock_one_cost_hero_data.lev = string.format("%s/%s", count, self.lock_one_cost_hero_data.count)
	if self.hero_one_item then
		self.hero_one_item:setLev(self.lock_one_cost_hero_data.lev)
		GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Click_One_Hero_Event,self.lock_one_cost_hero_data)
		if count > 0 then
			self.hero_one_item:setHeadUnEnabled(false)
		else
			self.hero_one_item:setHeadUnEnabled(true)
		end
		if count >=  self.lock_one_cost_hero_data.count then
			self.hero_one_item:showRedPoint(false)
		else
			local hero_list_num = self:getOneHeroList()
			if hero_list_num - count > 0 then
				self.hero_one_item:showRedPoint(true)
			else 
				self.hero_one_item:showRedPoint(false)
			end
		end
	end
end

function TreasureUpItem:DeleteMe(  )
	if self.item then 
		self.item:DeleteMe()
	end
	self.item = nil
	if self.hero_item then 
		self.hero_item:DeleteMe()
	end
	self.hero_item = nil
	
	if self.hero_one_item then 
		self.hero_one_item:DeleteMe()
	end
	self.hero_one_item = nil
    if self.update_hero_select_event then
        GlobalEvent:getInstance():UnBind(self.update_hero_select_event)
        self.update_hero_select_event = nil
    end
	
	if self.treasure_wake_cho_data then
        GlobalEvent:getInstance():UnBind(self.treasure_wake_cho_data)
        self.treasure_wake_cho_data = nil
    end
end