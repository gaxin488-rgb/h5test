    self.research_bar = self.schedule_bg:getChildByName("research_bar")
    self.research_bar:setScale9Enabled(true)
    self.remain_bg = self.research:getChildByName("remain_bg")
    self.remain_txt = self.remain_bg:getChildByName("remain_txt")
    self.remain_txt:setString(TI18N("语言_c_6350"))
