    self.treasure_bg:addChild(self.treasure_spine)
    self.treasure_img = self.treasure_panel:getChildByName("treasure_img")
    self.treasure_spine_1 = createEffectSpine("E24322",cc.p(100,100),cc.p(0.5,0.5),true,PlayerAction.action)
    self.treasure_img:addChild(self.treasure_spine_1,9)
    self.reward_btn = self.treasure_panel:getChildByName("reward_btn")
    self.reward_txt = self.treasure_panel:getChildByName("reward_txt")
    self.reward_txt:setString(TI18N("语言_c_6559"))
    setTextMaxWidth(self.reward_txt,100,-10)
    self.right_btn = self.treasure_panel:getChildByName("right_btn")
    self.left_btn = self.treasure_panel:getChildByName("left_btn")
    self.treasure_name = self.treasure_panel:getChildByName("name")
    self.star_node = self.treasure_panel:getChildByName("star_node")
    self.treasure_tips = self.treasure_panel:getChildByName("treasure_tips")
    self.constitute_bg = self.treasure_panel:getChildByName("constitute_bg")
    self.constitute_tip = self.constitute_bg:getChildByName("constitute_tip")
    self.constitute_tip:setChangeScaleOffWidth(-1000)
    setTextMaxWidth(self.constitute_tip,150,-10)
    self.constitute_bg:setVisible(false)
    
