    self.rank_scroll = self.constitute:getChildByName("rank_scroll")
    self.rank_scroll:setScrollBarEnabled(false)
    self.rank_container = self.rank_scroll:getInnerContainer()
    self.rank_click = createSprite(PathTool.getResFrame("ninja_treasure/treasure_research","treasure_research_17"), 73,111,self.rank_container,cc.p(0.5,0.5))
    self.rank_click:setZOrder(99)
    self.time_txt = createRichLabel(20,cc.c3b(0xfb,0xf4,0xe4),cc.p(0.5,0.5),cc.p(182,665),nil,nil,310)
    self.constitute:addChild(self.time_txt)---解锁倒计时
    self.rank_tip_bg = self.constitute:getChildByName("rank_tip_bg")
    self.require_bg = self.constitute:getChildByName("require_bg")
    self.finish_tip = self.require_bg:getChildByName("finish_tip")
    self.rank_txt = createRichLabel(20,cc.c3b(0x7c,0x55,0x36),cc.p(0.5,0.5),cc.p(180,337),nil,nil,310)
    self.constitute:addChild(self.rank_txt)
    self.rank_schedule_txt = createRichLabel(20,cc.c3b(0x7c,0x55,0x36),cc.p(1,0.5),cc.p(323,265),nil,nil,310)
    self.constitute:addChild(self.rank_schedule_txt)
    self.constitute_bar = self.constitute:getChildByName("constitute_bar")
    self.constitute_bar:setScale9Enabled(true)
    self.submit_btn = self.constitute:getChildByName("submit_btn")
    self.submit_txt = self.submit_btn:getChildByName("submit_txt")
    self.submit_txt:setString(TI18N("语言_c_279"))

    self.research = self.rank_panel:getChildByName("research")
    -- self.research:setVisible(false)
    self.research_img = self.research:getChildByName("research_img")
    self.research_txt = self.research_img:getChildByName("research_txt")
    self.research_txt:setString(TI18N("语言_c_6344"))
    self.state_bg = self.research:getChildByName("state_bg")
    self.state_txt = self.state_bg:getChildByName("state_txt")
    self.state_txt:setString(TI18N("语言_c_6345"))
    self.state_tip = self.research:getChildByName("state_tip")
    self.state_tip:setString(TI18N("语言_c_6346"))
    self.get_bg = self.research:getChildByName("get_bg")
    self.get_txt = self.get_bg:getChildByName("get_txt")
    self.get_txt:setString(TI18N("语言_c_6347"))
    self.go_txt = createRichLabel(18,cc.c3b(0x0e,0xa8,0x0e),cc.p(1,0.5),cc.p(324,14))
    self.get_bg:addChild(self.go_txt)
    self.go_txt:setString(TI18N("语言_c_6348"))
