TreasureResearchWindow = class("TreasureResearchWindow", function()
    return ccui.Widget:create()
end)

local controller = TreasureController:getInstance()
local model = controller:getModel()

function TreasureResearchWindow:ctor()  
    self:config()
    self:layoutUI()
    self:registerEvents()
    controller:sender22336()
    controller:sender22344()
    
    ActionController:getInstance():sender16808({ActionStorageBool.TreasureResearchFinish,ActionStorageBool.TreasureResearchInto})
end

function TreasureResearchWindow:config()
    self.treasure_list = {}
    self.rank_list = {}
    self.filt_btn_list = {}
    self.data_base_info = Config.NinjaTreasureResearchData.data_base_info
    self.research_cfg = model:getResearchCfg() --筛选完的配置表
    self.project_num = 1 --项目期数
    self.click_num = 1 --第几个魔导器
    self.click_rank_index = 1 --第几个任务
    self.constitute_id = 0 --构成的任务id
    self.treasure_pos = {
        [1] = {[1] = cc.p(360,87),},
        [2] = {[1] = cc.p(216,87),[2] = cc.p(504,87),},
        [3] = {[1] = cc.p(122,87),[2] = cc.p(360,87),[3] = cc.p(597,87),},
    }
    self.submit_treasure_list = {}  --提交任务是魔导器碎片的列表
    self.rank_posx = 0
end

function TreasureResearchWindow:layoutUI()
    local csbPath = PathTool.getTargetCSB("treasure/treasure_research_window")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.btn_rule = self.main_container:getChildByName("btn_rule")

    self.treasure_panel = self.main_container:getChildByName("treasure_panel")
