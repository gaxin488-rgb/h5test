end
--魔导器构成任务数据
function TreasureModel:getConstituteRankList(project_num,click_num,id)
	local list = self:ResearchStaData(project_num,click_num)
	if list then
		for k, v in pairs(list.quest_list) do
			if v.id == id then
				return v
			end
		end
	end
	return nil
end
--魔导器研发配置
function TreasureModel:getResearchCfg()
	local list = {}
	local research_cfg = deepCopy(Config.NinjaTreasureResearchData.data_base_info)
	local treasure_cfg = deepCopy(Config.NinjaTreasureData.data_base_info)
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("ninja_treasure_data")
	local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev or 0
    for key, value in pairs(research_cfg) do
		for k, v in pairs(value) do
			local cfg = treasure_cfg[v.annals_id]
			if cfg then
				if (cfg.open == 0 and table.indexof(nohideIds,cfg.id)) or cfg.open == 1 then
					if (next(cfg.show_limit) and tree_lev >= cfg.show_limit[1][2]) or not next(cfg.show_limit) then
						if not list[v.round] then
							list[v.round] = {}
						end
						table.insert(list[v.round],v)
					end
				end
			end
		end
    end
	return list
end
--魔导器研发剩余可获得道具
function TreasureModel:getResearchCanGetItem(project_num,click_num)
	local list = {}
	local reward_list = {}
	local achievement_list = {}
	local data = self:getResearchRankListForItem(project_num,click_num)
	if data then
		for k, v in pairs(data.quest_list) do
			if v.state ~= 2 then
				table.insert(achievement_list,v.id)
			end
		end
	else
		local cfg = deepCopy(Config.NinjaTreasureResearchData.data_base_info[project_num][click_num])
		if not cfg then return reward_list end
		achievement_list = cfg.achievement_list
	end
	for k, v in pairs(achievement_list) do
		local config = deepCopy(Config.NinjaTreasureResearchData.data_get[v])
		if next(config.commit_rewards) then
			for key, value in pairs(config.commit_rewards) do
				if list[value[1]] then
					list[value[1]] = list[value[1]] + value[2]
				else
					list[value[1]] = value[2]
				end
			end
		end
	end
	for key, value in pairs(list) do
		local data = {key,value}
		table.insert(reward_list, data)
	end
	return reward_list
end
--魔导器研发任务列表
function TreasureModel:getResearchRankList(project_num,click_num)
	local num = 0
	num = click_num
	local cfg = deepCopy(Config.NinjaTreasureResearchData.data_base_info[project_num][num])
	return cfg.achievement_list
end
--研发任务列表
function TreasureModel:setResearchRankList(data)
	self.rank_list = data
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_Rank_Data_Event,data.round,data.pos)
	self:setResearchMainRed()
end
function TreasureModel:getResearchRankListAll()
	return self.rank_list
end
--单个研发任务列表
function TreasureModel:setResearchRankListForItem(data)
	if next(self.rank_list.all) then
		for key, value in pairs(self.rank_list.all) do
			if value.round == data.round then
				for k, v in pairs(value.pos_info_list) do
					if v.pos == data.pos then
						for i, j in pairs(data.quest_list) do
							for a, b in pairs(v.quest_list) do
								if j.id == b.id then
									self.rank_list.all[key].pos_info_list[k].quest_list[a] = j
								end
							end
						end
					end
				end
			end
		end
	else
		local list = {}
		list.round = data.round
		list.pos_info_list = {}
		local list1= {}
		list1.pos = data.pos
		list1.quest_list = data.quest_list
		table.insert(list.pos_info_list,list1)
		table.insert(self.rank_list.all,list)
	end
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_Rank_Data_Event,data.round,data.pos)
	self:setResearchMainRed()
end

--获取研发任务  单个魔导器
function TreasureModel:getResearchRankListForItem(round,index)
	if self.rank_list and self.rank_list.all then
		for key, value in pairs(self.rank_list.all) do
			if value.round == round then
				for k, v in pairs(value.pos_info_list) do
					if v.pos == index then
						return v
					end
				end
			end
		end
	end
	return nil
end

--获取研发任务  单个项目
function TreasureModel:getResearchRankListForRound(round)
	for key, value in pairs(self.rank_list.all) do
		if value.round == round then
			return value
		end
	end
	return nil
end
function TreasureModel:setResearchRankRound(round)
	self.rank_round = round
end
function TreasureModel:getResearchRankRound()
	return self.rank_round
end
function TreasureModel:setResearchRankIndex(index)
	self.rank_index = index
end
function TreasureModel:getResearchRankIndex()
	return self.rank_index
end
--魔导器研发红点
function TreasureModel:getResearchRed()
	if self.research_data and self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			if value.round == self:getResearchProjectNum() then
				for k, v in pairs(value.pos_info_list) do
					if v.pos == self:getResearchClickNum() then
						for a, b in pairs(v.quest_list) do
							if b.point == 1 or b.state == 1 or (b.state ~= 2 and self:getResearchRankForItemRed(b.id)) then
								return true
							end
						end
					end
				end
			end
		end
	end
	return false
end

--单个项目位置的红点
function TreasureModel:getResearchOnlyRedForRound(round)
	if self.research_data and self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			if value.round == round then
				for k, v in pairs(value.pos_info_list) do
					if self:getResearchOnlyRed(value.round,v.pos) then
						return true
					end
				end
			end
		end
	end
	return false
end
function TreasureModel:getResearchOnlyRed(round,pos)
	return self:getResearchRewardRed(round,pos)
end

--研发奖励红点
function TreasureModel:getResearchAllRewardRed()
	if self.research_data and self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			for k, v in pairs(value.pos_info_list) do
				if self:getResearchRewardRed(value.round,v.pos) then
					return true
				end
			end
		end
	end
	return false
end
function TreasureModel:getResearchRewardRed(round,pos)
	local data = self:ResearchStaData(round,pos)
	if not data then return false end
	local config = Config.NinjaTreasureResearchData.data_base_info
	if config and config[round] and config[round][pos] then
		local num = 0
		local cfg = config[round][pos].rewards
		local list = data.quest_list
		for k, v in pairs(list) do
            if v.state == 2 then
                num = num + 1
            end
        end
		for k, v in pairs(cfg) do
			local status = true
			for key, value in pairs(data.rewards) do
				if value.reward_id == v[1] then
					status = false
				end
			end
			if status and num >=v[1] then
				return true
			end
		end
	end
	return false
end
function TreasureModel:getResearchRankForItemRed(id)
	local cfg = Config.NinjaTreasureResearchData.data_get[id]
	if cfg.progress[1].cli_label == "evt_use_item" then
		local data = cfg.progress[1].param[1]
		local id = data[1]
		local need_num = data[2]
		local have_num = BackpackController:getInstance():getModel():getItemNumByBid(id)
		if have_num >= need_num then
			return true
		end
	elseif cfg.progress[1].cli_label == "evt_give_annals" then
		local need_num = cfg.progress[1].param[1][1]
		local type = cfg.progress[1].param[1][2]
		local list = BackpackController:getInstance():getModel():getNumForQuantity2(type,need_num)
		local have_num = 0
		for key, value in pairs(list) do
			have_num = have_num + value.num
		end
		if have_num >= need_num then
			return true
		end
	end
	return false
end

--魔导器研发任务红点
function TreasureModel:getResearchRankRed()
	if self.rank_list and self.rank_list.all then
		for key, value in pairs(self.rank_list.all) do
			for k, v in pairs(value.pos_info_list) do
				for a, b in pairs(v.quest_list) do
					if b.state == 1 then
						return true
					end
				end
			end
		end
	end
	return false
end

