function TreasureModel:ResearchTime(project_num,click_num)
	local list = self:ResearchStaData(project_num,click_num)
	if list then
		return list.use_time
	end
	return 0
end
--魔导器构成研发开启时间戳
function TreasureModel:ResearchTimeNum(project_num,click_num)
	local list = self:ResearchStaData(project_num,click_num)
