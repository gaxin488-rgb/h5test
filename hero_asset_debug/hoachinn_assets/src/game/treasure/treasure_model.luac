--能否升星
function TreasureModel:getCanUpstarForIdRed(data)
	local id = data.item_bid or data.id
	if BattleDramaController:getInstance():getModel():checkDispatchIsUp(id) then
		return false
	end
	local star_info = Config.NinjaTreasureData.data_star_info[id]
	if not star_info then return false end
	if data.star >= tableLen(star_info) then return false end
	star_info = star_info[data.star]
	if star_info.limit[1] then
		local limit = star_info.limit[1]
		if limit[1] == "tree_lev" then
			local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev
			if tree_lev < limit[2] then return false end
		end
	end
	local cost_data = star_info.cost
	for key, value in pairs(cost_data) do
		local have_num = BackpackController:getInstance():getModel():getItemNumByBid(value[1])
		if have_num < value[2] then
			return false
		end
	end
	local cost_card = star_info.cost_card
	for key, value in pairs(cost_card) do
		local num = self:getHeroList(value)
		if num < value[3] then return false end
	end
	
	local cost_card = star_info.cost_card_mine
	for key, value in pairs(cost_card) do
		local heroinfolist = HeroController:getInstance():getModel():getHeroInfoByBidStar(value[1], value[2])
		local num = heroinfolist and #(heroinfolist) or 0
		if num < value[3] then return false end
	end
	return true
end
function TreasureModel:getHeroList(data)
	local num = 0
	--过滤
	local hero_array = HeroController:getInstance():getModel():getAllHeroArray()
	local size = hero_array:GetSize()
	--表示选择同阵营的随机卡
	for j=1, size do
		local hero_vo = hero_array:Get(j-1)
		if hero_vo  and not hero_vo:isResonateHero() and (hero_vo.camp_type == data[1] or 0 == data[1]) and (hero_vo.camp_type ~= HeroConst.CampType.eAlien) and --默认排除异能英雄
			hero_vo.star == data[2] then
			num = num + 1
		end
	end
	--不忽略英雄魂
	-- 获取背包的英魂 BackpackController:getInstance():getModel()
	local list = BackpackController:getInstance():getModel():getHeroHunList()
	for _,v in pairs(list) do
		if v.config and (v.config.camp_type == data[1] or 0 == data[1]) and v.config.eqm_jie == data[2] then
			for i=1, v.quantity do
				num = num + 1
			end
		end
	end
	return num
end
--能否觉醒
function TreasureModel:getCanWakeUpForIdRed(data)
	local wake = data.is_wakeup or data["break"]
	if wake == 1 then return false end
	local id = data.item_bid or data.id
	local lv = data.lev or data.lv
	local awake_info = Config.NinjaTreasureData.data_awake_info[id]
	if not awake_info then return false end
	for k, v in pairs(awake_info.limit) do
		if v[1] == "star" then
			if data.star < v[2] then return false end
		elseif v[1] == "lev" then
			if lv < v[2] then return false end
		end
	end
	local cost_data = awake_info.cost
	local cost_item_list = awake_info.cost_item
	for key, value in pairs(cost_data) do
		local have_data = BackpackController:getInstance():getModel():getNumForQuantity(value[1],value[2])
		local num = 0
		local cost_num = 0
		for key, value in pairs(have_data) do
			for k, v in pairs(cost_item_list) do
				if value.id == v[1] then
					cost_num = v[2]
				end
			end
			if cost_num == 0 then
				num = num + value.num
			else
				num = num + value.num - cost_num
			end
		end
		if num < value[2] then
			return false
		end
	end
	local cost_data = awake_info.cost_item
	for key, value in pairs(cost_data) do
		local have_num = BackpackController:getInstance():getModel():getItemNumByBid(value[1])
		if have_num < value[2] then
			return false
		end
	end
	local cost_card = awake_info.cost_card_mine
	for key, value in pairs(cost_card) do
		local heroinfolist = HeroController:getInstance():getModel():getHeroInfoByBidStar(value[1], value[2])
		local num = heroinfolist and #(heroinfolist) or 0
		if num < value[3] then return false end
	end
	return true
end
-- 魔导器系统是否开启
function TreasureModel:checkTreasureIsOpen( not_tips )
	local is_open = false
	local role_vo = RoleController:getInstance():getRoleVo()
	local open_cfg = Config.NinjaTreasureData.data_constant["open_lev"]
	if open_cfg and role_vo and open_cfg.val <= role_vo.lev then
		is_open = true
	end

	if not is_open and open_cfg and not not_tips then
		message(open_cfg.desc)
	end

	return is_open
end
-- 获取精灵红点状态
function TreasureModel:getTreasureRedStatusByRedBid( bid )
	return self.treasure_red_list[bid] or false
end
-- 获取所有寻访数据
function TreasureModel:getTreasureHatchList(  )
	return self.treasure_hatch_list
end
-- 设置今日购买数量信息
function TreasureModel:setTreasureBuyInfo( data )
	self.treasure_buy_info = data or {}
end
-- 根据bid获取该物品今日购买数量
function TreasureModel:getTreasureBuyCountByBid( bid )
	local buy_num = 0
	for k,v in pairs(self.treasure_buy_info) do
		if v.item_bid == bid then
			buy_num = v.buy_num
			break
		end
	end
	return buy_num
end

-- 更新某一个物品今日购买信息
function TreasureModel:updateTreasureBuyInfoByBid( bid, count )
	local is_have = false
	for k,v in pairs(self.treasure_buy_info) do
		if v.item_bid == bid then
			is_have = true
			v.buy_num = count
			break
		end
	end
	if not is_have then
		local info = {}
		info.item_bid = bid
		info.buy_num = count
		table.insert(self.treasure_buy_info, info)
	end
end

--设置自己拥有得秘宝列表
function TreasureModel:setTreasureList(data)
	for k, v in pairs(data) do
		self.treasure_list[v.item_bid] = v
	end
	for key, value in pairs(self.treasure_list) do
		self:setTreasureRed(value)
	end
	self:setNoTreasureRed()
	GlobalEvent:getInstance():Fire(TreasureEvent.Open_Treasure_List_Event,data)
	for key, value in pairs(self.treasure_red_list) do
		if value then
			self.red_1 = true
			self:setRedInfo()
			-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.treasure,status = true})
			-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
			return
		end
	end
	self.red_1 = false
	self:setRedInfo()
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.treasure,status = false})
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
	self.treasure_change_list = {}
end
--刷新单个编年史的红点 传入编年史碎片id
function TreasureModel:updateTreasureRedForOne(id)
	local item_cfg = Config.ItemData.data_get_data(id)
	if not item_cfg then return end
	local item_id = 0
	if item_cfg.effect and item_cfg.effect[1] and item_cfg.effect[1].val then
		item_id = item_cfg.effect[1].val
	end
	if item_id == 0 then return end
	local cfg = Config.NinjaTreasureData.data_base_info[item_id]
	if not item_id then return end
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("ninja_treasure_data")
	local backpack_model = BackpackController:getInstance():getModel()
	local hero_model = HeroController:getInstance():getModel()
	if (cfg.open == 0 and table.indexof(nohideIds,cfg.id)) or cfg.open == 1 then
		if not self.treasure_list[cfg.id] then --激活
			local need_id = cfg.need_id
			local need_num = cfg.item_num
			local have_num = backpack_model:getNumForId(need_id)			
			local tree_lev = hero_model.resonate_cystal_lev or 0
			if have_num >= need_num and tree_lev >= cfg.open_limit[1][2] then
				self.treasure_red_list[cfg.id] = true
			else
				self.treasure_red_list[cfg.id] = false
			end
		else
			local data = self.treasure_list[cfg.id]
			self:setTreasureRed(data)
		end
		local status = false
		for key, value in pairs(self.treasure_red_list) do
			if value then
				status = true
				break
			end
		end
		self.red_2 = status
		self:setRedInfo()
		-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.treasure,status = status})
	else
		return
	end
end
function TreasureModel:getTreasureList()
	return self.treasure_list
end
--设置未激活秘宝的可激活红点
function TreasureModel:setNoTreasureRed()
	local cfg = Config.NinjaTreasureData.data_base_info
	local star_cfg = Config.NinjaTreasureData.data_star_info
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("ninja_treasure_data")
	local backpack_model = BackpackController:getInstance():getModel()
	local hero_model = HeroController:getInstance():getModel()
	for key, value in pairs(cfg) do
		--单个魔导器屏蔽
        if (value.open == 0 and table.indexof(nohideIds,value.id)) or value.open == 1 then
			if not self.treasure_list[value.id] then --激活
				local need_id = value.need_id
				local need_num = value.item_num
				local have_num = backpack_model:getNumForId(need_id)			
				local tree_lev = hero_model.resonate_cystal_lev or 0
				if have_num >= need_num and tree_lev >= value.open_limit[1][2] then
					self.treasure_red_list[value.id] = true
				else
					self.treasure_red_list[value.id] = false
				end
			end
        end
	end
end


--活动英雄列表 根据匹配信息
--@dic_the_conditions --指定匹配 dic_the_conditions[bid][star] = 数量
--@dic_random_conditions --随机阵容匹配 dic_the_conditions[camp][star] = 数量
--@dic_hero_id 标志已用
--return
--@ count 拥有不重复英雄总数量
function TreasureModel:getHeroListByMatchInfo(dic_the_conditions, dic_random_conditions, dic_hero_id)
    --找不重复的数量
    local count  = 0
    local dic_hero_id = dic_hero_id or {}
    local dic_count = {}

    local _setDicCount = function( partner_id, str, max)
        --判断是否重复
        if dic_hero_id[partner_id] == nil then
            if dic_count[str] == nil then
                dic_count[str] = 0
            end
            if dic_count[str] < max then
                dic_count[str] = dic_count[str] + 1
                count = count + 1    
                dic_hero_id[partner_id] = 1
            end
        end 
    end
	local list = HeroController:getInstance():getModel():getHeroList()
    for k,hero in pairs(list) do
        if not hero:isResonateHero() then
            if dic_the_conditions and dic_the_conditions[hero.bid] and dic_the_conditions[hero.bid][hero.star] and not hero:isInForm() and not hero:isLock() then
                --指定的.范围最小
                local str = string_format("%s%s", hero.bid, hero.star)
                _setDicCount(hero.partner_id, str, dic_the_conditions[hero.bid][hero.star])
            end

            if dic_random_conditions then
                if dic_random_conditions[hero.camp_type] and dic_random_conditions[hero.camp_type][hero.star] and not hero:isInForm() and not hero:isLock() then
                    --先判定指定阵营的 ,先小范围.再大范围
                    local str = string_format("_%s%s", hero.camp_type, hero.star)
                    _setDicCount(hero.partner_id, str, dic_random_conditions[hero.camp_type][hero.star])
                elseif dic_random_conditions[0] and dic_random_conditions[0][hero.star] and not hero:isInForm() and not hero:isLock() then
                    --0表示所有阵营的合适
                    local str = string_format("_%s%s", 0, hero.star)
                    _setDicCount(hero.partner_id, str, dic_random_conditions[0][hero.star])
                end    
            end
        end
    end

    local list = BackpackController:getInstance():getModel():getHeroHunList()
    for k,good_vo in pairs(list) do
        if good_vo.config then
            local camp_type = good_vo.config.camp_type
            local star = good_vo.config.eqm_jie
			if dic_random_conditions[0] and dic_random_conditions[0][star] then
                local str = string.format("_%s%s", 0, star)

                if dic_count[str] == nil then
                    dic_count[str] = 0
                end
                if dic_count[str] < dic_random_conditions[0][star] then
                    local cur_count = dic_random_conditions[0][star] - dic_count[str]
                    if good_vo.quantity < cur_count then
                        cur_count = good_vo.quantity
                    end
                    count = count + cur_count 
                    dic_count[str] = dic_count[str] + cur_count
                end
            end
        end
    end

    return count
end
function TreasureModel:getHaveNumByQuality(quality)
	local num = 0
	for key, value in pairs(self.treasure_list) do
		local cfg = Config.NinjaTreasureData.data_base_info[key]
		if cfg and cfg.quality == quality then
			num = num + 1
		end
	end
	return num
end
function TreasureModel:getTreasureForId(id)
	if self.treasure_list[id] then 
		return self.treasure_list[id]
	end
	return nil
end
-----------------------------------------抽奖------------------------
function TreasureModel:setLotteryInfo(data)
	self.lottery_info = data
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Update_Lottery_Info_Event,self.lottery_info)
end
function TreasureModel:setLotteryOneInfo(data)
	for key, value in pairs(self.lottery_info.draw_list) do
		if value.group_id == data.group_id then
			self.lottery_info.draw_list[key] = data
		else
			self.lottery_info.draw_list[key].times = data.times
		end
	end
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Update_Lottery_Info_Event,self.lottery_info)
end
function TreasureModel:getLotteryInfo()
	return self.lottery_info
end
--获取已经解锁的奖池id
function TreasureModel:getLotteryId()
	local list = {}
	for key, value in pairs(self.lottery_info.draw_list) do
		if value.start_time > 0 then
			table.insert(list,value.group_id)
		end
	end
	return list
end
--战令信息列表
function TreasureModel:setOrderList(data)
	self.order_list = data
	table.sort(data.awards,function(a,b) return a.id < b.id end)
	self.awards = data.awards  --奖励
	self.buy1 = data.buy1 -- 是否解锁第一档
	self.buy2 = data.buy2 -- 是否解锁第二档
	self.discount = data.discount --是否打折
	self.end_time = data.end_time --结束时间
	self.id = data.id --战令周期id
	self.score = data.score --积分
	self:getOrderRed()
	TaskController:getInstance():getModel():checkQuestAndFeatStatus(TaskConst.update_type.quest)
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Order_Event)
end
--返回战令信息
function TreasureModel:getOrderList()
	return self.order_list or nil
end
--返回战令奖励领取列表
function TreasureModel:getOrderAwards()
	return self.awards or {}
end
--返回战令奖励是否已经领取
function TreasureModel:getOrderAwardsReceive(id,num)
	if self.awards[id] then
		if self.awards[id]["award"..num] then
			return self.awards[id]["award"..num] == 2
		end
	end
	return false
end
--返回战令奖励领取情况
function TreasureModel:getOrderStaForId(index)
	local status = 0
	if self.awards then
		for key, value in pairs(self.awards) do
			if value.id == index then
				if value.award1 == 0 and value.award2 == 0 then
					status = 0 
				elseif value.award1 == 2 and value.award2 == 0 then
					status = 1
				elseif value.award1 == 0 and value.award2 == 2 then
					status = 2
				elseif value.award1 == 2 and value.award2 == 2 then
					status = 3
				end
			end
		end
	end
	return status
end
--返回战令是否解锁第一档 0未解锁 1已解锁
function TreasureModel:getOrderBuy1()
	return self.buy1 or 0
end
--返回战令是否解锁第一档 0未解锁 1已解锁
function TreasureModel:getOrderBuy2()
	return self.buy2 or 0
end
--返回战令是否打折 0不打折 1打折
function TreasureModel:getOrderDiscount()
	return self.discount or 0
end
--返回战令结束时间
function TreasureModel:getOrderEndTime()
	return self.end_time or 0
end
--返回战令周期id
function TreasureModel:getOrderId()
	return self.id or 1
end
--返回战令积分
function TreasureModel:getOrderScore()
	return self.score or 0
end

--返回战令是否有红点
function TreasureModel:getOrderRed()
	if not Config.NinjaTreasureDrawData then
		return false
	end
	local cfg = deepCopy(Config.NinjaTreasureDrawData.data_get_task_reward[self:getOrderId()])
	if not cfg then return false end
	local buy1 = self:getOrderBuy1()
	local buy2 = self:getOrderBuy2()
	for i = 1, #cfg do
		if cfg[i] and self:getOrderScore() >= cfg[i].need_num then
			if self:getOrderStaForId(cfg[i].order) == 0 then
				self.red_3 = true
				self:setRedInfo()
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.order,status = true})
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
				if buy1 == 1 or buy2 == 1 then return true end
			elseif self:getOrderStaForId(cfg[i].order) == 1 then
				self.red_3 = true
				self:setRedInfo()
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.order,status = true})
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
				if buy1 == 2 then return true end
			elseif self:getOrderStaForId(cfg[i].order) == 2 then
				self.red_3 = true
				self:setRedInfo()
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.order,status = true})
				-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
				if buy1 == 1 then return true end
			end
		end
	end
	self.red_3 = false
	self:setRedInfo()
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.order,status = false})
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
	return false
end

--是否满足寻访开启条件
function TreasureModel:getIsSearchLimit()
	local cfg = Config.NinjaTreasureData.data_constant
	local lev = RoleController:getInstance():getRoleVo().lev or 0
	local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev or 0
	if lev >= cfg["hatch_open_lev"].val and tree_lev >= cfg["hatch_open_tree_lev"].val then
		return true
	else
		return false
	end
end
--是否满足抽奖开启条件
function TreasureModel:getIsLotteryLimit()
	local limit_lev = Config.NinjaTreasureDrawData.data_constant["open_lv"].val
	local limit_tree_lev = Config.NinjaTreasureDrawData.data_constant["open_tree_lv"].val
	local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev or 0
	if RoleController:getInstance():getRoleVo().lev < limit_lev or tree_lev < limit_tree_lev then
		return false
	else
		return true
	end
end
--是否满足成长自选开启条件
function TreasureModel:getIsMpGiftLimit()
	local data = ActionController:getInstance():getActionSubTabVo(ActionRankCommonType.grow_gift)
	if not data then return false end
	local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev or 0
	local limit_tree_lev = Config.NinjaTreasureData.data_constant["fire_gift_open_lev"].val[2]
	if tree_lev < limit_tree_lev then
		return false
	end
	return true
end
--是否满足编年小铺开启条件
function TreasureModel:getIsShopLimit()
    if not Config.ExchangeData then
        require "config.exchange_data"
		if not Config.ExchangeData then return false end
    end
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("skill_shop_data")
    local cfg = Config.ExchangeData.data_shop_list[MallConst.MallType.TreasureShop3]
    if cfg and (cfg.shop_show == 1 or (cfg.shop_show == 0 and table.indexof(nohideIds,MallConst.MallType.TreasureShop3))) then
		local limit_lev = cfg.limit[1][2]
		if RoleController:getInstance():getRoleVo().lev < limit_lev then
			return false
		else
			return true
		end
    end
    return false
end
--是否满足战令开启条件
function TreasureModel:getIsOrderLimit()
	if self:getOrderEndTime() > 0 then return true end
	local limit_lev = Config.NinjaTreasureDrawData.data_constant["order_open_lv"].val
	local limit_tree_lev = Config.NinjaTreasureDrawData.data_constant["order_open_tree_lv"].val
	local tree_lev = HeroController:getInstance():getModel().resonate_cystal_lev or 0
	if RoleController:getInstance():getRoleVo().lev < limit_lev or tree_lev < limit_tree_lev then
		return false
	else
		return true
	end
end
--是否满足魔导器开启等级
function TreasureModel:IsTreasureLev()
	if not Config.NinjaTreasureData then
		require("config.ninja_treasure_data")
	end
	local cfg = Config.NinjaTreasureData.data_constant.open_lev
	local role_vo = RoleController:getInstance():getRoleVo()
	if role_vo.lev < cfg.val then
		return false
	else
		return true
	end
	return false
end
--魔导器是否开启
function TreasureModel:TreasureIsOpen()
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
    local featuresId = MainuiConst.FeaturesShield.Treasure
    if table.indexof(nohideIds,featuresId) then
        if self:IsTreasureLev() then
			return true
        end
    end
	return false
end
