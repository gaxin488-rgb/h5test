function TreasureModel:setRedInfo(status)
	local red_status = false
	if self.red_1 or self.red_2 or self.red_3 or self.red_4 or self.red_5 or self.first_red then
		red_status = true
	end
	MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = JinqiConst.Red_Type.biannianshi,status = red_status})
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_Update_All_Red_Event) 
end

function TreasureModel:getRedInfo()
	return self.red_1 or self.red_2 or self.red_3 or self.red_4 or self.red_5 or self.first_red
end

--魔导器红点
function TreasureModel:getRed()
	return self:getTreasureRed() or self:getOrderRed() or self.first_red == true or self:getResearchRed() or self:getResearchRankRed() or self:getResearchAllRewardRed()
end
