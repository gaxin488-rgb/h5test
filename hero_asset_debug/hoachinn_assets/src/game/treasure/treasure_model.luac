TreasureModel = TreasureModel or BaseClass()

function TreasureModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function TreasureModel:config()
    self.treasure_hatch_list = {}  -- 孵化器数据
	self.treasure_red_list = {} -- 红点数据 1战令
	self.treasure_buy_info = {} 	-- 今日购买精灵蛋和砸蛋道具的物品数量
	self.treasure_list = {} --自己拥有得秘宝
	self.first_red = false --每次登陆红点  不需要每次登陆有红点 需要的话 这里变为true
	self.treasure_change_list = {} --改变的秘宝
	self.is_first_war = false
	self.research_data = {}--研发的数据
	self.research_first_list = {} --研发项目首次点击红点
end

-- 设置灵窝数据
function TreasureModel:setTreasureHatchList( data_list )
	self.treasure_hatch_list = {}
	for k,data in pairs(data_list) do
		local treasure_hatch_vo = TreasureHatchVo.New()
		treasure_hatch_vo:updateData(data)
		if self.hatch_cfg and self.hatch_cfg[data.id] then
			treasure_hatch_vo.sort = self.hatch_cfg[data.id].sort
		end
		table.insert(self.treasure_hatch_list, treasure_hatch_vo)
	end
	table.sort(self.treasure_hatch_list,function(a,b) return a.sort < b.sort end)

	-- 检测是否有孵化完成的灵窝
	self:calculateTreasureHatchDoneRedStatus()
	self:calculateTreasureHatchEggRedStatus()
end
-- 更新灵窝数据
function TreasureModel:updateTreasureHatchData( data_list )
	for _,data in pairs(data_list) do
		local is_have = false
		for k,treasure_hatch_vo in pairs(self.treasure_hatch_list) do
			if treasure_hatch_vo.id == data.id then
				treasure_hatch_vo:updateData(data)
				is_have = true
				break
			end
		end
		if not is_have then
			local treasure_hatch_vo = TreasureHatchVo.New()
			treasure_hatch_vo:updateData(data)
			if self.hatch_cfg and self.hatch_cfg[data.id] then
				treasure_hatch_vo.sort = self.hatch_cfg[data.id].sort
			end
			table.insert(self.treasure_hatch_list, treasure_hatch_vo)
		end
	end

	-- 检测是否有孵化完成的灵窝
	self:calculateTreasureHatchDoneRedStatus()
	self:calculateTreasureHatchEggRedStatus()
end

-- 计算灵窝孵化完成的红点
function TreasureModel:calculateTreasureHatchDoneRedStatus(  )
	if not self:checkTreasureIsOpen(true) then return end
	local hatch_done_red = false
	for k,hatch_vo in pairs(self.treasure_hatch_list) do
		if hatch_vo.state == TreasureConst.Hatch_Status.Over then
			hatch_done_red = true
			break
		end
	end
	self:updateTreasureRedStatus(HeroConst.RedPointType.eTreasure_hatch_done, hatch_done_red)
end

-- 计算是否有可孵化的灵窝和蛋
function TreasureModel:calculateTreasureHatchEggRedStatus(  )
	if not self:checkTreasureIsOpen(true) then return end
	local red_status = false
	local have_empty_hatch = false
	for k,hatch_vo in pairs(self.treasure_hatch_list) do
		if hatch_vo.is_open == 1 and hatch_vo.state == TreasureConst.Hatch_Status.Open then
			have_empty_hatch = true
			break
		end
	end
	if have_empty_hatch then
		local all_egg_list = BackpackController:getInstance():getModel():getBackPackItemListByType(BackPackConst.item_type.ELFIN_EGG)
		if #all_egg_list > 0 then
			red_status = true
		end
	end
	red_status = red_status and self:getIsSearchLimit()
	self:updateTreasureRedStatus(HeroConst.RedPointType.eTreasure_hatch_egg, red_status)
end

-------------------------------------@ 红点相关
function TreasureModel:updateTreasureRedStatus( bid, status )
	if not self:checkTreasureIsOpen(true) then return end
	if not bid then return end
    self.treasure_red_list[bid] = status

    MainuiController:getInstance():setBtnRedPoint(MainuiConst.btn_index.partner, {bid = bid, status = status})
    GlobalEvent:getInstance():Fire(TreasureEvent.Update_Treasure_Search_Red_Event, bid, status)
	local redpoint_data = {}
    redpoint_data.bid = bid
    redpoint_data.status = status
	GlobalEvent:getInstance():Fire(HeroEvent.All_Hero_RedPoint_Event, {redpoint_data})
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.lottery,status = self:getTreasureRed()})
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.firstRed,status = self.first_red == true})
	self:setRedInfo()
end
function TreasureModel:getTreasureRed()
	if not self:IsTreasureLev() then return false end
	for key, value in pairs(self.treasure_red_list) do
		if value then
			return true
		end
	end
	return false
end
function TreasureModel:setTreasureRed(data)
	local red_point = false
	red_point = self:getCanUpLevForIdRed(data)
	if red_point then
		self.treasure_red_list[data.item_bid] = red_point
		return
	end
	red_point = self:getCanUpstarForIdRed(data)
	if red_point then
		self.treasure_red_list[data.item_bid] = red_point
		return
	end
	red_point = self:getCanWakeUpForIdRed(data)
	if red_point then
		self.treasure_red_list[data.item_bid] = red_point
		return
	end
	self.treasure_red_list[data.item_bid] = red_point
end
