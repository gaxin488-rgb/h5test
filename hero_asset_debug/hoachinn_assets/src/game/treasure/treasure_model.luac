end
function TreasureModel:ResearchStaData(project_num,click_num)
	if self.research_data and self.research_data.all then
		local data = self.research_data.all
		for key, value in pairs(data) do
			if value.round == project_num then
				for k, v in pairs(value.pos_info_list) do
					if v.pos == click_num then
						return v
					end
				end
			end
		end
	end
	return nil
end
--魔导器构成研发状态 0未构成研发 1构成中 2研发中
function TreasureModel:ResearchSta(project_num,click_num)
	local list = self:ResearchStaData(project_num,click_num)
	if list then
		return list.pos_state
	end
	return 0
end
