function TreasureModel:setfirstWar(status)
	self.is_first_war = status
	TaskController:getInstance():getModel():checkQuestAndFeatStatus(TaskConst.update_type.quest)
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_War_First_Event)
end
function TreasureModel:getfirstWar()
	return self.is_first_war and self:getOrderBuy1() == 0
