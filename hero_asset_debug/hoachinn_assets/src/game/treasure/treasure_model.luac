--魔导器研发任务红点单个项目单个魔导器
function TreasureModel:getResearchRankRedForProjectPos(round,pos)
	for key, value in pairs(self.rank_list.all) do
		if value.round == round then
			for k, v in pairs(value.pos_info_list) do
				if v.pos == pos then
					for a, b in pairs(v.quest_list) do
						if b.state == 1 then
