--首次点击实战投入
function TreasureModel:setFirstInto(status)
	self.first_into = status
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_First_Into_Event)
end
function TreasureModel:getFirstInto()
	return self.first_into
end
--项目期数首次点击红点
function TreasureModel:sendResearchFirstRed()
	local list = self:getResearchCfg()
	local send_list = {}
	for k, v in pairs(list) do
		table.insert(send_list,2000+v[1].round)
	end
	ActionController:getInstance():sender16808(send_list)
end
function TreasureModel:setResearchFirstRed(type,status)
	self.research_first_list[type-2000] = status
	self:updateResearchFirstRed()
end
function TreasureModel:getResearchFirstRedForType(type)
	if self.research_first_list and self.research_first_list[type] then
		return true
	else
		return false
	end
end
function TreasureModel:updateResearchFirstRed()
	self.red_5 = false
	for key,value in pairs(self.research_first_list) do
		if value then
			self.red_5 = true
		end
	end
	self:setResearchMainRed()
	GlobalEvent:getInstance():Fire(TreasureEvent.Treasure_First_Red_Event)
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_Rank_Red_Event)
end
function TreasureModel:getResearchFirstRed()
	if self.red_5 then
		return self.red_5
	end
	return false
end
function TreasureModel:getResearchMainRed()
	return self:getResearchRed() or self:getResearchRankRed() or self:getResearchAllRewardRed() or self:getResearchFirstRed()
end
function TreasureModel:__delete()
end