--魔导器研发开启条件是否满足
function TreasureModel:IsTreasureResearchOpen()
	local cfg = Config.NinjaTreasureResearchData.data_constant
	local shield_id = MainuiConst.FeaturesShield.TreasureResearch
	local open_lv = cfg["open_lv"].val
	local open_tree_lv = cfg["open_tree_lv"].val
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	if table.indexof(nohideIds,shield_id) then
		local role_vo = RoleController:getInstance():getRoleVo()
		if role_vo.lev >= open_lv then
			if HeroController:getInstance():getModel():checkEnoughResLev(open_tree_lv) then
				return 0
			end
		end
	else
		return 1
	end
	return 2
end
--魔导器研发主界面红点
function TreasureModel:setResearchMainRed()
	local status = self:getResearchRed() or self:getResearchRankRed() or self:getResearchAllRewardRed()
	self.red_4 = status
	self:setRedInfo()
	-- MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.treasure, {bid = TreasureConst.Red_Type.research,status = status})
	MainuiController:getInstance():setFunctionTipsStatus(MainuiConst.icon.research, status or self:getResearchFirstRed())
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_Rank_Red_Event,status)
end
--魔导器研发数据
function TreasureModel:setResearchData(data)
	self.research_data = data
	if self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			for k, v in pairs(value.pos_info_list) do
				v.open_time = GameNet:getInstance():getTime() - v.use_time
			end
		end
	end
	self:setResearchMainRed()
	GlobalEvent:getInstance():Fire(TreasureEvent.Research_Data_Event,data.chose_round,data.chose_pos)
end
--魔导器研发数据单个项目
function TreasureModel:setResearchDataForProject(data)
	local status = true
	if self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			if value.round == data.round then
				status = false
				value = data
			end
		end
		if status then
			local list = {}
			list.round = data.round
			for k, v in pairs(data.pos_info_list) do
				v.open_time = GameNet:getInstance():getTime() - v.use_time
			end
			list.pos_info_list = data.pos_info_list
			table.insert(self.research_data.all,list)
		end
		self:setResearchMainRed()
		GlobalEvent:getInstance():Fire(TreasureEvent.Research_Data_Event)
	end
end
--魔导器研发数据单个魔导器
function TreasureModel:setResearchDataForItem(data)
	local status = true
	if self.research_data.all then
		for key, value in pairs(self.research_data.all) do
			if value.round == data.round then
				for k, v in pairs(value.pos_info_list) do
					if v.pos == data.pos then
						v.use_time = data.use_time
						v.open_time = GameNet:getInstance():getTime() - v.use_time
						v.pos_state = data.pos_state
						v.rewards = data.rewards
						for a, b in pairs(data.quest_list) do
							for i, j in pairs(v.quest_list) do
								if j.id == b.id then
									self.research_data.all[key].pos_info_list[k].quest_list[i] = data.quest_list[a]
									status = false
								end
							end
							if status then
								table.insert(v.quest_list,b)
							end
							status = true
						end
					end
				end
			end
		end
		self:setResearchMainRed()
		GlobalEvent:getInstance():Fire(TreasureEvent.Research_Data_Event,data.round,data.pos)
	end
end
--魔导器构成当前选择的项目
function TreasureModel:getResearchProjectNum()
	if not self.research_data then return 0 end
	return self.research_data.chose_round
end
--魔导器构成当前选择的位置
function TreasureModel:getResearchClickNum()
	if not self.research_data then return 0 end
