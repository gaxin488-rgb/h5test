-- 
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      传奇跨服忍者跨服主题界面展示
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
CrossServerThemeWindow = CrossServerThemeWindow or BaseClass(BaseView)

local controller = PrimusController:getInstance()

function CrossServerThemeWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big

    self.is_full_screen = false
    self.layout_name = "primus/cross_server_theme_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_4"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_5"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_6"), type = ResourcesType.single},
    }
end

function CrossServerThemeWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.root_csb = self.root_wnd:getChildByName("main_container")
    self.main_panel = self.root_csb:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel, 1)
    self.Image_2 = self.main_panel:getChildByName("Image_2")
    self.win_title = self.main_panel:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5420"))
    self.Image_2:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.Image_2:getContentSize().height))
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.top_bg = self.main_panel:getChildByName("top_bg")
    self.top_title_bg = self.main_panel:getChildByName("top_title_bg")
    self.top_title = self.main_panel:getChildByName("top_title")
    self.top_tip = self.main_panel:getChildByName("top_tip")
    self.time_txt = self.main_panel:getChildByName("time_txt")
    self.time_txt:setString(TI18N("语言_c_5426"))
    self.time_value = self.main_panel:getChildByName("time_value")
    self.bottom_bg = self.main_panel:getChildByName("bottom_bg")
    self.bottom_title_bg = self.main_panel:getChildByName("bottom_title_bg")
    self.bottom_title = self.main_panel:getChildByName("bottom_title")
    self.bottom_tip = self.main_panel:getChildByName("bottom_tip")
end 

function CrossServerThemeWindow:register_event()
    registerButtonEventListener(self.close_btn, function(param,sender, event_type)
        controller:openCrossServerThemeWindow(false)
    end ,false, 1)
    registerButtonEventListener(self.background, function(param,sender, event_type)
        controller:openCrossServerThemeWindow(false)
    end ,false, 1)
end

function CrossServerThemeWindow:setData(index,endTime)
    self.theme_list = {}
    local theme_list = deepCopy(Config.PrimusElementData.data_constant["season_rotation"].val)
    for key, value in pairs(theme_list) do
        table.insert(self.theme_list, value[1], value[2])
    end
    local theme_num = self.theme_list[index]
    local theme_next_num = self.theme_list[index+1]
    if not theme_next_num then
        theme_next_num = self.theme_list[1]
    end
    self.cfg = deepCopy(Config.PrimusElementData.data_primus_desc[theme_num])
    self.nextcfg = deepCopy(Config.PrimusElementData.data_primus_desc[theme_next_num])
    local endtime = endTime - GameNet:getInstance():getTime()
    ActionController:getInstance():getModel():setCountDownTime(self.time_value,endtime or 0)
    self.time_txt:setPositionX(self.time_value:getPositionX() - self.time_value:getContentSize().width-10)
    self.top_title:setString(string.format(TI18N("语言_c_5429"),self.cfg.name))
    self.top_title_bg:setContentSize(cc.size(self.top_title:getContentSize().width + 50,self.top_title_bg:getContentSize().height))
    self.top_tip:setString(TI18N(self.cfg.imp_desc))
    local bg_res = PathTool.getPlistImgForDownLoad("primus_element",self.cfg.imp_icon, false)
    self.item_load = loadSpriteTextureFromCDN(self.top_bg, bg_res, ResourcesType.single, self.item_load) 
    self.bottom_title:setString(string.format(TI18N("语言_c_5430"),self.nextcfg.name))
    self.bottom_title_bg:setContentSize(cc.size(self.bottom_title:getContentSize().width + 50,self.bottom_title_bg:getContentSize().height))
    self.bottom_tip:setString(TI18N(self.nextcfg.imp_desc))
	local bg_res2 = PathTool.getPlistImgForDownLoad("primus_element",self.nextcfg.imp_icon, false)
    self.item_load2 = loadSpriteTextureFromCDN(self.bottom_bg, bg_res2, ResourcesType.single, self.item_load2) 
end

function CrossServerThemeWindow:openRootWnd(index,endtime)
    self:setData(index,endtime)
end


function CrossServerThemeWindow:close_callback()
    controller:openCrossServerThemeWindow(false)
    if self.item_load then
        self.item_load:DeleteMe()
    end
    self.item_load = nil
    if self.item_load2 then
        self.item_load2:DeleteMe()
    end
    self.item_load2 = nil
end
