function HistoricalBattleReportWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.root_csb = self.root_wnd:getChildByName("main_container")
    self.main_panel = self.root_csb:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel, 1)
    self.Image_2 = self.main_panel:getChildByName("Image_2")
    self.win_title = self.main_panel:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5839"))
    self.Image_2:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.Image_2:getContentSize().height))
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.switch_panel = self.main_panel:getChildByName("switch_panel")
    self.switch_bg = self.switch_panel:getChildByName("switch_bg")
    self.left_btn = self.switch_panel:getChildByName("left_btn")
    self.title = self.switch_panel:getChildByName("title")
    self.right_btn = self.switch_panel:getChildByName("right_btn")
    self.expect_panel = self.main_panel:getChildByName("expect_panel")
    self.select_tip = self.expect_panel:getChildByName("select_tip")
    local res = PathTool.getResFrame("common_1","common_1_90002")
    loadSpriteTexture(self.select_tip, res, LOADTEXT_TYPE_PLIST)
    self.battle_report_panel = self.main_panel:getChildByName("battle_report_panel")
    self.line_1 = self.battle_report_panel:getChildByName("line_1")
    self.battle_report_title = self.battle_report_panel:getChildByName("title")
    self.line_2 = self.battle_report_panel:getChildByName("line_2")
    self.battle_report_bg = self.battle_report_panel:getChildByName("battle_report_bg")
    self.time_panel = self.battle_report_panel:getChildByName("time_panel")
    self.time_txt = self.time_panel:getChildByName("time_txt")
    self.time_label = self.time_panel:getChildByName("time_label")
    self.time_label:setString(TI18N("语言_c_5431"))
    self.cross_server_theme = self.battle_report_panel:getChildByName("cross_server_theme")
    self.cross_server_theme_txt = self.cross_server_theme:getChildByName("Text_1")
    setTextMaxWidth(self.cross_server_theme_txt,77)
    self.cross_server_theme_txt:setString(TI18N("语言_c_5432"))
    for i=1,9 do
        local station_lay = self.battle_report_panel:getChildByName("station_lay_"..i)
        local station_item = {}
        station_item.station_lay = station_lay
        station_item.title_img = station_lay:getChildByName("title_img")
        station_item.title_img_y = station_item.title_img:getPositionY()
        station_item.mode_node = station_lay:getChildByName("mode_node")
        station_item.name_bg = station_lay:getChildByName("name_bg")
        station_item.name = station_lay:getChildByName("name")
        station_item.name:setColor(cc.c3b(0xff,0xff,0xff))
        station_item.name:enableOutline(cc.c4b(108,94,78,0xff), 2)
        station_item.namey = station_item.name:getPositionY()
        self.station_list[i] = station_item
    end
end 

function HistoricalBattleReportWindow:register_event()
    registerButtonEventListener(self.close_btn, function(param,sender, event_type)
        self.controller:openHistoricalBattleReportWindow(false)
    end ,false, 1)
    registerButtonEventListener(self.background, function(param,sender, event_type)
        self.controller:openHistoricalBattleReportWindow(false)
    end ,false, 1)
    registerButtonEventListener(self.cross_server_theme, function(param,sender, event_type)
        self.controller:openViewTheaterPanel(true)
    end ,false, 1)
    -- if self.primus_list then
    --     for key, value in pairs(self.primus_list) do
    --         registerButtonEventListener(v, function(param,sender, event_type)
    --             self.select_tip:setPositionX(value:getPositionX())
    --         end ,false, 1)
    --     end
    -- end
    self:addGlobalEvent(PrimusEvent.Updata_Primus_Historical,function(data)
        self.canSend = 1
        self:setData(data)
    end)
    registerButtonEventListener(self.right_btn, function()
        self.fitNum = self.fitNum + 1
        self.controller:sender21812(self.myserver,self.fitNum,self.model:getCrossServerPrimusRound())
        if self.fitNum >= self.model:getCrossServerPrimusFitNum() then
            self.right_btn:setVisible(false)
        else
            self.right_btn:setVisible(true)
        end
    end ,false, 1)
    registerButtonEventListener(self.left_btn, function()
        self.fitNum = self.fitNum - 1
        self.controller:sender21812(self.myserver,self.fitNum,self.model:getCrossServerPrimusRound())
        if self.fitNum <= 1 then
            self.left_btn:setVisible(false)
        else
            self.left_btn:setVisible(true)
        end
    end ,false, 1)
end

function HistoricalBattleReportWindow:setData(data)
    self.data = data
    self.list = self.data.list
    if tableLen(self.list) == 0 then
        self.list = self.futurelist
    end
    if data.end_time == 0 or data.end_time > GameNet:getInstance():getTime() then
        self.time_panel:setVisible(false)
    else
        self.time_panel:setVisible(true)
        local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
        local y = TimeTool.xsdate("%Y",data.end_time,timezone)
        local m = TimeTool.xsdate("%m",data.end_time,timezone)
        local d = TimeTool.xsdate("%d",data.end_time,timezone)
        local str = string.format(TI18N("%s-%s-%s"),y,m,d)
        self.time_txt:setString(str)
    end
    self.myserver = data.server_id
    self.fitNum = data.num
    if self.fitNum <= 1 then
        self.left_btn:setVisible(false)
    else
        self.left_btn:setVisible(true)
    end
    if self.fitNum >= self.model:getCrossServerPrimusFitNum() then
        self.right_btn:setVisible(false)
    else
        self.right_btn:setVisible(true)
    end
    self.roundNum = data.round
    self:setthemelist()
    self:setStation()
end
function HistoricalBattleReportWindow:setthemelist()
    self.constant_cfg = deepCopy(Config.PrimusElementData.data_constant)
    self.primus_desc_cfg = deepCopy(Config.PrimusElementData.data_primus_desc)
    self.season_rotation = {}
    local season_rotation = self.constant_cfg["season_rotation"].val
    for key, value in pairs(season_rotation) do
        table.insert(self.season_rotation, value[1], value[2])
    end
    for key, value in pairs(self.season_rotation) do
        local cfg = self.primus_desc_cfg[value]
        local res = PathTool.getResFrame("common", cfg.pic_icon)
        if res == "common_99999.png" then
            res = PathTool.getResFrame("primus_element", cfg.pic_icon)
        end
        local _x = self.expect_panel:getContentSize().width / tableLen(self.season_rotation) * (key-0.5)
        if not self.primus_list[key] then
            local img = createImage(self.expect_panel,res,_x,25,cc.p(0.5,0.5),true,1,true)
            self.primus_list[key] = img
            img:setTouchEnabled(true)
            img:ignoreContentAdaptWithSize(true)
            if value ~= self.model.theme_attribute.All then
                img:setScale(0.9)
            end
            img:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    self:primusCallBack(key)
                    if value ~= self.model.theme_attribute.All then
                        img:setScale(0.9)
                    else
                        img:setScale(1)
                    end     
                elseif event_type == ccui.TouchEventType.began then
                    if value ~= self.model.theme_attribute.All then
                        img:setScale(0.8)
                    else
                        img:setScale(0.9)
                    end  
                end
            end)
        end
    end
    self.select_tip:setPositionX(self.primus_list[self.roundNum]:getPositionX())
    self.themeNum = self.primus_desc_cfg[self.season_rotation[self.roundNum]].type
    self.battle_report_title:setString(self.primus_desc_cfg[self.themeNum].imp_desc)
    self.line_2:setPositionX(self.battle_report_title:getPositionX() + self.battle_report_title:getContentSize().width/2 + 20)
    self.line_1:setPositionX(self.battle_report_title:getPositionX() - self.battle_report_title:getContentSize().width/2 - 20)
    self.title:setString(string.format(TI18N("语言_c_5435"),StringUtil.numToChinese(self.fitNum)))
end
function HistoricalBattleReportWindow:primusCallBack(index)
    if self.canSend == 1 then
        if self.fitNum == self.model:getCrossServerPrimusFitNum() and index > self.model:getCrossServerPrimusRound() then
            self.list = self.futurelist
            self:setStation()
        elseif self.fitNum > self.model:getCrossServerPrimusFitNum() then
            self.list = self.futurelist
            self:setStation()
        else
            self.controller:sender21812(self.myserver,self.fitNum,index)
            self.canSend = 0
        end
        self.select_tip:setPositionX(self.primus_list[index]:getPositionX())
        self.themeNum = self.primus_desc_cfg[self.season_rotation[index]].type
        self.battle_report_title:setString(self.primus_desc_cfg[self.themeNum].imp_desc)
        self.line_2:setPositionX(self.battle_report_title:getPositionX() + self.battle_report_title:getContentSize().width/2 + 20)
        self.line_1:setPositionX(self.battle_report_title:getPositionX() - self.battle_report_title:getContentSize().width/2 - 20)
    else
        message(TI18N("语言_c_4359"))
    end
end

--模型
function HistoricalBattleReportWindow:setStation()
    self.is_have_title = false
    table.sort(self.list, function(a, b) return a.pos < b.pos end)
    if not self.station_list then return end
    for i,v in ipairs(self.list) do
        if self.station_list[v.pos] then
            self.station_list[v.pos].sever_data = v
            self.station_list[v.pos].local_data = Config.PrimusElementData.data_primus_info[self.themeNum][v.pos]

            self:updateStationInfoByPos(v.pos)
            --有数据才有监听
            -- registerButtonEventListener(self.station_list[i].station_lay, function() self:_onClickByPosIndex(v.pos) end ,false, 2)
        end
    end
end
function HistoricalBattleReportWindow:_onClickByPosIndex(pos_index)
    if self.station_list and self.station_list[pos_index] and self.station_list[pos_index].sever_data then
        FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.station_list[pos_index].sever_data.srv_id, rid = self.station_list[pos_index].sever_data.rid})
        -- self.ctrl:openCrossServerPrimusChallengePanel(true, self.station_list[pos_index].sever_data, self.is_have_title)
    end
end
function HistoricalBattleReportWindow:updateStationInfoByPos(pos_index)
    local station_item = self.station_list[pos_index]
    if not station_item then return end
    local sever_data = station_item.sever_data 
    if not sever_data then return end
    local is_self = false
    --称号
    if station_item.local_data then
        local honor_data = Config.HonorData.data_title[station_item.local_data.name_id] 
        local offset_y = 0
        local look_config = Config.LooksData.data_data[sever_data.look_id]
        if look_config then
            offset_y = (look_config.offset_y + 20) or 20
        end
        station_item.title_img:setPositionY(station_item.title_img_y + offset_y)
        if honor_data then
            local res = PathTool.getPlistImgForDownLoad("honor","txt_cn_honor_"..honor_data.res_id,false)
            station_item.item_load = loadSpriteTextureFromCDN(station_item.title_img, res, ResourcesType.single, station_item.item_load)
        end   
    end
    --名字
    station_item.name:setColor(cc.c3b(0xff,0xff,0xff))
    station_item.name:enableOutline(cc.c4b(108,94,78,0xff), 2)--(cc.c3b(0xff,0xff,0xff))
    if sever_data.name == nil or sever_data.name == "" then
        station_item.name:setString(TI18N("语言_c_526"))
        station_item.name:setPositionY(station_item.station_lay:getContentSize().height/2)
        station_item.name_bg:setVisible(false)
        station_item.station_lay:setTouchEnabled(false)
        -- local look_id = self:getLookIdByData(station_item) or 340502
        -- --模型
        -- self:updateSpine(look_id, pos_index)
        station_item.mode_node:removeAllChildren()
        if station_item.spine then
            station_item.spine = nil
        end
    else
        station_item.station_lay:setTouchEnabled(true)
        station_item.name:setString(sever_data.name)
        station_item.name:setPositionY(station_item.namey)
        station_item.name_bg:setVisible(true)
        local roleVo = RoleController:getInstance():getRoleVo()
        if roleVo and sever_data.rid == roleVo.rid and sever_data.srv_id == roleVo.srv_id then 
            self.is_have_title = true
            is_self = true
            station_item.name:setColor(cc.c3b(0x14,0xff,0x32))
        else
            station_item.name:setColor(cc.c3b(255,255,67))
            station_item.name:enableOutline(cc.c4b(157,99,15,0xff), 2)
        end

        --模型 
        -- station_item.mode_node:removeAllChildren()
        -- if station_item.spine then
        --     station_item.spine = nil
        -- end
        self:updateSpine(sever_data.look_id, pos_index, is_self)
    end
end

function HistoricalBattleReportWindow:getLookIdByData( station_item)
    if not station_item then return end
    local sever_data = station_item.sever_data
    if station_item.unit_data_list == nil then
        station_item.unit_data_list = {} 
        local table_insert = table.insert
        for i,v in pairs(Config.PrimusElementData.data_single_info) do
            if sever_data.pos == v.pos and self.themeNum == v.type then
                table_insert(station_item.unit_data_list, v)
            end
        end
        table.sort( station_item.unit_data_list, function(a,b) return a.min < b.min end)
    end
    local num = sever_data.num
    local cur_data = nil
    local lenght = #station_item.unit_data_list
    for i,v in ipairs(station_item.unit_data_list) do
        if num >= v.min and num <= v.max then
            cur_data = v
            break
        end
        if i == lenght then
            cur_data = v
        end
    end
    if cur_data == nil then
        return
    end
    return cur_data.look_id
end
--更新模型,也是初始化模型
function HistoricalBattleReportWindow:updateSpine(look_id, pos_index, is_self)
    local station_item = self.station_list[pos_index]
    if not station_item then return end
    local fashion_id =  0
    local fun = function()
        if not station_item.spine then
            station_item.spine = BaseRole.new(BaseRole.type.role, look_id)
            station_item.spine:setAnimation(0,PlayerAction.show,true) 
            station_item.spine:setCascade(true)
            station_item.spine:setPosition(cc.p(0,45))
            station_item.spine:setAnchorPoint(cc.p(0.5,0.5)) 
            station_item.spine:setScale(0.8)
            station_item.mode_node:addChild(station_item.spine) 
            station_item.spine:setCascade(true)
            station_item.spine:setOpacity(0)
            local action = cc.FadeIn:create(0.2)
            station_item.spine:runAction(action)
        end
    end
    if station_item.spine then
        station_item.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        station_item.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
                doStopAllActions(station_item.spine)
                station_item.spine:removeFromParent()
                station_item.spine = nil
                fun()
        end)))
    else
        fun()
    end
end

function HistoricalBattleReportWindow:openRootWnd()
    self.myserver = self.model:getCrossServerPrimusServerId()
    self.fitNum = self.model:getCrossServerPrimusFitNum()
    self.roundNum = self.model:getCrossServerPrimusRound()
    self.controller:sender21812(self.myserver,self.fitNum,self.roundNum)
end


function HistoricalBattleReportWindow:close_callback()
    self.controller:openHistoricalBattleReportWindow(false)
end
