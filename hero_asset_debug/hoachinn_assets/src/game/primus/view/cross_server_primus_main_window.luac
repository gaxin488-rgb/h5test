CrossServerPrimusMainWindow = CrossServerPrimusMainWindow or BaseClass(BaseView)

local table_sort = table.sort
local string_format = string.format

function CrossServerPrimusMainWindow:__init()
    self.ctrl = PrimusController:getInstance()
    self.model = self.ctrl:getModel()
    self.win_type = WinType.Full
    self.layout_name = "primus/cross_server_primus_main_window"

    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_4"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_5"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_6"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_12"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_13"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("primus_element", "primus_element_14"), type = ResourcesType.single},
    }
    self.station_list = {}
    self.tips_list = {}
    self.box_effect = nil
    self.themeNum = 0
    self.box_state = 0
end

function CrossServerPrimusMainWindow:open_callback()
    self.ScrollView_1 = self.root_wnd:getChildByName("ScrollView_1")
    self.ScrollView_1:setScrollBarEnabled(false)
    local _h = display.size.height
    self.ScrollView_1:setContentSize(cc.size(720, _h))
    self.ScrollView_1:setPositionY(0-(_h - 1280)/2)
    self.Panel_1 = self.ScrollView_1:getChildByName("Panel_1")
    self.primus_element_13_1 = self.Panel_1:getChildByName("primus_element_13_1")
    self.primus_element_13_1:setScale( display.getMaxScale())
    self.primus_element_14_2 = self.Panel_1:getChildByName("primus_element_14_2")
    self.ScrollView_1:setInnerContainerSize(cc.size(720,1713 +70))
    self.Panel_1:setPositionY(self.ScrollView_1:getInnerContainerSize().height)
    self.main_container = self.root_wnd:getChildByName("main_container")
    -- self.main_panel = self.main_container:getChildByName("main_panel")
    self.tips_panel = self.main_container:getChildByName("tips_panel")
    self.title = self.tips_panel:getChildByName("title")
    self.title:setString(TI18N("语言_c_2543"))
    self.tips1 = createRichLabel(20, 1, cc.p(0,0), cc.p(5,65),nil,nil,500)
    self.tips_panel:addChild(self.tips1)
    self.tips_list[1] = self.tips1
    self.tips2 = createRichLabel(20, 1, cc.p(0,0), cc.p(5,35),nil,nil,500)
    self.tips_panel:addChild(self.tips2)
    self.tips_list[2] = self.tips2
    self.tips3 = createRichLabel(20, 1, cc.p(0,0), cc.p(5,5),nil,nil,500)
    self.tips_panel:addChild(self.tips3)
    self.tips_list[3] = self.tips3
    self.explain_btn = self.main_container:getChildByName("explain_btn")
    self.exit_btn = self.main_container:getChildByName("exit_btn")
    self.exit_btn:ignoreContentAdaptWithSize(true)
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title_lab = self.title_bg:getChildByName("title_lab")
    self.title_lab:setString(TI18N("语言_c_5779"))
    self.time_panel = self.main_container:getChildByName("time_panel")
    self.time_label = self.main_container:getChildByName("time_label")
    self.time_label:setString(TI18N("语言_c_5426"))
    self.time_txt = self.main_container:getChildByName("time_txt")
    self.log_battle_report_btn = self.main_container:getChildByName("log_battle_report_btn")
    self.log_battle_report_btn_txt = self.log_battle_report_btn:getChildByName("Text_1")
    self.log_battle_report_btn_txt:setString(TI18N("语言_c_5427"))
    setTextMaxWidth(self.log_battle_report_btn_txt,100,-10)
    self.cross_server_theme = self.main_container:getChildByName("cross_server_theme")
    self.cross_server_theme:setPositionY(self.log_battle_report_btn:getPositionY() - self.log_battle_report_btn:getContentSize().height - 30)
    self.cross_server_theme_txt = self.cross_server_theme:getChildByName("Text_1")
    self.cross_server_theme_txt:setString(TI18N("语言_c_5420"))
    setTextMaxWidth(self.cross_server_theme_txt,100,-10)
    self.box_panel = self.main_container:getChildByName("box_panel")
    self.treasure_chest = self.box_panel:getChildByName("treasure_chest")
    self.treasure_chest_num = self.box_panel:getChildByName("treasure_chest_num")
    self.treasure_chest_num:setString(TI18N("%s/%s"))
    self.treasure_chest_name = self.box_panel:getChildByName("treasure_chest_name")
    self.treasure_chest_name:setString(TI18N("语言_c_5428"))
    setTextSpacing(self.treasure_chest_name,-10)
    
    for i=1,9 do
        local station_lay = self.Panel_1:getChildByName("station_lay_"..i)
        local station_item = {}
        station_item.station_lay = station_lay
        station_item.title_img = station_lay:getChildByName("title_img")
        station_item.title_img_y = station_item.title_img:getPositionY()
        station_item.mode_node = station_lay:getChildByName("mode_node")
        station_item.name = station_lay:getChildByName("name")
        station_item.name:setColor(cc.c3b(0xff,0xff,0xff))
        station_item.name:enableOutline(cc.c4b(108,94,78,0xff), 2)
        self.station_list[i] = station_item
    end
    --设置适配
    self:adaptationScreen()
end
--设置适配屏幕
function CrossServerPrimusMainWindow:adaptationScreen()
    -- 对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)
    local container_size = self.main_container:getContentSize()

    --主菜单 顶部的高度
    local top_height = MainuiController:getInstance():getMainUi():getTopViewHeight()
    --主菜单 底部的高度
    local bottom_height = MainuiController:getInstance():getMainUi():getBottomHeight()

    local offy = top_y - 80   --top_height- 10
    self.title_bg:setAnchorPoint(cc.p(0.5,1))
    self.title_bg:setPosition(cc.p(390, offy))
    if top_y <= SCREEN_HEIGHT then 
        self.title_bg:setScale(display.getMaxScale())
    end

    self.explain_btn:setAnchorPoint(cc.p(0.5,1))
    self.explain_btn:setPositionY(offy)
    
    self.tips_panel:setPosition(cc.p(left_x + 2, bottom_y + bottom_height + 8)) --8 是偏移量
    self.exit_btn:setPosition(cc.p(right_x - 2, bottom_y + bottom_height + 8)) --8 是偏移量

    local tab_y = self.log_battle_report_btn:getPositionY()
    self.log_battle_report_btn:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.cross_server_theme:getPositionY()
    self.cross_server_theme:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.time_panel:getPositionY()
    self.time_panel:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.time_label:getPositionY()
    self.time_label:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.time_txt:getPositionY()
    self.time_txt:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.box_panel:getPositionY()
    self.box_panel:setPositionY(top_y - (container_size.height - tab_y))
end

function CrossServerPrimusMainWindow:register_event()
    registerButtonEventListener(self.exit_btn, function(param,sender, event_type)
        self.ctrl:openCrossServerPrimusMainWindow(false)
    end ,false, 1)
    registerButtonEventListener(self.explain_btn, function(param,sender, event_type)
        local config = Config.PrimusElementData.data_constant["main_rule"]
        TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition(),nil,nil,500)
    end ,false, 1)
    registerButtonEventListener(self.cross_server_theme, function(param,sender, event_type)
        local round = self.model:getCrossServerPrimusRound()
        if not round then return end
        self.ctrl:openCrossServerThemeWindow(true,round,self.model:getCrossServerPrimusEndTime())
    end ,true, 1)
    registerButtonEventListener(self.log_battle_report_btn, function(param,sender, event_type)
        self.ctrl:openHistoricalBattleReportWindow(true)
    end ,true, 1)
    registerButtonEventListener(self.treasure_chest, function(param,sender, event_type)
        if self.box_state == 2 then
            self.ctrl:sender21810()
            return
        end
        self.ctrl:openCrossServerPrimusBoxRewardWindow(true,self.themeNum)
    end ,true, 1)
    
    self:addGlobalEvent(PrimusEvent.Updata_Primus_BoxReward,function(data)
        self:updateBoxReward(data)
    end)
end
function CrossServerPrimusMainWindow:updateBoxReward(data)
    local cfg = Config.PrimusElementData.data_primus_desc[self.model:getCrossServerPrimusThemeNum()]
    if not cfg then return end
    local cfg_list = cfg.fit_reward
    local reward_list = {}
    for key, value in pairs(cfg_list) do
        table.insert(reward_list, key, value[1])
    end
    local isCan = true
    local targetNum = reward_list[#reward_list]
    for key, value in pairs(reward_list) do
        if value > data.num then
            if isCan then
                targetNum = value
                isCan = false
            end
        end
    end
    if self.treasure_chest_num then
        self.treasure_chest_num:setString(string.format("%s/%s", data.num,targetNum))
    end
    local action = PlayerAction.action_1
    self.box_state = 1
    local isAction2 = false
    for key, value in pairs(reward_list) do
        if data.reward_num < value and data.num >= value then
            if not isAction2 then
                isAction2 = true
            end
        end
    end
    if isAction2 then
        action = PlayerAction.action_2
        self.box_state = 2
    elseif data.reward_num >= reward_list[tableLen(reward_list)] then
        action = PlayerAction.action_3
        self.box_state = 3
    end
    if self.box_effect then
        self.box_effect:clearTracks()
        self.box_effect:removeFromParent()
        self.box_effect = nil
    end
    if not tolua.isnull(self.treasure_chest) and self.box_effect == nil then
        self.box_effect = createEffectSpine(PathTool.getEffectRes(602), cc.p(self.treasure_chest:getContentSize().width * 0.5, self.treasure_chest:getContentSize().height * 0.5-20), cc.p(0, 0), true, action)
        self.treasure_chest:addChild(self.box_effect)
    end
end
function CrossServerPrimusMainWindow:openRootWnd()
    self.ctrl:sender21800()
    self.ctrl:sender21801()
    self.ctrl:sender21808() 
    self.ctrl:sender21813() 
    self.model:setCrossFirstLogin(false)
    MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.CrossPrimusWar)
end

function CrossServerPrimusMainWindow:setData(data)
    self.list = data.list
    self.themeNum = self.model:getCrossServerPrimusThemeNum()
    if not self.themeNum then return end
    local list = self.model:getCrossServerPrimusData()
    if not list then return end
    if list then
        self:updateBoxReward(list)
    end
    local time = self.model:getCrossServerPrimusEndTime()
    if not time then return end
    local endtime = time - GameNet:getInstance():getTime()
    if endtime > 0 then
        doStopAllActions(self.time_txt)
        commonCountDownTime(self.time_txt,endtime or 0,{end_callback = function(time) 
            if time <= 0 then
                self.ctrl:openCrossServerPrimusMainWindow(false)
            end
        end})
    end
    if self.time_label and not tolua.isnull(self.time_label) then
        self.time_label:setPositionX(self.time_txt:getPositionX() - self.time_txt:getContentSize().width-10)
        self.time_panel:setContentSize(cc.size(self.time_label:getContentSize().width + self.time_txt:getContentSize().width + 20,self.time_panel:getContentSize().height))
    end

    self.is_have_title = false
    table_sort(self.list, function(a, b) return a.pos < b.pos end)
    if not self.station_list then return end
    for i,v in ipairs(self.list) do
        if self.station_list[v.pos] then
            self.station_list[v.pos].sever_data = v
            self.station_list[v.pos].local_data = Config.PrimusElementData.data_primus_info[self.themeNum][v.pos]
            delayRun(self.station_list[v.pos].station_lay, 0.1*i, function() 
                self:updateStationInfoByPos(v.pos)
            end)
            --有数据才有监听
            registerButtonEventListener(self.station_list[i].station_lay, function() self:_onClickByPosIndex(v.pos) end ,false, 2)
        end
    end
    self:setIdList()
    --挑战条件
    local tip_width_list = {}
    for key, value in pairs(self.tips_list) do
        local local_data = Config.PrimusElementData.data_primus_info[self.themeNum][self.id_list[key]]
        local str = string_format(TI18N("语言_c_2544"), local_data.name, local_data.arena_rank)
        value:setString(str)
        local _w = value:getContentSize().width
        table.insert(tip_width_list, _w)
    end
    table.sort(tip_width_list,function(a,b) return a>b end)
    if self.tips_panel then
        self.tips_panel:setContentSize(cc.size(tip_width_list[1] + 10, self.tips_panel:getContentSize().height))
    end
end
function CrossServerPrimusMainWindow:setIdList()
    self.id_list = {}
    local cfg = deepCopy(Config.PrimusElementData.data_primus_info[self.themeNum])
    for key, value in pairs(cfg) do
        local isIndexOf = table.indexof(self.id_list,value.group)
        if not isIndexOf then
            table.insert(self.id_list, key)
        end
    end
end
function CrossServerPrimusMainWindow:_onClickByPosIndex(pos_index)
    if self.station_list and self.station_list[pos_index] and self.station_list[pos_index].sever_data then
        self.ctrl:openCrossServerPrimusChallengePanel(true, self.station_list[pos_index].sever_data, self.is_have_title)
    end
end
function CrossServerPrimusMainWindow:updateStationInfoByPos(pos_index)
    local station_item = self.station_list[pos_index]
    if not station_item then return end
    local sever_data = station_item.sever_data 
    if not sever_data then return end
    local is_self = false
    --称号
    if station_item.local_data then
        local honor_data = Config.HonorData.data_title[station_item.local_data.honor_id] 
        local offset_y = 0
        local look_config = Config.LooksData.data_data[sever_data.look_id]
        if look_config then
            offset_y = (look_config.offset_y + 20) or 20
        end
        station_item.title_img:setPositionY(station_item.title_img_y + offset_y)
        if honor_data then
            local res = PathTool.getPlistImgForDownLoad("honor","txt_cn_honor_"..honor_data.res_id,false)
            station_item.item_load = loadSpriteTextureFromCDN(station_item.title_img, res, ResourcesType.single, station_item.item_load)
        end   
    end
    --名字
    station_item.name:setColor(cc.c3b(0xff,0xff,0xff))
    station_item.name:enableOutline(cc.c4b(108,94,78,0xff), 2)--(cc.c3b(0xff,0xff,0xff))
    if sever_data.name == nil or sever_data.name == "" then
        station_item.name:setString(TI18N("语言_c_526"))
        local look_id = self:getLookIdByData(station_item) or 340502
        --模型
        self:updateSpine(look_id, pos_index)
    else
        station_item.name:setString(sever_data.name)
        local roleVo = RoleController:getInstance():getRoleVo()
        if roleVo and sever_data.rid == roleVo.rid and sever_data.srv_id == roleVo.srv_id then 
            self.is_have_title = true
            is_self = true
            station_item.name:setColor(cc.c3b(0x14,0xff,0x32))
        else
            station_item.name:setColor(cc.c3b(255,255,67))
            station_item.name:enableOutline(cc.c4b(157,99,15,0xff), 2)
        end

        --模型 
        self:updateSpine(sever_data.look_id, pos_index, is_self)
    end
end

function CrossServerPrimusMainWindow:getLookIdByData( station_item)
    if not station_item then return end
    local sever_data = station_item.sever_data
    if station_item.unit_data_list == nil then
        station_item.unit_data_list = {} 
        local table_insert = table.insert
        for i,v in pairs(Config.PrimusElementData.data_single_info) do
            if sever_data.pos == v.pos and self.themeNum == v.type then
                table_insert(station_item.unit_data_list, v)
            end
        end
        table.sort( station_item.unit_data_list, function(a,b) return a.min < b.min end)
    end
    local num = sever_data.num
    local cur_data = nil
    local lenght = #station_item.unit_data_list
    for i,v in ipairs(station_item.unit_data_list) do
        if num >= v.min and num <= v.max then
            cur_data = v
            break
        end
        if i == lenght then
            cur_data = v
        end
    end
    if cur_data == nil then
        return
    end
    return cur_data.look_id
end
--更新模型,也是初始化模型
function CrossServerPrimusMainWindow:updateSpine(look_id, pos_index, is_self)
    local station_item = self.station_list[pos_index]
    if not station_item then return end
    local fashion_id =  0
    local fun = function()
        if not station_item.spine then
            station_item.spine = BaseRole.new(BaseRole.type.role, look_id)
            station_item.spine:setAnimation(0,PlayerAction.show,true) 
            station_item.spine:setCascade(true)
            station_item.spine:setPosition(cc.p(0,45))
            station_item.spine:setAnchorPoint(cc.p(0.5,0.5)) 
            station_item.spine:setScale(0.8)
            station_item.mode_node:addChild(station_item.spine)
            station_item.spine:setCascade(true)
            station_item.spine:setOpacity(0)
            local action = cc.FadeIn:create(0.2)
            station_item.spine:runAction(action)
        end
    end
    if station_item.spine then
        station_item.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        station_item.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
                doStopAllActions(station_item.spine)
                station_item.spine:removeFromParent()
                station_item.spine = nil
                fun()
        end)))
    else
        fun()
    end
end
function CrossServerPrimusMainWindow:close_callback()    
    if self.box_effect then
        self.box_effect:clearTracks()
        self.box_effect:removeFromParent()
        self.box_effect = nil
    end
    for k,item in pairs(self.station_list) do
        doStopAllActions(item.station_lay)
        if item.spine then
            item.spine:DeleteMe()
            item.spine = nil
        end
        if item.item_load then
            item.item_load:DeleteMe()
            item.item_load = nil
        end
    end
    doStopAllActions(self.time_txt)
    self.ctrl:openCrossServerPrimusMainWindow(false)
end
