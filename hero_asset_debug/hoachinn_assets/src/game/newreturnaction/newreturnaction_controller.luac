NewReturnActionController = NewReturnActionController or BaseClass(BaseController)
local const_data = Config.HolidayReturnNewData.data_constant
function NewReturnActionController:config()
    self.model = NewReturnActionModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function NewReturnActionController:getModel()
    return self.model
end

function NewReturnActionController:registerEvents()

end

function NewReturnActionController:registerProtocals()
	self:RegisterProtocal(11500, "handle11500") -- 回归基础信息
	self:RegisterProtocal(11501, "handle11501") -- 请求资源回溯信息
	self:RegisterProtocal(11502, "handle11502") -- 请求充值礼包信息
	self:RegisterProtocal(11503, "handle11503") -- 请求登陆赠礼信息
	self:RegisterProtocal(11504, "handle11504") -- 领取资源回溯奖励
	self:RegisterProtocal(11505, "handle11505") -- 领取登录赠礼奖励
	self:RegisterProtocal(11506, "handle11506") -- 超值特惠0元购买
	self:RegisterProtocal(11507, "handle11507") -- 活动红点
end

--回归基础信息
function NewReturnActionController:sender11500()
    self:SendProtocal(11500,{})
end
function NewReturnActionController:handle11500(data)
	self.model:setBasicInfo(data)
end
--请求资源回溯信息
function NewReturnActionController:sender11501()
    self:SendProtocal(11501,{})
end
function NewReturnActionController:handle11501(data)
	self.model:setResBackInfo(data)	
end
--请求充值礼包信息
function NewReturnActionController:sender11502()
    self:SendProtocal(11502,{})
end
function NewReturnActionController:handle11502(data)
	self.model:setChargeGiftInfo(data)
end
--请求登陆赠礼信息
function NewReturnActionController:sender11503()
    self:SendProtocal(11503,{})
end
-- NewReturnActionController:handle11503({login_day=2,reward={{day=1}}})
function NewReturnActionController:handle11503(data)
	-- print("handle11503",vardump(data))
	self.model:setLoginGiftInfo(data)
end
--领取资源回溯奖励
function NewReturnActionController:sender11504()
    self:SendProtocal(11504,{})
end
function NewReturnActionController:handle11504(data)
	message(data.msg)
end
--领取登录赠礼奖励
function NewReturnActionController:sender11505(day)
	local protocal = {}
    protocal.day = day
    self:SendProtocal(11505,protocal)
end
function NewReturnActionController:handle11505(data)
	message(data.msg)
end
--超值特惠0元购买
function NewReturnActionController:sender11506(charge_id)
	local protocal = {}
    protocal.charge_id = charge_id
    self:SendProtocal(11506,protocal)
end
function NewReturnActionController:handle11506(data)
	message(data.msg)
end
--活动红点
function NewReturnActionController:sender11507()
    self:SendProtocal(11507,{})
end
function NewReturnActionController:handle11507(data)
	self.model:setReturnRed(data)
end

---------------------------------------
--打开或关闭回归活动界面
function NewReturnActionController:openNewReturnActionMainWindow(status)
	if status == false then
		if self.new_return_action_view ~= nil then
			self.new_return_action_view:close()
			self.new_return_action_view = nil
		end
	else
		if not self.model:isHideNewReturn() then
			if self.new_return_action_view == nil then
				self.new_return_action_view = NewReturnActionMainWindow.New()
			end
			if self.new_return_action_view:isOpen() == false then
				self.new_return_action_view:open()
			end
		end
	end
end
