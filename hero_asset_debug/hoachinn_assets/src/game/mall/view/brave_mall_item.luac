-- --------------------------------------------------------------------
-- 竖版商城单个item
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
BraveMallItem = class("BraveMallItem", function()
	return ccui.Widget:create()
end)

function BraveMallItem:ctor()
   	self.is_limit = false
	self.limit_have_num = 0
	self.lock_desc = ""
	self.special_item_id = {10005,80001}   -- 英魂商店的消耗物品,这个商店非资产类的
    self.ctrl = MallController:getInstance()
    self.role_vo = RoleController:getInstance():getRoleVo()
	self:configUI()
end

function BraveMallItem:configUI( ... )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("mall/mall_item"))
	
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(306,143))
	self:setTouchEnabled(true)

    self.main_container = self.root_wnd:getChildByName("main_container")
	self.main_container:setTouchEnabled(true)
	self.main_container:setSwallowTouches(false)

	self.name_panel = self.main_container:getChildByName("name_panel")
	self.name = self.name_panel:getChildByName("name")
	self.name:ignoreContentAdaptWithSize(true)
	self.name:setTextAreaSize(cc.size(170, 0))--165
	setTextSpacing(self.name, -6)
	local count_bg = self.main_container:getChildByName("count_bg")
	self.coin = count_bg:getChildByName("coin")
	self.price = count_bg:getChildByName("price")

	self.discount = self.main_container:getChildByName("discount")
	self.discount:setLocalZOrder(20)
	self.discount_num = self.discount:getChildByName("discount_num")
	self.discount:setVisible(false)

	self.discount_label = createRichLabel(20,58,cc.p(0,1),cc.p(133,40),FONT_COMMON_LINE_SPACE,nil,174)
	self.discount_label:setString("")
	self.main_container:addChild(self.discount_label)
	self.discount_label:setVisible(false)

	self.sold = self.main_container:getChildByName("sold")
	self.sold:setLocalZOrder(20)
	self.sold:setVisible(false)

	self.grey = self.main_container:getChildByName("grey")
	self.grey:setVisible(false)
	self.grey:setLocalZOrder(2)

	self.need_icon = self.main_container:getChildByName("need_icon")
	self.need_label = self.main_container:getChildByName("need_label")
	self.need_label:setString(TI18N("语言_c_4953"))
	self.need_icon:setVisible(false)
	self.need_label:setVisible(false)

	self:setSellAll( false )

	self:registerEvent()
end

function BraveMallItem:setData( data )
	local shop_num --商城类型
	if data.shop_type then 
		shop_num = data.shop_type
	else
		shop_num = data.type
	end 
	self.data = data	
	local pay_config
	local pay_type = data.pay_type
	local own_sum = 0
	if type(data.pay_type) == "number" then
		pay_config = Config.ItemData.data_get_data(data.pay_type)
		if table.indexof(self.special_item_id,data.pay_type) then
			own_sum = BackpackController:getInstance():getModel():getItemNumByBid(data.pay_type)
		else
			pay_type = Config.ItemData.data_assets_id2label[data.pay_type]
		end
	else
		pay_config = Config.ItemData.data_get_data(Config.ItemData.data_assets_label2id[data.pay_type])
		pay_type = data.pay_type
	end
	if not pay_config then return end

	self.pay_type = pay_type
	
	local item_id = data.item_bid or data.item_id
	local count = data.item_num or 1
	if not self.goods_item then
		self.goods_item = BackPackItem.new(true,true)
		self.goods_item:setPosition(10+self.goods_item:getContentSize().width/2,self:getContentSize().height/2)
		self.main_container:addChild(self.goods_item)
		self.goods_item:setDefaultTip()
	end
	self.goods_item:showTagIcon(false)
	self.goods_item:setBaseData(item_id, count, nil, true)
	if self.goods_item.data then
		self.name:setString(self.goods_item.data.name)
	end

	self.price:setString(data.price)
	local res = ""
	if pay_config.is_payval == 1 then
		res = PathTool.getItemRes("txt_cn_"..pay_config.icon, false)
	else
		res = PathTool.getItemRes(pay_config.icon, false)
	end
	loadSpriteTexture(self.coin, res, LOADTEXT_TYPE)
	
	--限购
	self.str = ""
	local limit_num = 0
	local limit_rank = 0
	local limit_vip = 0
	local is_show_limit_label = false

	-- 天梯排名限购
	self.rank_limit_flag = false
	if data["limit_rank"] and data.limit_rank > 0 then
		if shop_num == MallConst.MallType.Ladder then
			local ladder_data = LadderController:getInstance():getModel():getLadderMyBaseInfo()
			local bestRank = ladder_data and ladder_data.best_rank or 0
			if ladder_data and bestRank == 0 or bestRank > data.limit_rank then
				limit_rank = data.limit_rank
				is_show_limit_label = true
			end
		end
	end

	-- vip等级限购
	self.vip_limit_flag = 0
	if data["limit_vip"] and data.limit_vip > 0 then
		if self.role_vo and self.role_vo.vip_lev < data.limit_vip then
			is_show_limit_label = true
			limit_vip = data.limit_vip
		end
	end
	if is_show_limit_label == false then
		if data["limit_count"] and data.limit_count>0 then
			self.str = TI18N("语言_c_2036")
			limit_num = data.limit_count
			is_show_limit_label = true
		elseif data["limit_this"] and data.limit_this>0 then
			self.str = TI18N("语言_c_359")
			limit_num = data.limit_this
			is_show_limit_label = true
		elseif data["limit_month"] and data.limit_month>0 then
			self.str = TI18N("语言_c_2037")
			limit_num = data.limit_month
			is_show_limit_label = true
		elseif data["limit_week"] and data.limit_week>0 then
			self.str = TI18N("语言_c_1801")
			limit_num = data.limit_week
			is_show_limit_label = true
		elseif data["limit_day"] and data.limit_day>0 then
			self.str = TI18N("语言_c_1800")
			limit_num = data.limit_day
			is_show_limit_label = true
		else
			if data.shop_type==4 or data.shop_type == 2 then
				limit_num = 1
				is_show_limit_label = false
			else
				-- 特殊物品消耗的商店
				if not table.indexof(self.special_item_id,pay_type) and table.indexof(Config.ItemData.data_assets_id2label, pay_type) then
					own_sum = self.role_vo[pay_type] or 0
				end
				if own_sum < (20*data.price) then --取资产最大可买
					local temp = math.floor(own_sum / data.price)
					if temp >= 1 then 
						limit_num = temp
					else
						limit_num = 1
					end
				else
					limit_num = 20 --无限制购买的物品 一次购买上限20
					is_show_limit_label = false
				end
			end
		end
	end

	if limit_vip > 0 and is_show_limit_label then
		self.discount_label:setVisible(true)
		self.discount_label:setString(string.format(TI18N("语言_c_4008"),limit_vip))
		self:setSellAll( false )
		self.vip_limit_flag = limit_vip
	elseif limit_num>0 and is_show_limit_label then
		self.discount_label:setVisible(true)
		self.discount_label:setString(string.format(TI18N("语言_c_4009"),self.str,data.has_buy,limit_num))
		if data.has_buy == limit_num then
			--self.sold:setVisible(true)
			self:setSellAll( true )
		else
			--self.sold:setVisible(false)
			self:setSellAll( false )
		end
	elseif limit_rank>0 and is_show_limit_label then
		self.discount_label:setVisible(true)
		self.discount_label:setString(string.format(TI18N("语言_c_4010"),limit_rank))
		self:setSellAll( false )
		self.rank_limit_flag = true
	else
		self.discount_label:setVisible(false)
		if data.has_buy==1 then
			--self.sold:setVisible(true)
			self:setSellAll( true )
		else
			--self.sold:setVisible(false)
			self:setSellAll( false )
		end
	end
	-- print("====limit_num===",limit_num)
	self.data.limit_num = limit_num
	self.data.is_show_limit_label = is_show_limit_label

	--折扣标签和折扣价格
	if data["label"] and data.label>0 then --表里的
		self.discount:setVisible(true)
		if isPFChange(CommonConst.fun_type.rebate) then
			local num2 = -10 * (10 - data.label)
			self.discount_num:setString(string.format(TI18N("语言_c_4710"),num2))
		else
			self.discount_num:setString(string.format(TI18N("语言_c_4710"),data.label))
		end
	elseif data["discount_type"] and data.discount_type>0 then --服务器的信息
		self.discount:setVisible(true)
		if isPFChange(CommonConst.fun_type.rebate) then
			local num2 = -10 * (10 - data.discount_type)
			self.discount_num:setString(string.format(TI18N("语言_c_4710"),num2))
		else
			self.discount_num:setString(string.format(TI18N("语言_c_4710"),data.discount_type))
		end
	else
		self.discount:setVisible(false)
	end

	if data["discount"] and data.discount>0 then
		self.price:setString(data.discount)
		self.price:setTextColor(Config.ColorData.data_color4[1])
	else
		self.price:setTextColor(Config.ColorData.data_color4[1])
	end

	--勇者之路商店
	if self.data.type == MallConst.MallType.BraveRoadShop then 
		if self.data.ext_limit and tableLen(self.data.ext_limit) ~= 0 then
			self:showBraveRoadStarLimit(true, self.data.ext_limit)
		else
			self:showBraveRoadStarLimit(false)
		end
	end

    if self.limit_glev_layer then
		self.limit_glev_layer:setContentSize(cc.size(190, self.limit_glev_label:getContentSize().height+15))
	end
	local bid = self.ctrl:getNeedBid()
	if bid~=nil and (bid==data.item_id or bid==data.item_bid) then 
		self.need_icon:setVisible(true)
		self.need_label:setVisible(true)
	else
		self.need_icon:setVisible(false)
		self.need_label:setVisible(false)
	end
end

function BraveMallItem:showChipTag(status)
	if not self.tag_point and status == false then
		return
	end
	if not self.tag_point then
		local res = PathTool.getResFrame('common', 'txt_cn_common_30016')
		self.tag_point = createImage(self.main_container, res,8,132, cc.p(0, 1), true, 10, false)
		-- self.tag_label = createLabel(18, 1, cc.c4b(197, 102, 25, 255), 24, 28, TI18N("语言_c_4011"), self.tag_point, 1, cc.p(0.5, 0))
		-- self.tag_label:setRotation(-45)
		self.tag_point:setScale(1)
	end
	self.tag_point:setVisible(status)
end

function BraveMallItem:initLimitGlevLayer()
	if not self.limit_glev_layer then
        -- self.limit_glev_layer = createSprite(PathTool.getResFrame("common","common_90056"), 211, 30, self.main_container)
		self.limit_glev_layer = createImage(self.main_container,PathTool.getResFrame("common","common_90056"),211, 10,cc.p(0.5,0),true,9999,true)
        -- self.limit_glev_layer:setLocalZOrder(9999)
        -- self.limit_glev_layer:setScaleX(0.5)
        -- self.limit_glev_layer:setScaleY(0.6)
		self.limit_glev_label = createRichLabel(20, 58, cc.p(0.5, 0), cc.p(211, 17),FONT_COMMON_LINE_SPACE,nil,174)
		self.main_container:addChild(self.limit_glev_label, 9999)
	end
end

function BraveMallItem:isShowGLevLimit(status, glev)
	self.limit_glev_status = status
    if self.limit_glev_layer == nil and status == false then 
        return
    end
    
    if status then
	    local guild_lev = RoleController:getInstance():getRoleVo().guild_lev
	    if guild_lev and guild_lev >= glev then
	        status = false
	    end
	    if status then
		    self:initLimitGlevLayer()
	    	self.limit_glev_label:setString(string.format(TI18N("语言_c_4014"), glev))
	    end
	end
	if self.limit_glev_layer then
	    self.limit_glev_layer:setVisible(false)
	    self.limit_glev_label:setVisible(status)
	end
	self.grey:setVisible(status)
	self.limit_glev_status = status
end

--勇者之路商店
function BraveMallItem:showBraveRoadStarLimit(status, limit_star)
	self.limit_brave_road_status = nil
	
	if self.limit_glev_layer == nil and status == false then 
        return
    end
    if status then
	    local cur_star = BraveRoadController:getInstance():getModel():getMonthStar() --本月星数
		local cur_diff = BraveRoadController:getInstance():getModel():getMonthDiff() --本月难度
		local need_star = 0
		local need_diff = 0
		for key, value in pairs(limit_star) do
			if value[1] == "dun_horcruxes_stars" then
				need_star = value[2]
			elseif value[1] == "dun_horcruxes_diff" then
				need_diff = value[2]
			end
		end
	    if cur_star and cur_star >= need_star and cur_diff and cur_diff >= need_diff then
	        status = false
	    end
	    if status then
		    self:initLimitGlevLayer()
		    local limit_str 
			if tableLen(limit_star) == 2 then
				local desclist = {}
				local str = ""
				if Config.LimitTrainingData.data_choose_diff[need_diff + 1] then
					str = Config.LimitTrainingData.data_choose_diff[need_diff+1].name
				else
					str = Config.LimitTrainingData.data_choose_diff[need_diff].name
				end
				table.insert(desclist,str)
				table.insert(desclist,need_star)
				limit_str = LangStringFormat(TI18N("语言_c_5454"),desclist)
			elseif tableLen(limit_star) == 1 then
				if limit_star[1][1] == "dun_horcruxes_stars" then
					limit_str = string.format(TI18N("语言_c_5357"), need_star)
				elseif limit_star[1][1] == "dun_horcruxes_diff" then
					limit_str = string.format(TI18N("语言_c_5453"), need_diff)
				end
			end
			self.limit_glev_label:setString(limit_str)
			self.limit_brave_road_status = limit_str
	    end
	end
	if self.limit_glev_layer then
	    self.limit_glev_layer:setVisible(false)
	    self.limit_glev_label:setVisible(status)
	end
	self.grey:setVisible(status)
end

function BraveMallItem:setSellAll( bool )
	self.sold:setVisible(bool)
	--setChildUnEnabled(bool,self)
	self.grey:setVisible(bool)
	self:setTouchEnabled(not bool)
end

function BraveMallItem:addCallBack( value )
	self.callback =  value
end

function BraveMallItem:registerEvent()
	self:addTouchEventListener(function(sender, event_type) 
		if event_type == ccui.TouchEventType.ended then
				self.touch_end = sender:getTouchEndPosition()
				local is_click = true
				if self.touch_began ~= nil then
					is_click =
						math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
						math.abs(self.touch_end.y - self.touch_began.y) <= 20
				end
				if is_click == true then
					playButtonSound2()
					if self.vip_limit_flag > 0 then
						message(string.format(TI18N("语言_c_4017"), self.vip_limit_flag))
						return
					end
					if self.rank_limit_flag then
						message(TI18N("语言_c_4018"))
                        return
					end
                    if self.limit_glev_status then
                        message(TI18N("语言_c_4019"))
                        return
                    end
                    if self.limit_elite_status then 
                        message(string.format(TI18N("语言_c_4020"), self.limit_elite_status))
                        return
					end
					if self.limit_brave_road_status then 
                        message(string.format(TI18N("语言_c_5335"), self.limit_brave_road_status))
                        return
                    end
					if self.limit_newyearmoppingup_status then 
                        message(string.format(TI18N("语言_c_5463"), self.limit_newyearmoppingup_status))
                        return
                    end
					if self.limit_shinobiShop_status then 
						local name=Config.ArenaShinobiData.data_shinobi_level[self.limit_shinobiShop_status].name
                        message(string.format(TI18N("语言_c_6022"), name))
                        return
                    end
					
					if self.limit_treasure_status then 
						message(string.format(TI18N("语言_c_6266"), self.limit_treasure_status))
						return
					end
					if self.callback then
						self:callback()
					end
				end
			elseif event_type == ccui.TouchEventType.moved then
			elseif event_type == ccui.TouchEventType.began then
				self.touch_began = sender:getTouchBeganPosition()
			elseif event_type == ccui.TouchEventType.canceled then
			end
	end)

	--除神秘商城以外的购买成功
	if not self.buy_success_event then
		self.buy_success_event = GlobalEvent:getInstance():Bind(MallEvent.Buy_Success_Event,function ( data )
			if not data or not self.data then return end
			
			if self.data["id"] and data.eid == self.data.id and next(data.ext or {}) ~= nil then
				self.data.has_buy = data.ext[1].val
				self.discount_label:setString(string.format(TI18N("语言_c_4009"),self.str,self.data.has_buy,self.data.limit_num))
				if self.data.has_buy == self.data.limit_num then
					--self.sold:setVisible(true)
					self:setSellAll( true )
				end
			end
		end)
	end

	if self.role_vo then
        if self.role_update_event == nil then
            self.role_update_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE,function(key,value)
            	if not self.data then return end
                if key == "gold" or key == "red_gold" or key =="hero_soul" or key == "arena_cent" or key == "friend_point" or key == "guild" then
					if self.pay_type and not table.indexof(self.special_item_id,self.pay_type) then
						if self.data["limit_day"]==0 and self.data["limit_month"]==0 and self.data["limit_week"]==0 and self.data["limit_this"]==0 and self.data["limit_count"]==0 then 
							--不限购的非神秘神格商店物品
							if self.data.shop_type~=4 and self.data.shop_type~=2 then
								local total_sum = self.role_vo[self.pay_type] or 0
								if total_sum < (20*self.data.price) then --取资产最大可买
									local temp = math.floor(total_sum / self.data.price)
									if temp>=1 then
										self.data.limit_num = temp
									else
										self.data.limit_num = 1 
									end
								else
									self.data.limit_num = 20 --无限制购买的物品 一次购买上限20	
								end
							end
						end
					end
                end
            end)
        end
    end
end

function BraveMallItem:buyOneSuccess(data)
	local shop_num --商城类型
	if self.data.shop_type then 
		shop_num = self.data.shop_type
	else
		shop_num = self.data.type
	end
	if shop_num == nil then return end

	if shop_num == data.type and self.data["order"] and data.order == self.data.order then
		if not self.data.has_buy then
			self.data.has_buy = data.num or 1
		else
			self.data.has_buy = self.data.has_buy + (data.num or 1)
		end
		self.discount_label:setString(string.format(TI18N("语言_c_4009"),self.str,self.data.has_buy,self.data.limit_num))
		local limit_num = self.data.limit_this
		if not limit_num or limit_num == 0 then
			limit_num = self.data.limit_num
		end
		if limit_num and self.data.has_buy >= limit_num then
			self:setSellAll( true )
		end
	end
end

function BraveMallItem:getData( )
	return self.data
end

function BraveMallItem:DeleteMe()
	if self.buy_success_event then 
        GlobalEvent:getInstance():UnBind(self.buy_success_event)
        self.buy_success_event = nil
    end

	if self.goods_item then 
		self.goods_item:DeleteMe()
	end

	if self.role_vo then
        if self.role_update_event ~= nil then
            self.role_vo:UnBind(self.role_update_event)
            self.role_update_event = nil
        end
        self.role_vo = nil
    end
    doStopAllActions(self.name)
	self:removeAllChildren()
	self:removeFromParent()
end
