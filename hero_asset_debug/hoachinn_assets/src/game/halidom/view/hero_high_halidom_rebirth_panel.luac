HeroHighHalidomRebirthPanel = HeroHighHalidomRebirthPanel or BaseClass(BaseView)

local _controller = HalidomController:getInstance()
local _model = _controller:getModel()

function HeroHighHalidomRebirthPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_high_halidom_rebirth_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
end

function HeroHighHalidomRebirthPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    self.panel_1 = self.main_container:getChildByName("panel_1")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_7511"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.image_title:getContentSize().height))
    self.explain_btn = self.main_container:getChildByName("explain_btn")
    self.top_line_left = self.main_container:getChildByName("top_line_left")
    self.top_title = self.main_container:getChildByName("top_title")
    self.top_title:setString(TI18N("语言_c_5314"))
    self.top_line_right = self.main_container:getChildByName("top_line_right")
    setTextTweenBg(self.top_title,self.top_line_left,self.top_line_right,nil,30,false)
    self.bg_panel = self.main_container:getChildByName("bg_panel")
    self.bg = self.bg_panel:getChildByName("bg")
    self.Node_1 = self.bg_panel:getChildByName("Node_1")
    self.Node_2 = self.bg_panel:getChildByName("Node_2")
    self.tips_bg = self.bg_panel:getChildByName("tips_bg")
    self.now_order = createRichLabel(20, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5,0.5), cc.p(145,45))
    self.bg_panel:addChild(self.now_order)
    self.rebirth_order = createRichLabel(20, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5,0.5), cc.p(455,45))
    self.bg_panel:addChild(self.rebirth_order)
    self.bottom_line_left = self.main_container:getChildByName("bottom_line_left")
    self.bottom_title = self.main_container:getChildByName("bottom_title")
    self.bottom_title:setString(TI18N("语言_c_21"))
    self.bottom_line_right = self.main_container:getChildByName("bottom_line_right")
    setTextTweenBg(self.bottom_title,self.bottom_line_left,self.bottom_line_right,nil,30,false)
    self.list_bg = self.main_container:getChildByName("list_bg")
    self.reward_scroll = self.main_container:getChildByName("reward_scroll")
    self.reward_scroll:setScrollBarEnabled(false)
    self.cost_tip = self.main_container:getChildByName("cost_tip")
    self.cost_tip:setString(TI18N("语言_c_6534"))
    self.cost_scroll = self.main_container:getChildByName("cost_scroll")
    self.cost_scroll:setScrollBarEnabled(false)
    self.select_btn = self.main_container:getChildByName("select_btn")
    self.select_btn_txt = self.select_btn:getChildByName("label")
    self.select_btn_txt:setString(TI18N("语言_c_6550"))
    self.tip = self.main_container:getChildByName("tip")
    setTextMaxWidth(self.tip,600)
    local num = 100
    if judgingLanguage() then
        num = 40
    else
        num = 90
    end
    self.tip:setString(transformTextToShort(TI18N("语言_c_7512"),num))
    addEvt2showAllTextTips(self.tip,TI18N("语言_c_7512"),num)
    self.high_step_list = {}
    for i=1,2 do
        local item = self.bg_panel:getChildByName("item_" .. i)
        if item then
            local cost_object = {}
            cost_object.item = item
            cost_object.bg = item:getChildByName("bg")
            cost_object.mask = createSprite(PathTool.getPlistImgForDownLoad("halidom","halidom_2006",false), 61, 61, nil, cc.p(0.5, 0.5),LOADTEXT_TYPE)--模板
            cost_object.mask:setScale(1)
            if not cost_object.clipNode then
                cost_object.clipNode = cc.ClippingNode:create(cost_object.mask)
                cost_object.clipNode:setAnchorPoint(cc.p(0.5,0.5))
                cost_object.clipNode:setContentSize(cc.size(cost_object.bg:getContentSize().width,cost_object.bg:getContentSize().height))
                cost_object.clipNode:setCascadeOpacityEnabled(true)
                cost_object.clipNode:setPosition(cc.p(61,61))
                cost_object.clipNode:setAlphaThreshold(0)
                cost_object.bg:addChild(cost_object.clipNode,2)
            end
            if not cost_object.hero_icon then
                cost_object.hero_icon = ccui.ImageView:create()
                cost_object.hero_icon:setCascadeOpacityEnabled(true)
                cost_object.hero_icon:setAnchorPoint(0.5,0.5)
                cost_object.hero_icon:setPosition(cc.p(cost_object.clipNode:getContentSize().width*0.5,cost_object.clipNode:getContentSize().height*0.5))--底板
                cost_object.hero_icon:setScale(1.1)
                cost_object.clipNode:addChild(cost_object.hero_icon,4)
            end
            if not cost_object.icon then
                cost_object.icon = ccui.ImageView:create()
                cost_object.icon:setCascadeOpacityEnabled(true)
                cost_object.icon:setAnchorPoint(0.5,0.5)
                cost_object.icon:setPosition(61,61)--底板
                cost_object.clipNode:addChild(cost_object.icon,3)
            end
            cost_object.cir_bg = item:getChildByName("cir_bg")
            cost_object.cir_bg:setZOrder(99)
            -- cost_object.icon:loadTexture(PathTool.getPlistImgForDownLoad("halidom","halidom_20"..9+self.cur_halidom_index), LOADTEXT_TYPE)
            cost_object.name_bg = item:getChildByName("name_bg")
            cost_object.name_bg:setZOrder(100)
            cost_object.name = item:getChildByName("name")
            cost_object.name:setZOrder(101)
            -- cost_object.name:setString(string.format(TI18N("语言_halm_01_11"), i))
            cost_object.name:setString("")
            cost_object.name_bg:setContentSize(cc.size(cost_object.name:getContentSize().width+20, cost_object.name_bg:getContentSize().height))
            cost_object.name:setVisible(false)
            cost_object.name_bg:setVisible(false)
            cost_object.index = i
            table.insert(self.high_step_list, cost_object)
        end
    end
end
-- 刷新进二阶段升级据显示
function HeroHighHalidomRebirthPanel:updateHighStepInfo(  )
    local all_step_cfg = Config.HalidomData.data_step_high[self.halidom_id]
    if not all_step_cfg then return end
    for i=1,#self.high_step_list do
        local value = self.high_step_list[i]
        value.hero_icon:setVisible(false)
        value.icon:setVisible(false)
        value.name:setString("")
        value.name_bg:setContentSize(cc.size(value.name:getContentSize().width+20, value.name_bg:getContentSize().height))
        value.name:setVisible(false)
        value.name_bg:setVisible(false)
        local step = self.halidom_list.jade_step
        if i == 2 then
            step = 1
        end
        value.name:setString(string.format(TI18N("语言_halm_01_14"), step))
        value.name_bg:setContentSize(cc.size(value.name:getContentSize().width+20, value.name_bg:getContentSize().height))
        value.name:setVisible(true)
        value.name_bg:setVisible(true)
        value.icon:setVisible(true)
        value.icon:loadTexture(PathTool.getPlistImgForDownLoad("halidom","halidom_20"..9+self.halidom_id), LOADTEXT_TYPE)
        local _hero_id = self.halidom_list.hero_id
        if i == 2 then
            _hero_id = 0
        end
        local hero_vo = HeroController:getInstance():getModel():getHeroById(_hero_id)
        if hero_vo and next(hero_vo) and hero_vo.bid then
            local head_id = hero_vo.bid
            if hero_vo.use_skin and hero_vo.use_skin ~= 0 then
                local skin_config = Config.PartnerSkinData.data_skin_info[hero_vo.use_skin]
                if skin_config then
                    head_id = skin_config.head_id
                end
            else
                local key = getNorKey(hero_vo.bid, hero_vo.star)
                local star_config = Config.PartnerData.data_partner_star(key)
                if star_config then
                    head_id = star_config.head_id
                end
            end
            value.hero_icon:loadTexture(PathTool.getHeadIcon(head_id), LOADTEXT_TYPE)
            value.hero_icon:setVisible(true)
        end
    end
end

function HeroHighHalidomRebirthPanel:register_event(  )
	registerButtonEventListener(self.explain_btn, function (param,sender, event_type)
		local rule_cfg = Config.HalidomData.data_const["halidom_back_rule_2"]
        if rule_cfg then
            TipsManager:getInstance():showAdventureBuffTipsScroll(rule_cfg.desc, sender:getTouchBeganPosition())
        end
    end,2)

    registerButtonEventListener(self.select_btn, function ( )
        local str = TI18N("语言_c_5327")
        CommonAlert.show( str, TI18N("语言_c_63"), function()
            HalidomController:getInstance():sender22221(tonumber(self.halidom_id),tonumber(self.halidom_index))
        end, TI18N("语言_c_62"),nil,nil,nil,{timer=5, timer_for=true, off_y = 10, title = TI18N("语言_c_154"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
    end,2)

    registerButtonEventListener(self.background, function ( )
		_controller:openHeroHighHalidomRebirthPanel(false)
    end)
end
-- 初始化圣物数据
function HeroHighHalidomRebirthPanel:initHalidomData(  )
    self.halidom_list = {}
    self.config = deepCopy(Config.HalidomData.data_base[self.halidom_id])
    local list = _model:getHalidomDataById(self.config.id)
    for i,v in ipairs(list.high_jades) do
        if v.jade_id == self.halidom_index then
            self.halidom_list = v
        end
    end
end
function HeroHighHalidomRebirthPanel:openRootWnd(halidom_id, index)
    self.halidom_id = halidom_id
    self.halidom_index = index
    self:setData()
end
function HeroHighHalidomRebirthPanel:setData()
    self:initHalidomData()
    if tableLen(self.halidom_list) == 0 then return end
    local str = TI18N("语言_halm_01_13")
    local txt1 = string.format(str,self.halidom_index)
    self.now_order:setString(txt1)
    local txt3 = string.format(str,self.halidom_index)
    self.rebirth_order:setString(txt3)
    self:setRewardList()
    self:setCostList()
    self:setHalidomSpine()
    self:updateHighStepInfo()
end
function HeroHighHalidomRebirthPanel:setHalidomSpine()
    self.now_spine = createEffectSpine(PathTool.getEffectRes(self.config.effect_id), cc.p(0, 0), cc.p(0.5,0.5), true, nil,nil,nil,true)
    self.Node_1:addChild(self.now_spine)
    self.now_spine:setPositionY(90)
    self.now_spine:setScale(0.6)
    self.now_spine:setAnimation(0, PlayerAction.action_2, true)
    self.erbirth_spine = createEffectSpine(PathTool.getEffectRes(self.config.effect_id), cc.p(0, 0), cc.p(0.5,0.5), true, nil,nil,nil,true)
    self.Node_2:addChild(self.erbirth_spine)
    self.erbirth_spine:setPositionY(90)
    self.erbirth_spine:setScale(0.6)
    self.erbirth_spine:setAnimation(0, PlayerAction.action_2, true)
end
function HeroHighHalidomRebirthPanel:setRewardList()
    if Config.HalidomData.data_step_high[self.halidom_id] and Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index] and Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index][self.halidom_list.jade_step] then
        local all_step_cfg = Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index][self.halidom_list.jade_step]
        local item_list = deepCopy(all_step_cfg.back_item)
        local partner_data = all_step_cfg.back_partner
        for i,v in ipairs(partner_data) do
            local cfg = Config.PartnerData.data_partner_base[v[1]]
            if cfg then
                local _list = {cfg.item_id,v[2]}
                table.insert(item_list,1,_list)
            end
        end
        local setting = {}
        setting.space_x = 2
        setting.max_count = 4
        setting.is_center = true
        setting.is_backpack_item = true
        self.item_list = commonShowSingleRowItemList(self.reward_scroll, self.item_list, item_list, setting)
    end
end
function HeroHighHalidomRebirthPanel:setCostList()
    if Config.HalidomData.data_step_high[self.halidom_id] and Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index] and Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index][self.halidom_list.jade_step] then
        local all_step_cfg = Config.HalidomData.data_step_high[self.halidom_id][self.halidom_index][self.halidom_list.jade_step]
        local item_list = all_step_cfg.back_cost
        local setting = {}
        setting.space_x = 2
        setting.max_count = 4
        setting.is_center = true
        setting.is_backpack_item = true
        self.item_list2 = commonShowSingleRowItemList(self.cost_scroll, self.item_list2, item_list, setting)
    end
end
function HeroHighHalidomRebirthPanel:close_callback(  )
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.item_list2 then
        for i,v in ipairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.now_spine then
        self.now_spine:clearTracks()
        self.now_spine:removeFromParent()
        self.now_spine = nil
    end
    if self.erbirth_spine then
        self.erbirth_spine:clearTracks()
        self.erbirth_spine:removeFromParent()
        self.erbirth_spine = nil
    end
    _controller:openHeroHighHalidomRebirthPanel(false)
end