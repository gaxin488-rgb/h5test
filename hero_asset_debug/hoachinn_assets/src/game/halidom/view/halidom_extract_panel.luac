HeroHalidomExtractPanel = HeroHalidomExtractPanel or BaseClass(BaseView)

local controller = HalidomController:getInstance()
local model = controller:getModel()
local string_format = string.format
local math_ceil = math.ceil

function HeroHalidomExtractPanel:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.res_list = {
        -- {path = PathTool.getPlistImgForDownLoad("homepet_travellingbag", "homepet_travellingbag"), type = ResourcesType.plist}
    }
    self.layout_name = "hero/hero_halidom_extract_panel"

    --精炼生成的id
    self.extract_item_id = 10301
    local config = Config.HalidomData.data_const.item_id
    if config then
        self.extract_item_id = config.val
    end
    self.extract_item_config = Config.ItemData.data_get_data(self.extract_item_id)
    
    self.item_list = {}
end
function HeroHalidomExtractPanel:open_callback(  )
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)  

    local main_panel = self.main_container:getChildByName("main_panel")
    self.main_panel = main_panel
    self.Image_2 = main_panel:getChildByName("Image_2")
    self.title = main_panel:getChildByName("win_title")
    self.title:setString(TI18N("语言_halm_01_50"))
    autoSizeTitleBg(self.title,self.Image_2,120)

    self.close_btn = main_panel:getChildByName("close_btn")
    self.look_btn = self.main_container:getChildByName("look_btn")
    self.comfirm_btn = self.main_container:getChildByName("comfirm_btn")
    self.comfirm_btn:getChildByName("label"):setString(TI18N("语言_halm_01_53"))

    self.recovery_btn = self.main_container:getChildByName("recovery_btn")
    self.recovery_btn_label = self.recovery_btn:getChildByName("label")
    self.recovery_btn_label:setString(TI18N("语言_c_1711"))

    self.spine_node = self.main_container:getChildByName("spine_node")
    local bg = self.main_container:getChildByName("bg")

    local bg_res = PathTool.getPlistImgForDownLoad("bigbg/resonate", "hero_resonate_bg3", false)
    self.item_load_bg = loadSpriteTextureFromCDN(bg, bg_res, ResourcesType.single, self.item_load_bg) 

    self.item_right_node = self.main_container:getChildByName("item_right_node")     

    self.right_item = BackPackItem.new(true,true,nil,0.75,false)
    self.right_item:setDefaultTip()
    self.item_right_node:addChild(self.right_item)

    local progress_container = self.main_container:getChildByName("progress_container")
    self.progress = progress_container:getChildByName("progress")
    self.progress:setScale9Enabled(true)
    -- local progress_container_size = progress_container:getContentSize()
    self.progress:setPercent(0)
    self.Image_1 = progress_container:getChildByName("Image_1")
    self.progress_time = progress_container:getChildByName("time")
    self.progress_time:setString("")
    self.item_panel = self.main_container:getChildByName("item_panel")
    for i = 1, 3 do
        local object = {}
        object.node = self.item_panel:getChildByName("item_node_"..i)
        object.bg = self.item_panel:getChildByName("item_node_bg_"..i)
        object.num = self.item_panel:getChildByName("item_node_num_"..i)
        self.item_list[i] = object
    end
    self.click_img = self.item_panel:getChildByName("click_img")
    self.click_img:setPositionX(self.item_list[1].node:getPositionX())
    self.total_time = self.main_container:getChildByName("total_time")
    self.total_time:setString("")

    self.txt_key_1 = self.main_container:getChildByName("txt_key_1")
    self.txt_key_1:setString(TI18N("语言_c_3005"))
    self.txt_key_2 = self.main_container:getChildByName("txt_key_2")
    self.txt_key_2:setString(TI18N("语言_c_3006"))
    self.txt_key_3 = self.main_container:getChildByName("txt_key_3")
    self.txt_key_3:setString(TI18N("语言_c_6570"))
    self.txt_key_4 = self.main_container:getChildByName("txt_key_4")
    self.txt_key_4:setString(TI18N("语言_c_1242"))
    self.total_time:setPositionX(self.txt_key_4:getPositionX()+self.txt_key_4:getContentSize().width+10)

    self.txt_value_1 = createRichLabel(20, cc.c4b(0x0e,0xa8,0x0e,0xff), cc.p(0,0.5),cc.p(395, 345),nil,nil,1900)
    self.txt_value_2 = createRichLabel(20, cc.c4b(0x0e,0xa8,0x0e,0xff), cc.p(0,0.5),cc.p(395, 320),nil,nil,1900)
    self.txt_value_3 = self.main_container:getChildByName("txt_value_3")

    self.main_container:addChild(self.txt_value_1)
    self.main_container:addChild(self.txt_value_2)
end
function HeroHalidomExtractPanel:setExtractData()
    local config = Config.HalidomData.data_const.halidom_material_transform.val
    for i = 1, 3 do
        local id = config[i][1]
        local back_cfg = Config.ItemData.data_get_data(id)
        if not self.item_list[i].item then
            local item = BackPackItem.new(true,true,false,0.75)
            local function clickItem()
                TipsManager:getInstance():showGoodsTips(back_cfg, true, true,nil)
            end
            item:addLongTimeTouchCallback(clickItem)
            
            local function clickItem()
                if self and self.scdata and self.scdata.all_num == 0 then
                    self:setExtractIndex(i)
                else
                    message(TI18N("语言_halm_01_51"))
                end
            end
            item:addCallBack(clickItem)
            self.item_list[i].item = item
            self.item_list[i].node:addChild(item)
        end
        self.item_list[i].item:setData(back_cfg)
        local num = BackpackController:getInstance():getModel():getItemNumByBid(id)
        self.item_list[i].num:setString(MoneyTool.GetMoneyString(num))
        self.item_list[i].bg:setContentSize(cc.size(self.item_list[i].num:getContentSize().width + 4,self.item_list[i].bg:getContentSize().height))
    end
end

function HeroHalidomExtractPanel:register_event(  )
    registerButtonEventListener(self.background, function() self:onClosedBtn() end,false, 2)
    registerButtonEventListener(self.close_btn, function() self:onClosedBtn() end ,true, 2)
    registerButtonEventListener(self.comfirm_btn, function() self:onComfirmBtn()  end ,true, 1)
    registerButtonEventListener(self.recovery_btn, function() self:onRecoveryBtn()  end ,false, 1)

    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.HalidomData.data_const.halidom_material_transform_rule
        if config then
            TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition(),nil,nil,500)
        end
    end ,true, 1)

    --精炼信息返回
    self:addGlobalEvent(HalidomEvent.Hero_Resonate_Extract_Event, function(data)
        if not data then return end
        self:setData(data)
    end)
    --     --道具增加
    self:addGlobalEvent(BackpackEvent.ADD_GOODS, function(bag_code,temp_add)
        if bag_code == BackPackConst.Bag_Code.BACKPACK then 
            if self.item_list then 
                self:setExtractData()
            end
        end
    end)
    --物品道具删除 
    self:addGlobalEvent(BackpackEvent.DELETE_GOODS, function(bag_code,temp_add)
        if bag_code == BackPackConst.Bag_Code.BACKPACK then 
            if self.item_list then 
                self:setExtractData()
            end
        end
    end)
    --物品道具变化
    self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_add)
        if bag_code == BackPackConst.Bag_Code.BACKPACK then 
            if self.item_list then 
                self:setExtractData()
            end
        end
    end)
end


--关闭
function HeroHalidomExtractPanel:onClosedBtn()
    controller:openHeroHalidomExtractPanel(false)
end

--收获材料
function HeroHalidomExtractPanel:onComfirmBtn()
    if not self.scdata then return end
    controller:sender22218()
end

--回收
function HeroHalidomExtractPanel:onRecoveryBtn()
    if not self.scdata then return end
    if self.scdata.all_num == 0 then
        local setting = {}
        setting.limit_count = self.limit_num
        setting.target_item_id = self.extract_item_id
        setting.cost_item_id = self.cost_item_id
        setting.price = self.single_cost_count
        controller:openHeroHalidomSelectExpPanel(true, setting)
    else
        local count = self.scdata.all_num - (self.scdata.do_num + self.scdata.get_num)
        if count <= 0 then
            message(TI18N("语言_c_3011"))
            return
        end
        local less_count = self.single_cost_count * count
        local icon_src = PathTool.getItemRes(self.cost_item_config.icon)
        local str = string_format(TI18N("语言_c_6573"),icon_src, less_count)
        local callback = function()
            controller:sender22217()
        end
        CommonAlert.show(str, TI18N("语言_c_63"), callback, TI18N("语言_c_62"),nil, CommonAlert.type.rich, nil, {timer = 3, timer_for = true, title = TI18N("语言_c_6572")}) 
    end
end
function HeroHalidomExtractPanel:setExtractIndex(index)
    self.click_img:setPositionX(self.item_list[index].node:getPositionX())
    --花费的
    local config = Config.HalidomData.data_const.halidom_material_transform.val[index]
    if config and next(config) ~= nil then
        self.cost_item_id = config[1]
        self.single_cost_time = config[2]
        self.single_cost_count = config[3]
    else
        self.cost_item_id = Config.ItemData.data_assets_label2id.hero_exp
        self.single_cost_count = 10000
        self.single_cost_time = 10000
    end
    self.cost_item_config = Config.ItemData.data_get_data(self.cost_item_id)
    local icon_src = PathTool.getItemRes(self.extract_item_config.icon) 
    local str = string_format(TI18N("语言_c_3014"),icon_src, self.single_cost_time)
    self.txt_value_1:setString(str)
    self.txt_value_1:setPositionX(self.txt_key_1:getPositionX()+self.txt_key_1:getContentSize().width+10)

    local icon_src_exp = PathTool.getItemRes(self.cost_item_config.icon)  --self.single_cost_count
    local str = string_format(TI18N("<img src='%s' scale=0.3 />%s=<img src='%s' scale=0.3 />1"),icon_src_exp, self.single_cost_count,icon_src)
    self.txt_value_2:setString(str)
    self.txt_value_2:setPositionX(self.txt_key_2:getPositionX()+self.txt_key_2:getContentSize().width+10)
end

function HeroHalidomExtractPanel:openRootWnd()
    self.limit_num = Config.HalidomData.data_const["halidom_material_limitnum"].val
    if model:isResonateExtractRedpoint() then
        controller:sender22219()
    end
    controller:sender22215()
    self:setExtractIndex(1)
    self:setExtractData()
end


function HeroHalidomExtractPanel:setData(data)
    if not self.single_cost_time then return end
    if self.scdata then
        if self.scdata.get_num - data.get_num > 0 then
            if self.extract_item_config then 
                local item_color = BackPackConst.getBlackQualityColorStr(self.extract_item_config.quality)
                local msg = string_format(TI18N("语言_c_3015"), item_color, self.extract_item_config.name)
                showAssetsMsg(msg)
            end
        end
    end
    self.scdata = data
    local config = Config.HalidomData.data_const.halidom_material_transform.val
    for i = 1, tableLen(config) do
        if data.id == config[i][1] then
            self:setExtractIndex(i)
        end
    end

    if self.scdata.all_num == 0 then
        self.right_item:setBaseData(self.extract_item_id, 1)
        self.right_item:setSpecialNum(0)
        doStopAllActions(self.progress_time)
        doStopAllActions(self.total_time)
        moveTextBg(self.progress_time,self.Image_1,10,112)
        self.total_time:setString("00:00:00")
        self.progress_time:setVisible(false)
        self.progress:setVisible(false)
        self.Image_1:setVisible(false)
        self.progress:setPercent(0)
        -- self:showBottleEffect1(0)
        self.recovery_btn_label:setString(TI18N("语言_c_1711"))

        self.txt_value_3:setString(0)
    else
        self.progress_time:setVisible(true)
        self.progress:setVisible(true)
        self.Image_1:setVisible(true)
        self.Image_1:setContentSize(cc.size(95,14))
        self.recovery_btn_label:setString(TI18N("语言_c_3017"))
        self.right_item:setBaseData(self.extract_item_id, self.scdata.do_num)
        self.right_item:setSpecialNum(self.scdata.do_num)
        local cur_time = GameNet:getInstance():getTime()
        local callback = function(time) self:setTimeFormatString(time) end
        local time = self.scdata.do_end_time - cur_time
        commonCountDownTime(self.progress_time, time, {callback = callback})

        --总时间
        local count = self.scdata.all_num - (self.scdata.do_num + self.scdata.get_num) - 1
        if count < 0 then
            count = 0
        end
        local total_time = self.single_cost_time * count + time
        commonCountDownTime(self.total_time, total_time)

        self.txt_value_3:setString(MoneyTool.GetMoneyString((count + 1) * self.single_cost_count))
    end
    self.txt_value_3:setPositionX(self.txt_key_3:getPositionX()+self.txt_key_3:getContentSize().width+10)
end


function HeroHalidomExtractPanel:setTimeFormatString(time)
    if not self.progress_time then return end
    if not self.progress then return end
    if not self.single_cost_time then return end
    if time <= 0 then
        time = 0
        self.progress_time:setString("00:00")
            --发送更新的协议
        doStopAllActions(self.progress_time)
    else
        local timeStr = TimeTool.GetTimeForFunction(time)
        self.progress_time:setString(timeStr)
    end

    if time >=  self.single_cost_time then
        self.progress:setPercent(0)
        -- self:showBottleEffect1(0)
    else
        local have_time = self.single_cost_time - time
        local per = have_time * 100/self.single_cost_time
        self.progress:setPercent(per)
        -- self:showBottleEffect1(per)
    end
end


