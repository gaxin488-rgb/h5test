HalidomStrengthenClickPanel = HalidomStrengthenClickPanel or BaseClass(BaseView)

local controller = HalidomController:getInstance()
local model =  controller:getModel()

function HalidomStrengthenClickPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_halidom_strengthen_click_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
		{path = PathTool.getPlistImgForDownLoad("elfin", "elfin"), type = ResourcesType.plist},
	}
	self.click_id = 0
    self.hero_data_list = {}
end

function HalidomStrengthenClickPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
	self.container = container
    self:playEnterAnimatianByObj(self.container , 1) 
	self.tip = createLabel(20,cc.c3b(0x5c,0x27,0x05),nil,340,848,"",self.container,nil,cc.p(0.5,0.5))
	self.tip:setString(TI18N("语言_halm_01_20"))
	self.image_bg = self.container:getChildByName("image_bg")
	self.image_title = self.container:getChildByName("image_title")
	self.image_top = self.container:getChildByName("image_top")
	self.image_bottom = self.container:getChildByName("image_bottom")
	self.right_btn = self.container:getChildByName("right_btn")
	self.right_txt = self.right_btn:getChildByName("label")
	self.right_txt:setString(TI18N("语言_c_261"))
	self.left_btn = self.container:getChildByName("left_btn")
	self.left_txt = self.left_btn:getChildByName("label")
	self.left_txt:setString(TI18N("语言_c_395"))
	self.close_btn = self.container:getChildByName("close_btn")
	self.hero_list = self.container:getChildByName("hero_list")
	local scroll_view_size = self.hero_list:getContentSize()
    local list_setting = {
        start_x = 0,
        space_x = 24,
        start_y = 5,
        space_y = 10,
        item_width = HeroExhibitionItem.Width,
        item_height = HeroExhibitionItem.Height,
        row = 0,
        col = 4,
        need_dynamic = true
    }
    self.hero_list_view = CommonScrollViewSingleLayout.new(self.hero_list, cc.p(0, 0), ScrollViewDir.vertical,
        ScrollViewStartPos.top, scroll_view_size, list_setting, cc.p(0, 0))

    self.hero_list_view:registerScriptHandlerSingle(handler(self, self.createNewCell), ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.hero_list_view:registerScriptHandlerSingle(handler(self, self.numberOfCells), ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.hero_list_view:registerScriptHandlerSingle(handler(self, self.updateCellByIndex),
        ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    -- self.hero_list_view:registerScriptHandlerSingle(handler(self, self.onCellTouched), ScrollViewFuncType.OnCellTouched) -- 更新cell
	self.hero_info_panel = self.container:getChildByName("hero_info_panel")
	self.hero_info_item = HeroExhibitionItem.new(1,true)
	self.hero_info_panel:addChild(self.hero_info_item)
	self.hero_info_item:addCallBack(function() self:onClickHeroItem() end)
	self.hero_info_item:setPosition(cc.p(self.hero_info_panel:getContentSize().width*0.5,self.hero_info_panel:getContentSize().height*0.5))
	self.win_title = self.container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_halm_01_21"))
	local _w = math.max(self.image_title:getContentSize().width,self.win_title:getContentSize().width+120)
	self.image_title:setContentSize(cc.size(_w, self.image_title:getContentSize().height))
end
function HalidomStrengthenClickPanel:setClickiItem()
	if self.click_id ~= 0 then
		local hero_vo = HeroController:getInstance():getModel():getHeroById(self.click_id)
		if hero_vo and next(hero_vo) and hero_vo.bid then
			self.hero_info_item:setData(hero_vo)
		end
	else
		self.hero_info_item:setData()
		self.hero_info_item:setDefaultHeadByRes(PathTool.getResFrame("elfin", "elfin_1045"))
	end
end
function HalidomStrengthenClickPanel:setData()
	self.data = deepCopy(model:getHighJades(self.halidom_id,self.index))
	self.click_id = self.data.hero_id
	self:setClickiItem()
	if self.data and next(self.data) then
		self.hero_data_list = model:getHeroListForCamp(self.halidom_id,self.index)
		if #self.hero_data_list > 0 then
            self.hero_list_view:reloadData(1)
        else
            self.hero_list_view:reloadData()
        end
	end
end
function HalidomStrengthenClickPanel:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openHeroHalidomStrengthenClickPanel(false)
    end)
    
	registerButtonEventListener(self.background, function ( )
		controller:openHeroHalidomStrengthenClickPanel(false)
	end)

	registerButtonEventListener(self.left_btn, function ( )
		controller:openHeroHalidomStrengthenClickPanel(false)
	end)

	registerButtonEventListener(self.right_btn, function ( )
		local function callback()
			controller:sender22212(self.halidom_id,self.index,self.click_id)
		end
		if self.click_id == 0 then
			local str = TI18N("语言_halm_01_19")
			CommonAlert.show( str, TI18N("语言_c_63"), function()
				callback()
				controller:openHeroHalidomStrengthenClickPanel(false)
			end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
		elseif self.click_id == self.data.hero_id then
			controller:openHeroHalidomStrengthenClickPanel(false)
		else
			callback()
			controller:openHeroHalidomStrengthenClickPanel(false)
		end
	end)
end
function HalidomStrengthenClickPanel:openRootWnd(id,index)
	self.halidom_id = id
	self.index = index
	self:setData()
end

function HalidomStrengthenClickPanel:createNewCell()
    local cell = HalidomStrengthenClickItem.new()
    cell:addCallBack(function()
        self:onCellTouched(cell)
    end)
	-- cell:setLongTimeTouchEffect(true)
    return cell
end

function HalidomStrengthenClickPanel:numberOfCells()
    if not self.hero_data_list then
        return 0
    end
    return #self.hero_data_list
end

function HalidomStrengthenClickPanel:updateCellByIndex(cell, index)
    cell.index = index
    local item_vo = self.hero_data_list[index]
    if item_vo then
        cell:setData(item_vo)
		if item_vo.id == self.click_id then
			cell:setSelected(true)
		else
			cell:setSelected(false)
		end
    end
end

function HalidomStrengthenClickPanel:onCellTouched(cell)
	for k, v in pairs(self.hero_list_view:getActiveCellList()) do
		if self.hero_data_list[v.index].id == self.click_id then
			v:setSelected(false)
		end
	end
    local item_vo = self.hero_data_list[cell.index]
	if item_vo.id == self.click_id then
		cell:setSelected(false)
		self.click_id = 0
	else
		cell:setSelected(true)
		self.click_id = item_vo.id
	end
    self:setClickiItem()
end

function HalidomStrengthenClickPanel:onClickHeroItem(  )
	local hero_vo = HeroController:getInstance():getModel():getHeroById(self.click_id)
	if hero_vo and next(hero_vo) and hero_vo.bid then
		HeroController:getInstance():openHeroTipsPanel(true, hero_vo, nil)
	end
end
function HalidomStrengthenClickPanel:close_callback(  )
	if self.hero_info_item then
        self.hero_info_item:DeleteMe()
        self.hero_info_item = nil
    end
	self.click_id = 0
    self.hero_data_list = {}
	controller:openHeroHalidomStrengthenClickPanel(false)
end


--------------------------@ item
HalidomStrengthenClickItem = class("HalidomStrengthenClickItem", function()
    return ccui.Widget:create()
end)

function HalidomStrengthenClickItem:ctor()
    self:configUI()
end

function HalidomStrengthenClickItem:configUI()
    self.size = cc.size(HeroExhibitionItem.Width, HeroExhibitionItem.Height)
    self:setTouchEnabled(false)
    self:setContentSize(self.size)

    self.item_node = HeroExhibitionItem.new(false, true, false)
    self.item_node:setPosition(cc.p(self.size.width * 0.5, self.size.height - HeroExhibitionItem.Height * 0.5))
    self:addChild(self.item_node)
	self.item_node:setSwallowTouches(false)
end

function HalidomStrengthenClickItem:addCallBack(callback)
    if self.item_node then
        self.item_node:addCallBack(callback)
    end
end

function HalidomStrengthenClickItem:setData(data)
    if self.item_node then
        self.item_node:setData(data)
    end
	local function func()
		HeroController:getInstance():openHeroTipsPanel(true, data, nil)
	end
	if self.item_node then
		self.item_node:addLongTimeTouchCallback(func)
	end
end

function HalidomStrengthenClickItem:setSelected(status)
    if self.item_node then
        self.item_node:setSelected(status)
    end
end

function HalidomStrengthenClickItem:DeleteMe()
    if self.item_node then
        self.item_node:DeleteMe()
        self.item_node = nil
    end
end
