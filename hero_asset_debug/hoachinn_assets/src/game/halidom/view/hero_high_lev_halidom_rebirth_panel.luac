HeroHighLevHalidomRebirthPanel = HeroHighLevHalidomRebirthPanel or BaseClass(BaseView)

local _controller = HalidomController:getInstance()
local _model = _controller:getModel()

function HeroHighLevHalidomRebirthPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_high_lev_halidom_rebirth_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
end

function HeroHighLevHalidomRebirthPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    self.panel_1 = self.main_container:getChildByName("panel_1")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_7513"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.image_title:getContentSize().height))
    self.explain_btn = self.main_container:getChildByName("explain_btn")
    self.top_line_left = self.main_container:getChildByName("top_line_left")
    self.top_title = self.main_container:getChildByName("top_title")
    self.top_title:setString(TI18N("语言_c_5314"))
    self.top_line_right = self.main_container:getChildByName("top_line_right")
    setTextTweenBg(self.top_title,self.top_line_left,self.top_line_right,nil,30,false)
    self.bg_panel = self.main_container:getChildByName("bg_panel")
    self.bg = self.bg_panel:getChildByName("bg")
    self.Node_1 = self.bg_panel:getChildByName("Node_1")
    self.Node_2 = self.bg_panel:getChildByName("Node_2")
    self.tips_bg = self.bg_panel:getChildByName("tips_bg")
    self.now_order = createRichLabel(20, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5,0.5), cc.p(145,45))
    self.bg_panel:addChild(self.now_order)
    self.rebirth_order = createRichLabel(20, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5,0.5), cc.p(455,45))
    self.bg_panel:addChild(self.rebirth_order)
    self.bottom_line_left = self.main_container:getChildByName("bottom_line_left")
    self.bottom_title = self.main_container:getChildByName("bottom_title")
    self.bottom_title:setString(TI18N("语言_c_21"))
    self.bottom_line_right = self.main_container:getChildByName("bottom_line_right")
    setTextTweenBg(self.bottom_title,self.bottom_line_left,self.bottom_line_right,nil,30,false)
    self.list_bg = self.main_container:getChildByName("list_bg")
    self.reward_scroll = self.main_container:getChildByName("reward_scroll")
    self.reward_scroll:setScrollBarEnabled(false)
    self.cost_tip = self.main_container:getChildByName("cost_tip")
    self.cost_tip:setString(TI18N("语言_c_6534"))
    self.cost_scroll = self.main_container:getChildByName("cost_scroll")
    self.cost_scroll:setScrollBarEnabled(false)
    self.select_btn = self.main_container:getChildByName("select_btn")
    self.select_btn_txt = self.select_btn:getChildByName("label")
    self.select_btn_txt:setString(TI18N("语言_c_6550"))
    self.tip = self.main_container:getChildByName("tip")
    setTextMaxWidth(self.tip,600)
    local num = 100
    if judgingLanguage() then
        num = 40
    else
        num = 90
    end
    self.tip:setString(transformTextToShort(TI18N("语言_c_7514"),num))
    addEvt2showAllTextTips(self.tip,TI18N("语言_c_7514"),num)
end
function HeroHighLevHalidomRebirthPanel:register_event(  )
	registerButtonEventListener(self.explain_btn, function (param,sender, event_type)
		local rule_cfg = Config.HalidomData.data_const["halidom_back_rule_2"]
        if rule_cfg then
            TipsManager:getInstance():showAdventureBuffTipsScroll(rule_cfg.desc, sender:getTouchBeganPosition())
        end
    end,2)

    registerButtonEventListener(self.select_btn, function ( )
        local str = TI18N("语言_c_5327")
        CommonAlert.show( str, TI18N("语言_c_63"), function()
            HalidomController:getInstance():sender22222(tonumber(self.halidom_id))
        end, TI18N("语言_c_62"),nil,nil,nil,{timer=5, timer_for=true, off_y = 10, title = TI18N("语言_c_154"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
    end,2)

    registerButtonEventListener(self.background, function ( )
		_controller:openHeroHighLevHalidomRebirthPanel(false)
    end)
end
-- 初始化圣物数据
function HeroHighLevHalidomRebirthPanel:initHalidomData(  )
    self.halidom_list = {}
    self.config = deepCopy(Config.HalidomData.data_base[self.halidom_id])
    self.halidom_list  = _model:getHalidomDataById(self.config.id)
end
function HeroHighLevHalidomRebirthPanel:openRootWnd(halidom_id, index)
    self.halidom_id = halidom_id
    self:setData()
end
function HeroHighLevHalidomRebirthPanel:setData()
    self:initHalidomData()
    if tableLen(self.halidom_list) == 0 then return end
    local str = TI18N("语言_halm_01_57")
    local txt1 = string.format(str,HeroConst.CampName[self.halidom_id])..string.format(TI18N("语言_c_4520"),self.halidom_list.high_lev)
    self.now_order:setString(txt1)
    local txt3 = string.format(str,HeroConst.CampName[self.halidom_id])..string.format(TI18N("语言_c_4520"),1)
    self.rebirth_order:setString(txt3)
    self:setRewardList()
    self:setCostList()
    self:setHalidomSpine()
end
function HeroHighLevHalidomRebirthPanel:setHalidomSpine()
    self.now_spine = createEffectSpine(PathTool.getEffectRes(self.config.effect_id), cc.p(0, 0), cc.p(0.5,0.5), true, nil,nil,nil,true)
    self.Node_1:addChild(self.now_spine)
    self.now_spine:setPositionY(90)
    self.now_spine:setScale(0.6)
    self.now_spine:setAnimation(0, PlayerAction.action_2, true)
    self.erbirth_spine = createEffectSpine(PathTool.getEffectRes(self.config.effect_id), cc.p(0, 0), cc.p(0.5,0.5), true, nil,nil,nil,true)
    self.Node_2:addChild(self.erbirth_spine)
    self.erbirth_spine:setPositionY(90)
    self.erbirth_spine:setScale(0.6)
    self.erbirth_spine:setAnimation(0, PlayerAction.action_2, true)
end
function HeroHighLevHalidomRebirthPanel:setRewardList()
    local item_list = _model:HighHalidomRebirthRewardList(self.halidom_id,self.halidom_list.high_lev,self.halidom_list.high_exp)
    local setting = {}
    setting.space_x = 2
    setting.max_count = 4
    setting.is_center = true
    setting.is_backpack_item = true
    self.item_list = commonShowSingleRowItemList(self.reward_scroll, self.item_list, item_list, setting)
end
function HeroHighLevHalidomRebirthPanel:setCostList()
    if Config.HalidomData.data_lvup_high[self.halidom_id] and Config.HalidomData.data_lvup_high[self.halidom_id][self.halidom_list.high_lev] then
        local all_step_cfg = Config.HalidomData.data_lvup_high[self.halidom_id][self.halidom_list.high_lev]
        local item_list = all_step_cfg.back_cost or {}
        local setting = {}
        setting.space_x = 2
        setting.max_count = 4
        setting.is_center = true
        setting.is_backpack_item = true
        self.item_list2 = commonShowSingleRowItemList(self.cost_scroll, self.item_list2, item_list, setting)
    end
end
function HeroHighLevHalidomRebirthPanel:close_callback(  )
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.item_list2 then
        for i,v in ipairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.now_spine then
        self.now_spine:clearTracks()
        self.now_spine:removeFromParent()
        self.now_spine = nil
    end
    if self.erbirth_spine then
        self.erbirth_spine:clearTracks()
        self.erbirth_spine:removeFromParent()
        self.erbirth_spine = nil
    end
    _controller:openHeroHighLevHalidomRebirthPanel(false)
end