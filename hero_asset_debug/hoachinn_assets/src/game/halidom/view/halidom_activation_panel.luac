HalidomActivationPanel = HalidomActivationPanel or BaseClass(BaseView)

local controller = HalidomController:getInstance()
local model =  controller:getModel()

function HalidomActivationPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_halidom_activation_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
	self.limit_list = {}
	self.lvup_cost_list = {}
	self.step_cost_hero_data = {} -- 进阶消耗的英雄数据
    self.step_hero_list = {}    -- 进阶需要的英雄item列表
	self.attr_list = {}
	self.role_vo = RoleController:getInstance():getRoleVo()
end

function HalidomActivationPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 

	self.image_bg_1 = self.main_container:getChildByName("image_bg_1")
	self.tip_panel = self.main_container:getChildByName("tip_panel")
	self.title_panel = self.main_container:getChildByName("title_panel")
	self.lock_tip = createRichLabel(20,cc.c3b(0x00,0x00,0x00),cc.p(0.5,0.5),cc.p(self.tip_panel:getContentSize().width*0.5,self.tip_panel:getContentSize().height*0.5),-10,nil,600)
	self.lock_tip:setString(TI18N("语言_halm_01_34"))
	self.tip_panel:addChild(self.lock_tip)
	self.attr_panel = self.main_container:getChildByName("attr_panel")
	self.lock_item = self.attr_panel:getChildByName("item")
	self.item_icon = self.lock_item:getChildByName("icon")
	self.attr_txt = self.attr_panel:getChildByName("attr_txt")
	self.attr_txt:setString(TI18N("语言_halm_01_35"))
	self.attr_tip1 = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(228,190),-10,nil,380)
	self.attr_panel:addChild(self.attr_tip1)
	self.attr_tip2 = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(228,150),-10,nil,380)
	self.attr_panel:addChild(self.attr_tip2)
	self.attr_tip3 = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(228,50),-10,nil,380)
	self.attr_panel:addChild(self.attr_tip3)
	self.lock_panel = self.main_container:getChildByName("lock_panel")
	self.lock_act_tip = self.lock_panel:getChildByName("lock_act_tip")
	self.lock_act_tip:setVisible(false)
	self.lock_condition_panel = self.lock_panel:getChildByName("lock_condition_panel")
	self.lock_condition_txt = self.lock_condition_panel:getChildByName("lock_condition_txt")
	self.lock_condition_txt:setString(TI18N("语言_halm_01_36"))
	self.lock_condition = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(110,200),-4)
	self.lock_condition_panel:addChild(self.lock_condition)
	self.unlock_panel = self.main_container:getChildByName("unlock_panel")
	self.activation_btn = self.unlock_panel:getChildByName("activation_btn")
	self.activation_txt = self.activation_btn:getChildByName("label")
	self.activation_txt:setString(TI18N("语言_halm_01_37"))
	self.unlock_condition_panel = self.unlock_panel:getChildByName("unlock_condition_panel")
	self.un_lock_condition_txt = self.unlock_condition_panel:getChildByName("lock_condition_txt")
	self.un_lock_condition_txt:setString(TI18N("语言_halm_01_38"))
	for i=1,2 do
        local lvup_cost_bg = self.unlock_panel:getChildByName("lvup_cost_bg_" .. i)
        if lvup_cost_bg then
            local cost_object = {}
            cost_object.cost_bg = lvup_cost_bg
            cost_object.res_icon = self.unlock_panel:getChildByName("res_icon_"..i)
            cost_object.label = self.unlock_panel:getChildByName("label_"..i)
            table.insert(self.lvup_cost_list, cost_object)
        end
    end
	self.cost_tip = self.unlock_panel:getChildByName("cost_tip")
	self.cost_tip:setString(TI18N("语言_halm_01_39"))
	self.Image_2 = self.title_panel:getChildByName("Image_2")
	self.win_title = self.title_panel:getChildByName("win_title")
	self.close_btn = self.title_panel:getChildByName("close_btn")
	self.Sprite_1 = self.main_container:getChildByName("Sprite_1")
end

function HalidomActivationPanel:setData()
	self.item_icon_road = loadSpriteTextureFromCDN(self.item_icon, PathTool.getPlistImgForDownLoad("halidom","halidom_20"..9+self.halidom_id), ResourcesType.single, self.item_icon_road)
	self.win_title:setString(string.format(TI18N("语言_halm_01_40"),self.index))
	self.Image_2:setContentSize(self.win_title:getContentSize().width + 100, self.Image_2:getContentSize().height)
	self.data = deepCopy(model:getHighJades(self.halidom_id,self.index))
	self.cfg = deepCopy(Config.HalidomData.data_step_high[self.halidom_id][self.index][1])
	self.const_cfg = Config.HalidomData.data_const
	if self.data and next(self.data) then
		local txt = TI18N("语言_halm_01_41")
		local str = string.format(txt,self.index,HeroConst.CampName[self.halidom_id])
		self.lock_tip:setString(str)
		local now_num = 0
		local next_num = self.cfg.dynamic_attr[1][2]*0.1
		self.tip_panel:setContentSize(cc.size(self.tip_panel:getContentSize().width,self.lock_tip:getContentSize().height + 30))
		self.lock_tip:setPositionY(self.tip_panel:getContentSize().height - self.lock_tip:getContentSize().height*0.5 - 10)
		self.lock_panel:setVisible(false)
		self.unlock_panel:setVisible(true)
		self:upDataUnLockPanel()
		local _h = self.tip_panel:getContentSize().height + self.attr_panel:getContentSize().height + self.unlock_panel:getContentSize().height + 30
		self.image_bg_1:setContentSize(cc.size(self.image_bg_1:getContentSize().width , _h))
		self.main_container:setContentSize(cc.size(self.main_container:getContentSize().width, _h))
		self.title_panel:setPositionY(_h - 20)
		self.tip_panel:setPositionY(_h -20)
		self.attr_panel:setPositionY(_h - self.tip_panel:getContentSize().height - 20)
		self.unlock_panel:setPositionY(_h - self.tip_panel:getContentSize().height - self.attr_panel:getContentSize().height - 30)
		self.Sprite_1:setPositionY(-23)
	else
		controller:sender22214(self.halidom_id,self.index)
		local str = TI18N("语言_halm_01_42")
		self.lock_tip:setString(str)
		self.lock_panel:setVisible(true)
		self.unlock_panel:setVisible(false)
	end
	self:upDataAttrPanel()
end
function HalidomActivationPanel:upDataAttrPanel()
	if not self.cfg then return end
	self.attr_tip1:setString(TI18N("语言_halm_01_43"))
	self.attr_tip2:setString(TI18N("语言_halm_01_44"))
	self.attr_tip3:setString(string.format(TI18N("语言_halm_01_46"),self.const_cfg["halidom_level_up"].val))
	local attr_val = 0
	local txt = TI18N("语言_halm_01_45")
	local txt_list= {}
	for k, v in pairs(self.cfg.dynamic_attr) do
		local attr_name = Config.AttrData.data_key_to_name[v[1]]
		if not attr_name then
			attr_name = Config.AttrExtraData.data_key_to_name[v[1]]
		end
		local is_per = PartnerCalculate.isShowPerByStr(v[1])
		if is_per == true then
			attr_val = (v[2]/10) .."%"
		else
			attr_val = v[2]
		end
		if not self.attr_list[k] then
			self.attr_list[k] = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,0.5),cc.p(258,130),-10,nil,350)
			self.attr_panel:addChild(self.attr_list[k])
		end
		self.attr_list[k]:setString(string.format("<div href=detial><div fontcolor=#643223> %s：</div><div fontcolor=#0ea80e>%s</div></div>",  attr_name, tostring(attr_val)))
		self.attr_list[k]:setPosition(cc.p(240 + (k-1)%2*170,130 - math.ceil(k/2)*28))
	end
	

end
function HalidomActivationPanel:upDataLockPanel(data)
	if data.id ~= self.halidom_id or data.pos ~= self.index then return end
	self.limit_cfg = Config.HalidomData.data_pos_limit[self.halidom_id][self.index]
	local limit_desc_cfg = Config.HalidomData.data_limit_desc
	for k, v in pairs(self.limit_list) do
		v:setVisible(false)
	end
	local list = model:getHalidomDataById(data.id)
	local cfg = Config.HalidomData.data_const.halidom_open_limit.val
	if list.step >= cfg[2] then
		self.lock_act_tip:setString(transformTextToShort(TI18N("语言_c_7051"),30))
		addEvt2showAllTextTips(self.lock_act_tip,TI18N("语言_c_7051"),30)
		self.lock_act_tip:setTextColor(cc.c4b(0x0e,0xa8,0x0e,0xff))
	else
		self.lock_act_tip:setString(transformTextToShort(TI18N("语言_c_7050"),30))
		addEvt2showAllTextTips(self.lock_act_tip,TI18N("语言_c_7050"),30)
		self.lock_act_tip:setTextColor(cc.c4b(0xff,0x15,0x15,0xff))
	end
	self.lock_act_tip:setVisible(true)
	local _h = self.lock_condition_panel:getContentSize().height - 60
	for i = 1, tableLen(self.limit_cfg) do
		if not self.limit_list[i] then
			self.limit_list[i] = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(0,1),cc.p(40,0),-4,nil,550)
			self.lock_condition_panel:addChild(self.limit_list[i])
		end
		self.limit_list[i]:setVisible(true)
		for k, v in pairs(data.state_list) do
			if v.task_id == self.limit_cfg[i] then
				if v.state == 0 then
					self.limit_list[i]:setFontColor(cc.c3b(0xff,0x15,0x15))
				else
					self.limit_list[i]:setFontColor(cc.c3b(0x0e,0xa8,0x0e))
				end
				local evt_str = limit_desc_cfg[self.limit_cfg[i]].evt_list[1][1]
				local status = true
				if evt_str == "challenge_rank" or evt_str == "camp_recharge" then
					status = false
				end
				if evt_str == "camp_recharge" then
					if status then
						self.limit_list[i]:setString(i.."."..limit_desc_cfg[self.limit_cfg[i]].desc.."    "..v["val"].."/"..v["t_val"])
					else
						self.limit_list[i]:setString(i.."."..limit_desc_cfg[self.limit_cfg[i]].desc)
						local click_txt = string.format("<div href=xxx ><img src=\'%s\'/></div>", PathTool.getResFrame("common","common_2029"))
						local txt = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(0,0.5),cc.p(self.limit_list[i]:getContentSize().width+5,self.limit_list[i]:getContentSize().height*0.5),-4,nil,550)
						txt:setString(click_txt)
						self.limit_list[i]:addChild(txt)
						txt:addTouchEventListener(function (  )
							controller:openHeroHalidomActivationPanel(false)
							HeroController:getInstance():openHeroBagWindow(false)
							MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.main_scene)
							VipController:getInstance():openVipMainWindow(true, VIPTABCONST.PRIVILEGE)
						end)
					end
				else
					if status then
						self.limit_list[i]:setString(i.."."..limit_desc_cfg[self.limit_cfg[i]].desc.."    "..v["val"].."/"..v["t_val"])
					else
						self.limit_list[i]:setString(i.."."..limit_desc_cfg[self.limit_cfg[i]].desc)
					end
				end
				self.limit_list[i]:setPositionY(_h)
			end
		end
		_h = _h - self.limit_list[i]:getContentSize().height - 20
	end
end
function HalidomActivationPanel:upDataUnLockPanel()
	local cfg = deepCopy(self.cfg.loss_items)
	for k,v in pairs(self.lvup_cost_list) do
		v.cost_bg:setVisible(false)
		v.res_icon:setVisible(false)
		v.label:setVisible(false)
	end
	for i,v in ipairs(cfg) do
		local bid = v[1]
		local num = v[2]
		local cost_object = self.lvup_cost_list[i]
		local item_config = Config.ItemData.data_get_data(bid)
		if cost_object and item_config then
			cost_object.cost_bg:setVisible(true)
			cost_object.res_icon:setVisible(true)
			cost_object.label:setVisible(true)
			cost_object.cost_num = num
			local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
			if num > have_num then
				cost_object.label:setTextColor(cc.c3b(255, 93, 93))
			else
				cost_object.label:setTextColor(cc.c3b(255, 246, 228))
			end
			cost_object.label:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(num))
			moveTextBg(cost_object.label,cost_object.cost_bg,20)
			if cost_object.cost_bid ~= bid then
				-- 记录一下消耗的bid，用于数量实时刷新
				cost_object.cost_bid = bid
				local item_res = PathTool.getItemRes(item_config.icon)
				cost_object.res_icon:loadTexture(item_res, LOADTEXT_TYPE)
			end
		end
	end
    for k,v in pairs(self.step_hero_list) do
        v:setVisible(false)
    end
	-- 英雄消耗
	self.step_cost_hero_data = {}
	-- 指定英雄
	for i,v in ipairs(self.cfg.loss_fixed) do
		local hero_data = self:getHeroData(v[1], v[2], v[3])
		table.insert(self.step_cost_hero_data, hero_data)
	end
	-- 随机英雄
	for i,v in ipairs(self.cfg.loss_rand) do
		local hero_data = self:getHeroData(nil, v[2], v[3], v[1])
		table.insert(self.step_cost_hero_data, hero_data)
	end
	for i,hero_vo in ipairs(self.step_cost_hero_data) do
		local hero_item = self.step_hero_list[i]
		if hero_item == nil then
			hero_item = HeroExhibitionItem.new(0.8, true)
			hero_item:addCallBack(function() self:_onClickStepHeroData(i) end)
			self.unlock_condition_panel:addChild(hero_item)
			self.step_hero_list[i] = hero_item
		end
		hero_item:setHeadUnEnabled(true)
		hero_item:setVisible(true)
		hero_item:setPosition(cc.p(100 + (i-1) * (HeroExhibitionItem.Width * 0.8 + 10), 76))
		if hero_vo.bid == 0 then
			--随机卡的头像id
			local default_head_id = HeroController:getInstance():getModel():getRandomHeroHeadByQuality(hero_vo.star)
			hero_item:setData(hero_vo)
			hero_item:setDefaultHead(default_head_id)
		else
			hero_item:setData(hero_vo)
		end
		hero_item:setHeadUnEnabled(true)
	end
end
-- 获取英雄数据
function HalidomActivationPanel:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string.format("%s/%s", 0, count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
        else
            return nil
        end
    end
    data.dic_select_list = {}
    return data
end
function HalidomActivationPanel:_onClickStepHeroData( index )
    if not self.step_cost_hero_data[index] then return end
    --标志点击了那个
    self.step_cost_hero_data[index].is_select = true
    self.step_cost_hero_data[index].is_ignore_hero_hun = false
    HeroController:getInstance():openHeroUpgradeStarSelectPanel(true, self.step_cost_hero_data[index], {}, HeroConst.SelectHeroType.eHalidom)
end
-- 刷新选择英雄数据
function HalidomActivationPanel:updateSelectHeroInfo(  )
	if not self.step_cost_hero_data then return end
	for i,item in ipairs(self.step_cost_hero_data) do
		if item.is_select then
			item.is_select = false
			local count = 0
			for k,v in pairs(item.dic_select_list) do
				count = count + 1
			end
			item.lev = string.format("%s/%s", count, item.count)
			if self.step_hero_list[i] then
				self.step_hero_list[i].num_label:setString(item.lev)
				if count > 0 then
					self.step_hero_list[i]:setHeadUnEnabled(false)
				else
					self.step_hero_list[i]:setHeadUnEnabled(true)
				end
			end
		end
	end
end
-- 刷新消耗道具数量
function HalidomActivationPanel:checkNeedUpdateItemNum( item_list )
    if item_list == nil or next(item_list) == nil then return end
    for k, v in pairs(item_list) do
        if v.config then
            local bid = v.config.id
            self:updateCostItemNumByBid(bid)
        end
    end
end

function HalidomActivationPanel:updateCostItemNumByBid( bid )
	for _,cost_object in pairs(self.lvup_cost_list) do
		if cost_object.cost_bid == bid then
			local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
			if cost_object.cost_num > have_num then
				cost_object.label:setTextColor(cc.c3b(255, 93, 93))
			else
				cost_object.label:setTextColor(cc.c3b(255, 246, 228))
			end
			cost_object.label:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(cost_object.cost_num))
			moveTextBg(cost_object.label,cost_object.cost_bg,20)
			break
		end
	end
end
function HalidomActivationPanel:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openHeroHalidomActivationPanel(false)
    end)
    
	registerButtonEventListener(self.background, function ( )
		controller:openHeroHalidomActivationPanel(false)
	end)
	-- 进阶
	registerButtonEventListener(self.activation_btn, function (  )
		local cfg = Config.HalidomData.data_step_high[self.halidom_id][self.index]
		local step_cfg = cfg[self.data.jade_step+1]
		local status = true
		local tip_num = 0
		for k, v in pairs(step_cfg.conds) do
			if v[1] == "lev" then
				local num = model:getHalidomDataById(self.halidom_id).high_lev or 0
				if num < v[2] then
					status = false
					tip_num = v[2]
				end
			end
		end
		if status then
			if self.step_cost_hero_data and next(self.step_cost_hero_data) ~= nil then
				local hero_list = {} -- 固定英雄id
				local random_list = {} -- 随机英雄id
				for i,item in ipairs(self.step_cost_hero_data) do
					local count = 0
					for k,v in pairs(item.dic_select_list) do
						count = count + 1
					end
					if count < item.count then
						message(TI18N("语言_c_860"))
						return
					end
					for k,v in pairs(item.dic_select_list) do
						if item.bid == 0 then
							--随机卡
							table.insert(random_list, {id = k})
						else
							--指定卡
							table.insert(hero_list, {id = k})
						end
					end
				end
				controller:sender22211(self.halidom_id, self.index, hero_list, random_list)
			end
		else
			message(string.format(TI18N("语言_c_6576"),tip_num))
		end
	end, true)
    -- 圣物数据返回
    if not self.update_halidom_high_jades_limit_event then
        self.update_halidom_high_jades_limit_event = GlobalEvent:getInstance():Bind(HalidomEvent.Update_Halidom_High_Jades_Limit_Event, function (data)
            self:upDataLockPanel(data)
        end)
    end
	-- 圣物数据更新
    if not self.update_halidom_data_event then
        self.update_halidom_data_event = GlobalEvent:getInstance():Bind(HalidomEvent.Update_Halidom_Data_Event, function ( id )
            if self.halidom_id and self.halidom_id == id then
                self:setData()
            end
        end)
    end
	--添加英雄选择返回事件
    if self.update_hero_select_event == nil then
        self.update_hero_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event, function()
            self:updateSelectHeroInfo()
        end)
    end

    -- 金币更新
    if not self.role_lev_event and self.role_vo then
        self.role_lev_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE, function(key, value) 
            if key == "coin" then 
                self:updateCostItemNumByBid(1)
            end
        end)
    end
	-- 物品数量变化
    if not self.goods_add_event then
        self.goods_add_event = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function(bag_code, item_list) 
            if bag_code ~= BackPackConst.Bag_Code.BACKPACK then return end
            self:checkNeedUpdateItemNum(item_list)
        end)
    end
    if not self.goods_modify_event then
        self.goods_modify_event = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code, item_list) 
            if bag_code ~= BackPackConst.Bag_Code.BACKPACK then return end
            self:checkNeedUpdateItemNum(item_list)
        end)
    end
    if not self.goods_delete_event then
        self.goods_delete_event = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function(bag_code, item_list) 
            if bag_code ~= BackPackConst.Bag_Code.BACKPACK then return end
            self:checkNeedUpdateItemNum(item_list)
        end)
    end
end
function HalidomActivationPanel:openRootWnd(id,index)
	self.halidom_id = id
	self.index = index
	self:setData()
end

function HalidomActivationPanel:close_callback(  )
	for k,item in pairs(self.step_hero_list) do
		item:DeleteMe()
		item = nil
	end
    if self.update_hero_select_event then
        GlobalEvent:getInstance():UnBind(self.update_hero_select_event)
        self.update_hero_select_event = nil
    end
    if self.role_lev_event and self.role_vo then
        self.role_vo:UnBind(self.role_lev_event)
        self.role_lev_event = nil
    end
    if self.update_halidom_data_event then
        GlobalEvent:getInstance():UnBind(self.update_halidom_data_event)
        self.update_halidom_data_event = nil
    end
    if self.goods_add_event then
        GlobalEvent:getInstance():UnBind(self.goods_add_event)
        self.goods_add_event = nil
    end
    if self.goods_modify_event then
        GlobalEvent:getInstance():UnBind(self.goods_modify_event)
        self.goods_modify_event = nil
    end
    if self.goods_delete_event then
        GlobalEvent:getInstance():UnBind(self.goods_delete_event)
        self.goods_delete_event = nil
    end
    if self.update_halidom_high_jades_limit_event then
        GlobalEvent:getInstance():UnBind(self.update_halidom_high_jades_limit_event)
        self.update_halidom_high_jades_limit_event = nil
    end
	controller:openHeroHalidomActivationPanel(false)
end