function BattleDramaDunFightInfo:onClickDunBtn(index)
    for i=1,#self.dunlist do
        self.dunlist[i]:setStatus(i==index)
    end
    self.info.sub_id=index
    if not self.QueueData then
        controller:sender13235(self.info.chapter_id, self.info.dun_id,index)
    else
        self:setData()
    end 
end

function BattleDramaDunFightInfo:openRootWnd(data)
    self.data = data
    self.info=data.info
    local rewards = {}
    local cfg=Config.DungeonNinjaWarData.data_drama_dungeon_info(self.info.dun_id)
    local show_items=cfg.show_items
    for i, v in ipairs(show_items) do
        rewards[#rewards + 1] = {bid = v[1], num = v[2]}
    end
    self.item_scrollview:setData(rewards)
	self.item_scrollview:addEndCallBack(function()
        local item_list = self.item_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
			v:setSwallowTouches(false)
			v:setGotIcon(false)--self.data.info.pass >= 1
        end
	end)
    local path= string.format("resource/partner/%d.png", cfg.show_bid)
    self.hero_img:loadTexture(path, LOADTEXT_TYPE)
    self:CreateDunBtn()
    self:onClickDunBtn(self.info.sub_id)
end

function BattleDramaDunFightInfo:setData()
    if not self.QueueData then return end
    self.pointData = model:getSubPointData(self.info.sub_id,self.QueueData) 
    self.pointData.dun_id=self.info.dun_id
    self.pointData.chapter_id=self.info.chapter_id
    if not self.pointData then return end
    local pointData=self.pointData
    self:updateHeroForm(self.left_hero_list, self.left_position_list, pointData.pos_info, "left", self.left_bg_list, pointData.formation_type)
    self:updateHeroForm(self.right_hero_list, self.right_position_list, pointData.a_list, "right", self.right_bg_list, pointData.a_formation_type)
    local actionInfo = ActionController:getInstance():getActionSubTabVo(self.info.bid)
    local index=Config.DungeonNinjaWarData.data_drama_dungeon_info(self.info.dun_id).floor
    self.win_title:setString(string.format(TI18N("语言_c_5810"),index,self.info.sub_id))
    autoSizeTitleBg(self.win_title, self.image_title) 
    for i=1,#self.dunlist do
        local list=model:getSubHerolist(i)
        local num=0
        for k,v in pairs(list) do
            num=num+1
        end
        self.dunlist[i]:setData(i,num)
    end
end
-- 左右  都使用
function BattleDramaDunFightInfo:updateHeroForm(hero_list, position_list, pos_info, station, bg_list, form_type)
    for i, v in ipairs(bg_list) do
        v:setVisible(false)
    end
    local function _getHeroInfoByPos( pos )
        for _,info in pairs(pos_info) do
            if info.pos == pos then
                return info
            end
        end
    end
    for index = 1, 5 do
        local hero_item = hero_list[index]
        local pos = self:getFormPosByIndex(form_type, index)
        local info = _getHeroInfoByPos(station == "right" and pos or index)
        if info and hero_item then
            hero_item:setPosition(position_list[pos])--info.pos
            if (info.bid and info.bid ~= 0) or (info.partner_id and info.partner_id ~= 0) then
                local hero_vo =model:getPoolHeroVoById(self.pointData.sub_id, info.partner_id)
                if station == "right" then
                    hero_vo = HeroVo.New()
                    hero_vo:updateHeroVo(info)
                end
                if hero_vo then
                    if station == "left" then
                        hero_item:setData(hero_vo)
                    else
                        hero_item:setMonsterData(info)
                    end
                    hero_item:setVisible(true)
                else
                    hero_item:setVisible(false)
                end
            else
                hero_item:setVisible(false)
            end
        else
            hero_item:setVisible(false)
        end
        bg_list[pos]:setVisible(true)
    end
end

-- 更新精灵
function BattleDramaDunFightInfo:updateElfinList(data, elfin_panel, elfin_item_list, station)
    if not elfin_panel then return end
    if not data then return end
    local elfin_bid_list = data.plan_sprites or {}
    local elfin_panel = elfin_panel
    local elfin_item_list = elfin_item_list
    local function getElfinBidByPos(pos)
        if station == "right" then
            return nil
        end 
        local elfin_bid
        for k,v in pairs(elfin_bid_list) do
            if v.pos == pos then
                elfin_bid = v.item_bid
                break
            end
        end
        return elfin_bid
    end
    for i=1,4 do
        local elfin_item = elfin_item_list[i]
        if elfin_item == nil then
            elfin_item = SkillItem.new(true, true, true, 0.5)
            local size = elfin_panel:getContentSize()
            local pos_x =SkillItem.Width*0.5/2 + (i - 1)*(SkillItem.Width*0.5 + 6)
            elfin_item:setPosition(cc.p(pos_x, size.height/2))
            elfin_panel:addChild(elfin_item)
            elfin_item_list[i] = elfin_item
        end
        local item_bid = getElfinBidByPos(i)
        if item_bid then
            local bid = item_bid or 0
            elfin_item:showLockIcon(false)
            local elfin_cfg = Config.SpriteData.data_elfin_data(bid)
            if bid == 0 or not elfin_cfg then
                elfin_item:setData()
            else
                local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
                if skill_cfg then
                    elfin_item:setData(skill_cfg)
                end
            end
        else
            elfin_item:setData()
            -- elfin_item:showLockIcon(true)
        end
    end
    if station == "right" then
        self.tree_lv_left:setString(string.format(TI18N("语言_c_2589"), data.lev or 0))
    else
        self.tree_lv_right:setString(string.format(TI18N("语言_c_2589"), 0))
    end
end

-- 根据阵法类型和index，获取对应的位置
function BattleDramaDunFightInfo:getFormPosByIndex( form_type, index )
    local pos = 1
    local formation_config = Config.FormationData.data_form_data[form_type]
    if formation_config then
        for k,v in pairs(formation_config.pos) do
            if v[1] == index then
                pos = v[2]
                break
            end
        end
    end
    return pos
end

function BattleDramaDunFightInfo:close_callback()
    HeroController:getInstance():getModel():setBossFormPoint()
    if self.point_info_event then
        GlobalEvent:getInstance():UnBind(self.point_info_event)
        self.point_info_event = nil
    end
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    if self.refresh_point_info then
        GlobalEvent:getInstance():UnBind(self.refresh_point_info)
        self.refresh_point_info = nil
    end
    if self.clear_point_info then
        GlobalEvent:getInstance():UnBind(self.clear_point_info)
        self.clear_point_info = nil
    end
    if self.dunlist then
        for k, v in pairs(self.dunlist) do
            if v then
                v:DeleteMe() 
            end
        end
    end
    controller:openBattleDramaDunFightInfo(false)
end