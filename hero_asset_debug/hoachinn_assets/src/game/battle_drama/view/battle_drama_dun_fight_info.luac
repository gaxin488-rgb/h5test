BattleDramaDunFightInfo = BattleDramaDunFightInfo or BaseClass(BaseView)

local controller = BattleDramaController:getInstance()
local model = controller:getModel()

function BattleDramaDunFightInfo:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.win_type = WinType.Big
    self.layout_name = "battledrama/battle_darma_dun_fight_info"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planes", "planes_map"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("planes", "planes_info"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("planes","big_bg_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("planes","big_bg_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("War_tolerance","War_tolerance"), type = ResourcesType.plist},
    }
end

function BattleDramaDunFightInfo:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    local image_title = self.main_container:getChildByName("image_title")
    local win_title = self.main_container:getChildByName("win_title")
    win_title:setString(TI18N(""))
    autoSizeTitleBg(win_title, image_title)
    self.image_title = image_title
    self.win_title = win_title
    local hero_panel=self.main_container:getChildByName("hero_panel")
    self.hero_img=hero_panel:getChildByName("hero_img")
    self.record_img = self.main_container:getChildByName("record_img")
    self.record_img:getChildByName("name_txt_1"):setString(TI18N("语言_c_5208"))   
    self.btn_bonus = self.main_container:getChildByName("btn_bonus")
    self.btn_bonus:setVisible(true)
    self.btn_bonus:ignoreContentAdaptWithSize(true)
    self.bonus_txt = self.btn_bonus:getChildByName("label")
    self.bonus_txt:setPositionX(self.btn_bonus:getContentSize().width*0.5-3)
    self.bonus_txt:setString(TI18N("语言_c_3995"))
    setTextMaxWidth(self.bonus_txt,130,-10)
    self.tips_txt = self.main_container:getChildByName("tips_txt")
    self.tips_txt:setString(transformTextToShort(TI18N("语言_c_5209"), 80))
    self.tips_txt:setTouchEnabled(true)
    addEvt2showAllTextTips(self.tips_txt,TI18N("语言_c_5209"),80)
    self.dunlist={}
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.line=self.top_panel:getChildByName("bottom_bg")
    self.linWid=self.line:getContentSize().width 
    self.orginx=self.top_panel:getPositionX()
    local desc_bg = self.main_container:getChildByName("desc_bg")
    local left_bg_1 = self.main_container:getChildByName("left_bg_1")
    local right_bg_1 = self.main_container:getChildByName("right_bg_1")
    loadSpriteTexture(left_bg_1, PathTool.getPlistImgForDownLoad("planes","big_bg_3"), LOADTEXT_TYPE)
    loadSpriteTexture(right_bg_1, PathTool.getPlistImgForDownLoad("planes","big_bg_2"), LOADTEXT_TYPE)

    self.left_role_panel = self.main_container:getChildByName("panel_role_left")
    local panel_size = self.left_role_panel:getContentSize()
    --9位置
    self.left_position_list = {}
    self.left_bg_list = {}
    self.left_hero_list = {}
    for i=1,9 do
        local item_bg = self.left_role_panel:getChildByName("pos_bg_" .. i)
        local pos_x, pos_y = item_bg:getPosition()
        table.insert(self.left_position_list, cc.p(pos_x, pos_y - 5))
        table.insert(self.left_bg_list, item_bg)
        item_bg:setVisible(false)
    end
    local pos = {2,4,6,7,9} --
    for index=1,5 do
        self.left_hero_list[index] = HeroExhibitionItem.new(0.6, true)
        self.left_hero_list[index]:setPosition(self.left_position_list[pos[index]])
        self.left_role_panel:addChild(self.left_hero_list[index])
        self.left_hero_list[index]:addCallBack(function(_, data)
            self:onClickItem(data, "left")
        end)
        self.left_bg_list[pos[index]]:setVisible(true)
    end
    self.right_role_panel = self.main_container:getChildByName("panel_role_right")
    self.right_position_list = {}
    self.right_bg_list = {}
    self.right_hero_list = {}
    for i=1,9 do
        local item_bg = self.right_role_panel:getChildByName("pos_bg_" .. i)
        local pos_x, pos_y = item_bg:getPosition()
        table.insert(self.right_position_list, cc.p(pos_x, pos_y - 5))
        table.insert(self.right_bg_list, item_bg)
        item_bg:setVisible(false)
    end
    for index=1,5 do
        self.right_hero_list[index] = HeroExhibitionItem.new(0.6, true)
        self.right_hero_list[index]:setPosition(self.right_position_list[pos[index]])
        self.right_role_panel:addChild(self.right_hero_list[index])
        self.right_hero_list[index]:addCallBack(function(_,data)
            self:onClickItem(data, "right")
        end)
        self.right_bg_list[pos[index]]:setVisible(true)
    end

    -- 精灵
    self.tree_lv_left = self.main_container:getChildByName("tree_lv_left")
    self.tree_lv_right = self.main_container:getChildByName("tree_lv_right")
    self.left_elfin_item_list = {}
    self.right_elfin_item_list = {}

    --reward
    self.main_container:getChildByName("award_txt"):setString(TI18N("语言_c_11"))
    self.reward_panel = self.main_container:getChildByName("reward_panel")
    local panel_size = self.reward_panel:getContentSize()
    local scroll_view_size = cc.size(panel_size.width, panel_size.height+10)
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 15,                    -- x方向的间隔
        start_y = 10,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.8,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.8,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.reward_panel, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.btn_embattle = self.main_container:getChildByName("btn_embattle")
    self.btn_embattle:getChildByName("label"):setString(TI18N("语言_c_1389"))
    self.btn_embattle:setName("battle_btn")
end
function BattleDramaDunFightInfo:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.main_container, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.record_img, handler(self, self.onClickRecord), true, 2)
    registerButtonEventListener(self.btn_embattle, handler(self, self.onClickEmbattleBtn), true)
    registerButtonEventListener(self.btn_bonus, handler(self, self.onClickBonusBtn), true)
    if not self.point_info_event then
        self.point_info_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Update_DarmaDun_point_info,function (data)
            if not data then return end
            self.QueueData=data.sub_list
            self:setData()
        end)
    end

    if not self.clear_point_info then
        self.clear_point_info = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Clear_Darma_point_info,function ()
            self:onClickDunBtn(1)
        end)
    end

    if not self.refresh_point_info then
        self:addGlobalEvent(Battle_dramaEvent.refreshPointData, function ()
            for i=1,#self.dunlist do 
                controller:sender13235(self.info.chapter_id, self.info.dun_id,i)
            end
        end)
    end

    if not self.update_dram_danmu_event then
        self.update_dram_data_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.UpdateDunVedio, function(data)
            if not data or next(data.harder_dungeon_replay_data) ==nil then 
                message(TI18N("语言_c_4098"))
                return 
            else
                controller:openDunPlayerWindows(true, data.harder_dungeon_replay_data)
            end
        end)
    end
end

function BattleDramaDunFightInfo:CreateDunBtn()
    self.dunlist={}
    local cfg=Config.DungeonNinjaWarData.data_drama_dungeon_info(self.info.dun_id).unit_id
    local len=#cfg
    local startX=0
    for i=1,len do
        local btn=BattleDramaWarDunItem.new()
        btn:setAnchorPoint(cc.p(0.5,0.5))
        self.top_panel:addChild(btn)
        btn:setPosition(startX+(i-1)*100,25)
        registerButtonEventListener(btn.container, function()
            self:onClickDunBtn(i)
        end ,true, 2)
        self.dunlist[i]=btn
    end
    local wid= self.linWid-(5-len)*100    --self.linWid*((len-1)/4)
    self.line:setContentSize(cc.size(wid,self.line:getContentSize().height))
    self.top_panel:setPositionX(self.orginx+(5-len)*50)
end

function BattleDramaDunFightInfo:onClickItem(item_data, state)
    if not item_data then
        return 
    end
end

function BattleDramaDunFightInfo:onClickRecord()
    controller:send13215(self.info.dun_id,2)
end

function BattleDramaDunFightInfo:onClickCloseBtn()
    controller:openBattleDramaDunFightInfo(false)
end

function BattleDramaDunFightInfo:onClickBonusBtn()
    controller:openBattleDramaBonusInfo(true,self.info.dun_id)
end

function BattleDramaDunFightInfo:onClickEmbattleBtn()
    local setting = {
        pointData = self.pointData,
    }
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.BattleDramaDun, setting, HeroConst.FormShowType.eFormFight)
end

