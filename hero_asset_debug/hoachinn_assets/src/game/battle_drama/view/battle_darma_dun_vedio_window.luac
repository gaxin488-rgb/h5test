BattleDarmaDunVedioWindow = BattleDarmaDunVedioWindow or BaseClass(BaseView)

local controller = BattleDramaController:getInstance()
local model = controller:getModel()

function BattleDarmaDunVedioWindow:__init()
    self.view_tag = ViewMgrTag.TOP_TAG
    self.is_full_screen = false
    self.layout_name = "battledrama/battle_darma_dun_vedio_window"
    self.res_list = {
       
    }
    self.win_type = WinType.Big   
end

function BattleDarmaDunVedioWindow:open_callback()
    self.panel_bg = self.root_wnd:getChildByName("Panel_bg")
    self.background = self.panel_bg:getChildByName("background")
    self.panel_bg:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("root")
    self:playEnterAnimatianByObj(self.main_container, 2)
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.Image_1=self.main_container:getChildByName("Image_1")
    self.title_label = self.main_container:getChildByName("title_label")
    self.item_scrollview = self.main_container:getChildByName("item_scrollview")
    self.item_scrollview:setScrollBarEnabled(false)
    self.Image_1 = self.main_container:getChildByName("Image_1")
    if self.list_view == nil then
        local scroll_view_size = self.item_scrollview:getContentSize()
        local setting = {
            item_class = BattleDarmFightVedioItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 15,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 628,               -- 单元的尺寸width
            item_height = 180,              -- 单元的尺寸height
            row = 3,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.list_view = CommonScrollViewLayout.new(self.item_scrollview, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
end

function BattleDarmaDunVedioWindow:register_event()
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            controller:openDunVedioWindows(false)
        end
    end)
    self.background:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            controller:openDunVedioWindows(false)
        end
    end)
end

function BattleDarmaDunVedioWindow:setData(data)
    if data and next(data.replay_id_list)~=nil and self.list_view and self.list_view.setData then
        local list={}
        for i,v in pairs(data.replay_id_list) do
            local temp={}
            temp.vo=v
            temp.hName=data.name
            temp.face_id=data.face_id
            temp.face_update_time=data.face_update_time
            temp.face_file=data.face_file
            table.insert(list, temp)
        end
        self.list_view:setData(list)
        -- local chapter=model.war_data.chapter_id
        -- local dun=model.cur_dun_id
        -- local dun_config = Config.DungeonNinjaWarData.data_drama_dungeon_info(dun)
        local title=data.replay_id_list[1].name
        self.title_label:setString(title)--string.format(TI18N("语言_c_5810"),chapter,dun)  dun_config.name
        autoSizeTitleBg(self.title_label,self.Image_1)
    end
end

function BattleDarmaDunVedioWindow:openRootWnd(data)
    self.data = data
    self:setData(data)
end

--[[
    @desc: 设置标签页面板数据内容
    author:{author}
    time:2018-05-03 21:57:09
    return
]]
function BattleDarmaDunVedioWindow:close_callback()
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    controller:openDunPlayerWindows(false)
end

------------------------------------------
-- 子项
BattleDarmFightVedioItem = class("BattleDarmFightVedioItem", function()
    return ccui.Widget:create()
end)

function BattleDarmFightVedioItem:ctor()
    self:configUI()
    self:register_event()
end

function BattleDarmFightVedioItem:configUI(  )
    self.size = cc.size(628,150)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)

    local csbPath = PathTool.getTargetCSB("battledrama/battle_darma_dun_fight_vedio_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    self.container = container
    self.play_btn = container:getChildByName("play_btn")
    self.turn_num=  container:getChildByName("turn_num")
    self.right_name=container:getChildByName("right_name")
    setTextMaxWidth(self.right_name,120)
    self.left_name=container:getChildByName("left_name")
    self.left_list=container:getChildByName("left_list")
    self.right_list=container:getChildByName("right_list")

    if self.left_item_list == nil then
        local scroll_view_size = self.left_list:getContentSize()
        local setting = {
            -- item_class = HeroExhibitionItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 5,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 60,               -- 单元的尺寸width
            item_height = 60,              -- 单元的尺寸height
            -- row = 1,                        -- 行数，作用于水平滚动类型
            col = 5,                         -- 列数，作用于垂直滚动类型
            scale = 0.5
        }
        self.left_item_list = CommonScrollViewSingleLayout.new(self.left_list, cc.p(0, 0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0,0))
        -- self.left_item_list.scroll_view:setClippingEnabled(true)
        self.left_item_list:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.left_item_list:registerScriptHandlerSingle(handler(self,self.numberOfCells1), ScrollViewFuncType.NumberOfCells) --获取数量
        self.left_item_list:registerScriptHandlerSingle(handler(self,self.updateCellByIndex1), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.left_item_list:setClickEnabled(true)
    end

    if self.right_item_list == nil then
        local scroll_view_size = self.right_list:getContentSize()
        local setting = {
            -- item_class = HeroExhibitionItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 5,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 60,               -- 单元的尺寸width
            item_height = 60,              -- 单元的尺寸height
            -- row = 1,                        -- 行数，作用于水平滚动类型
            col = 5,                         -- 列数，作用于垂直滚动类型
            scale = 0.5
        }
        self.right_item_list = CommonScrollViewSingleLayout.new(self.right_list, cc.p(0, 0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0,0))
        self.right_item_list:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.right_item_list:registerScriptHandlerSingle(handler(self,self.numberOfCells2), ScrollViewFuncType.NumberOfCells) --获取数量
        self.right_item_list:registerScriptHandlerSingle(handler(self,self.updateCellByIndex2), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.right_item_list:setClickEnabled(true)
    end
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function BattleDarmFightVedioItem:createNewCell()
    local cell = HeroExhibitionItem.new(0.5, false)
    cell:addCallBack(function() self:onCellTouched(cell) end)
    return cell
end
--获取数据数量1
function BattleDarmFightVedioItem:numberOfCells1()
    return #self.data.vo.a_list
end

--获取数据数量2
function BattleDarmFightVedioItem:numberOfCells2()
    return #self.data.vo.b_list
end

function BattleDarmFightVedioItem:updateCellByIndex1(cell, index)
    cell.index = index
    local cell_data = self.data.vo.a_list[index]
    local temp={}
    temp.bid=cell_data.partner_bid
    temp.lev=cell_data.partner_lev
    temp.skin=cell_data.partner_skin
    temp.star= cell_data.partner_star
    cell:setData(temp)
end

function BattleDarmFightVedioItem:updateCellByIndex2(cell, index)
    cell.index = index
    local cell_data = self.data.vo.b_list[index]
    local temp={}
    temp.bid=cell_data.partner_bid    --Config.UnitData1.data_unit2(cell_data.partner_bid).head_icon
    temp.lev=cell_data.partner_lev
    temp.skin=cell_data.partner_skin
    temp.star= cell_data.partner_star
    cell:setMonsterData(temp)
end

function BattleDarmFightVedioItem:register_event( )
    registerButtonEventListener(self.play_btn, handler(self, self.onClickPlayBtn) ,true, 2)
end

function BattleDarmFightVedioItem:onClickPlayBtn()
    if not self.data then return end
    local repaly_id=self.data.vo.repaly_id
    playButtonSound2()
    BattleController:getInstance():csRecordBattle(repaly_id, self.data.sid)
end

function BattleDarmFightVedioItem:setData(data)
    if not data then return end
    self.data = data
    local info=data.vo

    local extendData = {scale = 0.5, can_click = false}
    self.left_item_list:reloadData()--info.a_list or {}, nil, nil, extendData
    self.right_item_list:reloadData()

    self.turn_num:setString(string.format(TI18N("语言_c_5811"), info.sub_id))
    self.right_name:setString(info.name)
    self.play_head = self:createRoleHead(60,110)
    self.enemy_head = self:createRoleHead(570,110)
    -- self.play_head:setLev(data.lev)
    self.play_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    self.enemy_head:setHeadRes(info.face_id, false, LOADTEXT_TYPE)
    --左右
    self.left_name:setString(data.hName)
    self.right_name:setString(info.name)
end

function BattleDarmFightVedioItem:createRoleHead(x,y)
    local play_head = PlayerHead.new(PlayerHead.type.circle)
    self.container:addChild(play_head)
    play_head:setPosition(cc.p(x,y))
    play_head:setAnchorPoint(cc.p(0.5,0.5))
    play_head:setTouchEnabled(true)
    play_head:setScale(0.6)
    return play_head
end

function BattleDarmFightVedioItem:DeleteMe( )
    if self.right_item_list then
        for i,v in ipairs(self.right_item_list) do
            v:DeleteMe()
        end
    end
    if self.left_item_list then
        for i,v in ipairs(self.left_item_list) do
            v:DeleteMe()
        end
    end
    if self.play_head then
        self.play_head:DeleteMe()
    end
    if self.enemy_head then
        self.enemy_head:DeleteMe()
    end
    self:removeAllChildren()
    self:removeFromParent()
end






