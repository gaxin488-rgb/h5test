BattleDarmaDunPlayerWindows = BattleDarmaDunPlayerWindows or BaseClass(BaseView)

local controller = BattleDramaController:getInstance()
local model = controller:getModel()

function BattleDarmaDunPlayerWindows:__init()
    self.view_tag = ViewMgrTag.TOP_TAG
    self.is_full_screen = false
    self.layout_name = "battledrama/battle_darma_dun_player_windows"
    self.res_list = {
       
    }
    self.win_type = WinType.Big    
end

function BattleDarmaDunPlayerWindows:open_callback()
    self.panel_bg = self.root_wnd:getChildByName("Panel_bg")
    self.background = self.panel_bg:getChildByName("background")
    self.panel_bg:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("root")
    self:playEnterAnimatianByObj(self.main_container, 2)
    self.close_btn = self.main_container:getChildByName("close_btn")
    local Image_1=self.main_container:getChildByName("Image_1")
    self.title_label = self.main_container:getChildByName("title_label")
    self.title_label:setString(TI18N("语言_c_5806"))
    autoSizeTitleBg(self.title_label,Image_1)
    self.item_scrollview = self.main_container:getChildByName("item_scrollview")
    self.item_scrollview:setScrollBarEnabled(false)
    self.Image_1 = self.main_container:getChildByName("Image_1")
    if self.list_view == nil then
        local scroll_view_size = self.item_scrollview:getContentSize()
        local setting = {
            item_class = BattleDarmaDunVedioItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 10,                    -- 第一个单元的Y起点
            space_y = 30,                   -- y方向的间隔
            item_width = 590,               -- 单元的尺寸width
            item_height = 160,              -- 单元的尺寸height
            row = 3,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.list_view = CommonScrollViewLayout.new(self.item_scrollview, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
end

function BattleDarmaDunPlayerWindows:register_event()
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            controller:openDunPlayerWindows(false)
        end
    end)
    self.background:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            controller:openDunPlayerWindows(false)
        end
    end)
end

function BattleDarmaDunPlayerWindows:setData(list)
    if list and next(list)~=nil then
        self.list_view:setData(list)
    end
end

function BattleDarmaDunPlayerWindows:openRootWnd(data)
    self:setData(data)
end

--[[
    @desc: 设置标签页面板数据内容
    author:{author}
    time:2018-05-03 21:57:09
    return
]]
function BattleDarmaDunPlayerWindows:close_callback()
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    controller:openDunPlayerWindows(false)
end

BattleDarmaDunVedioItem = class("BattleDarmaDunVedioItem",function()
    return ccui.Layout:create()
end)

function BattleDarmaDunVedioItem:ctor()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("battledrama/battle_darma_dun_vedio_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)
  
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self.container=self.root_wnd:getChildByName("container")
    self.role_name = self.container:getChildByName("my_name_label")
    self.attk_label = self.container:getChildByName("my_attk_label")
    self.time_label = self.container:getChildByName("time_label")
    self.video_btn = self.container:getChildByName("video_btn")
    self.first_image = self.root_wnd:getChildByName("first_image")
    self.first_label=self.root_wnd:getChildByName("first_label")
    self.label_time = self.container:getChildByName("time_txt")
    self.time_label:setString(TI18N("语言_c_5807"))
    self:registerEvent()
end

function BattleDarmaDunVedioItem:registerEvent()
    registerButtonEventListener(self.video_btn, handler(self, self.onClickVideoBtn), true,nil,nil,1.4)
end

function BattleDarmaDunVedioItem:onClickVideoBtn()
    controller:openDunVedioWindows(true,self.data)
end

function BattleDarmaDunVedioItem:setData(data)
    self.data=data
    self.role_name:setString(data.name)
    self.play_head = self:createRoleHead(160,65)
    -- self.play_head:setLev(data.lev)
    self.play_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    self.attk_label:setString(MoneyTool.moneyFormat(data.power))
    self.label_time:setString(data.time)
    self.first_label:setString(data.type==1 and TI18N("语言_c_5808") or TI18N("语言_c_5809"))
    self.first_image:setContentSize(cc.size(self.first_label:getContentSize().width+80,50))
end

function BattleDarmaDunVedioItem:createRoleHead(x,y)
    local play_head = PlayerHead.new(PlayerHead.type.circle)
    self.container:addChild(play_head)
    play_head:setPosition(cc.p(x,y))
    play_head:setAnchorPoint(cc.p(0.5,0.5))
    play_head:setTouchEnabled(true)
    play_head:setScale(0.8)
    return play_head
end

function BattleDarmaDunVedioItem:DeleteMe()
    if self.play_head then 
		self.play_head:DeleteMe()
		self.play_head = nil
	end
    self:removeAllChildren()
    self:removeFromParent()
end






