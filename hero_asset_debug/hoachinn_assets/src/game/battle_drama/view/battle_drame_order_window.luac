-- 奖励子项
BattleDrameOrderItem = class("BattleDrameOrderItem", function()
    return ccui.Widget:create()
end)

function BattleDrameOrderItem:ctor()
    self:configUI()
    self:register_event()
end

function BattleDrameOrderItem:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("battledrama/battle_drama_order_item"))
    self:setContentSize(cc.size(720, 139))
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.goods_item = main_container:getChildByName("goods_item") -- 付费礼物
    self.goods_item:setScrollBarEnabled(false)
    self.free_goods_item = main_container:getChildByName("free_goods_item") -- 免费礼物
    self.free_goods_item:setScrollBarEnabled(false)
    self.finish_img = main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_name = self.btn_get:getChildByName("name")
    self.btn_name:setString("")
    -- self.common_goods_item = BackPackItem.new(nil, true, nil, 0.8, nil, true)
    -- main_container:addChild(self.common_goods_item)
    -- self.common_goods_item:setPosition(cc.p(170, 139 / 2))
end

function BattleDrameOrderItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        local model = BattleDramaController:getInstance():getModel()
        local is_unlock = model:getOrderStatus()
        if is_unlock then -- 战令已解锁
            if self.pay_status == 1 or self.free_status == 1 then
                controller:send13034()--send13009(self.data.id)
            elseif self.free_status == 2 or self.pay_status == 2 then
                controller:openDramRewardView(false)
                TaskController:getInstance():openTaskMainWindow(false)
                MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.Darma)
            end
        else -- 未解锁
            if self.free_status == 1 then -- 可领取
                controller:send13034()--self.data.id
            elseif self.free_status == 2 then -- 前往过关
                controller:openDramRewardView(false)
                TaskController:getInstance():openTaskMainWindow(false)
                MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.Darma)
            elseif self.free_status == 3 then
                controller:openBuyCardView(true)
            end
        end
    end, true, 1)
end

function BattleDrameOrderItem:setData(data)
    if not data then
        return
    end
    self.data = data
    -- 引导需要
    if self.data then
        self.btn_get:setTag(self.data.limit_id)
    end

    local model = BattleDramaController:getInstance():getModel()
    local drama_data = model:getDramaData()
    if drama_data then
        self.max_dun_id = drama_data.max_dun_id
        local cur_drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(drama_data.max_dun_id)
        if cur_drama_dungeon_info then
            self.cur_dun = cur_drama_dungeon_info.floor or 0 -- 最大通关数
        end
    end
    local drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(self.data.limit_id)
    local floor = drama_dungeon_info.floor -- 当前item的所在层数

    local is_free_received = model:getDicDramaRewardID()[self.data.id]
    -- 免费道具-
    local free_getstatus = false
    local free_effect_id
    if self.max_dun_id and self.data and self.data.limit_id then
        if self.max_dun_id >= self.data.limit_id then
            if is_free_received then
                free_getstatus = true -- 已领取
                self.free_status = 3
            else
                free_getstatus = false -- 可领取
                self.free_status = 1
                free_effect_id = 263
            end
        else -- 前往 条件未满足
            free_getstatus = false
            self.free_status = 2
        end
    else
        free_getstatus = false
        self.free_status = 2
    end

    local free_data_list = data.items or {}
    local setting1 = {}
    setting1.start_x = 10
    setting1.scale = 0.7
    setting1.is_tip = true
    setting1.show_effect_id = free_effect_id
    setting1.is_get_status = free_getstatus
    setting1.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.free_item_list = commonShowSingleRowItemList(self.free_goods_item, self.free_item_list, free_data_list,setting1)

    -- 进阶奖励
    local is_order_received = model:getDicDramaRewardOrder()[self.data.id]
    local is_locak_status = model:getOrderStatus() -- 战令解锁状态
    local is_pay_status = false -- 进阶奖励领取状态
    local pay_effect_id
    if self.max_dun_id >= self.data.limit_id then
        if is_order_received then
            is_pay_status = true -- 已领取
            self.pay_status = 3
        else
            is_pay_status = false -- 可领取
            self.pay_status = 1
            pay_effect_id = 263
        end
    else -- 前往 条件未满足
        is_pay_status = false
        self.pay_status = 2
    end
    -- 付费道具
    local data_list = data.items_ext or {}
    local setting = {}
    setting.start_x = 10
    setting.scale = 0.7
    setting.lock = not is_locak_status
    setting.is_tip = true
    setting.show_effect_id = pay_effect_id
    setting.is_get_status = is_pay_status
    setting.max_count = 2
    setting.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.item_list = commonShowSingleRowItemList(self.goods_item, self.item_list, data_list, setting)

    if self.btn_get then
        addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
        if is_locak_status then -- 战令已经解锁
            if self.free_status == 1 or self.pay_status == 1 then -- 可领取
                self.btn_name:enableOutline(Config.ColorData.data_color4[264], 2)
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 5, 5)
            elseif self.free_status == 3 and self.pay_status == 3 then -- 已领取
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
            elseif self.free_status == 2 or self.pay_status == 2 then -- 前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            end
        else -- 战令未解锁时
            if self.free_status == 1 then -- 可领取
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 5, 5)
            elseif self.free_status == 2 then -- 前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            elseif self.free_status == 3 then
                self.btn_name:setString(TI18N("语言_c_2684"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
            end
        end
    end
end

function BattleDrameOrderItem:DeleteMe()
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.free_item_list then
        for i, v in pairs(self.free_item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

------------------------------------------
-- 功勋子项
BattleDramaRewardItem = class("BattleDramaRewardItem", function()
    return ccui.Widget:create()
end)

function BattleDramaRewardItem:ctor()
    self.size = cc.size(100, 139)
    self:configUI()
    self:register_event()
end

function BattleDramaRewardItem:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.select_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_2"),
        self.size.width / 2, self.size.height / 2 + 6, cc.p(0.5, 0.5), true)
    self.select_img = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_1"),
        self.size.width / 2, self.size.height / 2 + 6, cc.p(0.5, 0.5), true)
    self.select_img:setVisible(false)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_11"),
        self.size.width / 2, self.size.height / 5 + 11, cc.p(0.5, 0.5), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(71, 37))
    self.num_txt = createLabel(20, Config.ColorData.data_color4[1], nil, self.size.width / 2 - 2,
        self.size.height / 5 + 11, "", self.root_wnd, nil, cc.p(0.5, 0.5))
end

function BattleDramaRewardItem:register_event()
end

function BattleDramaRewardItem:setData(data)
    if not data then
        return
    end
    self.data = data
    local model = BattleDramaController:getInstance():getModel()
    local drama_data = model:getDramaData()
    if drama_data then
        self.max_dun_id = drama_data.max_dun_id
        local cur_drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(drama_data.max_dun_id)
        if cur_drama_dungeon_info then
            self.cur_dun = cur_drama_dungeon_info.floor or 0 -- 最大通关数
        end
    end
    local drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(self.data.limit_id)
    local floor = drama_dungeon_info and drama_dungeon_info.floor or 0 -- 当前item的所在层数
    local exp = floor or 0
    self.num_txt:setString(tostring(exp))

    local max_dun_id = self.max_dun_id or 0
    local limit_id = self.data.limit_id or 0
    if max_dun_id >= limit_id then
        self.select_img:setVisible(true)
    else
        self.select_img:setVisible(false)
    end
    -- 进度条相关
    local cfg = Config.DungeonData.data_drama_reward
    local id = self.data.id
    local last_id = id + 1
    if cfg[last_id] then
        if self.comp_bar == nil then
            local size = cc.size(139, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(50, 77))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =
                createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 0, 0)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(139, 27))
            self.comp_bar:setContentSize(cc.size(139, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        -- 上一条数据的相关
        local last_cfg = cfg[last_id]
        local last_limit_id = last_cfg.limit_id
        local last_floor = Config.DungeonData.data_drama_dungeon_info(last_limit_id).floor
        if max_dun_id >= limit_id then
            local total = last_floor - floor
            local now_pas = self.cur_dun - floor
            self.comp_bar:setPercent(now_pas / total * 100)
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
    end
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(id)
end

function BattleDramaRewardItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end
