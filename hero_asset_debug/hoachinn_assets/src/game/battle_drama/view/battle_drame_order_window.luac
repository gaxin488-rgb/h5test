BattleDrameOrderWindow = BattleDrameOrderWindow or BaseClass(BaseView)

local controller = BattleDramaController:getInstance()
local model = controller:getModel()
local controll_action = ActionController:getInstance()
-- local lev_reward_list = Config.HolidayNewWarOrderData.data_lev_reward_list
local lev_reward_list = {}
local table_sort = table.sort
local table_insert = table.insert
function BattleDrameOrderWindow:__init()
    -- self.is_full_screen = true
    -- self.win_type = WinType.Full
    -- self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Full
    self.layout_name = "battledrama/battle_drama_order_window"
    self.res_list = {{
        path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"),
        type = ResourcesType.plist
    }, {
        path = PathTool.getPlistImgForDownLoad("oncewarorder", "oncewarorder"),
        type = ResourcesType.plist
    }}
    self.reward_list = {}
end

function BattleDrameOrderWindow:isFunNeedHideBattle()
    return false
end

function BattleDrameOrderWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    -- if self.background ~= nil then
    --     self.background:loadTexture(PathTool.getResFrame("oncewarorder","once_war_order_1"), LOADTEXT_TYPE_PLIST)
    -- end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    self.icon_img = self.main_container:getChildByName("icon_img")
    -- 解锁奖励总览
    self.btn_open_lock = self.main_container:getChildByName("btn_open_lock")
    self.btn_open_lock_label = self.btn_open_lock:getChildByName("name")
    self.btn_open_lock_label:setString(TI18N("语言_c_4991"))

    self.main_container:getChildByName("Image_15"):getChildByName("Text_33_0"):setString(TI18N("语言_c_4990"))
    self.go_btn = self.main_container:getChildByName("go_btn")
    self.go_btn:getChildByName("name_0"):setString(TI18N("语言_c_108"))

    self.btn_rule = self.main_container:getChildByName("btn_rule")
    self.btn_close = self.main_container:getChildByName("btn_close")
    local medal_title = self.main_container:getChildByName("medal_title")
    medal_title:setString(TI18N("语言_c_4992"))
    -- setTextMaxWidth(medal_title, 210)
    self.medal_num = self.main_container:getChildByName("medal_num")
    self.medal_num:setString("")

    local tips_bg = self.main_container:getChildByName("Image_7")
    tips_bg:getChildByName("coin_label"):setString(TI18N("语言_hol_sta_pa_01_2"))
    self.main_container:getChildByName("Image_4"):getChildByName("Text_33"):setString(TI18N("语言_c_5109"))
    setTextMaxWidth(self.main_container:getChildByName("Image_4"):getChildByName("Text_33"), 330)
    self.goods_item = self.main_container:getChildByName("goods_item")
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔 k, 
        item_width = 720, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true,
        checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,
        ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),
        ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),
        ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),
        ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    ---进度条相关
    local scroll_view_size2 = cc.size(100, scroll_view_size.height)
    local setting = {
        start_x = 8, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 100, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.reward_num_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,
        ScrollViewStartPos.top, scroll_view_size2, setting)
    self.reward_num_item:setClickEnabled(false)
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),
        ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),
        ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),
        ScrollViewFuncType.UpdateCellByIndex) -- 更新cell

    -- self:createProgress()
    self:initAwardConfig()
    self:adaptationScreen()
    -- self:updatePercent()
    self:updateIconImg() -- 背景
    self:upDataTips() -- 领奖提示


    self:changeTestInfo()
end

function BattleDrameOrderWindow:changeTestInfo()
    if MAKELIFEBETTER_NEW then
        self.main_container:getChildByName("Image_15"):setPositionX(360)
        self.main_container:getChildByName("Image_4"):setPositionX(360)
        self.main_container:getChildByName("Image_1"):setPositionX(202)
        self.main_container:getChildByName("medal_title"):setPositionX(209)
        self.main_container:getChildByName("medal_num"):setPositionX(500)
        self.btn_open_lock:setVisible(false)
        self.icon_img:setVisible(false)
        self.go_btn:setVisible(false)
    end
end

function BattleDrameOrderWindow:upDataTips()
    local nextInfo = model:getNextDramaRewardInfo()
    if nextInfo then
        local max_floor = 0 -- 当前最大的通关数量
        local next_floor -- 下一次奖励需要的关卡
        local drama_data = model:getDramaData()
        if drama_data then
            self.max_dun_id = drama_data.max_dun_id
            local cur_drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(drama_data.max_dun_id)
            if cur_drama_dungeon_info then
                max_floor = cur_drama_dungeon_info.floor or 0 -- 最大通关数
            end
        end
        local drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(nextInfo.limit_id)
        local next_floor = drama_dungeon_info.floor -- 当前item的所在层数
        self.medal_num:setString("(" .. max_floor .. "/" .. next_floor .. ")")
    end
end

-- 奖励列表
function BattleDrameOrderWindow:createTaskCell()
    local cell = BattleDrameOrderItem.new()
    return cell
end

function BattleDrameOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function BattleDrameOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end

-- 进度条
-- 功勋数数列表
function BattleDrameOrderWindow:createTaskCell2()
    local cell = BattleDramaRewardItem.new()
    return cell
end

function BattleDrameOrderWindow:numberOfTaskCells2()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function BattleDrameOrderWindow:updateTaskCellByIndex2(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end

