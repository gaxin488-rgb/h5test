-- 进度条
function BattleDrameOrderWindow:createProgress()
    if self.comp_bar == nil then
        local size = cc.size(315, 27)
        local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
        local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
        if self.reward_goods_item and not tolua.isnull(self.reward_goods_item) and self.reward_goods_item.container and
            not tolua.isnull(self.reward_goods_item.container) then
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.reward_goods_item.container:addChild(bar_layout, 999)
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =
                createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 0, 1)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
        end
    end
end

function BattleDrameOrderWindow:updatePercent()
    if tolua.isnull(self.comp_bar) then
        return
    end
    -- local totalNum = #self.reward_list or 1
    -- -- printLuaTable(model:getNextDramaRewardInfo())
    -- local getNum = model:getNextDramaRewardInfo().id or 2
    -- self.comp_bar:setPercent((getNum - 2)/(totalNum - 1) * 100)
    local max_floor = 0 -- 当前最大的通关数量
    local drama_data = model:getDramaData()
    if drama_data then
        local cur_drama_dungeon_info = Config.DungeonData.data_drama_dungeon_info(drama_data.max_dun_id)
        if cur_drama_dungeon_info then
            max_floor = cur_drama_dungeon_info.floor or 0 -- 最大通关数
        end
    end
    local totalNum = model:getRewardMaxInfo()
    self.comp_bar:setPercent(0) -- (max_floor/totalNum * 100)
end

function BattleDrameOrderWindow:register_event()
    if not self.update_dram_data_event then
        self.update_dram_data_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.BattleDrama_Drama_Reward_Data,
            function(data)
                self:initAwardConfig()
                self:upDataTips()
                self:updateIconImg()
            end)
    end
    if not self.update_order_event then -- 更新战令解锁信息
        self.update_order_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.BattleDrama_Top_Update_Data,
            function(data)
                self:initAwardConfig()
                self:upDataTips()
                self:updateIconImg() -- 背景
            end)
    end
    if not self.update_dram_data_event1 then
        self.update_dram_data_event1 = GlobalEvent:getInstance():Bind(Battle_dramaEvent.BattleDrama_Update_Data,
            function(data)
                self:initAwardConfig()
            end)
    end

    registerButtonEventListener(self.btn_open_lock, function()
        controller:openBuyCardView(true)
    end, true, 1)

    registerButtonEventListener(self.go_btn, function()
        controller:openDramRewardView(false)
        TaskController:getInstance():openTaskMainWindow(false)
        MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.Darma)
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        controller:openDramRewardView(false)
    end, true, 2)

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = Config.DungeonData.data_drama_const.dungeon_pass_rule_desc
        if config then
            local config_desc = config.desc
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
end

-- 滑动的时候处理显示
function BattleDrameOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end

function BattleDrameOrderWindow:updateIconImg()
    if tolua.isnull(self.icon_img) or tolua.isnull(self.btn_open_lock) then
        return
    end
    loadSpriteTexture(self.icon_img, PathTool.getResFrame("oncewarorder", "once_war_order_6"), LOADTEXT_TYPE_PLIST)
    local status = model:getOrderStatus()
    if status then
        setChildUnEnabled(false, self.icon_img)
    else
        setChildUnEnabled(true, self.icon_img)
    end
    if status then
        self.btn_open_lock:setVisible(false)
    else
        self.btn_open_lock:setVisible(true)
    end

    if MAKELIFEBETTER_NEW then
        self.btn_open_lock:setVisible(false)
        self.icon_img:setVisible(false)
    end
    
end

function BattleDrameOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
end

-- 
function BattleDrameOrderWindow:setChangeLevelStatus()
    local freeList = model:getDicDramaRewardID() or {}
    local payList = model:getDicDramaRewardOrder() or {}
    local model = BattleDramaController:getInstance():getModel()
    local drama_data = model:getDramaData()
    local max_dun_id = 1
    if drama_data then
        max_dun_id = drama_data.max_dun_id
    end
    local title_pos = 1
    local order_status = model:getOrderStatus()
    local cfg = Config.DungeonData.data_drama_reward
    for i, v in ipairs(cfg) do
        if max_dun_id >= v.limit_id then --已通关
            if order_status then--战令已经解锁
                if not payList[v.id] or not freeList[v.id] then
                    title_pos = v.id
                    break
                end
            else
                if not freeList[v.id] then
                    title_pos = v.id
                    break
                end
            end
        else--未通关
            title_pos = v.id
            break
        end
    end
    self:jumpToMoveByY(139 * (title_pos - 1))
end

-- 红点
function BattleDrameOrderWindow:setTabRedPoint()
    local cur_day = model:getCurDay()
    local status = model:getRewardLevRedPoint()
    addRedPointToNodeByStatus(self.tab_view[1].btn_tab_view, status)
end

function BattleDrameOrderWindow:initAwardConfig()
    self.reward_list = {}
    local temp_reward_list = deepCopy(Config.DungeonData.data_drama_reward) 
    for k, v in ipairs(temp_reward_list) do
        table_insert(self.reward_list, v)
    end
    self.reward_goods_item:reloadData()
    self.reward_num_item:reloadData()
    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
    self:setChangeLevelStatus()
end

function BattleDrameOrderWindow:openRootWnd()
    -- controller:send28706()
end

function BattleDrameOrderWindow:close_callback()
    doStopAllActions(self.time_text)
    doStopAllActions(self.task_time_text)
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    if self.update_order_event then
        GlobalEvent:getInstance():UnBind(self.update_order_event)
        self.update_order_event = nil
    end
    if self.update_dram_data_event1 then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event1)
        self.update_dram_data_event1 = nil
    end
    controller:openDramRewardView(false)
end

