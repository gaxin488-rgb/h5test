-- 出战
function BattleDramaDunGoFightPanel:onClickGoFightBtn(  )
    local data = model:GetTeamData()
    local count=0
    for i, v in pairs(data) do
        if #v.pos_info>0 then
            count=count+1
        end
    end
    if count<#self.dunlist then
       message(TI18N("语言_c_5813"))
       return
    end
    MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.NinjaWar)
    HeroController:getInstance():openFormGoFightPanel(false)
    BattleDramaController:getInstance():openBattleDramaDunFightInfo(false)
    -- BattleDramaController:getInstance():sender13236(data)
    BattleDramaController:getInstance():send13203(1)
end

function BattleDramaDunGoFightPanel:setData(data, pointData)
    if not data then return end
    if not pointData then return end
    self.team_data_list = data
    self.pointData = pointData
    self.plan_id = pointData.plan_id
    self.chapter_id=pointData.chapter_id
    self.dun_id=pointData.dun_id
    -- 神器id
    self.hallows_id = pointData.hallows_id
    -- 阵法类型
    self.formation_type = pointData.formation_type
    
    self.halo_num = PotentialController:getInstance():getModel():getHaloNum()
    self:updateLeftTeamInfo()
    self:updateTeamInfo()
    self:updateFormationData(true)
    self:updateRightTeamInfo()
    self:CreateDunBtn()
    self:setBtnStatus(pointData)
    self:updateJinqiBtnStatus()
end

function BattleDramaDunGoFightPanel:updateJinqiBtnStatus()
    local is_jinqi_open = JinqiController:getInstance():getModel():checkJinqiFunctionOpenStatus()
    if is_jinqi_open then
        self.change_btn:setVisible(true)
        self.elfin_btn_label:setVisible(false)
    else
        self.elfin_btn_label:setVisible(true)
        self.change_btn:setVisible(false)
    end
end

function BattleDramaDunGoFightPanel:setBtnStatus(pointData)
    for i=1,#self.dunlist do
        self.dunlist[i]:setStatus(i==pointData.sub_id)
    end
    local cfg=Config.DungeonNinjaWarData.data_drama_dungeon_info(self.dun_id).power
    if cfg then
        local power_num=cfg[pointData.sub_id]
        self.label_power_left:setString(TI18N("语言_c_248")..power_num)
    end
end

function BattleDramaDunGoFightPanel:updateLeftTeamInfo()
    -- 给每个item设置站位数据(站位数据是固定的)
    for i,item in ipairs(self.hero_item_list_left) do
        local pos = self:getFormPosByIndex(self.formation_type, i)
        item:setExtendData({scale = 1, can_click = true, pos_id = pos})
    end
    -- 英雄数据
    if self.hero_item_list_left and self.pointData then
        local function _getHeroInfoByPos(pos)
            for _,info in pairs(self.pointData.pos_info) do
                if info.pos == pos then
                    return info
                end
            end
        end
        for index,hero_item in ipairs(self.hero_item_list_left) do
            local hero_info = _getHeroInfoByPos(index)
            if hero_info then
                local hero_vo =model:getPoolHeroVoById(self.pointData.sub_id, hero_info.partner_id)
                if hero_vo then
                    hero_item:setData(hero_vo)
                    hero_item:setChosenImg(0)
                end
            else
                hero_item:setData()
                hero_item:setChosenImg(0)
            end
        end
    end
end

-- 根据阵法类型和index，获取对应的位置
function BattleDramaDunGoFightPanel:getFormPosByIndex( form_type, index )
    local pos = 1
    local formation_config = Config.FormationData.data_form_data[form_type]
    if formation_config then
        for k,v in pairs(formation_config.pos) do
            if v[1] == index then
                pos = v[2]
                break
            end
        end
    end
    return pos
end

function BattleDramaDunGoFightPanel:getData()
    local team_data = model:GetTeamData()
    return team_data
end

-- 英雄列表选择了一位英雄
function BattleDramaDunGoFightPanel:onSelectHero( item, hero_vo )
    if self.is_show_act == true or self.is_move_hero == true then return end
    if not self.pointData then return end
    local sub_id=self.pointData.sub_id
    if hero_vo.is_ui_select == true then
        if hero_vo.point_id==sub_id then
            hero_vo.is_ui_select = false
            hero_vo.teamNum=nil
            model:RemoveHeroTeam(hero_vo,sub_id)
            item:setChosenImg(0)
            self:cancelSelectHeroItem(hero_vo.partner_id, item)
        else
            local change_index = self:setEmptyHeroItem(hero_vo, item)
            if change_index then
                model:RemoveHeroTeam(hero_vo,hero_vo.teamNum)
                model:AddHeroTeam(hero_vo,sub_id,change_index)
                self:ChangeDunCount(hero_vo.teamNum)
                hero_vo.teamNum=sub_id
                item:setChosenImg(sub_id)
            end
        end
    else
        local change_index = self:setEmptyHeroItem(hero_vo, item)
        if change_index then
            model:AddHeroTeam(hero_vo,sub_id,change_index)
            hero_vo.is_ui_select = true
            item:setSelected(true)
            hero_vo.teamNum=sub_id
            item:setChosenImg(sub_id)
        end
    end
    self:ChangeDunCount()
end

function BattleDramaDunGoFightPanel:ChangeDunCount(target_id)
    local sub_id=target_id~=nil and target_id or self.pointData.sub_id
    local dunBtn=self.dunlist[sub_id]
    local list=model:getSubHerolist(sub_id) 
    local count=0
    if list and next(list) ~= nil then
        for _,v in pairs(list) do
            count=count+1
        end
    end
    if dunBtn then
        dunBtn:setData(sub_id,count)
    end
end

function BattleDramaDunGoFightPanel:cancelSelectHeroItem( partner_id, super_hero_item )
    if self.hero_item_list_left then
        for _,item in ipairs(self.hero_item_list_left) do
            local hero_vo = item:getData()
            if hero_vo and hero_vo.partner_id == partner_id then
                hero_vo.is_ui_select = false
                item:setData()
                if not self.move_hero_item then
                    self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                    self.main_container:addChild(self.move_hero_item)
                end
                self.move_hero_item:setData(hero_vo)
                local world_pos = item:convertToWorldSpace(cc.p(0, 0))
                local target_pos = self.main_container:convertToNodeSpace(world_pos)
                local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                local item_pos = self.main_container:convertToNodeSpace(super_world_pos)
                self.is_show_act = true
                self.move_hero_item:setPosition(cc.p(target_pos.x+HeroExhibitionItem.Width*0.7/2, target_pos.y+HeroExhibitionItem.Height*0.7/2))
                local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(item_pos.x+HeroExhibitionItem.Width/2, item_pos.y+HeroExhibitionItem.Height/2))
                local call_back = function ()
                    self.move_hero_item:setData()
                    self.move_hero_item:setPosition(cc.p(-1000, -1000))
                    if super_hero_item then
                        super_hero_item:setSelected(false)
                    end
                    self:updateTeamInfo()
                    self.is_show_act = false
                end
                self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                return
            end
        end
    end
end

-- 取出第一个空位置
function BattleDramaDunGoFightPanel:setEmptyHeroItem( data, super_hero_item )
    if self.hero_item_list_left and not self:checkIsHaveSameHeroInOneTeam(data, true) then
        for i,item in ipairs(self.hero_item_list_left) do
            local hero_vo = item:getData()
            if not hero_vo then
                if not self.move_hero_item then
                    self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                    self.main_container:addChild(self.move_hero_item)
                end
                self.move_hero_item:setData(data)
                local world_pos = item:convertToWorldSpace(cc.p(0, 0))
                local target_pos = self.main_container:convertToNodeSpace(world_pos)
                local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                local item_pos = self.main_container:convertToNodeSpace(super_world_pos)
                self.is_show_act = true
                self.move_hero_item:setPosition(cc.p(item_pos.x+HeroExhibitionItem.Width/2, item_pos.y+HeroExhibitionItem.Height/2))
                local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+HeroExhibitionItem.Width*0.7/2, target_pos.y+HeroExhibitionItem.Height*0.7/2))
                local call_back = function (  )
                    self.move_hero_item:setData()
                    self.move_hero_item:setPosition(cc.p(-1000, -1000))
                    if item then
                        item:setData(data)
                        item:setChosenImg(0)
                    end
                    self:updateTeamInfo()
                    self.is_show_act = false
                end
                self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                return i
            end
        end
        return 
    end
    -- 能走到这里，就一定是同队伍有同类英雄
    message(TI18N("语言_c_447"))
end

-- 判断某一队伍中是否有同类英雄
function BattleDramaDunGoFightPanel:checkIsHaveSameHeroInOneTeam(hero_vo, no_tips )
    local is_have = false
    local team_object = self.hero_item_list_left
    if team_object then
        for k,item in pairs(team_object) do
            local data = item:getData()
            if data and data.bid == hero_vo.bid then
                is_have = true
                break
            end
        end
    end
    if is_have and not no_tips then
        message(TI18N("语言_c_447"))
    end
    return is_have
end

-- 点击英雄
function BattleDramaDunGoFightPanel:onClickHeroItem(hero_index )
    local hero_item_list = self.hero_item_list_left or {}
    local hero_item = hero_item_list[hero_index]
    if hero_item then
        local hero_vo = hero_item:getData()
        if hero_vo then
            hero_vo.is_ui_select = false
            hero_item:setData()
            model:RemoveHeroTeam(hero_vo,self.pointData.sub_id)
            hero_vo.teamNum=nil
            hero_vo.point_id=nil
            self:updateTeamInfo()
            self:ChangeDunCount()
            if self.super_panel then
                local super_hero_item = self.super_panel:getCellHeroItemByPartnerId(hero_vo.partner_id)
                self.super_panel:updateShowlist(hero_vo.partner_id)
                if super_hero_item then
                    self.is_show_act = true
                    if not self.move_hero_item then
                        self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                        self.main_container:addChild(self.move_hero_item)
                    end
                    self.move_hero_item:setData(hero_vo)
                    local world_pos = hero_item:convertToWorldSpace(cc.p(0, 0))
                    local item_pos = self.main_container:convertToNodeSpace(world_pos)
                    self.move_hero_item:setPosition(cc.p(item_pos.x+HeroExhibitionItem.Width*0.7/2, item_pos.y+HeroExhibitionItem.Height*0.7/2))
                    local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                    local target_pos = self.main_container:convertToNodeSpace(super_world_pos)
                    local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+HeroExhibitionItem.Width/2, target_pos.y+HeroExhibitionItem.Height/2))
                    local call_back = function ()
                        self.move_hero_item:setData()
                        self.move_hero_item:setPosition(cc.p(-1000, -1000))
                        super_hero_item:setSelected(false)
                        -- super_hero_item:getData().is_ui_select = false
                        -- super_hero_item:getData().teamNum=nil
                        -- super_hero_item:getData().point_id=nil
                        super_hero_item:setChosenImg(0)
                        self.is_show_act = false
                    end
                    self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))                    
                end
            end
        end
    end
end
---- 更新right战力、阵营信息
function BattleDramaDunGoFightPanel:updateRightTeamInfo( )
    if not self.pointData then return end
    self.pointData.a_formation_type = self.pointData.a_formation_type == 0 and 1 or self.pointData.a_formation_type
    local team_object = self.hero_item_list_right
    if not team_object then return end
    local a_list = self.pointData.a_list--地方数据
    local getRightHeroVoBy = function(pos)
        for k, v in pairs(a_list or {}) do
            if v.pos == pos then
                local aherovo = HeroVo.New()
                aherovo:updateHeroVo(v)
                return aherovo
            end
        end
        return nil
    end
    -- 战力
    local power_num = self.pointData.a_power
    local function _getHeroInfoByPos( pos )
        for _,info in pairs(a_list) do
            if info.pos == pos then
                return info
            end
        end
    end
    for index,hero_item in ipairs(team_object) do
        local pos = self:getFormPosByIndex(self.pointData.a_formation_type, index)
        local hero_info = _getHeroInfoByPos(pos)
        if hero_info then
            local hero_vo = getRightHeroVoBy(pos)
            if hero_vo then
                hero_item:setMonsterData(hero_vo)
            end
        else
            local hero_vo = hero_item:getData()
            hero_item:setData()
        end
    end
    self.label_power_right:setString(power_num)
    --更新位置
    local formation_config = Config.FormationData.data_form_data[self.pointData.a_formation_type]
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        dic_pos_index[pos] = index
        --更新位置
        if team_object[index] then
            team_object[index]:setPosition(self.nine_position_right[pos])
        end
    end

    --没使用的要变灰变暗
    local index = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img_right[index]:setPosition(self.nine_position_right[pos])
            index = index + 1
            if index > 4 then
                break
            end
        end
    end
end

-- 更新left战力、阵营信息
function BattleDramaDunGoFightPanel:updateAllTeamInfo(  )
    self:updateTeamInfo()
end

-- 更新队伍的信息
function BattleDramaDunGoFightPanel:updateTeamInfo( )
    local team_object = self.hero_item_list_left
    if not team_object then return end

    -- 战力
    local power_num = 0
    local dic_camp = {}
    for k,item in pairs(team_object) do
        local hero_vo = item:getData()
        if hero_vo then
            power_num = power_num + (hero_vo.power or 0)
            local config = Config.PartnerData.data_partner_base[hero_vo.bid] 
            if config and config.camp_type then
                if dic_camp[config.camp_type] == nil then
                    dic_camp[config.camp_type] = 1
                else
                    dic_camp[config.camp_type] = dic_camp[config.camp_type] + 1
                end
            end
        end
    end
    self.fight_label:setNum(power_num)
    local form_id_list = BattleController:getInstance():getModel():getFormIdListByCamp(dic_camp)
    self.halo_form_id_list = form_id_list
    local halo_icon_config, alien_effect = BattleController:getInstance():getModel():getCampIconConfigByIds(form_id_list)
    if halo_icon_config then
        local halo_res = PathTool.getCampGroupIcon(halo_icon_config.icon)
        self.halo_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_load)
        addCountForCampIcon(self.halo_btn, halo_icon_config.nums)
        if self.halo_btn and self.halo_btn.top_num_txt and self.halo_btn.top_sp then
            self.halo_btn.top_num_txt:setVisible(false)
            self.halo_btn.top_sp:setVisible(false)
        end
        if self.halo_btn and self.halo_btn.bottom_num_txt and self.halo_btn.bottom_sp then
            self.halo_btn.bottom_num_txt:setVisible(false)
            self.halo_btn.bottom_sp:setVisible(false)
        end
        if self.halo_btn and self.halo_btn.bottom_num_txt2 and self.halo_btn.bottom_sp2 then
            self.halo_btn.bottom_num_txt2:setVisible(false)
            self.halo_btn.bottom_sp2:setVisible(false)
        end
        self.halo_label:setString("")
        self:updateEffect(true, halo_res, alien_effect)
    else
        local halo_res = PathTool.getCampGroupIcon(1000)
        self.halo_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_load)
        addCountForCampIcon(self.halo_btn)
        self.halo_label:setString(TI18N("语言_c_3170"))
        self:updateEffect(false, halo_res)
    end

    --神器
    local hallows_config = Config.HallowsData.data_base[self.hallows_id]
    if hallows_config then
        self.hallow_item:showAddIcon(false)
        local hallows_vo = HallowsController:getInstance():getModel():getHallowsById(self.hallows_id)
        if hallows_vo and hallows_vo.look_id ~= 0 then
            local magic_cfg = Config.HallowsData.data_magic[hallows_vo.look_id]
            if magic_cfg then
                self.hallow_item:setBaseData(magic_cfg.item_id)
                self.hallow_item:setMagicIcon(true)
            else
                self.hallow_item:setBaseData(hallows_config.item_id)
                self.hallow_item:setMagicIcon(false)
            end
        else
            self.hallow_item:setBaseData(hallows_config.item_id)
            self.hallow_item:setMagicIcon(false)
        end
    else
        self.hallow_item:setData()
        self.hallow_item:showAddIcon(true)
    end
    self:updateElfinList()
    self:initSpSkillInfoList(self.pointData.sub_id)
end

--播放特效
function BattleDramaDunGoFightPanel:updateEffect(status, halo_res, alien_effect)
    if status then
        if self.select == nil then
            local x, y = self.halo_btn:getPosition()
            self.select = createImage(self.btn_scroll, PathTool.getResFrame("common", "common_1101"), x, y, cc.p(0.5, 0.5), true)
            self.select:setCascadeOpacityEnabled(true)
            self.select:setScale(0.8)
        else
            self.select:setVisible(true)
        end
        if not self.select.alien then
            local size = self.select:getContentSize()
            local alien_res = PathTool.getCampGroupIcon("2001")
            self.select.alien = createImage(self.select, "", size.width/2, size.height/2, cc.p(0.5, 0.5), false)
            loadImageTextureFromCDN(self.select.alien, alien_res, ResourcesType.single)
            self.select.alien:setVisible(false)
        end
        self.select.alien:setVisible(alien_effect and alien_effect ~= "")

        local fadein = cc.FadeIn:create(0.6)
        local fadeout = cc.FadeOut:create(0.6)
        self.select:runAction(cc.RepeatForever:create(cc.Sequence:create(fadein, fadeout)))
    else
        if self.select then
            doStopAllActions(self.select)
            self.select:setVisible(false)
        end
    end
end

function BattleDramaDunGoFightPanel:updateFormationData(is_fixed)
    local formation_config = Config.FormationData.data_form_data[self.formation_type]
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
    local width = self.cell_width - 10
    --改变锁定忍者的位置
    local target_item = nil
    local new_pos = 4
    
    if self.pointData then
        local formation_config = Config.FormationData.data_form_data[self.formation_type]
        for i,hero_item in ipairs(self.hero_item_list_left) do
            local hero_vo = hero_item:getData()
            local extend = hero_item:getExtendData()
            if hero_vo and hero_vo.is_init_lock then
                target_item = hero_item
                break
            end
        end
    end
    if is_fixed then
        target_item = nil
    end
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        dic_pos_index[pos] = index
        --更新位置
        if self.hero_item_list_left[index] then
            self.hero_item_list_left[index]:setPosition(self.nine_position[pos])
            self.hero_item_list_left[index]:setExtendData({scale = 1, can_click = true, pos_id = pos})

            if target_item and pos == new_pos then
                local item = self.hero_item_list_left[index]
                local change_hero_vo = item:getData()
                item:setData(target_item:getData())
                target_item:setData(change_hero_vo)
            end
        end
        local world_pos = self.hero_item_list_left[index]:convertToWorldSpace(cc.p(0, 0))
        local node_pos = self.main_container:convertToNodeSpace(world_pos)
        local rect = cc.rect( node_pos.x, node_pos.y, HeroExhibitionItem.Width*0.7, HeroExhibitionItem.Height*0.7)
        self.item_rect_list[i] = rect
    end

    --没使用的要变灰变暗
    local index = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img_left[index]:setPosition(self.nine_position[pos])
            index = index + 1
            if index > 4 then
                break
            end
        end
    end
    self:updateFormationIcon()
end

--更新阵法item
function BattleDramaDunGoFightPanel:updateFormationIcon()
    if not self.formation_type  then return end

    local res = PathTool.getResFrame("form", "form_icon_"..self.formation_type)
    loadSpriteTexture(self.form_icon, res, LOADTEXT_TYPE_PLIST)
end

-- 更新精灵
function BattleDramaDunGoFightPanel:updateElfinList()
    if not self.elfin_btn then return end
    local plan_sprites = {}
    if self.pointData then
        self.save_elfin_data = self.pointData.plan_sprites --保存一下 用于古树信息返回处理用的..
    end
    local elfin_bid_list = self.save_elfin_data

    local function getElfinBidByPos( pos )
        local elfin_bid
        for k,v in pairs(elfin_bid_list) do
            if v.pos == pos then
                elfin_bid = v.item_bid
                break
            end
        end
        return elfin_bid
    end
    for i=1,4 do
        local elfin_bid = getElfinBidByPos(i)
        local elfin_item = self.elfin_item_list[i]
        if elfin_item == nil then
            elfin_item = SkillItem.new(true, false, true, 0.4)
            local pos_x = 20
            local pos_y = 66
            if i == 3 or i == 4 then
                pos_y = 18
            end
            if i == 2 or i == 4 then
                pos_x = 68
            end
            elfin_item:setPosition(cc.p(pos_x, pos_y))
            self.elfin_btn:addChild(elfin_item)
            self.elfin_item_list[i] = elfin_item
        end
        local item_bid = ElfinController:getInstance():getModel():getElfinItemByPos(i)
        if item_bid then
            local bid = elfin_bid or 0
            elfin_item:showLockIcon(false)
            local elfin_cfg = Config.SpriteData.data_elfin_data(bid)
            if bid == 0 or not elfin_cfg then -- 已解锁，但未放置精灵
                elfin_item:setData()
            else
                local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
                if skill_cfg then
                    elfin_item:setData(skill_cfg)
                end
            end
        else
            elfin_item:setData()
            elfin_item:showLockIcon(true)
        end
    end
end
--更新禁器
function BattleDramaDunGoFightPanel:updateJinqiList()
    if not self.jinqi_btn then return end
    local elfin_bid_list = {}
    if self.jinqi_data and self.jinqi_data.team_list and self.pointData then
        for key, value in pairs(self.jinqi_data.team_list) do
            if value.team == self.pointData.sub_id then
                elfin_bid_list = value.team_prohibitors
            end
        end
    end

    local function getJinqiBidByPos( pos )
        local elfin_bid
        for k,v in pairs(elfin_bid_list) do
            if v.pos == pos then
                elfin_bid = v.item_bid
                break
            end
        end
        return elfin_bid
    end
    for i=1,4 do
        local jinqi_bid = getJinqiBidByPos(i)
        local jinqi_item = self.jinqi_item_list[i]
        if jinqi_item == nil then
            jinqi_item = SkillItem.new(true, false, true, 0.4)
            local pos_x = 20
            local pos_y = 66
            if i == 3 or i == 4 then
                pos_y = 18
            end
            if i == 2 or i == 4 then
                pos_x = 68
            end
            jinqi_item:setPosition(cc.p(pos_x, pos_y))
            self.jinqi_btn:addChild(jinqi_item)
            self.jinqi_item_list[i] = jinqi_item
        end
        local item_bid = JinqiController:getInstance():getModel():getPosInfo(i)
        if item_bid then
            local bid = jinqi_bid or 0
            jinqi_item:showLockIcon(false)
            local jinqi_cfg = Config.ProhibitorData.data_get_proh_star[bid]
            if bid == 0 or not jinqi_cfg then -- 已解锁，但未放置精灵
                jinqi_item:setData()
            else
                local jinqi_skill_id = jinqi_cfg[0].active_skill[1]
                local skill_cfg = Config.SkillData.data_get_skill(jinqi_skill_id)
                if skill_cfg then
                    jinqi_item:setData(skill_cfg)
                end
            end
        else
            jinqi_item:setData()
            jinqi_item:showLockIcon(true)
        end
    end
end

-- 移动英雄item
function BattleDramaDunGoFightPanel:onClickHeroItemMove( sender, hero_vo )
    if not self.move_hero_item then
        self.move_hero_item = HeroExhibitionItem.new(0.7, false)
        self.main_container:addChild(self.move_hero_item)
    end
    if not self.move_hero_vo and hero_vo then
        self.move_hero_vo = hero_vo
        sender:setData()
        self.move_hero_item:setData(hero_vo)
        self.move_hero_item:setChosenImg(0)
    end
    local touch_pos = sender:getTouchMovePosition()
    local target_pos = self.main_container:convertToNodeSpace(touch_pos)
    self.move_hero_item:setPosition(target_pos)
end

function BattleDramaDunGoFightPanel:onClickHeroItemCanceled( sender )
    if self.move_hero_item and self.move_hero_vo then
        local touch_pos = sender:getTouchMovePosition()
        local target_pos = self.main_container:convertToNodeSpace(touch_pos) 
        local is_have = false
        for index,rect in ipairs(self.item_rect_list) do
            if cc.rectContainsPoint( rect, target_pos ) then
                local hero_item = self.hero_item_list_left[index]
                if hero_item and not self:checkIsHaveSameHeroInOneTeam(self.move_hero_vo) then
                    is_have = true
                    self.is_show_act = true
                    local world_pos = hero_item:convertToWorldSpace(cc.p(0, 0))
                    local item_pos = self.main_container:convertToNodeSpace(world_pos) 
                    local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(item_pos.x+41.5, item_pos.y+41.5))
                    local call_back = function (  )
                        self.move_hero_item:setData()
                        self.move_hero_item:setPosition(cc.p(-1000, -1000))
                        local hero_vo = hero_item:getData()
                        sender:setData(hero_vo)
                        sender:setChosenImg(0)
                        hero_item:setData(self.move_hero_vo)
                        hero_item:setChosenImg(0)
                        if self.pointData then
                           model:changeHeroPOS(self.pointData.sub_id, hero_vo,self.move_hero_vo,index)
                        end
                        self.move_hero_vo = nil
                        self:updateAllTeamInfo()
                        self.is_show_act = false
                    end
                    self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                end
                break
            end
        end
        if not is_have then
            self:onClickHeroItemEnd(sender)
        end
    end
end

function BattleDramaDunGoFightPanel:onClickHeroItemEnd( sender )
    if self.move_hero_item then
        self.is_show_act = true
        local world_pos = sender:convertToWorldSpace(cc.p(0, 0))
        local target_pos = self.main_container:convertToNodeSpace(world_pos) 
        local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+41.5, target_pos.y+41.5))
        local call_back = function (  )
            self.move_hero_item:setData()
            self.move_hero_item:setPosition(cc.p(-1000, -1000))
            if self.move_hero_vo then
                sender:setData(self.move_hero_vo)
                sender:setChosenImg(0)
                self.move_hero_vo = nil
            end
            self.is_show_act = false
        end
        self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
    end
end

function BattleDramaDunGoFightPanel:__delete(  )
    local data = model:GetTeamData()
    BattleDramaController:getInstance():sender13236(data)
    if self.sp_data and self.sp_data.formations then
        _hero_controller:sender11216(self.fun_form_type,self.sp_data.formations)
    end
    -- controller:sender13235(self.pointData.chapter_id,self.pointData.dun_id,self.pointData.sub_id)
    if self.hero_item_list_left then
        for _,item in pairs(self.hero_item_list_left) do
            item:setData()
            item:DeleteMe()
            item = nil
        end
        self.hero_item_list_left = {}
    end
    if self.fight_label then
        self.fight_label:DeleteMe()
    end
    self.fight_label = nil
    if self.hallow_item then
        self.hallow_item:DeleteMe()
        self.hallow_item = nil
    end
    if self.dunlist then
        for _,item in pairs(self.dunlist) do
            item:DeleteMe()
            item = nil
        end
        self.dunlist = {}
    end
    if self.halo_load then
        self.halo_load:DeleteMe()
        self.halo_load = nil
    end
    if self.move_hero_item then
        self.move_hero_item:DeleteMe()
        self.move_hero_item = nil
    end
end