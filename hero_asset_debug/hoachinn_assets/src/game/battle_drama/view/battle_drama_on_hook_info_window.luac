BattleDramaOnHookInfoWindow = BattleDramaOnHookInfoWindow or BaseClass(BaseView)

local _drama_model = BattleDramaController:getInstance():getModel()
local _controller = BattleDramaController:getInstance() 
local _string_format = string.format
local _table_insert = table.insert
function BattleDramaOnHookInfoWindow:__init()
    self.is_full_screen = false
    self.layout_name = "battledrama/battle_drama_on_hook_info_window"
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.res_list = {
        --{path = PathTool.getPlistImgForDownLoad("bigbg/action","txt_cn_online_gift"), type = ResourcesType.single},
    }
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.item_list = {}
end

function BattleDramaOnHookInfoWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.desc_bg = self.main_container:getChildByName("Image_1")
    self.title_txt = self.main_container:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_c_2998"))
    self.goods_con = self.main_container:getChildByName("goods_1")
    self.goods_con:setScrollBarEnabled(false)
end

function BattleDramaOnHookInfoWindow:register_event()
    registerButtonEventListener(self.background, function()
        _controller:openAdditionDetailWindow(false)
    end,false, 2)

    if not self.update_event then --
        self.update_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Update_On_Hook_Info_Event, function()
            self:setData()
        end)
    end
end

function BattleDramaOnHookInfoWindow:openRootWnd()
    _controller:sender13035()
end

function BattleDramaOnHookInfoWindow:setData()
    local data = _drama_model:getAddtionInfo()
    local info = data.infos
    local list = self:dataHandle(info)    
    -- print(vardump(list))
    local list_num = #list
    local _height = 45 * list_num + 100
    self.main_container:setContentSize(cc.size(600, _height))
    self.main_container:setPosition(360, 640+_height/2)
    self.desc_bg:setContentSize(cc.size(600, _height))
    self.desc_bg:setPositionY( _height)
    self.title_txt:setPositionY( _height - 35)
    self.goods_con:setContentSize(cc.size(560, 45 * list_num))
    self.goods_con:setPositionY( _height - 60)
    self.goods_con:setInnerContainerSize(cc.size(560, 45 * list_num))
    for k, v in pairs(list) do
        if not self.item_list[v.bid] then
            local item = createCSBNote(PathTool.getTargetCSB("battledrama/battle_drama_on_hook_info_item"))
            item:setPosition(0, 45 * list_num - k*45)
            self.goods_con:addChild(item)
            local root = item:getChildByName("root")
            local name_label = root:getChildByName("name_label")
            setTextSpacing(name_label,-10)
            local add_num = root:getChildByName("add_num")
            local jump_btn = root:getChildByName("jump_btn")
            item.name_label = name_label
            item.add_num = add_num
            item.jump_btn = jump_btn
            self.item_list[v.bid] = item
            self:setItemData(self.item_list[v.bid],v)
        else
            self:setItemData(self.item_list[v.bid],v)
        end
    end
end

function BattleDramaOnHookInfoWindow:dataHandle(data)
    local my_level = self.role_vo.lev
    local list = {}
    for k, v in pairs(data) do
        local data_info = v
        if data_info.bid == 1 or data_info.bid == 2 then
            if my_level >= Config.NinjaTreasureData.data_constant["open_lev"].val then
                _table_insert(list,v)
            end
        elseif data_info.bid == 3 or data_info.bid == 4 or data_info.bid == 5 or data_info.bid == 6 then
            if my_level >= Config.DungeonNinjaWarData.data_drama_const["opening_level"].val then
                _table_insert(list,v)
            end
        elseif data_info.bid == 7 or data_info.bid == 8 or data_info.bid == 9 then
            if my_level >= 20 then --策划需求 写死等级
                _table_insert(list,v)
            end
        end
    end
    return list
end

function BattleDramaOnHookInfoWindow:setItemData(item,data)
    local desc = ""
    local add_num = TI18N("语言_c_1586") 
    if data.bid == 1 then
        desc = TI18N("语言_c_6235") --"忍界编年史 银币加成"
    elseif data.bid == 2 then
        desc = TI18N("语言_c_6236") --"忍界编年史 忍者经验加成"
    elseif data.bid == 3 then
        desc = TI18N("语言_c_6237") --"忍界大战 银币加成"
    elseif data.bid == 4 then
        desc = TI18N("语言_c_6238") --"忍界大战 忍者经验加成"
    elseif data.bid == 5 then
        desc = TI18N("语言_c_6239") --"忍界大战 首领经验加成"
    elseif data.bid == 6 then
        desc = TI18N("语言_c_6240") --"忍界大战 任务情报加成"
    elseif data.bid == 7 then
        desc = TI18N("语言_c_6430") --"VIP忍者经验加成"
    elseif data.bid == 8 then
        desc = TI18N("语言_c_6431") --"VIP首领经验加成"
    elseif data.bid == 9 then
        desc = TI18N("语言_c_6432") --"VIP银币加成"
    end
    if data.num ~= 0 then
        add_num = _string_format("+%s/m", data.num)
    end
    item.name_label:setString(transformTextToShort(desc,40))
    addEvt2showAllTextTips(item.name_label,desc,40)
    item.add_num:setString(add_num)
    item.jump_btn:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
           self:jumpToTargetFun(data.bid)
           BattleDramaController:getInstance():openAdditionDetailWindow(false)
        end
    end)
end
--跳转其他功能页面
function BattleDramaOnHookInfoWindow:jumpToTargetFun(id)
    if id == 1 or id == 2 then -- 忍界编年史
        --判断功能是否开启
        local config = Config.CityData.data_base[19].activate
        local role_vo = RoleController:getInstance():getRoleVo()
        if role_vo.lev >= config[1][2] then
            TreasureController:getInstance():openTreasureMainWindow(true)
        else
            message(TI18N("语言_s_1035"))
        end
    elseif id == 3 or id == 4 or id == 5 or id == 6 then --忍界大战
        BattleDramaController:getInstance():send13200()
    elseif id == 7 or id == 8 or id == 9 then --忍界大战
        local tab_type = VIPTABCONST.VIP
        VipController:getInstance():openVipMainWindow(true, tab_type)
    end
end

function BattleDramaOnHookInfoWindow:close_callback()
    if self.update_event then
        GlobalEvent:getInstance():UnBind(self.update_event)
        self.update_event = nil
    end
    _controller:openAdditionDetailWindow(false)
end
