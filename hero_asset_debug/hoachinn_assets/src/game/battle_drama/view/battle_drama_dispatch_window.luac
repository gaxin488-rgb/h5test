BattleDramaDispatchWindow = BattleDramaDispatchWindow or BaseClass(BaseView)

local _drama_model = BattleDramaController:getInstance():getModel()
local _controller = BattleDramaController:getInstance() 
local treasure_controller = TreasureController:getInstance()
local treasure_model = treasure_controller:getModel()
function BattleDramaDispatchWindow:__init()
    self.is_full_screen = false
    self.layout_name = "battledrama/battle_drama_dispatch_window"
    self.win_type = WinType.Big   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("sprite_detach","sprite_detach"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("sprite_detach","sprite_detach_15"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("sprite_detach","sprite_detach_16"), type = ResourcesType.single},
    }
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.treasure_list = {}
    self.elfin_list = {}
    self.top_elfin_list = {}
    self.is_play_spine = false
end

function BattleDramaDispatchWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_img = self.main_container:getChildByName("title_img")
    self.title_txt = self.main_container:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_spr_det_1_3"))
    moveTextBg(self.title_txt,self.title_img,60,287)
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.top_panel_size = self.top_panel:getContentSize()
    self.bg_spine = self.top_panel:getChildByName("bg_spine")
    self.time_bg = self.top_panel:getChildByName("time_bg")
    self.time_title = self.top_panel:getChildByName("time_title")
    self.time_title:setString(TI18N("语言_c_13"))
    self.time_str = self.top_panel:getChildByName("time_str")
    self.time_str:setPositionX(self.time_title:getPositionX() + self.time_title:getContentSize().width)
    self.rule_btn = self.top_panel:getChildByName("rule_btn")
    self.have_bg = self.top_panel:getChildByName("have_bg")
    self.have_num = self.top_panel:getChildByName("have_num")
    self.have_icon = self.top_panel:getChildByName("have_icon")
    self.countdown_txt = self.top_panel:getChildByName("countdown_txt")
    self.countdown_txt:setString(TI18N(""))
    self.countdown_tip = self.top_panel:getChildByName("countdown_tip")
    self.countdown_tip:setString(TI18N(""))
    self.holid_up = self.top_panel:getChildByName("holid_up")
    self.holid_up_txt = self.holid_up:getChildByName("Text_1")    
    self.holid_up_txt:setChangeScaleOffWidth(-9999)
    self.holid_up_txt:setString(TI18N("语言_c_6999"))
    local _w = math.max(self.holid_up:getContentSize().width,self.holid_up_txt:getContentSize().width+40)
    self.holid_up:setContentSize(cc.size(_w, self.holid_up:getContentSize().height))
    self.holid_up_txt:setPositionX(_w*0.5)
    self.holid_up:setVisible(false)
    self.elfin_scroll = self.top_panel:getChildByName("elfin_scroll")
    self.elfin_scroll:setScrollBarEnabled(false)
    self.treasure_scroll = self.top_panel:getChildByName("treasure_scroll")
    self.treasure_scroll:setScrollBarEnabled(false)
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.get_txt = createRichLabel(24,cc.c3b(0x7c,0x55,0x36),cc.p(0.5,0.5),cc.p(333,174),nil,nil,1000)
    self.bottom_panel:addChild(self.get_txt)
    self.all_txt = createRichLabel(22,cc.c3b(0x7c,0x55,0x36),cc.p(0.5,0),cc.p(333,13),-10,nil,360)
    self.bottom_panel:addChild(self.all_txt)
    self.receive_btn = self.bottom_panel:getChildByName("receive_btn")
    self.receive_txt = self.receive_btn:getChildByName("receive_txt")
    self.receive_txt:setString(TI18N("语言_c_8"))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.btn_shop = self.main_container:getChildByName("btn_shop")
    self.btn_shop:setVisible(false)
    self.btn_txt = self.btn_shop:getChildByName("label")
    setTextSpacing(self.btn_txt,-10)
    self.btn_txt:setString(TI18N("语言_c_2594"))
    self.btn_order = self.main_container:getChildByName("btn_order")
    self.order_img = self.btn_order:getChildByName("order_img")
    self.order_txt = self.btn_order:getChildByName("label")
    self.order_txt:setString(TI18N("语言_spr_det_1_21"))
    setTextMaxWidth(self.order_txt,130,-10)
    self.btn_into = self.main_container:getChildByName("btn_into")
    self.into_txt = self.btn_into:getChildByName("label")
    setTextSpacing(self.into_txt,-10)
    self.into_txt:setChangeScaleOffWidth(-25)
    self.into_txt:setString(TI18N("语言_spr_det_1_20"))
    self.into_tip = self.btn_into:getChildByName("into_tip")
    self.into_tip:setPositionY(self.into_txt:getPositionY()-self.into_txt:getContentSize().height*0.5 - 10)
    self.into_tip:setString("")
end

function BattleDramaDispatchWindow:register_event()
    registerButtonEventListener(self.background, function()
        _controller:openBattleDramaDispatchWindow(false)
    end,false, 2)
    registerButtonEventListener(self.close_btn, function()
        _controller:openBattleDramaDispatchWindow(false)
    end,true, 2)
    registerButtonEventListener(self.receive_btn, function()
        if self.data then
            if not next(self.data.annals_list) and not next(self.data.sprite_list) then
                message(TI18N("语言_spr_det_1_17"))
                return
            end
        end
        _controller:sender30504()
    end,true, 2)
    registerButtonEventListener(self.rule_btn, function(param,sender, event_type)
        if self.data and self.data.camp_id then
            local reward_desc_cfg = Config.SpriteDetachData.data_const[self.data.camp_id].sprite_detach_rule
            if reward_desc_cfg then
                TipsManager:getInstance():showCommonTips(reward_desc_cfg.val, sender:getTouchBeganPosition(),nil,nil,400)
            end
        end
    end ,true, 1)
    registerButtonEventListener(self.btn_shop, function()
        self:onComfirmBtn() 
    end, true)
    registerButtonEventListener(self.btn_order, function()
        _controller:openBattleDramaDispatchOrderWindow(true)
    end, true)
    registerButtonEventListener(self.holid_up, function()
        _controller:openBattleDramaDispatchOrderWindow(true)
    end, true)
    registerButtonEventListener(self.btn_into, function()
        if self.act_is_close then
            message(TI18N("语言_c_1472"))
            return
        end
        _controller:openBattleDramaDispatchAllWindow(true,2)        
    end, true)
    if not self.update_elfin_dispatch_event then --
        self.update_elfin_dispatch_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Update_Elfin_Dispatch_Event, function()
            self:setData()
        end)
    end

    if self.role_assets_event == nil then
        self.role_assets_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ACTION_ASSETS, function(key, value)
            if self.const_cfg then
                local item_id = self.const_cfg.sprite_detach_reward.val
                if key == item_id then
                    self.have_num:setString(self.role_vo:getActionAssetsNumByBid(item_id))
                end
            end
        end)
    end
    if not self.update_elfin_dispatch_order_event then
        self.update_elfin_dispatch_order_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Update_Elfin_Dispatch_Order_Event, function ()
            self:updateOrderRed()
        end)
    end
    if not self.update_elfin_dispatch_red_event then
        self.update_elfin_dispatch_red_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.Update_Elfin_Dispatch_Red_Event, function ()
            self:updateFormRed()
        end)
    end
end
--前往兑换
function BattleDramaDispatchWindow:onComfirmBtn()
    local act_ctrl = ActionController:getInstance()
    if act_ctrl:getActionSubTabVo(ActionRankCommonType.dispatch1) then
        MallController:getInstance():openMallActionWindow(true, ActionRankCommonType.dispatch1)
    elseif act_ctrl:getActionSubTabVo(ActionRankCommonType.dispatch2) then
        MallController:getInstance():openMallActionWindow(true, ActionRankCommonType.dispatch2)
    elseif act_ctrl:getActionSubTabVo(ActionRankCommonType.dispatch3) then
        MallController:getInstance():openMallActionWindow(true, ActionRankCommonType.dispatch3)
    end
end
function BattleDramaDispatchWindow:openRootWnd()
    if _drama_model:getfirstDispatchOpen() then
        MonopolyController:getInstance():sender16811(ActionStorageBool2.DispatchFirst)
    end
    _controller:sender30500()
    -- self:setData()
    if _drama_model:getDispatchFirst() then
        MonopolyController:getInstance():sender16811(ActionStorageBool2.ElfinDispatch)
    end
    self:runBgTimer()
    if not self.top_spine then
        self.top_spine = createEffectSpine("E31400_1",cc.p(315,190),cc.p(0.5,0.5),true,PlayerAction.action,nil,nil,true)
        self.top_panel:addChild(self.top_spine)
    end
end

function BattleDramaDispatchWindow:runBgTimer()
    doStopAllActions(self.bg_spine)
    if not self.run_img then
        local res = PathTool.getPlistImgForDownLoad("sprite_detach", "sprite_detach_bg", false)
        self.run_img = {}
        self.run_img[1] = createSprite(res, 0, 0, self.bg_spine, cc.p(0, 0), LOADTEXT_TYPE)
        self.run_img_size = self.run_img[1]:getContentSize() 
        local max_count = math.ceil(self.top_panel_size.width / self.run_img_size.width) + 1
        for i=2, (max_count + 1) do
            local x = (i - 1) * self.run_img_size.width 
            self.run_img[i] = createSprite(res, x, 0, self.bg_spine, cc.p(0, 0), LOADTEXT_TYPE)
        end
    end
    local max_count = math.ceil(self.top_panel_size.width / self.run_img_size.width) + 1
    local total_width = max_count* self.run_img_size.width
    local move_x = total_width - self.run_img_size.width
    local time_num = 4
    local num = (move_x+self.bg_spine:getPositionX())/(move_x/time_num)
    local move_to = cc.MoveTo:create(num, cc.p(-move_x, 0))
    local callfunc = cc.CallFunc:create(function() self.bg_spine:setPosition(0, 0)
        doStopAllActions(self.bg_spine)
        local move_to = cc.MoveTo:create(time_num, cc.p(-move_x, 0))
        local callfunc = cc.CallFunc:create(function() self.bg_spine:setPosition(0, 0) end)
        self.bg_spine:runAction(cc.RepeatForever:create(cc.Sequence:create(move_to, callfunc)))
    end)
    self.bg_spine:runAction(cc.Sequence:create(move_to, callfunc))
end
function BattleDramaDispatchWindow:setData()
    self.data = _drama_model:getDispatchData()
    if next(self.data.sprite_list) then
        self:runBgTimer()
        if self.top_spine then
            self.top_spine:setVisible(false)
            self.top_spine:clearTracks()
        end
    else
        doStopAllActions(self.bg_spine)
        if self.top_spine then
            self.top_spine:setAnimation(0,PlayerAction.action,true)
            self.top_spine:setVisible(true)
        end
    end
    if not self.data or not next(self.data) then return end
    self.act_is_close = self.data.end_time - GameNet:getInstance():getTime() <= 0
    if self.data.end_time and self.data.end_time ~= 0 then
        commonCountDownTime(self.time_str,self.data.end_time - GameNet:getInstance():getTime(),{end_callback=function()
            self.time_str:setString(TI18N("语言_c_233"))
            self:updateFormRed()
            -- self:updateTreasurePanel()
            -- self.holid_up:setVisible(false)
        end})
    end
    setChildUnEnabled(self.act_is_close,self.receive_btn)
    self.receive_btn:setTouchEnabled(not self.act_is_close)
    self.const_cfg = Config.SpriteDetachData.data_const[self.data.camp_id]
    if not self.const_cfg then return end
    if self.const_cfg.sprite_detach_monoploytime and _drama_model:getDispatchRmbStatus() == 0 and self.data.end_time > GameNet:getInstance():getTime() then
        self.holid_up:setVisible(true)
    else
        self.holid_up:setVisible(false)
    end
    local item_id = self.const_cfg.sprite_detach_reward.val
    -- self.have_num:setString(BackpackController:getInstance():getModel():getItemNumByBid(item_id))
    self.have_num:setString(self.role_vo:getActionAssetsNumByBid(item_id)) 
    local back_cfg = Config.ItemData.data_get_data(item_id)
    loadSpriteTexture(self.have_icon,PathTool.getItemRes(back_cfg.icon),LOADTEXT_TYPE)
    if _drama_model:getDispatchRmbStatus() == 1 and self.const_cfg.sprite_detach_monoploytime then
        self.countdown_tip:setString("/"..self.const_cfg.sprite_detach_monoploytime.val..":00:00")
    else
        self.countdown_tip:setString("/0"..self.const_cfg.sprite_detach_maxtime.val..":00:00")
    end
    self.countdown_txt:setPositionX(self.countdown_tip:getPositionX() - self.countdown_tip:getContentSize().width)
    if self.data.detach_start_time and self.data.detach_start_time ~= 0 and not self.act_is_close then
        local max_num = self.const_cfg.sprite_detach_maxtime.val*3600
        if _drama_model:getDispatchRmbStatus() == 1 and self.const_cfg.sprite_detach_monoploytime then
            max_num = self.const_cfg.sprite_detach_monoploytime.val*3600
        end
        local num = GameNet:getInstance():getTime() - self.data.detach_start_time
        if num < max_num then
            num = num + 1
        else
            num = max_num
        end
        self.countdown_txt:setString(TimeTool.GetTimeFormat(num))
        doStopAllActions(self.countdown_txt)
        self.countdown_txt:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1), cc.CallFunc:create(function()
            if num < max_num then
                num = num + 1
            else
                doStopAllActions(self.countdown_txt)
                num = max_num
            end
            self.countdown_txt:setString(TimeTool.GetTimeFormat(num))
        end))))
        local get_num = 0
        if self.data.acc_hook_items and next(self.data.acc_hook_items) and self.data.acc_hook_items[1] and self.data.acc_hook_items[1].item_count then
            get_num = math.floor(self.data.acc_hook_items[1].item_count)
        end
        self.get_txt:setString(TI18N("语言_spr_det_1_4").."  "..string.format("<img src=%s visible=true scale=0.4 />%s",PathTool.getItemRes(item_id),get_num))
    else
        doStopAllActions(self.countdown_txt)
        self.countdown_txt:setString("00:00:00")
        self.get_txt:setString(TI18N("语言_spr_det_1_4").."  "..string.format("<img src=%s visible=true scale=0.3 />%s",PathTool.getItemRes(item_id),0))
    end
    local treasure_add_num = 0
    local treasure_num = 0
    self.annals_data = Config.SpriteDetachData.data_annals_info[self.data.camp_id]
    self.elfin_data = Config.SpriteDetachData.data_sprite_info[self.data.camp_id]
    for k,v in pairs(self.data.annals_list or {}) do
        local treasure_list = treasure_model:getTreasureForId(v.annals_id)
        if treasure_list then
            local cfg = self.annals_data[treasure_list.item_bid]
            treasure_add_num = (treasure_add_num + (cfg.base_award_ratio + (treasure_list.star-1) * cfg.grow_award_ratio)*0.1)
    
            treasure_num = treasure_num + cfg.base_award + (treasure_list.star-1) * cfg.grow_award
        end
    end
    local elfin_num = 0
    for k,v in pairs(self.data.sprite_list or {}) do
        elfin_num = elfin_num + self.elfin_data[v.sprite_id].award
    end
    local all_add_num = (elfin_num+treasure_num)*(treasure_add_num*0.01)
    all_add_num = elfin_num+treasure_num + math.floor(all_add_num*10)*0.1
    local txt = ""
    if self.const_cfg.sprite_detach_time.val == 1 then
        txt = TI18N("语言_spr_det_1_6")
        self.all_txt:setString(string.format(txt,PathTool.getItemRes(item_id),all_add_num)..TI18N("语言_c_2419"))
    else
        txt = TI18N("语言_spr_det_1_7")
        self.all_txt:setString(string.format(txt,PathTool.getItemRes(item_id),all_add_num,self.const_cfg.sprite_detach_time.val)..TI18N("语言_c_2419"))
    end
    self.all_txt:addTouchLinkListener(function(type, value, sender, pos)
    	TipsManager:getInstance():showCommonTips(string.format(TI18N("语言_spr_det_1_5"),treasure_add_num), pos,nil,nil,400)
    end, { "click", "href" })
    self:updateTreasurePanel()
    self:updateElfinPanel()
    addRedPointToNodeByStatus(self.receive_btn,_drama_model:getDispatchMaxRed(),10,10)
    self:updateFormRed()
    -- self.order_img
    local back_cfg = Config.ItemData.data_get_data(item_id)
    local mask_res = PathTool.getResFrame("sprite_detach", "sprite_detach_25")
    local vSize = cc.size(55,55)
    if not self.mask then
        self.mask = createSprite(mask_res, vSize.width/2, vSize.height/2, nil, cc.p(0.5, 0.5))--模板
    end
    if not self.clipNode then
        self.clipNode = cc.ClippingNode:create(self.mask)
        self.clipNode:setAnchorPoint(cc.p(0.5,0.5))
        self.clipNode:setContentSize(vSize)
        self.clipNode:setCascadeOpacityEnabled(true)
        self.clipNode:setPosition(0,0)
        self.clipNode:setAlphaThreshold(0)
        self.order_img:addChild(self.clipNode,2)

        self.icon = BackPackItem.new(false,false)
        self.icon:setScale(0.5)
        self.icon:setData(back_cfg)
        self.icon:setCascadeOpacityEnabled(true)
        self.icon:setAnchorPoint(0.5,0.5)
        self.icon:setPosition(vSize.width/2,vSize.height/2+2)--底板
        self.clipNode:addChild(self.icon,3)
    end
    self.btn_shop:setVisible(self.const_cfg.shop_open.val == 2)
end
--魔导器列表
function BattleDramaDispatchWindow:updateTreasurePanel()
    if self.treasure_list and next(self.treasure_list) then
        for k,v in pairs(self.treasure_list) do
            if v and v.removeFromParent then
                v:removeFromParent()
                v=nil
            end
        end
    end
    self.treasure_list = {}
    if self.data.end_time <= GameNet:getInstance():getTime() then
        return
    end
    local max_num = self.const_cfg.sprite_detach_slot2.val
    local list = deepCopy(self.data.annals_list or {})
    if tableLen(list) > 1 then
        table.sort(list, function(a,b) return a.pos < b.pos end)
    end
    for i=1,max_num do
        local treasure_id = 0
        if list[i] then
            treasure_id = list[i].annals_id
        end
        local item = DispatchTreasureItem.new()
        item:setData(treasure_id,self.act_is_close)
        local zorder = i%2 == 0 and 1 or 10
        self.treasure_scroll:addChild(item)
        item:setZOrder(zorder)
        item:setPositionX(93*(i-1)+82)
        item:setPositionY(i%2*63 + 57)
        self.treasure_list[i] = item
        if i > tableLen(list) + 1 then
            item:setVisible(false)
        else
            item:setVisible(true)
        end
    end
    local _w = math.max(93*(max_num-1)+82,self.treasure_scroll:getContentSize().width)
    self.treasure_scroll:setInnerContainerSize(cc.size(_w, self.treasure_scroll:getContentSize().height))
end
--通灵兽列表
function BattleDramaDispatchWindow:updateElfinPanel()
    local top_elfin_list = {}
    local bottom_elfin_list = {}
    local list = deepCopy(self.data.sprite_list or {})
    if tableLen(list) > 1 then
        table.sort(list, function(a,b) return a.pos < b.pos end)
    end
    for k,v in pairs(list or {}) do
        if v and next(v) then
            if tableLen(top_elfin_list) < 3 then
                table.insert(top_elfin_list,v)
            end
        end
        table.insert(bottom_elfin_list,v)
    end
    for k,v in pairs(self.top_elfin_list) do
        if v.bottom_img then
            v.bottom_img:removeFromParent()
            v.bottom_img = nil
        end
        if v then
            v:removeFromParent()
            v=nil
        end
    end
    self.top_elfin_list = {}
    for i=1,tableLen(top_elfin_list) do
        local elfin_id = 0
        if top_elfin_list[i] then
            elfin_id = top_elfin_list[i].sprite_id
        end
        local item = DispatchElfintem.new()
        item:setTouchEnabled(false)
        item:setData(elfin_id,self.act_is_close)
        item:setScale(1)
        self.top_panel:addChild(item)
        item.bottom_img = createSprite(PathTool.getResFrame("sprite_detach", "sprite_detach_27"),54,-10,self.top_panel,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
        if tableLen(top_elfin_list)%2 == 0 then
            item:setPositionX(275-(math.ceil(tableLen(top_elfin_list)/2-i))*108)
            item.bottom_img:setPositionX(275-(math.ceil(tableLen(top_elfin_list)/2-i))*108)
        else
            item:setPositionX(315-(math.ceil(tableLen(top_elfin_list)/2-i))*108)
            item.bottom_img:setPositionX(315-(math.ceil(tableLen(top_elfin_list)/2-i))*108)
        end
        item:setPositionY(236)
        item.bottom_img:setPositionY(196)
        self.top_elfin_list[i] = item
    end
    --图标上下浮动
    for i=tableLen(self.top_elfin_list), 1,-1 do
        delayOnce(function()
            doStopAllActions(self.top_elfin_list[i])
            local act_1 = cc.MoveBy:create(0.5, cc.p(0, 30))
            local act_2 = cc.MoveBy:create(0.5, cc.p(0, -30))
            if self.top_elfin_list[i] and self.top_elfin_list[i].runAction then
                self.top_elfin_list[i]:runAction(cc.RepeatForever:create(cc.Sequence:create(act_1, act_2)))
            end
        end,i%2 == 0 and 0.3 or 0)
    end
    
    for k,v in pairs(self.elfin_list) do
        if v then
            v:removeFromParent()
            v=nil
        end
    end
    self.elfin_list = {}
    local max_num = self.const_cfg.sprite_detach_slot.val
    for i=1,max_num do
        local elfin_id = 0
        if list[i] then
            elfin_id = list[i].sprite_id
        end
        local item = DispatchElfintem.new()
        item:setData(elfin_id,self.act_is_close)
        item:setScale(0.45)
        self.elfin_scroll:addChild(item)
        item:setPositionX(50*(i-1)+30)
        item:setPositionY(25)
        self.elfin_list[i] = item
        if i > tableLen(list) + 1 then
            item:setVisible(false)
        else
            item:setVisible(true)
        end
    end
    local _w = math.max(98*(max_num-1)+56,self.elfin_scroll:getContentSize().width)
    self.elfin_scroll:setInnerContainerSize(cc.size(_w, self.elfin_scroll:getContentSize().height))
    self.into_tip:setString(tableLen(self.data.sprite_list).."/"..max_num)
end
function BattleDramaDispatchWindow:updateOrderRed()
    addRedPointToNodeByStatus(self.btn_order,_drama_model:getDispatchOrderRed(),10,10)
end
function BattleDramaDispatchWindow:updateFormRed()
    if self.btn_into then
        addRedPointToNodeByStatus(self.btn_into,_drama_model:getDispatchFormRed(1),10,10)
    end
    if self.data then
        local list = deepCopy(self.data.annals_list or {})
        for k,v in ipairs(self.treasure_list) do
            if k == tableLen(list)+1 then
                addRedPointToNodeByStatus(v,_drama_model:getDispatchFormRed(2),10,10)
            else
                addRedPointToNodeByStatus(v,false)
            end
        end
    end
end
function BattleDramaDispatchWindow:close_callback()
    doStopAllActions(self.countdown_txt)
    if self.update_elfin_dispatch_event then
        GlobalEvent:getInstance():UnBind(self.update_elfin_dispatch_event)
        self.update_elfin_dispatch_event = nil
    end
    if self.role_assets_event then
        if self.role_vo then
            self.role_vo:UnBind(self.role_assets_event)
        end
        self.role_assets_event = nil
        self.role_vo = nil
    end
    if self.update_elfin_dispatch_order_event then
        GlobalEvent:getInstance():UnBind(self.update_elfin_dispatch_order_event)
        self.update_elfin_dispatch_order_event = nil
    end
    if self.update_elfin_dispatch_red_event then
        GlobalEvent:getInstance():UnBind(self.update_elfin_dispatch_red_event)
        self.update_elfin_dispatch_red_event = nil
    end
    for k,v in pairs(self.top_elfin_list) do
        if v.bottom_img then
            v.bottom_img:removeFromParent()
            v.bottom_img = nil
        end
        if v then
            doStopAllActions(v)
            v:removeFromParent()
            v=nil
        end
    end
    for k,v in pairs(self.treasure_list) do
        v:removeFromParent()
        v=nil
    end
    for k,v in pairs(self.elfin_list) do
        v:removeFromParent()
        v=nil
    end
    _controller:openBattleDramaDispatchWindow(false)
end



-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
--  (必填, 后续维护以及修改的人员)
-- @description:
--      魔导器单个
-- Create: 2020-02-10
-- --------------------------------------------------------------------
DispatchTreasureItem = class("DispatchTreasureItem", function()
    return ccui.Widget:create()
end)

function DispatchTreasureItem:ctor()
	self.ctrl = TaskController:getInstance()
	self.model = self.ctrl:getModel()

	self:configUI()
	self:register_event()
end

function DispatchTreasureItem:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("battledrama/dispatch_treasure_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self.size = cc.size(106,106)
    self:setContentSize(self.size)
    self:setAnchorPoint(0.5,0.5)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container:setTouchEnabled(true)
    self.main_container:setSwallowTouches(false)
    self.close_panel = self.main_container:getChildByName("close_panel")
    self.no_choose_panel = self.main_container:getChildByName("no_choose_panel")
    self.choose_panel = self.main_container:getChildByName("choose_panel")
    self.bg = self.choose_panel:getChildByName("bg")
    self.icon_node = self.bg:getChildByName("icon_node")
    self.star_con = self.choose_panel:getChildByName("star_con")
    self.star_con:setScale(0.8)
end

function DispatchTreasureItem:register_event(  )
    registerButtonEventListener(self.main_container, function()
        if self.is_close then
            message(TI18N("语言_c_1472"))
            return
        end
        _controller:openBattleDramaDispatchAllWindow(true,1)
    end,true, 2)
end
function DispatchTreasureItem:setData(id,is_close)
    self.id = id
    self.is_close = is_close
    if self.is_close then
        self.close_panel:setVisible(true)
        self.no_choose_panel:setVisible(false)
        self.choose_panel:setVisible(false)
    else
        self.close_panel:setVisible(false)
        -- self.no_choose_panel:setVisible(true)
        -- self.choose_panel:setVisible(true)
        if id == 0 then
            self.choose_panel:setVisible(false)
            self.no_choose_panel:setVisible(true)
        else
            self.choose_panel:setVisible(true)
            self.no_choose_panel:setVisible(false)
            local cfg = Config.NinjaTreasureData.data_base_info[id]
            loadSpriteTexture(self.bg,PathTool.getResFrame("sprite_detach", "treasure_detach_"..cfg.quality+1),LOADTEXT_TYPE_PLIST)
            if not self.mask then
                -- self.mask = createSprite(PathTool.getResFrame("sprite_detach", "sprite_detach_18"), self.size.width/2, self.size.height/2,nil, cc.p(0.5, 0.5),LOADTEXT_TYPE_PLIST)--模板
                self.mask = createSprite(PathTool.getResFrame("sprite_detach", "sprite_detach_18"), self.size.width/2, self.size.height/2,nil, cc.p(0.5, 0.5),LOADTEXT_TYPE_PLIST)--模板
                self.clipNode = cc.ClippingNode:create(self.mask)
                self.clipNode:setAnchorPoint(cc.p(0.5,0.5))
                self.clipNode:setContentSize(cc.size(106,106))
                self.clipNode:setCascadeOpacityEnabled(true)
                self.clipNode:setPosition(53,53)
                self.clipNode:setAlphaThreshold(0)
                self.icon_node:addChild(self.clipNode,2)
                
                self.icon = ccui.ImageView:create()
                self.icon:setCascadeOpacityEnabled(true)
                self.icon:setAnchorPoint(0.5,0.5)
                self.icon:setPosition(53,53)--底板
                self.clipNode:addChild(self.icon,3)
            end
            if self.icon then
                self.icon:loadTexture(string.format("resource/ninja_treasure/treasure_item/%s.png",id),LOADTEXT_TYPE)
            end
            local treasure_list = treasure_model:getTreasureForId(id)
            if treasure_list then
                self.star_setting = self:createStar(treasure_list.star,treasure_list.star,self.star_con,self.star_setting)
            end
        end
    end
end

function DispatchTreasureItem:createStar(num ,max_num, star_con, star_setting)
	local num = num or 0
    local star_setting = star_setting or {}
	if star_setting.star_list == nil then
        star_setting.star_list = {}
    end
	for i,v in pairs(star_setting.star_list) do
        v:setVisible(false)
    end
	local _cStar = function(star_count, max_count, star_list,moveW)
        local width = 15
        local x = - max_count * width * 0.5 + width * 0.5
        if moveW then 
            x = x + moveW
        end
        for i=1,max_count do
            if not star_list[i] then 
				local res = PathTool.getResFrame("common","common_90074")
                local star = createImage(star_con,res,0,0,cc.p(0.5,0.5),true,i,false)
                star:setScale(1)
                star_list[i] = star
            end
			if i > star_count then
				star_list[i]:loadTexture(PathTool.getResFrame("common","common_90093"), LOADTEXT_TYPE_PLIST)	
			else
				star_list[i]:loadTexture(PathTool.getResFrame("common","common_90074"), LOADTEXT_TYPE_PLIST)
			end
            star_list[i]:setVisible(true)
            star_list[i]:setPositionX(x + (i-1) * width)
        end
    end
	_cStar(num,max_num, star_setting.star_list)
	return star_setting
end

function DispatchTreasureItem:DeleteMe()
	
end



