BattlDramaDunInfoWindow = BattlDramaDunInfoWindow or BaseClass(BaseView)

local controller = BattleDramaController:getInstance()
local model = BattleDramaController:getInstance():getModel()
local table_insert = table.insert
function BattlDramaDunInfoWindow:__init(data)
    self.dungeon_data = data
    self.layout_name = "battledrama/battle_darma_dun_info_windows"
    self.res_list = {
            {path = PathTool.getPlistImgForDownLoad("War_tolerance", "War_tolerance"), type = ResourcesType.plist},
        }
    self.swap_status = 0 --0:不可挑战,1可挑战,2,扫荡
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.auto_id = 1

    self.list_step = 1
    self.loop_step = 1

    self.cache_pool = {}                    -- 弹幕缓存池
    self.cache_list = {}                    -- 弹幕缓存列表,当前存活的
    self.barrage_list = {}
    self.container_index = 1
    self.barrage_pool_list = {}

    self.list_interval = 2
    self.loop_interval = 3
    self.openchat=true
end
function BattlDramaDunInfoWindow:open_callback()
    self.panel_bg = self.root_wnd:getChildByName("Panel_bg")
    self.background = self.panel_bg:getChildByName("background")
    self.panel_bg:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("root")
    self:playEnterAnimatianByObj(self.main_container, 2)
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.ok_btn = self.main_container:getChildByName("ok_btn")
    self.ok_btn:getChildByName("label"):setString(TI18N("语言_c_937"))
    self.ok_btn:getChildByName("label"):enableOutline(Config.ColorData.data_color4[263], 2)
    self.window_title_label = self.main_container:getChildByName("window_title_label")
    self.window_title_label:setString(TI18N("语言_c_2511"))
    self.item_scrollview = self.main_container:getChildByName("item_scrollview")
    -- self.item_scrollview:setScrollBarEnabled(false)
    local Image_1 = self.main_container:getChildByName("Image_1")
    autoSizeTitleBg(self.window_title_label, Image_1)
    self.switch_btn = self.main_container:getChildByName("switch_btn")-- 滑块
    if self.list_view == nil then
        local scroll_view_size = self.item_scrollview:getContentSize()
        local setting = {
            item_class = BattlDramaDunHeadItem,      -- 单元类
            start_x = 4,                  -- 第一个单元的X起点
            space_x = 3,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 3,                   -- y方向的间隔
            item_width = 143,               -- 单元的尺寸width
            item_height = 152,              -- 单元的尺寸height
            row = 3,                        -- 行数，作用于水平滚动类型
            col = 4            
        }
        self.list_view = CommonScrollViewLayout.new(self.item_scrollview, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end

    local content_container = self.main_container:getChildByName("content_container")
    local size = cc.size(content_container:getContentSize().width-10, content_container:getContentSize().height-5)

    local top_title_bg=self.main_container:getChildByName("top_title_bg")
    local top_title_txt=top_title_bg:getChildByName("top_title_txt")
    top_title_txt :setString(TI18N("语言_c_5917"))
    top_title_bg:setContentSize(cc.size(top_title_txt:getContentSize().width+60,top_title_bg:getContentSize().height))
    local bot_title_bg=self.main_container:getChildByName("bot_title_bg")
    local bot_title_txt=bot_title_bg:getChildByName("bot_title_txt")
    bot_title_txt:setChangeScaleOffWidth(-9999)
    bot_title_txt:setString(TI18N("语言_c_5918"))
    bot_title_bg:setContentSize(cc.size(bot_title_txt:getContentSize().width+60, bot_title_bg:getContentSize().height))
    self.editbox = createEditBox(content_container, PathTool.getResFrame("common","common_99998"), size, Config.ColorData.data_color4[175], 20, Config.ColorData.data_color4[63], 20, TI18N("语言_c_1358"), nil, 40, LOADTEXT_TYPE_PLIST)
    self.editbox:setAnchorPoint(cc.p(0,1))
    self.editbox:setPosition(18,size.height)
    self.list_container = {}
    local container = nil
    for i=1,4 do
        container = self.main_container:getChildByName("list_container_"..i)
        if container ~= nil then
            self.list_container[i] = container
        end
    end

    self.topcontainer=self.main_container:getChildByName("topcontainer")
    self.name_label=self.topcontainer:getChildByName("name_label")
    self.rank_img=self.topcontainer:getChildByName("rank_img")
    self.video_btn=self.topcontainer:getChildByName("video_btn")
    self.empty_label=self.topcontainer:getChildByName("empty_label")
    self.empty_label:setString(TI18N("语言_c_526"))
    self.empty_label:setVisible(false)
end

function BattlDramaDunInfoWindow:setData(list)
    local cfg=Config.DungeonNinjaWarData.data_drama_const["chat_open"]
    if cfg.val and cfg.val==0 then
        self.openchat=false
        setChildUnEnabled(true,self.ok_btn)
    else
        self.openchat=true
        setChildUnEnabled(false,self.ok_btn)
    end
    if list and next(list)~=nil then
        self.list_view:setData(list)
    end
end

function BattlDramaDunInfoWindow:createPlayerHead(x,y)
	local play_head = PlayerHead.new(PlayerHead.type.circle)
	self.topcontainer:addChild(play_head)
	play_head:setPosition(cc.p(x,y))
	play_head:setAnchorPoint(cc.p(0,0.5))
	play_head:setTouchEnabled(false)
	play_head:setScale(0.8)
	return play_head
end

function BattlDramaDunInfoWindow:setCurData(data)
    if not data then return  end
    self.vedioData=data
    local info=data.harder_dungeon_replay_data[1]
    if not info then 
        self.empty_label:setVisible(true)
        self.name_label:setVisible(false)
        self.video_btn:setVisible(false)
    else
        self.empty_label:setVisible(false)
        self.name_label:setVisible(true)
        self.video_btn:setVisible(true)
        self.play_head = self:createPlayerHead(55,61)
        local face_id = info.face_id or info.face
        local avatar_bid = info.avatar_bid
        local vo = Config.AvatarData.data_avatar[avatar_bid]
            if vo then
                local res_id = vo.res_id or 1
                local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
                self.play_head:showBg(res, nil, false, vo.offy)
            end
        self.play_head:setHeadRes(face_id, false, LOADTEXT_TYPE, info.face_file, info.face_update_time)
        self.name_label:setString(info.name)
    end
end

--desc:设置计时器
--time:2017-09-08 04:31:18
--@status:
--@return 
--==============================--
function BattlDramaDunInfoWindow:setScheduleUpdate(status)
    if status == true then
        if self.queue_timer == nil then
            self.queue_timer = GlobalTimeTicket:getInstance():add(function()
                if self.barrage_list ~= nil and next(self.barrage_list) ~= nil then
                    if self.list_step >= self.list_interval then
                        local data = table.remove( self.barrage_list, 1 )
                        self:updateBarrage(data)
                        -- table_insert(self.barrage_pool_list, data)
                        self.list_step = 1
                    else
                        self.list_step = self.list_step + 1
                    end
                else
                    if self.cache_list == nil or next(self.cache_list) == nil then
                        if self.loop_step >= self.loop_interval then
                            self.barrage_list = deepCopy(self.barrage_pool_list)
                            self.barrage_pool_list = {}
                            self.loop_step = 1
                        else
                            self.loop_step = self.loop_step + 1
                        end
                    end
                end
            end, 1)
        end
    else
        if self.queue_timer ~= nil then
            GlobalTimeTicket:getInstance():remove(self.queue_timer)
            self.queue_timer = nil
        end
    end
end

--写弹幕
function BattlDramaDunInfoWindow:onClickWirteBtn()
    if isQingmingShield and isQingmingShield() then
        return
    end
    controller:openEditView(true, self.type)
end
--关闭弹幕
function BattlDramaDunInfoWindow:onClickInfoBtn( )
    local status=self.open_status and 0 or 1
    controller:send13242(status)
end

function BattlDramaDunInfoWindow:OnSiwtch()
    self.open_status = not self.open_status
    self:setScheduleUpdate(self.open_status)
    if not self.open_status == true then
        for k,v in pairs(self.cache_list) do
            if v.clearInfo then
                v:clearInfo()
            end
            table_insert( self.cache_pool, v )
            self.cache_list[v.id] = nil
        end
        self.cache_list = {}
    end
   self:SetSwitch(self.open_status)
end

