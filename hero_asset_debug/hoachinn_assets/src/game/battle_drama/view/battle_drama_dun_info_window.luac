function BattlDramaDunInfoWindow:SetSwitch(status)
    local res= PathTool.getResFrame("War_tolerance",status and "recommend_7" or "recommend_2") 
    self.switch_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
end

function BattlDramaDunInfoWindow:BeginBarrage(data)
    self.barrage_list = deepCopy(data.bullets)
    self.open_status=data.switch==1
    self:SetSwitch(self.open_status)
    self:setScheduleUpdate(self.open_status)
end
--==============================--
--desc:创建并开始移动弹幕 
--==============================--
function BattlDramaDunInfoWindow:updateBarrage(data)
    if data == nil or data.msg == "" then
        return 
    end

    local function finish_action_callback(list)
        if list ~= nil and list.clearInfo then
            list:clearInfo()
        end
        table_insert(self.cache_pool, list )
        self.cache_list[list.id] = nil
    end

    local item = nil
    if self.cache_pool == nil or next(self.cache_pool) == nil then
        item = BarrageItemList.new(self.auto_id)
        self.cache_list[self.auto_id] = item
        self.auto_id = self.auto_id + 1
    else
        item = table.remove( self.cache_pool, 1 )
        self.cache_list[item.id] = item
    end
    self.list_container[self.container_index]:addChild(item)
    if item ~= nil then
        item:setPosition(display.width+10, 15)
        item:actionFinishCallBack(finish_action_callback)
        item:update(data)
    end
    self.container_index = self.container_index + 1
    if self.container_index > 4 then
        self.container_index = 1
    end
end

function BattlDramaDunInfoWindow:register_event()
    if self.background then
        self.background:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                controller:openDramaDunInfoView(false) 
            end
        end)
    end
    if self.close_btn then
        self.close_btn:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                controller:openDramaDunInfoView(false) 
            end
        end)
    end
    self.video_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:PlayFirstVedio()
        end
    end)
    if self.ok_btn then
        self.ok_btn:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                if not self.openchat then
                    message(TI18N("语言_c_5842"))
                    return
                end
                playButtonSound2()
                local str = self.editbox:getText()
                if str == "" then
                else
                    controller:send13243(self.dun_id, str)
                end
            end
        end)
    end
    registerButtonEventListener(self.switch_btn, handler(self, self.onClickInfoBtn), true)
    if not self.update_dram_data_event then
        self.update_dram_data_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.UpdateDunPlayers, function(data)
            self:setData(data)
        end)
    end
    if not self.update_danmu_data_event then
        self.update_danmu_data_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.UpdateDunDanMu, function(data)
            self:BeginBarrage(data)
        end)
    end
    if not self.update_danmu_vedio_event then
        self.update_danmu_vedio_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.UpdateDunVedio, function(data)
            self:setCurData(data)
        end)
    end
    if not self.update_send_danmu_event then
        self.update_send_danmu_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.SendDunDanMu, function(data)
            self.editbox:setText("")
            controller:send13241(self.dun_id,30)
        end)
    end
    if not self.update_switch_danmu_event then
        self.update_switch_danmu_event = GlobalEvent:getInstance():Bind(Battle_dramaEvent.SwitchDunDanMu, function(data)
           self:OnSiwtch()
        end)
    end
    
end

function BattlDramaDunInfoWindow:openRootWnd(dun_id)
    self.dun_id=dun_id
    controller:send13240(dun_id)
    controller:send13241(dun_id,30)
    controller:send13215(dun_id,3)
end

function BattlDramaDunInfoWindow:PlayFirstVedio()
    if self.vedioData then
        controller:openDunVedioWindows(true, self.vedioData.harder_dungeon_replay_data[1])
    end
end

function BattlDramaDunInfoWindow:close_callback()
    if self.update_danmu_data_event then
        GlobalEvent:getInstance():UnBind(self.update_danmu_data_event)
        self.update_danmu_data_event = nil
    end
    if self.update_danmu_vedio_event then
        GlobalEvent:getInstance():UnBind(self.update_danmu_vedio_event)
        self.update_danmu_vedio_event = nil
    end
    if self.update_send_danmu_event then
        GlobalEvent:getInstance():UnBind(self.update_send_danmu_event)
        self.update_send_danmu_event = nil
    end
    if self.update_switch_danmu_event then
        GlobalEvent:getInstance():UnBind(self.update_switch_danmu_event)
        self.update_switch_danmu_event = nil
    end
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    for k,v in pairs(self.cache_pool) do
        if v.DeleteMe then
            v:DeleteMe()
        end
    end
    self.cache_pool = {}
    if self.queue_timer ~= nil then
        GlobalTimeTicket:getInstance():remove(self.queue_timer)
        self.queue_timer = nil
    end
    for k,v in pairs(self.cache_list) do
        if v.DeleteMe then
            v:DeleteMe()
        end
    end
    self.cache_list = {}
    controller:openDramaDunInfoView(false)
end

BattlDramaDunHeadItem = class("BattlDramaDunHeadItem",function()
    return ccui.Layout:create()
end)

function BattlDramaDunHeadItem:ctor()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("battledrama/battle_drama_dun_head_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self.container=self.root_wnd:getChildByName("container")
    self.guild_img = self.container:getChildByName("guild_img")
    self.role_name = self.container:getChildByName("role_name")
    self.role_lv = self.container:getChildByName("role_lv")
    self.sex_img = self.container:getChildByName("sex_img")

    self:registerEvent()
end

function BattlDramaDunHeadItem:registerEvent()
    
end

function BattlDramaDunHeadItem:setData(data)
    self.data=data
    self.role_name:setString(data.name)
    local guildres
    if data.from ==1 then
        guildres=PathTool.getResFrame("War_tolerance","War_tolerance4")
    else
        guildres=PathTool.getResFrame("War_tolerance","War_tolerance5")
    end
    loadSpriteTexture(self.guild_img, guildres, LOADTEXT_TYPE_PLIST)
    local sexRes
    if data.sex ==0 then
        sexRes=PathTool.getResFrame("War_tolerance","War_tolerance8")
    else
        sexRes=PathTool.getResFrame("War_tolerance","War_tolerance7")
    end
    loadSpriteTexture(self.sex_img, sexRes, LOADTEXT_TYPE_PLIST)

    self.play_head = self:createRoleHead(self.size.width/2,100)
    self.play_head:setLev(data.lev)
    self.play_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    local avatar_bid =data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    --背景框
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.play_head:showBg(res, nil, false, vo.offy)
    end
end

function BattlDramaDunHeadItem:createRoleHead(x,y)
    local play_head = PlayerHead.new(PlayerHead.type.circle)
    self:addChild(play_head)
    play_head:setPosition(cc.p(x,y))
    play_head:setAnchorPoint(cc.p(0.5,0.5))
    play_head:setTouchEnabled(true)
    play_head:setScale(0.8)
    return play_head
end

function BattlDramaDunHeadItem:DeleteMe()
    if self.play_head then 
		self.play_head:DeleteMe()
		self.play_head = nil
	end
    self:removeAllChildren()
    self:removeFromParent()
end
