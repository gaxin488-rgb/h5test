function StarTowerOrderWindow:register_event()
    if not self.update_order_event then --更新战令解锁信息
        self.update_order_event = GlobalEvent:getInstance():Bind(StartowerEvent.Update_All_Data, function(data)
            self:initAwardConfig()
            self:updateIconImg()--背景
            self:setChangeLevelStatus()
        end)
    end

    if not self.update_reward_list then --更新领奖信息
        self.update_reward_list = GlobalEvent:getInstance():Bind(StartowerEvent.Update_Reward_Event, function(data)
            self:initAwardConfig()
            self:updatePercent()
            self:upDataTips() -- 领奖提示
            self:setChangeLevelStatus()
        end)
    end

    registerButtonEventListener(self.btn_open_lock, function()
        controller:openStarOrderBuyWindow(true)
    end, true, 1)

    registerButtonEventListener(self.go_btn, function()
        controller:openAwardWindow(false)
        controller:openMainView(true)
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        controller:openAwardWindow(false)
    end, true, 2)

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = Config.StarTowerData.data_tower_const.dungeon_pass_rule_desc
        if config then
            local config_desc = config.desc
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
end

-- 滑动的时候处理显示
function StarTowerOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end

function StarTowerOrderWindow:updateIconImg()
    if tolua.isnull(self.icon_img) or tolua.isnull(self.btn_open_lock) then
        return
    end
    if self.icon_img then
        local basecfg = Config.StarTowerData.data_tower_const
        local   res = basecfg.dungeon_pass_icon.desc
        loadSpriteTexture(self.icon_img, PathTool.getResFrame("oncewarorder", res), LOADTEXT_TYPE_PLIST)
    end
    local status = model:getWarOrderStatus()
    if status then
        setChildUnEnabled(false, self.icon_img)
    else
        setChildUnEnabled(true, self.icon_img)
    end
    if status then
        self.btn_open_lock:setVisible(false)
    else
        self.btn_open_lock:setVisible(true)
    end
end

-- 当等级变化的时候
function StarTowerOrderWindow:setChangeLevelStatus()
    local getnum = model:getCanGetRewardId() or 1
    self:jumpToMoveByY(139 * (getnum - 1))
end

function StarTowerOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
end

function StarTowerOrderWindow:initAwardConfig()
    local reward_data = Config.StarTowerData.data_get_floor_award
    local dic_reward = controller:getModel():getRewardData()
    -- print("+++++++++++++++++++")
    -- printLuaTable(dic_reward)
    self.reward_list = {}
    for k, v in pairs(dic_reward) do
        if reward_data[v.id] then -- 过滤
            table_insert(self.reward_list, v)
        end
    end
    self.reward_goods_item:reloadData()
    self.reward_num_item:reloadData()

    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
end

function StarTowerOrderWindow:openRootWnd()

end

function StarTowerOrderWindow:close_callback()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.update_order_event then
        GlobalEvent:getInstance():UnBind(self.update_order_event)
        self.update_order_event = nil
    end
    if self.update_reward_list then
        GlobalEvent:getInstance():UnBind(self.update_reward_list)
        self.update_reward_list = nil
    end
    controller:openAwardWindow(false)
end

