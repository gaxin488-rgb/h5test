-- --------------------------------------------------------------------
-- 竖版伙伴主界面的子项
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
StarTowerItem = class("StarTowerItem", function()
    return ccui.Widget:create()
end)

local _config = Config.StarTowerData.data_tower_base

function StarTowerItem:ctor()
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function StarTowerItem:config()
    self.ctrl = StartowerController:getInstance()
    self.size = cc.size(720,370)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)
    self.is_lock = false
    self:retain()
    self.is_open_tower = true
    self.star_list = {}
end
function StarTowerItem:layoutUI()
    local csbPath = PathTool.getTargetCSB("startower/star_tower_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    --背景
    self.background = self.main_panel:getChildByName("bg")
    --选中背景
    self.select_bg = self.main_panel:getChildByName("select_bg")
    self.select_bg:setVisible(false)

    self.tower_name = self.main_panel:getChildByName("name")
    --锁
    -- self.lock_icon = self.main_panel:getChildByName("lock")
    --通关图标
    self.pass_icon = self.main_panel:getChildByName("pass_icon")
    self.pass_icon:setVisible(false)
    self.pass_icon:setTouchEnabled(true)
    --关键层奖励
    self._floorAward = self.main_panel:getChildByName("floorAward")
    self._firstAward = self._floorAward:getChildByName("firstAward")
    self._floorAward:setVisible(false)
    --扫荡次数
    self:countVisible(false)
    self.countBG = self.main_panel:getChildByName("countBG")
    self.clean_layout = self.countBG:getChildByName("layou_click")
    --点击进入
    self.come_label =self.main_panel:getChildByName("Image_4")
    self.come_label:setVisible(false) 
    --关卡信息
    self.des_btn = self.main_panel:getChildByName("des_btn")
    local label = self.des_btn:getChildByName("label")
    label:setString(TI18N("语言_c_2511"))
    --通关录像
    self.video_btn = self.main_panel:getChildByName("video_btn")
    local label = self.video_btn:getChildByName("label")
    label:setString(TI18N("语言_c_1605"))
    --模型展示
    local model_node = self.main_panel:getChildByName("model_node")
    self.model_node = model_node
    self.modelList = {}
    for i=1,5 do
        local item = {}
        item.bg = model_node:getChildByName("model_img_"..i)
        item.model = item.bg:getChildByName("model")
        item.name = item.bg:getChildByName("name")
        item.name_bg = item.bg:getChildByName("name_bg")
        item.camp_img = item.bg:getChildByName("camp_img")
        self.modelList[#self.modelList + 1] = item
    end
    --挑战
    self.comfirm_btn = self.main_panel:getChildByName("comfirm_btn")
    self.comfirm_btn.label = self.comfirm_btn:getChildByName("label")
end

function StarTowerItem:createModel(parent, monster_id, hero_vo)
    --spine
    -- if parent.spine_model then
    --     parent.spine_model:DeleteMe()
    --     parent.spine_model = nil
    -- end
    if not parent.spine_model then
        parent.spine_model = BaseRole.new(BaseRole.type.unit, monster_id)
        parent.spine_model:setAnimation(0, PlayerAction.show, true)
        parent.spine_model:setCascade(true)
        parent.spine_model:setScale(0.6)
        parent.spine_model:setAnchorPoint(cc.p(0.5, 0.5))
        parent.model:addChild(parent.spine_model)
    end
    --name camp
    parent.name:setString(string.format(TI18N("语言_c_540"), hero_vo.lev))
    local res = PathTool.getHeroCampTypeIcon(hero_vo.camp_type)
    parent.camp_img:loadTexture(res, LOADTEXT_TYPE_PLIST)
end

function StarTowerItem:updateMode(bool)
    for i,v in ipairs(self.modelList) do
        if v.spine_model then
            v.spine_model:DeleteMe()
            v.spine_model = nil
        end
    end
    if not bool then
        self.model_node:setVisible(false)
        return
    end
    self.model_node:setVisible(true)
    local data = self.data
    local unit_cfg = Config.UnitData.data_unit(data.unit_id)
    local monsters = {unit_cfg.monster1, unit_cfg.monster2, unit_cfg.monster3, unit_cfg.monster4, unit_cfg.monster5}
    for i,v in ipairs(self.modelList) do
        local monster_id = monsters[i]
        local monster_cfg = Config.UnitData1.data_unit2(monster_id)
        if monster_cfg then
            local hero_vo 
            hero_vo = HeroVo.New()
            hero_vo.bid = tonumber(monster_cfg.head_icon)
            hero_vo.master_head_id = tonumber(monster_cfg.head_icon)
            hero_vo.lev = monster_cfg.lev
            hero_vo.star = monster_cfg.star
            hero_vo.camp_type = monster_cfg.camp_type
            hero_vo.name = monster_cfg.name
            delayRun(self, 3 * i / display.DEFAULT_FPS, function()
                self:createModel(v, monster_id, hero_vo)
            end)
        end
    end
end

function StarTowerItem:countVisible(visible)
    local countBG = self.main_panel:getChildByName("countBG")
    countBG:setVisible(visible)
    self._textCount = countBG:getChildByName("textCount")
    self._textCount:setVisible(visible)
    self._dianmond = countBG:getChildByName("dianmond")
    self._dianmond:setVisible(false)
end

function StarTowerItem:setData(index)
    if not index then return end
    local data = _config[index]
    self.data = data
    local name = data.name or ""
    self.tower_name:setString(name)
    -- 引导需要
    self:setName("guildsign_startower_"..data.lev)
    local max_tower = self.ctrl:getModel():getNowTowerId() or 0
    if index>max_tower then
        if not self.lock_icon then
            local pos = {}
            pos.x = 360
            pos.y = 185
            self.lock_icon = createEffectSpine( "E00004", pos, cc.p(0.5,0.5), true, PlayerAction.action_1)
            self.main_panel:addChild(self.lock_icon)
        end
    else
        if self.lock_icon then
            self.lock_icon:clearTracks()
            self.lock_icon:removeFromParent()
            self.lock_icon = nil
        end
    end
    self:updateMessage()
end
function StarTowerItem:sweepCount(data)
    self.pass_icon:setVisible(false)
    self:countVisible(false)
    local max_tower = self.ctrl:getModel():getNowTowerId() or 0
    if data and data.lev == max_tower then
        local count = self.ctrl:getModel():getTowerLessCount() or 0
        local buyCount = self.ctrl:getModel():getBuyCount()

        if count <= 0 then
            if buyCount >= 0 then
                self:countVisible(true)
                self._dianmond:setVisible(true)
                local have_buycount = self.ctrl:getModel():getBuyCount() or 0
                if Config.StarTowerData.data_tower_buy[have_buycount+1] then
                    local num = Config.StarTowerData.data_tower_buy[have_buycount+1].expend[1][2] or 0
                    local str = string.format(TI18N("语言_c_9"),num)
                    self._textCount:setString(str)
                else
                    self:countVisible(false)
                    self._dianmond:setVisible(false)
                    self.pass_icon:setVisible(true)
                end
            else
                self:countVisible(false)
                self._dianmond:setVisible(false)
                self.pass_icon:setVisible(true)
            end
        else
            local str = string.format(TI18N("语言_c_4085"),count)
            self._textCount:setString(str)
            self:countVisible(true)
            self._dianmond:setVisible(false)
            self.pass_icon:setVisible(false)
        end
    end

    if data.lev ~= max_tower and data.lev < max_tower then
        self.pass_icon:setVisible(true)
    end

    --层级奖励
    local max = max_tower
    local itemNum = 6 --写死显示6层的奖励

    if max_tower + itemNum >= #_config then 
        max = #_config
    else 
        max = max_tower + itemNum 
    end
    
    local current = max_tower
    if max_tower+1 >= #_config then 
        current = #_config
    else 
        current = max_tower+1
    end

    if self.data.lev > current and self.data.lev <= max then
        local item_show = _config[self.data.lev].item_show[1]
        if item_show then
            local baseid = item_show[1]
            local num = item_show[2]
            local item = BackPackItem.new(nil,true,nil,0.5)
            item:setDefaultTip()
            self._floorAward:addChild(item)
            self._firstAward:setZOrder(10)
            item:setPosition(cc.p(41,44))
            item:setBaseData(baseid, num)
            self._floorAward:setVisible(true)
        else
            self._floorAward:setVisible(false)    
        end
    else
        self._floorAward:setVisible(false)
    end
end

function StarTowerItem:updateMessage()
    if not self.data then return end
    local max_tower = self.ctrl:getModel():getNowTowerId() or 0
    -- print("-----------------------------StarTowerItem updateMessage", max_tower, self.data.lev)
    local bool = false
    if self.data.lev <= max_tower then
        bool = true
    end
    self.is_pass = bool
    self:sweepCount(self.data)

    self.is_lock = self.data.lev > max_tower+1
    -- self.lock_icon:setVisible(self.is_lock)
    -- self.video_btn:setVisible(not self.is_lock)
    self.come_label:setVisible(false)
    doStopAllActions(self.come_label)
    
    self.is_open_tower = true
    if self.is_pass == false and self.is_lock == false then
        local limit_dun_id = self.data.limit_dun_id or 0
        local data = BattleDramaController:getInstance():getModel():getDramaData()
        if limit_dun_id~=0 and data and data.max_dun_id and data.max_dun_id < limit_dun_id then 
           self.is_open_tower = false
           return
        end
        if self.data.lev == max_tower+1 then
            -- self.come_label:setVisible(false)
            -- breatheShineAction(self.come_label,1,1)
            self:setSelectStatus(true)
            self:updateMode(true)
        else
            self:setSelectStatus(false)
            self:updateMode(false)
        end
    else
        self:setSelectStatus(false)
        -- if self.data.lev == max_tower+1+1 or self.data.lev == max_tower+1+2 then
        if self.data.lev >= max_tower + 1 then
            self:updateMode(true)
        else
            self:updateMode(false)
        end
    end
end

--事件
function StarTowerItem:registerEvents()
    self:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                    math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                    math.abs(self.touch_end.y - self.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                local index = self.data.lev
                local cur_lev = self.ctrl:getModel():getNowTowerId() + 1
                if index > cur_lev then
                    message(TI18N("语言_c_4095"))
                    return
                end
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        end
    end)
    self.clean_layout:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(self.countBG, event_type)
        if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                    math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                    math.abs(self.touch_end.y - self.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                self:clickHandler()
				if sender.guide_call_back ~= nil then
					sender.guide_call_back(sender)
				end
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        end
    end)
    self.pass_icon:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(self.countBG, event_type)
        if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                    math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                    math.abs(self.touch_end.y - self.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                self:clickHandler()
				if sender.guide_call_back ~= nil then
					sender.guide_call_back(sender)
				end
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        end
    end)


    self.comfirm_btn:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                    math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
                    math.abs(self.touch_end.y - self.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                if not self.data then return end
                local tower = self.data.lev or 0
                HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.Startower, {tower_lev = tower})
				if self.guide_call_back ~= nil then
					self.guide_call_back(self)
				end
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
        end
    end)

    self.des_btn:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            sender.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if sender.touch_began ~= nil then
                is_click =
                    math.abs(sender.touch_end.x - sender.touch_began.x) <= 20 and
                    math.abs(sender.touch_end.y - sender.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                self:clickDesHandler()
            end
        elseif event_type == ccui.TouchEventType.began then
            sender.touch_began = sender:getTouchBeganPosition()
        end
    end)
    self.video_btn:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            sender.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if sender.touch_began ~= nil then
                is_click =
                    math.abs(sender.touch_end.x - sender.touch_began.x) <= 20 and
                    math.abs(sender.touch_end.y - sender.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                if self.data then
                    self.ctrl:sender11325(self.data.lev, true)
                end
            end
        elseif event_type == ccui.TouchEventType.began then
            sender.touch_began = sender:getTouchBeganPosition()
        end
    end)

    -- if not self.battle_result_event then
    --     self.battle_result_event = GlobalEvent:getInstance():Bind(StartowerEvent.BATTLE_RESULT, function()
    --         self:updateMessage()
    --     end)
    -- end

end

function StarTowerItem:clickDesHandler()
    StartowerController:getInstance():openStarTowerDes(true, self.data)
end

function StarTowerItem:clickHandler()
    if self.call_fun then 
        self:call_fun(self.data)
    end
end
function StarTowerItem:addCallBack(call_fun)
    self.call_fun =call_fun
end

function StarTowerItem:setSelectStatus(bool)
    if self.lock_icon then
        if bool then
            self.lock_icon:setAnimation(0, PlayerAction.action_2, false)
        else
            self.lock_icon:setAnimation(0, PlayerAction.action, true)
        end
    end
    self.select_bg:setVisible(false)
    self.comfirm_btn:setVisible(bool)
    if bool then
        self:setLocalZOrder(999)
    else 
        self:setLocalZOrder(10)
    end
end

function StarTowerItem:setVisibleStatus(bool)
    self:setVisible(bool)
end
function StarTowerItem:getData()
    return self.data
end

function StarTowerItem:clearInfo()
    self:setSelectStatus(false)
    self:updateMode(false)
    self:removeFromParent()
end


function StarTowerItem:DeleteMe()
    for i,v in ipairs(self.modelList) do
        if v.spine_model then
            v.spine_model:DeleteMe()
            v.spine_model = nil
        end
    end
    if self.lock_icon then
        self.lock_icon:clearTracks()
        self.lock_icon:removeFromParent()
        self.lock_icon = nil
    end
    self:removeFromParent()
    self:removeAllChildren()
    self:release()
end



