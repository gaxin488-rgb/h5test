function StarTowerDes:setPanelData()
end

function StarTowerDes:close_callback()
    self.ctrl:openStarTowerDes(false)
    for i,v in pairs(self.item_list) do
        v:DeleteMe()
    end
    self.item_list = nil
    if self.video_data_event then
        GlobalEvent:getInstance():UnBind(self.video_data_event)
        self.video_data_event = nil
    end
end
