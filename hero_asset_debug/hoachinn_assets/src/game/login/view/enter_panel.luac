				arg_21_0.spine = createEffectSpine(PathTool.getEffectRes(122), cc.p(arg_21_0.logo_size.width / 2 - 28, arg_21_0.logo_size.height / 2 - 64), cc.p(0.5, 0.5), true, PlayerAction.action, nil, cc.TEXTURE2_D_PIXEL_FORMAT_RGB_A8888)

