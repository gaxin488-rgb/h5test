			arg_21_0.checkbox:setSelected(arg_21_0.is_agree)
			SysEnv:getInstance():set(SysEnv.keys.user_proto_agree, arg_21_0.is_agree, false)
			table.insert(var_21_1, 1, {
				usr = arg_21_0.model.loginData.usrName
			})
			SysEnv:getInstance():set(SysEnv.keys.user_proto_name_list, var_21_1, true)
		end
	end

	if var_21_2 and checkUserProto and checkUserProto() then
		arg_21_0.ctrl:openUserProtoPanel(true, function()
