			end

			if arg_21_0.need_show_status then
				arg_21_0.stateIcon:setVisible(true)
			end
		end))

		arg_21_0.btn_login_server:runAction(var_22_0)

		local var_22_1 = cc.Sequence:create(cc.FadeIn:create(0.5), cc.CallFunc:create(function()
			arg_21_0.btn_enter:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1, 100), cc.FadeTo:create(1, 255))))
		end))

		arg_21_0.btn_enter:runAction(var_22_1)

		local var_22_2 = cc.Sequence:create(cc.FadeIn:create(0.5))

		arg_21_0.btn_bg_1:runAction(var_22_2)
		arg_21_0.checkbox:runAction(cc.Sequence:create(cc.FadeIn:create(0.5)))
		arg_21_0.checkbox_lable:runAction(cc.Sequence:create(cc.FadeIn:create(0.5)))
	end))

	arg_21_0.logo:runAction(var_21_0)

	arg_21_0.hasShowFinish = true

	local var_21_1 = arg_21_0.model.loginData.newNameList or {}
	local var_21_2 = true

	if next(var_21_1) == nil then
		if arg_21_0.is_agree then
			var_21_2 = false
		end

		SysEnv:getInstance():set(SysEnv.keys.user_proto_name_list, {
			{
				usr = arg_21_0.model.loginData.usrName
			}
		}, true)
	else
		for iter_21_0, iter_21_1 in ipairs(var_21_1) do
			if iter_21_1.usr == arg_21_0.model.loginData.usrName then
				var_21_2 = false

