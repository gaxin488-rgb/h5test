function EnterPanel.requestEnterGame(arg_18_0, arg_18_1)
	if checkUserProto and checkUserProto() and not arg_18_0.is_agree and not arg_18_1 then
		message(TI18N("语言_c_1429"))

		return
	end

	arg_18_0.is_agree = true

	arg_18_0.checkbox:setSelected(arg_18_0.is_agree)

	local function var_18_0()
		local var_19_0 = arg_18_0.model:getLoginData()

		if var_19_0.srv_id == nil or var_19_0.srv_id == "" or var_19_0.usrName == "" then
			arg_18_0.ctrl:openView(LoginController.type.user_input)

			return
		end

		if var_19_0.ip == nil or #var_19_0.ip == 0 then
			message(TI18N("语言_c_1442"))
			arg_18_0.ctrl:openView(LoginController.type.server_list)

			return
		end

		if os.time() - arg_18_0.last_login > (RECONNEST_INTERVAL or 5) then
			arg_18_0.last_login = os.time()

			sdkSubmitUserData(1)
			arg_18_0.ctrl:requestLoginGame(var_19_0.usrName, var_19_0.ip, var_19_0.port, true, true)
		end
	end

	if os.time() - arg_18_0.last_login <= (RECONNEST_INTERVAL or 5) then
		return
	end

	local var_18_1 = arg_18_0.model:getLoginData()

	if NEED_CHECK_CLOSE and (var_18_1.isClose or GameNet:getInstance():getTime() - var_18_1.open_time < 0) then
		arg_18_0.model:checkReloadServerData(var_18_1)

		return
	end

	if not arg_18_0.model:isNeedReload(TI18N("优先体验服变换，需要重新加载资源才能进入游戏"), var_18_1, sdkOnSwitchAccount) then
		arg_18_0.model:saveCurSrv()
		var_18_0()
	end
end

