	arg_1_0.title_height = 0
	arg_1_0.title = ""
end

function ChooseLangWindow.open_callback(arg_2_0)
	arg_2_0.root_wnd:getChildByName("background"):setScale(display.getMaxScale())

	arg_2_0.main_panel = arg_2_0.root_wnd:getChildByName("main_panel")

	arg_2_0:playEnterAnimatianByObj(arg_2_0.main_panel, 2)

	arg_2_0.close_btn = arg_2_0.main_panel:getChildByName("close_btn")

	arg_2_0.main_panel:getChildByName("win_title"):setString(TI18N("语言_c_4578"))

	arg_2_0.container = arg_2_0.main_panel:getChildByName("container")
	arg_2_0.txt_container = arg_2_0.container:getChildByName("txt_container")
	arg_2_0.txt_title = arg_2_0.txt_container:getChildByName("txt_title")

	arg_2_0:layoutWebView()
	arg_2_0:setMessage(arg_2_0.url)

	arg_2_0.btnobj = {}

	if IS_GAME_WHITEER and CHOOSE_LANG_ARR_TEST then
		CHOOSE_LANG_ARR = CHOOSE_LANG_ARR_TEST
	end

	if CHOOSE_LANG_ARR then
		local var_2_0 = CHOOSE_LANG_ARR
		local var_2_1 = 200
		local var_2_2 = 62
		local var_2_3 = arg_2_0.txt_container:getContentSize().width / 2 - 146
		local var_2_4 = arg_2_0.txt_container:getContentSize().height - var_2_2 + 8
		local var_2_5 = 0
		local var_2_6
		local var_2_7

		for iter_2_0, iter_2_1 in pairs(CHOOSE_LANG_ARR) do
			local var_2_8 = var_2_3 + 296 * math.floor(var_2_5 % 2)
			local var_2_9 = var_2_4 - 110 * math.floor(var_2_5 / 2)
			local var_2_10 = CHOOSE_LANG_STR_ARR[iter_2_1] or iter_2_1
			local var_2_11 = createButton(arg_2_0.txt_container, var_2_10, 620, 500, cc.size(var_2_1, var_2_2), PathTool.getResFrame("common", "common_1017"), 24, Config.ColorData.data_color4[1])

			var_2_11:setPosition(var_2_8, var_2_9)
			var_2_11:setName(iter_2_1)
			var_2_11:enableOutline(Config.ColorData.data_color4[264], 2)
			var_2_11:addTouchEventListener(function(arg_3_0, arg_3_1)
				if arg_3_1 == ccui.TouchEventType.ended then
					if arg_3_0:getName() == CUR_LANG then
						playButtonSound2()
						arg_2_0.ctrl:closeChooseLangView()
					else
						SetGameChooseLang(arg_3_0:getName())
						arg_2_0.ctrl:closeChooseLangView()
						LoginPlatForm:getInstance():onLogout()
					end
				end
			end)

			arg_2_0.btnobj[iter_2_1] = var_2_11
			var_2_5 = var_2_5 + 1
		end
	end
end

function ChooseLangWindow.layoutWebView(arg_4_0)
