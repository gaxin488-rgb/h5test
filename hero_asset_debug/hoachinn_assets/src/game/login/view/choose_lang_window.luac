ChooseLangWindow = ChooseLangWindow or BaseClass(BaseView)

function ChooseLangWindow.__init(arg_1_0)
	arg_1_0.view_tag = ViewMgrTag.DEBUG_TAG
	arg_1_0.ctrl = NoticeController:getInstance()
