FillView = class("FillView", function()
	return ccui.Widget:create()
end)

function FillView.ctor(arg_2_0)
	arg_2_0.size = cc.size(SCREEN_WIDTH, SCREEN_HEIGHT)

	arg_2_0:setContentSize(arg_2_0.size)
	arg_2_0:setAnchorPoint(0.5, 0.5)

	arg_2_0.root_wnd = createCSBNote(PathTool.getTargetCSB("login/login_fill_view"))

	arg_2_0:addChild(arg_2_0.root_wnd)

	arg_2_0.left_panel = arg_2_0.root_wnd:getChildByName("left_panel")
	arg_2_0.right_panel = arg_2_0.root_wnd:getChildByName("right_panel")

	local var_2_0 = (display.width - SCREEN_WIDTH) * 0.5

	if needMourning() then
		setChildUnEnabled(true, arg_2_0.left_panel, cc.c4b(255, 255, 255, 255))
		setChildUnEnabled(true, arg_2_0.right_panel, cc.c4b(255, 255, 255, 255))
	end

	arg_2_0.left_panel:setContentSize(cc.size(var_2_0, display.height))
	arg_2_0.right_panel:setContentSize(cc.size(var_2_0, display.height))
end
