BindEmailWindow = BindEmailWindow or BaseClass(BaseView)

function BindEmailWindow:__init( )
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.ctrl = NoticeController:getInstance()
    self.model = self.ctrl:getModel()
    self.layout_name = "login/bind_email_window" 
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("export","export"), type = ResourcesType.plist },
    } 
    self.win_type = WinType.Tips
    self.title_height = 0
    self.title = ""
end

function BindEmailWindow:open_callback()
    local background = self.root_wnd:getChildByName("background")
    background:setScale(display.getMaxScale())
	self.data = LoginController:getInstance():getModel():getLoginData()

    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel , 2)
    self.close_btn = self.main_panel:getChildByName("close_btn")

    self.Image_2 = self.main_panel:getChildByName("Image_2")
    local win_title = self.main_panel:getChildByName("win_title")
    win_title:setString(TI18N("语言_fun_01_137"))
    self.win_title = win_title
    self.container = self.main_panel:getChildByName('container')
    autoSizeTitleBg(self.win_title,self.Image_2)

    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_btn_label = self.ok_btn:getChildByName("label")
    self.ok_btn_label:setString(TI18N("语言_c_3"))
    self.ok_btn_label:enableOutline(Config.ColorData.data_color4[264], 2)

    self.kefu_btn = self.main_panel:getChildByName("kefu_btn")
    self.kefu_btn_label = self.kefu_btn:getChildByName("label")
    self.kefu_btn_label:setString(TI18N("语言_c_2617"))
    self.kefu_btn_label:enableOutline(Config.ColorData.data_color4[264], 2)

    
    self.role_vo = RoleController:getInstance():getRoleVo()
    local kefuconfig =  Config.FunctionData.data_info[8]
    local needvip = 1
    if kefuconfig and kefuconfig.activate then
        for i,v in ipairs(kefuconfig.activate) do
            if v[1] == "vip_lev" then
                needvip = v[2]
            end
        end
    end
    if GAME_GO_NEW_APK_NEED_VIP then
        needvip = GAME_GO_NEW_APK_NEED_VIP
    end
    local curvip = self.role_vo and self.role_vo.vip_lev or 0
    if needvip > curvip then
        self.kefu_btn:setVisible(false)
        self.ok_btn:setPositionX(327)
    else
        if not GAME_GO_TO_NEW_APK_URL then
            self.kefu_btn:setVisible(false)
            self.ok_btn:setPositionX(327)
        else
            self.ok_btn:setPositionX(508)
            self.kefu_btn:setVisible(true)
        end
    end
    
    self.container_2 = self.main_panel:getChildByName("container_2")
    if self.container_2 then
        self.container_2:setVisible(false)
        self.day_list = {}
        self.cur_select = nil
        self.cur_index = nil
        self.seven_con = self.container_2:getChildByName("seven_con")
        self.exportTop = self.container_2:getChildByName("exportTop")
        self.export_tip = self.exportTop:getChildByName("export_tip")
        setTextMaxWidth(self.export_tip,650)
        self.exportCenter = self.container_2:getChildByName("exportCenter")
        self.export_tip_2 = self.exportCenter:getChildByName("export_tip_2")
        self.tip_leftimg = self.exportCenter:getChildByName("tip_leftimg")
        self.tip_rightimg = self.exportCenter:getChildByName("tip_rightimg")
        self.export_tip:setString(TI18N("语言_c_6047"))
        self.export_tip_2:setString(TI18N("语言_c_6048"))
        setLeftRightImg(self.tip_leftimg,self.export_tip_2,self.tip_rightimg,10)
        local txtH = self.export_tip:getContentSize().height
        local txtbgH = 57 + txtH - 25
        local image_5 = self.exportTop:getChildByName("Image_5")
        local txtbgW = image_5:getContentSize().width
        image_5:setContentSize(cc.size(txtbgW,txtbgH))
    end

    self.tip_1 = self.main_panel:getChildByName("tip_1")
    self.line = self.main_panel:getChildByName("line")
    if self.tip_1 then
        self.tip_1:setTextColor(Config.ColorData.data_color4[175])
        self.tip_1:setTextAreaSize(cc.size(580,0))
    end

    self.user_name_input = self.container:getChildByName("user_name_input")
	self.user_name_input:setMaxLength(99)
    self.user_name_input:setPlaceHolder(TI18N("语言_c_5274"))

	self.password_input = self.container:getChildByName("password_input")
    self.password_input:setPlaceHolder(TI18N("语言_c_5273"))

	self.password_input_2 = self.container:getChildByName("password_input_2")
    self.password_input_2:setPlaceHolder(TI18N("语言_c_5272"))

    
    local function textFieldEvent(sender, eventType)
		if eventType == ccui.TextFiledEventType.attach_with_ime then
			sender:setString("")
        elseif eventType == ccui.TextFiledEventType.detach_with_ime then
        elseif eventType == ccui.TextFiledEventType.insert_text then
        elseif eventType == ccui.TextFiledEventType.delete_backward then
        end
	end
	self.user_name_input:addEventListener(textFieldEvent)
	self.password_input:addEventListener(textFieldEvent)
	self.password_input_2:addEventListener(textFieldEvent)
    self:changeState()
    
    if GAME_GO_NEW_APK_AWAERD then
        NoticeController:getInstance():reqExportAwardInfo()
    end
    if not GAME_GO_TO_NEW_APK_URL and not self.model:isExportGetAward() then
        MainuiController:getInstance():removeFunctionIconById(MainuiConst.icon.go_to_new_apk)
        NoticeController:getInstance():closeBindEmailWindow()
    end
end

function BindEmailWindow:showExportInfo()
    local config = Config.InviteCodeData.data_new_package_list
    local export_loginday = self.model.export_loginday or 0
    local export_getawardday = self.model.export_getawardday or 0
    if config then
        local configlen = #config
        for i=1,4 do
            local day = self.seven_con:getChildByName("day"..i)
            if configlen < i  then
                day:setVisible(false)
            else
                day:setVisible(true)
                local item
                if not self.day_list[i] then
                    item = ExportLoginItem.new()
                    self.day_list[i] = item
                    day:addChild(item)
                    item:setData(i)
                else
                    item = self.day_list[i]
                end
                -- item:addCallBack(function (  )
                --     self:ExportLoginItem(i)
                -- end)
                if export_loginday >= i then
                    if export_getawardday >= i then
                        self.day_list[i]:setStatus(3)
                    else
                        self.day_list[i]:setStatus(2)
                    end
                else
                    self.day_list[i]:setStatus(1)
                end
            end
        end
    end
end

function BindEmailWindow:changeState()
    if not self.container then return end
    local loginData = LoginController:getInstance():getModel():getLoginData() 
    self.isbindemail = false
    local des = TI18N("语言_c_5220")
    if GAME_GO_TO_NEW_APK_SHOW_MSG then des = GAME_GO_TO_NEW_APK_SHOW_MSG end
    local btntip = TI18N("语言_c_7")
    local maxHeight = 533
    if not tolua.isnull(self.line) then
        self.line:setVisible(true)
    end
    if self.container_2 then
        self.container_2:setVisible(false)
    end
    -- --临时代码
    -- loginData.is_guest = 1
    addRedPointToNodeByStatus(self.ok_btn, false)
    self.ok_btn:setTouchEnabled(true)
    setChildUnEnabled(false,self.ok_btn)
    if loginData and loginData.is_guest == 1 and not self.model:isExportGetAward() then -- 游客需线绑定
        self.isbindemail = true
        des = TI18N("语言_c_5219")
        if GAME_GO_TO_NEW_APK_SHOW_MSG_EMAIL then des = GAME_GO_TO_NEW_APK_SHOW_MSG_EMAIL end
        btntip = TI18N("语言_c_5221")
        self.container:setVisible(true)
        self.main_panel:setSize(cc.size(670,maxHeight))
        if self.tip_1 then
            self.tip_1:setPositionY(407)
            self.tip_1:setVisible(true)
        end
    else
        if GAME_GO_NEW_APK_AWAERD and self.container_2 and self.model:isExportGetAward() then
            self.container_2:setVisible(true)
            maxHeight = 600
            self.container:setVisible(false)
            self.main_panel:setSize(cc.size(670,maxHeight))
            self.line:setVisible(false)
            if self.tip_1 then
                self.tip_1:setPositionY(maxHeight-140)
                self.tip_1:setVisible(false)
            end
            if GAME_GO_TO_NEW_APK_URL then
                btntip = TI18N("语言_c_6050")
            else
                if self.model:isExportAwardReceive() then
                    addRedPointToNodeByStatus(self.ok_btn, true, 10, 10)
                    btntip = TI18N("语言_c_684")
                else
                    setChildUnEnabled(true,self.ok_btn)
                    btntip = TI18N("语言_c_684")
                    self.ok_btn:setTouchEnabled(false)
                end
            end
            self:showExportInfo()
        else
            maxHeight = 360
            self.container:setVisible(false)
            self.main_panel:setSize(cc.size(670,maxHeight))
            if self.tip_1 then
                self.tip_1:setPositionY(maxHeight-140)
                self.tip_1:setVisible(true)
            end
        end
    end
    self.close_btn:setPositionY(maxHeight-18)
    self.Image_2:setPositionY(maxHeight-8)
    self.win_title:setPositionY(maxHeight-5)

    self.ok_btn_label:setString(btntip)
    if self.tip_1 then
        self.tip_1:setString(des)
    end
    if GAME_GO_NEW_APK_CANT_PLAY then
        self.close_btn:setVisible(false)
    else
        self.close_btn:setVisible(true)
    end
end

function BindEmailWindow:register_event()
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            NoticeController:getInstance():closeBindEmailWindow()
        end
    end)
	registerButtonEventListener(self.ok_btn, handler(self, self.bingEmail), true, 2)
	registerButtonEventListener(self.kefu_btn, handler(self, self.jumpKefu), true, 2)
    -- 图标添加或者移除的时候需要判断
    if self.update_bind_email_event == nil then
        self.update_bind_email_event = GlobalEvent:getInstance():Bind(MainuiEvent.UPDATE_BIND_EMAIL, function() 
            self:changeState()
        end)
    end
    self:addGlobalEvent(NoticeEvent.Get_Export_Award_info, function(data)
        self:changeState()
    end)
    self:addGlobalEvent(NoticeEvent.Get_Export_Award, function(data)
        self:changeState()
    end)
end

function BindEmailWindow:jumpKefu()
    NoticeController:getInstance():openServiceCenterWindow(true)
end

function BindEmailWindow:bingEmail()
    if not self.isbindemail then
        self:goDownApk()
        return
    end
    local usr = self.user_name_input:getString()
    local password = self.password_input:getString()
    local password2 = self.password_input_2:getString()
    if password ~= password2 then
        message(TI18N("语言_c_5275"))
        return
    end
    local loginInfo = LoginPlatForm:getInstance():getInfo()
    local appId = loginInfo.appid or "0"
    local platform = PLATFORM_NAME
    local account = LoginController:getInstance():getModel():getLoginData().usrName --平台账号id
    local token = LoginPlatForm:getInstance():getToken()
    local email = usr
    local pwd = password
    local args = {
        platform=platform,
        account=account,
        appId=appId,
        token=token,
        email=email,
        pwd=pwd,
        re_pwd=password2
    }
    local param = "/api/user_bind?" .. get_new_send_str(args)
    local callback = function(back_data)
        local eroorobj = {
            [403] = TI18N("语言_c_5266"),
            [405] = TI18N("语言_c_5267"),
            [406] = TI18N("语言_c_5268"),
            [407] = TI18N("语言_c_5269"),
            [408] = TI18N("语言_c_5270"),
            [409] = TI18N("语言_c_5271"),
            [410] = TI18N("语言_c_5275"),
            [500] = TI18N("语言_c_5265"),
        }
        if eroorobj[back_data.code] then
            message(eroorobj[back_data.code])
            return
        end
        if back_data.status == "error" then
            message(back_data.msg)
            return 
        end
        if back_data.data then
            message(TI18N("语言_s_163"))
            LoginController:getInstance():getModel():getLoginData().is_guest = 0
            if self.changeState then
                self:changeState()
            end
            self:goDownApk()
        end
    end
    NoticeController:getInstance():reqHttpCommomPort(param,callback)
end

function BindEmailWindow:goDownApk()
    if GAME_GO_NEW_APK_AWAERD and self.model:isExportGetAward() then
        local channelId = LoginPlatForm:getInstance():getChannel()
        local export_channel_to = self.model.export_channel_to
        if GAME_GO_TO_NEW_APK_URL then
            if export_channel_to and export_channel_to ~= 0 and export_channel_to ~= channelId then
                NoticeController:getInstance():reqGetExportAwardReg(self.model.export_channel_to)
            end
        else
            if self.model:isExportAwardReceive() then
                self.ctrl:Send19815(1)
            end
        end
    else
        if GAME_GO_TO_NEW_APK_URL then
            sdkCallFunc("openUrl", GAME_GO_TO_NEW_APK_URL)
        end
    end
end

function BindEmailWindow:close_callback()
    if self.update_bind_email_event then
        GlobalEvent:getInstance():UnBind(self.update_bind_email_event)
        self.update_bind_email_event = nil
    end
    NoticeController:getInstance():closeBindEmailWindow()
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
--  (必填, 后续维护以及修改的人员)
-- @description:
--      月神之约子项
-- Create: 2020-02-10
-- --------------------------------------------------------------------
ExportLoginItem = class("ExportLoginItem", function()
    return ccui.Widget:create()
end)

function ExportLoginItem:ctor()
    self.ctrl = NoticeController:getInstance()
    self.model = self.ctrl:getModel()

    self:configUI()
    self.status = 1
    self.day_index = 1
	-- self:register_event()
end

function ExportLoginItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("login/export_login_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_day = self.main_container:getChildByName("title_day")
    self.img = self.main_container:getChildByName("img")
    self.icon = self.img:getChildByName("icon")
    self.get = self.main_container:getChildByName("get")
    self.get:setVisible(false)
    self.get_open = self.main_container:getChildByName("get_open")
    self.get_open:setVisible(false)
end

