PlatformPanel = class("PlatformPanel", function()
	return ccui.Widget:create()
end)

function PlatformPanel.ctor(arg_2_0, arg_2_1, arg_2_2)
	arg_2_0.ctrl = arg_2_2
	arg_2_0.model = arg_2_0.ctrl:getModel()
	arg_2_0.data = arg_2_0.model:getLoginData()
	arg_2_0.ip = arg_2_0.data.ip
	arg_2_0.port = arg_2_0.data.port
	arg_2_0.size = arg_2_1 and arg_2_1:getContentSize() or cc.size(SCREEN_WIDTH, SCREEN_HEIGHT)

	arg_2_0:setAnchorPoint(cc.p(0, 0.5))
	arg_2_0:setContentSize(arg_2_0.size)
	arg_2_0:configUI()
	arg_2_0:setTouchEnabled(true)
end

function PlatformPanel.configUI(arg_3_0)
	arg_3_0:initEvent()
end

function PlatformPanel.initEvent(arg_4_0)
	if MUTIL_LOGIN == 0 or not MUTIL_LOGIN then
		arg_4_0:addTouchEventListener(function(arg_5_0, arg_5_1)
			if arg_5_1 == ccui.TouchEventType.ended and PLATFORM_NAME ~= "icebird" and not IS_IOS_PLATFORM then
				LoginPlatForm:getInstance():login()
			end
		end)

		if not LoginPlatForm:getInstance():isLogin() then
			LoginPlatForm:getInstance():login()
		end
	elseif LoginPlatForm:getInstance():isLogin() then
		LoginPlatForm:getInstance():login()
	end
end

function PlatformPanel.update(arg_6_0)
	return
end

function PlatformPanel.setMsg(arg_7_0, arg_7_1)
	return
end

function PlatformPanel.effectHandler(arg_8_0)
	return
end

function PlatformPanel.DeleteMe(arg_9_0)
	return
end
