	if not GameNet:getInstance():IsServerConnect() then
		local var_7_1 = var_0_1:getLoginData()

		var_7_1.host = arg_7_0.data.v.host
		var_7_1.open_time = arg_7_0.data.v.open_time

		if var_7_1 and var_7_1.usrName and var_7_1.usrName ~= "" and not arg_7_0.connecting then
			arg_7_0.connecting = true

			var_0_0:requestLoginGame(var_7_1.usrName, arg_7_0.data.v.ip, arg_7_0.data.v.port or arg_7_0.data.v.erl_port, false)
			delayOnce(function()
				arg_7_0.connecting = false
			end, 0.5)
		end
	else
		sdkSubmitUserData(1)

		if arg_7_1.isEmpty then
			-- block empty
		else
			var_0_0:request10102Login(arg_7_1.rid, arg_7_1.srv_id)
		end
	end

	var_0_1:setCurSrv(arg_7_0.data.v, true)
end

