function ServerCell.click_callback(arg_7_0, arg_7_1)
	local var_7_0 = SysEnv:getInstance():getBool(SysEnv.keys.user_proto_agree, false)

	if checkUserProto and checkUserProto() and not var_7_0 then
		message(TI18N("语言_c_1429"))

		return
	end

	if arg_7_0.data == nil or arg_7_0.data.v == nil then
		return
	end

	if NEED_CHECK_CLOSE == true and IsServerCloseFun(arg_7_0.data.v.isClose) then
		return
