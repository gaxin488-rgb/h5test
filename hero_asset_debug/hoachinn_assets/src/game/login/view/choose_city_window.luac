-- --------------------------------------------------------------------
-- 选择语言
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-8-8
-- --------------------------------------------------------------------
ChooseCityWindow = ChooseCityWindow or BaseClass(BaseView)

function ChooseCityWindow:__init( )
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.ctrl = NoticeController:getInstance()
    self.layout_name = "login/choose_lang_window"
    self.win_type = WinType.Mini
    self.dengluMgr = LoginController:getInstance():getModel()
    self.title_height = 0
    self.title = ""
end

function ChooseCityWindow:open_callback()
    local background = self.root_wnd:getChildByName("background")
    background:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel , 2)
    self.close_btn = self.main_panel:getChildByName("close_btn")

    local win_title = self.main_panel:getChildByName("win_title")
    win_title:setString(TI18N("语言_c_5142"))

    self.container = self.main_panel:getChildByName('container')

    self.txt_container = self.container:getChildByName("txt_container")

    self.txt_title = self.txt_container:getChildByName("txt_title")

    
    self:layoutWebView()
    self:setMessage(self.url)
    self.btnobj = {}
    if CHOOSE_LANG_ARR then
        local langarr = CHOOSE_LANG_ARR
        local bw = 200
        local bh = 62
        local lang_len = 0
        for k,v in pairs(CHOOSE_LANG_ARR) do
            lang_len = lang_len + 1
        end
        local txtContSize = self.txt_container:getContentSize()
        local maxH = math.max(math.ceil(lang_len*0.5)*110,txtContSize.height)
        self.ScrollView = createScrollView(txtContSize.width, txtContSize.height, 0, 0, self.txt_container, ccui.ScrollViewDir.vertical)
        local initX = txtContSize.width / 2-146
        local initY = maxH - bh + 8
        local index = 0
        local btn1X,btn1Y
        for k,v in pairs(CHOOSE_LANG_ARR) do
            btn1X = initX + 296 * math.floor(index%2);
			btn1Y = initY - 110 * math.floor(index/2);
            local lanstr = CHOOSE_LANG_STR_ARR[v] or v
            local font_type = nil
            if v == "ar" then  font_type = "ar" end
            local comfirm_btn = createButton(self.ScrollView,lanstr, 620, 500, cc.size(bw, bh), PathTool.getResFrame("common", "common_1017"), 24, Config.ColorData.data_color4[1],
        nil, nil, nil, font_type)
            comfirm_btn:setPosition(btn1X,btn1Y)
            comfirm_btn:setName(v)
            comfirm_btn:enableOutline(Config.ColorData.data_color4[264], 2)
            comfirm_btn:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playButtonSound2()
                    local clickN = sender:getName()
                    local nowid = CHOOSE_CITY_ID or CUR_LANG
                    if nowid == LANGUAGE_ZH then
                        nowid = LANGUAGE_EN
                    end
                    if nowid == clickN then
                        message(TI18N("语言_c_5150"))
                    else
                        ChatController:getInstance():clearChatLog(ChatConst.Channel.Province)
                        RoleController:getInstance():send25800(clickN)
                        self.ctrl:closeChooseCityView()
                    end
                end
            end)
            self.btnobj[v] = comfirm_btn
            index = index + 1
        end
        self.ScrollView:setInnerContainerSize(cc.size(txtContSize.width, maxH))
    end
end

-- 分离处理webview，如果有问题可以只修改局部代码
function ChooseCityWindow:layoutWebView()
end

function ChooseCityWindow:register_event()
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self.ctrl:closeChooseCityView()
        end
    end)
end

function ChooseCityWindow:setMessage(url)
end

function ChooseCityWindow:setWebViewUrl(url)
end

function ChooseCityWindow:addNoticeContent(list)
end

function ChooseCityWindow:createSubContent(x, y, content, width, linespace)
	local label = createRichLabel(22, Config.ColorData.data_color4[274], nil, cc.p(0, 1), linespace, nil, width)
	return label
end

function ChooseCityWindow:close_callback()
    doStopAllActions(self.notice_scroll)
    self.url = nil
    self.ctrl:closeNoticeView()
    self.ctrl:closeChooseCityView()
end