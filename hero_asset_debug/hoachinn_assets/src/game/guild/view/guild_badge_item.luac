local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

GuildBadgeItem = class("GuildBadgeItem", function()
    return ccui.Widget:create()
end)

function GuildBadgeItem:ctor()
	self:configUI()
	self:register_event()
end

function GuildBadgeItem:configUI( )
	local csbPath = PathTool.getTargetCSB("guild/guild_badge_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.img_bg = self.main_container:getChildByName("img_bg")
	self.img_icon = self.main_container:getChildByName("img_icon")
	self.image_lev_bg = self.main_container:getChildByName("image_lev_bg")
	self.image_lev_bg:setVisible(false)
	self.label_lev = self.image_lev_bg:getChildByName("label_lev")

	self.main_container:setTouchEnabled(false)
end

function GuildBadgeItem:register_event(  )
	registerButtonEventListener(self.main_container, function (  )
		if self.back_fun then
			self.back_fun(self.data)
		end
	end, true, 2)
end

function GuildBadgeItem:setLevOnRight(status)
	if status then
		self.image_lev_bg:setPositionX(83)
	else
		self.image_lev_bg:setPositionX(22)
	end
end

function GuildBadgeItem:setClickCallBack(back_fun)
	if back_fun then
		self.main_container:setTouchEnabled(true)
		self.back_fun = back_fun
	end
end

function GuildBadgeItem:setItemTouchEnabled(enabled)
	self.main_container:setTouchEnabled(enabled)
end

function GuildBadgeItem:setData(data)
	self.data = data
	self:updateBaseView()
end
 
function GuildBadgeItem:updateBaseView()
	self.label_lev:setString(self.data.lev or 0)
	self.label_lev:setVisible(self.data.lev ~= nil)
	self.image_lev_bg:setVisible(self.data.lev ~= nil)
	local cfg = Config.GuildData.data_guild_hui[self.data.select_badge.type][self.data.select_badge.son_type]
	local img_badge = cfg[self.data.select_badge.id].son_type_desc..".png"
	self.img_icon:loadTexture(PathTool.getGuildBadgeIcon(cfg[self.data.select_badge.id].son_type_desc), LOADTEXT_TYPE)
	self.img_icon:setVisible(true)
	local cfg = Config.GuildData.data_guild_hui[self.data.select_badge_bg.type][self.data.select_badge_bg.son_type]
	local img_badge_bg = cfg[self.data.select_badge_bg.id].son_type_desc..".png"
	self.img_bg:loadTexture(PathTool.getGuildBadgeIcon(cfg[self.data.select_badge_bg.id].son_type_desc), LOADTEXT_TYPE)
end

function GuildBadgeItem:showEmptyImage(res)
	local mask_res = PathTool.getResFrame("common", "common_1032")
	self.img_bg:loadTexture(mask_res, ResourcesType.plist)
	self.img_icon:loadTexture(res, ResourcesType.plist)
	self.label_lev:setVisible(false)
	self.image_lev_bg:setVisible(false)
end

function GuildBadgeItem:DeleteMe(  )
	self:removeAllChildren()
    self:removeFromParent()
end