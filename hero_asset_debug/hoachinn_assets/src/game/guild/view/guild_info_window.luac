GuildInfoWindow = GuildInfoWindow or BaseClass(BaseView)
local _controller = GuildController:getInstance()
function GuildInfoWindow:__init()
    self.is_full_screen = false
    self.view_tag = ViewMgrTag.DIALOGUE_TAG  
    self.win_type = WinType.Mini              	
    self.layout_name = "guild/guild_info_window"  

    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("guildbadge","guildbadge"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("elitetournamen","elitetournamen"), type = ResourcesType.plist },
    }
end

function GuildInfoWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
    local Image_11 = self.main_container:getChildByName("Image_11")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5101"))
    moveTextBg(self.win_title,Image_11,60,Image_11:getContentSize().width)

    local panel_top = self.main_container:getChildByName("panel_top")
    self.node_icon = panel_top:getChildByName("node_icon")
    local badge_item = GuildBadgeItem.new()
    self.node_icon:addChild(badge_item)
    self.badge_item = badge_item
    self.guild_name_val = panel_top:getChildByName("guild_name_val")
    self.guild_lv = panel_top:getChildByName("guild_lv")
    self.guild_lv:setString(TI18N("语言_c_5102"))
    self.guild_lv_val = panel_top:getChildByName("guild_lv_val")
    self.guild_num = panel_top:getChildByName("guild_num")
    self.guild_num:setString(TI18N("语言_c_5103"))
    self.guild_num_val = panel_top:getChildByName("guild_num_val")
    self.guild_rank = panel_top:getChildByName("guild_rank")
    self.guild_rank:setString(TI18N("语言_c_5104"))
    self.guild_rank_val = panel_top:getChildByName("guild_rank_val")
    self.guild_cups = panel_top:getChildByName("guild_cups")
    self.guild_cups:setString(TI18N("语言_c_5105"))
    self.guild_cups_val = panel_top:getChildByName("guild_cups_val")
    self.guild_power = panel_top:getChildByName("guild_power")
    self.guild_declaration = panel_top:getChildByName("guild_declaration")
    self.guild_declaration:setString(TI18N("语言_c_5106"))
    self.scrollview_declaration = panel_top:getChildByName("scrollview_declaration")
    self.scrollview_declaration:setScrollBarEnabled(false)
    self.scrollview_declaration.size = self.scrollview_declaration:getContentSize()
    self.guild_declaration_val = self.scrollview_declaration:getChildByName("guild_declaration_val")
    self.guild_declaration_val:ignoreContentAdaptWithSize(true)
    self.guild_declaration_val:setTextAreaSize(cc.size(610, 0))

    local panel_bottom = self.main_container:getChildByName("panel_bottom")
    self.player_mes_title = panel_bottom:getChildByName("player_mes_title")
    self.player_mes_title:setString(TI18N("语言_c_5107"))
    self.player_pos_title = panel_bottom:getChildByName("player_pos_title")
    self.player_pos_title:setString(TI18N("语言_c_5108"))

    local panel_list = panel_bottom:getChildByName("panel_list")
    local scroll_view_size = panel_list:getContentSize()
    local setting = {
        item_class = GuildInfoItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                     -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 620,               -- 单元的尺寸width
        item_height = 130,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scrollview = CommonScrollViewLayout.new(panel_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setBounceEnabled(false)

    self.close_btn = self.main_container:getChildByName("close_btn")
end

function GuildInfoWindow:register_event()
    registerButtonEventListener(self.close_btn, function (  )
        _controller:openGuildInfoWindow(false) 
    end, true, 1)
end

function GuildInfoWindow:openRootWnd(data)
    if data == nil then return end
    self.data = data
    local badge_data = GuildController:getInstance():getModel():getBadgeItemData(self.data.avatar, self.data.avatar_frame)
    self.badge_item:setData(badge_data)
    self.guild_name_val:setString(data.name)
    self.guild_lv_val:setString(data.lev)
    local num1 = data.members_num or 0
    local num2 = data.members_max or 0
    self.guild_num_val:setString(num1.."/"..num2)
    local config = nil
    -- if _controller:getModel():checkIsNewGuildWar() then
    --     config = Config.GuildWarNewData.data_guild_war_level[data.war_lev] --IS_GUILD_NEW_WAR
    -- else
    --     config = Config.GuildWarData.data_guild_war_level[data.war_lev]
    -- end
    config = Config.GuildWarNewData.data_guild_war_level[data.war_lev] --IS_GUILD_NEW_WAR
    if not config then
        config = Config.GuildWarNewData.data_guild_war_level[1]
    end
    self.guild_rank_val:setString(config.name)
    self.guild_cups_val:setString(data.war_cup)
    self.guild_declaration_val:setString(data.sign)
    local height = self.scrollview_declaration.size.height
    if self.guild_declaration_val:getContentSize().height > height then
        height = self.guild_declaration_val:getContentSize().height
    end
    self.scrollview_declaration:setInnerContainerSize(cc.size(self.scrollview_declaration.size.width, height))
    self.guild_declaration_val:setPositionY(height - 5)

    self.item_scrollview:setData(data.members)
    self.guild_power:setString(MoneyTool.moneyFormat(data.power or 0))
end

function GuildInfoWindow:close_callback()
	_controller:openGuildInfoWindow(false)
end

-------------------------------------- item -----------------------------
GuildInfoItem = class("GuildInfoItem", function()
    return ccui.Widget:create()
end)

function GuildInfoItem:ctor()
	self:configUI()
	self:register_event()
end

function GuildInfoItem:configUI( )
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0, 0))

	local csbPath = PathTool.getTargetCSB("guild/guild_info_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    
    self.container = self.root_wnd:getChildByName("container")
    self.node_icon = self.container:getChildByName("node_icon")
    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.node_icon:addChild(self.role_head)
    self.label_name = self.container:getChildByName("label_name")
    self.label_power = self.container:getChildByName("label_power")
    self.label_title = self.container:getChildByName("label_title")
end

function GuildInfoItem:register_event(  )
    if self.role_head then
        self.role_head:addCallBack(function (  )
            if self.role_head then 
                FriendController:getInstance():openFriendCheckPanel(true, self.data)
            end
        end)
    end
end

function GuildInfoItem:setData(data)
    self.data = data
    self.role_head:setHeadRes(data.face, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    self.role_head:setLev(data.lev)
    self.label_name:setString(data.name)
    self.label_power:setString(MoneyTool.moneyFormat(data.power))
    local config = Config.GuildData.data_position[data.post]
    self.label_title:setString(config.name)
end

function GuildInfoItem:getData()
    return self.data
end

function GuildInfoItem:DeleteMe(  )
    if self.head_icon ~= nil then
        self.head_icon:DeleteMe()
        self.head_icon = nil
    end
	self:removeAllChildren()
    self:removeFromParent()
end