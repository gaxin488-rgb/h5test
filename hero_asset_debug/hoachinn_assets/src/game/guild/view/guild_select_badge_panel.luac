GuildSelectBadgePanel = GuildSelectBadgePanel or BaseClass(BaseView)
local _controller = GuildController:getInstance()
function GuildSelectBadgePanel:__init()
    self.is_full_screen = false
    self.view_tag = ViewMgrTag.DIALOGUE_TAG  
    self.win_type = WinType.Mini              	
    self.layout_name = "guild/guild_select_badge_panel"  

    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("guildbadge","guildbadge"), type = ResourcesType.plist },
    }
end

function GuildSelectBadgePanel:open_callback()
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
    local Image_2 = self.main_container:getChildByName("Image_2")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5096"))
    moveTextBg(self.win_title,Image_2,60,Image_2:getContentSize().width)

    local panel_top = self.main_container:getChildByName("panel_top")
    self.image_bg = panel_top:getChildByName("image_bg")
    self.node_item = panel_top:getChildByName("node_item")
    local badge_item = GuildBadgeItem.new()
    self.node_item:addChild(badge_item)
    self.badge_item = badge_item

    local getTabImg = function(tab, index)
        local cfg = Config.GuildData.data_guild_hui[tab][index]
        return cfg[1].son_type_icon..".png"
    end

    --icon
    self.btn_badge_list = {}
    self.panel_badge = self.main_container:getChildByName("panel_badge")
    self.panel_badge.label_title = self.panel_badge:getChildByName("label_title")
    self.panel_badge.label_title:setString(TI18N("语言_c_5097"))
    self.panel_badge.sp_select = self.panel_badge:getChildByName("sp_select")
    for i=1,2 do
        local btn = self.panel_badge:getChildByName("btn_"..i)
        btn:ignoreContentAdaptWithSize(true)
        self.btn_badge_list[#self.btn_badge_list + 1] = btn
        btn.index = i
        btn.tab_index = 1
        local img_btn = getTabImg(1, i)
        btn:loadTexture(img_btn, ResourcesType.plist)
    end
    self.panel_badge.panel_list = self.panel_badge:getChildByName("panel_list")
    local scroll_view_size = self.panel_badge.panel_list:getContentSize()
    local setting = {
        item_class = GuildSelectBadgeItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 2,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 2,                   -- y方向的间隔
        item_width = 120,               -- 单元的尺寸width
        item_height = 120,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 5,                         -- 列数，作用于垂直滚动类型
    }
    self.badge_scrollview = CommonScrollViewLayout.new(self.panel_badge.panel_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.badge_scrollview:setBounceEnabled(false)
    --bg
    self.btn_badge_bg_list = {}
    self.panel_badge_bg = self.main_container:getChildByName("panel_badge_bg")
    self.panel_badge_bg.label_title = self.panel_badge_bg:getChildByName("label_title")
    self.panel_badge_bg.label_title:setString(TI18N("语言_c_5098"))
    self.panel_badge_bg.sp_select = self.panel_badge_bg:getChildByName("sp_select")
    for i=1,4 do
        local btn = self.panel_badge_bg:getChildByName("btn_"..i)
        btn:ignoreContentAdaptWithSize(true)
        self.btn_badge_bg_list[#self.btn_badge_bg_list + 1] = btn
        btn.index = i
        btn.tab_index = 2
        local img_btn = getTabImg(2, i)
        btn:loadTexture(img_btn, ResourcesType.plist)
    end
    self.panel_badge_bg.panel_list = self.panel_badge_bg:getChildByName("panel_list")
    local scroll_view_size = self.panel_badge_bg.panel_list:getContentSize()
    local setting = {
        item_class = GuildSelectBadgeItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 2,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 2,                   -- y方向的间隔
        item_width = 120,               -- 单元的尺寸width
        item_height = 120,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 5,                         -- 列数，作用于垂直滚动类型
    }
    self.badge_bg_scrollview = CommonScrollViewLayout.new(self.panel_badge_bg.panel_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.badge_bg_scrollview:setBounceEnabled(false)

    self.label_des = self.main_container:getChildByName("label_des")
    self.label_des :setString(TI18N("语言_c_5099"))
    self.confirm_btn = self.main_container:getChildByName("confirm_btn")
    self.confirm_btn:getChildByName("label"):setString(TI18N("语言_c_5100"))
    self.close_btn = self.main_container:getChildByName("close_btn")
end

function GuildSelectBadgePanel:register_event()
    registerButtonEventListener(self.close_btn, function (  )
        _controller:openGuildSelectBadgePanel(false) 
    end, true, 1)
    registerButtonEventListener(self.confirm_btn, function (  )
        local data = {}
        data.avatar_id = Config.GuildData.data_guild_hui[self.select_badge.type][self.select_badge.son_type][self.select_badge.id].sid
        data.avatar_frame_id = Config.GuildData.data_guild_hui[self.select_badge_bg.type][self.select_badge_bg.son_type][self.select_badge_bg.id].sid
        _controller:send13525(data)
        _controller:openGuildSelectBadgePanel(false)
    end, true, 2)
    for i, v in ipairs(self.btn_badge_list) do
        registerButtonEventListener(v, function (param, sender)
            self:updateSelectBadgeList(1 ,sender.index)
        end, true, 2)
    end

    for i, v in ipairs(self.btn_badge_bg_list) do
        registerButtonEventListener(v, function (param, sender)
            self:updateSelectBadgeBgList(2, sender.index)
        end, true, 2)
    end

    if self.update_select_badge_event == nil then
        self.update_select_badge_event = GlobalEvent:getInstance():Bind(GuildEvent.UpdateSelectBadge, function(badge_data)
            if badge_data.type == 1 then
                self.select_badge = badge_data
            else
                self.select_badge_bg = badge_data
            end
            self:updateCurBadgeItem()
		end)
	end
end

function GuildSelectBadgePanel:openRootWnd(select_badge_index, select_badge_bg_index)
    self.select_badge = _controller:getModel():getCurBadge()
    self.select_badge_bg = _controller:getModel():getCurBadgeBg()
    self:updateCurBadgeItem()
    self:updateSelectBadgeList()
    self:updateSelectBadgeBgList()
end

function GuildSelectBadgePanel:updateCurBadgeItem()
    local data = {
        select_badge = self.select_badge,
        select_badge_bg = self.select_badge_bg,
    }
    self.badge_item:setData(data)
end

function GuildSelectBadgePanel:updateSelectBadgeList(type, son_type)
    local _type = type or self.select_badge.type
    local son_type = son_type or self.select_badge.son_type
    self.panel_badge.sp_select:setPosition(cc.p(self.btn_badge_list[son_type]:getPosition()))
    local list = Config.GuildData.data_guild_hui[_type][son_type]
    self.badge_scrollview:setData(list)
    self.badge_scrollview:addEndCallBack(function (  )
        local list = self.badge_scrollview:getItemList()
        for k,v in pairs(list) do
            local data = v:getData()
            v:setSelectStatus(data and data.son_type == self.select_badge.son_type and data.id == self.select_badge.id)
        end
    end)
end

function GuildSelectBadgePanel:updateSelectBadgeBgList(type, son_type)
    local _type = type or self.select_badge_bg.type
    local son_type = son_type or self.select_badge_bg.son_type
    self.panel_badge_bg.sp_select:setPosition(cc.p(self.btn_badge_bg_list[son_type]:getPosition()))
    local list = Config.GuildData.data_guild_hui[_type][son_type]
    self.badge_bg_scrollview:setData(list)
    self.badge_bg_scrollview:addEndCallBack(function (  )
        local list = self.badge_bg_scrollview:getItemList()
        for k,v in pairs(list) do
            local data = v:getData()
            v:setSelectStatus(data and data.son_type == self.select_badge_bg.son_type and data.id == self.select_badge_bg.id)
        end
    end)
end

function GuildSelectBadgePanel:close_callback()
    if self.badge_item ~= nil then
        self.badge_item:DeleteMe()
        self.badge_item = nil
    end
    if self.update_select_badge_event then
		GlobalEvent:getInstance():UnBind(self.update_select_badge_event)
		self.update_select_badge_event = nil
	end
	_controller:openGuildSelectBadgePanel(false)
end

-------------------------------------- item -----------------------------
GuildSelectBadgeItem = class("GuildSelectBadgeItem", function()
    return ccui.Widget:create()
end)

function GuildSelectBadgeItem:ctor()
	self:configUI()
	self:register_event()
end

function GuildSelectBadgeItem:configUI( )
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0, 0))

	local csbPath = PathTool.getTargetCSB("guild/guild_select_badge_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    -- self.root_wnd:setPosition(cc.p(self.size.width/2, self.size.height/2))
    
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container:setSwallowTouches(false)
    self.img_bg = self.main_container:getChildByName("img_bg")
    self.img_icon = self.main_container:getChildByName("img_icon")
    self.sp_lock = self.main_container:getChildByName("sp_lock")
    self.sp_lock:setScale(0.7)
    self.img_select = self.main_container:getChildByName("img_select")
end

function GuildSelectBadgeItem:register_event(  )
    registerButtonEventListener(self.main_container, function (  )
        local status, desc = _controller:getModel():checkBadgeLock(self.data)
        if status then
            message(desc)
            return 
        end
        local data = {type = self.data.type, son_type = self.data.son_type, id = self.data.id}
        GlobalEvent:getInstance():Fire(GuildEvent.UpdateSelectBadge, data)
    end, true, 2, nil, nil, nil, true)
    
    if self.update_select_badge_event == nil then
        self.update_select_badge_event = GlobalEvent:getInstance():Bind(GuildEvent.UpdateSelectBadge, function(badge_data)
            if tolua.isnull(self) or not self.data then return end
            if self.data.type ~= badge_data.type then return end
            self:setSelectStatus(self.data and self.data.son_type == badge_data.son_type and self.data.id == badge_data.id)
		end)
	end
end

function GuildSelectBadgeItem:setSelectStatus(status)
    self.img_select:setVisible(status)
end

function GuildSelectBadgeItem:setLockStatus(status)
    self.sp_lock:setVisible(status)
end

function GuildSelectBadgeItem:setData(data)
    self.data = data
    self.img_icon:loadTexture(PathTool.getGuildBadgeIcon(data.son_type_desc), LOADTEXT_TYPE)
    self:setLockStatus(_controller:getModel():checkBadgeLock(self.data))
end

function GuildSelectBadgeItem:getData()
    return self.data
end

function GuildSelectBadgeItem:DeleteMe(  )
    if self.update_select_badge_event then
		GlobalEvent:getInstance():UnBind(self.update_select_badge_event)
		self.update_select_badge_event = nil
	end
	self:removeAllChildren()
    self:removeFromParent()
end