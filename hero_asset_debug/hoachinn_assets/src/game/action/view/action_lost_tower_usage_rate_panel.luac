ActionLostTowerUsageRatePanel = ActionLostTowerUsageRatePanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionLostTowerUsageRatePanel:__init()
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "action/action_lost_tower_usage_rate_panel"
	self.hero_list = {}   ------英雄使用率
	self.formation_list = {}    ------------阵型使用率
	self.page_num = 1
	self.total_page = 1
	self.res_list = {
		{ path = PathTool.getPlistImgForDownLoad("form","form"), type = ResourcesType.plist },
	}
end

function ActionLostTowerUsageRatePanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 
	local image_2 = main_container:getChildByName("image_2")
	local win_title = main_container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_5817"))
	image_2:setContentSize(cc.size(win_title:getContentSize().width + 120,image_2:getContentSize().height))
	self.close_btn = main_container:getChildByName("close_btn")
	self.top_panel = main_container:getChildByName("top_panel")
	self.top_bg = self.top_panel:getChildByName("top_bg")
	self.top_title_bg = self.top_panel:getChildByName("top_title_bg")
	self.top_title_txt = self.top_panel:getChildByName("top_title_txt")
	self.top_title_txt:setString(TI18N("语言_c_5818"))
	self.top_title_bg:setContentSize(cc.size(self.top_title_txt:getContentSize().width + 100,self.top_title_bg:getContentSize().height))
	self.top_list = self.top_panel:getChildByName("top_list")
	self.top_null_img = self.top_panel:getChildByName("top_null_img")
	self.top_null_txt = self.top_panel:getChildByName("top_null_txt")
	self.top_null_txt:setString(TI18N("语言_c_273"))
	self.bottom_panel = main_container:getChildByName("bottom_panel")
	self.bottom_bg = self.bottom_panel:getChildByName("bottom_bg")
	self.bottom_title_bg = self.bottom_panel:getChildByName("bottom_title_bg")
	self.bottom_title_txt = self.bottom_panel:getChildByName("bottom_title_txt")
	self.bottom_title_txt:setString(TI18N("语言_c_5819"))
	self.bottom_title_bg:setContentSize(cc.size(self.bottom_title_txt:getContentSize().width + 100,self.bottom_title_bg:getContentSize().height))
	self.bottom_list = self.bottom_panel:getChildByName("bottom_list")
	self.bottom_null_img = self.bottom_panel:getChildByName("bottom_null_img")
	self.bottom_null_txt = self.bottom_panel:getChildByName("bottom_null_txt")
	self.bottom_null_txt:setString(TI18N("语言_c_273"))
    self.bottom_list:setScrollBarEnabled(false)
    self.bottomview_size = self.bottom_list:getContentSize()

	local bgSize = self.top_list:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height)
    local setting = {
        item_class = ActionLostTowerUsageRateItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 5,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 608,               -- 单元的尺寸width
        item_height = 138,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.award_scrollview = CommonScrollViewLayout.new(self.top_list, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.award_scrollview:setSwallowTouches(false)
end

function ActionLostTowerUsageRatePanel:createItem(config, item_width, use_num)
    local size = cc.size(item_width, item_width)
    local item = {}
    item.config = config
    
    local con = ccui.Widget:create()
    con:setContentSize(size)
    con:setTouchEnabled(true)
    --背景
    local res = PathTool.getNormalCell()
    local bg = createImage(con, res,  size.width/2,size.height/2, cc.p(0.5,0.5), true, 0, true)
    bg:setContentSize(size)

    item.con = con

    --阵法icon
	local type = config.type + 7
    local res = PathTool.getResFrame("form", "form_icon_"..type)
    item.icon = createImage(item.con, res,  size.width/2,size.height/2, cc.p(0.5,0.5), true, 0, false)
    item.icon:setScale(0.8)

    --阵法名字 --68452a
	local str = string.format(TI18N("语言_c_5820"),use_num)
    item.name = createLabel(20,cc.c3b(0x68,0x45,0x2a),nil, item_width * 0.5,-27 ,str, item.con,nil, cc.p(0.5,0.5),nil)
    return item
end

function ActionLostTowerUsageRatePanel:openRootWnd(  )
	controller:sender21910(ActionRankCommonType.LostTower)
end

function ActionLostTowerUsageRatePanel:setData(data)
	if not data then return end
	self.hero_list = data.p_list
	self.formation_list = data.f_list
	table.sort(self.hero_list,function(a,b)
		return a.num > b.num
	end)
	if #self.hero_list > 0 then
		self.award_scrollview:setData(self.hero_list)
		self.top_null_img:setVisible(false)
		self.top_null_txt:setVisible(false)
	else
		self.top_null_img:setVisible(true)
		self.top_null_txt:setVisible(true)
	end
	if #self.formation_list > 0 then
		self.bottom_null_img:setVisible(false)
		self.bottom_null_txt:setVisible(false)
	else
		self.bottom_null_img:setVisible(true)
		self.bottom_null_txt:setVisible(true)
	end

	local item_width  = 98
	local _width = math.max(#self.formation_list * (item_width + 22),self.bottom_list:getContentSize().width)
    self.bottom_list:setInnerContainerSize(cc.size(_width, self.bottomview_size.height))
	self.item_list = {}
    local index = 1
    self:clearTimeTicket()
    self.time_ticket = GlobalTimeTicket:getInstance():add(function()
        if tolua.isnull(self.bottom_list) then return end
        if self.formation_list[index] ~= nil then
            local config = Config.FormationData.data_six_form_data[self.formation_list[index].type]
			if config then
				if self.item_list[index] == nil then
					self.item_list[index] = self:createItem(config, item_width,self.formation_list[index].num)
					self.bottom_list:addChild(self.item_list[index].con)
				end
				self.item_list[index].con:setPosition( (index-1 + 0.5) * (item_width + 22), 100)
			end
            index = index + 1
        else
            self:clearTimeTicket()
        end
    end, 3 / display.DEFAULT_FPS)
end
function ActionLostTowerUsageRatePanel:clearTimeTicket()
    if self.time_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_ticket)
        self.time_ticket = nil
    end
end 
function ActionLostTowerUsageRatePanel:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	if not self.LostTowerUsageRate then
        self.LostTowerUsageRate = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerUsageRate,function(data)
            if not data then return end
            self:setData(data)
        end
        )
    end
end

function ActionLostTowerUsageRatePanel:_onClickBtnClose(  )
	controller:openActionLostTowerUsageRatePanel(false)
end

function ActionLostTowerUsageRatePanel:close_callback(  )
	self:clearTimeTicket()
	controller:openActionLostTowerUsageRatePanel(false)
	if self.LostTowerUsageRate then
        GlobalEvent:getInstance():UnBind(self.LostTowerUsageRate)
        self.LostTowerUsageRate = nil
    end
end

-----------------------------------@ 奖励item
ActionLostTowerUsageRateItem = class("ActionLostTowerUsageRateItem", function()
    return ccui.Widget:create()
end)

function ActionLostTowerUsageRateItem:ctor()
	self:configUI()
	self:register_event()
end

function ActionLostTowerUsageRateItem:configUI(  )
	self.size = cc.size(608,138)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("action/action_lost_tower_usage_rate_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("main_container")
    self.container = container
	self.rank_sprite= container:getChildByName("rank_sprite")
	self.rank_txt= self.container:getChildByName("rank_txt")
	self.hero_node= self.container:getChildByName("hero_node")
	self.camp= self.container:getChildByName("camp")
	self.hero_name = self.container:getChildByName("hero_name")
	setTextMaxWidth(self.hero_name,126,-10)
	self.usage_rate_txt_bg= self.container:getChildByName("usage_rate_txt_bg")
	self.usage_rate_txt= self.container:getChildByName("usage_rate_txt")
end

function ActionLostTowerUsageRateItem:register_event(  )
end

function ActionLostTowerUsageRateItem:setData(data)
    --排名
	self.data = data
	if self.data._index <= 3 then
		self.rank_txt:setVisible(false)
		self.rank_sprite:setVisible(true)
		local path = string.format("common_200%s", data._index)
        local src =  PathTool.getResFrame('common', path,false)
        loadSpriteTexture(self.rank_sprite,src,LOADTEXT_TYPE_PLIST)
	else
		self.rank_txt:setVisible(true)
		self.rank_sprite:setVisible(false)
		self.rank_txt:setString(self.data._index)
	end
	--英雄展示
	if not self.hero_item then
		self.hero_item = HeroExhibitionItem.new(1, true)
		self.hero_item:addCallBack(function() self:onClickHeroItemByIndex() end)
		-- self.hero_item:setBgOpacity(128)
		self.hero_node:addChild(self.hero_item)
	end
	self.hero_cfg = Config.PartnerData.data_partner_base[self.data.bid]
	if self.hero_cfg then
		self.hero_item:setData(self.hero_cfg)
		self.hero_name:setString(self.hero_cfg.name)
		local src =  PathTool.getHeroCampTypeIcon(self.hero_cfg.camp_type)
		loadSpriteTexture(self.camp,src,LOADTEXT_TYPE_PLIST)
		self.hero_item:setQualityImg(self.hero_cfg.init_star-1)
	else
		if self.hero_item then
			self.hero_item:setData()
		end
		self.hero_name:setString("")
	end
	-- if self.hero_name:getContentSize().width > 126 then
	-- 	self.hero_name:setPositionX(self.hero_name:getPositionX() - (self.hero_name:getContentSize().width - 126))
	-- 	self.camp:setPositionX(self.camp:getPositionX() - (self.hero_name:getContentSize().width - 126))
	-- else
	-- 	self.camp:setPositionX(431)
	-- 	self.hero_name:setPositionX(466)
	-- end
	self.usage_rate_txt:setString(string.format(TI18N("语言_c_5820"),self.data.num))
	self.usage_rate_txt_bg:setContentSize(cc.size(self.usage_rate_txt:getContentSize().width + 20, 28))
end
--点击英雄
function ActionLostTowerUsageRateItem:onClickHeroItemByIndex()
	HeroController:getInstance():openHeroLibraryInfoWindow(true,self.data.bid)
end

function ActionLostTowerUsageRateItem:DeleteMe(  )
end