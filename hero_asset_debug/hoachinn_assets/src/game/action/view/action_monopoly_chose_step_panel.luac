--******** 文件说明 ********
-- 
-- @description:幻境探险幸运骰子选择界面
-- @DateTime:    2019-06-24 20:08:18
-- *******************************
ActionMonopolyChoseStepPanel = ActionMonopolyChoseStepPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local table_insert = table.insert
function ActionMonopolyChoseStepPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_monopoly_chose_step_window"
    self.init_select = 1 --默认选择1点
end

function ActionMonopolyChoseStepPanel:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("container")
    self.title = main_container:getChildByName("Sprite_1"):getChildByName("Text_1")
    self.title:setString(TI18N("语言_c_5127"))
    self.tips1 = main_container:getChildByName("tips_txt")
    self.tips1:ignoreContentAdaptWithSize(true)
    self.tips1:setTextAreaSize(cc.size(620, 0))
    setTextSpacing(self.tips1)
    self.tips1:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self.tips1:setString(TI18N("语言_c_5128"))

    -- self.tips1:setString(transformTextToShort(TI18N("语言_c_5128"), 24))
    -- addEvt2showAllTextTips(self.tips1,TI18N("语言_c_5128"),24,nil,nil,nil,true,true)

    self.bg_panel = main_container:getChildByName("bg_panel")
    self.sure_btn = self.bg_panel:getChildByName("sure_btn")
    self.sure_btn:getChildByName("label"):setString(TI18N("语言_c_63"))
    self.cancel_btn = self.bg_panel:getChildByName("cancel_btn")
    self.cancel_btn:getChildByName("label"):setString(TI18N("语言_c_62"))
    self.step_layer = self.bg_panel:getChildByName("Image_38")
    self.step_list = {}
    for i = 1, 6, 1 do
        local step_btn = self.step_layer:getChildByName("step_btn_"..i)
        step_btn:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                self:changeSelect(i)
            end
        end)
        table_insert(self.step_list,step_btn)
    end
    self.select_img = self.step_layer:getChildByName("sele_img")

    self.btn_close = main_container:getChildByName("close_btn")
end

function ActionMonopolyChoseStepPanel:changeSelect(index)
	local pos_x = self.step_list[index]:getPositionX()
	local pos_y = self.step_list[index]:getPositionY()
    self.init_select = index
    self.select_img:setPositionX(pos_x)
    self.select_img:setPositionY(pos_y)
end

function ActionMonopolyChoseStepPanel:setData()
    
end

function ActionMonopolyChoseStepPanel:register_event()
	registerButtonEventListener(self.btn_close, function()
        controller:openMonopolyChooseStep(false)
    end,true, 2)
    registerButtonEventListener(self.sure_btn, function()
        controller:sender29302(2,self.init_select)
        controller:openMonopolyChooseStep(false)
    end,false, 2)
    registerButtonEventListener(self.cancel_btn, function()
        controller:openMonopolyChooseStep(false)
    end,true, 1)
end

function ActionMonopolyChoseStepPanel:openRootWnd()
   
end

function ActionMonopolyChoseStepPanel:close_callback()
	controller:openMonopolyChooseStep(false)
end
