--******** 文件说明 ********
-- 
-- @description: 活动结束警告
-- @DateTime:    2020-02-20
-- *******************************
ActionWarOrderEndWarnWindow = ActionWarOrderEndWarnWindow or BaseClass(BaseView)

local controller = ActionController:getInstance()

function ActionWarOrderEndWarnWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "neworderaction/neworderaction_end_warn_window"
end

function ActionWarOrderEndWarnWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2) 
    local Image_16 = main_container:getChildByName("Image_16")
    local Text_15 = main_container:getChildByName("Image_16"):getChildByName("Text_15")
    Text_15:setString(TI18N("语言_c_719"))
    local _w = math.max(Text_15:getContentSize().width+100,Image_16:getContentSize().width)
    Image_16:setContentSize(cc.size(_w,Image_16:getContentSize().height))
    Text_15:setPositionX(Image_16:getContentSize().width/2)
    self.btn_close = main_container:getChildByName("btn_close")
    self.btn_ok = main_container:getChildByName("btn_ok")
    self.btn_ok:getChildByName("Text_14"):setString(TI18N("语言_c_720"))
    self.btn_unlock = main_container:getChildByName("btn_unlock")
    self.btn_unlock:getChildByName("label"):setString(TI18N("语言_c_2677"))
    local str_warn = string.format(TI18N("语言_c_2678"))
    local desc_text = main_container:getChildByName("desc_text")
    desc_text:setString(str_warn)
    desc_text:ignoreContentAdaptWithSize(true)
    desc_text:setTextAreaSize(cc.size(580,0))
    desc_text:setScale(1)
    self.desc_text = desc_text
    self.reamin_day = main_container:getChildByName("reamin_day")
    self.desc_text:setVisible(false)
    self.reamin_day:setVisible(false)
    self.desc_r_text = createRichLabel(self.desc_text:getFontSize(),self.desc_text:getTextColor(),cc.p(0.5,1),cc.p(self.desc_text:getPosition()),nil,nil,590)
	main_container:addChild(self.desc_r_text)
end

function ActionWarOrderEndWarnWindow:register_event()
    registerButtonEventListener(
        self.background,
        function()
            controller:openEndWarnView(false)
        end,
        false,
        2
    )
    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openEndWarnView(false)
        end,
        true,
        2
    )
    registerButtonEventListener(
        self.btn_ok,
        function()
            controller:openEndWarnView(false)
        end,
        true,
        1
    )
    registerButtonEventListener(
        self.btn_unlock,
        function()
            controller:openEndWarnView(false)
            controller:openActionwaradvanced(true)
        end,
        true,
        1
    )
end

function ActionWarOrderEndWarnWindow:openRootWnd(day,txt)
    day = day or 0
    local str = ""
    local remain_day = day
    local txt = txt or TI18N("语言_c_5198")
    -- if remain_day <= 0 then
    -- 	remain_day = 0
    -- 	str = TI18N("语言_c_726")
    -- else
    str = string.format(TI18N("语言_c_4703"),remain_day)
    str = string.format("<div fontcolor=249003>%s</div>",str)
    -- end
    -- self.reamin_day:setString(str)
    if txt then
        self.desc_r_text:setString(string.format(txt, str))
        -- self.desc_text:setString(txt)
        self.btn_unlock:setVisible(false)
        self.btn_ok:setPositionX(323)
    end
end
function ActionWarOrderEndWarnWindow:close_callback()
    controller:openEndWarnView(false)
end
