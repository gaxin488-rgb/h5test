ActionLostTowerDreamTeamPanel = ActionLostTowerDreamTeamPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionLostTowerDreamTeamPanel:__init()
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "action/action_lost_tower_dream_team_panel"
	-- self.own_dreamTeam_data = {}
	self.page_num = 1
	self.total_page = 1
	self.own_dreamTeam_data = {}------自己上传的梦之队
	self.dreamTeam_data = {}---------梦之队排行
end

function ActionLostTowerDreamTeamPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 
	local image_2 = main_container:getChildByName("image_2")
	local win_title = main_container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_5825"))
	image_2:setContentSize(cc.size(win_title:getContentSize().width + 120,image_2:getContentSize().height))
	self.close_btn = main_container:getChildByName("close_btn")
	self.top_panel = main_container:getChildByName("top_panel")
	self.top_title_bg = self.top_panel:getChildByName("top_title_bg")
	self.top_title_txt = self.top_panel:getChildByName("top_title_txt")
	self.top_title_txt:setString(TI18N("语言_c_5825"))
	self.top_title_bg:setContentSize(cc.size(self.top_title_txt:getContentSize().width + 30,40))
	self.top_bg = self.top_panel:getChildByName("top_bg")
	self.top_list = self.top_panel:getChildByName("top_list")
	self.top_null_img = self.top_panel:getChildByName("top_null_img")
	self.top_null_txt = self.top_panel:getChildByName("top_null_txt")
	self.top_null_txt:setString(TI18N("语言_c_273"))
	self.pagination_panel = self.top_panel:getChildByName("pagination_panel")
	self.left_img = self.pagination_panel:getChildByName("left_img")
	self.page_txt = self.pagination_panel:getChildByName("page_txt")
	self.page_txt:setString(self.page_num.."/"..self.total_page)
	self.right_img = self.pagination_panel:getChildByName("right_img")
	self.bottom_panel = main_container:getChildByName("bottom_panel")
	self.bottom_bg = self.bottom_panel:getChildByName("bottom_bg")
	self.bottom_title_bg = self.bottom_panel:getChildByName("bottom_title_bg")
	self.bottom_title_txt = self.bottom_panel:getChildByName("bottom_title_txt")
	self.bottom_title_txt:setString(TI18N("语言_c_5926"))
	self.bottom_title_bg:setContentSize(cc.size(self.bottom_title_txt:getContentSize().width + 30,40))
	self.my_line_up_panel = self.bottom_panel:getChildByName("my_line_up_panel")
	self.item_panel = main_container:getChildByName("item_panel")
	self.item_img = self.item_panel:getChildByName("item_img")
	self.item_label = self.item_panel:getChildByName("item_label")
	self.upload_btn = main_container:getChildByName("upload_btn")
	self.txt_panel = self.upload_btn:getChildByName("txt_panel")
	self.upload_txt = self.txt_panel:getChildByName("upload_txt")
	self.upload_txt:getVirtualRenderer():setLineSpacing(-10)
	self.upload_txt:setString(TI18N("语言_c_5835"))

	local bgSize = self.top_list:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height-8)
    local setting = {
        item_class = ActionLostTowerDreamTeamItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 588,               -- 单元的尺寸width
        item_height = 250,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.award_scrollview = CommonScrollViewLayout.new(self.top_list, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.award_scrollview:setSwallowTouches(false)

	controller:sender21905(ActionRankCommonType.LostTower)
	controller:sender21906(ActionRankCommonType.LostTower,self.page_num)
end

function ActionLostTowerDreamTeamPanel:openRootWnd(  )
	self:setData()
end
function ActionLostTowerDreamTeamPanel:setRankData()
	for key, value in pairs(self.dreamTeam_data) do
		local data = {}
		for key, value in pairs(value.pos_info) do
			local list = {}
			list = value
			data[value.pos] = list
		end
		value.pos_info = data
	end
	if #self.dreamTeam_data > 0 then
		self.award_scrollview:setData(self.dreamTeam_data)
		self.top_null_img:setVisible(false)
		self.top_null_txt:setVisible(false)
	else
		self.top_null_img:setVisible(true)
		self.top_null_txt:setVisible(true)
	end
end
function ActionLostTowerDreamTeamPanel:setSelfTeamData()
	if self.own_dreamTeam_data and next(self.own_dreamTeam_data) ~= nil then
		self.own_dreamTeam_item = ActionLostTowerDreamTeamItem.new()
		self.my_line_up_panel:addChild(self.own_dreamTeam_item)
		self.own_dreamTeam_item:setData(self.own_dreamTeam_data)
		self.own_dreamTeam_item:setPosition(cc.p(self.my_line_up_panel:getContentSize().width/2,self.my_line_up_panel:getContentSize().height/2))
		self.upload_btn:setVisible(false)
	end
end
function ActionLostTowerDreamTeamPanel:setData(  )
	self:setRankData()
	local item_id = Config.HolidayLostTowerData.data_constant["likes_item"].val[1][1]
	local res = PathTool.getItemRes(item_id)
	loadSpriteTexture(self.item_img,res,LOADTEXT_TYPE)
	local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
	self.item_label:setString(num)
	self.upload_btn:setVisible(true)
	self:setSelfTeamData()
end
function ActionLostTowerDreamTeamPanel:updatePage_num(status)
	if status then
		self.page_num = self.page_num + 1
	else
		self.page_num = self.page_num - 1
	end
	self:updatePageImg()
	if self.page_num >= 1 and self.page_num <= self.total_page then
		controller:sender21906(ActionRankCommonType.LostTower,self.page_num)
	end
end
function ActionLostTowerDreamTeamPanel:updatePageImg( )
	if self.page_num <= 1 then
		self.left_img:setVisible(false)
	else
		self.left_img:setVisible(true)
	end
	if self.page_num >= self.total_page then
		self.right_img:setVisible(false)
	else
		self.right_img:setVisible(true)
	end
end
function ActionLostTowerDreamTeamPanel:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.upload_btn, handler(self, self._onClickBtnupload_btn), false, 2)
	registerButtonEventListener(self.left_img, function()
        self:updatePage_num(false)
	end, true)
    registerButtonEventListener(self.right_img, function()
        self:updatePage_num(true)
	end, true)
	if not self.lostTowerDreamTeamRankData then
        self.lostTowerDreamTeamRankData = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerDreamTeamRankData,function(data)
            if not data then return end
			self.page_num = data.now_page
			self.total_page = data.total_page
			self.page_txt:setString(data.now_page.."/"..data.total_page)
			if self.total_page <= 1 then
				self.page_txt:setVisible(false)
				self.left_img:setVisible(false)
				self.right_img:setVisible(false)
			else
				self.page_txt:setVisible(true)
				self.left_img:setVisible(true)
				self.right_img:setVisible(true)
			end
			self:updatePageImg()
			self.dreamTeam_data = data.team_info
			self:setRankData()
            -- self:setData(data)
        end
        )
    end
	if not self.LostTowerSelfDreamTeamData then
        self.LostTowerSelfDreamTeamData = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerSelfDreamTeamData,function(data)
            if not data then return end
            -- self:setData(data)
			self.own_dreamTeam_data = data
			local date = {}
			for key, value in pairs(self.own_dreamTeam_data.pos_info) do
				local list = {}
				list = value
				date[value.pos] = list
			end
			self.own_dreamTeam_data.pos_info = date
			local role_vo = RoleController:getInstance():getRoleVo()
			self.own_dreamTeam_data.id = role_vo.rid
			self.own_dreamTeam_data.srv_id = role_vo.srv_id
			self.own_dreamTeam_data.name = role_vo.name
			self.own_dreamTeam_data.lev = role_vo.lev
			self.own_dreamTeam_data.face = role_vo.face_id
			self.own_dreamTeam_data.face_update_time = role_vo.face_update_time
			self.own_dreamTeam_data.face_file = role_vo.face_file
			self.own_dreamTeam_data.avatar_id = role_vo.avatar_base_id
			self:setSelfTeamData()
        end
        )
    end
	
	-- 道具数量更新
    self:addGlobalEvent(BackpackEvent.ADD_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.DELETE_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
end

function ActionLostTowerDreamTeamPanel:refreshExchangeItemNum( bag_code, data_list )
	if bag_code == BackPackConst.Bag_Code.BACKPACK then
		local item_id = Config.HolidayLostTowerData.data_constant["likes_item"].val[1][1]
		for i,v in pairs(data_list) do 
			if v and v.base_id and item_id == v.base_id then 
				local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
				self.item_label:setString(num)
			end
		end
	end
end

function ActionLostTowerDreamTeamPanel:_onClickBtnupload_btn(  )
	local data = model:getLostTowerData()
	local action_data = controller:getActionSubTabVo(ActionRankCommonType.LostTower)
	self.camp_id = action_data.camp_id
	local cfg = Config.HolidayLostTowerData.data_lv_info[self.camp_id]
	if data and data.is_send == 0 and data.stage == cfg[#cfg].lv then
		HeroController:getInstance():openFormGoFightPanel(true,PartnerConst.Fun_Form.LostTowerDreamTeam,{},HeroConst.FormShowType.eFormSave)
	else
		message(TI18N("语言_c_5836"))
	end
end
function ActionLostTowerDreamTeamPanel:_onClickBtnClose(  )
	controller:openActionLostTowerDreamTeamPanel(false)
end

function ActionLostTowerDreamTeamPanel:close_callback(  )
	controller:openActionLostTowerDreamTeamPanel(false)
	
    if self.lostTowerDreamTeamRankData then
        GlobalEvent:getInstance():UnBind(self.lostTowerDreamTeamRankData)
        self.lostTowerDreamTeamRankData = nil
    end
	if self.LostTowerSelfDreamTeamData then
        GlobalEvent:getInstance():UnBind(self.LostTowerSelfDreamTeamData)
        self.LostTowerSelfDreamTeamData = nil
    end
	self.own_dreamTeam_data = {}
	self.dreamTeam_data = {}
end

-----------------------------------@ 奖励item
ActionLostTowerDreamTeamItem = class("ActionLostTowerDreamTeamItem", function()
    return ccui.Widget:create()
end)

function ActionLostTowerDreamTeamItem:ctor()
    self.cell_width = 119*0.6
	--9个位置
    self.nine_position = {
        [1] = cc.p(self.cell_width * 2.5 + 7, self.cell_width * 0.5 + 8),
        [2] = cc.p(self.cell_width * 2.5 + 7, self.cell_width * 1.5 + 8),
        [3] = cc.p(self.cell_width * 2.5 + 7, self.cell_width * 2.5 + 8),
        [4] = cc.p(self.cell_width * 1.5 + 7, self.cell_width * 0.5 + 8),
        [5] = cc.p(self.cell_width * 1.5 + 7, self.cell_width * 1.5 + 8),
        [6] = cc.p(self.cell_width * 1.5 + 7, self.cell_width * 2.5 + 8),
        [7] = cc.p(self.cell_width * 0.5 + 7, self.cell_width * 0.5 + 8),
        [8] = cc.p(self.cell_width * 0.5 + 7, self.cell_width * 1.5 + 8),
        [9] = cc.p(self.cell_width * 0.5 + 7, self.cell_width * 2.5 + 8),
    }
    self.hero_item_list = {}
    self.four_blank_img = {}
    -- 精灵
    self.elfin_item_list = {}
	self:configUI()
	self:register_event()
end

function ActionLostTowerDreamTeamItem:configUI(  )
	self.size = cc.size(588,250)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("action/action_lost_tower_dream_team_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("main_container")
    self.container = container
	self.head_panel= self.container:getChildByName("head_panel")
	self.head_panel:setSwallowTouches(false)
	self.head = PlayerHead.new(PlayerHead.type.circle)
	self.head:setPosition(60, 60)
	self.head_panel:addChild(self.head)
	self.head:setSwallowTouches(false)
	self.my_name_label= self.container:getChildByName("my_name_label")
	setTextMaxWidth(self.my_name_label,130,-10)
	self.top_fight= self.container:getChildByName("top_fight")
	local pos = {2,4,6,7,9,1}--一开始默认 第一个阵法位置
    for index=1,6 do
		if not self.hero_item_list[index] then
			self.hero_item_list[index] = HeroExhibitionItem.new(0.6, false)
		end
        self.hero_item_list[index]:setPosition(self.nine_position[pos[index]])
        self.top_fight:addChild(self.hero_item_list[index])
		self.hero_item_list[index]:setSwallowTouches(false)
    end
	for i=1,3 do
        self.four_blank_img[i] = self.top_fight:getChildByName("hero_info_21_"..i) 
    end
	self.like_btn= self.container:getChildByName("like_btn")
	self.like_sprite= self.like_btn:getChildByName("like_sprite")
	self.like_txt= self.like_btn:getChildByName("like_txt")
	self.equip_btn= self.container:getChildByName("equip_btn")
    local size = self.equip_btn:getContentSize()
    self.hallows_item = BackPackItem.new(false, false, false, 0.8)
    self.hallows_item:showAddIcon(true)
    self.hallows_item:setPosition(cc.p(size.width * 0.5, size.height * 0.5))
    self.equip_btn:addChild(self.hallows_item)
	self.hallows_item:setSwallowTouches(false)
	self.equip_btn:setSwallowTouches(false)
	self.equip_txt= self.equip_btn:getChildByName("label")
	self.elfin_btn= self.container:getChildByName("elfin_btn")
	self.elfin_btn:setSwallowTouches(false)
	self.sp_btn= self.container:getChildByName("sp_btn")
	self.sp_skill= self.sp_btn:getChildByName("sp_skill")
	self.sp_txt= self.sp_btn:getChildByName("label")
    self.sp_txt:setString(TI18N("语言_c_6756"))
    if not HeroController:getInstance():getModel():getSpecialHeroHuanShield() then
        if self.sp_btn then
            self.sp_btn:setVisible(false)
        end
    end
end

function ActionLostTowerDreamTeamItem:register_event(  )
	for key, value in pairs(self.hero_item_list) do
		registerButtonEventListener(value, function()
			if value:getData() and value:getData().bid then
				local library_config = Config.PartnerData.data_partner_library(value:getData().bid)
				local cfg = Config.PartnerData.data_partner_base[value:getData().bid]
				if cfg and cfg.draw_res and cfg.draw_res ~= "" and library_config then
					--有立绘的 并且有配置图书馆的
					HeroController:getInstance():openHeroLibraryInfoWindow(true, value:getData().bid)
				else
					message(TI18N("语言_c_4384"))
					--没有立绘的 英雄详情
					local star = value:getData().star or 1
					HeroController:getInstance():openHeroInfoWindowByBidStar(value:getData().bid, star)
				end
			end
		end, true, 2,nil,0.6)
	end
	registerButtonEventListener(self.equip_btn, function()
		if self.data.formation_lev ~= 0 then
			local data = HallowsController:getInstance():getModel():makeHighestHallowVo(self.data.formation_lev)
			HallowsController:getInstance():openHallowsTips(true,data)
		end
	end, true, 2,nil,0.9)
	registerButtonEventListener(self.like_btn, function()
		local item_id = Config.HolidayLostTowerData.data_constant["likes_item"].val[1][1]
		local item_num = Config.HolidayLostTowerData.data_constant["likes_item"].val[1][2]
		local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
		-- if num >= item_num then
			controller:sender21909(ActionRankCommonType.LostTower,self.data.id,self.data.srv_id)
		-- else
		-- 	local item_config = Config.ItemData.data_get_data(item_id)
		-- 	BackpackController:getInstance():openTipsSource(true, item_config)
		-- end
	end, true, 2)
	
    registerButtonEventListener(self.sp_btn, handler(self, self.onClickSPBtn) ,true, 1)

	if not self.LostTowerDreamTeamRankLike then
        self.LostTowerDreamTeamRankLike = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerDreamTeamRankLike,function()
			local rid,srv_id = model:getLostTowerLikeRole()
			if self.data and self.data.id == rid and self.data.srv_id == srv_id then
				local like_num = self.like_txt:getString()
				local str = tonumber(like_num) + 1
				self.like_txt:setString(str)
			end
        end
        )
    end

	self.head:addCallBack(function()
		if self.data ~= nil then
			if self.data.srv_id ~= "" then
				FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.data.srv_id, rid = self.data.id})				
			end
		end
	end, false)
end

function ActionLostTowerDreamTeamItem:onClickSPBtn()
	local skill_vo = Config.SkillData.data_get_skill(self.sp_skill_id)
	if skill_vo then
		TipsManager:getInstance():showSkillTips(skill_vo)
	end
end

function ActionLostTowerDreamTeamItem:updateSpBtn(id)
    self.sp_skill_id = id
    if not self.mask then
        self.mask = createSprite(PathTool.getResFrame("form", "form_1002"), 40, 40, nil, cc.p(0.5, 0.5))--模板
        self.mask:setScale(self.mask_scale or 1)
    end
    if not self.clipNode then
        self.clipNode = cc.ClippingNode:create(self.mask)
        self.clipNode:setAnchorPoint(cc.p(0.5,0.5))
        self.clipNode:setContentSize(cc.size(80,80))
        self.clipNode:setCascadeOpacityEnabled(true)
        self.clipNode:setPosition(0,0)
        self.clipNode:setAlphaThreshold(0)
        self.sp_skill:addChild(self.clipNode,2)
    end
    if not self.sp_icon then
        self.sp_icon = ccui.ImageView:create()
        self.sp_icon:setCascadeOpacityEnabled(true)
        self.sp_icon:setAnchorPoint(0.5,0.5)
        self.sp_icon:setPosition(40,40)--底板
        self.clipNode:addChild(self.sp_icon,1)
        self.sp_icon:setScale(0.75)
    end
    local skill_config = Config.SkillData.data_get_skill(id)
    if skill_config then
        local skill_icon = PathTool.getSkillRes(skill_config.icon, false)
        self.sp_icon:loadTexture(skill_icon, LOADTEXT_TYPE)
        self.sp_icon:setVisible(true)
    else
        self.sp_icon:setVisible(false)
    end
end

function ActionLostTowerDreamTeamItem:setData( data )
	self.data = data
	self.like_txt:setString(self.data.like_num)
	self.my_name_label:setString(self.data.name)
	self.head:setHeadRes(self.data.face,false, LOADTEXT_TYPE, self.data.face_file, self.data.face_update_time)
	self.head:setLev(self.data.lev)
	local vo = Config.AvatarData.data_avatar[self.data.avatar_bid]
	if vo then
		local res_id = vo.res_id or 1
		local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
		self.head:showBg(res, nil, false, vo.offy)
	end
	local formation_config = Config.FormationData.data_six_form_data[self.data.formation_type]
    if formation_config then
        self:initFormationData(formation_config)
    end
	local id = 0
	if data.sp_skill and next(data.sp_skill) then
		for i,v in pairs(data.sp_skill) do
			id = v.skill_bid
		end
	end
	self:updateSpBtn(id)
end

function ActionLostTowerDreamTeamItem:initFormationData(formation_config)
	if not formation_config then return end
	local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
	local width = self.cell_width - 10
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        -- self.dic_index_pos[index] = pos
        dic_pos_index[pos] = index
        -- self:updatePosItemByIndex(pos, index)
        --更新位置
        if self.hero_item_list[index] then
            self.hero_item_list[index]:setPosition(self.nine_position[pos])
        end
        if pos <= 3 then
            self.pos_name_list[index] = 1 --位置 前
        elseif pos > 3 and pos <= 6 then
            self.pos_name_list[index] = 2 --位置 中
        else
            self.pos_name_list[index] = 3 --位置 后
        end

        local x = self.nine_position[pos].x
        local y = self.nine_position[pos].y
        local rect = cc.rect( x - width*0.6 ,y - width*0.6 , width, width)
        self.pos_rect_list[index] = rect
		local cfg = self.data.pos_info[index] and Config.PartnerData.data_partner_base[self.data.pos_info[index].bid] 
		if cfg then
			local hero_vo = HeroVo.New()
			local data = {}
			data.bid = cfg.bid
			data.lev = self.data.pos_info[index].lv
			data.break_lev = 6
			data.flag = 0
			data.partner_id = cfg.bid
			data.star = self.data.pos_info[index].start
			data.camp_type = cfg.camp_type
			hero_vo:updateHeroVo(data)
			self.hero_item_list[index]:setData(hero_vo)
		else
			self.hero_item_list[index]:setData()
		end
    end
	local subscript = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img[subscript]:setPosition(self.nine_position[pos])
            subscript = subscript + 1
            if subscript > 3 then
                break
            end
        end
    end
	--神器
	local hallows_config = Config.HallowsData.data_base[self.data.formation_lev]
	if hallows_config then
		self.hallows_item:setBaseData(hallows_config.item_id)
		self.hallows_item:setMagicIcon(false)
        self.hallows_item:showAddIcon(false)
	end
	--通灵兽
	local elfin_bid_list = self.data.elfin_data
	local function getElfinBidByPos( pos )
        local elfin_bid
        for k,v in pairs(elfin_bid_list) do
            if v.pos == pos then
                elfin_bid = v.item_bid
                break
            end
        end
        return elfin_bid
    end
	for i=1,4 do
        local elfin_bid = getElfinBidByPos(i)
        local elfin_item = self.elfin_item_list[i]
        if elfin_item == nil then
            elfin_item = SkillItem.new(true, true, true, 0.4)
            local pos_x = 24.3
            local pos_y = 72.5
            if i == 3 or i == 4 then
                pos_y = 24.3
            end
            if i == 2 or i == 4 then
                pos_x = 72.5
            end
            elfin_item:setPosition(cc.p(pos_x, pos_y))
            self.elfin_btn:addChild(elfin_item)
			elfin_item:setSwallowTouches(false)
            self.elfin_item_list[i] = elfin_item
        end
		local bid = elfin_bid or 0
		elfin_item:showLockIcon(false)
		local elfin_cfg = Config.SpriteData.data_elfin_data(bid)
		if bid == 0 or not elfin_cfg then -- 已解锁，但未放置精灵
			elfin_item:setData()
		else
			local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
			if skill_cfg then
				elfin_item:setData(skill_cfg)
			end
		end
    end
end
function ActionLostTowerDreamTeamItem:DeleteMe(  )
	if self.head then
		self.head:DeleteMe()
		self.head = nil
	end
	if self.hallows_item then
        self.hallows_item:DeleteMe()
        self.hallows_item = nil
    end
	if self.LostTowerDreamTeamRankLike then
        GlobalEvent:getInstance():UnBind(self.LostTowerDreamTeamRankLike)
        self.LostTowerDreamTeamRankLike = nil
    end
	self.hero_item_list = {}
    self.four_blank_img = {}
    -- 精灵
    self.elfin_item_list = {}
end