    self.challenger_panel = self.main_container:getChildByName("challenger_panel")
    self.opponent_panel_1 = self.challenger_panel:getChildByName("opponent_panel_1")
    self.opponent_bg = self.opponent_panel_1:getChildByName("opponent_bg")
    self.opponent_base = self.opponent_panel_1:getChildByName("opponent_base")
    self.opponent_model = self.opponent_panel_1:getChildByName("opponent_model")
    self.opponent_name = self.opponent_panel_1:getChildByName("opponent_name")
    self.opponent_power_bg = self.opponent_panel_1:getChildByName("opponent_power_bg")
    self.opponent_power_icon = self.opponent_panel_1:getChildByName("opponent_power_icon")
    self.opponent_power = self.opponent_panel_1:getChildByName("opponent_power")
    self.vacant_position_txt = self.opponent_panel_1:getChildByName("vacant_position_txt")
    self.vacant_position_txt:setString(TI18N("语言_c_526"))
    setTextMaxWidth(self.vacant_position_txt,110,-10)
    self.challenger_panel:setVisible(false)
    self.switch_btn = self.main_container:getChildByName("switch_btn")
    self.switch_txt = self.main_container:getChildByName("switch_txt")
    self.switch_txt:setString(TI18N("语言_c_5930"))
    self.switch_txt:setPositionX(712 - self.switch_txt:getContentSize().width/2)
    self.switch_btn:setPositionX(712 - self.switch_txt:getContentSize().width/2)
    self.bottome_panel = self.main_container:getChildByName("bottome_panel")
    self.bottom_bg = self.bottome_panel:getChildByName("bottom_bg")
    self.reward_btn = self.bottome_panel:getChildByName("reward_btn")
    self.reward_txt = self.reward_btn:getChildByName("reward_txt")
    self.reward_txt:setString(TI18N("语言_c_21"))
    setTextMaxWidth(self.reward_txt,86,-10)
    self.now_bg = self.bottome_panel:getChildByName("now_bg")
    self.now_txt = self.bottome_panel:getChildByName("now_txt")
    self.now_txt:setString(TI18N("语言_c_1294"))
    self.now_bg:setContentSize(cc.size(self.now_txt:getContentSize().width + 50,self.now_bg:getContentSize().height))
    self.now_rank = self.bottome_panel:getChildByName("now_rank")
    setTextMaxWidth(self.reset_txt,110)
    self.settlement_txt = self.bottome_panel:getChildByName("settlement_txt")
    self.settlement_txt:setString(TI18N("语言_c_5828"))
    self.settlement_value = self.bottome_panel:getChildByName("settlement_value")
    local day_time = self:getRemainingTime()
    controller:getModel():setCountDownTime(self.settlement_value,day_time or 0)
    self:settlementPos()
    self.next_txt = createRichLabel(20,cc.c4b(0xff,0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(400,85),-10,nil,340)
    self.next_txt:setHorizontalLayoutType(2)
    self.bottome_panel:addChild(self.next_txt)
    self.next_txt:setString("")
    self.result_panel = self.bottome_panel:getChildByName("result_panel")
    for i=1,5 do
        local result = self.result_panel:getChildByName("result_"..i)
        self.result_list[i] = result
    end
    self.challenge_txt = self.bottome_panel:getChildByName("challenge_txt")
    self.challenge_txt:setString(TI18N("语言_c_92"))
    self.challenge_bg = self.bottome_panel:getChildByName("challenge_bg")
    self.challenge_value = self.bottome_panel:getChildByName("challenge_value")
    controller:sender21900(self.holiday_bid)
end
function ActionLostTowerPanel:settlementPos()
    local _w = self.settlement_txt:getContentSize().width + self.settlement_value:getContentSize().width + 20
    self.settlement_txt:setPositionX((720 - _w)/2 + 40)
    self.settlement_value:setPositionX(self.settlement_txt:getPositionX() + self.settlement_txt:getContentSize().width+10)
end
function ActionLostTowerPanel:getRemainingTime()
    local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
    local day_time = TimeTool.getOneDayLessTimeServer(GameNet:getInstance():getTime(),timezone)
    local cfg = Config.HolidayLostTowerData.data_constant["settlement_time"].val
    local secondNum = (23 - cfg[1]) * 3600 + (59 - cfg[2]) * 60 + (60 - cfg[3])
    return day_time - secondNum
end
function ActionLostTowerPanel:setEnemyPanel(list)
    if #list == 0 then
        self.first_btn:setVisible(true)
    else
        self.first_btn:setVisible(false)
    end
    for i=1,3 do
        local data = list[i]
        local station_item = self.opponent_list[i]
        if data then
            station_item:setVisible(true)
            if self.stage_data and self.stage >= #self.stage_data then
                local role_vo = RoleController:getInstance():getRoleVo()
                self:updateSpine(role_vo.look_id,i)
                if not station_item then return end
                station_item.opponent_name:setString(string.format("[%s]%s", getServerName(role_vo.srv_id),role_vo.name))
                setTextMaxWidth(station_item.opponent_name,160,-10)
                station_item.opponent_power:setString(MoneyTool.moneyFormat(role_vo.power))
                if self.data.use_num >= 1 then
                    setChildUnEnabled(false,station_item.challenge_btn)
                    station_item:setTouchEnabled(true)
                    station_item.challenge_btn:setTouchEnabled(true)
                else
                    setChildUnEnabled(true,station_item.challenge_btn)
                    station_item:setTouchEnabled(false)
                    station_item.challenge_btn:setTouchEnabled(false)
                end
            else
                self:updateSpine(data.look_id,i)
                if not station_item then return end
                station_item.opponent_name:setString(string.format("[%s]%s", getServerName(data.srv_id),data.name))
                setTextMaxWidth(station_item.opponent_name,160,-10)
                station_item.opponent_power:setString(MoneyTool.moneyFormat(data.power))
                if data.challenge_status == 0 then
                    setChildUnEnabled(false,station_item.challenge_btn)
                    station_item:setTouchEnabled(true)
                    station_item.challenge_btn:setTouchEnabled(true)
                else
                    setChildUnEnabled(true,station_item.challenge_btn)
                    station_item:setTouchEnabled(false)
                    station_item.challenge_btn:setTouchEnabled(false)
                end
            end
        else
            station_item:setVisible(false)
        end
    end
end

--更新模型,也是初始化模型
function ActionLostTowerPanel:updateSpine(look_id, pos_index)
    local station_item = self.opponent_list[pos_index]
    if not station_item then return end
    local fashion_id =  0
    local fun = function()
        if not station_item.spine then
            if look_id == 0 then
                look_id = 500001
            end
            station_item.spine = BaseRole.new(BaseRole.type.role, look_id)
            station_item.spine:setAnimation(0,PlayerAction.show,true) 
            station_item.spine:setCascade(true)
            station_item.spine:setPosition(cc.p(100,220))
            station_item.spine:setAnchorPoint(cc.p(0.5,0.5)) 
            station_item.spine:setScale(0.8)
            station_item.opponent_model:addChild(station_item.spine) 
            station_item.spine:setCascade(true)
            station_item.spine:setOpacity(0)
            local action = cc.FadeIn:create(0.2)
            station_item.spine:runAction(action)
        end
    end
    if station_item.spine then
        station_item.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        station_item.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
            doStopAllActions(station_item.spine)
            station_item.spine:removeFromParent()
            station_item.spine = nil
            fun()
        end)))
    else
        fun()
    end
end

