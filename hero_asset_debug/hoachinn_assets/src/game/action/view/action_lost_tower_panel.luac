        station_item.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        station_item.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
            doStopAllActions(station_item.spine)
            station_item.spine:removeFromParent()
            station_item.spine = nil
            fun()
        end)))
    else
        fun()
    end
end

function ActionLostTowerPanel:register_event()
    if self.btn_rule then
		self.btn_rule:addTouchEventListener(function( sender,event_type )
            if event_type == ccui.TouchEventType.ended then
                MainuiController:getInstance():openCommonExplainView(true, Config.HolidayLostTowerData.data_desc_info,TI18N("语言_c_577"),false,true)
                -- playButtonSound2() 
                -- TipsManager:getInstance():showCommonTips(Config.HolidayClientData.data_constant["mouth_get_ninja_rules"].desc,sender:getTouchBeganPosition())
            end
        end)
    end
    registerButtonEventListener(self.first_btn, function()
        if self.data.use_num <= 0 then
            message(TI18N("语言_c_5928"))
            return
        end
        controller:sender21902(self.holiday_bid)
	end, true)
    registerButtonEventListener(self.sweep_btn, function()
        if self.data.use_num <= 0 then
            message(TI18N("语言_c_5831"))
            return 
        end
        local msg = TI18N("语言_c_5838")
        CommonAlert.show(msg,TI18N("语言_c_63"),function() 
            controller:sender21912(self.holiday_bid)
        end, TI18N("语言_c_62"))
	end, true)
    registerButtonEventListener(self.reward_btn, function()
        controller:openActionLostTowerRewardPanel(true)
	end, true)
    registerButtonEventListener(self.usageRate_btn, function()
        controller:openActionLostTowerUsageRatePanel(true)
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.dreamTeam_btn, function()
        controller:openActionLostTowerDreamTeamPanel(true)
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.formation_btn, function()
        HeroController:getInstance():openFormGoFightPanel(true,PartnerConst.Fun_Form.LostTowerDefensive,{},HeroConst.FormShowType.eFormSave)
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.shop_btn, function()
        JumpController:getInstance():jumpViewByEvtData({15, MallConst.MallType.LostTowerShop})
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.battleReport_btn, function()
        controller:openActionLostTowerBattleReportPanel(true)
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.switch_btn, function()
        self:onClickBtnSwitch()
	end, true)
    for i=1,3 do
        registerButtonEventListener(self.opponent_list[i], function()
            if self.stage_data then
                if self.stage < #self.stage_data then
                    local list = {}
                    if self.data and self.data.list and self.data.list[i] then
                        list.rid = self.data.list[i].rid
                        list.srv_id = self.data.list[i].srv_id
                    end
                    self:goWar(i,list)
                else
                    local msg = TI18N("语言_c_5838")
                    CommonAlert.show(msg,TI18N("语言_c_63"),function() 
                        controller:sender21912(self.holiday_bid)
                    end, TI18N("语言_c_62"))
                end
            end
        end, false)
        registerButtonEventListener(self.opponent_list[i].challenge_btn, function()
            if self:getRemainingTime() <= 0 then
                message(TI18N("语言_c_5925"))
                return
            end
            if self.stage_data then
                if self.stage < #self.stage_data then
                    local list = {}
                    if self.data and self.data.list and self.data.list[i] then
                        list.rid = self.data.list[i].rid
                        list.srv_id = self.data.list[i].srv_id
                    end
                    self:goWar(i,list)
                else
                    local msg = TI18N("语言_c_5838")
                    CommonAlert.show(msg,TI18N("语言_c_63"),function() 
                        controller:sender21912(self.holiday_bid)
                    end, TI18N("语言_c_62"))
                end
            else
                message(TI18N("语言_s_1409"))
            end
        end, false)
    end
    registerButtonEventListener(self.refresh_btn, function()
        -- print("刷新顶层人物")
        controller:sender21904(self.holiday_bid)
	end, true,nil,nil,0.9)
    registerButtonEventListener(self.reset_btn, function()
        if not self.data then return end
        if self.data.use_num <= 0 then
            message(TI18N("语言_c_5928"))
            return
        end
        local stage = self.data.stage
        local action_data = controller:getActionSubTabVo(ActionRankCommonType.LostTower)
        local camp_id = action_data.camp_id
        local stage_data = Config.HolidayLostTowerData.data_lv_info[self.camp_id]
        local free_num = self.data_constant["refresh_free_count"].val
        local charge_num = self.data_constant["refresh_charge_count"].val
        if stage >= #stage_data - 1 then
            controller:sender21902(self.holiday_bid)
        else
            if self.data.ref_num > 0 then
                local msg = string.format(TI18N("语言_c_5861"),self.data.ref_num,charge_num)
                CommonAlert.show(msg,TI18N("语言_c_63"),function() 
                    controller:sender21902(self.holiday_bid)
                end, TI18N("语言_c_62"),nil,CommonAlert.type.rich)
                return
            end
            if self.data.buy_num < self.data_constant["refresh_charge_count"].val then
                local msg = string.format(TI18N("语言_c_5829"),self.data_constant["refresh_price"].val[1][2],0,charge_num - self.data.buy_num)
                CommonAlert.show(msg,TI18N("语言_c_63"),function() 
                    controller:sender21903(self.holiday_bid,1)
                end, TI18N("语言_c_62"),nil,CommonAlert.type.rich)
                return
            end
            message(TI18N("语言_c_5894"))
        end
	end, true,nil,nil,0.9)

    if not self.lostTowerData then
        self.lostTowerData = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerData,function(data)
            if not data then return end
            self:setData(data)
        end
        )
    end

    if not self.LostTowerDreamTeamLookChallenger then
        self.LostTowerDreamTeamLookChallenger = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerDreamTeamLookChallenger,function(data)
            if not data then return end
            self.challenger_data = data
            if data.rid == 0 then
                self.opponent_name:setVisible(false)
                self.opponent_power_icon:setVisible(false)
                self.opponent_power:setVisible(false)
                self.opponent_power_bg:setVisible(false)
                self.vacant_position_txt:setVisible(true)
            else
                self.opponent_name:setVisible(true)
                
                self.opponent_name:setString(string.format("[%s]%s", getServerName(data.srv_id),data.name))
                setTextMaxWidth(self.opponent_name,160,-10)
                self.opponent_power_icon:setVisible(true)
                self.opponent_power:setVisible(true)
                self.opponent_power:setString(MoneyTool.moneyFormat(data.power))
                self.opponent_power_bg:setVisible(true)
                self.vacant_position_txt:setVisible(false)
                self:updateChallengerSpine(data.look_id)
            end
        end
        )
    end
end
function ActionLostTowerPanel:setData(data)
    if not data then return end
    local action_data = controller:getActionSubTabVo(ActionRankCommonType.LostTower)
    self.camp_id = action_data.camp_id
    self.stage_data = Config.HolidayLostTowerData.data_lv_info[self.camp_id]
    if not self.stage_data then return end
    if data.stage >= #self.stage_data - 1 then
        if tableLen(data.list) > 1 then
            local list_1 = {}
            list_1[1] = data.list[1]
            data.list = list_1
        end
    end
    self.next_txt:setString(TI18N("语言_c_5938"))
    self.data = data
    self.stage = data.stage
    if data.stage < tableLen(self.stage_data) - 1 then
        for key, value in pairs(self.stage_data) do
            if value.lv == data.stage + 1 then
                local stage_name = value.lv_name
                self.next_txt:setString(string.format(TI18N("语言_c_5929"),stage_name))
            end
        end
    end
    self.data_constant = Config.HolidayLostTowerData.data_constant
    self.challenge_value:setString(string.format("%s/%s",data.use_num,self.data_constant["challenges_count"].val))
    self:setEnemyPanel(data.list)
    for i=1,data.win_num do
        if self.result_list[i] then
            local res = PathTool.getResFrame("lost_tower","lost_tower_10")
            loadSpriteTexture(self.result_list[i],res,LOADTEXT_TYPE_PLIST)
        end
    end
    for i=6 - data.lose_num,5 do
        if self.result_list[i] then
            local res = PathTool.getResFrame("lost_tower","lost_tower_9")
            loadSpriteTexture(self.result_list[i],res,LOADTEXT_TYPE_PLIST)
        end
    end
    local res = PathTool.getResFrame("lost_tower","txt_cn_lost_tower_rank_"..data.stage)
    loadSpriteTexture(self.now_rank,res,LOADTEXT_TYPE_PLIST)
    if self.stage_data then
        if data.stage >= #self.stage_data - 1 then
            setChildUnEnabled(false,self.reset_btn)
            for key, value in pairs(self.result_list) do
                value:setVisible(false)
            end
            self.max_rank:setVisible(true)
            setTextMaxWidth(self.settlement_txt,160,-10)
            self.settlement_txt:setString(TI18N("语言_c_5828"))
            self:settlementPos()
            self.next_txt:setPositionY(65)
            self.switch_btn:setVisible(false)
            self.switch_txt:setVisible(false)
            for key, value in pairs(self.opponent_list) do
                value.challenge_txt:setString(TI18N("语言_c_1095"))
                value.challenge_btn:setPositionX(100)
                local res = PathTool.getResFrame("lost_tower","lost_tower_18")
                value.opponent_bg:setPositionY(487)
                loadSpriteTexture(value.opponent_bg, res, LOADTEXT_TYPE_PLIST)
                value.opponent_name:setPositionX(100)
                value.opponent_power_bg:setPositionX(100)
                value.opponent_power_icon:setPositionX(44)
                value.opponent_power:setPositionX(107)
            end
            self.is_Current = 2
            if data.stage >= #self.stage_data then
                self.sweep_btn:setVisible(false)
                for key, value in pairs(self.opponent_list) do
                    value.challenge_txt:setString(TI18N("语言_c_5830"))
                end
            else
                for key, value in pairs(self.opponent_list) do
                    value.challenge_txt:setString(TI18N("语言_c_1095"))
                    value.challenge_btn:setPositionX(-20)
                    self.sweep_btn:setVisible(true)
                end
            end
            local res = PathTool.getResFrame("lost_tower", Config.HolidayLostTowerData.data_constant["top_floor_background"].val)
            self.Image_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
        else
            if data.buy_num >= self.data_constant["refresh_charge_count"].val then
                setChildUnEnabled(true,self.reset_btn)
            else
                setChildUnEnabled(false,self.reset_btn)
            end
            for key, value in pairs(self.result_list) do
                value:setVisible(true)
            end
            self.sweep_btn:setVisible(false)
            self.max_rank:setVisible(false)
            self.next_txt:setPositionY(85)
            self.switch_btn:setVisible(true)
            self.switch_txt:setVisible(true)
            self.is_Current = 1
            for key, value in pairs(self.opponent_list) do
                value.challenge_txt:setString(TI18N("语言_c_1095"))
                local res = PathTool.getResFrame("lost_tower","lost_tower_13")
                value.opponent_bg:setPositionY(430)
                value.opponent_name:setPositionX(116)
                value.opponent_power_bg:setPositionX(115)
                value.opponent_power_icon:setPositionX(59)
                value.opponent_power:setPositionX(121)
                value.challenge_btn:setPositionX(100)
                loadSpriteTexture(value.opponent_bg, res, LOADTEXT_TYPE_PLIST)
            end
            local res = PathTool.getResFrame("lost_tower", Config.HolidayLostTowerData.data_constant["un_top_floor_background"].val)
            self.Image_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
        end
        self.reset_btn:setVisible(true)
        self.refresh_btn:setVisible(false)
        if data.stage >= #self.stage_data then
            self.reset_btn:setVisible(false)
            self.refresh_btn:setVisible(true)
        end
    end
end
function ActionLostTowerPanel:goWar(index,list)
    if self.data.use_num > 0 then
        controller:openActionLostTowerGoWarPanel(true,index,list)
    else
        message(TI18N("语言_c_5831"))
    end
end
function ActionLostTowerPanel:onClickBtnSwitch()
    if self.is_Current == 1 then -- 当前段位
        self.is_Current = 2
    else            --最高段位
        self.is_Current = 1
    end
    self:updatePage()
end
function ActionLostTowerPanel:updatePage()
    if self.is_Current == 1 then
        local res = PathTool.getResFrame("lost_tower", Config.HolidayLostTowerData.data_constant["un_top_floor_background"].val)
        self.Image_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
        self.challenger_panel:setVisible(false)
        self.enemy_panel:setVisible(true)
        self.refresh_btn:setVisible(false)
        self.reset_btn:setVisible(true)
        self.switch_txt:setString(TI18N("语言_c_5930"))
    else
        controller:sender21904(self.holiday_bid)
        local res = PathTool.getResFrame("lost_tower", Config.HolidayLostTowerData.data_constant["top_floor_background"].val)
        self.Image_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
        self.challenger_panel:setVisible(true)
        self.enemy_panel:setVisible(false)
        self.refresh_btn:setVisible(true)
        self.reset_btn:setVisible(false)
        self.switch_txt:setString(TI18N("语言_c_398"))
    end
end
function ActionLostTowerPanel:DeleteMe()
    for k,item in pairs(self.opponent_list) do
        if item.spine then
            item.spine:DeleteMe()
            item.spine = nil
        end
    end
    
    if self.lostTowerData then
        GlobalEvent:getInstance():UnBind(self.lostTowerData)
        self.lostTowerData = nil
    end
    if self.LostTowerDreamTeamLookChallenger then
        GlobalEvent:getInstance():UnBind(self.LostTowerDreamTeamLookChallenger)
        self.LostTowerDreamTeamLookChallenger = nil
    end
    
end