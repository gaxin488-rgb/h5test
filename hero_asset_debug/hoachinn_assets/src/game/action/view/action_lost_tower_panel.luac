        opponent_panel.opponent_name = opponent_panel:getChildByName("opponent_name")
        opponent_panel.opponent_power_bg = opponent_panel:getChildByName("opponent_power_bg")
        opponent_panel.opponent_power_icon = opponent_panel:getChildByName("opponent_power_icon")
        opponent_panel.opponent_power = opponent_panel:getChildByName("opponent_power")
        opponent_panel.challenge_btn = opponent_panel:getChildByName("challenge_btn")
        opponent_panel.challenge_txt = opponent_panel.challenge_btn:getChildByName("challenge_txt")
