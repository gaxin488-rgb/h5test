ActionLostTowerPanel = class("ActionLostTowerPanel", function()
	return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionLostTowerPanel:ctor(bid,id,remain_sec)
    self.remain_sec = remain_sec
    self.holiday_bid = bid
    self.result_list = {}
    self.opponent_list = {}
    self.challenger_data = {}
    self.is_Current = 1
	self:configUI()
    self:register_event()
end

function ActionLostTowerPanel:configUI()
    MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.LostTower)

	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_lost_tower_panel"))
	self.root_wnd:setPosition(-40,-70)
	self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setAnchorPoint(0, 0)
	
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.image_title = self.main_container:getChildByName("image_title")
    self.image_tip = self.main_container:getChildByName("image_tip")
    self.image_tip:setString(TI18N("语言_c_5823"))
    self.surplus_txt = self.main_container:getChildByName("surplus_txt")
    self.surplus_txt:setString(TI18N("语言_c_13"))
    self.surplus_time = self.main_container:getChildByName("surplus_time")
    self.surplus_time:setPositionX(self.surplus_txt:getPositionX() + self.surplus_txt:getContentSize().width)
    controller:getModel():setCountDownTime(self.surplus_time,self.remain_sec or 0)
    self.btn_rule = self.main_container:getChildByName("btn_rule")
    self.Image_bg = self.main_container:getChildByName("Image_bg")
    self.reset_btn = self.main_container:getChildByName("reset_btn")
    self.reset_txt = self.reset_btn:getChildByName("reset_txt")
    self.reset_txt:setString(TI18N("语言_c_5827"))
    setTextMaxWidth(self.reset_txt,86,-10)
    self.refresh_btn = self.main_container:getChildByName("refresh_btn")
    self.refresh_txt = self.refresh_btn:getChildByName("refresh_txt")
    self.refresh_txt:setString(TI18N("语言_c_5827"))
    setTextMaxWidth(self.refresh_txt,86,-10)
    self.refresh_btn:setVisible(false)
    self.usageRate_btn = self.main_container:getChildByName("usageRate_btn")
    self.usageRate_txt = self.usageRate_btn:getChildByName("usageRate_txt")
    self.usageRate_txt:setString(TI18N("语言_c_5824"))
    setTextMaxWidth(self.usageRate_txt,86,-10)
    self.dreamTeam_btn = self.main_container:getChildByName("dreamTeam_btn")
    self.dreamTeam_txt = self.dreamTeam_btn:getChildByName("dreamTeam_txt")
    self.dreamTeam_txt:setString(TI18N("语言_c_5825"))
    setTextMaxWidth(self.dreamTeam_txt,86,-10)
    self.battleReport_btn = self.main_container:getChildByName("battleReport_btn")
    self.battleReport_txt = self.battleReport_btn:getChildByName("battleReport_txt")
    self.battleReport_txt:setString(TI18N("语言_c_2595"))
    setTextMaxWidth(self.battleReport_txt,86,-10)
    self.formation_btn = self.main_container:getChildByName("formation_btn")
    self.formation_txt = self.formation_btn:getChildByName("formation_txt")
    self.formation_txt:setString(TI18N("语言_c_5893"))
    setTextMaxWidth(self.formation_txt,86,-10)
    self.shop_btn = self.main_container:getChildByName("btn_shop")
    self.shop_txt = self.shop_btn:getChildByName("label")
    self.shop_txt:setString(TI18N("语言_c_2594"))
    setTextMaxWidth(self.shop_txt,86,-10)
    self.enemy_panel = self.main_container:getChildByName("enemy_panel")
    self.first_btn = self.enemy_panel:getChildByName("first_btn")
    self.first_txt = self.first_btn:getChildByName("first_txt")
    self.first_txt:setString(TI18N("语言_c_3918"))
    for i=1,3 do
        local opponent_panel = self.enemy_panel:getChildByName("opponent_panel_"..i)
        opponent_panel.opponent_bg = opponent_panel:getChildByName("opponent_bg")
