function ActionAskPicItem:setData(data)--1.题号 2.题目  3.资源名  4.spine名   5.音频名  6.是否有输入框  7.横竖屏幕
    self.btn_sound_1:setVisible(false)
    self.btn_sound_2:setVisible(false)
    self.btn_select_1:setVisible(false)
    self.btn_select_2:setVisible(false)
    self.btn_choose:setSelected(false)
    if data then
        self.data = data
        self.image_bg_1:setVisible(false)
        self.image_bg_2:setVisible(false)

        local question_name = self.data[2]
        -- local question_name = self.data[1].."."..self.data[2]
        local pic_id = self.data[3]
        local pic_res = PathTool.getPlistImgForDownLoad("bigbg/partnercard_library", "partnercard_library_" ..pic_id)
        local spine = self.data[4]
        local sound = self.data[5]
        self.btn_choose_name:setString(transformTextToShort(question_name,8))
        addEvt2showAllTextTips(self.btn_choose_name,question_name,8)
        if self.data[7] == 1 then
            self.image_bg_1:setVisible(true)
            local config_list = Config.PartnerData.data_partner_base or {}
            if config_list and config_list[pic_id] then
                local config_data = config_list[pic_id]
                if self.record_res_id == nil or self.record_res_id ~= pic_res then
                    self.record_res_id = pic_res
                    self.item_load = loadImageTextureFromCDN(self.hero_icon, pic_res, ResourcesType.single, self.item_load, 60)
                end
                --阵营
                local camp_res = PathTool.getHeroCampTypeIcon(config_data.camp_type)
                if self.record_camp_res == nil or self.record_camp_res ~= camp_res then
                    self.record_camp_res = camp_res 
                    self.camp_icon:loadTexture(camp_res,LOADTEXT_TYPE_PLIST)
                    -- loadSpriteTexture(self.camp_icon, camp_res, LOADTEXT_TYPE_PLIST)
                end
    
                --职业
                local hero_type = config_data.type or 4
                local res = PathTool.getPartnerTypeIcon(hero_type)
                if self.record_type_res == nil or  self.record_type_res ~= res then
                    self.record_type_res = res
                    self.profession_icon:loadTexture(res,LOADTEXT_TYPE_PLIST)
                    -- loadSpriteTexture(self.profession_icon, res, LOADTEXT_TYPE_PLIST)
                end
            end
            if spine and spine ~= 0 and spine ~= "0" then
                self.btn_select_1:setVisible(true)
            end
            if sound and sound ~= 0 then
                self.btn_sound_1:setVisible(true)
            end
        else
            self.image_bg_2:setVisible(true)
            self.image_bg_2:loadTexture(pic_res, LOADTEXT_TYPE)
            if spine and spine ~= 0 and spine~="0" then
                self.btn_select_2:setVisible(true)
            end
            if sound and sound ~= 0 then
                self.btn_sound_2:setVisible(true)
            end
        end
    end
end

function ActionAskPicItem:DeleteMe()
    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    if self.update_single_action_even_event then
        GlobalEvent:getInstance():UnBind(self.update_single_action_even_event)
        self.update_single_action_even_event = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end


