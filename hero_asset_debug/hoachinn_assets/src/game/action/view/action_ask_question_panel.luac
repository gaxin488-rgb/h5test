ActionAskQuestionPanel = class("ActionAskQuestionPanel", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = ActionController:getInstance():getModel()
local string_format = string.format

function ActionAskQuestionPanel:ctor(bid)
    self.current_id = 0
    self.holiday_bid = bid
    self.touch_btn = true
    self:configUI()
    self:register_event()
    controller:sender29400()
end

