    registerButtonEventListener(self.btn_sound_1, function(sender,event_type)
        local sound = self.data[5]
        playOtherSound(sound,AudioManager.AUDIO_TYPE.DUBBING)
    end, true, 1,nil,0.5)

    registerButtonEventListener(self.btn_sound_2, function(sender,event_type)
        local sound = self.data[5]
        playOtherSound(sound,AudioManager.AUDIO_TYPE.DUBBING)
    end, true, 1)

    registerButtonEventListener(self.btn_select_1, function(sender,event_type)
        local controller = ActionController:getInstance()
        local model = ActionController:getInstance():getModel()
        local spine = self.data[4]
        if spine and spine ~= 0 then
            controller:openAskQuestionTips(true,spine)
        end
