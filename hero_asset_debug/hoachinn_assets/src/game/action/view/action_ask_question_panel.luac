function ActionAskQuestionPanel:setPanelData()
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    local time = tab_vo.remain_sec or 0
    model:setCountDownTime(self.time_txt,time)
    self.tip1:setPositionX(self.time_txt:getPositionX() - self.time_txt:getContentSize().width - 10)
    -- self.time_label:setPosition(cc.p(493, 19))
        -- self.time_panel:setPositionX(self.time_label:getPositionX())
end

function ActionAskQuestionPanel:update(isMax)
    local isMax = isMax or false
    self.main_panel:setVisible(false)
    self.panel_1:setVisible(false)
    self.panel_2:setVisible(false)
    self.panel_3:setVisible(false)
    self.panel_max:setVisible(false)
    self.group_pro:setVisible(false)
    self.panel1_item_list:setVisible(false)
    self.panel1_2_item_list:setVisible(false)
    model:updateAskQuestionData(true)
    model:updateAskQuestionStr("")
    model:setAskQuestionChoose(false)
    if isMax == true then
        self.panel_max:setVisible(true)
        return
    end
    local _table_insert = table.insert 
    if self.config_data and self.group_id then
        local max_Page = self.config_data.num
        if self.current_id == 0 then
            for i, v in ipairs(self.config_data.reward) do
                local reward_id = v[1]
                if self["main_text_box_"..i] then
                    self["main_text_box_"..i]:setString(""..reward_id)
                end
            end
            self.main_panel:setVisible(true)
            self:setItemData(self.config_data)
            self.main_txt_desc:setString(self.config_data.desc)
        else
            self.group_pro:setVisible(true)
            local current_index = self.group_id .. "_" .. self.current_id
            self.config_question_data = Config.QuestionData.data_question_cfg[current_index]
            if self.config_question_data then
                local optype = tonumber(self.config_question_data.optype)
                if optype == 1 or optype == 3 or optype == 6 then
                    self.panel1_txt_page:setString(self.config_question_data.num .. "/" .. max_Page)
                    self.panel1_btn_go_label:setString(TI18N("语言_c_1322"))
                    self.panel_1:setVisible(true)
                    self.panel1_txt_title:setString(self.config_question_data.num.."."..self.config_question_data.question)
                    local quest_list = {}
                    for i, v in ipairs(self.config_question_data.answer) do
                        local quest_data = v
                        quest_data.min_num = self.config_question_data.min_num
                        quest_data.max_num = self.config_question_data.max_num
                        _table_insert(quest_list, quest_data)
                    end
                    if optype == 6 then
                        self.panel1_2_item_list:setVisible(true)
                        self.panel1_2_item_scrollview:setData(quest_list)
                    else
                        self.panel1_item_list:setVisible(true)
                        self.panel1_item_scrollview:setData(quest_list)
                    end
                elseif optype == 2 or optype == 5 then
                    self.panel2_txt_page:setString(self.config_question_data.num .. "/" .. max_Page)
                    self.panel_2:setVisible(true)
                    self.panel2_txt_title:setString(self.config_question_data.num.."."..self.config_question_data.question)
                    local quest_list = {}
                    for i, v in ipairs(self.config_question_data.answer) do
                        local quest_data = v
                        quest_data.min_num = self.config_question_data.min_num
                        quest_data.max_num = self.config_question_data.max_num
                        _table_insert(quest_list, quest_data)
                    end
                    self.panel2_item_scrollview:setData(quest_list)
                elseif optype == 4 then
                    self.panel3_txt_page:setString(self.config_question_data.num .. "/" .. max_Page)
                    self.panel_3:setVisible(true)
                    self.panel3_txt_title:setString(self.config_question_data.num.."."..self.config_question_data.question)
                end
                local cur_score = self.config_question_data.num
                local max_score = 0
                local cur_pro = 0 --当前处于第几阶段
                for i, v in ipairs(self.config_data.reward) do
                    local reward_id = v[1]
                    if cur_score <= reward_id then
                        max_score = reward_id
                        cur_pro = i
                        break
                    end
                end
                --percent = （当前题数-上阶段奖励题数-1）/（下阶段奖励题数-上阶段奖励题数）
                local pre_score = 0 -- 上阶段奖励题数
                local next_score =  self.reward_id_list[cur_pro]--下阶段奖励题数
                if cur_pro > 1 then
                    pre_score = self.reward_id_list[cur_pro-1]
                end
                if next_score then
                    local percent = ((cur_score - pre_score - 1)/(next_score - pre_score))*100
                    self.score_progress:setPercentage(percent)
                end
                self.score_label:setString(string.format("%d/%d", cur_score-1, max_score))
                local box_res_list = {"question_7","question_8","question_9"}
                local box_res = PathTool.getResFrame("question",box_res_list[cur_pro])
                self.box_icon:loadTexture(box_res, LOADTEXT_TYPE_PLIST)
            end
        end
    end
end

function ActionAskQuestionPanel:register_event()
    if not self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.AskQuestionUpdate, function(data)
            if self.config_data and self.config_question_data and self.config_question_data.num then
                local max_Page = self.config_data.num
                if self.config_question_data.num >= max_Page then 
                    self:update(true)
                    return
                end
                -- if #self.config_question_data.reward > 0 then
                --     message(TI18N("语言_c_6384"))
                -- end
            end
            self.current_id = self.current_id + 1
            self:update()
        end)
    end

    if not self.init_action_even_event then
        self.init_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.AskQuestionInitData, function(data)
            self.current_id = data.curr_qid
            if self.config_data then
                local max_Page = self.config_data.num
                if data.curr_qid < max_Page then 
                    self.main_btn_go_label:setString(TI18N("语言_c_6389"))
                    self.main_btn_go:setTouchEnabled(true)
                else
                    self.main_btn_go_label:setString(TI18N("语言_c_759"))
                    self.main_btn_go:setTouchEnabled(false)
                end
                local box_res_list = {"question_7","question_8","question_9"}
                local box_finish_res_list = {"question_16","question_17","question_18"}
                for i, v in ipairs(self.config_data.reward) do
                    local reward_id = v[1]
                    if self["main_box_"..i] then
                        local box_res = PathTool.getResFrame("question",box_res_list[i])
                        if self.current_id >= reward_id then
                            box_res = PathTool.getResFrame("question",box_finish_res_list[i])
                        end
                        self["main_box_"..i]:loadTexture(box_res, LOADTEXT_TYPE_PLIST)
                    end
                end
            end
        end)
    end

    registerButtonEventListener(self.main_btn_go, function()
        -- if self.current_id == 0 then
            self.current_id = self.current_id + 1
        -- end
        self:update()
    end, true, 1)

    registerButtonEventListener(self.score_btn, function()
        if self.config_question_data then
            local cur_score = self.config_question_data.num
            local reward_data = {}
            for i, v in ipairs(self.config_data.reward) do
                local reward_id = v[1]
                if cur_score <= reward_id then
                    reward_data.idx = i
                    reward_data.data = v
                    break
                end
            end
            controller:openAskQuestionRewardWindow(true,reward_data)
        end
    end, true, 1)

    registerButtonEventListener(self.panel1_btn_go, function()
        if self.config_question_data then
            local choose_num = #model.question_data
            if choose_num < self.config_question_data.min_num then
                message(TI18N("语言_c_6385"))
            else
                if model:getAskQuestionChoose() == true then
                    if model.question_str == "" then
                        message(TI18N("语言_c_6386"))
                    else
                        controller:sender29401(self.config_question_data.group_id,self.config_question_data.num,model.question_data,model.question_str)
                    end
                else
                    controller:sender29401(self.config_question_data.group_id,self.config_question_data.num,model.question_data,model.question_str)
                end
            end
        end
    end, true, 1)

    registerButtonEventListener(self.panel2_btn_go, function()
        if self.config_question_data then
            local choose_num = #model.question_data
            if choose_num < self.config_question_data.min_num then
                message(TI18N("语言_c_6385"))
            else
                controller:sender29401(self.config_question_data.group_id,self.config_question_data.num,model.question_data,model.question_str)
            end
        end
    end, true, 1)

    registerButtonEventListener(self.panel3_btn_go, function()
        local sign = self.edit_title:getText()
        -- if sign == "" then
        --     model:updateAskQuestionStr("")
        --     -- message(TI18N("语言_c_6386"))
        --     -- return
        -- end
        model:updateAskQuestionStr(sign)
        controller:sender29401(self.config_question_data.group_id,self.config_question_data.num,model.question_data,model.question_str)
    end, true, 1)

    registerButtonEventListener(self.main_box_1, function()
        local reward_data = {}
        reward_data.idx = 1
        reward_data.data = self.config_data.reward[1]
        controller:openAskQuestionRewardWindow(true,reward_data)
    end, true, 1)
    registerButtonEventListener(self.main_box_2, function()
        local reward_data = {}
        reward_data.idx = 2
        reward_data.data = self.config_data.reward[2]
        controller:openAskQuestionRewardWindow(true,reward_data)
    end, true, 1)
    registerButtonEventListener(self.main_box_3, function()
        local reward_data = {}
        reward_data.idx = 3
        reward_data.data = self.config_data.reward[3]
        controller:openAskQuestionRewardWindow(true,reward_data)
    end, true, 1)


    if not self.charge_data_event then
        self.charge_data_event = GlobalEvent:getInstance():Bind(ActionEvent.Is_Charge_Event, function(data)
            if data and data.status and data.charge_id then
                local charge_config = Config.ChargeData.data_charge_data[data.charge_id]
                if charge_config and data.status == 1 and data.charge_id == self.cur_charge_id then
                    sdkOnPay(charge_config.val, 1, charge_config.id, charge_config.name, charge_config.name)
                end
            end
        end)
    end
end

function ActionAskQuestionPanel:setItemData(data)
    if not data then
        return
    end
    self:loadRewardList(data.val)
end

function ActionAskQuestionPanel:loadRewardList(item_list)
    if tableLen(item_list) > 0 then
        self.item_scroll_view:setData(item_list)
        self.item_scroll_view:addEndCallBack(function()
            local list = self.item_scroll_view:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip()
                v:setSwallowTouches(false)
            end
        end)
    end
end

function ActionAskQuestionPanel:setVisibleStatus(bool)
    bool = bool or false
    self:setVisible(bool)
end

function ActionAskQuestionPanel:DeleteMe()
    doStopAllActions(self.txt_time_val)
    if self.send_num then
        self.send_num:DeleteMe()
        self.send_num = nil
    end
    if self.item_load then
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    -- if self.jump_load then 
    --     self.jump_load:DeleteMe()
    --     self.jump_load = nil
    -- end
    if self.item_scroll_view then
        self.item_scroll_view:DeleteMe()
        self.item_scroll_view = nil
    end
    if self.init_action_even_event ~= nil then
        GlobalTimeTicket:getInstance():remove(self.init_action_even_event)
        self.init_action_even_event = nil
    end
    if self.charge_data_event then
        GlobalEvent:getInstance():UnBind(self.charge_data_event)
        self.charge_data_event = nil
    end
    if self.update_action_even_event then
        GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    -- if self.update_single_action_even_event then
    --     GlobalEvent:getInstance():UnBind(self.update_single_action_even_event)
    --     self.update_single_action_even_event = nil
    -- end
end

ActionAskQuestionItem = class("ActionAskQuestionItem", function()
    return ccui.Widget:create()
end)

ActionAskQuestionItem.Width = 400
ActionAskQuestionItem.Height = 80

function ActionAskQuestionItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionAskQuestionItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_askplayer_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setContentSize(cc.size(ActionAskQuestionItem.Width, ActionAskQuestionItem.Height))
    self:setAnchorPoint(0, 0)

    self.container = self.root_wnd:getChildByName("container")
    self.container:setTouchEnabled(true)
    self.container:setSwallowTouches(false)

    self.btn_choose = self.container:getChildByName("btn_choose")
    self.btn_choose_name = self.container:getChildByName("btn_choose_name")
    self.btn_choose:setSelected(false)

    self.Image_21 = self.container:getChildByName("Image_21")

    local res = PathTool.getResFrame("common", "common_99998")
    self.edit_title = createEditBox(self.Image_21, res, cc.size(208, 30), nil, 20, cc.c4b(0x64,0x35,0x23,0xff), 20, "", nil, nil, LOADTEXT_TYPE_PLIST)
    self.edit_title:setAnchorPoint(cc.p(0, 0))
    self.edit_title:setPlaceholderFontColor(cc.c4b(0x64,0x35,0x23,0xff))
    self.edit_title:setFontColor(cc.c4b(0x64,0x35,0x23,0xff))
    self.edit_title:setPosition(cc.p(0, 0))
    local function editBoxTextEventHandle(strEventName,pSender)
        if strEventName == "return" or strEventName == "ended" then
            if self.data and self.data[6] and self.data[6] == 1 and not tolua.isnull(self.edit_title) then
                model:updateAskQuestionStr(self.edit_title:getText())
            end
        end
    end
    self.edit_title:registerScriptEditBoxHandler(editBoxTextEventHandle)
    -- self.edit_title:setMaxLength(Const_name_max)

end

function ActionAskQuestionItem:register_event()
    self.btn_choose:addEventListener(function(sender,event_type)
        if event_type == ccui.CheckBoxEventType.selected then
            playButtonSound2()
            local choose_num = #model.question_data
            if self.data.max_num == 1 then
                model:setAskQuestionChoose(false)
                if choose_num >= self.data.max_num then
                    model:updateAskQuestionData(true)
                end
                local data = {}
                data.id = self.data[1]
                data.is_select = true
                if self.data[6] == 1 then
                    model:setAskQuestionChoose(true)
                end
                model:updateAskQuestionData(false,data)
                self.btn_choose:setSelected(true) 
            else
                if choose_num >= self.data.max_num then
                    message(TI18N("语言_c_6388"))
                    self.btn_choose:setSelected(false)
                else
                    local data = {}
                    data.id = self.data[1]
                    data.is_select = true
                    if self.data[6] == 1 then
                        model:setAskQuestionChoose(true)
                    end
                    model:updateAskQuestionData(false,data)
                    self.btn_choose:setSelected(true)
                end 
            end
	    elseif event_type == ccui.CheckBoxEventType.unselected then 
            playButtonSound2()
            local data = {}
            data.id = self.data[1]
            data.is_select = false
            if self.data[6] == 1 then
                model:setAskQuestionChoose(false)
            end
            model:updateAskQuestionData(false,data)
            self.btn_choose:setSelected(false)
	    end
        -- local is_select = self.btn_choose:isSelected()
        -- if is_select then
        --     playButtonSound2()
        --     local choose_num = #model.question_data
        --     if choose_num >= self.data.max_num then
        --         message(TI18N("语言_c_6388"))
        --         self.btn_choose:setSelected(false)
        --     else
        --         local data = {}
        --         data.id = self.data[1]
        --         data.is_select = true
        --         if self.data[6] == 1 then
        --             model:setAskQuestionChoose(true)
        --         end
        --         model:updateAskQuestionData(false,data)
        --         self.btn_choose:setSelected(true)
        --     end 
	    -- else
        --     playButtonSound2()
        --     local data = {}
        --     data.id = self.data[1]
        --     data.is_select = false
        --     if self.data[6] == 1 then
        --         model:setAskQuestionChoose(false)
        --     end
        --     model:updateAskQuestionData(false,data)
        --     self.btn_choose:setSelected(false)
	    -- end
    end) 
    -- self.get_btn:addTouchEventListener(function(sender, event_type) 
    -- 	customClickAction_2(sender, event_type)
    -- 	if event_type == ccui.TouchEventType.ended then
    -- 		if self.data then
    -- 			controller:requestSubmitTask(self.data.id)
    -- 		end
    -- 	end
    -- end)
    if not self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.AskQuestionUpdate, function(data)
            if self.data and  self.data[6] and self.data[6] == 1 then
                self.edit_title:setPlaceHolder("")
                self.edit_title:setText("")
            end
        end)
    end

    if not self.update_single_action_even_event then
        self.update_single_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.AskQuestionUpdateSingle, function(data)
            if self.btn_choose then
                self.btn_choose:setSelected(false)
                for i, v in pairs(data) do
                    if v.index == self.data[1] then
                        self.btn_choose:setSelected(true)
                    end
                end
            end
        end)
    end
end

function ActionAskQuestionItem:setData(data)
    if data then
        self.data = data
        self.Image_21:setVisible(false)
        local question_name = self.data[2]
        self.btn_choose_name:setString(question_name)
        if self.data[6] and self.data[6] == 1 then
            self.Image_21:setVisible(true)
        end
    end
    self.btn_choose:setSelected(false)
end

function ActionAskQuestionItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
    if self.update_action_even_event then
        GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    if self.update_single_action_even_event then
        GlobalEvent:getInstance():UnBind(self.update_single_action_even_event)
        self.update_single_action_even_event = nil
    end
end

