ActionWarOrderAdvancedPanel = ActionWarOrderAdvancedPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local config = Config.HolidayGetninjaData
function ActionWarOrderAdvancedPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_war_order_advanced_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("neworderaction", "neworderaction_banner_1"), type = ResourcesType.single}
    }
end

function ActionWarOrderAdvancedPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2) 

    main_container:getChildByName("Text_3"):setString(TI18N("语言_c_741"))
    local text_bg = main_container:getChildByName("text_bg")
    local Text_3_0 = main_container:getChildByName("Text_3_0")
    Text_3_0:setString(TI18N("语言_c_2685"))
    Text_3_0:ignoreContentAdaptWithSize(true)
    Text_3_0:setTextAreaSize(cc.size(270,0))  
    setTextSpacing(Text_3_0,-6)
    text_bg:setContentSize(cc.size(500,20))
    local Text_3_1 = main_container:getChildByName("Text_3_1")
    Text_3_1:setString(TI18N("语言_c_4852"))
    Text_3_1:ignoreContentAdaptWithSize(true)
    Text_3_1:setTextAreaSize(cc.size(260,0))

    local label_lock = createRichLabel(22, cc.c4b(0x2b, 0x19, 0x5e, 0xff), cc.p(0.5, 0.5), cc.p(325, 136), -10, nil, 400)
    local str = string.format(TI18N("语言_c_4774"))
    label_lock:setString(str)
    main_container:addChild(label_lock)

    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_label = self.btn_change:getChildByName("Text_6")

    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    local image_bg = main_container:getChildByName("Sprite_1")
    -- local res = PathTool.getPlistImgForDownLoad("get_ninja", "getninjaorder_banner_1")
    if not self.image_bg_load then
        self.image_bg_load = loadSpriteTextureFromCDN(image_bg, res, ResourcesType.single, self.image_bg_load)
    end
    self.btn_close = main_container:getChildByName("btn_close")


    self:setData()
end

function ActionWarOrderAdvancedPanel:setData()
    local card_list = Config.HolidayGetninjaData.data_advance_card_list
    local period = model:getWarCampId()
    if card_list and card_list[period] then
        local data_list = card_list[period].reward or {}
        -- local data_list2 = card_list[period].reward_1 or {}
        -- for key, value in pairs(data_list2) do
        --     table.insert(data_list,value)
        -- end
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, data_list, setting)

        local data_list = card_list[period].reward_2 or {}
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, data_list, setting)

        local charge_list = Config.ChargeData.data_charge_data
        local charge_id = card_list[period].charge_id or nil
        if model:getChargeFlag() == 1 then
            setChildUnEnabled(true,self.btn_change)
            self.btn_change:setTouchEnabled(false)
            self.btn_change_label:setString(TI18N("语言_c_210"))
        else
            if charge_id and charge_list[charge_id] then
                self.btn_change_label:setString(string.format(TI18N("语言_c_4441"),MoneyTool.moneyFormat(GetMoneyNum(charge_list[charge_id],"val"))))
            end
        end
    end
end

function ActionWarOrderAdvancedPanel:register_event()
    registerButtonEventListener(
        self.background,
        function()
            controller:openActionwaradvanced(false)
        end,
        false,
        2
    )
    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openActionwaradvanced(false)
        end,
        true,
        2
    )

    registerButtonEventListener(
        self.btn_change,
        function()
            self:changeWarn()
        end,
        true,
        1
    )
    self:addGlobalEvent(ActionEvent.WarOrderAct, function()
        if model:getChargeFlag() == 1 then
            setChildUnEnabled(true,self.btn_change)
            self.btn_change:setTouchEnabled(false)
            self.btn_change_label:setString(TI18N("语言_c_210"))
        end
    end)
    self:addGlobalEvent(
        ActionEvent.Is_Charge_Event,
        function(data)
            if self.cur_charge_id and data and self.cur_charge_id == data.charge_id and data.status == 1 then
                local charge_list = Config.ChargeData.data_charge_data
                local card_list = config.data_advance_card_list
                local period = model:getWarCampId()
                if card_list and card_list[period] and card_list[period] then
                    local charge_id = card_list[period].charge_id or nil
                    if charge_id and charge_list[charge_id] then
                        sdkOnPay(charge_list[charge_id].val, 1, charge_list[charge_id].id, charge_list[charge_id].name)
                        -- self.btn_change_label:setString(TI18N("语言_c_210"))
                        -- setChildUnEnabled(true,self.btn_change)
                        -- self.btn_change:setTouchEnabled(false)
                    end
                end
            end
        end
    )
end

function ActionWarOrderAdvancedPanel:changeWarn()
    -- local day = model:getCurDay()
    local charge_list = Config.ChargeData.data_charge_data
    local card_list = Config.HolidayGetninjaData.data_advance_card_list
    local period = model:getWarCampId()
    if not period then
        return
    end
    if card_list and card_list[period] then
        local charge_id = card_list[period].charge_id or nil
        if charge_id and charge_list[charge_id] then
            self.cur_charge_id = charge_list[charge_id].id
            ActionController:getInstance():sender21016(self.cur_charge_id)
        end
    end
end
function ActionWarOrderAdvancedPanel:openRootWnd()
end
