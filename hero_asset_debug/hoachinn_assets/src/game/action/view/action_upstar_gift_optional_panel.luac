-- --------------------------------------------------------------------
ActionUpstarGiftOptionalItem = class("ActionUpstarGiftOptionalItem", function()
    return ccui.Widget:create()
end)

function ActionUpstarGiftOptionalItem:ctor(holiday_bid)
    self.holiday_bid = holiday_bid
    self:configUI()
    self:register_event()
end

function ActionUpstarGiftOptionalItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_upstar_gift_item"))
    self:addChild(self.root_wnd)
    -- self:setCascadeOpacityEnabled(true)
    -- self:setContentSize(cc.size(ActionUpstarGiftOptionalItem.Width,ActionUpstarGiftOptionalItem.Height))
    self:setAnchorPoint(0, 0)
    self:setContentSize(cc.size(690, 120))
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container:setTouchEnabled(true)
    self.main_container:setSwallowTouches(false)

    self.bg = self.main_container:getChildByName("bg")

    self.hero_layer = self.main_container:getChildByName("hero_layer")
    self.starbg = self.hero_layer:getChildByName("starbg")
    self.background = self.hero_layer:getChildByName("background")
    self.Panel_1 = self.starbg:getChildByName("Panel_1")
    self.star_num = self.Panel_1:getChildByName("star_num")
    setTextSpacing(self.star_num,-10)
    self.tempbg = self.hero_layer:getChildByName("Sprite_8")
    self.tempbg_b = self.hero_layer:getChildByName("Sprite_9")
    self.free_layer = self.main_container:getChildByName("free_layer")
    self.free_layer:setSwallowTouches(true)
    self.pic_has = self.main_container:getChildByName("pic_has")
    self.pic_has:setVisible(false)
    -- self.limit_label = self.main_container:getChildByName("limit_label")
    self.buy_img = self.main_container:getChildByName("buy_img")
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.get_btn_label = self.btn_get:getChildByName("Text_5")

    self.item_srcoller = self.main_container:getChildByName("goods_item")
    self.item_srcoller:setVisible(false)
    self.srcoll_con = self.main_container:getChildByName("goods_con")
    self.srcoll_con:setVisible(true)
    if self.item_scrollview == nil then
        local scroll_view_size = self.srcoll_con:getContentSize()
        local setting = {
            item_class = BackPackItem, -- 单元类
            start_x = 10, -- 第一个单元的X起点
            space_x = 6, -- x方向的间隔
            start_y = 4, -- 第一个单元的Y起点
            space_y = 0, -- y方向的间隔
            item_width = BackPackItem.Width * 0.7, -- 单元的尺寸width
            item_height = BackPackItem.Height * 0.7, -- 单元的尺寸height
            row = 1, -- 行数，作用于水平滚动类型
            col = 0, -- 列数，作用于垂直滚动类型
            scale = 0.7,
            is_backpack_item = true
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.srcoll_con, cc.p(0, 0), ScrollViewDir.horizontal,
                                   ScrollViewStartPos.top, scroll_view_size, setting)
        self.item_scrollview:setSwallowTouches(false)
    end
    if not self.head_icon then
        self.head_icon = createImage(self.hero_layer, nil, 42, 34, cc.p(0.5, 0.5), false, 1, false)
    end
end

function ActionUpstarGiftOptionalItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        if self.status then
            message(TI18N("语言_c_6769"))
            return
        end
        local charge_list = Config.ChargeData.data_charge_data
            local charge_id = self.data.cfg.charge_id or nil
            if charge_id and charge_list[charge_id] then
                local config = charge_list[charge_id]
                sdkOnPay(config.val, nil, config.id, config.name)
            end
	end, true)

    self.free_layer:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            local get_status = self.data.serverdata.status
            if get_status == 1 then
                controller:sender28318(self.holiday_bid)
            end
        end
    end)
    registerButtonEventListener(self.head_icon, function()
        if type(self.data.cfg.progress[2]) == "table" then
            HeroController:getInstance():openHeroLibraryInfoWindow(true, self.data.cfg.progress[2][1])
        else
            HeroController:getInstance():openHeroLibraryInfoWindow(true, self.data.cfg.progress[2])
        end
	end)
end

function ActionUpstarGiftOptionalItem:setData(data,is_last,status)
    if not data then return end
    if tolua.isnull(self.head_icon) then return end
    self.data = data
    self.status = status
    if self.holiday_bid == ActionRankCommonType.copyupstargift3 then
        loadSpriteTexture(self.starbg, PathTool.getResFrame("starplan", "starplan_16"), LOADTEXT_TYPE_PLIST)
        self.Panel_1:setPositionX(self.starbg:getContentSize().width*0.5)
        self.Panel_1:setContentSize(cc.size(self.starbg:getContentSize().width,200))
        self.star_num:setPositionX(self.starbg:getContentSize().width*0.5)
        self.star_num:setChangeScaleOffWidth(30)
    end
    -- 条件部分
    self.head_icon:setTouchEnabled(true)
    self.star_con = ccui.Widget:create()
    self.star_con:setZOrder(3)
    self.star_con:setPosition(cc.p(55,10))
    self.star_con:setSwallowTouches(false)
    self.head_icon:addChild(self.star_con)
    self.star_setting = model:createStar(data.cfg.progress[3],self.star_con,self.star_setting)
    if not self.head_icon_bg then 
		self.head_icon_bg = createImage(self.head_icon,PathTool.getResFrame("crossground","crossground_1002"), 0, 0, cc.p(0,0),true,9998,true)
		self.head_icon_bg:setCapInsets(cc.rect(14,14,1,1))
		self.head_icon_bg:setContentSize(cc.size(119,119))
        self.head_icon_bg:setTouchEnabled(false)
        self.head_icon_bg:setSwallowTouches(false)
	end
    -- self.star_num:setString(TI18N("语言_hol_sta_or_02_"..(data.cfg.progress[3] - 4)))
    self.star_num:setString(data.cfg.title)
    local hero_bid = 0
    if type(data.cfg.progress[2]) == "table" then
        hero_bid = data.cfg.progress[2][1]
    else
        hero_bid = data.cfg.progress[2]
    end
    self:setHeadImg(hero_bid)
    local score = HeroController:getInstance():getModel():heroBidScore(hero_bid)
    if score and type(score)=="number" and score >= 10 then
        self:setQualityImg(16)
    else
        self:setQualityImg(data.cfg.progress[3])
    end
    -- 免费部分
    addRedPointToNodeByStatus(self.free_layer, false, 8, 8)
    if not data or not data.serverdata or not data.serverdata.awards1 then return end
    local freeGiftData = data.serverdata.awards1
    if not self.freeItem then
        self.freeItem = BackPackItem.new(false, true, false, 0.7, false, true)
        self.freeItem:setPositionY(50)
        self.freeItem:setPositionX(50)
        self.free_layer:addChild(self.freeItem,0)
        local fun = function()
            message(TI18N("语言_c_g_329"))
        end
        self.freeItem:addBtnCallBack(fun)
    end
    if freeGiftData and freeGiftData[1] and freeGiftData[1].item_id and freeGiftData[1].item_count then
        self.freeItem:setBaseData(freeGiftData[1].item_id, freeGiftData[1].item_count)
        local fun = function()
            local cfg = Config.ItemData.data_get_data(freeGiftData[1].item_id)
            TipsManager:getInstance():showGoodsTips(cfg)
        end
        self.freeItem:addLongTimeTouchCallback(fun)
    end
    local get_status = false
    if data and data.serverdata and data.serverdata.status then
        get_status = data.serverdata.status
    end
    self.pic_has:setVisible(false)
    self.freeItem:setCommonStatus(false)
    self.freeItem:showOrderWarLock(false)
    -- self.freeItem:showOrderWarLockBg(false)
    if not tolua.isnull(self.freeItem) then
        if get_status == 2 then --已领取
            self.freeItem:setTouchEnabled(true)
            self.freeItem:setCommonStatus(true,nil, PathTool.getResFrame("actionpetard", "txt_cn_petard_get"))
        elseif get_status == 1 then--可领取
            addRedPointToNodeByStatus(self.free_layer, true, 8, 8)
            self.freeItem:setTouchEnabled(false)
            self.freeItem:setCommonStatus(true,0, PathTool.getResFrame("actioneightlogin", "txt_cn_eight_login_available"))
        else --不可领取
            self.freeItem:setTouchEnabled(true)
            self.freeItem:showOrderWarLock(true,nil,0.8)
            -- self.freeItem:showOrderWarLockBg(true)
        end
	end

    -- 付费购买部分
    local chargeId = data.cfg.charge_id
    local chargeCfg = Config.ChargeData.data_charge_data[chargeId]
    local price = string.format(TI18N("语言_c_4440"), (GetMoneyNum(chargeCfg, "val")))
    self.get_btn_label:setString(price)
    -- 限购
    local maxTimes = data.cfg.limit_buy
    local nowTimes = data.serverdata.count
    if not self.limit_label then
        self.limit_label = createRichLabel(20,cc.c4b(0x68,0x45,0x2a,0xff),cc.p(0.5,0),cc.p(607,10),-10)
        self.main_container:addChild(self.limit_label)
    end
    self.limit_label:setString(string.format(TI18N("语言_c_1468"), nowTimes, maxTimes))
    if data and data.serverdata and data.serverdata.count2 and data.serverdata.count2 >= maxTimes then
        self.limit_label:setVisible(false)
        if not self.tip_label then
            self.tip_label = createLabel(20,cc.c4b(0x68,0x45,0x2a,0xff),cc.c4b(0x68,0x45,0x2a,0xff),607,10,"",self.main_container,0,cc.p(0.5,0))
            self.tip_label:setChangeScaleOffWidth(550)
            self.tip_label:setLineSpacing(-10)
        end
        self.tip_label:setVisible(true)
        self.tip_label:setString(TI18N("语言_c_5404"))
    else
        if self.tip_label then
            self.tip_label:setVisible(false)
        end
        self.limit_label:setVisible(true)
    end
    local leftTimes = maxTimes - nowTimes
    
    if not tolua.isnull(self.btn_get) then
        if get_status ~= 0 then
            self.head_icon_bg:setVisible(false)
            self.tempbg:setVisible(true)
            self.tempbg_b:setVisible(false)
            if leftTimes <= 0 then -- 判断限购 
                self.btn_get:setTouchEnabled(false)
                -- setChildUnEnabled(true, self.btn_get)
                self.buy_img:setVisible(true)
                self.btn_get:setVisible(false)
            else
                self.buy_img:setVisible(false)
                self.btn_get:setVisible(true)
                self.btn_get:setTouchEnabled(true)
                setChildUnEnabled(false,self.btn_get)
            end
        else
            self.head_icon_bg:setVisible(true)
            self.tempbg:setVisible(false)
            self.tempbg_b:setVisible(true)
            self.buy_img:setVisible(false)
            self.btn_get:setVisible(true)
            if self.status then
                self.btn_get:setTouchEnabled(true)
            else
                self.btn_get:setTouchEnabled(false)
            end
            setChildUnEnabled(true, self.btn_get)
        end
    end
    if self.status then
        self.head_icon_bg:setVisible(true)
        setChildUnEnabled(true,self.btn_get)
        self.btn_get:setTouchEnabled(false)
    end
    -- if data.cfg.progress[3] >= max_lv then
    if data.cfg.id >= max_lv then
        self.tempbg:setVisible(false)
        self.tempbg_b:setVisible(false)
    end
    local list = {}
    for k, v in pairs(data.serverdata.awards2 or {}) do
        local vo = {}
        vo.bid = v.item_id
        vo.quantity = v.item_count
        table.insert(list, vo)
    end
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function()
        local item_list = self.item_scrollview:getItemList()
        for k, v in pairs(item_list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
            v:IsGetStatus(false,nil, PathTool.getResFrame("actionpetard", "txt_cn_petard_get"))
            if get_status == 0 then
                v:showOrderWarLock(true,nil,0.8)
                -- v:showOrderWarLockBg(true)
            else
                v:showOrderWarLock(false)
                -- v:showOrderWarLockBg(false)
            end
        end
    end)
    local item_list = self.item_scrollview:getItemList()
    if item_list then
        for k, v in pairs(item_list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
            v:IsGetStatus(false,nil, PathTool.getResFrame("actionpetard", "txt_cn_petard_get"))
            if get_status == 0 then
                v:showOrderWarLock(true,nil,0.8)
                -- v:showOrderWarLockBg(true)
            else
                v:showOrderWarLock(false)
                -- v:showOrderWarLockBg(false)
            end
        end
    end
end

function ActionUpstarGiftOptionalItem:setQualityImg(quality)
    local cur_quailty = quality
    if quality <= 5 then
    elseif quality <= 14 then
        cur_quailty = 5
    elseif quality <= 15 then
        cur_quailty = 6
    else
        cur_quailty = 7
    end
    local res_id = PathTool.getQualityBg(cur_quailty)
    self.background:loadTexture(res_id, LOADTEXT_TYPE_PLIST)
end
function ActionUpstarGiftOptionalItem:setHeadImg(head_icon)
    local res = PathTool.getHeadIcon(head_icon)
    self.head_icon:loadTexture(res, LOADTEXT_TYPE)
    self.head_icon:setScale(0.68)
    self.head_icon_bg:setContentSize(self.head_icon:getContentSize())
end

function ActionUpstarGiftOptionalItem:DeleteMe()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    if self.freeItem then
        self.freeItem:DeleteMe()
        self.freeItem = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end
