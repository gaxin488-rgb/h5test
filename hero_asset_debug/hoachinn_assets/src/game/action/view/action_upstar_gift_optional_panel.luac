ActionUpstarGiftOptionalPanel = class("ActionUpstarGiftOptionalPanel", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()
local max_lv = 0
function ActionUpstarGiftOptionalPanel:ctor(bid)
    self.holiday_bid = bid
    self.pos = 1
    self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("actioneightlogin", "actioneightlogin"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("actionpetard", "actionpetard"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("crossground", "crossground"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("starplan", "starplan"), type = ResourcesType.plist}
	}
    self.resources_load = ResourcesLoad.New(true)
	self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
            self:loadResListCompleted()
        end
	end)
end
function ActionUpstarGiftOptionalPanel:loadResListCompleted(  )
    self:configUI()
	self:register_event()
end

function ActionUpstarGiftOptionalPanel:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_upstar_gift_optional_panel"))
    if not self.root_wnd then return end
    self.root_wnd:setPosition(-40, -82)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    self.name_bg = self.main_container:getChildByName("name_bg")
    self.hero_name = self.name_bg:getChildByName("hero_name")

    self.herohead = self.main_container:getChildByName("herohead")
    self.head_icon = self.herohead:getChildByName("head_icon")
    self.change_btn = self.main_container:getChildByName("change_btn")
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.Text_10 = self.btn_get:getChildByName("Text_10")
    self.Text_10:setString(TI18N("语言_c_6212"))
    self.change_btn:setVisible(false)
    self.btn_get:setVisible(false)
    
    self.btn_tips = self.main_container:getChildByName("btn_tips") -- 帮助说明
    self.Image_7 = self.main_container:getChildByName("Image_7")
    self.Image_7:getChildByName("coin_label"):setString(TI18N("语言_hol_sta_pa_01_2"))
    local time_tips = self.main_container:getChildByName("time_txt")
    time_tips:setString(TI18N("语言_c_748"))
    self.act_time = self.main_container:getChildByName("act_time")--活动时间
    local time_pos_x = time_tips:getPositionX() + time_tips:getContentSize().width + 5
    self.act_time:setPositionX(time_pos_x)
    self.time_bg = self.main_container:getChildByName("time_bg")

    self.tipsbg = self.main_container:getChildByName("tipsbg")
    self.tips = self.main_container:getChildByName("tips")
    -- setTextMaxWidth(self.tips,650)
    self.goods_item = self.main_container:getChildByName("goods_list")
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0,
        space_x = 0,
        start_y = 5,
        space_y = 4,
        item_width = 690,
        item_height = 120,
        row = 0,
        col = 1
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    controller:sender28317(self.holiday_bid)
end
-- 奖励列表
function ActionUpstarGiftOptionalPanel:createTaskCell()
    local cell = ActionUpstarGiftOptionalItem.new(self.holiday_bid)
    return cell
end

function ActionUpstarGiftOptionalPanel:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ActionUpstarGiftOptionalPanel:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    local is_last = false
    if index == tableLen(self.reward_list) then
        is_last = true
    end
    cell:setData(cell_data,is_last,self.activityData.chose_id == 0)
end

function ActionUpstarGiftOptionalPanel:setHolidayBG()
    local campId = self.activityData.camp_id
    local baseConfig = Config.HolidayStarplanPackOptionalData.data_holiday_const[campId]
    local str_bg = "txt_cn_starplan_banner_1"
    
    local cfg = Config.HolidayStarplanPackOptionalData.data_chose_info[campId]
    if cfg[self.pos] and cfg[self.pos].banner and cfg[self.pos].banner ~= "" then
        str_bg = cfg[self.pos].banner
    end
    local res = PathTool.getPlistImgForDownLoad("starplan/banner", str_bg)
    loadSpriteTexture(self.image_bg, res, LOADTEXT_TYPE)
end

function ActionUpstarGiftOptionalPanel:register_event()
    if not self.skin_buy_event then
        self.skin_buy_event = GlobalEvent:getInstance():Bind(ActionEvent.UpStarGiftOptional, function(data,bid)
            if data and bid == self.holiday_bid then
                self.activityData = data
                self:setData(data)
            end
        end)
    end

    if not self.upStar_select_ok_gift then
        self.upStar_select_ok_gift = GlobalEvent:getInstance():Bind(ActionEvent.UpStarSelectOkGift, function(bid,chose_id)
            if bid == self.holiday_bid then
                self.pos = chose_id
                self:setData()
            end
        end)
    end
    
    self.btn_tips:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type, 1)
        if event_type == ccui.TouchEventType.ended then
            if self.activityData then
                local campId = self.activityData.camp_id
                local baseConfig = Config.HolidayStarplanPackOptionalData.data_holiday_const[campId]
                if baseConfig then
                    local str = baseConfig.rule
                    TipsManager:getInstance():showCommonTips(str, sender:getTouchBeganPosition())
                end
            end
        end
    end)

    self.head_icon:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type, 1)
        if event_type == ccui.TouchEventType.ended then
            if self and self.activityData then
                local cfg = Config.HolidayStarplanPackOptionalData.data_chose_info[self.activityData.camp_id]
                local heroId = cfg[self.pos].partner_id
                HeroController:getInstance():openHeroLibraryInfoWindow(true, heroId)
            else
                message(TI18N("语言_c_4972"))
            end
        end
    end)
    self.btn_get:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type, 1)
        if event_type == ccui.TouchEventType.ended then
            if self.activityData then
                local str = TI18N("语言_c_6768")
                CommonAlert.show( str, TI18N("语言_c_63"), function()
                    controller:sender28319(self.activityData.bid,self.pos)
                end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
            end
        end
    end)
    self.change_btn:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type, 1)
        if event_type == ccui.TouchEventType.ended then
            if self.activityData then
                controller:openActionUpstarSelectPanel(true,self.activityData,self.pos)
            end
        end
    end)
end

function ActionUpstarGiftOptionalPanel:setData(data)
    if not data then
        data = self.activityData
    end
    local campId = data.camp_id
    local baseConfig = Config.HolidayStarplanPackOptionalData.data_holiday_const[campId]
    local config = {}
    if data.chose_id ~= 0 then
        self.change_btn:setVisible(false)
        self.btn_get:setVisible(false)
        self.pos = data.chose_id
    else
        self.change_btn:setVisible(true)
        self.btn_get:setVisible(true)
    end
    local cfg = Config.HolidayStarplanPackOptionalData.data_chose_info[campId]
    local hero_name = cfg and cfg[self.pos] and cfg[self.pos].name or ""
    self.hero_name:setString(hero_name)
    config = deepCopy(Config.HolidayStarplanPackOptionalData.data_chose_task_list[campId][self.pos])
    if not config or not baseConfig then
        return
    end
    local reward_list = {}
    self.reward_list = {}
    for i, v in pairs(config) do
        if not reward_list[v.id] then
            local a = {
                cfg = v
            }
            reward_list[v.id] = a
        else
            reward_list[v.id].cfg = v
        end
    end
    max_lv = tableLen(reward_list)
    for i, v in pairs(data.award_list) do
        if reward_list[v.id] then
            reward_list[v.id].serverdata = v
        end
    end
    local list = {}
    for key, value in pairs(reward_list) do
        if value.serverdata and value.serverdata.is_show and value.serverdata.is_show ~= 1 then
            table.insert(list, key)
        end
    end
    table.sort(list,function(a,b) return a>b end)
    for key, value in pairs(list) do
        if reward_list[value] then
            table.remove(reward_list, value)
        end
    end
    for key, value in pairs(reward_list) do
        table.insert(self.reward_list,value)
    end
    table.sort(self.reward_list,function(a,b) return a.cfg.id<b.cfg.id end)
    self.reward_goods_item:reloadData()
    self:setTitleInfo()
    self:setHolidayBG()
end
function ActionUpstarGiftOptionalPanel:setTitleInfo()
    local campId = self.activityData.camp_id
    local baseConfig = Config.HolidayStarplanPackOptionalData.data_holiday_const[campId]
    local cfg = Config.HolidayStarplanPackOptionalData.data_chose_info[campId]
    local heroId = cfg[self.pos].partner_id
    local res = PathTool.getHeadIcon(heroId)
    self.head_icon:loadTexture(res, LOADTEXT_TYPE)

    doStopAllActions(self.act_time)
    local actInfo = controller:getActionSubTabVo(self.holiday_bid)
    controller:getModel():setCountDownTime(self.act_time,actInfo.remain_sec)
    local w1 = self.main_container:getChildByName("time_txt"):getContentSize().width
    local w2 = self.act_time:getContentSize().width
    local twidth = w1 + w2 + 20
    self.time_bg:setContentSize(cc.size(twidth,30))

    self.tips:setString(baseConfig.title)
    local tips_width = self.tips:getContentSize().width
    local tips_height = self.tips:getContentSize().height
    self.tipsbg:setContentSize(cc.size(tips_width + 20,tips_height))

    local data = HeroController:getInstance():getModel():getTopStarHeroInfoByBid(heroId)
    local star_num = 5
    if data then
        star_num = data.star
    end
    self.star_con = ccui.Widget:create()
    self.star_con:setZOrder(3)
    self.star_con:setPosition(cc.p(self.head_icon:getContentSize().width * 0.5,10))
    self.head_icon:addChild(self.star_con)
    self.star_setting = model:createStar(star_num,self.star_con,self.star_setting)
    self:setHolidayBG()
end

function ActionUpstarGiftOptionalPanel:DeleteMe()
    doStopAllActions(self.act_time)
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.bg_load then
        self.bg_load:DeleteMe()
        self.bg_load = nil
    end
    if self.skin_buy_event then
        GlobalEvent:getInstance():UnBind(self.skin_buy_event)
        self.skin_buy_event = nil
    end
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
