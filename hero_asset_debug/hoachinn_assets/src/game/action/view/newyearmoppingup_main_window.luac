local _controller = ActionController:getInstance()
local _model = _controller:getModel()


NewYearMoppingUpMainWindow = NewYearMoppingUpMainWindow or BaseClass(BaseView)

function NewYearMoppingUpMainWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full
    self.view_tag = ViewMgrTag.WIN_TAG
    self.layout_name = "action/newyearmoppingup_main_window"

    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("actionyearmonster", "actionyearmonster"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("new_year", "new_year"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("herodraw", "herodrawres"), type = ResourcesType.single},
    }
end

function NewYearMoppingUpMainWindow:open_callback( )
    self.background = self.root_wnd:getChildByName("background")
    self.background:setContentSize(cc.size(SCREEN_WIDTH, display.height))
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    -- self.main_container:setScale(display.getMaxScale())
    self:playEnterAnimatianByObj(self.mainContainer , 1) 
    self.container_size = self.main_container:getContentSize()
    self.background_0 = self.main_container:getChildByName("background_0")
    self.skin = self.main_container:getChildByName("skin")
    self.rule_btn = self.main_container:getChildByName("rule_btn")
    self.jump1_btn = self.main_container:getChildByName("jump1_btn")
    self.jump1_btn_img = self.jump1_btn:getChildByName("jump1_btn_img")
    self.jump1_btn_name_bg = self.jump1_btn:getChildByName("jump1_btn_name_bg")
    self.jump1_btn_name_txt = self.jump1_btn_name_bg:getChildByName("jump1_btn_name_txt")
    self.jump1_btn_name_txt:setChangeScaleOffWidth(-1000)
    self.jump2_btn = self.main_container:getChildByName("jump2_btn")
    self.jump2_btn_img = self.jump2_btn:getChildByName("jump2_btn_img")
    self.jump2_btn_name_bg = self.jump2_btn:getChildByName("jump2_btn_name_bg")
    self.jump2_btn_name_txt = self.jump2_btn_name_bg:getChildByName("jump2_btn_name_txt")
    self.jump2_btn_name_txt:setChangeScaleOffWidth(-1000)
    self.jump3_btn = self.main_container:getChildByName("jump3_btn")
    self.jump3_btn_img = self.jump3_btn:getChildByName("jump3_btn_img")
    self.jump3_btn_name_bg = self.jump3_btn:getChildByName("jump3_btn_name_bg")
    self.jump3_btn_name_txt = self.jump3_btn_name_bg:getChildByName("jump3_btn_name_txt")
    self.jump3_btn_name_txt:setChangeScaleOffWidth(-1000)
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.bottom_bg = self.bottom_panel:getChildByName("bottom_bg")
    self.image_title = self.bottom_panel:getChildByName("image_title")
    self.award_title = self.bottom_panel:getChildByName("award_title")
    self.award_title:setString(TI18N("语言_c_21"))
    self.image_title:setContentSize(cc.size(self.award_title:getContentSize().width + 120, self.image_title:getContentSize().height))
    self.award_list = self.bottom_panel:getChildByName("award_list")
    self.shop_btn = self.bottom_panel:getChildByName("shop_btn")
    self.new_yare_total = self.bottom_panel:getChildByName("new_yare_total")
    self.shop_txt = self.shop_btn:getChildByName("shop_txt")
    self.back_btn = self.bottom_panel:getChildByName("back_btn")
    self.holiday_name = self.main_container:getChildByName("holiday_name")
    self.holiday_tip = self.main_container:getChildByName("holiday_tip")

    self.time_txt = self.main_container:getChildByName("time_txt")
    self.time_val = createLabel(22,cc.c4b(0x1e,0xff,0x00),cc.c4b(0x00,0x00,0x00,0xff),50,1064,"",self.main_container,2,cc.p(0,1))
    -- local top_off = display.getTop(self.main_container)
    local bottom_off = display.getBottom(self.main_container)
	-- top_panel:setPositionY(top_off - 158)
	self.bottom_panel:setPositionY(bottom_off)

    local top_y = display.getTop(self.main_container)
    local main_container_size = self.main_container:getContentSize()
    local tab_y = self.rule_btn:getPositionY()
    self.rule_btn:setPositionY(top_y - (main_container_size.height - tab_y))
    local tab_y = self.skin:getPositionY()
    self.skin:setPositionY(top_y - (main_container_size.height - tab_y))
    local tab_y = self.jump1_btn:getPositionY()
    self.jump1_btn:setPositionY(top_y - (main_container_size.height - tab_y))
    local tab_y = self.jump2_btn:getPositionY()
    self.jump2_btn:setPositionY(top_y - (main_container_size.height - tab_y))
    local tab_y = self.jump3_btn:getPositionY()
    self.jump3_btn:setPositionY(top_y - (main_container_size.height - tab_y))
    MonopolyController:getInstance():sender16810(ActionRankCommonType.legendary_trial)
    self:adaptationScreen()
end
--设置适配屏幕
function NewYearMoppingUpMainWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local tab_y = self.holiday_name:getPositionY()
    self.holiday_name:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.holiday_tip:getPositionY()
    self.holiday_tip:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.time_txt:getPositionY()
    self.time_txt:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.jump1_btn:getPositionY()
    self.jump1_btn:setPositionY(tab_y+bottom_y)
    local tab_y = self.jump2_btn:getPositionY()
    self.jump2_btn:setPositionY(tab_y+bottom_y)
    local tab_y = self.jump3_btn:getPositionY()
    self.jump3_btn:setPositionY(tab_y+bottom_y)
    local tab_y = self.bottom_panel:getPositionY()
    self.bottom_panel:setPositionY(top_y - (self.container_size.height - tab_y))
end

function NewYearMoppingUpMainWindow:register_event( )
    registerButtonEventListener(self.back_btn, handler(self, self.onClickCloseBtn), true, 2)
    registerButtonEventListener(self.rule_btn, function (param,sender, event_type)
        local desc= self.const_cfg and self.const_cfg.txt
        if desc then
            TipsManager:getInstance():showAdventureBuffTipsScroll(desc, sender:getTouchBeganPosition(),nil,nil,nil,nil,800)
        end
    end, true, 2)
    registerButtonEventListener(self.jump1_btn, handler(self, self.onClickJumpBtn1), true, 2)
    registerButtonEventListener(self.jump2_btn, handler(self, self.onClickJumpBtn2), true, 2)
    registerButtonEventListener(self.jump3_btn, handler(self, self.onClickJumpBtn3), true, 2)
    registerButtonEventListener(self.shop_btn, handler(self, self.onClickShopBtn), true, 2)

    self:addGlobalEvent(MonopolyEvent.Get_Monopoly_War_Order_Popups, function ( data )
        if data.type == ActionRankCommonType.legendary_trial then
            self:setJumpBtnRed1()
        elseif data.type == ActionRankCommonType.CopyValuePackage or data.type == ActionRankCommonType.CopyValuePackage2 or data.type == ActionRankCommonType.CopyValuePackage5 or data.type == ActionRankCommonType.CopyValuePackage6 then
            self:setJumpBtnRed3()
        end 
	end)
    if self.newYear_mopping_data == nil then
        self.newYear_mopping_data = GlobalEvent:getInstance():Bind(ActionEvent.NewYearMoppingData, function() 
            self.new_yare_total:setString(string.format(TI18N("语言_c_5837"),_model:getNewYearMoppingUpNum()))
        end) 
    end
end

function NewYearMoppingUpMainWindow:onClickCloseBtn()
    _controller:openNewYearMoppingUpMainWindow(false)
end
function NewYearMoppingUpMainWindow:onClickJumpBtn1()
    --跳转传奇试炼
    if self.act_data and self.act_data.remain_sec < 86400 then
        message(TI18N("语言_c_233"))
        return
    end
    JumpController:getInstance():jumpViewByEvtData({self.const_cfg.chuanqi_skip})
end
function NewYearMoppingUpMainWindow:onClickJumpBtn2()
    --跳转主线战斗
    if self.act_data and self.act_data.remain_sec < 86400 then
        message(TI18N("语言_c_233"))
        return
    end
    JumpController:getInstance():jumpViewByEvtData({self.const_cfg.collect_skip})
end
function NewYearMoppingUpMainWindow:onClickJumpBtn3()
    --跳转超值礼包
    if self.act_data and self.act_data.remain_sec < 86400 then
        message(TI18N("语言_c_233"))
        return
    end
    JumpController:getInstance():jumpViewByEvtData({self.const_cfg.biggift_skip})
end
function NewYearMoppingUpMainWindow:onClickShopBtn()
    MallController:getInstance():openMallActionWindow(true,ActionRankCommonType.NewYearMoppingUp)
end

function NewYearMoppingUpMainWindow:openRootWnd()
    ActionController:getInstance():sender16814(ActionRankCommonType.NewYearMoppingUp)
    _controller:sender21722(ActionRankCommonType.NewYearMoppingUp)
    self.act_data = _controller:getActionSubTabVo(ActionRankCommonType.NewYearMoppingUp)
    if not self.act_data then return end
    self.camp_id = self.act_data.camp_id
    if not self.camp_id then return end
    self.skin_cfg = Config.HolidayNewYearData.data_skin_data[self.camp_id]
    if not self.skin_cfg then return end
    self.const_cfg = Config.HolidayNewYearData.data_const[self.camp_id]
    if not self.const_cfg then return end
    if self.skin_cfg then
        self:updateSkin()
    end
    self:updatePage()
    self.shop_txt:setString(self.const_cfg.exchange_name)
    local scroll_view_size = self.award_list:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.8,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.8,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.award_scrollview = CommonScrollViewLayout.new(self.award_list, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.award_scrollview:setSwallowTouches(false)
    self.award_scrollview:setData(self.const_cfg.reward_view)
    self.award_scrollview:addEndCallBack(
        function()
            local list = self.award_scrollview:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip(true)
            end
        end
    )
    self:setJumpBtnRed1()
    self:setJumpBtnRed2()
    self:setJumpBtnRed3()
end
function NewYearMoppingUpMainWindow:setJumpBtnRed1()
    addRedPointToNodeByStatus(self.jump1_btn,_model:getNewYearTolegendaryTrialRed() and self.act_data and self.act_data.remain_sec > 86400,0,-30)
end
function NewYearMoppingUpMainWindow:setJumpBtnRed2()
    addRedPointToNodeByStatus(self.jump2_btn,_model:getNewYearToMainLineRed() and self.act_data and self.act_data.remain_sec > 86400,0,-30)
end
function NewYearMoppingUpMainWindow:setJumpBtnRed3()
    addRedPointToNodeByStatus(self.jump3_btn,_model:getNewYearToCopyValuePackageRed() and self.act_data and self.act_data.remain_sec > 86400,0,-30)
end
--设置倒计时
function NewYearMoppingUpMainWindow:setLessTime(less_time)
    if tolua.isnull(self.time_val) then
        return
    end
    doStopAllActions(self.time_val)
    if less_time > 0 then
        self:setTimeFormatString(less_time)
        self.time_val:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1),
            cc.CallFunc:create(function()
                less_time = less_time - 1
                if less_time < 0 then
                    doStopAllActions(self.time_val)
                    self.time_val:setString("00:00:00")
                    _controller:openNewYearMoppingUpMainWindow(false)
                    MallController:getInstance():openMallActionWindow(false)
                else
                    self:setTimeFormatString(less_time)
                end
                
            end))))
    else
        self:setTimeFormatString(less_time)
        _controller:openNewYearMoppingUpMainWindow(false)
        MallController:getInstance():openMallActionWindow(false)
    end
end
function NewYearMoppingUpMainWindow:setTimeFormatString(time)
    if time > 0 then
        self.time_val:setString(TimeTool.GetTimeForFunction(time))
    else
        self.time_val:setString("00:00:00")
    end
end
function NewYearMoppingUpMainWindow:updatePage()
    local res = PathTool.getResFrame("new_year","txt_cn_new_year_1")
    loadSpriteTexture(self.holiday_name,res,LOADTEXT_TYPE_PLIST)
    local res = PathTool.getResFrame("new_year", "new_year_1")
    self.background:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.background:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year","new_year_12")
    loadSpriteTexture(self.background_0,res,LOADTEXT_TYPE_PLIST)
    local res = PathTool.getResFrame("new_year", "new_year_4")
    self.jump1_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump1_btn:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_7")
    self.jump2_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump2_btn:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_8")
    self.jump3_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump3_btn:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_5")
    self.jump1_btn_img:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump1_btn_img:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_6")
    self.jump2_btn_img:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump2_btn_img:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_9")
    self.jump3_btn_img:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump3_btn_img:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_3")
    self.jump1_btn_name_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump1_btn_name_bg:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_3")
    self.jump2_btn_name_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump2_btn_name_bg:ignoreContentAdaptWithSize(true)
    local res = PathTool.getResFrame("new_year", "new_year_3")
    self.jump3_btn_name_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.jump3_btn_name_bg:ignoreContentAdaptWithSize(true)
    self.jump1_btn_img:setPositionX(self.jump1_btn:getContentSize().width/2)
    self.jump2_btn_img:setPositionX(self.jump2_btn:getContentSize().width/2)
    self.jump3_btn_img:setPositionX(self.jump3_btn:getContentSize().width/2)
    self.jump1_btn_name_bg:setPositionX(self.jump1_btn:getContentSize().width/2)
    self.jump2_btn_name_bg:setPositionX(self.jump2_btn:getContentSize().width/2)
    self.jump3_btn_name_bg:setPositionX(self.jump3_btn:getContentSize().width/2)
    self.jump1_btn_name_txt:setString(self.const_cfg.pic_bk_txt)
    self.jump2_btn_name_txt:setString(self.const_cfg.main_bk_txt)
    self.jump3_btn_name_txt:setString(self.const_cfg.gift_bk_txt)
    local _w = math.max(self.jump1_btn_name_txt:getContentSize().width + 40,176)
    self.jump1_btn_name_bg:setContentSize(cc.size(_w, self.jump1_btn_name_bg:getContentSize().height))
    local _w = math.max(self.jump2_btn_name_txt:getContentSize().width + 40,176)
    self.jump2_btn_name_bg:setContentSize(cc.size(_w, self.jump2_btn_name_bg:getContentSize().height))
    local _w = math.max(self.jump3_btn_name_txt:getContentSize().width + 40,176)
    self.jump3_btn_name_bg:setContentSize(cc.size(_w, self.jump3_btn_name_bg:getContentSize().height))
    self.jump1_btn_name_txt:setPositionX(self.jump1_btn_name_bg:getContentSize().width/2)
    self.jump2_btn_name_txt:setPositionX(self.jump2_btn_name_bg:getContentSize().width/2)
    self.jump3_btn_name_txt:setPositionX(self.jump3_btn_name_bg:getContentSize().width/2)    
    if self.jump1_btn_name_bg:getContentSize().width > self.jump1_btn:getPositionX() * 2 then
        self.jump1_btn_name_bg:setPositionX(self.jump1_btn_name_bg:getPositionX() - (self.jump1_btn:getPositionX() - self.jump1_btn_name_bg:getContentSize().width/2))
    end
    if self.jump3_btn_name_bg:getContentSize().width > self.jump3_btn:getPositionX() * 2 then
        self.jump3_btn_name_bg:setPositionX(self.jump3_btn_name_bg:getPositionX() - (self.jump3_btn:getPositionX() - self.jump3_btn_name_bg:getContentSize().width/2))
    end
    self.holiday_tip:setChangeScaleOffWidth(-9999999)
    setTextMaxWidth(self.holiday_tip,720,-10)
    self.holiday_tip:setString(self.const_cfg.pic_txt)
    -- self.holiday_tip:setString(transformTextToShort(self.const_cfg.pic_txt,60))
    -- addEvt2showAllTextTips(self.holiday_tip,self.const_cfg.pic_txt,60)
    self.time_txt:setString(TI18N("语言_c_635"))
    self.time_val:setPositionX(self.time_txt:getPositionX() + self.time_txt:getContentSize().width)
    self.time_val:setPositionY(self.time_txt:getPositionY())
    local time = self.act_data and self.act_data.remain_sec or 0
    if time < 0 then
        time = 0
    end
    self:setLessTime(time)
end

function NewYearMoppingUpMainWindow:updateSkin( )
    if not self.skin_index then
        self.skin_index = math.random(#self.skin_cfg)
    else
        self.skin_index = self.skin_index + 1
        if self.skin_index > #self.skin_cfg then
            self.skin_index = 1
        end
    end
    local skin_name = self.skin_cfg[self.skin_index].skin_name
    if skin_name and skin_name ~= "" then
        local res = PathTool.getPlistImgForDownLoad("herodraw/herodrawres",skin_name)
        loadSpriteTexture(self.skin,res,LOADTEXT_TYPE)
    end
    self.skin:setPositionX(530 + self.skin_cfg[self.skin_index].pos[1][1])
    self.skin:setPositionY(680 + self.skin_cfg[self.skin_index].pos[1][2])
    self.skin:setScale(self.skin_cfg[self.skin_index].add / 100)
    local time = self.skin_cfg[self.skin_index].time
    doStopAllActions(self.skin)
	commonCountDownTime(self.skin,time,{callback = function(time)
        if time < 0 then
            self:updateSkin()
        end
    end})
end
function NewYearMoppingUpMainWindow:close_callback( )
    doStopAllActions(self.skin)
    
    if self.newYear_mopping_data then
        GlobalEvent:getInstance():UnBind(self.newYear_mopping_data)
        self.newYear_mopping_data = nil
    end
    _controller:openNewYearMoppingUpMainWindow(false)
end