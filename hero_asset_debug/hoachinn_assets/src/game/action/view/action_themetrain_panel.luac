ActionThemetrainTargetItem = class("ActionThemetrainTargetItem", function()
    return ccui.Widget:create()
end)

function ActionThemetrainTargetItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionThemetrainTargetItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("themetrain/action_theme_target_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self:setContentSize(cc.size(274, 50))
    self.main_container = self.root_wnd:getChildByName("container")
    self.desc_txt = self.main_container:getChildByName("desc_txt")
    setTextMaxWidth(self.desc_txt,200,-4)
    self.right_icon = self.main_container:getChildByName("right_icon")
    self.right_icon:setVisible(false)
    self.wrong_icon = self.main_container:getChildByName("wrong_icon")
    self.wrong_icon:setVisible(false)
end

function ActionThemetrainTargetItem:register_event()
    -- self.point_layer:addTouchEventListener(function(sender, event_type)
    --     if event_type == ccui.TouchEventType.ended then
    --         TipsController:getInstance():openActionScoreTips(true,"wonderland_point_max",TI18N("语言_c_1195"),TI18N("语言_c_5175"))
    --     end
    -- end)
end
function ActionThemetrainTargetItem:setData(data)
    self.data = data
    local desc = data.config.task_desc
    local condition = data.config.condition
    local floor = condition[2]
    local num = condition[3]
    local star = condition[4]
    local temp = {}
    temp[1] = floor
    temp[2] = num
    if star and star[1] and star[1][2] then
        temp[3] = star[1][2] 
    end
    local str = LangStringFormat(desc,temp)
    self.desc_txt:setString(str)
    local finish_status = data.data.finish
    if finish_status == 0 then
        self.right_icon:setVisible(false)
        self.wrong_icon:setVisible(true)
    else
        self.right_icon:setVisible(true)
        self.wrong_icon:setVisible(false)
    end
end

function ActionThemetrainTargetItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end
