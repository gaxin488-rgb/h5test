function ActionThemetrainPanel:setData()
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    local camp_id = tab_vo.camp_id
    local config = Config.HolidayLimitAssistData.data_mode_npc[camp_id]
    local theme_desc = config[1].desc
    local theme_type = config[1].type
    self.theme_desc:setString(theme_desc)
    if theme_type == 1 then
        self.score_panel_1:setVisible(true)
        self.score_panel_2:setVisible(false)
        local show_hero_id = config[1].partner_id[1]
        self.spine = BaseRole.new(BaseRole.type.partner, show_hero_id, nil, {scale = 1})
        self.spine:setAnimation(0,PlayerAction.show,true) 
        self.spine:setCascade(true)
        self.spine:setScale(0.65, 0.65)
        self.spine:setPosition(cc.p(58,150))
        self.spine:setAnchorPoint(cc.p(0.5,0.5)) 
        self.people_node:addChild(self.spine) 
        local hero_name = Config.PartnerData.data_partner_base[show_hero_id].name
        self.hero_name:setString(hero_name)
        local speak_desc = config[1].context
        self.hero_speak:setString(speak_desc)
        local skill_list = config[1].skills
        local item_width = 80
        for i, v in pairs(skill_list) do
            local config = Config.SkillData.data_get_skill(v)
            if config then
                self.skill_item_list[i] = SkillItem.new(true,true,true,0.56,nil,false)
                self.skill_item_list[i]:setPosition((52 + (i-1)%2*item_width),150 - 52 - math.floor((i-1)/2)*item_width)
                self.skill_item_list[i]:setData(config)
                self.skill_panel:addChild(self.skill_item_list[i])
            end
        end
    else
        self.score_panel_1:setVisible(false)
        local buff_id = config[1].effect
        if not self.buff_item then
            self.buff_item = SkillItem.new(true, true, true, 1, true)
            self.skill_node:addChild(self.buff_item)
        end
        local skill_config = Config.SkillData.data_get_skill(buff_id)
        self.buff_item:setData(skill_config)
        self.buff_name:setString(skill_config.name)
        self.buff_desc:setString(skill_config.des)
        self.score_panel_2:setVisible(true)
    end
    self:setLessTime(tab_vo.remain_sec)
end
--设置倒计时
function ActionThemetrainPanel:setLessTime( less_time )
    if tolua.isnull(self.left_time) then return end
    self.left_time:stopAllActions()
    if less_time > 0 then
        self:setTimeFormatString(less_time)
        self.left_time:runAction(cc.RepeatForever:create(cc.Sequence:create(
            cc.DelayTime:create(1), cc.CallFunc:create(function()
            less_time = less_time - 1
            if less_time < 0 then
                self.left_time:stopAllActions()
            else
                self:setTimeFormatString(less_time)
            end
        end)
        )))
    else
        self:setTimeFormatString(less_time)
    end
end

function ActionThemetrainPanel:setTimeFormatString(time)
    if time > 0 then
        self.left_time:setString(TimeTool.GetTimeFormatDayIIIIII(time))
    else
        self.left_time:setString("")
    end
    local _posx = self.left_time:getPositionX() - 10 - self.left_time:getContentSize().width
    self.time_txt:setPositionX(_posx)
end

function ActionThemetrainPanel:updateActionData(data)
    self.activity_data = data
    --print(vardump(data))
    --任务数据
    local task_list = data.task_list
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    local camp_id = tab_vo.camp_id
    local task_config = Config.HolidayLimitAssistData.data_task[camp_id]
    local new_array = {}
    for k, v in pairs(task_config) do
        local task_step = v.task_step
        local _temp = {}
        _temp.config = v
        _temp.task_step = task_step
        for key, value in pairs(task_list) do
            if value.step == task_step then
                _temp.data = value
                break
            end
        end
        table_insert(new_array,_temp)
    end
    table_sort(new_array, SortTools.KeyLowerSorter("task_step"))
    self.reward_list = deepCopy(new_array)
    self.target_goods_item:reloadData()
    local finish_all_task = true
    for k, v in pairs(task_list) do
        local task_info = v
        if task_info.finish == 0 then
            finish_all_task = false
        end
    end
    --奖励数据
    local data_list = data.reward
    local reward_list = {}
    for k, v in pairs(data_list) do
        local a = {}
        table_insert(a,v.base_id)
        table_insert(a,v.num)
        table_insert(reward_list,a)
    end
    local setting = {}
    setting.scale = 0.6
    setting.max_count = 4
    setting.is_get_status = finish_all_task
    setting.get_status_res = PathTool.getResFrame("common", "txt_cn_common_get")
    self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, reward_list, setting)
end

function ActionThemetrainPanel:DeleteMe()
    if self.update_dram_data_event then
        GlobalEvent:getInstance():UnBind(self.update_dram_data_event)
        self.update_dram_data_event = nil
    end
    if self.spine then
        self.spine:DeleteMe()
        self.spine = nil
    end
    if self.skill_item_list and next(self.skill_item_list) ~= nil then
        for i,v in pairs(self.skill_item_list) do
            v:DeleteMe()
        end
        self.skill_item_list = {}
    end
    if self.buff_item then
        self.buff_item:DeleteMe()
        self.buff_item = nil
    end
end

