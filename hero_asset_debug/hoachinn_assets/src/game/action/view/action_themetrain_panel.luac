ActionThemetrainPanel = class("ActionThemetrainPanel", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local table_insert = table.insert
local table_sort = table.sort
function ActionThemetrainPanel:ctor(bid)
    self.holiday_bid = bid
    self.res_list = {
        {
        path = PathTool.getPlistImgForDownLoad("wonderland", "wonderland"),
        type = ResourcesType.plist
    }, {
        path = PathTool.getPlistImgForDownLoad("actioneightlogin", "actioneightlogin"),
        type = ResourcesType.plist
    }
}
    self.skill_item_list= {}
    self.resources_load = ResourcesLoad.New(true)
    self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
            self:loadResListCompleted()
        end
    end)
end

function ActionThemetrainPanel:loadResListCompleted()
    self:configUI()
    self:register_event()
end

function ActionThemetrainPanel:register_event()
    if not self.update_dram_data_event then
        self.update_dram_data_event = GlobalEvent:getInstance():Bind(ActionEvent.ThemeTrainData, function(data)
            self:updateActionData(data)
        end)
    end
    
    registerButtonEventListener(self.jump_btn, function()
        local is_open = AdventureActivityController:getInstance():isOpenActivity(5)
        if not is_open then
			message(TI18N("语言_c_5411"))
			return
		end
        BraveRoadController:getInstance():sender13100()
        MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.Brave_road)
    end, true, 1)

    registerButtonEventListener(self.rule_btn, function(param,sender, event_type)
        local desc = Config.LimitTrainingData.data_const.event_rule.desc
        TipsManager:getInstance():showCommonTips(desc, sender:getTouchBeganPosition(),nil,nil,500)
    end, true, 1)

    self.people_node:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.began then
            self.people_node.touch_began = sender:getTouchBeganPosition()
        end    
        if event_type == ccui.TouchEventType.ended then
            local touch_began = self.people_node.touch_began
            local touch_end = sender:getTouchEndPosition()
            if touch_began and touch_end and (math.abs(touch_end.x - touch_began.x) > 20 or math.abs(touch_end.y - touch_began.y) > 20) then 
                --移动大于20了..表示本点击无效
                return
            end
            local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
            local camp_id = tab_vo.camp_id
            local config = Config.HolidayLimitAssistData.data_mode_npc[camp_id]
            local theme_type = config[1].type
            if theme_type == 1 then
                local show_hero_id = config[1].partner_id[1]
                HeroController:getInstance():openHeroLibraryInfoWindow(true, show_hero_id)
            end
        end
    end)
end

function ActionThemetrainPanel:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("themetrain/action_themetrain_panel"))
    self.root_wnd:setPosition(-40, -82)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.rule_btn = self.main_container:getChildByName("btn_rule")

    self.theme_panel =self.main_container:getChildByName("theme_panel")
    self.theme_panel:getChildByName("tip"):setString(TI18N("语言_c_6296"))
    self.theme_desc = createRichLabel(20, cc.c3b(0x0e, 0xa8, 0x0e), cc.p(0.5,0.5), cc.p(142, 74), -4, nil, 260)
    self.theme_panel:addChild(self.theme_desc)

    self.target_panel = self.main_container:getChildByName("target_panel")
    self.target_panel:getChildByName("tip"):setString(TI18N("语言_c_6298"))
    self.target_scroll = self.target_panel:getChildByName("goods_con")
    local scroll_view_size = self.target_scroll:getContentSize()
    local setting = {
        start_x = 0,
        space_x = 0,
        start_y = 45,
        space_y = 0,
        item_width = 280,
        item_height = 65,
        row = 0,
        col = 1
    }
    self.target_goods_item = CommonScrollViewSingleLayout.new(self.target_scroll, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
    self.target_goods_item:setSwallowTouches(true)
    self.target_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.target_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.target_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    
    self.score_panel_1 = self.main_container:getChildByName("score_panel_1")
    self.score_panel_1:getChildByName("tip"):setString(TI18N("语言_c_6297"))
    self.hero_name = self.score_panel_1:getChildByName("hero_name")
    self.hero_speak = self.score_panel_1:getChildByName("hero_speak")
    setTextMaxWidth(self.hero_speak, 150, -6)
    self.people_node = self.score_panel_1:getChildByName("people_node")
    self.skill_panel = self.score_panel_1:getChildByName("skill_panel")

    self.score_panel_2 = self.main_container:getChildByName("score_panel_2")
    self.score_panel_2:getChildByName("tips"):setString(TI18N("语言_c_6327"))
    self.skill_node = self.score_panel_2:getChildByName("skill_node")
    self.buff_name = self.score_panel_2:getChildByName("buff_name")
    self.buff_desc = self.score_panel_2:getChildByName("buff_desc")
    setTextMaxWidth(self.buff_desc, 265, 0)

    self.reward_panel = self.main_container:getChildByName("reward_panel")
    self.reward_panel:getChildByName("tip"):setString(TI18N("语言_c_6299"))
    self.reward_con = self.reward_panel:getChildByName("goods_con")
    local size = self.reward_con:getContentSize()
    self.item_scrollview = createScrollView(size.width, size.height+2, 0, 0, self.reward_con, ScrollViewDir.horizontal)
    self.jump_btn = self.reward_panel:getChildByName("jump_btn")

    local time_panel = self.main_container:getChildByName("time_panel")
    self.time_txt = time_panel:getChildByName("left_txt")
    self.time_txt:setString(TI18N("语言_c_1113")) 
    self.left_time = time_panel:getChildByName("left_num")
    controller:sender29140(self.holiday_bid)
    self:setData()
end
-- 奖励列表
function ActionThemetrainPanel:createTaskCell()
    local cell = ActionThemetrainTargetItem.new()
    return cell
end

function ActionThemetrainPanel:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ActionThemetrainPanel:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,is_last)
end
