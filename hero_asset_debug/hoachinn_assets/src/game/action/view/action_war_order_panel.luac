ActionWarOrderPanel = class("ActionWarOrderPanel", function()
	return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionWarOrderPanel:ctor(bid,id,remain_sec)
    self.remain_sec = remain_sec
    self.holiday_bid = bid
    self.task_data_list = {}
    model:setAcBid(bid)
    self.click_btn_list = -1
	self:configUI()
    self:register_event()

end

function ActionWarOrderPanel:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_war_order_panel"))
	self.root_wnd:setPosition(-40,-70)
	self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setAnchorPoint(0, 0)
	
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    -- local bg_res = PathTool.getPlistImgForDownLoad("get_ninja", "getninja_order_banner_bg_1")
	-- self.bg_load = loadSpriteTextureFromCDN(self.image_bg, bg_res, ResourcesType.single, self.bg_load)
	self.Image_2 = self.main_container:getChildByName("Image_2")
    self.surplus_txt = self.main_container:getChildByName("surplus_txt")
    local str = TI18N("语言_c_1242")
    self.surplus_txt:setString(str)
    self.surplus_time = self.main_container:getChildByName("surplus_time")
    self.surplus_time:setPositionX(self.surplus_txt:getPositionX())
    controller:getModel():setCountDownTime(self.surplus_time,self.remain_sec or 0)
    self.explain = self.main_container:getChildByName("explain")
    self.explain:setString(TI18N("语言_c_4688"))
	self.tab = self.main_container:getChildByName("tab")
	self.normal = self.tab:getChildByName("normal")
    self.name = self.tab:getChildByName("name")
    self.name:setString(TI18N("语言_c_4689"))
	self.tab_view = self.main_container:getChildByName("tab_view")
	self.btn_rule = self.main_container:getChildByName("btn_rule")
    self.good_cons = self.main_container:getChildByName("good_cons")
    
    self.btn_list = {}
    for i=1,3 do 
        local btn = self.tab_view:getChildByName("tab_"..i)
        btn.red_point = btn:getChildByName("redpoint")
        btn.red_point:setVisible(false)
        btn.normal = btn:getChildByName("normal")
        btn.select = btn:getChildByName("select")
        btn.select:setVisible(false)
        btn.name = btn:getChildByName("name")
        btn.lock = btn:getChildByName("lock")
        btn.name:setString("")
        btn.name:setTextColor(cc.c4b(0xEE, 0xD1, 0xAF, 0xff))
        btn.name:enableOutline(cc.c4b(0x53, 0x3D, 0x32, 0xff), 2)
        btn.index = i
        self.btn_list[i] = btn
    end
    controller:sender13620(self.holiday_bid)
end
function ActionWarOrderPanel:updateList()
    self.cfg = Config.HolidayGetninjaData.data_task_list
    if not self.cfg or not model:getWarCampId() or not model:getWarCur_turn() or not self.cfg[model:getWarCampId()] or not self.cfg[model:getWarCampId()][model:getWarCur_turn()] then
        return
    end
    local len = tableLen(self.cfg[model:getWarCampId()][model:getWarCur_turn()])
    self.task_data_list = model:getWarList(self.cur_turn or model:getWarCur_turn(),len) or {}
    for i=1,tableLen(self.btn_list) do
        local red = model:setAcRed(i,len)
        self.btn_list[i].red_point:setVisible(red)
    end
    if self.task_view == nil then
        local scroll_view_size = self.good_cons:getContentSize()
        local setting = {
            item_class = ActionWarOrderItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 680,               -- 单元的尺寸width
            item_height = 156,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.task_view = CommonScrollViewLayout.new(self.good_cons, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
        self.task_view:setData(self.task_data_list)
    end
end

function ActionWarOrderPanel:setInitBtn(index)
    self.cur_turn = index or self.cur_turn or model:getWarCur_turn()
    for i=1,3 do
        self.btn_list[i].select:setVisible(true)
        self.btn_list[i].normal:setVisible(false)
        local str = string.format(TI18N("语言_c_1558"),i)
        self.btn_list[i].name:setString(str)
        if i <= model:getWarCur_turn() then
            self.btn_list[i].lock:setVisible(false)
            setChildUnEnabled(false, self.btn_list[i].select)
            setChildUnEnabled(false, self.btn_list[i].normal)
            self.btn_list[i].name:setTextColor(cc.c4b(0xf9, 0xee, 0xd0, 0xff))
            self.btn_list[i].name:enableOutline(cc.c4b(0x5c, 0x27, 0x05, 0xff), 2)
        else
            self.btn_list[i].lock:setVisible(true)
            setChildUnEnabled(true, self.btn_list[i].select)
            setChildUnEnabled(true, self.btn_list[i].normal)
            self.btn_list[i].name:setTextColor(cc.c4b(0xf3, 0xf3, 0xf3, 0xff))
            self.btn_list[i].name:enableOutline(cc.c4b(0x2c, 0x2c, 0x2c, 0xff), 2)
        end
    end

    self.cur_select = self.btn_list[self.cur_turn]
    if self.cur_select ~= nil then
        self.cur_select.select:setVisible(false)
        self.cur_select.normal:setVisible(true)
        setChildUnEnabled(false, self.cur_select.normal)
        self.cur_select.name:setTextColor(cc.c4b(0xf8, 0xef, 0x76, 0xff))
        self.cur_select.name:enableOutline(cc.c4b(0x5c, 0x27, 0x05, 0xff), 2)
    end
    for key, value in pairs(self.task_data_list) do
        if self.cur_turn == model:getWarCur_turn() then
            value.test = true
        elseif self.cur_turn < model:getWarCur_turn() then
            value.test = false
        end
    end
    self.cfg = Config.HolidayGetninjaData.data_task_list
    if not self.cfg or not model:getWarCampId() or not self.cfg[model:getWarCampId()] or not self.cfg[model:getWarCampId()][self.cur_turn] then
        return
    end
    local len = tableLen(self.cfg[model:getWarCampId()][self.cur_turn])
    if not tolua.isnull(self) and not tolua.isnull(self.task_view) then
        if self.cur_turn > model:getWarCur_turn() then
            local list = {}
            for i=1,len do
                local num = (self.cur_turn - 1) * len + i
                local data = {}
                data["id"] = num
                table.insert(list,data)
            end
            self.task_view:setData(list)
        else
            self.task_data_list = model:getWarList(self.cur_turn,len)
            self.task_view:setData(self.task_data_list)
        end
    end
end

function ActionWarOrderPanel:setInitData()
    self:updateList()
    self:setInitBtn()
end
function ActionWarOrderPanel:register_event()
    for k,v in pairs(self.btn_list) do
        registerButtonEventListener(v, function()
            self:setInitBtn(k)
        end,false, 1)
    end

	registerButtonEventListener(self.tab, function()
        controller:openActionwaradvanced(true)
	end, true)

	if self.btn_rule then
		self.btn_rule:addTouchEventListener(function( sender,event_type )
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2() 
TipsManager:getInstance():showCommonTips(Config.HolidayClientData.data_constant["mouth_get_ninja_rules"].desc,sender:getTouchBeganPosition())
            end
        end)
    end

    if not self.updateEvent then
        self.updateEvent = GlobalEvent:getInstance():Bind(ActionEvent.WarOrderAct ,function(data)
            if not data then
                return
            end
                self.data = data
                self:setInitData()
            end
        )
    end
end

function ActionWarOrderPanel:DeleteMe()
    doStopAllActions(self.remain_time)
	if self.message_event then
        GlobalEvent:getInstance():UnBind(self.message_event)
        self.message_event = nil
    end
    if self.updateEvent then
        GlobalEvent:getInstance():UnBind(self.updateEvent)
        self.updateEvent = nil
    end
    if self.task_view then
        self.task_view:DeleteMe()
        self.task_view = nil
    end
end

--子项
ActionWarOrderItem = class("ActionWarOrderItem", function()
    return ccui.Widget:create()
end)

function ActionWarOrderItem:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function ActionWarOrderItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_war_order_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(641,156))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.goods_con = self.main_container:getChildByName("goods_con")
    self.goods_con:setScrollBarEnabled(false)
    self.goods_con_2 = self.main_container:getChildByName("goods_con_2")
    -- self.goods_con_2:setScrollBarEnabled(false)
	self.has_bg = self.main_container:getChildByName("has_bg")
	self.btn_get = self.main_container:getChildByName("btn_get")
	self.Text_10 = self.btn_get:getChildByName("Text_10")
    self.Text_10:setString(TI18N("语言_c_8"))
	self.btn_goto = self.main_container:getChildByName("btn_goto")
	self.Text_11 = self.btn_goto:getChildByName("Text_11")
    self.Text_11:setString(TI18N("语言_c_7"))
	self.Image_1_0 = self.main_container:getChildByName("Image_1_0")
	self.bar = self.main_container:getChildByName("bar")
    self.bar:setScale9Enabled(true)
    -- self.bar:setPercent(0)
    self.title_txt_0 = self.main_container:getChildByName("title_txt_0")
    self.Text_11_0 = self.main_container:getChildByName("Text_11_0")
    self.Text_11_0:setString(TI18N("语言_c_4868"))
    self.lock = self.main_container:getChildByName("lock")
    self.remain_up = createRichLabel(26, cc.c4b(0x33,0x23,0x1b,0xff), cc.p(0,0.5), cc.p(15,132))
    self.main_container:addChild(self.remain_up)
end

function ActionWarOrderItem:setData( data)
    if not data or next(data) == nil then return end
    self.data = data
    self.cur_turns = model:getWarCur_turn()
    self.camp_id = model:getWarCampId()
    self.cfg = Config.HolidayGetninjaData.data_task_list
    local len = tableLen(self.cfg[self.camp_id][self.cur_turns])
    local cur_turn = math.ceil(data.id / len )
    self.list = self.cfg[self.camp_id][cur_turn][data.id]
    local str = self.list["desc"]
    self.remain_up:setString(str)
    
    if data.finish then
        self.finish = data.finish
        self.Text_11_0:setVisible(false)
        self.lock:setVisible(false)
        self.btn_get:setVisible(true)
        self.btn_goto:setVisible(true)
        self.Image_1_0:setVisible(true)
        self.bar:setVisible(true)
        self.title_txt_0:setVisible(true)
        self.has_bg:setVisible(true)
        if self.finish == 0 then
            self.btn_get:setVisible(false)
            self.btn_goto:setTouchEnabled(true)
            self.has_bg:setVisible(false)
        elseif self.finish == 1 then
            self.btn_get:setVisible(true)
            self.btn_get:setTouchEnabled(true)
            addRedPointToNodeByStatus(self.btn_get,model:getWarRed(),15,10,nil,nil,PathTool.getResFrame("common","common_1014"))
            self.btn_goto:setVisible(false)
            self.has_bg:setVisible(false)
        elseif self.finish == 2 then
            if model:getChargeFlag() == 0 then
                self.btn_get:setVisible(false)
                self.btn_goto:setVisible(true)
                self.btn_goto:setTouchEnabled(true)
                self.Text_11:setString(TI18N("语言_c_2684"))
                self.has_bg:setVisible(false)
            else
                self.btn_get:setVisible(true)
                self.btn_get:setTouchEnabled(true)
                addRedPointToNodeByStatus(self.btn_get,model:getWarRed(),5,5,nil,nil,PathTool.getResFrame("common","common_1014"))
                self.btn_goto:setVisible(false)
                self.has_bg:setVisible(false)
            end
        elseif self.finish == 3 then
            self.btn_get:setVisible(false)
            self.btn_goto:setVisible(false)
            self.has_bg:setVisible(true)
        end
        local progress = data.progress[1]
        self.bar:setPercent(progress.value/progress.target_val*100)
        local strings = progress.value.."/"..progress.target_val
        self.title_txt_0:setString(strings)
    else
        self.btn_get:setVisible(false)
        self.btn_goto:setVisible(false)
        self.Image_1_0:setVisible(false)
        self.bar:setVisible(false)
        self.title_txt_0:setVisible(false)
        self.has_bg:setVisible(false)
        self.Text_11_0:setVisible(true)
        self.lock:setVisible(true)
    end
    -- self.data_list = {}
    local data_list1 = self.list["reward"]
    local data_list2 = self.list["rmb_reward"]
    -- for key, value in pairs(data_list1) do
    --     table.insert(self.data_list,value)
    -- end
    -- for key, value in pairs(data_list2) do
    --     table.insert(self.data_list,value)
    -- end
    local setting = {}
    setting.scale = 0.7
    setting.space_x = 2
    setting.max_count = 2
    setting.is_center = true
    setting.is_get_status = self.data.finish and self.data.finish > 1
    setting.get_status_res = PathTool.getResFrame("get_ninja","txt_cn_get_ninja_lingqu")
    self.item_list1 = commonShowSingleRowItemList(self.goods_con, self.item_list1, data_list1, setting)
    local lock
    if model:getChargeFlag() == 0 then
        lock = true
    else
        lock = false
    end
    local setting2 = {}
    setting2.scale = 0.7
    setting2.space_x = 0
    setting2.max_count = 1
    setting2.lock = lock
    setting2.lock_pos = cc.p(59.5, 59.5)
    setting2.is_lock_bg = lock
    setting2.is_get_status = self.data.finish and self.data.finish > 2
    setting2.get_status_res = PathTool.getResFrame("get_ninja","txt_cn_get_ninja_lingqu")
    self.item_list2 = commonShowSingleRowItemList(self.goods_con_2, self.item_list2, data_list2, setting2) 
end

function ActionWarOrderItem:register_event( )
    registerButtonEventListener(self.btn_get, function()
        local bid = ActionController:getInstance():getModel():getWarCampId()
        ActionController:getInstance():sender13621(model:getAcBid(),self.data.id)
    end,true, 1)

    registerButtonEventListener(self.btn_goto, function()
        if self.finish == 0 then
            StrongerController:getInstance():clickCallBack(120)
            -- NewPartnersummonController:getInstance():openNewPartnerSummonWindow(true)
        else
            controller:openActionwaradvanced(true)
        end
    end,true, 1)

end

function ActionWarOrderItem:DeleteMe()

end