-- 开始打开卡牌
function ActionDdpGameWindow:beginOpenBagFlip(cell)
    if self.opening ~= nil and self.opening then
        return
    end
    -- self:setBagOpening(true)
    self.flip_num = -flip_open_delay
    self.opening = true
    local cell_data = cell:getData()
    self:clearTimeTicket()
    local function _callback()
        if cell and cell.setOpenItemFlip then
            cell:setOpenItemFlip(self.flip_num)
            self.flip_num = self.flip_num + 3
        end
        if self.is_can_time then
            self:updateTime()
        end
        if self.flip_num >= flip_open_delay then
            self:clearTimeTicket()
            if cell.resetItemFlip then
                cell:initScale()
                self.current_step = self.current_step + 1
                self.step_num:setString(string.format("%s/%s",self.current_step,self.diff_limit))
                if self.checkHeroItem ~= nil then
                    local hero_data = self.checkHeroItem.data
                    local current_data = cell.data
                    if hero_data and hero_data.id == current_data.id then
                        cell.data.open = true
                        self.has_done_item_num = self.has_done_item_num + 2
                        if cell and cell.showItemEffect then
                            cell:showItemEffect()
                        end
                        if self.checkHeroItem and self.checkHeroItem.showItemEffect then
                            self.checkHeroItem:showItemEffect()
                        end
                        delayOnce(function()
                            self.opening = false
                            if cell and cell.resetItemFlip then
                                cell:resetItemFlip()
                            end
                            if self.checkHeroItem and self.checkHeroItem.resetItemFlip then
                                self.checkHeroItem:resetItemFlip()
                                self.checkHeroItem = nil
                            end
                        end, 0.2)
                    else
                        cell.data.open = false
                        if self.checkHeroItem and self.checkHeroItem.data then
                            self.checkHeroItem.data.open = false
                        end
                        delayOnce(function()
                            self.opening = false
                            if cell and cell.setCloseItemFlip then
                                cell:setCloseItemFlip()
                            end
                            if self.checkHeroItem and self.checkHeroItem.setCloseItemFlip then
                                self.checkHeroItem:setCloseItemFlip()
                                self.checkHeroItem = nil
                            end
                            -- if cell and cell.resetItemFlip then
                            --     cell:resetItemFlip()
                            -- end
                            -- if self.checkHeroItem and self.checkHeroItem.resetItemFlip then
                            --     self.checkHeroItem:resetItemFlip()
                            --     self.checkHeroItem = nil
                            -- end
                        end, 0.2)

                    end
                else
                    self.opening = false
                    self.checkHeroItem = cell
                    cell.data.open = true
                    cell:resetItemFlip()
                end

            end
        end
        if self.all_item_num == self.has_done_item_num then
            self.ctrl:sender29601(self.choose_index,self.current_step)
        end
    end
    self.time_open_ticket = GlobalTimeTicket:getInstance():add(_callback, 1 / (flip_open_delay * 4))
    self.opening_ticket = GlobalTimeTicket:getInstance():add(function()
        if self.opening_ticket ~= nil then
            GlobalTimeTicket:getInstance():remove(self.opening_ticket)
            self.opening_ticket = nil
        end
    end, 0.5, 1)
end

function ActionDdpGameWindow:clearTimeTicket()
    if self.time_open_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_open_ticket)
        self.time_open_ticket = nil
    end
end

function ActionDdpGameWindow:DeleteMe()
    -- self:showEffect(false)
    if self.opening_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.opening_ticket)
        self.opening_ticket = nil
    end
    if self.card_open_event then
        GlobalEvent:getInstance():UnBind(self.card_open_event)
        self.card_open_event = nil
    end
    self.action_id = nil
    self.choose_index = nil
    if self.item_node then
        self.item_node = nil
    end
    if self.item_layer then
        self.item_layer:removeAllChildren()
    end
    for k, v in pairs(self.reward_item_list) do
        v:DeleteMe()
        -- v:removeFromParent()
        v=nil
    end
    doStopAllActions(self.time_txt)
    self:clearTimeTicket()
    self:removeAllChildren()
end

ActionDdpItem = class("ActionDdpItem", function()
    return ccui.Widget:create()
end)

function ActionDdpItem:ctor()
    self:configUI()
    self:registerEvent()
end

function ActionDdpItem:getData()
    return self.data
end

function ActionDdpItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_ddp_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setContentSize(cc.size(110, 110))
    self:setAnchorPoint(0.5, 0.5)

    self.container = self.root_wnd:getChildByName("container")
    self.head_icon = self.container:getChildByName("head_icon")
    self.item_bg = self.container:getChildByName("item_bg")
    self.item_mask = self.container:getChildByName("item_mask")
    self.effect_group = self.container:getChildByName("effect_group")
    self:createItemEffect(true)
end

-- desc:注册相关事件
-- time:2017-07-03 01:53:49
-- @return 
-- ==============================--
function ActionDdpItem:registerEvent()
    self:setTouchEnabled(true)
    self.item_mask:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            GlobalEvent:getInstance():Fire(ActionEvent.CardOpenEvent, self)
        end
    end)
end

function ActionDdpItem:showItemEffect()
    if self.play_effect then
        self.play_effect:setVisible(true)
        self.play_effect:setAnimation(0, PlayerAction.action_1, false)
    end
end

function ActionDdpItem:createItemEffect(bool)
    if bool == true then
        if self.play_effect == nil then
            self.play_effect = createEffectSpine("E31315", cc.p(55, 56), cc.p(0.5, 0.5), false, PlayerAction.action_1, function()
                self.play_effect:setVisible(false)
            end)
            self.play_effect:setVisible(false)
            self.effect_group:addChild(self.play_effect, 1)
        end
    else
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
    end
end

function ActionDdpItem:unBindEvent()

    -- if self.data then
    --     if self.item_update_event ~= nil then
    --         self.data:UnBind(self.item_update_event)
    --         self.item_update_event = nil
    --     end
    --     self.data = nil
    -- end
end
-- ==============================--
-- desc:设置数据
-- time:2018-05-15 08:12:01
-- @data:data类型可以是partnervo，partner表的config，bid
-- @return 
-- ==============================--
function ActionDdpItem:setData(data)
    self:unBindEvent()
    self.data = data
    local card_icon = PathTool.getPlistImgForDownLoad("pairtopair", data.card_icon)
    self.item_mask:loadTexture(card_icon, LOADTEXT_TYPE)
    self:updateData(data)
    self:resetItemFlip()
end

function ActionDdpItem:initScale()
    self.item_mask:setScaleX(1)
    self.item_bg:setScaleX(1)
    self.head_icon:setScaleX(1)
    self.item_bg:setVisible(true)
end

function ActionDdpItem:resetItemFlip()
    self:initScale()
    if self.data.open then
        self.head_icon:setVisible(true)
        self.item_mask:setVisible(false)
    else
        self.head_icon:setVisible(false)
        self.item_mask:setVisible(true)
    end
end

function ActionDdpItem:setOpenItemFlip(flip_num)
    if flip_num < 0 then
        self.item_bg:setVisible(false)
        self.head_icon:setVisible(false)
        self.item_mask:setVisible(false)
        self.item_bg:setScaleX(flip_num / flip_open_delay)
        self.head_icon:setScaleX(1)
    else
        self.head_icon:setVisible(true)
        self.item_bg:setVisible(true)
        self.item_bg:setScaleX(flip_num / flip_open_delay)
        self.head_icon:setScaleX(flip_num / flip_open_delay)
    end
end

function ActionDdpGameWindow:clearTimeTicket()
    if self.time_open_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_open_ticket)
        self.time_open_ticket = nil
    end
end

function ActionDdpItem:setCloseItemFlip()
    if self.opening ~= nil and self.opening then
        return
    end
    self.flip_num = -flip_open_delay
    self.opening = true
    self:clearTimeTicket()
    local function _callback()
        if not self.flip_num then self.flip_num = 0 end
        if not self.item_bg then return end
        if self.flip_num < 0 then
            self.item_bg:setVisible(true)
            self.head_icon:setVisible(true)
            self.item_mask:setScaleX(0)
            self.head_icon:setScaleX(-self.flip_num / flip_open_delay)
            self.item_bg:setScaleX(self.flip_num / flip_open_delay)
            self.item_mask:setScaleX(1)
        else
            self.head_icon:setVisible(false)
            self.item_bg:setVisible(true)
            self.item_mask:setVisible(true)
            self.head_icon:setScaleX(-self.flip_num / flip_open_delay)
            self.item_bg:setScaleX(self.flip_num / flip_open_delay)
            self.item_mask:setScaleX(self.flip_num / flip_open_delay)
        end
        self.flip_num = self.flip_num + 3
        if self.flip_num >= flip_open_delay then
            self:clearTimeTicket()
            self:resetItemFlip()
        end
    end
    self.time_open_ticket = GlobalTimeTicket:getInstance():add(_callback, 1 / (flip_open_delay * 4))
    self.opening_ticket = GlobalTimeTicket:getInstance():add(function()
        self.opening = false
        if self.opening_ticket ~= nil then
            GlobalTimeTicket:getInstance():remove(self.opening_ticket)
            self.opening_ticket = nil
        end
    end, 0.2, 1)
end

function ActionDdpItem:clearTimeTicket()
    if self.time_open_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_open_ticket)
        self.time_open_ticket = nil
    end
end

-- @info 数据 可以是
function ActionDdpItem:updateData(info)
    if not info then
        return
    end
    if info.icon_type == 1 then
        local item_config = Config.ItemData.data_get_data(info.id)
        if not item_config or not item_config.icon then
            return
        end
        local head_icon = PathTool.getItemRes(item_config.icon, false)
        if self.record_head_icon == nil or self.record_head_icon ~= head_icon then
			self.record_head_icon = head_icon
            self.head_icon:loadTexture(head_icon, LOADTEXT_TYPE)
		end
    else
        local data = Config.PartnerData.data_partner_base[info.id]
        if not data or not data.bid then
            return
        end
        local key = getNorKey(data.bid, 5)
        local star_config = Config.PartnerData.data_partner_star(key)
        if star_config then
            self:setHeadImg(star_config.head_id)
        end
    end
    local cfg = Config.HolidayFlopData.data_flop_act_list[info.camp_id]
    local res = PathTool.getResFrame("pairtopair", cfg.card_icon) 
    self.item_bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
end

-- ==================--
-- desc:设置头像
-- time:2019-01-24 09:31:58
-- @head_icon:
-- @return 
-- ==============================--
function ActionDdpItem:setHeadImg(head_icon)
    if self.record_head_id == nil or self.record_head_id ~= head_icon then
        self.record_head_id = head_icon
        local res = PathTool.getHeadIcon(head_icon)
        self.record_head_icon = res
        self.head_icon:loadTexture(res, LOADTEXT_TYPE)
    end
end

function ActionDdpItem:DeleteMe()
    doStopAllActions(self)
    if self.opening_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.opening_ticket)
        self.opening_ticket = nil
    end
    self:createItemEffect(false)
    self:unBindEvent()
    self:removeAllChildren()
    self:removeFromParent()
end
