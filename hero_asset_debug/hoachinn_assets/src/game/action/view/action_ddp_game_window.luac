ActionDdpGameWindow = class("ActionDdpGameWindow",function()
    return ccui.Layout:create()
end)
local table_insert = table.insert
local flip_open_delay = 15

function ActionDdpGameWindow:ctor(activity_id, choose_index, bid)
    if self.action_id == activity_id then
        return
    end
    if self.choose_index == choose_index then
        return
    end
    self.action_id = activity_id
    self.choose_index = choose_index
    self.action_bid = bid
    self.ctrl = ActionController:getInstance()
    self.model = self.ctrl:getModel()
    -- self.win_type = WinType.Full
    -- self.layout_name = "action/action_ddp_game_panel"
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_ddp_game_panel"))
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self.label_list = {}
    self.hero_item_list = {}
    self.cur_rank_type = 0
    self.has_done_item_num = 0 -- 已完成选择的牌数
    self.all_item_num = 0 -- 总牌数
    self.current_step = 0 -- 当前步数
    self.checkHeroItem = nil
    self.flip_num = 0
    self.reward_item_list = {}
    self.is_can_time = true --是否开启倒计时
    self.flop_cfg = Config.HolidayFlopData.data_flop_act_list[self.action_id]
    -- 资源加载
    local res_list = {
        {path = PathTool.getPlistImgForDownLoad("arena", "arenaenter"),type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("bigbg/action", "pairtopair_bg_1"),type = ResourcesType.single}, 
        {path = PathTool.getPlistImgForDownLoad("bigbg/action", "pairtopair_bg_2"),type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("num", "type3"),type = ResourcesType.plist}
    }
    if self.init_res_load then
        self.init_res_load:DeleteMe()
        self.init_res_load = nil
    end
    self.init_res_load = ResourcesLoad.New()
    self.init_res_load:addAllList(res_list, function()
        if not tolua.isnull(self.root_wnd) then
            self:initConfig()
        end
    end)
end

function ActionDdpGameWindow:initConfig()
    self.background_path = PathTool.getPlistImgForDownLoad("bigbg/action", "pairtopair_bg_1")
    self.bottom_path = PathTool.getPlistImgForDownLoad("bigbg/action", "pairtopair_bg_2")
    
    self:initView()
    self:registerEvent()
    self:openRootWnd()
end

function ActionDdpGameWindow:initView()

    self.current_step = 0
    self.has_done_item_num = 0
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.background = self.main_container:getChildByName("bg")
    -- self.effect_layer = self.main_container:getChildByName("effect_layer") -- 模型

    self.award_bg = self.main_container:getChildByName("award_bg")
    self.item_layer = self.main_container:getChildByName("item_layer")
    self.step_title = self.main_container:getChildByName("step_title")
    self.step_title:setString(TI18N("语言_c_107"))
    local _w = math.max(self.step_title:getContentSize().width,135)
    self.item_layer:setContentSize(cc.size(_w,self.item_layer:getContentSize().height))

    self.item_group = self.main_container:getChildByName("reward_con")
    
    self.step_tip = self.main_container:getChildByName("step_tip")
    setTextMaxWidth(self.step_tip,250)
    self.step_tip:setString(TI18N("语言_hol_fl_2"))
    self.step_num = self.main_container:getChildByName("step_num")
    self.surplus_txt = self.main_container:getChildByName("surplus_txt")
    self.surplus_txt:setString(TI18N("语言_c_6995"))
    self.time_node = self.main_container:getChildByName("time_node")
    self.time_txt = createRichLabel(24,cc.c3b(0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(0,0))
    self.time_node:addChild(self.time_txt)
end

function ActionDdpGameWindow:_onClickBtnClose()
    self.ctrl:openDdpGameWindow(false)
    self.ctrl:openActionMainPanel(true,nil,self.action_id)
end
function ActionDdpGameWindow:registerEvent()
    if not self.card_open_event then
        self.card_open_event = GlobalEvent:getInstance():Bind(ActionEvent.CardOpenEvent, function(data)
            self:beginOpenBagFlip(data)
        end)
    end
end

function ActionDdpGameWindow:openRootWnd()
    self:initPanel(self.action_id, self.choose_index, self.action_bid)
end

function ActionDdpGameWindow:initPanel(activity_id, choose_index, bid)
    local flop_cfg = Config.HolidayFlopData.data_flop_act_list[self.action_id]
    local mod_info = Config.HolidayFlopData.data_mod_info[flop_cfg.mod_id][self.choose_index]
    if not mod_info then
        return
    end
    local award_info = Config.HolidayFlopData.data_award_info[self.action_id][mod_info.difficulty_id]
    self.mod_info = mod_info
    self.award_info = award_info
    local game_background_pic = flop_cfg.table_background_picture
    local step_pic = flop_cfg.challenge_picture
    local card_icon = flop_cfg.card_icon
    local icon_type = flop_cfg.icon_type
    self.background_path = PathTool.getPlistImgForDownLoad("bigbg/action", game_background_pic)
    -- self.background_path = PathTool.getPlistImgForDownLoad("pairtopair", step_pic)
    self.icon_type = icon_type
    self.card_icon = card_icon

    self.background:loadTexture(self.background_path, LOADTEXT_TYPE)

    self.all_item_num = mod_info.count or 0
    self.diff_limit = mod_info.award_limit or 0
    local hero_icon = flop_cfg.hero_icon
    local reward_show = award_info.challenge_award
    -- self.step_desc:setString(string_format(TI18N("语言_c_g_140"), self.diff_limit))
    local list = self.model:getDdpRewardList()
    local has_get = false
    if list[self.choose_index] and list[self.choose_index].finish_award then
        has_get = true
    end
    for i,v in ipairs(reward_show) do
        if self.hero_item_list[i] == nil then
            self.hero_item_list[i] = BackPackItem.new(false, true, false, 0.8, false, true)
            self.hero_item_list[i]:setPosition( (i-1) * (BackPackItem.Width * 0.8 + 10) , 0)
            self.hero_item_list[i]:setDefaultTip(true, false)
            self.item_layer:addChild(self.hero_item_list[i])
            self.hero_item_list[i]:setBaseData(v[1], v[2])
        end
        self.hero_item_list[i]:IsGetStatus(has_get, 0, PathTool.getResFrame("actioneightlogin", "txt_cn_eight_login_get"))
    end
    
    -- self:showEffect(true)
    self:initGameData(hero_icon)
    local countdown = 0
    local list = self.flop_cfg.play_type
    local _type = "type_3"
    if table.indexof(list, 1) then
        for k, v in pairs(self.mod_info.play_param) do
            if v[1] == DdpSpecialType.Time then
                countdown = v[2][1]
                _type = v[2][2]
            end
        end
    end
    if countdown ~= 0 then
        self.time_node:setVisible(true)
        self.surplus_txt:setVisible(true)
        if countdown > 0 then 
            if countdown > 99 then
                local txt = "<img src=%s visible=true /><img src=%s visible=true /><img src=%s visible=true />"
                local a = math.floor(countdown/100)
                local b = math.floor(countdown%100/10)
                local c = math.floor(countdown%100%10)
                self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, a), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, b), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, c), false, _type)))
            elseif countdown > 9 then
                local txt = "<img src=%s visible=true /><img src=%s visible=true />"
                local b = math.floor(countdown/10)
                local c = math.floor(countdown%10)
                self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, b), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, c), false, _type)))
            else
                local txt = "<img src=%s visible=true />"
                self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, countdown), false, _type)))
            end
        end
        self.surplus_txt:setPositionX(self.time_node:getPositionX() - self.time_txt:getContentSize().width/2 - 10)
    else
        doStopAllActions(self.time_txt)
        self.time_node:setVisible(false)
        self.surplus_txt:setVisible(false)
    end
end
function ActionDdpGameWindow:updateTime()
    local countdown = 0
    local list = self.flop_cfg.play_type
    local _type = "type_3"
    if table.indexof(list, 1) then
        for k, v in pairs(self.mod_info.play_param) do
            if v[1] == DdpSpecialType.Time then
                countdown = v[2][1]
                _type = v[2][2]
            end
        end
    end
    if countdown ~= 0 then
        self.time_node:setVisible(true)
        commonCountDownTime(self.time_txt,countdown,{callback=function(time)
            if time > 0 then 
                if time > 99 then
                    local txt = "<img src=%s visible=true /><img src=%s visible=true /><img src=%s visible=true />"
                    local a = math.floor(time/100)
                    local b = math.floor(time%100/10)
                    local c = math.floor(time%100%10)
                    self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, a), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, b), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, c), false, _type)))
                elseif time > 9 then
                    local txt = "<img src=%s visible=true /><img src=%s visible=true />"
                    local b = math.floor(time/10)
                    local c = math.floor(time%10)
                    self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, b), false, _type),PathTool.getResFrame("num", string.format("%s_%s", _type, c), false, _type)))
                else
                    local txt = "<img src=%s visible=true />"
                    self.time_txt:setString(string.format(txt,PathTool.getResFrame("num", string.format("%s_%s", _type, time), false, _type)))
                end
            else
                doStopAllActions(self.time_txt)
                GlobalEvent:getInstance():Fire(ActionEvent.DdpGameFailEvent)
            end
        end})
    else
        doStopAllActions(self.time_txt)
        self.time_node:setVisible(false)
    end
    self.is_can_time = false
end
function ActionDdpGameWindow:initGameData(hero_icon)
    local hero_type_num = #hero_icon
    local need_hero_num = self.all_item_num * 0.5
    local random_hero_index = self:get_random_list(hero_type_num)
    local random_heros = {}
    for k, v in pairs(random_hero_index) do
        if k <= need_hero_num then
            table_insert(random_heros, hero_icon[v])
            table_insert(random_heros, hero_icon[v])
        end
    end
    local random_hero = self:get_random_list(self.all_item_num)
    self.heros = {}
    for h, j in pairs(random_hero) do
        local hero = {}
        hero.id = random_heros[j]
        hero.open = false
        hero.card_icon = self.card_icon
        hero.icon_type = self.icon_type
        hero.camp_id = self.action_id
        table_insert(self.heros, hero)
    end
    local difficulty = self.mod_info.dispose
    local difficulty_x = difficulty[1]
    local difficulty_y = difficulty[2]
    local space = 5
    local item_group_width = self.item_group:getContentSize().width
    local item_group_height = self.item_group:getContentSize().height
    local item_group_pos_x = item_group_width * 0.5
    local item_group_pos_y = item_group_height * 0.5
    local item_width = 110
    local item_height = 110

    local first_pos_x = item_group_pos_x - (item_width + space) * (difficulty_x - 1) * 0.5
    local first_pos_y = item_group_pos_y + (item_width + space) * (difficulty_y - 1) * 0.5
    self.reward_item_list = {}
    for i = 1, tableLen(self.heros) do
        local reward_item
        local reward_item_obj = self.heros[i]
        if not reward_item then
            reward_item = ActionDdpItem.new()
            local item_x = first_pos_x + (i - 1) % difficulty_x * (item_width + space)
            local item_y = first_pos_y - math.floor((i - 1) / difficulty_x) * (item_width + space)
            reward_item:setPosition(item_x, item_y)
            reward_item:setTouchEnabled(true)
            self.item_group:addChild(reward_item)
            self.reward_item_list[i] = reward_item
        end
        reward_item:setData(reward_item_obj)
    end

    self.step_num:setString(string.format("%s/%s",self.current_step,self.diff_limit))
end

function ActionDdpGameWindow:get_random_list(n)
    local map = {}
    local list = {}
    for i = 1, n do
        local r = math.random(i, n)
        local a = r
        if map[r] then
            a = map[r]
        end
        table.insert(list, a)
        map[r] = map[i] or i
    end
    return list
end

