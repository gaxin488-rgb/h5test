function ActionDailyValuePackItem:setExtendData(bid)
    self.hoilday_bid = bid
end
function ActionDailyValuePackItem:register_event( )
    registerButtonEventListener(self.buy_btn, function()
        if self.buy_btn_touch == 2 then
            message(TI18N("语言_c_1684"))
            return
        end
        local status = self.hoilday_bid == ActionRankCommonType.CopyValuePackage or self.hoilday_bid == ActionRankCommonType.CopyValuePackage2 or self.hoilday_bid == ActionRankCommonType.CopyValuePackage3 or self.hoilday_bid == ActionRankCommonType.CopyValuePackage4 or self.hoilday_bid == ActionRankCommonType.CopyValuePackage5 or self.hoilday_bid == ActionRankCommonType.CopyValuePackage6
        self.mopup_data = controller:getActionSubTabVo(ActionRankCommonType.NewYearMoppingUp)
        if self.mopup_data and status then
            self.camp_id = self.mopup_data.camp_id
            self.const_cfg = Config.HolidayNewYearData.data_const[self.camp_id]
            local charge_id = self.data.aim_args[6] and self.data.aim_args[6].aim_args_val
            local addnum = 0
            if charge_id then
                addnum = model:getNewYearMoppingUseNum(charge_id)
            end
            local have_num = RoleController:getInstance():getRoleVo():getActionAssetsNumByBid(self.const_cfg.gold_id) 
            if have_num > 0 and addnum < self.const_cfg.gold_limit then
                controller:openActionDailyValueDiscountCouponWindow(true,self.data)
                return
            end
        end
        controller:openActionDailyValuePackTipWindow(true,self.data)
    end,true, 1)
end

function ActionDailyValuePackItem:DeleteMe()
    if next(self.goods_list) then
        for key,value in pairs(self.goods_list) do
            value:removeFromParent()
            value = nil
        end
        self.goods_list = {}
    end
    doStopAllActions(self.time_txt)
end