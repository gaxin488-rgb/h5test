--
-- @description: 每日超值礼包
-- *******************************
ActionDailyValuePack = class("ActionDailyValuePack", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()
local color_text = {
    [1] = cc.c4b(0x80,0xf7,0x31,0xff),
    [2] = cc.c4b(0x64,0x32,0x23,0xff),
}

function ActionDailyValuePack:ctor(bid)
    self.holiday_bid = model:getDailyValuePackId()
    self.holiday_bid2 = bid
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("daily_value","daily_value"), type = ResourcesType.plist}
	}
    if not self.resources_load then
        self.resources_load = ResourcesLoad.New(true)
        self.resources_load:addAllList(self.res_list, function()
            if self.loadResListCompleted then
                self:loadResListCompleted()
            end
        end)
    end
end
function ActionDailyValuePack:loadResListCompleted(  )
    self:configUI()
	self:register_event()
    if self.holiday_bid2 then
        controller:cs16603(self.holiday_bid2)
    end
end

function ActionDailyValuePack:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_fantasy_mmission"))
    self.root_wnd:setPosition(-40, -64)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_con = self.main_container:getChildByName("title_con")
    self.title_img = self.title_con:getChildByName("title_img")
    self.time_panel = self.title_con:getChildByName("time_panel")
    self.time_panel:setPositionY(-5)
    -- self.time_panel:setVisible(false)
    self.time_label = self.title_con:getChildByName("label_time_key")
    self.time_label:setString(TI18N("语言_c_1113"))
    self.time_label:setPositionY(10)
    -- self.time_label:setVisible(false)
    self.time_text = self.title_con:getChildByName("label_time")
    self.time_text:setPositionY(10)
    self.time_text:setTextColor(color_text[1])
    self.time_text:setAnchorPoint(cc.p(0, 0.5))
    -- self.time_text:setPosition(cc.p(10,10))
    self.btn_rule = self.title_con:getChildByName("btn_rule") --规则说明按钮，，就是问号的图片
    self.btn_rule:setVisible(false)
    self.good_cons = self.main_container:getChildByName("charge_con")
    self.good_cons:setBounceEnabled(false)
    self.good_cons:setScrollBarEnabled(false)
    self.Sprite_3 = self.main_container:getChildByName("Sprite_3")
    self.Sprite_3:setVisible(false)
    self:loadBannerImage()

    MonopolyController:getInstance():sender16811(self.holiday_bid2)
end
function ActionDailyValuePack:loadBannerImage()
    local str_banner = "txt_cn_daily_value_1"
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid2)
    if tab_vo and tab_vo.reward_title ~= "" and tab_vo.reward_title then
        str_banner = tab_vo.reward_title
    end
    if self.holiday_bid2 == ActionRankCommonType.CopyValuePackage5 then
        local res = PathTool.getWelfareBannerRes(str_banner)
        loadSpriteTexture(self.title_img, res, LOADTEXT_TYPE)
    else
        local res = PathTool.getResFrame("daily_value", str_banner, false,"daily_value")
        loadSpriteTexture(self.title_img, res, LOADTEXT_TYPE_PLIST)
    end
   
    self:setData()
end
function ActionDailyValuePack:register_event()
    if not self.update_action_even_event  then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE,function (data)
            if data and data.bid == self.holiday_bid2 then
                controller:openActionDailyValuePackTipWindow(false,self.data)
                self:setData(data)
            end
        end)
    end
    -- -- 道具数量更新
    -- if not self.ADD_GOODS  then
    --     self.ADD_GOODS = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS,function (bag_code, data_list)
    --         self:setDiscountCouponNum(bag_code, data_list)
    --     end)
    -- end
    -- if not self.DELETE_GOODS  then
    --     self.DELETE_GOODS = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS,function (bag_code, data_list)
    --         self:setDiscountCouponNum(bag_code, data_list)
    --     end)
    -- end
    -- if not self.MODIFY_GOODS_NUM  then
    --     self.MODIFY_GOODS_NUM = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM,function (bag_code, data_list)
    --         self:setDiscountCouponNum(bag_code, data_list)
    --     end)
    -- end

    if self.role_assets_event == nil then
        if self.role_vo then
            self.role_assets_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ACTION_ASSETS,function(key ,value) 
                if self.const_cfg and key and key == self.const_cfg.gold_id then
                    self:setDiscountCouponNum()
                end
            end)
        end
    end   
    if self.coupon_change_event == nil then
        self.coupon_change_event = GlobalEvent:getInstance():Bind(ActionEvent.NewYearMoppingData,function(key ,value) 
            self:taskUpdataItem()
        end)
    end   

    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        if self.const_cfg then
            local desc= self.const_cfg.gift_txt
            if desc then
                TipsManager:getInstance():showCommonTips(desc, sender:getTouchBeganPosition())
            end
        end
    end,true, 1)
end

function ActionDailyValuePack:setDiscountCouponNum()
    if self.const_cfg.gold_id then
        local have_num = self.role_vo:getActionAssetsNumByBid(self.const_cfg.gold_id)
        local str = self.const_cfg.gift_title
        if self.discount_coupon_txt then
            self.discount_coupon_txt:setString(string.format(str,have_num))
        end
    end
end

function ActionDailyValuePack:setData(data)
    --判断新年扫荡是否开启
    local status = self.holiday_bid2 == ActionRankCommonType.CopyValuePackage or self.holiday_bid2 == ActionRankCommonType.CopyValuePackage2 or self.holiday_bid2 == ActionRankCommonType.CopyValuePackage3 or self.holiday_bid2 == ActionRankCommonType.CopyValuePackage4 or self.holiday_bid2 == ActionRankCommonType.CopyValuePackage5 or self.holiday_bid2 == ActionRankCommonType.CopyValuePackage6
    self.mopup_data = controller:getActionSubTabVo(ActionRankCommonType.NewYearMoppingUp)
    if self.mopup_data and status then
        self.camp_id = self.mopup_data.camp_id
        self.const_cfg = Config.HolidayNewYearData.data_const[self.camp_id]
        if not self.discount_coupon_txt then
            self.discount_coupon_txt = createRichLabel(20,cc.c4b(0x00,0xff,0x00,0xff),cc.p(1,0),cc.p(700,-5),nil,nil,700)
            self.title_con:addChild(self.discount_coupon_txt)
        end
        local str = self.const_cfg.gift_title
        local have_num = self.role_vo:getActionAssetsNumByBid(self.const_cfg.gold_id) 
        self.discount_coupon_txt:setString(string.format(str,have_num))
        local function clickLinkCallBack( type )
            if type == "href" then
                local desc= self.const_cfg.gift_txt
                if desc then
                    TipsManager:getInstance():showCommonTips(desc, cc.p(700,850))
                end
            end
        end
        self.discount_coupon_txt:addTouchLinkListener(clickLinkCallBack,{"href"})
        self.btn_rule:setVisible(true)
        self.btn_rule:setPositionX(680)
    else
        if self.discount_coupon_txt then
            self.discount_coupon_txt:setVisible(false)
        end
    end


    if data then
        self.data = data 
    else
        self.data = model:getValuePackageData(self.holiday_bid2)
    end
    local time = self.data.remain_sec or 0
	commonCountDownTime(self.time_text, time)
    -- self.time_label:setPositionX(self.time_text:getPositionX() - self.time_text:getContentSize().width - 10)
    self.time_label:setPositionX(10 + self.time_label:getContentSize().width)
    self.time_text:setPositionX(self.time_label:getPositionX() + 10)
    self.time_panel:setContentSize(self.time_label:getContentSize().width + self.time_text:getContentSize().width + 30,self.time_panel:getContentSize().height)
    self.time_panel:setPositionX(self.time_panel:getContentSize().width)
    if self.task_view == nil then
        local scroll_view_size = self.good_cons:getContentSize()
        local setting = {
            item_class = ActionDailyValuePackItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 7,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 226,               -- 单元的尺寸width
            item_height = 309,              -- 单元的尺寸height
            row = 2,                        -- 行数，作用于水平滚动类型
            col = 3            
        }
        self.task_view = CommonScrollViewLayout.new(self.good_cons, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    self.task_view:setData(self.data.aim_list,nil,nil,self.holiday_bid2)

    -- self.task_view:updataItem(bag_code, data_list, is_update)
    if tableLen(self.data.aim_list) > 6 then
        self.Sprite_3:setVisible(true)
    else
        self.Sprite_3:setVisible(false)
    end
end

function ActionDailyValuePack:taskUpdataItem()
    if self.data and self.holiday_bid2 then
        self.task_view:setData(self.data.aim_list,nil,nil,self.holiday_bid2)
    end
end

function ActionDailyValuePack:DeleteMe()
    doStopAllActions(self.time_text)

    if self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    if self.coupon_change_event then
        self.coupon_change_event = GlobalEvent:getInstance():UnBind(self.coupon_change_event)
        self.coupon_change_event = nil
    end
    if self.ADD_GOODS then
        self.ADD_GOODS = GlobalEvent:getInstance():UnBind(self.ADD_GOODS)
        self.ADD_GOODS = nil
    end
    if self.DELETE_GOODS then
        self.DELETE_GOODS = GlobalEvent:getInstance():UnBind(self.DELETE_GOODS)
        self.DELETE_GOODS = nil
    end
    if self.MODIFY_GOODS_NUM then
        self.MODIFY_GOODS_NUM = GlobalEvent:getInstance():UnBind(self.MODIFY_GOODS_NUM)
        self.MODIFY_GOODS_NUM = nil
    end
    if self.role_assets_event then
        self.role_assets_event = GlobalEvent:getInstance():UnBind(self.role_assets_event)
        self.role_assets_event = nil
    end
    
end

--每日超值礼包 子项
ActionDailyValuePackItem = class("ActionDailyValuePackItem", function()
    return ccui.Widget:create()
end)

function ActionDailyValuePackItem:ctor()
    self.goods_list = {}
    self.buy_btn_touch = 1
    self:configUI()
    self:register_event()
end

function ActionDailyValuePackItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_daily_value_pack_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(226,309))
	self:setTouchEnabled(false)

    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("container")
    self.Panel_1 = self.main_container:getChildByName("Panel_1")
    self.buy_btn = self.main_container:getChildByName("Image_2")
    self.price = self.buy_btn:getChildByName("Text_1_0")
    self.icon_bg = self.main_container:getChildByName("Sprite_2")
    self.Panel_2 = self.main_container:getChildByName("Panel_2")
    self.icon_bg_2 = self.main_container:getChildByName("Sprite_3")
    self.icon_bg_2:setVisible(false)
    self.icon = self.Panel_2:getChildByName("Sprite_1")
end

function ActionDailyValuePackItem:setData(data) 
    self.data = data
    local time = data.aim_args[13].aim_args_val - GameNet:getInstance():getTime()
    self.time_txt = createLabel(22, nil, nil, 0, 0, "", self, nil, cc.p(0,0))
    commonCountDownTime(self.time_txt, time, {callback = function(time) 
        if time <= 0 then
            self:setVis()
            return
        end       
    end})
    if next(self.goods_list) then
        for key,value in pairs(self.goods_list) do
            value:setVisible(false)
        end
    end
    self:setReward()
    if not self.purchaseLimit then
        self.purchaseLimit = createRichLabel(16,cc.c4b(0xff,0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(110,77),FONT_COMMON_LINE_SPACE,nil)
        self.main_container:addChild(self.purchaseLimit)
    end
    if data and data.aim_args and tableLen(data.aim_args) == 0 then return end
    local str = ""
    if data.aim_args[12].aim_args_val >= 99 then
        str = "<div fontcolor=#ffffff outline=2,#000000>"..string.format(TI18N("语言_c_1693"),string.format("%s/%s",(data.aim_args[3].aim_args_val-data.aim_args[4].aim_args_val),data.aim_args[3].aim_args_val)).."</div>"
        self.purchaseLimit:setString(str)
    else
        str = "<div fontcolor=#ffffff outline=2,#000000>"..string.format(TI18N("语言_c_5282"),data.aim_args[12].aim_args_val,string.format("%s/%s",(data.aim_args[3].aim_args_val-data.aim_args[4].aim_args_val),data.aim_args[3].aim_args_val)).."</div>"
        self.purchaseLimit:setString(str)
    end
    local chargeId = data.aim_args[6].aim_args_val
    local chargeCfg = Config.ChargeData.data_charge_data[chargeId]
    if not chargeCfg then return end
    local price = string.format(TI18N("语言_c_4440"), (GetMoneyNum(chargeCfg, "val")))
    self.price:setString(price)
    if data.aim_args[4].aim_args_val >= data.aim_args[3].aim_args_val then
        addRedPointToNodeByStatus(self.buy_btn,false)
        setChildUnEnabled(true,self.buy_btn)
        -- self.buy_btn:setTouchEnabled(false)
        self.buy_btn_touch = 2
        self.price:setString(TI18N("语言_c_210"))
    else
        setChildUnEnabled(false,self.buy_btn)
        self.buy_btn_touch = 1
        if chargeCfg.val == 0 then
            addRedPointToNodeByStatus(self.buy_btn,true,10,10)
        end
    end
    if data.aim_args[9].aim_args_val == 0 then
        self.icon_bg:setVisible(false)
        local st = string.format("daily_value_%s",data.aim_args[8].aim_args_val)
        -- self.icon:setPositionY(235)
        -- self.icon:setPositionX(110)
        self.icon:setScale(1)
        self.icon_bg_2:setVisible(true)
        loadSpriteTexture(self.icon,PathTool.getResFrame("daily_value",st), LOADTEXT_TYPE_PLIST)
    else
        self.icon_bg:setVisible(true)
        local cfg = Config.PartnerData.data_partner_base[data.aim_args[9].aim_args_val]
        if cfg then
            local id = 8 + cfg.camp_type
            loadSpriteTexture(self.icon_bg,PathTool.getResFrame("daily_value", "daily_value_"..id,false), LOADTEXT_TYPE_PLIST)
            local posX = 0
            local posY = 0
            if data.aim_args[10] and data.aim_args[11] then
                posX = data.aim_args[10].aim_args_val
                posY = data.aim_args[11].aim_args_val
            end
            self.icon:setPositionX(80 + posX)
            self.icon:setPositionY(-50 + posY)
            self.icon:setScale(0.55)
            local res_id = data.aim_args[9].aim_args_str
            if res_id and res_id ~= "" then
                loadSpriteTexture(self.icon, PathTool.getPlistImgForDownLoad("herodraw/herodrawres", res_id,false), LOADTEXT_TYPE)
            end
            self.icon_bg_2:setVisible(false)
        end
    end
end
function ActionDailyValuePackItem:setVis()
    local aim = self.data.aim
    local data = deepCopy(model:getValuePackageData(self.hoilday_bid))
    for key, value in pairs(data.aim_list or {}) do
        if value.aim == aim then
            table.remove(data.aim_list,key)
        end
    end
    model:setValuePackageData(data)
    doStopAllActions(self.time_txt)
end
function ActionDailyValuePackItem:setReward()
    if not self.data.item_list then return end
    self.rewardPos = {cc.p(10,90),cc.p(80,90),cc.p(150,90),cc.p(10,170)}
    local charge_id = self.data.aim_args[6] and self.data.aim_args[6].aim_args_val
    local addnum = 0
    if charge_id then
        addnum = model:getNewYearMoppingUseNum(charge_id)
    end
    for key, value in pairs(self.data.item_list) do
        local showvalue = deepCopy(value)
        local _scale = 0.6
        if key > 3 then
            _scale = 0.45
        end
        if not self.goods_list[key] then
            local reward = BackPackItem.new(false,true,nil,_scale,true,true)
            self.goods_list[key] = reward
            if addnum and addnum ~= 0 then
                if showvalue.bid == 3 then
                    showvalue.num = showvalue.num*(1 + addnum*0.1)
                    reward:setHeroEquipComposeMark(true)
                end
            end
            reward:setAnchorPoint(cc.p(0,0))
            reward:setPosition(self.rewardPos[key])
            self.main_container:addChild(reward)
            reward:setNumSacl(1.2)
        end
        local reward = self.goods_list[key]
        reward:setData(showvalue)
        reward:setVisible(true)
    end
end
