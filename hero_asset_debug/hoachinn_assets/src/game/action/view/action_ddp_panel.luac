-- @description:	--对对碰翻牌
ActionDdpPanel = class("ActionDdpPanel", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = ActionController:getInstance():getModel()

function ActionDdpPanel:ctor(bid,id,remain_sec)
    self.holiday_bid = bid
    self.remain_sec = remain_sec
    local tabvo = controller:getActionSubTabVo(self.holiday_bid)
    local campid = tabvo.camp_id -- 活动的唯一Id
    local flop_cfg = Config.HolidayFlopData.data_flop_act_list[campid]
    local banner_pic = flop_cfg.title
    self.tab_list = {}
    self.award_item_list = {}
    self.arriveLuckly_label = {}
    self.res_list = {
        -- {path = PathTool.getPlistImgForDownLoad("pairtopair", pairtopair),type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("pairtopair", "txt_cn_pairtopair_1"),type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("pairtopair", "txt_cn_pairtopair_title_1"),type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("actioneightlogin", "actioneightlogin"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("planesafkorderaction","planesafkorderaction"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("common","common_2"), type = ResourcesType.plist},
    }
    if banner_pic then
        table.insert(self.res_list, {path = PathTool.getPlistImgForDownLoad("pairtopair", banner_pic),type = ResourcesType.single})
    end
    self.resources_load = ResourcesLoad.New(true)
    self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
            self:loadResListCompleted()
        end
    end)
end

function ActionDdpPanel:loadResListCompleted()
    self:configUI()
    self:register_event()
    MonopolyController:getInstance():sender16811(ActionStorageBool2.DdpFirst)
end

function ActionDdpPanel:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_ddp_panel"))
    self.root_wnd:setPosition(cc.p(-40, -80))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self.choose_index = 0

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.bg = self.main_container:getChildByName("bg")
    -- 特效
    -- self.effect_layer = self.main_container:getChildByName("effect_layer") -- 模型
    self.banner = self.main_container:getChildByName("banner")
    self.top_list = {}
    self.help_btn = self.main_container:getChildByName("btn_rule")
    self.time_txt = self.main_container:getChildByName("time_txt")
    self.time_txt:setString(TI18N("语言_c_1242"))
    self.act_time = self.main_container:getChildByName("act_time")
    setItemXOneByOne({self.time_txt, self.act_time})
    self.tab_view = self.main_container:getChildByName("tab_view")
    self.tab_view:setScrollBarEnabled(false)
    self.itembg = self.main_container:getChildByName("itembg")
    self.title1 = self.main_container:getChildByName("title1")
    self.title1:setString(TI18N("语言_c_5149"))
    self.title2 = self.main_container:getChildByName("title2")
    self.title2:setString(TI18N("语言_c_532"))

    self.item_container1 = self.main_container:getChildByName("item_container1")
    self.item_container1:setScrollBarEnabled(false)

    self.item_container2 = self.main_container:getChildByName("item_container2")
    self.item_container2:setScrollBarEnabled(false)

    local scroll_view_size = self.item_container1:getContentSize()
    local setting = {
        item_class = BackPackItem, -- 单元类
        start_x = 0, -- 第一个单元的X起点
        space_x = 10, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = BackPackItem.Width * 0.8, -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.8, -- 单元的尺寸height
        row = 1, -- 行数，作用于水平滚动类型
        col = 0, -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.item_scrollview1 = CommonScrollViewLayout.new(self.item_container1, cc.p(0, 0), ScrollViewDir.horizontal,
        ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview1:setSwallowTouches(false)

    local scroll_view_size2 = self.item_container2:getContentSize() -- self.item_container2:getContentSize()
    local setting2 = {
        item_class = BackPackItem, -- 单元类
        start_x = 0, -- 第一个单元的X起点
        space_x = 10, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = BackPackItem.Width * 0.8, -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.8, -- 单元的尺寸height
        row = 1, -- 行数，作用于水平滚动类型
        col = 0, -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.item_scrollview2 = CommonScrollViewLayout.new(self.item_container2, cc.p(0, 0), ScrollViewDir.horizontal,
        ScrollViewStartPos.top, scroll_view_size2, setting2)
    self.item_scrollview2:setSwallowTouches(false)

    self.btn_go = self.main_container:getChildByName("btn_go")
    self.btn_go_label = self.btn_go:getChildByName("Text_8")
    self.btn_go_label:setString(TI18N("语言_c_457"))

    self.finish_img = self.main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    
    self.progress_panel = self.main_container:getChildByName("progress_panel")
    self.war_btn = self.progress_panel:getChildByName("war_btn")
    self.war_txt = self.war_btn:getChildByName("war_txt")
    setTextSpacing(self.war_txt,-10)
    self.war_txt:setChangeScaleOffWidth(-1000)
    self.progress = self.progress_panel:getChildByName("progress")
	self.progress:setScale9Enabled(true)
    self.action_panel = self.root_wnd:getChildByName("action_panel")
    self.game_panel = self.action_panel:getChildByName("game_panel")
    self.back_btn = self.action_panel:getChildByName("back_btn")
    self.back_txt = self.action_panel:getChildByName("back_txt")
    self.back_txt:setString(TI18N("语言_c_10"))
    self.action_panel:setVisible(false)

    controller:sender29600()
    -- self:showEffect(true)
    self:updatePanelRes()
    -- self:updateTabView(true)
end

