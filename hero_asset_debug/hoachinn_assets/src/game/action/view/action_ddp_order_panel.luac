local _controller = ActionController:getInstance()
local _model = _controller:getModel()

ActionDdpOrderPanel = ActionDdpOrderPanel or BaseClass(BaseView)

function ActionDdpOrderPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "action/action_ddp_order_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planesafkorderaction","planesafkorderaction"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("ninja_treasure/ninja_treasure","ninja_treasure"), type = ResourcesType.plist },
        {path = PathTool.getPlistImgForDownLoad("heaven","heaven"), type = ResourcesType.plist},
	}
    self.role_vo = RoleController:getInstance():getRoleVo()
end

function ActionDdpOrderPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
	self.container = container
    self:playEnterAnimatianByObj(container, 2)
	self.item_panel = container:getChildByName("item_panel")
    self.bg = container:getChildByName("bg")
	self.btn_panel = container:getChildByName("btn_panel")
	self.buy_btn_1 = self.btn_panel:getChildByName("buy_btn_1")
	self.btn_txt_1 = self.buy_btn_1:getChildByName("btn_txt")
	self.btn_txt_1:setString(TI18N("语言_c_6840"))
    self.btn_txt_1_1 = self.buy_btn_1:getChildByName("btn_txt_1")
	self.btn_txt_1_1:setString(TI18N("语言_hol_sta_pa_01_2"))
	
	self.buy_btn_2 = self.btn_panel:getChildByName("buy_btn_2")
	self.btn_tip_2 = self.buy_btn_2:getChildByName("btn_tip")
	self.tip_txt_2 = createRichLabel(24, cc.c3b(0xff,0xff,0xff), cc.p(0.5,0), cc.p(140,85),-10)
	self.tip_txt_2:setHorizontalLayoutType(2)
	self.buy_btn_2:addChild(self.tip_txt_2)
	self.btn_txt_2 = self.buy_btn_2:getChildByName("btn_txt")
	self.btn_txt_2:setString(TI18N("语言_c_6435"))
	self.price_2 = createRichLabel(20, cc.c3b(0xff,0xff,0xff), cc.p(0.5,0.5), cc.p(self.buy_btn_2:getContentSize().width*0.5,17))
	self.price_2:setHorizontalLayoutType(2)
	self.buy_btn_2:addChild(self.price_2)
	self.btn_lock_2 = self.buy_btn_2:getChildByName("btn_lock")

	self.time_bg = container:getChildByName("time_bg")
    self.time_bg:setVisible(false)
	self.time_tip = self.time_bg:getChildByName("time_tip")
	self.time_tip:setString(TI18N("语言_c_6166"))
	self.time_label = self.time_bg:getChildByName("time_label")

    self.image_2 = container:getChildByName("image_2")
	self.win_title = container:getChildByName("win_title")
	self.close_btn = container:getChildByName("close_btn")
end

function ActionDdpOrderPanel:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openActionDdpOrderPanel(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openActionDdpOrderPanel(false)
	end, false, 2)

	registerButtonEventListener(self.buy_btn_2, function (  )
		self:clickBuyBtn()
	end, false, 2)

	if not self.treasure_order_event then
        self.treasure_order_event = GlobalEvent:getInstance():Bind(ActionEvent.UpdateDdpData, function ()
            self:setData()
        end)
    end
	if not self.treasure_order_con_event then
        self.treasure_order_con_event = GlobalEvent:getInstance():Bind(ActionEvent.Treasure_Order_Con_Event, function ()
            self:clickBuyBtn()
        end)
    end
end

function ActionDdpOrderPanel:clickBuyBtn()
    if _model:getDdpWarStatus() then
        message(TI18N("语言_c_1984"))
        return
    end
	local function fun()
        if self.charge_id then
            local charge_data = Config.ChargeData.data_charge_data[self.charge_id]
            if charge_data then
                sdkOnPay(charge_data.val, nil, charge_data.id, charge_data.name)
            else
                message("error")
            end
        end
	end
    local str = TI18N("语言_c_6469")
	CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, nil, nil, true)
end

function ActionDdpOrderPanel:setData()
	self.holiday_bid = _model:getDdpId()
    local tabvo = _controller:getActionSubTabVo(self.holiday_bid)
    if not tabvo then return end
    self.camp_id = tabvo.camp_id -- 活动的唯一Id
    self.flop_act_cfg = Config.HolidayFlopData.data_flop_act_list[self.camp_id]
    self.reward_cfg = Config.HolidayFlopData.data_war_order_info[self.camp_id]
    -- self.const_cfg = Config.HolidayCollectManualData.data_const[self.camp_id]
	-- self.reward_cfg = Config.HolidayCollectManualData.data_act_info[self.camp_id]
	self.charge_id = self.flop_act_cfg.war_order_charge_id
	self.win_title:setString(self.flop_act_cfg.war_order_title)
    moveTextBg(self.win_title,self.image_2,60,self.image_2:getContentSize().width)
    local res = PathTool.getTargetRes("pairtopair",self.flop_act_cfg.war_order_banner,false,false)
    loadSpriteTexture(self.bg, res, LOADTEXT_TYPE)
	self.tip_txt_2:setString(TI18N("语言_c_6162"))
	self.btn_tip_2:setContentSize(cc.size(math.max(self.tip_txt_2:getContentSize().width + 30,self.btn_tip_2:getContentSize().width),self.tip_txt_2:getContentSize().height + 20))
	-- self.end_time = tabvo and tabvo.remain_sec or 0
    -- if self.end_time > 86400 then
    --     _model:setCountDownTime(self.time_label,self.end_time - 86400)
    -- else
    --     self.time_label:setString(TI18N("语言_s_11"))
    -- end
	local charge_data = Config.ChargeData.data_charge_data[self.charge_id]
    local val = 198
    if charge_data then
        val = GetMoneyNum(charge_data,"val")
    end
	self.price_2:setString(string.format(TI18N("语言_c_6172"),val))
    self.btn_lock_2:setVisible(not _model:getDdpWarStatus())
	if _model:getDdpWarStatus() then
        self.price_2:setString(TI18N("语言_c_6252"))
	else
        self.price_2:setString(string.format(TI18N("语言_c_6172"),val))
	end
	self:setRewardPanel()
    self:updateScrollY()
end
function ActionDdpOrderPanel:updateScrollY()
    local num_tol = tableLen(self.reward_cfg)
    local list = _model:getDdpWarList()
    local data = deepCopy(self.reward_cfg)
    local num = tableLen(list)
    for key, value in pairs(data) do
        if list[value.level] then
            if _model:getDdpWarStatus() then
                if list[value.level].award_status == 0 or list[value.level].rmb_award_status == 0 then
                    num = value.level
                    break        
                end
            else
                if list[value.level].award_status == 0 then
                    num = value.level
                    break        
                end
            end
        end
    end
    local scroll_view_size = self.item_panel:getContentSize()
    local pos_per = 124 * (num - 1) * 100 / (num_tol * 124 - scroll_view_size.height)

    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_list:scrollToPercentVertical(pos_per, 0.5, true)
end
function ActionDdpOrderPanel:setRewardPanel()
	if self.reward_list == nil then
        local scroll_view_size = self.item_panel:getContentSize()
        local setting = {
            start_x = 0,
            space_x = 0,
            start_y = 5,
            space_y = 4,
            item_width = 650,
            item_height = 124,
            row = 0,
            col = 1,
            need_dynamic = true,
            checkovercallback = handler(self, self.updateSlideShowByVertical)
        }
        self.reward_list = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
        self.reward_list:setSwallowTouches(true)
        self.reward_list:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_list:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_list:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell

        --进度条相关
        local scroll_view_size2 = cc.size(100, scroll_view_size.height)
        local setting = {
            start_x = 10, -- 第一个单元的X起点
            space_x = 0, -- x方向的间隔
            start_y = 5, -- 第一个单元的Y起点
            space_y = 4, -- y方向的间隔
            item_width = 55, -- 单元的尺寸width
            item_height = 124, -- 单元的尺寸height
            row = 0, -- 行数，作用于水平滚动类型
            col = 1, -- 列数，作用于垂直滚动类型
            need_dynamic = true
        }
        self.reward_num_item = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
        self.reward_num_item:setClickEnabled(false)
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    end
    self.reward_list:reloadData(nil,nil,true)
    self.reward_num_item:reloadData(nil,nil,true)
end

-- 滑动的时候处理显示
function ActionDdpOrderPanel:updateSlideShowByVertical()
    local container_y = self.reward_list:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end
-- 奖励列表
function ActionDdpOrderPanel:createTaskCell()
    local cell = ActionDdpOrderItem.new()
    return cell
end

function ActionDdpOrderPanel:numberOfTaskCells()
    if not self.reward_cfg then
        return 0
    end
    return #self.reward_cfg
end

function ActionDdpOrderPanel:updateTaskCellByIndex(cell, index)
    if not self.reward_cfg then
        return
    end
    local cell_data = self.reward_cfg[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,index)
end

-- 进度条
-- 功勋数数列表
function ActionDdpOrderPanel:createTaskCell2()
    local cell = ActionDdpOrderLineItem.new()
    return cell
end

function ActionDdpOrderPanel:numberOfTaskCells2()
    if not self.reward_cfg then
        return 0
    end
    return #self.reward_cfg
end

function ActionDdpOrderPanel:updateTaskCellByIndex2(cell, index)
    if not self.reward_cfg then
        return
    end
    local cell_data = self.reward_cfg[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,index)
end
function ActionDdpOrderPanel:openRootWnd()
    self:setData()
end

function ActionDdpOrderPanel:close_callback(  )
    if self.treasure_order_event then
        GlobalEvent:getInstance():UnBind(self.treasure_order_event)
        self.treasure_order_event = nil
    end
	if self.treasure_order_con_event then
        GlobalEvent:getInstance():UnBind(self.treasure_order_con_event)
        self.treasure_order_con_event = nil
    end
	_controller:openActionDdpOrderPanel(false)
end


