ActionDdpOrderItem = class("ActionDdpOrderItem", function()
    return ccui.Widget:create()
end)

function ActionDdpOrderItem:ctor()
    self:configUI()
    self:register_event()
    self.item_list = {}
    self.item_list2 = {}
end

