end

function ActionDdpOrderItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        _controller:sender29605()
	end, true)
	registerButtonEventListener(self.btn_go, function()
		_controller:openActionDdpOrderPanel(false)
	end, true)
	registerButtonEventListener(self.btn_con, function()
        GlobalEvent:getInstance():Fire(ActionEvent.Treasure_Order_Con_Event)
	end, true)
end

function ActionDdpOrderItem:setData(data,index)
    self.rewardData = data
	self.index = index
	self.need_num = self.rewardData.score
    self.holiday_bid = _model:getDdpId()
    local tabvo = _controller:getActionSubTabVo(self.holiday_bid)
    if not tabvo then return end
    self.camp_id = tabvo.camp_id -- 活动的唯一Id
    self.cfg = Config.HolidayFlopData.data_war_order_info[self.camp_id]
    local txt = TI18N("语言_c_6887")
    -- local str = string.format(txt,self.need_num,_model:getOrderScore())
    local str = string.format(txt,self.need_num)
    self.title:setString(transformTextToShort(str,60))
    addEvt2showAllTextTips(self.title,str,60)
	local list = {}
    for index, value in ipairs(self.rewardData.free_award) do
        table.insert(list,index,value)
    end
    for key, value in pairs(self.item_list) do
        value:DeleteMe()
        value = nil
    end
    self.item_list = {}
	local scale_num = 0.7
	for key, value in pairs(list) do
        local item = BackPackItem.new(true,true,false,scale_num)
        item:setBaseData(value[1],value[2])
        table.insert(self.item_list,item)
        self.free_layer:addChild(item)
        item:setDefaultTip(true,false)
    end
	if tableLen(self.item_list) == 1 then
		self.free_layer:setTouchEnabled(false)
	else
		self.free_layer:setTouchEnabled(true)
	end
    local list_num = 5
    local _w = self.free_layer:getContentSize().width
    local row_y = math.ceil(tableLen(self.item_list)/list_num)
    local _h = math.max(self.free_layer:getContentSize().height,row_y * TreasureItem.Width * scale_num)
    self.free_layer:setInnerContainerSize(cc.size(_w,_h))
    local war_list = _model:getDdpWarList()
    for key, value in pairs(self.item_list) do
        local _x = (119 * scale_num + 10) * key -(119 * scale_num*0.5)
        local _y = self.free_layer:getContentSize().height*0.5
        value:setPosition(cc.p(_x,_y))
        if value.setReceiveIcon then
            value:setReceiveIcon(war_list[self.index] and war_list[self.index].award_status == 1 or false)
        end
    end

	local scale_num2 = 0.7
	local list2 = {}
    for index, value in ipairs(self.rewardData.rmb_award) do
        table.insert(list2,index,value)
    end
    for key, value in pairs(self.item_list2) do
        value:DeleteMe()
        value = nil
    end
    self.item_list2 = {}
	for key, value in pairs(list2) do
        local item = BackPackItem.new(true,true,false,scale_num2)
        item:setBaseData(value[1],value[2])
        table.insert(self.item_list2,item)
        self.goods_con:addChild(item)
        item:setDefaultTip(true,false)
    end
	if tableLen(self.item_list2) <= 2 then
		self.goods_con:setTouchEnabled(false)
	else
		self.goods_con:setTouchEnabled(true)
	end
	local list_num = 5
    local _w = math.max(self.goods_con:getContentSize().width,tableLen(self.item_list2) * 129 * scale_num2)
    local _h = self.goods_con:getContentSize().height
    self.goods_con:setInnerContainerSize(cc.size(_w,_h))
    for key, value in pairs(self.item_list2) do
        local _x = (119 * scale_num2 + 10) * key -(119 * scale_num2*0.5)
        local _y = self.goods_con:getContentSize().height*0.5
        value:setPosition(cc.p(_x,_y))
        if value.setReceiveIcon then
            value:setReceiveIcon(war_list[self.index] and war_list[self.index].rmb_award_status == 1 or false)
        end
    end

	self:setItemLock()
	self:setStatus()
end
function ActionDdpOrderItem:setItemLock()
	local lock_2 = not _model:getDdpWarStatus()
	for key, value in pairs(self.item_list2) do
		value:showOrderWarLock(lock_2)
	end
end
function ActionDdpOrderItem:setStatus()
	self.score = _model:getDdpWarScore()
	self.btn_go:setVisible(false)
	self.btn_get:setVisible(false)
	self.buy_img:setVisible(false)
	self.btn_con:setVisible(false)
    local war_list = _model:getDdpWarList()
	if self.score >= self.need_num then --积分已满足
        if _model:getDdpWarStatus() then
            if war_list[self.index] and war_list[self.index].award_status == 1 and war_list[self.index].rmb_award_status == 1 then
                self.locl_status = 2 --已领取
            else
                self.locl_status = 1 --可领取  
            end
        else
            if war_list[self.index] and war_list[self.index].award_status == 1 then
                self.locl_status = 3 --前往购买
            else
                self.locl_status = 1 --可领取
            end
        end
		if self.locl_status == 1 then
			self.btn_get:setVisible(true)
		elseif self.locl_status == 2 then
            self.buy_img:setVisible(true)
		elseif self.locl_status == 3 then
            self.btn_con:setVisible(true)
		end
	else--积分不满足
		self.btn_go:setVisible(true)
	end
end
function ActionDdpOrderItem:DeleteMe()
end


