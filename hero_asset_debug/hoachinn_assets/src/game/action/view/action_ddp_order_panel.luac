-- 功勋子项
ActionDdpOrderLineItem = class("ActionDdpOrderLineItem", function()
    return ccui.Widget:create()
end)

function ActionDdpOrderLineItem:ctor()
    self.size = cc.size(55, 124)
    self:configUI()
    self:register_event()
end

function ActionDdpOrderLineItem:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.select_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_2"),
        self.size.width / 2, self.size.height / 2 + 21, cc.p(0.5, 0.5), true)
	-- self.select_bg:setScale(0.7)
    self.select_img = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_1"),
        self.size.width / 2, self.size.height / 2 + 21, cc.p(0.5, 0.5), true)
    self.select_img:setVisible(false)
	-- self.select_img:setScale(0.7)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_11"),
        self.size.width / 2, 60, cc.p(0.5, 0.5), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(71, 37))
	self.num_bg:setScale(0.7)
    self.num_txt = createLabel(20, Config.ColorData.data_color4[1], nil, self.size.width / 2 - 2,
    60, "", self.root_wnd, nil, cc.p(0.5, 0.5))
end

function ActionDdpOrderLineItem:register_event()
end

function ActionDdpOrderLineItem:setData(data,index)
    if not data then
        return
    end
    self.data = data
	self.holiday_bid = _model:getDdpId()
    local tabvo = _controller:getActionSubTabVo(self.holiday_bid)
    if not tabvo then return end
    self.camp_id = tabvo.camp_id -- 活动的唯一Id
    local flop_list = Config.HolidayFlopData.data_flop_act_list[self.camp_id]
    self.select_bg:loadTexture(PathTool.getResFrame("pairtopair", flop_list.war_order_init_picture),LOADTEXT_TYPE_PLIST)
    local item_id = flop_list.war_order_item
    local item_cfg = Config.ItemData.data_get_data(item_id)
    self.select_img:loadTexture(PathTool.getItemRes(item_cfg.icon))
    self.cfg = Config.HolidayFlopData.data_war_order_info[self.camp_id]
    self.num_txt:setString(self.cfg[index].score)
    local score = _model:getDdpWarScore()
    if tonumber(score) >= tonumber(self.data.score) then
        self.select_img:setVisible(true)
    else
        self.select_img:setVisible(false)
    end
    -- 进度条相关
    local next_id = index + 1
    if self.cfg[next_id] then
        if self.comp_bar == nil then
            local size = cc.size(75, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(26, 65))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =
                createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 5, 1)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(120, 27))
            self.comp_bar:setContentSize(cc.size(105, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        if score >= self.cfg[index].score and score < self.cfg[next_id].score then
            self.comp_bar:setPercent((score - self.cfg[index].score)/ (self.cfg[next_id].score - self.cfg[index].score) * 100)
        elseif score >= self.cfg[next_id].score then
            self.comp_bar:setPercent(100)
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
    end
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(self.data.level)
end

function ActionDdpOrderLineItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end