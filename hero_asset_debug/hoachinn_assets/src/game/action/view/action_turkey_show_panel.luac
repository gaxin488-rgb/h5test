-- 
-- @description: 疯狂火鸡节首次进入说明
-- @DateTime:    2020-02-20
-- *******************************
ActionTurkeyShowPanel = ActionTurkeyShowPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local config = Config.HolidayGetninjaData
function ActionTurkeyShowPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_turkey_show_panel"
end

function ActionTurkeyShowPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2) 
    self.bg = self.main_container:getChildByName("bg")
    self.tip_1 = self.main_container:getChildByName("tip_1")
    self.tip_2 = self.main_container:getChildByName("tip_2")
    self.tip_3 = self.main_container:getChildByName("tip_3")
    self.go_btn = self.main_container:getChildByName("go_btn")
    self.go_txt = self.go_btn:getChildByName("txt")
    self.go_txt:setString(TI18N("语言_c_6414"))
end

function ActionTurkeyShowPanel:register_event()
    registerButtonEventListener(self.go_btn,function()
        controller:sender16809(self.bid,1,"")
        HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.Turkey,{},HeroConst.FormShowType.eFormSave)
        controller:openActionTurkeyShowPanel(false)
    end,true,2)
end
function ActionTurkeyShowPanel:openRootWnd(camp_id,bid)
    self.camp_id = camp_id
    self.bid = bid
    self.cfg = Config.HolidayCollectManualData.data_const[self.camp_id]
    local res = PathTool.getResFrame("holiday_collect_manual",self.cfg["rule_pic"].val[1])
    loadSpriteTexture(self.bg,res,LOADTEXT_TYPE_PLIST)
    local str = self.cfg["rule_infor_1"].val[1]
    self.tip_1:setString(transformTextToShort(str,40))
    setTextMaxWidth(self.tip_1,203)
    addEvt2showAllTextTips(self.tip_1,str,40)
    local str = self.cfg["rule_infor_2"].val[1]
    self.tip_2:setString(transformTextToShort(str,40))
    setTextMaxWidth(self.tip_2,290)
    addEvt2showAllTextTips(self.tip_2,str,40)
    local str = self.cfg["rule_infor_3"].val[1]
    self.tip_3:setString(transformTextToShort(str,40))
    setTextMaxWidth(self.tip_3,300)
    addEvt2showAllTextTips(self.tip_3,str,40)
    local res = PathTool.getResFrame("holiday_collect_manual",self.cfg["rule_icon_pic"].val[1])
    self.go_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
end
function ActionTurkeyShowPanel:close_callback()
    controller:openActionTurkeyShowPanel(false)
end
