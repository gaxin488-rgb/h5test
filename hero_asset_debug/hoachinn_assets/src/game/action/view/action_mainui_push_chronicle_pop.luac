		local res = PathTool.getResFrame("goldeqm", "goldeqm_" .. cfg.params[1])

		if ui._iconNode then
			ui._iconNode:removeFromParent()
			ui._iconNode = nil
		end
		if not ui._iconNode then
			local offset = cc.p(0, 0)
			local scale = 1
			if cfg.res_offset and cfg.res_offset[1] then
				local info = cfg.res_offset[1]
				if info[1] and info[1] ~= 0 then				
					scale = info[1]
				end
				offset.x = info[2] or 0
				offset.y = info[3] or 0
			end
			local targetPos =  cc.pAdd(cc.p(0, 280), offset)
			ui._iconNode = createSprite( res ,targetPos.x, targetPos.y + 15, ui._spineParentNode, cc.p(0.5, 0.5))

			local action = cc.Sequence:create(cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y - 15)),cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y + 15)))
			ui._iconNode:runAction(cc.RepeatForever:create(action))
			ui._iconNode:setScale(scale)
		end

	end
end

--编年史
function ActionMainuiPushChroniclePop:_updateChronicle()
	local cfg = self._data.cfg
	local ui = self
	if cfg.params and cfg.params[1] then
		local star_cfg = Config.NinjaTreasureData.data_star_info[cfg.params[1]]
		if star_cfg then
			local res = string.format("resource/ninja_treasure/treasure_item/%s.png",star_cfg[1].icon)
			if ui._iconNode then
				ui._iconNode:removeFromParent()
				ui._iconNode = nil
			end
			if not ui._iconNode then
				local offset = cc.p(0, 0)
				local scale = 1
				if cfg.res_offset and cfg.res_offset[1] then
					local info = cfg.res_offset[1]
					if info[1] and info[1] ~= 0 then
						scale = info[1]
					end
					offset.x = info[2] or 0
					offset.y = info[3] or 0
				end
				local targetPos =  cc.pAdd(cc.p(0, 0), offset)
				ui._iconNode = createSprite( nil,targetPos.x, targetPos.y, ui._spineParentNode, cc.p(0.5, 0.5))
				loadSpriteTexture(ui._iconNode,res,LOADTEXT_TYPE)
	
				-- local action = cc.Sequence:create(cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y - 15)),cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y + 15)))
				-- ui._iconNode:runAction(cc.RepeatForever:create(action))
				ui._iconNode:setScale(scale)
			end
		end
		self._type_img:setVisible(true)--f7eead
		self.chronicle_name = createRichLabel(22, cc.c4b(0xf7, 0xee, 0xad, 0xff), cc.p(0.5,0.5), cc.p(360, 607))
		self._root:addChild(self.chronicle_name)
		--createLabel(22, cc.c4b(0xf7, 0xee, 0xad, 0xff), cc.c4b(0x00, 0x00, 0x00, 0xff), 360, 607, "", self._root, 0, cc.p(0.5,0.5))
		self.chronicle_name:setString(string.format("<div outline=2,#000000>%s</div>",TI18N("语言_nin_tre_02_"..cfg.params[1])))
	end
end

function ActionMainuiPushChroniclePop:updateData()
	if not self._data then
		return
	end
	local ui = self
	local cfg = self._data.cfg

	if cfg.bg_img and cfg.bg_img ~= "" then
		loadSpriteTexture(ui._bg,PathTool.getActivityPush(cfg.bg_img),LOADTEXT_TYPE)
	end

	if cfg.push_type == 2 then
		-- 精灵
		if cfg.title_img and cfg.title_img ~= "" then
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img),LOADTEXT_TYPE)
		else
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_4"),LOADTEXT_TYPE)
		end
		ui._titleSprite:setPosition(cc.p(360, 972))
		self:_updateElfin()
	elseif cfg.push_type == 3 then
		-- 禁器
		if cfg.title_img and cfg.title_img ~= "" then
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img),LOADTEXT_TYPE)
		else
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_5"),LOADTEXT_TYPE)
		end
		
		ui._titleSprite:setPosition(cc.p(360, 1150))
		self:_updateJinqi()
		
	elseif cfg.push_type == 4 then
		-- 金裝
		if cfg.title_img and cfg.title_img ~= "" then
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img), LOADTEXT_TYPE)
		else
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_6"), LOADTEXT_TYPE)
		end

		ui._titleSprite:setPosition(cc.p(360, 1150))
		self:_updateGoldEquip()
	elseif cfg.push_type == 5 then
		-- 神装
		if cfg.title_img and cfg.title_img ~= "" then
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img), LOADTEXT_TYPE)
		else
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_7"), LOADTEXT_TYPE)
		end
		--策划需求  改位置 隐藏背景
		ui._titleSprite:setPosition(cc.p(360, 1000))
		ui._bg:setVisible(false)
		self:_updateHolyEqm()

	elseif cfg.push_type == 6 then
		-- 编年史
		if cfg.title_img and cfg.title_img ~= "" then
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img),LOADTEXT_TYPE)
		else
			loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_7"),LOADTEXT_TYPE)
		end
		ui._titleSprite:setPosition(cc.p(360, 972))
		self:_updateChronicle()
	end

	local actionData = ActionController:getInstance():getOverViewActiondata(cfg.activity_id)
	if actionData then
		local remain_sec = actionData.remain_sec
		local surplus_time = 0
		if cfg.end_time_adjust then
			surplus_time = cfg.end_time_adjust*3600
			remain_sec = actionData.remain_sec - surplus_time
		end
		if remain_sec and remain_sec > 0 then
			commonCountDownTime(ui._richText, remain_sec, {
				time_color="#08e908",
				outline="#000000",
				time_title=string.format("<div fontcolor=#ffffff outline=2,#000000>%s</div>", TI18N("语言_c_13")),
				label_type= CommonAlert.type.rich,
				str_end = TI18N("语言_c_233")
			})
		else
			ui._richText:setString("")
		end
	end

	if cfg.ani_show and cfg.ani_show[1] then
		local ani_show = cfg.ani_show[1]
		if ani_show[1] and ani_show[1] ~= "" then
			local offset = cc.p(ani_show[2] or 0, ani_show[3] or 0)
			if ui._effectSpine then
				ui._effectSpine:removeFromParent()
				ui._effectSpine = nil
			end
			ui._effectSpine = createEffectSpine( ani_show[1], cc.pAdd(cc.p(0, 0), offset), cc.p(0.5, 0), true, PlayerAction.action_1 )
			ui._effectNode:addChild(ui._effectSpine)
		end
	end

end
-- desc: 
function ActionMainuiPushChroniclePop:register_event()
	local ui = self
	registerButtonEventListener(ui._goBtn, handler(self, self._onClickGoBtn), true)
	registerButtonEventListener(ui._closeBtn, handler(self, self.close), true)
	registerButtonEventListener(ui._extendTouch, function ()
		if ui._noTipsCheck:isSelected() then
			ui._noTipsCheck:setSelected(false)
		else
			ui._noTipsCheck:setSelected(true)
			MainuiController:getInstance():getModel():recordShowTime(self._data, true)
		end
	end, true)

	ui._noTipsCheck:addEventListener(function(sender,event_type)
        if event_type == ccui.CheckBoxEventType.selected then
            playButtonSound2()
			MainuiController:getInstance():getModel():recordShowTime(self._data, true)
        elseif event_type == ccui.CheckBoxEventType.unselected then 
            playButtonSound2()
        end
    end)

end

-- desc: 
function ActionMainuiPushChroniclePop:close_callback()
	if self._data then 
		ActionController:getInstance():openActionMainuiPushPop(false, self._data)
	end
	if not self._isJump then
		GlobalEvent:getInstance():Fire(MainuiEvent.TRY_POP_ACTION_EVENT)
	end
end
-- desc: 
function ActionMainuiPushChroniclePop:_onClickGoBtn(param, sender, event_type)
	if self._data then
		local cfg = self._data.cfg
		self._isJump = true
		self:close()
		if self._data.cfg.push_type == 2 or self._data.cfg.push_type == 5 then
			local config = Config.SourceData.data_source_data[cfg.jump_id]
			if config then
				BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
			end
		else
			local actionData = ActionController:getInstance():getOverViewActiondata(cfg.activity_id)
			if actionData then
				JumpController:getInstance():jumpViewByEvtData({700,actionData.bid})
			end
		end
	end
end