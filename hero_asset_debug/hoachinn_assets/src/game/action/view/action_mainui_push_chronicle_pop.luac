--编年史弹窗
ActionMainuiPushChroniclePop = ActionMainuiPushChroniclePop or BaseClass(BaseView)

function ActionMainuiPushChroniclePop:__init()
	self.is_full_screen = false
	self.layout_name = "action/action_mainui_push_chronicle_pop"
	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("goldeqm","goldeqm"), type = ResourcesType.plist },
	}
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.win_type = WinType.Big
	self.background_mask_enable = true
end

-- desc: 
function ActionMainuiPushChroniclePop:open_callback()

	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale( display.getMaxScale())

	self._root = self.root_wnd:getChildByName("_root")
	self.Panel_27 = self._root:getChildByName("Panel_27")
	self._bg = self._root:getChildByName("_bg")
	self._titleSprite = self._root:getChildByName("_titleSprite")
	self._effectNode = self._root:getChildByName("_effectNode")
	self._spineParentNode = self._root:getChildByName("_spineParentNode")
	self._limitNode = self._root:getChildByName("_limitNode")
	self._noTipsCheck = self._root:getChildByName("_noTipsCheck")
	self._noTipLabel = self._root:getChildByName("_noTipLabel")
	self._extendTouch = self._noTipsCheck:getChildByName("_extendTouch")
	self._richParent = self._root:getChildByName("_richParent")
	self._skill_bg = self._root:getChildByName("_skill_bg")
	self._jumpBtn = self._root:getChildByName("_jumpBtn")
	self._jumpBtnLabel = self._jumpBtn:getChildByName("_jumpBtnLabel")
	self._jump_tip = self._root:getChildByName("_jump_tip")
	self._skill_bg:setVisible(false)
	self._jumpBtn:setVisible(false)
	self._jump_tip:setVisible(false)
	self._goBtn = self._root:getChildByName("_goBtn")	
	self._goBtnLabel = self._goBtn:getChildByName("_goBtnLabel")
	self._closeBtn = self._root:getChildByName("_closeBtn")
	self._type_img = self._root:getChildByName("_type_img")
	self._type_img:setVisible(false)
	
	local ui = self
	ui._richText = createRichLabel(20, cc.c3b(0x08,0xe9,0x08), cc.p(0.5, 0.5), cc.p(0, 0),nil, nil, 600)
	ui._richParent:addChild(ui._richText)

	loadSpriteTexture(ui._bg, PathTool.getActivityPush("activitypush_3"), LOADTEXT_TYPE)
	loadSpriteTexture(ui._titleSprite, PathTool.getActivityPush("txt_cn_activitypush_4"), LOADTEXT_TYPE)

	ui._goBtnLabel:setString(TI18N("语言_c_970"))
	ui._noTipLabel:setString(TI18N("语言_c_2021"))
	local _width = self._noTipLabel:getContentSize().width
	local _total_width = _width + 40
	local posx = 360 - _total_width/2 + 15
	self._noTipsCheck:setPositionX(posx)
	self._noTipLabel:setPositionX(posx+25)
end

function ActionMainuiPushChroniclePop:openRootWnd(data, noAni)
	self._data = data
	self:updateData()
	if not noAni then
		self:playEnterAnimatianByObj(self._root, 2)
	end
end

function ActionMainuiPushChroniclePop:_updateElfin()
	local cfg = self._data.cfg
	local ui = self
	if cfg.params and cfg.params[1] then
		local elfinCfg =  Config.SpriteData.data_elfin_data(cfg.params[1])
		if elfinCfg then
			if ui._iconNode then
				ui._iconNode:removeFromParent()
				ui._iconNode = nil
			end
			if not ui._iconNode then
				local offset_y = tonumber(elfinCfg.offset_y) or 0
				local offset = cc.p(0, 0)
				local scale = 1
				if cfg.res_offset and cfg.res_offset[1] then
					local info = cfg.res_offset[1]
					if info[1] and info[1] ~= 0 then				
						scale = info[1]
					end
					offset.x = info[2] or 0
					offset.y = info[3] or 0
				end
				ui._iconNode = createEffectSpine( elfinCfg.effect_id, cc.pAdd(cc.p(0, -20+offset_y), offset), cc.p(0.5, 0), true, PlayerAction.stand )
				ui._iconNode:setScale(scale)
				ui._spineParentNode:addChild(ui._iconNode)

				updateLimitEffect(2, elfinCfg.id, ui._limitNode)
			end

		end
	end
	if cfg.append_params and next(cfg.append_params) then
		self._skill_bg:setVisible(true)
		self._jumpBtn:setVisible(true)
		self._jump_tip:setVisible(true)
		self._goBtn:setPosition(cc.p(240,303))
		self._goBtnLabel:setString(TI18N("语言_c_804"))
		self._richParent:setPositionY(237)
		local bg_res = PathTool.getPlistImgForDownLoad("bigbg/timesummon", cfg.append_params[5])
		loadSpriteTexture(self._jump_tip,bg_res,LOADTEXT_TYPE)
		for i=1,2 do
			local item = SkillItem.new(true, true, true, 0.95, true)
			self._skill_bg:addChild(item)
			local _x = i == 1 and 160 or 341
			item:setPosition(cc.p(_x,65))
			local cfg = Config.SkillData.data_get_skill(cfg.append_params[i])
			item:setData(cfg)
		end
		registerButtonEventListener(self._jumpBtn, function()
			local config = Config.SourceData.data_source_data[cfg.append_params[3]]
			if config then
				BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
			end
		end, true)
		self._jumpBtnLabel:setString(cfg.append_params[4])
	end
	
end

function ActionMainuiPushChroniclePop:_updateHolyEqm()
	local cfg = self._data.cfg
	local ui = self
	if cfg.params and cfg.params[1] then
		local res_id = cfg.params[1]
		local res = PathTool.checkRes(string_format("resource/ninjacontract/%s.png", res_id))

		if ui._iconNode then
			ui._iconNode:removeFromParent()
			ui._iconNode = nil
		end
		if not ui._iconNode then
			local offset = cc.p(0, 0)
			local scale = 1
			if cfg.res_offset and cfg.res_offset[1] then
				local info = cfg.res_offset[1]
				if info[1] and info[1] ~= 0 then				
					scale = info[1]
				end
				offset.x = info[2] or 0
				offset.y = info[3] or 0
			end
			local targetPos =  cc.pAdd(cc.p(0, 280), offset)
			-- function createImage(parent, res, x, y, anchorPoint, usePlist, zorder, is_Scale9)
			ui._iconNode = createSprite( nil,targetPos.x, targetPos.y + 15, ui._spineParentNode, cc.p(0.5, 0.5))
			loadSpriteTexture(ui._iconNode,res, LOADTEXT_TYPE)

			local action = cc.Sequence:create(cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y - 15)),cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y + 15)))
			ui._iconNode:runAction(cc.RepeatForever:create(action))
			ui._iconNode:setScale(scale)
		end
	end
	
	if cfg.append_params and next(cfg.append_params) then
		self._skill_bg:setVisible(true)
		self._jumpBtn:setVisible(true)
		self._jump_tip:setVisible(true)
		self._goBtn:setPosition(cc.p(240,303))
		self._goBtnLabel:setString(TI18N("语言_c_804"))
		self._richParent:setPositionY(237)
		local bg_res = PathTool.getPlistImgForDownLoad("bigbg/timesummon", cfg.append_params[5])
		loadSpriteTexture(self._jump_tip,bg_res,LOADTEXT_TYPE)
		for i=1,2 do
			local item = SkillItem.new(true, true, true, 0.95, true)
			self._skill_bg:addChild(item)
			local _x = i == 1 and 160 or 341
			item:setPosition(cc.p(_x,65))
			local cfg = Config.SkillData.data_get_skill(cfg.append_params[i])
			item:setData(cfg)
		end
		registerButtonEventListener(self._jumpBtn, function()
			local config = Config.SourceData.data_source_data[cfg.append_params[3]]
			if config then
				BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
			end
		end, true)
		self._jumpBtnLabel:setString(cfg.append_params[4])
	end
end

function ActionMainuiPushChroniclePop:_updateJinqi()
	local cfg = self._data.cfg
	local ui = self
	if cfg.params and cfg.params[1] then
		local itemCfg =  Config.ProhibitorData.data_get_prohibitor[cfg.params[1]]
		if itemCfg then
			local res_id = itemCfg.resource
			local res = PathTool.getJinqiIcon(res_id,2)

			if ui._iconNode then
				ui._iconNode:removeFromParent()
				ui._iconNode = nil
			end
			if not ui._iconNode then
				local offset = cc.p(0, 0)
				local scale = 1
				if cfg.res_offset and cfg.res_offset[1] then
					local info = cfg.res_offset[1]
					if info[1] and info[1] ~= 0 then				
						scale = info[1]
					end
					offset.x = info[2] or 0
					offset.y = info[3] or 0
				end
				local targetPos =  cc.pAdd(cc.p(0, 280), offset)
				-- function createImage(parent, res, x, y, anchorPoint, usePlist, zorder, is_Scale9)
				ui._iconNode = createSprite( nil,targetPos.x, targetPos.y + 15, ui._spineParentNode, cc.p(0.5, 0.5))
				loadSpriteTexture(ui._iconNode,res, LOADTEXT_TYPE)

				local action = cc.Sequence:create(cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y - 15)),cc.MoveTo:create(2, cc.p(targetPos.x, targetPos.y + 15)))
    			ui._iconNode:runAction(cc.RepeatForever:create(action))
				ui._iconNode:setScale(scale)
			end

		end
	end
end

