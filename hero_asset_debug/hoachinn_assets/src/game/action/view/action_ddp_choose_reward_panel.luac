ActionDdpChooseRewardPanel = ActionDdpChooseRewardPanel or BaseClass(BaseView)
local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionDdpChooseRewardPanel:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.layout_name = "action/action_monopoly_choose_reward_panel"
    -- self.select_camp = 1
end

function ActionDdpChooseRewardPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_4780"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 100, 63))
    self.image_bottom = self.main_container:getChildByName("image_bottom")
    self.right_btn = self.main_container:getChildByName("right_btn")
    self.right_label = self.right_btn:getChildByName("label")
    self.right_label:setString(TI18N("语言_c_3"))
    self.left_btn = self.main_container:getChildByName("left_btn")
    self.left_label = self.left_btn:getChildByName("label")
    self.left_label:setString(TI18N("语言_act_02_5"))
    self.tips = self.main_container:getChildByName("tips")
    self.tips:setString(TI18N("语言_c_5288"))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.list_info_panel = self.main_container:getChildByName("list_info_panel")
    self.name_txt = self.list_info_panel:getChildByName("name_txt")
    self.name_txt:setString(TI18N("语言_c_4513"))
    self.hero_list = self.list_info_panel:getChildByName("hero_list")
end

function ActionDdpChooseRewardPanel:register_event()
    registerButtonEventListener(self.background, function()
        self:clickClose()
    end, false, 1)
    registerButtonEventListener(self.close_btn, function()
        self:clickClose()
    end, true, 1)
    registerButtonEventListener(self.right_btn, function()
        if self.select_camp and self.select_camp.item_id then
            controller:sender29604(self.select_camp)
        else
            message(TI18N("语言_c_4770"))
        end
    end, true, 1)
    registerButtonEventListener(self.left_btn, function()
        self:clickClose()
    end, true, 1)

    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(ActionEvent.OptionalSelectData, function(data)
            self:setData(data)
        end)
    end
    if not self.close_self then
        self.close_self = GlobalEvent:getInstance():Bind(ActionEvent.OptionalFireData, function(data)
            if data.code ~= 0 then
                self:clickClose()
            else
                message(data.msg)
            end
        end)
    end
end

function ActionDdpChooseRewardPanel:openRootWnd(id, reward)
    self.holiday_bid = id
    self:setData(reward[1])
end

function ActionDdpChooseRewardPanel:setData(reward)
    local tabvo = controller:getActionSubTabVo(self.holiday_bid)
    local campid = tabvo.camp_id -- 活动的唯一Id
    local cfg = Config.HolidayFlopData.data_flop_final_act_award[campid]
    local awards = cfg and cfg.award or {}
    local cfg_reward = deepCopy(awards)
    self.reward = {}
    self.select_camp = reward or nil
    for index, value in pairs(cfg_reward) do
        local item_id = value[1]
        local item_count = value[2]
        local is_select = false
        if reward then
            if item_id == reward.item_id and item_count == reward.item_count then
                is_select = true
            end
        end

        local temp = {}
        temp.item_id = item_id
        temp.item_count = item_count
        temp.is_select = is_select
        table.insert(self.reward, temp)
    end
    self:updateList()
end

function ActionDdpChooseRewardPanel:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.hero_list:getContentSize()
        local setting = {
            item_class = ActionDdpChooseItem,
            start_x = 30, -- 第一个单元的X起点
            space_x = 20, -- x方向的间隔
            start_y = 10, -- 第一个单元的Y起点
            space_y = 5, -- y方向的间隔
            item_width = 120, -- 单元的尺寸width
            item_height = 148, -- 单元的尺寸height
            col = 4 -- 列数，作用于垂直滚动类型
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.hero_list, cc.p(0, 0), ScrollViewDir.vertical,
            ScrollViewStartPos.top, scroll_view_size, setting)
        self.item_scrollview:setSwallowTouches(false)
    end
    self.item_scrollview:setData(self.reward)
    -- self.item_scrollview:addEndCallBack(function()
    --     local item_list = self.item_scrollview:getItemList()
    --     local now_choose = self.now_list[1].index
    --     for k, v in pairs(item_list) do
    --         local item_data = v:getItemData()
    --         if item_data and item_data.pos == now_choose then
    --             v:setSelected(true)
    --         else
    --             v:setSelected(false)
    --         end
    --     end
    -- end)
end
function ActionDdpChooseRewardPanel:clickClose()
    controller:openDdpSelectRewardPanel(false)
end
function ActionDdpChooseRewardPanel:close_callback()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    self.node_list = {}
    self.image_list = {}
    if self.close_self then
        GlobalEvent:getInstance():UnBind(self.close_self)
        self.close_self = nil
    end
end

ActionDdpChooseItem = class("ActionDdpChooseItem", function()
    return ccui.Widget:create()
end)

function ActionDdpChooseItem:ctor(width, height)
    self.size = cc.size(width, height)
    self:configUI(width, height)
    self:register_event()
end

function ActionDdpChooseItem:configUI(width, height)
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_optional_gift_chose_item"))
    self:setAnchorPoint(cc.p(0, 0))
    self:setContentSize(cc.size(width, height))
    self:setTouchEnabled(false)

    self:addChild(self.root_wnd)
    self.container = self.root_wnd:getChildByName("container")
    self.Node_1 = self.container:getChildByName("Node_1")
    self.select = self.container:getChildByName("select")
    self.select_1 = self.container:getChildByName("select_1")
    self.select:setVisible(false)
    -- self.item_name_txt = self.container:getChildByName("item_name_txt")
    -- self.item_name_txt:setString("")

    self.item_node = BackPackItem.new(false, true, false, 1, nil, nil, false)
    self.Node_1:addChild(self.item_node)
end
-- ==============================--
-- desc:设置选中状态
-- time:2017-07-03 09:07:12
-- @status:
-- ==============================--
function ActionDdpChooseItem:setSelected(status)
    if status then
        self.select:setVisible(true)
    else
        self.select:setVisible(false)
    end
end
function ActionDdpChooseItem:clearTimeTicket()
    if self.sequence_action then
        self.item_node:stopActionByTag(10086)
        self.sequence_action = nil
    end
    if self.time_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_ticket)
        self.time_ticket = nil
    end
end
function ActionDdpChooseItem:register_event()
    self.item_node:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.began then
            GlobalEvent:getInstance():Fire(ActionEvent.OptionalSelectData, self.data)
            local action = cc.Sequence:create(cc.DelayTime:create(0.3), cc.CallFunc:create(function()
                TipsManager:getInstance():showGoodsTips(self.data.item_id)
            end))
            self.sequence_action = self.item_node:runAction(action)
            self.sequence_action:setTag(10086)
        elseif event_type == ccui.TouchEventType.canceled then
            self:clearTimeTicket()
        elseif event_type == ccui.TouchEventType.ended then
            self:clearTimeTicket()
        end
    end)
end

-- function ActionDdpChooseItem:addCallBack( callback )
-- 	self.callback = callback
-- 	if self.item_node then
-- 		self.item_node:addCallBack(callback)
--     end
-- end
function ActionDdpChooseItem:getItemData()
    return self.data
end

function ActionDdpChooseItem:setData(data)
    self.data = data
    if self.item_node then
        self.item_node:setBaseData(data.item_id, data.item_count)
        local cfg = Config.ItemData.data_get_data(data.item_id)
        if cfg.type == BackPackConst.item_type.HERO_HUN then
            self.item_node:initCamp(cfg.camp_type)
            local starNum = cfg.eqm_jie
		    self.item_node:createStar(starNum,15)
        end
    end
    self:setSelected(data.is_select)
end

function ActionDdpChooseItem:DeleteMe()
    self:clearTimeTicket()
    if self.item_node then
        self.item_node:DeleteMe()
        self.item_node = nil
    end
end
