-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
--  (必填, 后续维护以及修改的人员)
-- @description:
--      异界之门活动面板
-- Create: 2020-02-10
-- --------------------------------------------------------------------
ActionOutsideWorldWindow = ActionOutsideWorldWindow or BaseClass(BaseView)

function ActionOutsideWorldWindow:__init()
	self.ctrl = ActionController:getInstance()
	self.model = self.ctrl:getModel()
    self.is_full_screen = true
    self.win_type = WinType.Big  
    self.view_tag = ViewMgrTag.DIALOGUE_TAG  
    self.layout_name = "action/action_outside_world_window"    
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld"), type = ResourcesType.plist},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_7"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_7_1"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_7_2"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_7_3"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_1"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_1_1"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_1_2"), type = ResourcesType.single},
		{ path = PathTool.getPlistImgForDownLoad("gate_otherworld","gate_otherworld_8"), type = ResourcesType.single},
    }
    self.day_list = {}
    self.cur_index = nil
end

function ActionOutsideWorldWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container)
	self.gate_otherworld_7_1 = self.main_container:getChildByName("gate_otherworld_7_1")
	self.txt_cn_gate_otherworld_2_2 = self.main_container:getChildByName("txt_cn_gate_otherworld_2_2")
	self.gate_otherworld_9_1 = self.main_container:getChildByName("gate_otherworld_9_1")
	self.close_btn = self.main_container:getChildByName("close_btn")
	self.get_btn = self.main_container:getChildByName("get_btn")
	self.get_btn_txt = self.get_btn:getChildByName("label")
	self.get_btn:setTouchEnabled(false)
	self.goto_btn = self.main_container:getChildByName("goto_btn")
	self.goto_btn_txt = self.goto_btn:getChildByName("label")
	self.goto_btn:setTouchEnabled(false)
	self.rule_btn = self.main_container:getChildByName("rule_btn")
	-- self.title_tips = self.main_container:getChildByName("title_tips")
	self.title_tips = createRichLabel(24,cc.c3b(0xe6,0xc8,0x8d),cc.p(0.5,0.5),cc.p(360,841),nil,nil,650)
	self.main_container:addChild(self.title_tips)
	self.hero_icon = self.main_container:getChildByName("hero_icon")
	self.video_btn = self.main_container:getChildByName("video_btn")
	self.video_btn_txt = self.video_btn:getChildByName("label")
    setTextMaxWidth(self.video_btn_txt:getChildByName("label"),100)
	self.video_btn_txt:setString(TI18N("语言_c_823"))
	self.Image_4 = self.main_container:getChildByName("Image_4")
	self.Sprite_3 = self.main_container:getChildByName("Sprite_3")
	self.Text_7 = self.main_container:getChildByName("Text_7")
	self.Image_5 = self.main_container:getChildByName("Image_5")
	self.ctrl:sender21710(self.model:getOutsideWorldDoorBid2())
end

function ActionOutsideWorldWindow:openRootWnd()
	self:setData()
end
function ActionOutsideWorldWindow:setData(data)
	self.ctrl:setHolidayStatus(self.model:getOutsideWorldDoorBid(),true)
	if not data then return end
	self.get_btn:setTouchEnabled(true)
	self.goto_btn:setTouchEnabled(true)
	self.data = data
	self.bid = self.model:getOutsideWorldDoorBid()
	self.cfg = Config.HoildayAlienWorldData.data_constant[self.bid]
	local bg_res = PathTool.getPlistImgForDownLoad("herodraw/herodrawres",self.cfg.hero_body, false)
	if self.hero_icon then
		self.item_load = loadSpriteTextureFromCDN(self.hero_icon, bg_res, ResourcesType.single, self.item_load) 
	end
	self.hero_icon:setPosition(cc.p(360 + self.cfg.pos[1][1],539 + self.cfg.pos[1][2]))
	if tableLen(self.cfg.hero_head[1]) ~= 0 then
		self.spine = createSpineByName("E30001","action")
		self.main_container:addChild(self.spine)
		self.spine:setPosition(cc.p(360,270))
		self.spine:setAnimation(0, PlayerAction.action, true)
		local id = self.cfg.hero_head[1][1]
		local cfg = Config.PartnerData.data_partner_base[id]
		self.heroAvatar = BackPackItem.new(false, true, false, 0.7, true, true)
		self.main_container:addChild(self.heroAvatar)
		self.heroAvatar:setPosition(cc.p(250,270))
		self.heroAvatar:setBaseData(cfg.item_id,1)
		local id = self.cfg.hero_head[1][2]
		local cfg = Config.PartnerData.data_partner_base[id]
		self.reward = BackPackItem.new(false, true, false, 0.7, true, true)
		self.main_container:addChild(self.reward)
		self.reward:setPosition(cc.p(470,270))
		self.reward:setBaseData(cfg.item_id,1)
	else
		self.video_btn_txt:setTextColor(cc.c4b(0xff, 0xff, 0xff, 0xff))
		self.video_btn_txt:enableOutline(cc.c4b(0x2e, 0x32, 0x6a, 0xff))
		-- self.title_tips:setTextColor(cc.c4b(0x40, 0x5c, 0x7a, 0xff))
		self.Text_7:setTextColor(cc.c4b(0xff, 0xff, 0xff, 0xff))
		self.Text_7:enableOutline(cc.c4b(0x00, 0x00, 0x00, 0xff))
		self.Image_4:setPositionY(350)
		self.Sprite_3:setPositionY(355)
		self.Text_7:setPositionY(356)
		-- self.Sprite_3:setVisible(false)
		self.video_btn:setPositionX(650)
		self.video_btn:setPositionY(200)
	end
	self.hero_icon:setPosition(cc.p(360 + self.cfg.boday_move[1][1] , 539 + self.cfg.boday_move[1][2]))
	self.hero_icon:setScaleX(self.cfg.boday_add[1][1])
	self.hero_icon:setScaleY(self.cfg.boday_add[1][2])
	loadSpriteTexture(self.gate_otherworld_7_1,string.format("resource/gate_otherworld/%s.png", self.cfg.bg_name), LOADTEXT_TYPE)
	self.video_btn:loadTexture(PathTool.getResFrame("gate_otherworld", self.cfg.look_icon),LOADTEXT_TYPE_PLIST)
	self.close_btn:loadTexture(PathTool.getResFrame("gate_otherworld", self.cfg.close_icon),LOADTEXT_TYPE_PLIST)
	self.Image_4:loadTexture(PathTool.getResFrame("gate_otherworld", self.cfg.name_txt),LOADTEXT_TYPE_PLIST)
	loadSpriteTexture(self.txt_cn_gate_otherworld_2_2,PathTool.getResFrame("gate_otherworld", self.cfg.total_name), LOADTEXT_TYPE_PLIST)
	self.gate_otherworld_9_1:loadTexture(PathTool.getResFrame("gate_otherworld", self.cfg.total_txt),LOADTEXT_TYPE_PLIST)
	local time = self.data.end_time - GameNet:getInstance():getTime()
	self.tips = createRichLabel(24,cc.c4b(0xff,0xff,0xff,0xff),cc.p(0.5,1),cc.p(360,80),nil,nil,600)
	self.main_container:addChild(self.tips)
	commonCountDownTime(self.tips, time, {callback = function(time)
		-- local str = string.format(TI18N("限时绝版英雄试用、\n购买、兑换倒计时<div fontcolor=#00ff00>%s</div>"),TimeTool.GetTimeFormatDayIV(time))
		local str = string.format(TI18N(self.cfg.sec_txt),TimeTool.GetTimeFormatDayIIIIII(time))
		self.tips:setString(str)
	end})
	self.Image_5:setContentSize(cc.size(703,self.tips:getContentSize().height + 20))
	self.title_tips:setString(TI18N(self.cfg.lv_txt))
	self.gate_otherworld_9_1:setContentSize(cc.size(self.title_tips:getContentSize().width+70,self.gate_otherworld_9_1:getContentSize().height))
	-- if self.data.free_reward == 0 then
	-- 	self.get_btn_txt:setString(TI18N("获得英雄"))
	-- 	addRedPointToNodeByStatus(self.get_btn_txt,true,40,25)
	-- else
		self.get_btn_txt:setString(TI18N("语言_c_5179"))
		-- addRedPointToNodeByStatus(self.get_btn_txt,false,10,15)
	-- end
	if data.exc_point == 1 then
		addRedPointToNodeByStatus(self.goto_btn,true,10,15)
	else
		addRedPointToNodeByStatus(self.goto_btn,false,10,15)
	end
	self.goto_btn_txt:setString(TI18N("语言_c_1567"))
	if self.cfg and self.cfg.reward and self.cfg.reward[1] and self.cfg.reward[1][1] then
		local item_id = self.cfg.reward[1][1]
		local item_cfg = Config.ItemData.data_get_data(item_id)
		if tableLen(self.cfg.hero_head[1]) == 0 and item_cfg and item_cfg.client_effect and item_cfg.client_effect[1] and item_cfg.client_effect[1] then
			local skin_id = item_cfg.client_effect[1][1]
			local is_have = HeroController:getInstance():getModel():getHeroSkinInfoBySkinID(skin_id)
			local is_have_2 = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
			if is_have or is_have_2 >= 1 then
				self.goto_btn_txt:setString(TI18N("语言_c_4055"))
				setChildUnEnabled(true,self.goto_btn)
				self.goto_btn:setTouchEnabled(false)
				addRedPointToNodeByStatus(self.goto_btn,false,10,15)
				self.ctrl:setHolidayStatus(self.model:getOutsideWorldDoorBid2(),false)
			else
				self.goto_btn_txt:setString(TI18N("语言_c_1567"))
				setChildUnEnabled(false,self.goto_btn)
				self.goto_btn:setTouchEnabled(true)
			end
		end
	end
	local id = self.cfg.reward[1][1]
	local cfg = Config.PartnerData.data_partner_base[id]
	if not cfg then
		cfg = Config.ItemData.data_get_data(id)
	end
	self.Text_7:setString(cfg.name)
	self.Image_4:setContentSize(cc.size(self.Text_7:getContentSize().width + 90 + 70,63))
	loadSpriteTexture(self.Sprite_3, PathTool.getHeroCampTypeIcon(self.cfg.attr), LOADTEXT_TYPE_PLIST)
	self.Sprite_3:setPositionX(self.Image_4:getPositionX() - self.Image_4:getContentSize().width /2 + 43)
	self.Text_7:setPositionX(self.Image_4:getPositionX() - self.Image_4:getContentSize().width/2 + 80)

end
function ActionOutsideWorldWindow:register_event()
	registerButtonEventListener(self.get_btn, function()
		local config = Config.SourceData.data_source_data[self.cfg.exc_hero_skip]
        if config then
            BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
        else
            ActionController:getInstance():openActionMainPanel(true, nil, ActionRankCommonType.ValuePackage or ActionRankCommonType.ValuePackage2)
        end
		self.ctrl:openActionOutsideWorldWindow(false)
	end, true,2)
	registerButtonEventListener(self.goto_btn, function()
		self.ctrl:sender21713(self.model:getOutsideWorldDoorBid2())
		self.ctrl:openActionOutsideWorldExchangeWindow(true)
	end, true,2)
	registerButtonEventListener(self.close_btn, function()
		self.ctrl:openActionOutsideWorldWindow(false)
	end, true,2)
	registerButtonEventListener(self.rule_btn, function(param,sender, event_type)
		TipsManager:getInstance():showAdventureBuffTipsScroll(self.cfg.faq_txt, sender:getTouchBeganPosition(),nil,nil,500)
	end, true,2)
	if not self.OutsideWorldExchangeData  then
        self.OutsideWorldExchangeData = GlobalEvent:getInstance():Bind(ActionEvent.OutsideWorldExchangeData,function(data)
			self:setData(data)
        end)
    end
	--战斗预览
    registerButtonEventListener(self.video_btn, function()
        if self.bid then
            TimesummonController:getInstance():send23219(self.model:getOutsideWorldDoorBid2())
        end
    end, true, 2)
end

function ActionOutsideWorldWindow:close_callback()
	if self.heroAvatar then
		self.heroAvatar:DeleteMe()
		self.heroAvatar = nil
	end
	if self.reward then
		self.reward:DeleteMe()
		self.reward = nil
	end
    if self.item_load then
        self.item_load:DeleteMe()
    end
    self.item_load = nil
	if self.OutsideWorldExchangeData then
        self.OutsideWorldExchangeData = GlobalEvent:getInstance():UnBind(self.OutsideWorldExchangeData)
        self.OutsideWorldExchangeData = nil
    end
	self.ctrl:openActionOutsideWorldWindow(false)
end