ActionAskQuestionRewardWindow = ActionAskQuestionRewardWindow or BaseClass(BaseView)

function ActionAskQuestionRewardWindow:__init()
    self.ctrl = ActionController:getInstance()
    self.model = self.ctrl:getModel()
    self.is_full_screen = false
    self.win_type = WinType.Mini  
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.layout_name = "action/action_askplayer_reward_window"
    self.res_list = {
    }
end

function ActionAskQuestionRewardWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(main_panel , 2)
	local main_container  = main_panel:getChildByName("main_container")

	self.content_label = main_container:getChildByName("content_label")
	self.content_label:setString("")
	
	self.item_container = main_container:getChildByName("good_cons")
    self.item_container:setScrollBarEnabled(false)
	
	local title_container = main_panel:getChildByName("title_container")
	local title_bg = title_container:getChildByName("Image_1_0")
	local title_label = title_container:getChildByName("title_label")
	title_label:setString(TI18N("语言_c_11"))
	moveTextBg(title_label,title_bg,60,title_bg:getContentSize().width)

	self.close_btn = main_panel:getChildByName("close_btn")
	self.ok_btn = main_panel:getChildByName("ok_btn")
	self.ok_btn_label = self.ok_btn:getChildByName("label")
	self.ok_btn_label:setString(TI18N("语言_c_63"))
end

function ActionAskQuestionRewardWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), false, 2)
	registerButtonEventListener(self.ok_btn, handler(self, self._onClickCloseBtn), true)
end

function ActionAskQuestionRewardWindow:_onClickCloseBtn(  )
	self.ctrl:openAskQuestionRewardWindow(false)
end


function ActionAskQuestionRewardWindow:openRootWnd(data)
	self.content_label:setString(string.format(TI18N("语言_c_6387"), data.data.idx))
	local reward_data = data.data.data[2]
	if not reward_data then
        return
    end
    local scroll_view_size = self.item_container:getContentSize()
    local setting = {
        item_class = BackPackItem, -- 单元类
        start_x = 0, -- 第一个单元的X起点
        space_x = 10, -- x方向的间隔
        start_y = 5, -- 第一个单元的Y起点
        space_y = 4, -- y方向的间隔
        item_width = BackPackItem.Width * 0.8, -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.8, -- 单元的尺寸height
        row = 1, -- 行数，作用于水平滚动类型
        col = 0, -- 列数，作用于垂直滚动类型
        scale = 0.8,
        is_center = true
    }
    if not self.item_scrollview  then
        self.item_scrollview = CommonScrollViewLayout.new(self.item_container, cc.p(0, 0), ScrollViewDir.horizontal,ScrollViewStartPos.top, scroll_view_size, setting)
        self.item_scrollview:stopAllActions()

    end
    self.item_scrollview:setSwallowTouches(false)
    local list = {}
    for k, v in pairs(reward_data) do
        local temp = Config.ItemData.data_get_data(v[1])
        local vo = deepCopy(temp)
        vo.quantity = v[2]
        table.insert(list, vo)
    end
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function()
        local list = self.item_scrollview:getItemList()
        for k, v in pairs(list) do
            v:setDefaultTip()
        end
    end)
end

function ActionAskQuestionRewardWindow:close_callback(  )
	if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
	self.ctrl:openAskQuestionRewardWindow(false)
end
