        self.tab_list[i] = object
    end
    -- self:setData()
    self:changeTabView(1)
    self:loadBannerImage()
    self:checkTabRedPoint()
end

function ActionRankPanel:changeTabView( index )
    if self.cur_selected and self.cur_selected.index == index then return end
    if self.cur_selected then
        self.cur_selected.normal_img:setVisible(true)
        self.cur_selected.sele_img:setVisible(false)
        self.cur_selected = nil 
    end
    self.cur_selected = self.tab_list[index]
    if self.cur_selected == nil then return end
    self.cur_selected.normal_img:setVisible(false)
    self.cur_selected.sele_img:setVisible(true)

    for i = 1, 2 do
        local task_list = self.rank_tab_item[i]
        local layer_out = task_list.layer_out
        layer_out:setVisible(false)
    end
    local task_list = self.rank_tab_item[index]
    local layer_out = task_list.layer_out
    layer_out:setVisible(true)
    if index == 1 then
        self.scrollor_bg:setContentSize(cc.size(self.scrollor_bg:getContentSize().width, 435))
    else
        self.scrollor_bg:setContentSize(cc.size(self.scrollor_bg:getContentSize().width, 455))
    end
end

function ActionRankPanel:getLabel(index)
    if index == 1 then
        return TI18N("语言_c_11")
    elseif index == 2 then
        return TI18N("语言_c_255")
    end
end

function ActionRankPanel:loadBannerImage()
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    local str_bg = "holiday_rank_banner_01"
    local str_txt = "txt_cn_holiday_rank_01"
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    if tab_vo and tab_vo.aim_title ~= "" and tab_vo.aim_title then
        str_bg = tab_vo.aim_title
        str_txt = tab_vo.reward_title
    end
    local img_res = PathTool.getPlistImgForDownLoad("holiday_rank", str_bg)
    if not self.bg_load then
        self.bg_load = loadSpriteTextureFromCDN(self.title_img, img_res, ResourcesType.single, self.bg_load)
    end
    local txt_res = PathTool.getPlistImgForDownLoad("holiday_rank", str_txt)
    if not self.bg_txt_load then
        self.bg_txt_load = loadSpriteTextureFromCDN(self.title_txt_img, txt_res, ResourcesType.single, self.bg_txt_load)
    end
end

function ActionRankPanel:register_event()
    if not self.update_action_even_event  then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(RankEvent.RankEvent_Get_Rank_data,function (data)
            if self.setData then
                self:setData(data)
                self:checkTabRedPoint()
                self:changeTabView(self.cur_selected.index or 1)
            end
        end)
    end

    if not self.update_holiday_common_event then
        self.update_holiday_common_event = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE,function (data)
            if not data then return end
            if data.bid == self.holiday_bid then
                self:setPanelData(data)
            end
        end)
    end

    for i, object in ipairs(self.tab_list) do
        object.tab_btn:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playTabButtonSound()
                self:changeTabView(i)
            end
        end)
    end

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        TipsManager:getInstance():showCommonTips(TI18N("语言_hol_ro_97014_4"), sender:getTouchBeganPosition(), nil, nil, 500)
    end, true, 1)

end

function ActionRankPanel:setPanelData(data)
    self.rank_rank_group:setVisible(false)
    self.rank_reward_rank_group:setVisible(false)
    self.rank_lock_group:setVisible(true)
    self.rank_reward_lock_group:setVisible(true)
    local roleVo = RoleController:getInstance():getRoleVo()
    local lv = roleVo.lev
    local need_lock2 = Config.HolidayRankData.data_const["rank_condition2"].val
    if lv >= need_lock2 then
        self.rank_rank_group:setVisible(true)
        self.rank_reward_rank_group:setVisible(true)
        self.rank_lock_group:setVisible(false)
        self.rank_reward_lock_group:setVisible(false)
    else
        self.rank_rank_group:setVisible(false)
        self.rank_reward_rank_group:setVisible(false)
        self.rank_lock_group:setVisible(true)
        self.rank_reward_lock_group:setVisible(true)
    end
    local finish = false
    if data then
        self.time_text:setAnchorPoint(cc.p(1, 0.5))
        self.time_label:setAnchorPoint(cc.p(1, 0.5))
        --debug_Print("data.remain_sec",data.remain_sec)
        local is_over = false
        if data.remain_sec <= 0 then
            is_over = true
        end
        commonCountDownTime(self.time_text,data.remain_sec or 0,{
            end_callback=function ()
                self.time_text:setString(TI18N("语言_c_233"))
            end
        })
        -- controller:getModel():setCountDownTime(self.time_text,data.remain_sec or 0,is_over)
        self.time_label:setPositionX(self.time_text:getPositionX() - self.time_text:getContentSize().width - 10)
        self.time_panel:setContentSize(cc.size(self.time_text:getContentSize().width + self.time_label:getContentSize().width + 20,30))
        if data.finish and data.finish ~= 0 then
            finish = true
        end
    end
    --排行奖励
    local tab_1_data = {}
    local rank_reward_info = Config.HolidayRankData.data_rank_info
    if rank_reward_info then
        for k,v in pairs(rank_reward_info) do
            local item = {}
            item.id = v.begin_rank
            item.reward = v.award
            item.cond_award = v.cond_award
            item.finish = finish
            item.config = v
            if #v.award > 0 then
                table.insert(tab_1_data, item)
            end
        end
    end
    table.sort(tab_1_data , function(a,b) return a.id < b.id end)
    self:setpanel(1,tab_1_data)
    local reward = {}
    local cond_award = {}
    if rank_reward_info then
        for k,v in pairs(rank_reward_info) do
            if self.data.my_idx >= v.begin_rank and self.data.my_idx <= v.end_rank then
                reward = v.award
                cond_award = v.cond_award
                break
            end
        end
    end
    
    local setting = {}
    setting.scale = 0.6
    local show_lock = finish == false
    local cond_award_setting = {}
    cond_award_setting.scale = 0.6
    cond_award_setting.lock = show_lock
    cond_award_setting.is_lock_bg  = show_lock
    self.rank_item_list = commonShowSingleRowItemList(self.my_item_scrollview, self.rank_item_list, reward, setting)
    self.rank_cond_item_list = commonShowSingleRowItemList(self.my_item_scrollview2, self.rank_cond_item_list, cond_award, cond_award_setting)
end

function ActionRankPanel:setData(data)
    if data then
        self.data = data 
    end
    if not self.data then return end
    -- local tab_1_data = {}
    local tab_2_data = {}
    -- local rank_reward_info = Config.HolidayRankData.data_rank_info
    -- if rank_reward_info then
    --     for k,v in pairs(rank_reward_info) do
    --         local item = {}
    --         item.id = v.begin_rank
    --         item.reward = v.award
    --         item.cond_award = v.cond_award
    --         item.config = v
    --         if #v.award > 0 then
    --             table.insert(tab_1_data, item)
    --         end
    --     end
    -- end
    -- table.sort(tab_1_data , function(a,b) return a.id < b.id end)
    -- self:setpanel(1,tab_1_data)

    local rank_list = data.rank_list or {}
    if rank_list then
        for k,v in pairs(rank_list) do
            table.insert(tab_2_data, v)
        end
    end
    table.sort(tab_2_data, function(a,b) return a.idx < b.idx end)
    self:setpanel(2,tab_2_data)
    if data.my_idx ~= nil then
        if data.my_idx <= 3 then
            self.rank_reward_rank_label:setVisible(false)
            self.rank_rank_label:setVisible(false)
            if data.my_idx == 0 then
                self.rank_reward_rank_label:setVisible(true)
                self.rank_rank_label:setVisible(true)
                self.rank_reward_rank_img:setVisible(false)
                self.rank_rank_img:setVisible(false)
                self.rank_rank_label:setString(TI18N("语言_c_273"))
                self.rank_reward_rank_label:setString(TI18N("语言_c_273"))
            else
                local rank_res_id = PathTool.getResFrame("common", string.format("common_200%s", data.my_idx))
                if self.rank_rank_res_id ~= rank_res_id then
                    self.rank_rank_res_id = rank_res_id
                    loadSpriteTexture(self.rank_rank_img, rank_res_id, LOADTEXT_TYPE_PLIST)
                end
                if self.rank_reward_res_id ~= rank_res_id then
                    self.rank_reward_res_id = rank_res_id
                    loadSpriteTexture(self.rank_reward_rank_img, rank_res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_rank_img:setVisible(true)
                self.rank_reward_rank_img:setVisible(true)
            end
        else
            self.rank_rank_img:setVisible(false)
            self.rank_reward_rank_img:setVisible(false)
            self.rank_rank_label:setVisible(true)
            self.rank_reward_rank_label:setVisible(true)
            if data.my_idx ~= nil then
               self.rank_rank_label:setString(data.my_idx)
               self.rank_reward_rank_label:setString(data.my_idx)
            else
               self.rank_rank_label:setString(TI18N("语言_c_438"))
               self.rank_reward_rank_label:setString(TI18N("语言_c_438"))
            end
        end 

       
        --排行榜
        self.play_head = self:createPlayerHead(145,60)
		local face_id = self.data.face_id or self.data.face
		local avatar_bid = self.data.avatar_bid
		local vo = Config.AvatarData.data_avatar[avatar_bid]
		if vo then
			local res_id = vo.res_id or 1
			local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
			self.play_head:showBg(res, nil, false, vo.offy)
		end

		self.play_head:setHeadRes(face_id, false, LOADTEXT_TYPE, self.data.face_file, self.data.face_update_time)
		self.play_head:setLev(self.data.lev)

        local role_name = self.data.name
        if self.is_cluster == true then
            local srv_id = self.data.srv_id or self.data.leader_srvid
            role_name  = transformNameByServ(self.data.name, srv_id) 
        end

        local label = createLabel(24,Config.ColorData.data_color4[175],nil,250,124/2,"",self.rank_rank_group,0, cc.p(0,0.5))
		label:setString(role_name)

		local label = createRichLabel(24, Config.ColorData.data_color4[175],cc.p(0.5,0.5), cc.p(575,124/2), 0, 0, 500)
		self.rank_rank_group:addChild(label)
		local power = self.data.my_val1 or 0
		local res = PathTool.getResFrame('common', 'common_90002')
		label:setString(string.format("<img src='%s' /> %s", res, MoneyTool.moneyFormat(power)))
    end
    -- for i = 1, 2 do
    --     self:setpanel(i,task_list)
    -- end
    -- local time = self.data.end_time - GameNet:getInstance():getTime()
	-- commonCountDownTime(self.time_text, time)
    -- self.time_text:setAnchorPoint(cc.p(1, 0.5))
    -- self.time_label:setAnchorPoint(cc.p(1, 0.5))
    -- self.time_text:setPosition(cc.p(700,21))
    -- self.time_label:setPosition(cc.p(self.time_text:getPositionX() - self.time_text:getContentSize().width - 10,21))
    -- self.time_panel:setContentSize(cc.size(self.time_text:getContentSize().width + self.time_label:getContentSize().width + 20,30))

end

--创建玩家头像
function ActionRankPanel:createPlayerHead(x,y)
	local play_head = PlayerHead.new(PlayerHead.type.circle)
	self.rank_rank_group:addChild(play_head)
	play_head:setPosition(cc.p(x,y))
	play_head:setAnchorPoint(cc.p(0,0.5))
	play_head:setTouchEnabled(false)
	play_head:setScale(0.8)
	--头像不需要点击 本身item就是处理点击了
	return play_head
end


function ActionRankPanel:setpanel(index,data)
    local rank_tab_item = self.rank_tab_item[index]
    local _time_val = rank_tab_item.time_val
    local _time_txt = rank_tab_item.time_txt
    local item_scroll = rank_tab_item.item_scroll
    item_scroll:setData(data)
end

function ActionRankPanel:checkTabRedPoint()
    for i=1, 2 do
        local red_status = false
        if self.tab_list and self.tab_list[i] then
            local tab = self.tab_list[i]
            tab.red_img:setVisible(red_status)
        end
    end
end

function ActionRankPanel:DeleteMe()
    if self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
    end
    self.item_scrollview = nil
    if self.rank_item_scrollview then
        self.rank_item_scrollview:DeleteMe()
    end
    self.rank_item_scrollview = nil
    if self then
        self:removeAllChildren()
        self:removeFromParent()
    end
end

