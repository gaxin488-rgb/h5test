        col = 1,                         -- 列数，作用于垂直滚动类型
    }
    self.rank_item_scrollview = CommonScrollViewLayout.new(self.rank_reward_scrollor, cc.p(10,131) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.rank_item_scrollview:setSwallowTouches(false)
    self.rank_tab_item[1] = {
