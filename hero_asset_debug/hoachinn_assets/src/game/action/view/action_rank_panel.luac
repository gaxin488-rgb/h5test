    }
    self.rank_reward_free_txt_bg:setLocalZOrder(999)
    self.rank_reward_lock_txt_bg:setLocalZOrder(999) 
    self.rank_reward_free_txt:setLocalZOrder(999)
    self.rank_reward_lock_txt:setLocalZOrder(999)
    
    local bgSize = self.rank_scrollor:getContentSize()
    local rank_scroll_view_size = cc.size(bgSize.width - 19 , bgSize.height - 158)
    local setting = {
        item_class = ActionRankItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 3,                    -- 第一个单元的Y起点
        space_y = 5,                   -- y方向的间隔
        item_width = 674,               -- 单元的尺寸width
        item_height = 125,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.rank_scrollor, cc.p(10,131) , ScrollViewDir.vertical, ScrollViewStartPos.top, rank_scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
