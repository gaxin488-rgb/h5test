    -- self.rank_scrollor:setContentSize(cc.size(self.rank_scrollor:getContentSize().width, self.rank_scrollor:getContentSize().height + add_height))
    -- scrollor_bg:setContentSize(cc.size(scrollor_bg:getContentSize().width,scrollor_bg:getContentSize().height + add_height))
    -- self.scroller_bg:setContentSize(cc.size(self.scroller_bg:getContentSize().width, self.scroller_bg:getContentSize().height+add_height))
    -- controller:autoSizeActionScrollerBottomBg(self.scroller_bg, self.scroller_bottom_bg,10)
    
    local bgSize = self.rank_reward_scrollor:getContentSize()
	local scroll_view_size = cc.size(bgSize.width - 19 , bgSize.height - 166)
    -- self.rank_reward_free_txt_bg:setPositionY(bgSize.height - 150 + 160)
    -- self.rank_reward_free_txt:setPositionY(bgSize.height - 150 + 160)
    -- self.rank_reward_lock_txt_bg:setPositionY(bgSize.height - 150 + 160)
    -- self.rank_reward_lock_txt:setPositionY(bgSize.height - 150 + 160)
    local setting = {
        item_class = ActionRankRewardItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 3,                    -- 第一个单元的Y起点
        space_y = 5,                   -- y方向的间隔
        item_width = 678,               -- 单元的尺寸width
        item_height = 130,              -- 单元的尺寸height
