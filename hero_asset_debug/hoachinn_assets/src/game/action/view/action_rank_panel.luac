ActionRankPanel = class("ActionRankPanel", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()
local color_text = {
    [1] = cc.c4b(0x00,0xff,0x00,0xff),
    [2] = cc.c4b(0x64,0x32,0x23,0xff),
}

function ActionRankPanel:ctor(bid)
    self.holiday_bid = bid

    self.rank_tab_item = {}
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("holiday_rank","holiday_rank"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("holiday_rank","txt_cn_holiday_rank_01"), type = ResourcesType.single},
	}
    self.resources_load = ResourcesLoad.New(true)
	self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
            self:loadResListCompleted()
        end
	end)
end
function ActionRankPanel:loadResListCompleted(  )
    self:configUI()
    RankController:getInstance():send_12905(RankConstant.RankType.action_power_rank)
    if self.holiday_bid then
        controller:cs16603(self.holiday_bid)
    end
	self:register_event()
end

