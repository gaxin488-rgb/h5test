ActionRankRewardItem = class("ActionRankRewardItem", function()
    return ccui.Widget:create()
end)

function ActionRankRewardItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionRankRewardItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_rank_reward_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(678,130))
	self:setTouchEnabled(false)

    self.rank_img = self.root_wnd:getChildByName("rank_img")
    self.rank_label = self.root_wnd:getChildByName("rank_label")
    -- setTextMaxWidth(self.rank_label,60)
    self.item_scrollview = self.root_wnd:getChildByName("item_scrollview")
    self.item_scrollview:setScrollBarEnabled(false)
    self.item_scrollview:setSwallowTouches(false)

    self.cond_item_scrollview = self.root_wnd:getChildByName("item_scrollview_0")
    self.cond_item_scrollview:setScrollBarEnabled(false)
    self.cond_item_scrollview:setSwallowTouches(false)
   
end

function ActionRankRewardItem:setData(data)--index,key,
    if not data then return end
    self.data = data
    if data.id ~= nil then
        if data.id <= 3 then
            self.rank_label:setVisible(false)
            if data.id == 0 then
                self.rank_img:setVisible(false)
            else
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.id))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id = res_id
                    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_img:setVisible(true)
            end
        else
            self.rank_img:setVisible(false)
            self.rank_label:setVisible(true)
            if data.config~=nil then
               self.rank_label:setString(string.format("%s~%s", data.config.begin_rank, data.config.end_rank))
            else
               self.rank_label:setString(TI18N("语言_c_6033"))
            end
        end 
    end
    local reward = data.reward or {}
    local setting = {}
    setting.scale = 0.6

    local cond_award = data.cond_award or {}
    local finish = data.finish or false
    local show_lock = finish == false
    local cond_award_setting = {}
    cond_award_setting.scale = 0.6
    cond_award_setting.lock = show_lock
    cond_award_setting.is_lock_bg  = show_lock
    self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, reward, setting)
    self.cond_item_list = commonShowSingleRowItemList(self.cond_item_scrollview, self.cond_item_list, cond_award, cond_award_setting)
end

function ActionRankRewardItem:register_event( )
   
end

function ActionRankRewardItem:DeleteMe()
    if self then
        self:removeAllChildren()
        self:removeFromParent()
    end
end



ActionRankItem = class("ActionRankItem", function()
    return ccui.Widget:create()
end)

function ActionRankItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionRankItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_rank_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(674,125))
	self:setTouchEnabled(false)

    self.rank_img = self.root_wnd:getChildByName("rank_img")
    self.rank_label = self.root_wnd:getChildByName("rank_label")
    -- setTextMaxWidth(self.rank_label,60)
   
end

function ActionRankItem:setData(data)--index,key,
    if not data then return end
    self.data = data
    if data.idx ~= nil then
        if data.idx <= 3 then
            self.rank_label:setVisible(false)
            if data.id == 0 then
                self.rank_img:setVisible(false)
            else
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.idx))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id = res_id
                    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_img:setVisible(true)
            end
        else
            self.rank_img:setVisible(false)
            self.rank_label:setVisible(true)
            self.rank_label:setString(data.idx)
        end 
    end

    self.play_head = self:createPlayerHead(145,60)
    local face_id = self.data.face_id or self.data.face
    local avatar_bid = self.data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.play_head:showBg(res, nil, false, vo.offy)
    end

    self.play_head:setHeadRes(face_id, false, LOADTEXT_TYPE, self.data.face_file, self.data.face_update_time)
    self.play_head:setLev(self.data.lev)
    -- self.play_head:addCallBack(function( )
    --     FriendController:getInstance():openFriendCheckPanel(true,self.data)
    -- end)

    local role_name = self.data.name
    if self.is_cluster == true then
        local srv_id = self.data.srv_id or self.data.leader_srvid
        role_name  = transformNameByServ(self.data.name, srv_id) 
    end

    local label = createLabel(24,Config.ColorData.data_color4[175],nil,250,124/2,"",self.root_wnd,0, cc.p(0,0.5))
    label:setString(role_name)

    local label = createRichLabel(24, Config.ColorData.data_color4[175],cc.p(0.5,0.5), cc.p(575,124/2), 0, 0, 500)
    self.root_wnd:addChild(label)
    local power = self.data.val1 or 0
    local res = PathTool.getResFrame('common', 'common_90002')
    label:setString(string.format("<img src='%s' /> %s", res, MoneyTool.moneyFormat(power)))
end

--创建玩家头像
function ActionRankItem:createPlayerHead(x,y)
	local play_head = PlayerHead.new(PlayerHead.type.circle)
	self.root_wnd:addChild(play_head)
	play_head:setPosition(cc.p(x,y))
	play_head:setAnchorPoint(cc.p(0,0.5))
	play_head:setTouchEnabled(false)
	play_head:setScale(0.8)
	--头像不需要点击 本身item就是处理点击了
	return play_head
end

function ActionRankItem:register_event( )
   
end

function ActionRankItem:DeleteMe()
    if self then
        self:removeAllChildren()
        self:removeFromParent()
    end
end