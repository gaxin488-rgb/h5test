local _controller = ActionController:getInstance()
local _model = _controller:getModel()

ActionDdpFailPanel = ActionDdpFailPanel or BaseClass(BaseView)

function ActionDdpFailPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "action/action_ddp_fail_panel"
    self.res_list = {
	}
    self.role_vo = RoleController:getInstance():getRoleVo()
end

function ActionDdpFailPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
	self.source_container = container
    self:playEnterAnimatianByObj(container, 2)

    
	self.title_container = self.source_container:getChildByName("title_container")
	self.title_width = self.title_container:getContentSize().width
	self.title_height = self.title_container:getContentSize().height
    
	self.time_label = createRichLabel(22, 1, cc.p(0.5, 0.5), cc.p(self.source_container:getContentSize().width / 2 + 5,20), nil, nil, 1000)
	self.time_label:setString(TI18N("语言_c_117"))
	self.source_container:addChild(self.time_label)
    
	self:handleEffect(true)
    self:updateTimer()
end

function ActionDdpFailPanel:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openActionDdpFailPanel(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openActionDdpFailPanel(false)
	end, false, 2)

end

function ActionDdpFailPanel:handleEffect(status)
	if status == false then
		if self.play_effect then
			self.play_effect:clearTracks()
			self.play_effect:removeFromParent()
			self.play_effect = nil
		end
	else
		if not tolua.isnull(self.title_container) and self.play_effect == nil then
			self.play_effect = createEffectSpine(PathTool.getEffectRes(104), cc.p(self.title_width * 0.5, self.title_height * 0.5), cc.p(0.5, 0.5), false, PlayerAction.action)
			self.title_container:addChild(self.play_effect, 1)
		end
	end
end

function ActionDdpFailPanel:updateTimer()
    local time = 10
    local call_back = function()
        time = time - 1
        local new_time = math.ceil(time)
        local str = string.format(TI18N("语言_c_4715"),new_time)
        if self.time_label and not tolua.isnull(self.time_label) then
            self.time_label:setString(str)
        end
        if new_time <= 0 then
            _controller:openActionDdpFailPanel(false)
        end
    end
    GlobalTimeTicket:getInstance():add(call_back, 1, 0,"action_ddp_game")
end
function ActionDdpFailPanel:openRootWnd()
end

function ActionDdpFailPanel:close_callback(  )
    GlobalTimeTicket:getInstance():remove('action_ddp_game')
	self:handleEffect(false)
end
