--******** 文件说明 ********
-- 
-- @description: 购买经验
-- @DateTime:    2020-02-20
-- *******************************
ActionLingtDarkWarOrderBuyexpPanel = ActionLingtDarkWarOrderBuyexpPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
function ActionLingtDarkWarOrderBuyexpPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.addLevel = 1
    self.ConsumeNum = 0
    self.layout_name = "action/action_lingt_dark_war_order_buyexp_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("neworderaction", "neworderaction_banner_1"), type = ResourcesType.single}
    }
end

function ActionLingtDarkWarOrderBuyexpPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2) 
    self.Image_20 = self.main_container:getChildByName("Image_20")
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title = self.main_container:getChildByName("title")
    self.title:setString(TI18N("语言_c_5113"))
    self.title_bg:setContentSize(cc.size(self.title:getContentSize().width + 100,63))
    self.tips = self.main_container:getChildByName("tips")
    self.tips:setTouchEnabled(true)
    self.tips:setString(transformTextToShort(TI18N("语言_c_5114"),40))
    addEvt2showAllTextTips(self.tips,TI18N("语言_c_5114"),40)
    self.level_num_bg = self.main_container:getChildByName("level_num_bg")
    self.level_num = self.main_container:getChildByName("level_num")
    self.level_add = self.main_container:getChildByName("level_add")
    self.level_less = self.main_container:getChildByName("level_less")
    self.consume_panel = self.main_container:getChildByName("consume_panel")
    self.consume = self.consume_panel:getChildByName("consume")
    self.num_bg = self.consume_panel:getChildByName("num_bg")
    self.icon = self.consume_panel:getChildByName("icon")
    self.num = self.consume_panel:getChildByName("num")
    self.buy_btn = self.main_container:getChildByName("buy_btn")
    self.buy_btn_txt = self.buy_btn:getChildByName("buy_btn_txt")
    self.buy_btn_txt:setString(TI18N("语言_c_85"))
    self:setData()
end

function ActionLingtDarkWarOrderBuyexpPanel:setData()
    self:updatePanel()
end

function ActionLingtDarkWarOrderBuyexpPanel:register_event()
    registerButtonEventListener(self.background, function()
        controller:openActionLingtDarkWarOrderBuyexpPanel(false)
	end, false)
    registerButtonEventListener(self.level_add, function()
        self:touchNum(true)
	end, true)
    registerButtonEventListener(self.level_less, function()
        self:touchNum(false)
	end, true)
    registerButtonEventListener(self.buy_btn, function()
        controller:sender21703(model:getLingtDarkSignBid(),self.addLevel)
        controller:openActionLingtDarkWarOrderBuyexpPanel(false)
	end, true)
end
function ActionLingtDarkWarOrderBuyexpPanel:touchNum(status)
    if status then
        local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
        local cfg = Config.ChuanqiTaskData.data_lv_reward[id]
        local data = model:getLingtDarkData()
        local one_exp = Config.ChuanqiTaskData.data_constant["lv_exp"].val
        local max_exp = Config.ChuanqiTaskData.data_lv_exp[id][#Config.ChuanqiTaskData.data_lv_exp[id] - 1].exp        
        if data.exp + self.addLevel * one_exp < max_exp then
            self.addLevel = self.addLevel + 1
        else
            message(TI18N("语言_c_4337"))
        end
    else
        if self.addLevel > 1 then
            self.addLevel = self.addLevel - 1
        else
            message(TI18N("语言_c_4338"))
        end
    end
    self:updatePanel()
end
function ActionLingtDarkWarOrderBuyexpPanel:updatePanel()
    self.ConsumeNum = self.addLevel * Config.ChuanqiTaskData.data_constant["lv_cost"].val
    self.level_num:setString(self.addLevel)    
    self.num:setString(self.ConsumeNum)    
    self.consume:setString(TI18N("语言_c_1971"))
    self.num_bg:setContentSize(cc.size(self.icon:getContentSize().width * 0.3 + self.num:getContentSize().width + 30,30))
    self.consume_panel:setContentSize(cc.size(self.icon:getContentSize().width + self.num_bg:getContentSize().width + 60 , 30))
    self.consume:setPositionX(5)
    self.num_bg:setPositionX(self.consume:getPositionX() + self.consume:getContentSize().width + 5)
    self.icon:setPositionX(self.consume:getPositionX() + self.consume:getContentSize().width + 10)
    self.num:setPositionX(self.icon:getPositionX() + self.icon:getContentSize().width * 0.3 + 5)
end
function ActionLingtDarkWarOrderBuyexpPanel:openRootWnd()
end
function ActionLingtDarkWarOrderBuyexpPanel:close_callback()
    controller:openActionLingtDarkWarOrderBuyexpPanel(false)
end
