ActionAskQuestionTips = ActionAskQuestionTips or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionAskQuestionTips:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "action/action_askplayer_tips"
    self.res_list = {
       { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }
    self.win_type = WinType.Tips    
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end

function ActionAskQuestionTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
        self.background:setSwallowTouches(true)
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.bot_bg = self.main_panel:getChildByName("bot_bg")
end

function ActionAskQuestionTips:register_event()
    registerButtonEventListener(self.background, function() self:onClickCloseBtn() end ,false, 0) 
end

--关闭
function ActionAskQuestionTips:onClickCloseBtn()
    controller:openAskQuestionTips(false)
end

function ActionAskQuestionTips:openRootWnd(data)
    local spine_name = data.data
    if tolua.isnull(self.main_panel) then return end
    if spine_name == nil or spine_name == "" or spine_name == 0 then
        spine_name = "H99999"
    end
    local spine = createSpineByName(spine_name,PlayerAction.show,nil,1,1)
    spine:setAnchorPoint(cc.p(0.5,0))
    spine:setPosition(self.main_panel:getContentSize().width/2, 255)
    spine:setAnimation(0, PlayerAction.show, true)
    spine:setScale(0.8, 0.8)
    self.main_panel:addChild(spine)
    -- delayOnce(function() 
        -- local spine_height = spine:getBoundingBox().height
        -- self.bot_bg:setPositionY(spine:getPositionY() - spine_height*0.8*0.5-90)
    -- end, 0.01)
end

function ActionAskQuestionTips:close_callback()
    controller:openAskQuestionTips(false)
end
