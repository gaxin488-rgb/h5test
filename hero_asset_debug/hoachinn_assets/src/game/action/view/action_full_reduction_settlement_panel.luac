--******** 文件说明 ********
-- 
-- @description: 黑色星期五满减结算
-- @DateTime:    2020-02-20
-- *******************************
ActionFullReductionSettlementPanel = ActionFullReductionSettlementPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
function ActionFullReductionSettlementPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_full_reduction_settlement_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("neworderaction", "neworderaction_banner_1"), type = ResourcesType.single}
    }
    self.buy_list = {}
    self.row_num = 1
end

function ActionFullReductionSettlementPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2) 
    self.Image_20 = self.main_container:getChildByName("Image_20")
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title = self.main_container:getChildByName("title")
    self.title:setString(TI18N("语言_c_357"))
    self.title_bg:setContentSize(cc.size(self.title:getContentSize().width + 100,63))
    self.item_bg = self.main_container:getChildByName("item_bg")
    self.item_panel = self.main_container:getChildByName("item_panel")
    self.consume_panel = self.main_container:getChildByName("consume_panel")
    self.num_bg = self.consume_panel:getChildByName("num_bg")
    self.icon = self.consume_panel:getChildByName("icon")
    self.num = self.consume_panel:getChildByName("num")
    self.buy_btn = self.main_container:getChildByName("buy_btn")
    self.buy_btn_txt = self.buy_btn:getChildByName("label")
    self.buy_btn_txt:setString(TI18N("语言_c_3"))
    self.cancel_btn = self.main_container:getChildByName("cancel_btn")
    self.cancel_btn_txt = self.cancel_btn:getChildByName("label")
    self.cancel_btn_txt:setString(TI18N("语言_c_62"))
end
function ActionFullReductionSettlementPanel:register_event()
    registerButtonEventListener(self.background, function()
        controller:openFullReductionSettlementPanel(false)
	end, true)
    registerButtonEventListener(self.cancel_btn, function()
        controller:openFullReductionSettlementPanel(false)
	end, true)
    registerButtonEventListener(self.buy_btn, function()
        controller:sender21719(self.data.bid)
	end, true)
end
function ActionFullReductionSettlementPanel:openRootWnd(data)
    self.data = data
    self.price_list = model:setCostNum(controller:getActionSubTabVo(data.bid).camp_id,data.buy_list)
    self.num:setString(self.price_list[2])
    self.num_bg:setContentSize(cc.size(self.num:getContentSize().width + self.icon:getContentSize().width * 0.3 + 30,40))
    self.icon:setPositionX(self.num_bg:getPositionX() - self.num_bg:getContentSize().width/2)
    self.num:setPositionX(self.icon:getPositionX() + self.icon:getContentSize().width * 0.3 + 10)
    self:setPanel()
end
function ActionFullReductionSettlementPanel:setPanel()
    self.cfg = Config.HolidayBlackFridayData.data_buy_info[controller:getActionSubTabVo(self.data.bid).camp_id]
    for key, value in pairs(self.data.buy_list) do
        if self.cfg and self.cfg[value.id] then
            local num = value.save_num * self.cfg[value.id].reward[1][2]
            if num > 0 then
                local data = {bid = self.cfg[value.id].reward[1][1],quantity = num}
                table.insert(self.buy_list, data)
            end
        end
    end
    self.row_num = math.ceil(tableLen(self.buy_list) / 5)
    if self.row_num > 4 then
        self.row_num = 4.5
    end
    self.main_container:setContentSize(cc.size(650,330 + (self.row_num - 1) * 105))
    self.Image_20:setContentSize(cc.size(650,330 + (self.row_num - 1) * 105))
    self.Image_20:setPositionY(self.main_container:getContentSize().height/2)
    self.item_bg:setContentSize(cc.size(600,120 + (self.row_num - 1) * 105))
    self.item_panel:setContentSize(cc.size(580,100 + (self.row_num - 1) * 105))
    self.title_bg:setPositionY(self.Image_20:getContentSize().height)
    self.title:setPositionY(self.Image_20:getContentSize().height)
    self.item_bg:setPositionY(148)
    self.item_panel:setPositionY(158)
    self.consume_panel:setPositionY(100)
    self.cancel_btn:setPositionY(62)
    self.buy_btn:setPositionY(62)

    local scroll_view_size = self.item_panel:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 1,                  -- 第一个单元的X起点
        space_x = 17,                    -- x方向的间隔
        start_y = 1,                    -- 第一个单元的Y起点
        space_y = 10,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.80,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.80,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 5,                         -- 列数，作用于垂直滚动类型
        scale = 0.80,
        is_backpack_item = true
    }
    self.good_scrollview = CommonScrollViewLayout.new(self.item_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.good_scrollview:setSwallowTouches(false)
    self.good_scrollview:setData(self.buy_list)
    if self.row_num == 4.5 then
        self.good_scrollview:setClickEnabled(true)
    else
        self.good_scrollview:setClickEnabled(false)
    end
    self.good_scrollview:addEndCallBack(function()
        local list = self.good_scrollview:getItemList()
        for k,v in pairs(list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
        end
    end)
end
function ActionFullReductionSettlementPanel:close_callback()
    if self.good_scrollview then
        self.good_scrollview:DeleteMe()
        self.good_scrollview = nil
    end
end
