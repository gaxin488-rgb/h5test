--******** 文件说明 ********
-- 
-- @description: 购买进阶卡
-- @DateTime:    2020-02-20
-- *******************************
ActionLegendaryWarOrderAdvancedPanel = ActionLegendaryWarOrderAdvancedPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local config = Config.HolidayGetninjaData
function ActionLegendaryWarOrderAdvancedPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_war_order_advanced_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("neworderaction", "neworderaction_banner_1"), type = ResourcesType.single}
    }
    self.data_list = {}
    self.data_list2 = {}
    self.data_reward_list = {}
end
function ActionLegendaryWarOrderAdvancedPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2) 
    local title_bg = main_container:getChildByName("title_bg")
    local text_3 = main_container:getChildByName("Text_3")
    text_3:setString(TI18N("语言_c_5123"))
    local title_width = text_3:getContentSize().width
    local title_bg_width = math.max(title_width+130, 266)
    title_bg:setContentSize(cc.size(title_bg_width,44))
    local text_bg = main_container:getChildByName("text_bg")
    local Text_3_0 = main_container:getChildByName("Text_3_0")
    Text_3_0:setString(TI18N("语言_c_2685"))
    Text_3_0:ignoreContentAdaptWithSize(true)
    Text_3_0:setTextAreaSize(cc.size(270,0))  
    setTextSpacing(Text_3_0,-6)
    text_bg:setContentSize(cc.size(500,20))
    local Text_3_1 = main_container:getChildByName("Text_3_1")
    Text_3_1:setString(TI18N("语言_c_5124"))
    Text_3_1:ignoreContentAdaptWithSize(true)
    Text_3_1:setTextAreaSize(cc.size(260,0))

    local label_lock = createRichLabel(22, cc.c4b(0xff, 0xdf, 0x6f, 0xff), cc.p(0.5, 0.5), cc.p(325, 136), -10, nil, 400)
    local str = "<div fontcolor=#ffdf6f outline=1,#291703>"..TI18N("语言_c_6229").."</div>"
    label_lock:setString(str)
    main_container:addChild(label_lock)

    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_label = self.btn_change:getChildByName("Text_6")

    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    local image_bg = main_container:getChildByName("Sprite_1")
    -- local res = PathTool.getPlistImgForDownLoad("get_ninja", "getninjaorder_banner_1")
    if not self.image_bg_load then
        self.image_bg_load = loadSpriteTextureFromCDN(image_bg, res, ResourcesType.single, self.image_bg_load)
    end
    self.btn_close = main_container:getChildByName("btn_close")
    self:setData()
end

function ActionLegendaryWarOrderAdvancedPanel:setData()
    local card_list = deepCopy(Config.ChuanqiTaskData.data_card_list)
    local period = Config.ChuanqiTaskData.data_base_id[model:getLegendarySignCampId()].period
    if card_list and card_list[period] then
        if not self.item_list1 then
            self.data_list = card_list[period].reward or {}
            -- self.data_list2 = card_list[period].reward_1 or {}
            -- for key, value in pairs(self.data_list2) do
            --     table.insert(self.data_list,value)
            -- end
            local setting = {}
            setting.scale = 0.7
            setting.space_x = 3
            setting.max_count = 4
            setting.is_center = true
            self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, self.data_list, setting)
        end

        self.data_reward_list = card_list[period].reward_1 or {}
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, self.data_reward_list, setting)

        local charge_list = Config.ChargeData.data_charge_data
        local charge_id = card_list[period].charge_id or nil
        if model:getLegendarySignData().buy == 1 then
            setChildUnEnabled(true,self.btn_change)
            self.btn_change:setTouchEnabled(false)
            self.btn_change_label:setString(TI18N("语言_c_210"))
        else
            if charge_id and charge_list[charge_id] then
                self.btn_change_label:setString(string.format(TI18N("语言_c_4441"),GetMoneyNum(charge_list[charge_id],"val")))
            end
        end
    end
end

function ActionLegendaryWarOrderAdvancedPanel:register_event()
    registerButtonEventListener(
        self.background,
        function()
            controller:openActionLegendaryWarOrderAdvancedPanel(false)
        end,false,2)
    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openActionLegendaryWarOrderAdvancedPanel(false)
        end,true,2)

    registerButtonEventListener(
        self.btn_change,
        function()
            self:changeWarn()
        end,true,1)
    if not self.legendarysign_charge_data  then
        self.legendarysign_charge_data = GlobalEvent:getInstance():Bind(ActionEvent.LegendarySignChargeData,function (data)
            self:setData()
        end)
    end
end

function ActionLegendaryWarOrderAdvancedPanel:changeWarn()
    -- local day = model:getCurDay()
    local charge_list = Config.ChargeData.data_charge_data
    local card_list = Config.ChuanqiTaskData.data_card_list
    local cfg = Config.ChuanqiTaskData.data_base_id[model:getLegendarySignCampId()]
    local period = cfg.period

    local charge_id = card_list[period].charge_id or nil
    if charge_id and charge_list[charge_id] then
        local config = charge_list[charge_id]
        sdkOnPay(config.val, nil, config.id, config.name)
    end
end
function ActionLegendaryWarOrderAdvancedPanel:openRootWnd()
end
function ActionLegendaryWarOrderAdvancedPanel:close_callback()
    self.data_list = {}
    self.data_list2 = {}
    self.data_reward_list = {}
    if self.item_list1 then
        for i,v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i,v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.legendarysign_charge_data then
        self.legendarysign_charge_data = GlobalEvent:getInstance():UnBind(self.legendarysign_charge_data)
        self.legendarysign_charge_data = nil
    end
    controller:openActionLegendaryWarOrderAdvancedPanel(false)
end
