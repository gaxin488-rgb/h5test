	self.is_full_screen = false
	self.layout_name = "action/action_optional_gift_chose"
	
    self.cur_item_id = nil
    self.upcur_item_id = nil
	self.select_cell = nil
	self.hero_data_list = {}
    self.node_list = {}
    self.image_list = {}
    self.list_data = {}
    -- self.select_camp = 1
	self.select_list = {}
    self.join_list = {}
end

function ActionDailyLoginOptionalChosePanel:open_callback()
