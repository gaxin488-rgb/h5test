    self.name_txt = self.list_info_panel:getChildByName("name_txt")
    self.name_txt:setString(TI18N("语言_c_4781"))
    self.hero_list = self.list_info_panel:getChildByName("hero_list")
    self.Node_1 = self.main_container:getChildByName("Node_1")
    self.reward_item_1 = BackPackItem.new(true, true, false, 1)
    self.reward_item_1:setDefaultTip()
    self.reward_item_1:setPosition(cc.p(60,60))
    self.Node_1:addChild(self.reward_item_1)
    self.Image_1_1 = self.Node_1:getChildByName("Image_1_1")
    self.Node_2 = self.main_container:getChildByName("Node_2")
    self.reward_item_2 = BackPackItem.new(true, true, false, 1)
    self.reward_item_2:setDefaultTip()
    self.reward_item_2:setPosition(cc.p(60,60))
    self.Node_2:addChild(self.reward_item_2)
    self.Image_2_1 = self.Node_2:getChildByName("Image_2_1")
    self.Node_3 = self.main_container:getChildByName("Node_3")
    self.reward_item_3 = BackPackItem.new(true, true, false, 1)
    self.reward_item_3:setDefaultTip()
    self.reward_item_3:setPosition(cc.p(60,60))
    self.Node_3:addChild(self.reward_item_3)
    self.Image_3_1 = self.Node_3:getChildByName("Image_3_1")
    self.click_select = self.main_container:getChildByName("click_select")
    self.click_select:setPosition(self.Node_1:getPosition())
    table.insert(self.node_list,self.Node_1)
    table.insert(self.node_list,self.Node_2)
    table.insert(self.node_list,self.Node_3)
    
    table.insert(self.join_list,self.Image_1_1)
    table.insert(self.join_list,self.Image_2_1)
    table.insert(self.join_list,self.Image_3_1)

    table.insert(self.image_list,self.reward_item_1)
    table.insert(self.image_list,self.reward_item_2)
    table.insert(self.image_list,self.reward_item_3)
end
function ActionDailyLoginOptionalChosePanel:setRewardData(i)
    self.select_camp = i
    self.click_select:setPosition(self.node_list[i]:getPosition())
    local data = {}
    local item_cfg = nil
    if tableLen(self.select_list[i])~=0 then
        data = self.select_list[i]
    elseif tableLen(self.data[i+1]) ~= 0 then
        data = self.data[i+1]
    end
    if data and next(data) then
        if data[1] and data[2] then
            for key, value in pairs(self.cfg) do
                for k, v in pairs(value) do
                    if v.num == data[2] and v.pos == data[1] then
                        item_cfg = Config.ItemData.data_get_data(v.award[1][1])
                    end
                end
            end
        else
            item_cfg = Config.ItemData.data_get_data(data.award[1][1])
        end
    end
    if item_cfg and item_cfg.name then
        self.item_name:setString(item_cfg.name)
    end
    self.item_scrollview:setData(self.cfg[i],nil,nil,data)
    local fun = function()
        local data = {}
        if tableLen(self.select_list[i])~=0 then
            data = self.select_list[i]
        elseif tableLen(self.data[i+1]) ~= 0 then
            data = self.data[i+1]
        end
        GlobalEvent:getInstance():Fire(ActionEvent.OptionalUpSeData,data)
    end
    self.item_scrollview:addEndCallBack(fun())
end
function ActionDailyLoginOptionalChosePanel:register_event()
    registerButtonEventListener(self.background, function()
        self:clickClose()
    end,false)
    registerButtonEventListener(self.close_btn, function()
        self:clickClose()
    end,true, 1)

    registerButtonEventListener(self.reward_item_1, function()
        -- local data = {}
        -- if tableLen(self.select_list[1])~=0 then
        --     data = self.select_list[1]
        -- elseif tableLen(self.data[2]) ~= 0 then
        --     data = self.data[2]
        -- end
        -- self.select_camp = 1
        -- self.click_select:setPosition(self.Node_1:getPosition())
        -- self.item_scrollview:setData(self.reward1)
        -- GlobalEvent:getInstance():Fire(ActionEvent.OptionalUpSeData,data)
        self:setRewardData(1)
    end,true, 1)
    registerButtonEventListener(self.reward_item_2, function()
        -- local data = {}
        -- if tableLen(self.select_list[2])~=0 then
        --     data = self.select_list[2]
        -- elseif tableLen(self.data[3]) ~= 0 then
        --     data = self.data[3]
        -- end
        -- self.select_camp = 2
        -- self.click_select:setPosition(self.Node_2:getPosition())
        -- self.item_scrollview:setData(self.reward2)
        -- GlobalEvent:getInstance():Fire(ActionEvent.OptionalUpSeData,data)
        self:setRewardData(2)
    end,true, 1)
    registerButtonEventListener(self.reward_item_3, function()
        -- local data = {}
        -- if tableLen(self.select_list[3])~=0 then
        --     data = self.select_list[3]
        -- elseif tableLen(self.data[4]) ~= 0 then
        --     data = self.data[4]
        -- end
        -- self.select_camp = 3
        -- self.click_select:setPosition(self.Node_3:getPosition())
        -- self.item_scrollview:setData(self.reward3)
        -- GlobalEvent:getInstance():Fire(ActionEvent.OptionalUpSeData,data)
        self:setRewardData(3)
    end,true, 1)

    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(ActionEvent.OptionalSelectData,function (data)
            self:setSelect(data)
        end)
    end  
    registerButtonEventListener(self.right_btn, function()
        local rewardlist = {}
        local id = self.id
        for key, value in pairs(self.select_list) do
            local data = {}
            data.pos = value.pos or value[1]
            data.rewardid = value.num or value[2]
            table.insert(rewardlist,data)
        end
        if tableLen(rewardlist) ~= self.count then
            message(TI18N("语言_c_4770"))
        else
            local cfg = Config.PersonalPushData.data_gift_list
            if cfg[id] then
                if cfg[id].type_id == 15 then
                    ActionController:getInstance():sender21604(id,rewardlist)
                else
                    ActionController:getInstance():sender21609(id,rewardlist)
                end
                ActionController:getInstance():openActionDailyLoginOptionalChosePanel(false)
            end
        end
    end,true, 1)
    registerButtonEventListener(self.left_btn, function()
        self:clickClose()
    end,true, 1)

    if not self.close_self then
        self.close_self = GlobalEvent:getInstance():Bind(ActionEvent.OptionalFireData,function(data)
            if data.code ~= 0 then
                self:clickClose()
            else
                message(data.msg)
            end
        end)
    end
end
function ActionDailyLoginOptionalChosePanel:setSelect(list)
    if not list then return end
    local data = list.award[1]
    if self.select_camp == 0 then return end
    self.image_list[self.select_camp]:setBaseData(data[1],data[2])
    local cfg = Config.ItemData.data_get_data(data[1])
    self.item_name:setString(cfg.name)
    if cfg.type == BackPackConst.item_type.HERO_HUN then
        self.image_list[self.select_camp]:initCamp(cfg.camp_type)
    end
    if cfg and cfg.sub_type == BackPackConst.item_tab_type.TREASURE then
        if self.image_list[self.select_camp].treasureItem then
            self.image_list[self.select_camp].treasureItem.is_show_tips = false
            self.image_list[self.select_camp].treasureItem.click = false
        end
    end
    self.select_list[self.select_camp] = list
    self.join_list[self.select_camp]:setVisible(false)
end

function ActionDailyLoginOptionalChosePanel:openRootWnd(id,data,index)
    local id = id or 110001
    self.id = id
    self.select_camp = index or 1
    self.data =data
	self:setData(id)
end
function ActionDailyLoginOptionalChosePanel:setData(id)
 
    self.cfg = Config.PersonalPushData.data_quest_list[id]
    self.count = tableLen(self.cfg) or 3
    if self.count == 2 then
        self.Node_2:setPosition(self.Node_3:getPosition())
        self.Node_3:setVisible(false)
    elseif self.count == 1 then
        self.Node_1:setPosition(self.Node_2:getPosition())
        self.Node_2:setVisible(false)
        self.Node_3:setVisible(false)
        self.click_select:setPosition(self.Node_1:getPosition())
    end
    self.reward1 = self.cfg[1]
    self.reward2 = self.cfg[2]
    self.reward3 = self.cfg[3]
    local list = {}
    for i=1,3 do
        id = i
        if self.data and self.data[id] and tableLen(self.data[id])~=0 then
            table.insert(list,self.data[id])
        end
    end
    local list2 = {}
    for i=tableLen(list),1,-1 do
        table.insert(list2,list[i])
    end
    self.data = list
    for i=1,tableLen(self.data) do
        id = i
        if self.data[id] and tableLen(self.data[id])~=0 then
            self.join_list[i]:setVisible(false)
            local reward = self.cfg[self.data[id]["pos"]][self.data[id]["num"]].award[1]
            self.image_list[i]:setBaseData(reward[1], reward[2])
            local cfg = Config.ItemData.data_get_data(reward[1])
            if cfg.type == BackPackConst.item_type.HERO_HUN then
                self.image_list[i]:initCamp(cfg.camp_type)
            end
            if cfg and cfg.sub_type == BackPackConst.item_tab_type.TREASURE then
                if self.image_list[i].treasureItem then
                    self.image_list[i].treasureItem.is_show_tips = false
                    self.image_list[i].treasureItem.click = false
                end
            end
            local list = {}
            list[1] = self.data[id]["pos"]
            list[2] = self.data[id]["num"]
            self.select_list[i] = list
        else
            self.join_list[i]:setVisible(true)
        end
        self.join_list[i]:setLocalZOrder(9999)
    end
    self.list_data = self.reward1
    self:updateList()
    self:setRewardData(self.select_camp)
end
function ActionDailyLoginOptionalChosePanel:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.hero_list:getContentSize()
        local setting = {
            item_class = OptionalItem2,
            start_x = 30,                     -- 第一个单元的X起点
            space_x = 20,                     -- x方向的间隔
            start_y = 10,                     -- 第一个单元的Y起点
            space_y = 5,                     -- y方向的间隔
            item_width = 120,                -- 单元的尺寸width
            item_height = 148,               -- 单元的尺寸height
            col = 4,                         -- 列数，作用于垂直滚动类型
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.hero_list,cc.p(0,0),ScrollViewDir.vertical,ScrollViewStartPos.top,scroll_view_size,setting)
        self.item_scrollview:setSwallowTouches(false)
    end
    -- self.child_scrollview:setSwallowTouches(false)
    self.item_scrollview:setData(self.reward1)
end
function ActionDailyLoginOptionalChosePanel:clickClose()
    controller:openActionDailyLoginOptionalChosePanel(false)
end
function ActionDailyLoginOptionalChosePanel:close_callback()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    self.node_list = {}
    self.image_list = {}
    if self.close_self then
        GlobalEvent:getInstance():UnBind(self.close_self)
        self.close_self = nil
    end
    controller:openActionDailyLoginOptionalChosePanel(false)
end


--------------------------@ item
OptionalItem2 = class("OptionalItem2", function()
    return ccui.Widget:create()
end)

function OptionalItem2:ctor(width, height)
	self.size = cc.size(width,height)
	self:configUI(width, height)
	self:register_event()
end

function OptionalItem2:configUI( width, height )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_optional_gift_chose_item"))
    self:setAnchorPoint(cc.p(0, 0))
    self:setContentSize(cc.size(width, height))
	self:setTouchEnabled(false)
    
	self:addChild(self.root_wnd)
	self.container = self.root_wnd:getChildByName("container")
    self.Node_1 = self.container:getChildByName("Node_1")
    self.select = self.container:getChildByName("select")
    self.select_1 = self.container:getChildByName("select_1")
    self.select:setVisible(false)

    self.item_node = BackPackItem.new(false, true, false, 1, nil, nil, false)
    self.Node_1:addChild(self.item_node)
end
--==============================--
--desc:设置选中状态
--time:2017-07-03 09:07:12
--@status:
--==============================--
function OptionalItem2:setSelected(status)
    if status then
        self.select:setVisible(true)
    else
        self.select:setVisible(false)
    end
end
function OptionalItem2:clearTimeTicket()
    if self.sequence_action then
        self.item_node:stopActionByTag(10086)
        self.sequence_action = nil
    end
    if self.time_ticket ~= nil then
        GlobalTimeTicket:getInstance():remove(self.time_ticket)
        self.time_ticket = nil
    end
end
function OptionalItem2:register_event(  )
    -- registerButtonEventListener(self.item_node, function()
    self.item_node:addTouchEventListener(function (sender, event_type)
        if event_type == ccui.TouchEventType.began then
			self.touch_began = sender:getTouchBeganPosition()
            local action = cc.Sequence:create(cc.DelayTime:create(0.3), cc.CallFunc:create(function() 
                if self.data.award then
                    local cfg = Config.ItemData.data_get_data(self.data.award[1][1])
                    if cfg then
                        if cfg.sub_type == BackPackConst.item_tab_type.TREASURE then
                            TreasureController:getInstance():openTreasureFragmentsTips(true, cfg, {})
                        else
                            TipsManager:getInstance():showGoodsTips(self.data.award[1][1])
                        end
                    end
                end
            end))
            self.sequence_action = self.item_node:runAction(action)
            self.sequence_action:setTag(10086)
        elseif event_type == ccui.TouchEventType.moved then
            local touch_began = self.touch_began
            local touch_move = sender:getTouchMovePosition()
            if touch_began and touch_move and (math.abs(touch_move.x - touch_began.x) > 20 or math.abs(touch_move.y - touch_began.y) > 20) then 
                --移动大于20了..表示取消长点击效果
                doStopAllActions(self.main_container)
                self:clearTimeTicket()
            end
        elseif event_type == ccui.TouchEventType.canceled then
            self:clearTimeTicket()
        elseif event_type == ccui.TouchEventType.ended then
            GlobalEvent:getInstance():Fire(ActionEvent.OptionalSelectData,self.data)
            self:clearTimeTicket()
            -- GlobalEvent:getInstance():Fire(ActionEvent.OptionalSelectData,self.data)
        end
    end)
    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(ActionEvent.OptionalSelectData,function (data)
            if data["_index"] == self.data["_index"] then
                self:setSelected(true)
            else
                self:setSelected(false)
            end
        end)
    end  
    if not self.update_sele then
        self.update_sele = GlobalEvent:getInstance():Bind(ActionEvent.OptionalUpSeData,function (data)
            self:setStatrSelected(data)
        end)
    end  
end

-- function OptionalItem2:addCallBack( callback )
-- 	self.callback = callback
-- 	if self.item_node then
-- 		self.item_node:addCallBack(callback)
--     end
-- end
function OptionalItem2:setStatrSelected(data)
    local status = false
    if data[1] and data[2] then
        if data[1] == self.data.pos and data[2] == self.data.num then
            status = true
        else
            status = false
        end
    else
        if data.pos == self.data.pos and data.num == self.data.num then
            status = true
        else
            status = false
        end
    end
    self:setSelected(status)
end
function OptionalItem2:setExtendData(data)
    self.choose_data = data
end
function OptionalItem2:setData( list)
    self.data = list
    if list.award then
        local data = list.award[1]
    -- function OptionalItem2:setData( data)
    --     self.data = data
        if self.item_node then
            self.item_node:setBaseData(data[1], data[2])
            local cfg = Config.ItemData.data_get_data(data[1])
            if cfg.type == BackPackConst.item_type.HERO_HUN then
                self.item_node:initCamp(cfg.camp_type)
            end
        end
        local item_txt = Config.ItemData.data_get_data(data[1]).name
    end
    self:setStatrSelected(self.choose_data)
end

function OptionalItem2:DeleteMe(  )
    self:clearTimeTicket()
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    if self.update_sele then
        GlobalEvent:getInstance():UnBind(self.update_sele)
        self.update_sele = nil
    end
    if self.item_node then
		self.item_node:DeleteMe()
		self.item_node = nil
	end
end