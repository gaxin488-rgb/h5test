    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5148"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 100,63))
    self.image_bottom = self.main_container:getChildByName("image_bottom")
    self.item_name = self.main_container:getChildByName("item_name")
