-- 
ActionMonoItem = class("ActionMonoItem", function()
    return ccui.Widget:create()
end)

function ActionMonoItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionMonoItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_monopoly_item"))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.img_bg = self.main_container:getChildByName("bg")
    self.point_layer = self.main_container:getChildByName("point_layer")
    self.point_layer:setVisible(false)
    self.point_num_txt = self.point_layer:getChildByName("point_num_txt")
    self.title_label = self.main_container:getChildByName("title_label") -- 格子的等级信息

    self.start_label = self.main_container:getChildByName("start_label")
    self.start_label:setString(TI18N("语言_c_1022"))
    self.start_label:setVisible(false)
end

function ActionMonoItem:register_event()
    self.point_layer:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            TipsController:getInstance():openActionScoreTips(true,"wonderland_point_max",TI18N("语言_c_1195"),TI18N("语言_c_5175"))
        end
    end)
end

-- {group_id=10001, num=1, type=1, upgrade=1, parameter={{1,1,10000},{2,1,20000},{3,1,30000}}}
-- type -->  1起点 2道具 3积分 4事件
function ActionMonoItem:setData(data)
    if not data then
        return
    end
    self.data = data
    local type = data.type
    if type == 1 then -- 是起点
        loadSpriteTexture(self.img_bg, PathTool.getResFrame("wonderland", "wonderland_plaid_start"), LOADTEXT_TYPE_PLIST)
    elseif type == 2 then
        loadSpriteTexture(self.img_bg, PathTool.getResFrame("wonderland", "wonderland_plaid_item"), LOADTEXT_TYPE_PLIST)
    elseif type == 3 then
        loadSpriteTexture(self.img_bg, PathTool.getResFrame("wonderland", "wonderland_plaid_point"), LOADTEXT_TYPE_PLIST)
    elseif type == 4 then
        loadSpriteTexture(self.img_bg, PathTool.getResFrame("wonderland", "wonderland_plaid_event"), LOADTEXT_TYPE_PLIST)
    end
end

function ActionMonoItem:setItemInfo()
    local type = self.data.type
    if self.point_img then
        self.point_img:setVisible(false)
    end
    local level = self.lev --  string.format(TI18N("语言_c_4520"), self.lev)
    self.title_label:setString(string.format(TI18N("语言_c_4520"), self.lev))-- .. "--" .. self.data.num)
    self.title_label:setVisible(true)
    self.point_layer:setVisible(false)
    if type == 1 then -- 是起点
        if self.isinit == 1 then -- 表示已经初始化
            loadSpriteTexture(self.img_bg, PathTool.getResFrame("wonderland", "wonderland_plaid_item"),
                LOADTEXT_TYPE_PLIST)
            self.start_label:setVisible(false)
            local item_data
            local itemList = self.data.parameter
            for index, value in ipairs(itemList) do
                local temp = value[1]
                if temp == level then
                    item_data = value
                end
            end
            if item_data then
                if not self.item then
                    self.item = BackPackItem.new(false, true, false, 0.55, false, true)
                    self.item:setPositionX(46)
                    self.item:setPositionY(67)
                    self.main_container:addChild(self.item)
                end
                self.item:setBaseData(item_data[2], item_data[3])
            end
        else
            self.start_label:setVisible(true)
            self.title_label:setVisible(false)
        end
    elseif type == 2 then
        local item_data
        local itemList = self.data.parameter
        for index, value in ipairs(itemList) do
            local temp = value[1]
            if temp == level then
                item_data = value
            end
        end
        if item_data then
            if not self.item then
                self.item = BackPackItem.new(false, true, false, 0.55, false, true)
                self.item:setPositionX(46)
                self.item:setPositionY(67)
                self.main_container:addChild(self.item)
            end
            self.item:setBaseData(item_data[2], item_data[3])
        end
    elseif type == 3 then
        if not self.point_img then
            self.point_img = createSprite(PathTool.getResFrame("wonderland", "wonderland_point_max"), 32, 32,
                self.point_layer, cc.p(0.5, 0.5), LOADTEXT_TYPE_PLIST, 2)
            self.point_img:setScale(0.5)
        end
        self.point_img:setVisible(true)
        self.point_num_txt:setString(self.data.parameter[1])
        self.point_layer:setVisible(true)
        self.title_label:setTextColor(cc.c3b(0xf9, 0xee, 0xd0))
        self.title_label:enableOutline(cc.c4b(58, 41, 10, 255), 2)
        self.title_label:setVisible(false)
    elseif type == 4 then
        if not self.item then
            self.item = BackPackItem.new(false, true, false, 0.55, false, true)
            self.item:setPositionX(46)
            self.item:setPositionY(56)
            self.item:setIsShowBackground(false)
            self.item:setScale(0.8)
            self.main_container:addChild(self.item)
        end
        self.item:setBaseData(self.data.parameter[1][1], self.data.parameter[1][2])
        self.title_label:setVisible(false)
    end
end

function ActionMonoItem:setBuildIngLv(lv, isinit)
    local base_cfg = Config.WonderlandData.data_wonderland_const.lattice_lv_max
    self.lev = lv + 1
    if self.lev > base_cfg.val then
        self.lev = base_cfg.val
    end
    self.isinit = isinit
    self:setItemInfo()
end

function ActionMonoItem:getBuildId()
    if not self.data then return nil end
    return self.data.num
end

function ActionMonoItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end
