local _hero_controller = HeroController:getInstance()
local _table_insert = table.insert
local elfin_controller = ElfinController:getInstance()

ShadowChallengeGoFightPanel = ShadowChallengeGoFightPanel or BaseClass()

function ShadowChallengeGoFightPanel:__init(parent, super_panel, form_show_type, fun_form_type)
    self.is_init = true
    self.parent = parent
    self.super_panel = super_panel
    self.form_show_type = form_show_type
    self.fun_form_type = fun_form_type
    self.halo_load = nil
    self.is_move_hero = false -- move_item 正在跟随手指移动中
    self.is_show_act = false  -- move_item 是否在移动动作中


    --英雄对象 left
    self.hero_item_list_left = {}
    self.plan_id = 0 --精灵方案
    self.hallows_id = 0  --神器id
    self.formation_type = 1 --默认阵法
    --英雄对象 right
    self.hero_item_list_right = {}

    --四个空白图片
    self.four_blank_img_left = {}
    self.four_blank_img_right = {}

    self.item_rect_list = {} --记录格子的区域

    self.halo_form_id_list = {}

    self.elfin_item_list = {} --精灵

    self.cell_width = 134
    self.nine_position = {
        [1] = cc.p(self.cell_width, -self.cell_width),
        [2] = cc.p(self.cell_width, 0),
        [3] = cc.p(self.cell_width, self.cell_width),
        [4] = cc.p(0, -self.cell_width),
        [5] = cc.p(0, 0),
        [6] = cc.p(0, self.cell_width),
        [7] = cc.p(-self.cell_width, -self.cell_width),
        [8] = cc.p(-self.cell_width, 0),
        [9] = cc.p(-self.cell_width, self.cell_width),
    }

    self.nine_position_right = {
        [7] = cc.p(self.cell_width, -self.cell_width),
        [8] = cc.p(self.cell_width, 0),
        [9] = cc.p(self.cell_width, self.cell_width),
        [4] = cc.p(0, -self.cell_width),
        [5] = cc.p(0, 0),
        [6] = cc.p(0, self.cell_width),
        [1] = cc.p(-self.cell_width, -self.cell_width),
        [2] = cc.p(-self.cell_width, 0),
        [3] = cc.p(-self.cell_width, self.cell_width),
    }
    self.halo_num = PotentialController:getInstance():getModel():getHaloNum()
    self.team_index = 1
    self:createRoorWnd()
    self:registerEvent()
end

function ShadowChallengeGoFightPanel:createRoorWnd(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("shadowchallenge/shadow_challenge_go_fight_panel"))
    if not tolua.isnull(self.parent) then
        self.root_wnd:setPosition(cc.p(-5, 330))
        self.parent:addChild(self.root_wnd)
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    local form_panel = self.main_container:getChildByName("form_panel")
    self.form_panel = form_panel
    local analyzeFormUI = function(node, hero_item_list, four_blank_img, station)
        local pos = {2,4,6,7,9}--一开始默认 第一个阵法位置
        local nine_position = self.nine_position --默认是左边
        if station == "right" then
            nine_position = self.nine_position_right
        end
        for index=1,5 do
            if station == "right" then
                hero_item_list[index] = HeroExhibitionItem.new(1, true)
                -- hero_item_list[index]:setExtendData({from_type = HeroConst.ExhibitionItemType.eLegendTrial})
                -- hero_item_list[index]:addCallBack(function(_,data)
                --     self:onClickItem(data, "right")
                -- end)
            else
                hero_item_list[index] = HeroExhibitionItem.new(1, false)
            end
            hero_item_list[index]:setPosition(nine_position[pos[index]])
            node:addChild(hero_item_list[index])
            local world_pos = hero_item_list[index]:convertToWorldSpace(cc.p(0, 0))
            local node_pos = self.main_container:convertToNodeSpace(world_pos)
            _table_insert(self.item_rect_list, cc.rect( node_pos.x, node_pos.y, HeroExhibitionItem.Width*0.7, HeroExhibitionItem.Height*0.7))
        end
        for i=1,4 do
            four_blank_img[i] = node:getChildByName("hero_info_21_"..i) 
        end
    end
    local fight_hero_node_left = form_panel:getChildByName("fight_hero_node_left")
    analyzeFormUI(fight_hero_node_left, self.hero_item_list_left, self.four_blank_img_left, "left")
    self.fight_hero_node_left = fight_hero_node_left
    local fight_hero_node_right = form_panel:getChildByName("fight_hero_node_right")
    analyzeFormUI(fight_hero_node_right, self.hero_item_list_right, self.four_blank_img_right, "right")
    self.fight_hero_node_right = fight_hero_node_right

    --阵法
    self.form_change_btn = form_panel:getChildByName("form_change_btn")
    self.form_change_btn:getChildByName("label"):setString(TI18N("语言_c_1966"))
    --阵法icon
    self.form_icon = self.form_change_btn:getChildByName("form_icon")
    --光环icon
    self.halo_btn = form_panel:getChildByName("halo_btn")
    self.halo_label = self.halo_btn:getChildByName("label")
    --sp光环icon
    self.sp_btn = form_panel:getChildByName("sp_btn")
    self.sp_skill = self.sp_btn:getChildByName("sp_skill")
    self.sp_label = self.sp_btn:getChildByName("label")
    self.sp_label:setString(TI18N("语言_c_6756"))
    if not HeroController:getInstance():getModel():getSpecialHeroHuanShield() then
        self.sp_btn:setVisible(false)
    else
        self.sp_btn:setVisible(true)
    end
        --穿戴
    self.equip_btn = form_panel:getChildByName("equip_btn")

    local size = self.equip_btn:getContentSize()
    self.hallow_item = BackPackItem.new(false, false, false, 0.8)
    self.hallow_item:showAddIcon(true)
    self.hallow_item:setPosition(cc.p(size.width * 0.5, size.height * 0.5))
    self.equip_btn:addChild(self.hallow_item)

    self.equip_btn_label = self.equip_btn:getChildByName("label")
    self.equip_btn_label:setString(TI18N("语言_c_3148"))
    -- 精灵
    self.elfin_btn = form_panel:getChildByName("elfin_btn")
    if self.elfin_btn then
        self.elfin_btn:getChildByName("label"):setString(TI18N("语言_c_3149"))
    end

    self.label_power_left = form_panel:getChildByName("label_power_left")
    self.label_power_right = form_panel:getChildByName("label_power_right")

    self.go_fight_btn = form_panel:getChildByName("go_fight_btn")
    self.go_fight_btn:getChildByName("label"):setString(TI18N("语言_c_444"))
    self.go_fight_btn:setPositionY(-424)

    self:updateAllTeamInfo()
    -- self:updateFormationData()
end

