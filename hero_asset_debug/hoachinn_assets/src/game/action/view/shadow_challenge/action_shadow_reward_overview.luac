ActionShadowRewardOverview = ActionShadowRewardOverview or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionShadowRewardOverview:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.win_type = WinType.Big
    self.layout_name = "shadowchallenge/shadow_challenge_reward_overview"
    self.res_list = {
    }
end

function ActionShadowRewardOverview:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_container, 1)
    local title_container = self.main_panel:getChildByName("title_container")
    self.title_container = title_container
    local image_title = title_container:getChildByName("image_title")
    local title_label = title_container:getChildByName("title_label")
    title_label:setString(TI18N("语言_c_21"))

    self.first_reward = self.main_panel:getChildByName("first_reward")
    self.first_tips = self.first_reward:getChildByName("tips")
    self.first_tips:setString(TI18N("语言_c_2878"))
    local first_tips_bg = self.first_reward:getChildByName("Image_5")
    autoSizeTitleBg(self.first_tips, first_tips_bg, 50,217)
    self.first_reward_scroller = self.first_reward:getChildByName("reward_scroller")
    
    self.normal_reward = self.main_panel:getChildByName("normal_reward")
    self.normal_tips = self.normal_reward:getChildByName("tips")
    self.normal_tips:setString(TI18N("语言_c_6290"))
    local normal_tips_bg = self.normal_reward:getChildByName("Image_5")
    autoSizeTitleBg(self.normal_tips, normal_tips_bg, 50,217)
    self.normal_reward_scroller = self.normal_reward:getChildByName("reward_scroller")

    self.close_btn = self.main_panel:getChildByName("close_btn")
end
function ActionShadowRewardOverview:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickCloseBtn), false, 2)
end


function ActionShadowRewardOverview:onClickCloseBtn()
    controller:openShadowChallengeOverView(false)
end

function ActionShadowRewardOverview:openRootWnd(data)
    self.fb_id = data
    self.data = model:getShadowChallengeFbInfo(self.fb_id)
    -- print(vardump(self.data))
    local first_reward = self.data.reward
    local daily_reward_status = self.data.fd
    local setting = {}
    setting.scale = 0.7
    setting.max_count = 3
    setting.is_center = true
    setting.is_get_status = (daily_reward_status == 1)
    setting.get_status_res = PathTool.getResFrame("common", "common_1000")
    -- setting.show_effect_id = 263
    local data_list = {}
    for k, v in pairs(first_reward) do
        local _temp = {}
        table.insert(_temp,v.base_id)
        table.insert(_temp,v.num)
        table.insert(data_list,_temp)
    end

	self.item_list = commonShowSingleRowItemList(self.first_reward_scroller, self.item_list, data_list, setting)
    --有随机奖励
    local preview_reward = self.data.preview
    if preview_reward and next(preview_reward) then
        local data_list = {}
        for k, v in pairs(preview_reward) do
            local _temp = {}
            table.insert(_temp,v.base_id)
            table.insert(_temp,v.num)
            table.insert(data_list,_temp)
        end
        local setting1 = {}
        setting1.scale = 0.7
        setting1.max_count = 3
        setting1.is_center = true
        self.item_list2 = commonShowSingleRowItemList(self.normal_reward_scroller, self.item_list2, data_list, setting1)

        self.main_panel:setContentSize(cc.size(623, 384))
        self.first_reward:setPositionY(261)
        self.title_container:setPositionY(352)
        self.close_btn:setPositionY(373)
    else
        self.normal_reward:setVisible(false)
        self.main_panel:setContentSize(cc.size(623, 221))
        self.first_reward:setPositionY(97)
        self.title_container:setPositionY(184)
        self.close_btn:setPositionY(215)
    end
end


function ActionShadowRewardOverview:setData(data)
  
end

function ActionShadowRewardOverview:close_callback()
    -- if self.point_info_event then
    --     GlobalEvent:getInstance():UnBind(self.point_info_event)
    --     self.point_info_event = nil
    -- end

    controller:openShadowChallengeOverView(false)
end