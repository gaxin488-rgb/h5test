-- --------------------------------------------------------------------
-- 
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      影之试炼排行榜主界面
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
ShadowChallengeRankPanel = class("ShadowChallengeRankPanel",function()
    return ccui.Layout:create()
end)
local controller = ActionController:getInstance()
function ShadowChallengeRankPanel:ctor(type)
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("shadowchallenge/shadow_challenge_rank_panel"))
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self.tips = self.root_wnd:getChildByName("tips")
    self.tips:setString(transformTextToShort(TI18N("语言_c_6329"),60))
    addEvt2showAllTextTips(self.tips,TI18N("语言_c_6329"),60)
    self.scroll_container = self.root_wnd:getChildByName("scroll_container")
    self.empty_bg = self.scroll_container:getChildByName("empty_bg")
    self.empty_bg:setVisible(false)
    loadSpriteTexture(self.empty_bg, PathTool.getPlistImgForDownLoad("bigbg", "bigbg_3"), LOADTEXT_TYPE)
    self.desc_label = self.empty_bg:getChildByName("desc_label")
    self.desc_label:setPositionX(self.empty_bg:getContentSize().width / 2)
    self.desc_label:setString(TI18N("语言_c_1067"))

    local title_img = self.scroll_container:getChildByName("titile_img")
    local title_img_rank_txt = title_img:getChildByName("rank_txt")
    title_img_rank_txt:setString(TI18N("语言_c_281"))
    local title_img_role_name = title_img:getChildByName("role_name")
    title_img_role_name:setString(TI18N("语言_c_1879"))
    local title_img_score_txt = title_img:getChildByName("score_txt")
    title_img_score_txt:setString(TI18N("语言_c_6328"))
    setTextMaxWidth(title_img_score_txt,200,-10)

    self.scroller_panel = self.scroll_container:getChildByName("Panel_2")
    local size = cc.size(self.scroll_container:getContentSize().width, self.scroller_panel:getContentSize().height-10)
    local setting = {
        item_class = ShadowChallengeRankItem,
        start_x = 0,
        space_x = 4,
        start_y = 0,
        space_y = 0,
        item_width = 614,
        item_height = 125,
        row = 0,
        col = 1,
        need_dynamic = true
    }
    self.scroll_view = CommonScrollViewLayout.new(self.scroller_panel, cc.p(0, 5), nil, nil, size, setting)

    local my_container = self.root_wnd:getChildByName("my_container")
    local my_rank_title = my_container:getChildByName("my_rank_title")
    my_rank_title:setString(TI18N("语言_c_258"))
    self.rank_img = my_container:getChildByName("rank_img")
    self.rank_img:setVisible(false)
    self.rank_x = self.rank_img:getPositionX()
    self.rank_y = self.rank_img:getPositionY()

    self.role_name = my_container:getChildByName("role_name")
    self.role_power = my_container:getChildByName("role_power")
    self.power_bg = my_container:getChildByName("Image_1")
    self.no_rank = my_container:getChildByName("no_rank")
    self.rank_index = my_container:getChildByName("rank_id")
    setTextMaxWidth(self.no_rank,100)
    self.no_rank:setString(TI18N("语言_c_285"))
    self.no_rank:setVisible(false)
    if not self.four_label then
        self.four_label = createRichLabel(26, Config.ColorData.data_color4[175],cc.p(0.5,0.5), cc.p(512,65), 0, 0, 500)
        my_container:addChild(self.four_label)
    end

    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.role_head:setHeadLayerScale(0.8)
    self.role_head:setPosition(205, 63)
    self.role_head:setLev(99)
    my_container:addChild(self.role_head)

    self.my_container = my_container

    self:registerEvent()
end

function ShadowChallengeRankPanel:registerEvent()
    if self.update_rank_event == nil then
        self.update_rank_event = GlobalEvent:getInstance():Bind(ActionEvent.ShadowChallengeRankData, function(data) 
            self:updateRankList(data)
        end)
    end
end

function ShadowChallengeRankPanel:setNodeVisible(status)
    self:setVisible(status)
end

function ShadowChallengeRankPanel:addToParent()
    controller:sender18307()
end

function ShadowChallengeRankPanel:updateRankList(data)
    self.data = data
    local function click_callback(item)
        -- self:worshipOtherRole(item)
    end
    local rank_data = data.shadow_challenge_role_rank
    local sort_func = SortTools.tableLowerSorter({"rank"})
    table.sort(rank_data,sort_func)
    if data.shadow_challenge_role_rank ~= nil and next(data.shadow_challenge_role_rank) ~= nil then
        self.scroll_view:setData(rank_data, click_callback)
        self.empty_bg:setVisible(false)
    else
        self.empty_bg:setVisible(true)
    end
    self:updateMyData()
end
function ShadowChallengeRankPanel:updateMyData()
    if not self.data then return end 
    local data = self.data
    local str = "0"
    local my_idx = data.role_rank or 0
    if my_idx and my_idx >0 then 
        str = my_idx
    end
    self.no_rank:setVisible(false)
    local role_vo = RoleController:getInstance():getRoleVo()
    self.rank_index:setString(str)
    if my_idx and my_idx >= 1 and my_idx <= 3 then
        self.rank_index:setVisible(false)
        self.rank_img:setVisible(true)
        loadSpriteTexture( self.rank_img, PathTool.getResFrame("common","common_200"..my_idx), LOADTEXT_TYPE_PLIST)--(,)
    else
        if my_idx <=0 then
            self.no_rank:setVisible(true)
            self.rank_index:setVisible(false)
        else
            self.rank_index:setVisible(true)
            if self.my_rank_icon then
                self.my_rank_icon:setVisible(false)
            end
        end
    end
    self.role_head:setHeadRes(role_vo.face_id, false, LOADTEXT_TYPE, role_vo.face_file, role_vo.face_update_time)
    local name = role_vo.name or ""
    self.role_name:setString(name)
    local avatar_bid = data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.role_head:showBg(res, nil, false, vo.offy)
    end

    self.role_power:setString(role_vo.srv_id)
    
    local score = data.role_val or 0
    str = score
    self.four_label:setString(str)
    -- self.four_label:setPosition(cc.p(525,53))
end


function ShadowChallengeRankPanel:DeleteMe()
    if self.update_rank_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_rank_event)
        self.update_rank_event = nil
    end
    if self.update_worship_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_worship_event)
        self.update_worship_event = nil
    end

    if self.rank_num then
        self.rank_num:DeleteMe()
        self.rank_num = nil
    end
    if self.scroll_view then
        self.scroll_view:DeleteMe()
        self.scroll_view = nil
    end
end


-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- @description:
--      循环赛排行榜单元
-- <br/>Create: new Date().toISOString()
--
-- --------------------------------------------------------------------
ShadowChallengeRankItem = class("ShadowChallengeRankItem",function()
    return ccui.Layout:create()
end)

function ShadowChallengeRankItem:ctor()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("shadowchallenge/shadow_challenge_rank_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    self.rank_img = container:getChildByName("rank_img")
    self.role_name = container:getChildByName("role_name")
    self.role_power = container:getChildByName("role_power")
    self.score_info = createRichLabel(26, cc.c4b(0x7c,0x55,0x36,0xff), cc.p(0.5, 0.5), cc.p(510, 60), nil, nil, 300)
    container:addChild(self.score_info)

    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.role_head:setHeadLayerScale(0.8)
    self.role_head:setPosition(202, 63)
    container:addChild(self.role_head)
    self.role_head:setLev(99)

    self.container = container

    self:registerEvent()
end

function ShadowChallengeRankItem:registerEvent()
    self.role_head:addCallBack( function()
        if self.data ~= nil then
            FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.data.srv_id, rid = self.data.rid})
        end
    end,false)
end

function ShadowChallengeRankItem:addCallBack(call_back)
    self.call_back = call_back
end
function ShadowChallengeRankItem:setData(data)
    local role_vo = RoleController:getInstance():getRoleVo()
    if data and role_vo then
        self.data = data
        self.role_name:setString(data.name)
        self.role_power:setString(data.srv_id)
        -- local width = self.role_power:getContentSize().width + 75
        -- local height = self.power_bg:getContentSize().height
        -- self.power_bg:setContentSize(cc.size(width,height))
        self.role_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
        self.role_head:setLev(data.lev)
        local avatar_bid = data.avatar_id 
        local vo = Config.AvatarData.data_avatar[avatar_bid]
        if vo then
            local res_id = vo.res_id or 1
            local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
            self.role_head:showBg(res, nil, false, vo.offy)
        end

        if data.rank <= 3 then
            if self.rank_num ~= nil then
                self.rank_num:setVisible(false)
            end
            if data.rank == 0 then
                self.rank_img:setVisible(false)
            else
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.rank))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id = res_id
                    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_img:setVisible(true)
            end
        else
            if self.rank_num == nil then
                self.rank_num = CommonNum.new(1, self.container, 1, -2, cc.p(0.5, 0.5))
                self.rank_num:setPosition(59, 77)
            end
            self.rank_num:setVisible(true)
            self.rank_num:setNum(data.rank)
            self.rank_img:setVisible(false)
        end
        -- local msg = string.format(TI18N("<div>%s</div><div fontcolor=#249003 fontsize=22>%s</div>"), TI18N("语言_c_4812"), data.val1 or 0)
        self.score_info:setString(data.val)
    end
end

function ShadowChallengeRankItem:DeleteMe()
    if self.rank_num ~= nil then
        self.rank_num:DeleteMe()
        self.rank_num = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end
