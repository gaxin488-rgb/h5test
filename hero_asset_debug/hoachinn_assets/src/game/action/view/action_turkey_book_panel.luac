ActionTurkeyBookPanel = ActionTurkeyBookPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
function ActionTurkeyBookPanel:__init()
    self.is_full_screen = true
    self.title_btn_list = {}
    self.reward_btn_list = {}
    self.item_list = {}
    self.click_index = 0
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_turkey_book_panel"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("partnersummon", "partnersummon"), type = ResourcesType.plist },
    }
    self.tab_name = {
        [1] = TI18N("语言_c_7623"),
        [2] = TI18N("语言_c_7624"),
    }
    self.bottom_tab_list = {}
end

function ActionTurkeyBookPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2)
    self.title = self.main_container:getChildByName("title")
    self.title:setString(TI18N("语言_c_6409"))
    self.choose_panel = self.main_container:getChildByName("choose_panel")
    self.choose_bg = self.choose_panel:getChildByName("choose_bg")
    self.click_icon = self.choose_panel:getChildByName("click_icon")
    -- self.click_icon:setZOrder(999)
    self.progress_panel = self.main_container:getChildByName("progress_panel")
    self.progress_panel_width = self.progress_panel:getContentSize().width
    self.progress_bg = self.progress_panel:getChildByName("progress_bg")
    self.progress = self.progress_panel:getChildByName("progress")
    self.progress:setPercent(0)
    self.num_label = self.progress_panel:getChildByName("num_label")
    self.num_label:setString("0%")
    self.book_panel = self.main_container:getChildByName("book_panel")
    self.ScrollView = self.book_panel:getChildByName("ScrollView")
    self.ScrollView:setScrollBarEnabled(false)
    self.ScrollView_size = self.ScrollView:getContentSize()
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.botton_panel = self.root_wnd:getChildByName("botton_panel")
    self.botton_panel:setVisible(false)
    for i = 1, #self.tab_name, 1 do
        local tab_btn = {}
        local item = self.botton_panel:getChildByName("tab_btn_"..i)
        tab_btn.btn = item
        tab_btn.index = i
        tab_btn.select_bg = item:getChildByName("select_bg")
        -- tab_btn.select_bg:setVisible(false)
        tab_btn.select_img = item:getChildByName("select_img")
        -- tab_btn.select_img:setVisible(false)
        tab_btn.normal_img = item:getChildByName("normal_img")
        tab_btn.label = item:getChildByName("label")
        setTextSpacing(tab_btn.label,-8)
        tab_btn.label:setString(self.tab_name[i])
        tab_btn.red_point = item:getChildByName("red_point")
        tab_btn.red_point:setVisible(false)
        -- tab_btn.btn:setVisible(false)
        self.bottom_tab_list[i] = tab_btn
    end

    
    local bottom_y = display.getBottom()
    self.botton_panel:setPositionY(bottom_y)
end

function ActionTurkeyBookPanel:register_event()
    registerButtonEventListener(self.background,function()
        controller:openActionTurkeyBookPanel(false)
    end,false,2)
    registerButtonEventListener(self.close_btn,function()
        controller:openActionTurkeyBookPanel(false)
    end,false,2)
    for index, tab_btn in ipairs(self.bottom_tab_list) do
        registerButtonEventListener(tab_btn.btn, function() self:changeTabFun(index, true, tab_btn.btn) end ,false, 1) 
    end
    
    -- 火鸡节数据返回
	if not self.update_turke_book_data then
        self.update_turke_book_data = GlobalEvent:getInstance():Bind(ActionEvent.UpdateTurkeyBookData, function()
            self:setTitlePanel()
            if self.click_index == 0 then
                self:ClickTitleBtn(self.index)
            else
                self:setProgressPanel()
            end
        end)
    end
    
    self:addGlobalEvent(HomeworldEvent.Update_Puzzle_Red_Event, function()
        self:updatePuaaleRed()
    end)
end
