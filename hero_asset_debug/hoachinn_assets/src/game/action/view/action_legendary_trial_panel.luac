ActionLegendaryTrialpanel = class("ActionLegendaryTrialpanel", function()
	return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionLegendaryTrialpanel:ctor(bid)
    self.holiday_bid = bid
    self.trial_data_list={}
    self.rank_list = {}
    self.act_vo= controller:getActionSubTabVo(bid)
    self.actid= Config.HolidayLegendTrialData.data_get_base_id[self.act_vo.camp_id]
    model:setAcBid(bid,self.act_vo.camp_id)
	self:configUI()
    self:register_event()

    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("legend_trial","Legendary_trial"), type = ResourcesType.plist},
    }
end

