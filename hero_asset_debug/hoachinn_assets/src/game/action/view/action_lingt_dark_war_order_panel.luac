function ActionLingtDarkWarOrderPanel:register_event()
    registerButtonEventListener(self.panel_btn_1, function()
        self:setPanelVis(true)
	end, true)
    registerButtonEventListener(self.panel_btn_2, function()
        self:setPanelVis(false)
	end, true)
    registerButtonEventListener(self.war_order_buy, function()
        controller:openActionLingtDarkWarOrderAdvancedPanel(true)
	end, true)
    registerButtonEventListener(self.exp_buy_btn, function()
        controller:openActionLingtDarkWarOrderBuyexpPanel(true)
	end, true)
    
    registerButtonEventListener(self.extra_exp_btn, function()
        local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
        local rewardList = deepCopy(Config.ChuanqiTaskData.data_lv_reward[id])
        if self.data.lv < tableLen(rewardList) then
            controller:sender21704(self.holiday_bid)
        else
            message(TI18N("语言_c_4337"))
        end
	end, true)
    if not self.legendary_signData  then
        self.legendary_signData = GlobalEvent:getInstance():Bind(ActionEvent.LingtDarkData,function (data)
            self:setData(data)
            if data.buy == 1 then
                GlobalEvent:getInstance():Fire(ActionEvent.LingtDarkChargeData)
                controller:openActionLingtDarkWarOrderAdvancedPanel(false)
            end
        end)
    end
    if not self.legendarysign_task_data  then
        self.legendarysign_task_data = GlobalEvent:getInstance():Bind(ActionEvent.LingtDarkTaskData,function (data)
            self:settaskPanel(data.list)
        end)
    end
end
function ActionLingtDarkWarOrderPanel:setPanelVis(status)
    self.reward_panel:setVisible(status)
    self.task_panel:setVisible(not status)
    self.normal_img1:setVisible(not status)
    self.select_img1:setVisible(status)
    self.normal_img2:setVisible(status)
    self.select_img2:setVisible(not status)
end
function ActionLingtDarkWarOrderPanel:setData(data)
    if not data then
        data = model:getLingtDarkData()
        if not data then return end
    end
    local action_data = NewPartnersummonController:getInstance():getModel():getSummonWarData()
    -- loadSpriteTexture(self.backpackground,PathTool.getResFrame("legendary_battle", action_data.reward_title), LOADTEXT_TYPE)
    loadSpriteTexture(self.backpackground,string.format("resource/starplan/banner/%s.png",action_data.reward_title), LOADTEXT_TYPE)
    if self.holiday_bid == ActionRankCommonType.LingtDarkWar or self.holiday_bid == ActionRankCommonType.LingtDarkWar2 then
        loadSpriteTexture(self.level_bg,PathTool.getResFrame("legendary_battle", "legendary_battle_1_1"), LOADTEXT_TYPE_PLIST)
    else
        loadSpriteTexture(self.level_bg,PathTool.getResFrame("legendary_battle", "legendary_battle_1"), LOADTEXT_TYPE_PLIST)
    end
    self.data = data
    self.level:setString(data.lv)
    self.war_order_buy:setVisible(data.buy == 0)
    local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
    self.title:setString(Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].banner)
    self.title_bg:setContentSize(cc.size(self.title:getContentSize().width + 140,self.title:getContentSize().height + 20))
    local rewardList = deepCopy(Config.ChuanqiTaskData.data_lv_reward[id])
    self.gift_bg:setVisible(data.buy == 1 and data.lv < tableLen(rewardList))
    self.extra_exp_red:setVisible(data.buy == 1 and data.day_reward == 0)
    self.war_order_buy_txt:setString(TI18N("语言_chuan_3"))
    -- self.war_order_buy:setContentSize(cc.size(self.war_order_buy_txt:getContentSize().width + 20 ,55))
    -- self.war_order_buy_txt:setPositionX(self.war_order_buy:getContentSize().width / 2)
    local endtime = data.end_time - GameNet:getInstance():getTime()
    controller:getModel():setCountDownTime(self.time_value,endtime or 0)
    self.time_value:setPositionX(self.time_txt:getPositionX() + self.time_txt:getContentSize().width + 5)
    self.time_bg:setContentSize(cc.size(self.time_value:getContentSize().width + self.time_txt:getContentSize().width + 20,30))
    local value = data.exp
    local cfg = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()]
    local period = cfg.period
    local target_value = Config.ChuanqiTaskData.data_lv_exp[period][data.lv].exp or 100
    self.exp_bar:setPercent(value/target_value*100)
    local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
    local rewardList = deepCopy(Config.ChuanqiTaskData.data_lv_reward[id])
    if data.lv < tableLen(rewardList) then
        -- self.exp_bar_txt:setString(value.."/"..target_value)
        self.exp_buy_btn:setVisible(true)
        self.exp_bar_txt:setVisible(true)
    else
        -- self.exp_bar:setPercent(100)
        -- self.exp_bar_txt:setString(TI18N("语言_s_1780"))
        self.exp_buy_btn:setVisible(false)
        self.exp_bar_txt:setVisible(false)
    end
    self:setRewardLineData()
    self:setRewardPanel(rewardList)
    self:setPanelVis(true)
    local jump_index = 0
    for key, value in pairs(self.rewardList) do
        local num = model:getLingtDarkRewardLock(key)
        if num == 1 or num == 2 or num == 4 then
            jump_index = key
            break
        end
    end
    if jump_index == 0 then
        if self.data.lv >= tableLen(rewardList) then
            self.reward_list:selectCellByIndex(self.data.lv - 1)
            self.reward_num_item:selectCellByIndex(self.data.lv - 1)
        else
            self.reward_list:selectCellByIndex(self.data.lv)
            self.reward_num_item:selectCellByIndex(self.data.lv)
        end
    else
        self.reward_list:selectCellByIndex(jump_index)
        self.reward_num_item:selectCellByIndex(jump_index)
    end
    self.reward_list:resetCurrentItems()
    self.reward_num_item:resetCurrentItems()
end
--战令奖励
function ActionLingtDarkWarOrderPanel:setRewardPanel(list)
    self.rewardList = list
    if self.reward_list == nil then
        local scroll_view_size = self.item_panel:getContentSize()
        local setting = {
            start_x = 0,
            space_x = 0,
            start_y = 5,
            space_y = 4,
            item_width = 700,
            item_height = 120,
            row = 0,
            col = 1,
            need_dynamic = true,
            checkovercallback = handler(self, self.updateSlideShowByVertical)
        }
        self.reward_list = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
        self.reward_list:setSwallowTouches(false)
        self.reward_list:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_list:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_list:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell

        ---进度条相关
        local scroll_view_size2 = cc.size(100, scroll_view_size.height)
        local setting = {
            start_x = 10, -- 第一个单元的X起点
            space_x = 0, -- x方向的间隔
            start_y = 5, -- 第一个单元的Y起点
            space_y = 4, -- y方向的间隔
            item_width = 100, -- 单元的尺寸width
            item_height = 120, -- 单元的尺寸height
            row = 0, -- 行数，作用于水平滚动类型
            col = 1, -- 列数，作用于垂直滚动类型
            need_dynamic = true
        }
        self.reward_num_item = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
        self.reward_num_item:setClickEnabled(false)
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    end
    self.reward_list:reloadData(nil,nil,true)
    self.reward_num_item:reloadData(nil,nil,true)
end
--经验条数据
function ActionLingtDarkWarOrderPanel:setRewardLineData()    
    local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
    self.expList = deepCopy(Config.ChuanqiTaskData.data_lv_exp[id])
end
-- 滑动的时候处理显示
function ActionLingtDarkWarOrderPanel:updateSlideShowByVertical()
    local container_y = self.reward_list:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end
-- 进度条
-- 功勋数数列表
function ActionLingtDarkWarOrderPanel:createTaskCell2()
    local cell = ActionLingtDarkWarWarOrderBarItem.new()
    return cell
end

function ActionLingtDarkWarOrderPanel:numberOfTaskCells2()
    if not self.expList then
        return 0
    end
    return #self.expList
end

function ActionLingtDarkWarOrderPanel:updateTaskCellByIndex2(cell, index)
    if not self.expList then
        return
    end
    local cell_data = self.expList[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end
-- 奖励列表
function ActionLingtDarkWarOrderPanel:createTaskCell()
    local cell = ActionLingtDarkWarOrderRewardItem.new()
    return cell
end

function ActionLingtDarkWarOrderPanel:numberOfTaskCells()
    if not self.rewardList then
        return 0
    end
    return #self.rewardList
end

function ActionLingtDarkWarOrderPanel:updateTaskCellByIndex(cell, index)
    if not self.rewardList then
        return
    end
    local cell_data = self.rewardList[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,index)
end

--任务
function ActionLingtDarkWarOrderPanel:settaskPanel(data)
    local scrollH = 0
    self.taskData = data
    for key, value in pairs(data) do
        local _h = 0
        if tableLen(value) ~= 0 then
            _h = _h + 60
        end
        scrollH = scrollH + 210 * math.ceil(tableLen(value)/2) + _h
    end
    self.task_panel:setInnerContainerSize(cc.size(693,scrollH))
    for key, value in pairs(data) do
        if tableLen(value) ~= 0 then
            self:settaskPanelList(key,value)
        end
    end
end
function ActionLingtDarkWarOrderPanel:settaskPanelList(index,data)
    local _h = 0
    if tableLen(data) ~= 0 then
        _h = _h + 60
    end
    local panel_h = 210 * math.ceil(tableLen(data)/2) + _h
    local layout = ccui.Layout:create()
    layout:setContentSize(cc.size(693, panel_h))
    layout:setAnchorPoint(cc.p(0, 0))
    if index == 3 then
        layout:setPosition(cc.p(0, 0))
    elseif index == 2 then
        local _h = 0
        if tableLen(self.taskData[3]) ~= 0 then
            _h = _h + 60
        end
        local panel_y = 210 * math.ceil(tableLen(self.taskData[3])/2) + _h
        layout:setPosition(cc.p(0, panel_y))
    elseif index == 1 then
        local _h = 0
        if tableLen(self.taskData[3]) ~= 0 then
            _h = _h + 60
        end
        if tableLen(self.taskData[2]) ~= 0 then
            _h = _h + 60
        end
        local panel_y = 210 * math.ceil(tableLen(self.taskData[2])/2) + 210 * math.ceil(tableLen(self.taskData[3])/2) + _h
        layout:setPosition(cc.p(0, panel_y))
    end
    self.task_panel:addChild(layout)
    table.insert(self.panelList,index,layout)
    local res = PathTool.getResFrame("legendary_battle","legendary_battle_9")
    local title_bg = createSprite(res,0,panel_h,layout,cc.p(0,1),LOADTEXT_TYPE_PLIST)
    local title = createLabel(30,cc.c4b(0xd7,0x53,0x03,0xff),cc.c4b(0xfe,0xfe,0xdc),20,20,index,title_bg,2,cc.p(0,0.5))
    local time_txt = createLabel(24,cc.c4b(0xff,0xff,0xff,0xff),nil,20,20,index,title_bg,2,cc.p(1,0.5))
    local time_val = createLabel(24,cc.c4b(0x0e,0xa8,0x0e,0xff),nil,680,20,index,title_bg,2,cc.p(1,0.5))
    table.insert(self.timeValueList,index,time_val)
    local time = data[1].end_time - GameNet:getInstance():getTime()
    commonCountDownTime(self.timeValueList[index], time)
    if index == 1 then
        title:setString(TI18N("语言_c_731"))
        time_txt:setString(TI18N("语言_c_734"))
    elseif index == 2 then
        title:setString(TI18N("语言_c_5121"))
        time_txt:setString(TI18N("语言_c_1242"))
    elseif index == 3 then
        title:setString(TI18N("语言_c_5296"))
        --time_txt:setString(TI18N("语言_c_1242"))
		time_txt:setVisible(false)
		time_val:setVisible(false)
    end
    time_txt:setPositionX(time_val:getPositionX() - time_val:getContentSize().width-10)
    for i=1,tableLen(data) do
        local item = ActionLingtDarkWarWarOrderTaskItem:new()
        local pos_x =(1-i%2)*349
        local pos_y = panel_h - 45 - (math.ceil(i/2)-1)*213
        item:setPosition(cc.p(pos_x,pos_y))
        layout:addChild(item)
        item:setData(index,i,data[i])
    end
end
function ActionLingtDarkWarOrderPanel:DeleteMe()
    -- model:deLegendarySignTaskData()
    if self.reward_list then
        self.reward_list:DeleteMe()
        self.reward_list = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.legendary_signData then
        self.legendary_signData = GlobalEvent:getInstance():UnBind(self.legendary_signData)
        self.legendary_signData = nil
    end
    if self.legendarysign_task_data then
        self.legendarysign_task_data = GlobalEvent:getInstance():UnBind(self.legendarysign_task_data)
        self.legendarysign_task_data = nil
    end
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      传奇之征奖励子集
-- Create: 2018-06-28
-- --------------------------------------------------------------------
ActionLingtDarkWarOrderRewardItem = class("ActionLingtDarkWarOrderRewardItem", function()
    return ccui.Widget:create()
end)

function ActionLingtDarkWarOrderRewardItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionLingtDarkWarOrderRewardItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_lingt_dark_war_order_reward_item"))
    self:addChild(self.root_wnd)
    self:setAnchorPoint(0, 0)
    self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(700,120))
	self:setTouchEnabled(true)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.Image_19 = self.main_container:getChildByName("Image_19")
    -- self.levelbg = self.main_container:getChildByName("levelbg")
    -- self.level = self.levelbg:getChildByName("level")
    self.free_layer = self.main_container:getChildByName("free_layer")
    self.goods_con = self.main_container:getChildByName("goods_con")
    self.buy_img = self.main_container:getChildByName("buy_img")
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.btn_get_txt = self.btn_get:getChildByName("Text_5")
    self.btn_get_txt:setString(TI18N("语言_c_109"))
end

function ActionLingtDarkWarOrderRewardItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        if self.num ~= 3 then
            controller:sender21702(model:getLingtDarkSignBid(),self.rewardData._index or self.index)
        else
            controller:openActionLingtDarkWarOrderAdvancedPanel(true)
        end
	end, true)
end

function ActionLingtDarkWarOrderRewardItem:setData(data,index)
    self.rewardData = data
    self.index = index
    -- self.level:setString(index or data._index) 
    local num = model:getLingtDarkRewardLock(index or data._index)
    self.num = num
    if num == 1 or num == 2 or num == 4 then
        self.btn_get_txt:setString(TI18N("语言_c_8"))
        addRedPointToNodeByStatus(self.btn_get,true,10,15)
        self.btn_get:setTouchEnabled(true)
        setChildUnEnabled(false,self.btn_get)
    elseif num == 3 then
        self.btn_get_txt:setString(TI18N("语言_c_2684"))
        setChildUnEnabled(false,self.btn_get)
        self.btn_get:setTouchEnabled(true)
        addRedPointToNodeByStatus(self.btn_get,false,10,15)
    else
        self.btn_get_txt:setString(TI18N("语言_c_8"))
        if num == 5 then
            self.btn_get_txt:setString(TI18N("语言_c_15"))
        end
        setChildUnEnabled(true,self.btn_get)
        self.btn_get:setTouchEnabled(false)
        addRedPointToNodeByStatus(self.btn_get,false,10,15)
    end
    local lock = self.num == 0
    local setting = {}
    setting.scale = 0.7
    setting.space_x = 0
    setting.max_count = 1
    setting.lock = lock
    setting.is_lock_bg = lock
    setting.is_get_status = self.num >= 3
    setting.get_status_res = PathTool.getResFrame("get_ninja","txt_cn_get_ninja_lingqu")
    self.item_list = commonShowSingleRowItemList(self.free_layer, self.item_list, data.award, setting) 


    local lock2 = self.num == 0 or self.num == 1 or self.num == 3
    local setting2 = {}
    setting2.scale = 0.7
    setting2.space_x = 0
    setting2.max_count = 3
    setting2.lock = lock2
    setting2.is_lock_bg = lock2
    setting2.is_get_status = self.num == 5
    setting2.get_status_res = PathTool.getResFrame("get_ninja","txt_cn_get_ninja_lingqu")
    self.item_list2 = commonShowSingleRowItemList(self.goods_con, self.item_list2, data.rmb_award, setting2)
    self.goods_con:setSwallowTouches(false)

end
function ActionLingtDarkWarOrderRewardItem:DeleteMe()
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list2 = nil
    if self.item_list2 then
        for i,v in ipairs(self.item_list2) do
            v:DeleteMe()
        end
    end
    self.item_list2 = nil
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      传奇之征任务子集
-- Create: 2018-06-28
-- --------------------------------------------------------------------
ActionLingtDarkWarWarOrderTaskItem = class("ActionLingtDarkWarWarOrderTaskItem", function()
    return ccui.Widget:create()
end)

function ActionLingtDarkWarWarOrderTaskItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionLingtDarkWarWarOrderTaskItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_lingt_dark_war_order_task_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(344,208))
	self:setTouchEnabled(false)

    self.background = self.root_wnd:getChildByName("background")
    self.container = self.root_wnd:getChildByName("container")
    self.btn_goto = self.container:getChildByName("btn_goto")
    self.btn_goto_txt = self.btn_goto:getChildByName("Text_11")
    self.btn_goto_txt:setString(TI18N("语言_c_108"))
    self.has_bg = self.container:getChildByName("has_bg")
    self.schedule = self.container:getChildByName("schedule")
    self.ScrollView_2 = self.container:getChildByName("ScrollView_2")
    self.ScrollView_2:setScrollBarEnabled(false)
    self.cesc = createRichLabel(20,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0,1),cc.p(0,0),FONT_COMMON_LINE_SPACE,nil,300)
    self.ScrollView_2:addChild(self.cesc)
end

function ActionLingtDarkWarWarOrderTaskItem:register_event()
    registerButtonEventListener(self.btn_goto, function()
        local jump_id = self.cfg.id
        local data = {}
        data[1] = jump_id
        controller:openActionMainPanel(false)
        JumpController:jumpViewByEvtData(data)
	end, true)
end

function ActionLingtDarkWarWarOrderTaskItem:setData(index,i,data)
    local cfg = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()]
    if not cfg then return end
    local period = cfg.period
    self.cfg = Config.ChuanqiTaskData.data_quest_list[period][data.id]
    if tableLen(self.cfg) == 0 then return end
    local jump_id = self.cfg.id
    if jump_id == 0 then
        self.btn_goto_txt:setString(TI18N("语言_c_1564"))   
        self.btn_goto:setTouchEnabled(false)
        setChildUnEnabled(true,self.btn_goto)
    else
        self.btn_goto_txt:setString(TI18N("语言_c_108"))   
        self.btn_goto:setTouchEnabled(true)
        setChildUnEnabled(false,self.btn_goto)
    end
    local str = ""
    local desclist ={}
    for i=1,tableLen(self.cfg.progress) do
        if self.cfg.progress[i].target ~= 0 then
            table.insert(desclist,1,self.cfg.progress[i].target_val)
        end
        if self.cfg.progress[i].param then
            for j=1,tableLen(self.cfg.progress[i].param) do
                local _str =  ActivityTaskDescription(self.cfg.progress[i].param[j])
                for key, value in pairs(_str) do
                    table.insert(desclist,1,value)
                end
            end
        end
    end
    local str = LangStringFormat(self.cfg.desc,desclist)
    self.cesc:setString(str)
    if self.cesc:getContentSize().height < 70 then
        self.ScrollView_2:setInnerContainerSize(cc.size(306,70))
        self.cesc:setPositionY(70)
    else
        self.ScrollView_2:setInnerContainerSize(cc.size(306,self.cesc:getContentSize().height))
        self.cesc:setPositionY(self.cesc:getContentSize().height)
    end

    self.reward = BackPackItem.new(false, true, false, 0.7, true, true)
    self.container:addChild(self.reward)
    self.reward:setPosition(cc.p(80,50))
    self.reward:setBaseData(self.cfg.task_icon,self.cfg.award)
    local str = ""
    for key, value in pairs(data.val_list) do
        if str == "" then
            str = str .. string.format(TI18N("语言_c_5017"),value.value,value.target_val)
        else
            str = str .."\n".. string.format(TI18N("语言_c_5017"),value.value,value.target_val)
        end
    end
    self.schedule:setString(str)
    if data.finish == 2 then
        self.schedule:setTextColor(cc.c3b(0x0e,0xa8,0x0e))
    else
        self.schedule:setTextColor(cc.c3b(0xff,0x00,0x00))
    end
    self.has_bg:setVisible(data.finish == 2)
    self.btn_goto:setVisible(data.finish == 0)
end
function ActionLingtDarkWarWarOrderTaskItem:DeleteMe()

end


------------------------------------------
-- 功勋子项
ActionLingtDarkWarWarOrderBarItem = class("ActionLingtDarkWarWarOrderBarItem", function()
    return ccui.Widget:create()
end)

function ActionLingtDarkWarWarOrderBarItem:ctor()
    self.size = cc.size(100, 120)
    self:configUI()
    self:register_event()
end

function ActionLingtDarkWarWarOrderBarItem:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.select_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_2"),
        self.size.width / 2, self.size.height / 2 + 6, cc.p(0.5, 0.5), true)
    self.select_img = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_1"),
        self.size.width / 2, self.size.height / 2 + 6, cc.p(0.5, 0.5), true)
    self.select_img:setVisible(false)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_11"),
        self.size.width / 2, self.size.height / 5 + 11, cc.p(0.5, 0.5), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(71, 37))
    self.num_txt = createLabel(20, Config.ColorData.data_color4[1], nil, self.size.width / 2 - 2,
    self.size.height / 5 + 11, "", self.root_wnd, nil, cc.p(0.5, 0.5))
end

function ActionLingtDarkWarWarOrderBarItem:register_event()
end

function ActionLingtDarkWarWarOrderBarItem:setData(data)
    if not data then
        return
    end
    self.data = data
    
    local id = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()].period
    -- local needExp = model:getWarOrderExp(id,self.data.lv)
    local last_cfg = Config.ChuanqiTaskData.data_lv_exp[id][self.data.lv - 1]
    if last_cfg then
        self.num_txt:setString(tostring(last_cfg.exp))
    else
        self.num_txt:setString(tostring(0))
    end
    local lingt_dark_data = model:getLingtDarkData()
    local selfLv = lingt_dark_data.lv
    if selfLv >= data.lv then
        self.select_img:setVisible(true)
    else
        self.select_img:setVisible(false)
    end

    -- 进度条相关
    local config = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()]
    local period = config.period
    local cfg = Config.ChuanqiTaskData.data_lv_exp[period]
    local id = self.data.lv
    local last_id = id + 1
    if cfg[last_id] then
        if self.comp_bar == nil then
            local size = cc.size(75, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(50, 30))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =
                createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 0, 0)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(75, 27))
            self.comp_bar:setContentSize(cc.size(70, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        -- 上一条数据的相关
        if lingt_dark_data.lv == data.lv then
            local value = lingt_dark_data.exp
            local cfg = Config.ChuanqiTaskData.data_base_id[model:getLingtDarkSignCampId()]
            local period = cfg.period
            local target_value = Config.ChuanqiTaskData.data_lv_exp[period][data.lv].exp or 100
            local last_cfg = Config.ChuanqiTaskData.data_lv_exp[period][data.lv - 1]
            local last_value = 0
            if last_cfg then
                last_value = last_cfg.exp
            end
            self.comp_bar:setPercent((value - last_value)/ (target_value - last_value) * 100)
        elseif lingt_dark_data.lv > data.lv then
            self.comp_bar:setPercent(100)
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
    end
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(id)
end

function ActionLingtDarkWarWarOrderBarItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end
