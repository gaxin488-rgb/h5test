-- ******** 文件说明 ********
-- 
-- @description: 幻境任务
-- *******************************
ActionFantasyMmission2 = class("ActionFantasyMmission2", function()
    return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()
local color_text = {
    [1] = cc.c4b(0x80,0xf7,0x31,0xff),
    [2] = cc.c4b(0x64,0x32,0x23,0xff),
}

function ActionFantasyMmission2:ctor(bid)
    self.holiday_bid = bid
    self.panelList = {}
    self.timeValueList = {}
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("wonderlandtask","wonderlandtask"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("welfare/welfare_banner","txt_cn_welfare_banner136"), type = ResourcesType.single},
	}
    self.resources_load = ResourcesLoad.New(true)
	self.resources_load:addAllList(self.res_list, function()
        if self.loadResListCompleted then
            self:loadResListCompleted()
            controller:sender21600(bid)
        end
	end)
end
function ActionFantasyMmission2:loadResListCompleted(  )
    self:configUI()
	self:register_event()
end

function ActionFantasyMmission2:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_fantasy_mmission_2"))
    self.root_wnd:setPosition(-40, -82)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_con = self.main_container:getChildByName("title_con")
    self.title_img = self.title_con:getChildByName("title_img")
    self.time_panel = self.title_con:getChildByName("time_panel")
    self.time_label = self.title_con:getChildByName("label_time_key")
    self.time_label:setString(TI18N("语言_c_1113"))
    self.time_text = self.title_con:getChildByName("label_time")
    self.time_text:setTextColor(color_text[1])
    self.btn_rule = self.title_con:getChildByName("btn_rule") --规则说明按钮，，就是问号的图片
    self.btn_rule:setVisible(false)
    self.image_6 = self.main_container:getChildByName("image_6")
    if self.image_6 then
        self.image_6:setVisible(false)
    end
    self.good_cons = self.main_container:getChildByName("charge_con")
    self.jump_btn = self.main_container:getChildByName("jump_btn")
    self.jump_btn:ignoreContentAdaptWithSize(true)
    self.jump_btn:setVisible(false)
    self.jump_txt = self.jump_btn:getChildByName("label")
    self.jump_txt:setChangeScaleOffWidth(-9999)
    setTextMaxWidth(self.jump_txt,120,-8)
    self.jump_txt:setString(TI18N("语言_c_7356"))
    
    self.tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    self.constant_cfg = Config.WonderlandTaskData.data_constant[self.tab_vo.camp_id]
    if self.constant_cfg and self.constant_cfg.jump and self.constant_cfg.jump ~= 0 then
        self.jump_btn:setVisible(true)
        if self.constant_cfg.btn_txt and self.constant_cfg.btn_txt ~= "" then
            self.jump_txt:setString(self.constant_cfg.btn_txt)
        end
        local res = PathTool.getResFrame("wonderlandtask", self.constant_cfg.btn_res)
        self.jump_btn:loadTexture(res, LOADTEXT_TYPE_PLIST)
    end
    self:loadBannerImage()

end
function ActionFantasyMmission2:loadBannerImage()
    local str_banner = "txt_cn_welfare_banner136"
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    if tab_vo and tab_vo.reward_title ~= "" and tab_vo.reward_title then
        str_banner = tab_vo.reward_title
    end
    local res = PathTool.getPlistImgForDownLoad("welfare/welfare_banner",str_banner)
    loadSpriteTexture(self.title_img,res, LOADTEXT_TYPE)
    self:setData()
end
function ActionFantasyMmission2:register_event()
    if not self.update_action_even_event  then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.FantasyMissionData,function (data)
            if data.bid == self.holiday_bid then
                self:setData(data)
            end
        end)
    end
    registerButtonEventListener(self.jump_btn, function()
        local jump_id = self.constant_cfg.jump
        local config = Config.SourceData.data_source_data[jump_id]
        if config then
            BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
        end
	end, true)
end

function ActionFantasyMmission2:setData(data)
    if data then
        self.data = data 
    else
        self.data = model:getFantasyMissionData(self.holiday_bid)
    end
    if not self.data then return end
    local period = self.constant_cfg.period
    local cfg = Config.WonderlandTaskData.data_quest_list[period]
    self.item_list = {}
    for key, value in pairs(self.data.list) do
        for k, v in pairs(value) do
            local need_id = cfg[v.id].need_id
            if need_id and need_id ~= 0 then
                local need_list = model:getFantasyMissionForId(self.holiday_bid,need_id)
                if need_list and need_list.finish == 2 then
                    table.insert(self.item_list,v)
                end
            else
                table.insert(self.item_list,v)
            end
        end
    end
    local sort_func = SortTools.tableCommonSorter({{"finish_sort", false}, {"type", false}, {"id", false}})
    table.sort(self.item_list,sort_func)
    local time = self.data.end_time - GameNet:getInstance():getTime()
	commonCountDownTime(self.time_text, time)
    self.time_text:setAnchorPoint(cc.p(1, 0.5))
    self.time_label:setAnchorPoint(cc.p(1, 0.5))
    self.time_text:setPositionX(700)
    self.time_label:setPositionX(self.time_text:getPositionX() - self.time_text:getContentSize().width)
    self.time_panel:setContentSize(cc.size(self.time_text:getContentSize().width + self.time_label:getContentSize().width + 50,26))
    if self.item_scrollview == nil then
        local scroll_view_size = self.good_cons:getContentSize()
        local setting = {
            start_x = 0, -- 第一个单元的X起点
            space_x = 10, -- x方向的间隔
            start_y = 0, -- 第一个单元的Y起点
            space_y = 0, -- y方向的间隔
            item_width = 713, -- 单元的尺寸width
            item_height = 160, -- 单元的尺寸height
            col = 1, -- 行数，作用于水平滚动类型
            once_num = 1 -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(self.good_cons, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    self.item_scrollview:reloadData()
end

function ActionFantasyMmission2:createNewCell(width, height)
    local cell = ActionFantasyMmission2Item.new()
    return cell
end
 --获取数据数量
function ActionFantasyMmission2:numberOfCells()
    if not self.item_list then return 0 end
    return #self.item_list
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--index :数据的索引
function ActionFantasyMmission2:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.item_list[index]
    if not cell_data then return end
    cell:setData(cell_data,self.holiday_bid)
end

function ActionFantasyMmission2:DeleteMe()
    model:deFantasyMissionData(self.holiday_bid)
    doStopAllActions(self.time_text)
    doStopAllActions(self.timeValueList[1])
    doStopAllActions(self.timeValueList[2])

    if self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    for k, v in pairs(self.panelList) do
        if v then
            v:removeAllChildren()
            v:removeFromParent()
        end
    end
    if self then
        self:removeAllChildren()
        self:removeFromParent()
    end
end

--幻境任务
ActionFantasyMmission2Item = class("ActionFantasyMmission2Item", function()
    return ccui.Widget:create()
end)

function ActionFantasyMmission2Item:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function ActionFantasyMmission2Item:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_fantasy_mmission_item_2"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(713,160))
	self:setTouchEnabled(false)

    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("container")
    self.title_txt = self.main_container:getChildByName("title_txt")
    self.btn_goto = self.main_container:getChildByName("btn_goto")
    self.Text_11 = self.btn_goto:getChildByName("Text_11")
    self.Text_11:setString(TI18N("语言_c_7"))
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.Text_10 = self.btn_get:getChildByName("Text_10")
    self.Text_10:setString(TI18N("语言_c_8"))
    self.has_bg = self.main_container:getChildByName("has_bg")
    self.txt_scroll = self.main_container:getChildByName("txt_scroll")
    self.txt_scroll:setScrollBarEnabled(false)
    self.item_scroll = self.main_container:getChildByName("item_scroll")
    self.item_scroll:setScrollBarEnabled(false)
    self.bar_bg = self.main_container:getChildByName("bar_bg")
    self.bar = self.main_container:getChildByName("bar")
    self.bar:setScale9Enabled(true)
    self.schedule = self.main_container:getChildByName("schedule")
    self.cesc = createRichLabel(20,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0,1),cc.p(0,0),FONT_COMMON_LINE_SPACE,nil,300)
    self.txt_scroll:addChild(self.cesc)
end

function ActionFantasyMmission2Item:setData(data,bid)
    self.data = data
    self.holiday_bid = bid
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    if not tab_vo then return end
    local camp_id = tab_vo.camp_id
    if not camp_id then return end
    local period = Config.WonderlandTaskData.data_constant[camp_id] and Config.WonderlandTaskData.data_constant[camp_id].period
    if not period then return end
    if self.data.type == 1 then
        self.title_txt:setString(TI18N("语言_c_731"))
    else
        self.title_txt:setString(TI18N("语言_c_5016"))
    end
    self.cfg = Config.WonderlandTaskData.data_quest_list[period][self.data.id]
    self.title_txt:setString(self.cfg.title)
    self.schedule:setString(string.format("%s/%s",self.data.value,self.data.target_val))
    self.bar:setPercent(self.data.value/self.data.target_val*100)
    self.btn_goto:setVisible(self.data.finish == 0)
    self.btn_get:setVisible(self.data.finish == 1)
    addRedPointToNodeByStatus(self.btn_get, self.data.finish == 1, 15, 10)
    self.has_bg:setVisible(self.data.finish == 2)
    self.schedule:setVisible(self.data.finish ~= 2)
    self.bar:setVisible(self.data.finish ~= 2)
    self.bar_bg:setVisible(self.data.finish ~= 2)
    local desclist =  ActivityTaskDescription(self.cfg.progress[1].param[1])
    table.insert(desclist,1,self.cfg.progress[1].target_val)
    local str = LangStringFormat(self.cfg.desc,desclist)
    self.cesc:setString(str)
    local _h = math.max(self.cesc:getContentSize().height , self.txt_scroll:getContentSize().height)
    self.txt_scroll:setInnerContainerSize(cc.size(self.txt_scroll:getContentSize().width,_h))
    self.cesc:setPositionY(_h)
    if self.cesc:getContentSize().height > self.txt_scroll:getContentSize().height then
        self.txt_scroll:setTouchEnabled(true)
    else
        self.txt_scroll:setTouchEnabled(false)
    end
    local setting = {}
    setting.scale = 0.7
    setting.space_x = 2
    setting.max_count = 1
    setting.is_center = true
    self.item_list = commonShowSingleRowItemList(self.item_scroll, self.item_list, self.cfg.award, setting)
end
function ActionFantasyMmission2Item:register_event( )
    registerButtonEventListener(self.btn_goto, function()
        if self and self.cfg and self.cfg.id then
            local jump_id = self.cfg.id
            local data = {}
            data[1] = jump_id
            local bid = 0
            for key, value in pairs(self.cfg.progress) do
                for k, v in pairs(value.param) do
                    if v[1] == "hbid" then
                        for _k, _v in pairs(v[2]) do
                            if controller:getActionSubTabVo(_v) and not model:checkActionJump(_v) then
                                bid = _v
                                break
                            end
                        end
                    end
                end
            end
            if bid ~= 0 then
                data[2] = bid
            end
            controller:openActionMainPanel(false)
            JumpController:getInstance():jumpViewByEvtData(data)
        end
	end, true)
    registerButtonEventListener(self.btn_get, function()
        controller:sender21601(self.holiday_bid,self.data.id)
	end, true)
end

function ActionFantasyMmission2Item:DeleteMe()
    if self then
        self:removeAllChildren()
        self:removeFromParent()
    end
end