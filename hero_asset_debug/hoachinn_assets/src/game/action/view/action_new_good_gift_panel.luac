ActionNewGoodGiftPanel = class("ActionNewGoodGiftPanel", function()
	return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = controller:getModel()

function ActionNewGoodGiftPanel:ctor(bid,id,remain_sec)
    self.remain_sec = remain_sec
    self.holiday_bid = bid
    self.click_btn_list = -1
	self:configUI()
    self:register_event()
    ActionController:getInstance():cs16603(self.holiday_bid)
end

function ActionNewGoodGiftPanel:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_good_gift_panel"))
	self.root_wnd:setPosition(-40,-70)
	self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setAnchorPoint(0, 0)
	
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    local str = "txt_cn_optional_ballon_bg_1"
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    if tab_vo and tab_vo.reward_title ~= "" and tab_vo.reward_title then
        str = tab_vo.reward_title
    end
    local bg_res = PathTool.getPlistImgForDownLoad("bigbg/action", str)
    if self.image_bg then
        self.background_load = loadSpriteTextureFromCDN(self.image_bg, bg_res, ResourcesType.single, self.background_load)
    end
    self.surplus_txt = self.main_container:getChildByName("surplus_txt")
    local str = TI18N("语言_c_1242")
    self.surplus_txt:setString(str)
    self.tips = self.main_container:getChildByName("tips")
    self.tips:setPosition(cc.p(360,100))
    self.tips:setString(TI18N("语言_c_4954"))
    self.surplus_time = self.main_container:getChildByName("surplus_time")
    self.surplus_time:setPositionX(self.surplus_txt:getPositionX()+self.surplus_txt:getContentSize().width+5)
    controller:getModel():setCountDownTime(self.surplus_time,self.remain_sec or 0)
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.btn_get:setPosition(cc.p(360,147))
    self.btn_get_txt = self.btn_get:getChildByName("Text_10")
    self.btn_get_txt:setString(TI18N("语言_c_8"))
    addRedPointToNodeByStatus(self.btn_get,true,-5,10)
    self.btn_get:setVisible(false)
    self.btn_goto = self.main_container:getChildByName("btn_goto")
    self.btn_goto:setPosition(cc.p(360,147))
    self.btn_goto_txt = self.btn_goto:getChildByName("Text_11")
    self.btn_goto_txt:setString(TI18N("语言_c_7"))
    self.btn_reward = self.main_container:getChildByName("btn_reward")
    self.btn_reward:setPosition(cc.p(360,147))
    self.btn_reward_txt = self.btn_reward:getChildByName("Text_10")
    self.btn_reward_txt:setString(TI18N("语言_c_15"))
    self.btn_reward:setVisible(false)
    setChildUnEnabled(true, self.btn_reward)
    self.btn_reward:setTouchEnabled(false)
    self.show_img = self.main_container:getChildByName("show_img")
    self.show_img:setPosition(cc.p(360,321))
    self.show_img_txt = self.show_img:getChildByName("show_img_txt")
    self.reward_btn = self.main_container:getChildByName("reward_btn")
    self.reward_btn:setVisible(true)
    self.reward_btn:setPosition(cc.p(550,147))
    self.reward_txt = self.reward_btn:getChildByName("label")
    self.reward_txt:setString(TI18N("语言_c_21"))
    self.hero_node = self.main_container:getChildByName("hero_node")
    self.hero_node:setPosition(cc.p(360,329))
    self.tip = self.main_container:getChildByName("tip")
    if tab_vo and tab_vo.aim_title ~= "" and tab_vo.aim_title then
        str = tab_vo.aim_title
    end
    local bg_res = PathTool.getPlistImgForDownLoad("bigbg/action", str)
    if self.image_bg then
        self.background_load2 = loadSpriteTextureFromCDN(self.tip, bg_res, ResourcesType.single, self.background_load2)
    end
    self.look_more = self.main_container:getChildByName("look_more")
    self.look_more:setPosition(cc.p(360,229))
    self.loock_more_txt = self.look_more:getChildByName("loock_more_txt")
    self.loock_more_txt:setChangeScaleOffWidth(-9999)
    self.loock_more_txt:setString(TI18N("语言_c_6422"))
    local _w = math.max(self.look_more:getContentSize().width,self.loock_more_txt:getContentSize().width + 100)
    self.look_more:setContentSize(cc.size(_w,self.look_more:getContentSize().height))
    self.loock_more_txt:setPosition(cc.p(_w*0.5,self.look_more:getContentSize().height*0.5))
    self.txt_num = self.main_container:getChildByName("txt_num")
    self.txt_num:setPosition(cc.p(237,726))
    self:setInitData()
end

function ActionNewGoodGiftPanel:setInitData()
    if not self.data then return end
    local aim_list = self.data.aim_list[1]
    self.treasure_id = 0
    for key, value in pairs(aim_list.aim_args) do
        if value.aim_args_key == 27 then
            local needMoney = value.aim_args_val
            self.txt_num:setString(string.format(TI18N("语言_c_4440"),needMoney))
            self.txt_num:setPositionX(270)
        elseif value.aim_args_key == 36 then
            self.treasure_id = value.aim_args_val
        end
    end
    
    local star_cfg = Config.NinjaTreasureData.data_star_info[self.treasure_id]
    local cfg = star_cfg[1]
    self.hero_node:loadTexture(string.format("resource/ninja_treasure/treasure_item/%s.png",cfg.icon), LOADTEXT_TYPE)
    self.hero_node:ignoreContentAdaptWithSize(true)
    self.hero_node:setScale(1.5)
    local base_cfg = Config.NinjaTreasureData.data_base_info[self.treasure_id]
    self.show_img_txt:setString(base_cfg.name)
    if self.star_node == nil then
		self.star_node = cc.Node:create()
		self.star_node:setPosition(120, -10)
		self.show_img:addChild(self.star_node)
	end
    self.star_setting = self:createStar(tableLen(star_cfg),tableLen(star_cfg),self.star_node,self.star_setting)
    self.btn_goto:setVisible(aim_list.status == 0)
    self.btn_get:setVisible(aim_list.status == 1)
    self.btn_reward:setVisible(aim_list.status == 2)
    
end

function ActionNewGoodGiftPanel:createStar(num ,max_num, star_con, star_setting)
	local num = num or 0
    local star_setting = star_setting or {}
	if star_setting.star_list == nil then
        star_setting.star_list = {}
    end
	for i,v in pairs(star_setting.star_list) do
        v:setVisible(false)
    end
	local _cStar = function(star_count, max_count, star_list,moveW)
        local width = 20
        local x = - max_count * width * 0.5 + width * 0.5
        if moveW then 
            x = x + moveW
        end
        for i=1,max_count do
            if not star_list[i] then 
				local res = PathTool.getResFrame("common","common_90074")
                local star = createImage(star_con,res,0,0,cc.p(0.5,0.5),true,max_count-i,false)
                star:setScale(1)
                star_list[i] = star
            end
			if i > star_count then
				star_list[i]:loadTexture(PathTool.getResFrame("common","common_90093"), LOADTEXT_TYPE_PLIST)	
			else
				star_list[i]:loadTexture(PathTool.getResFrame("common","common_90074"), LOADTEXT_TYPE_PLIST)
			end
            star_list[i]:setVisible(true)
            star_list[i]:setPositionX(x + (i-1) * width)
        end
    end
	_cStar(num,max_num, star_setting.star_list)
	return star_setting
end
function ActionNewGoodGiftPanel:register_event()
	registerButtonEventListener(self.btn_goto, function()
        VipController:getInstance():openVipMainWindow(true, VIPTABCONST.CHARGE)
	end, true)
    registerButtonEventListener(self.reward_btn, function()
        local _x,_y = self.reward_btn:getPosition()
        local world_pos = self:convertToWorldSpace(cc.p(_x,_y))
        local list = {}
        if self.data then
            for key, value in pairs(self.data.aim_list[1].item_list) do
                local data = {}
                data[1] = value.bid
                data[2] = value.num
                table.insert(list,data)
            end
            self:showRewardItems(list)
        end
        -- EsecsiceController:getInstance():openEserciseShowRewardWindow(true,list,world_pos,1.5)
	end, true)
    registerButtonEventListener(self.btn_get, function()
        controller:cs16604(self.holiday_bid,self.data.aim_list[1].aim * 100,0)
	end, true)
    registerButtonEventListener(self.look_more, function()
        local data = TreasureVo.New()
        local cfg = Config.NinjaTreasureData.data_star_info[self.treasure_id]
        data:updataData(self.treasure_id,tableLen(cfg))
        data.isother = true
        local list = {}
        list.is_book = false
        list.is_btn = false
        TreasureController:getInstance():openTreasureTips(true, data, list)
	end, true)

    if not self.updateEvent then
        self.updateEvent = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE ,function(data)
            if data.bid ~= self.holiday_bid then return end
            self.data = data
            self:setInitData()
        end)
    end
end
--抄过来的
function ActionNewGoodGiftPanel:showRewardItems(data)
    local size = self.main_container:getContentSize()
    if not self.tips_layer then
        self.tips_layer = ccui.Layout:create()
        self.tips_layer:setContentSize(size)
        self.main_container:addChild(self.tips_layer)
        self.tips_layer:setTouchEnabled(true)
        registerButtonEventListener(self.tips_layer, function()
            self.tips_bg:removeFromParent()
            self.tips_bg = nil
            self.tips_layer:removeFromParent()
            self.tips_layer = nil
        end,false, 1)
    end
    
    local list = {}
    if not self.tips_bg then
        self.tips_bg = createImage(self.tips_layer, PathTool.getResFrame("common","common_1056"), size.width*0.5, 100, cc.p(0,0), true, 10, true)
        self.tips_bg:setTouchEnabled(true)
    end
    if self.tips_bg then
        local pos = self.reward_btn:getPosition()
        self.tips_bg:setContentSize(cc.size(BackPackItem.Width*#data+50,BackPackItem.Height+50))
        local ccp = cc.p(0.5,0)
        -- local tips_bg_width = self.tips_bg:getContentSize().width
        -- if tips_bg_width * 0.5 + pos.x >= 720 then
        --     ccp = cc.p(0.86,0)
        -- elseif pos.x - tips_bg_width * 0.5 < 0 then
        --     ccp = cc.p(0.3,0)
        -- end

        self.tips_bg:setAnchorPoint(ccp)
        self.tips_bg:setPosition(self.reward_btn:getPositionX(), self.reward_btn:getPositionY())
    end
    local size = self.tips_bg:getContentSize()
    local x =  25 + BackPackItem.Width * 0.5
    for i,v in pairs(data) do
        if not list[i] then
            list[i] = BackPackItem.new(nil,true,nil,0.8)
            list[i]:setAnchorPoint(cc.p(0.5,0.5))
            self.tips_bg:addChild(list[i])
            list[i]:setBaseData(v[1])
            list[i]:setPosition(cc.p(x + (i-1) * BackPackItem.Width, 100))
            list[i]:setDefaultTip()
            
            self.text_num = createLabel(22,cc.c4b(0xff,0xee,0xdd,0xff),nil,60,-25,"",list[i],nil, cc.p(0.5,0.5))
            self.text_num:setString("x"..v[2])
        else
            list[i]:setBaseData(v[1])
            list[i]:setPosition(cc.p(x + (i-1) * BackPackItem.Width, 100))
            self.text_num:setString("x"..v[2])
        end
    end
end
function ActionNewGoodGiftPanel:DeleteMe()
    doStopAllActions(self.remain_time)
    if self.updateEvent then
        GlobalEvent:getInstance():UnBind(self.updateEvent)
        self.updateEvent = nil
    end
end