 
ActionMainuiPushHeroPop = ActionMainuiPushHeroPop or BaseClass(BaseView)
-- desc: 
function ActionMainuiPushHeroPop:__init()
	self.is_full_screen = false
	self.layout_name = "action/action_mainui_push_hero_pop"
	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("hero","hero"), type = ResourcesType.plist },
		{path = PathTool.getPlistImgForDownLoad("partnersummon","partnersummon"), type = ResourcesType.plist },
	}
	self.view_tag = ViewMgrTag.TOP_TAG
	self.win_type = WinType.Big
end
-- desc: 
function ActionMainuiPushHeroPop:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale( display.getMaxScale())

	self._root = self.root_wnd:getChildByName("main_container")
	self.Panel_27 = self._root:getChildByName("Panel_27")
	self._bg = self._root:getChildByName("_bg")
	self._hero_img = self._root:getChildByName("_hero_img")
	self.Panel_4 = self._root:getChildByName("Panel_4")
	self._heroNode = self.Panel_4:getChildByName("_heroNode")
	self._titleSprite = self._root:getChildByName("_titleSprite")
	self._heroOrderBg = self._root:getChildByName("_heroOrderBg")
	self._orderTitle = self._heroOrderBg:getChildByName("_orderTitle")
	setTextMaxWidth(self._orderTitle,200,-10)
	self._orderScroll = self._heroOrderBg:getChildByName("_orderScroll")
	self._orderScroll:setScrollBarEnabled(false)
	self._skillBg = self._root:getChildByName("_skillBg")
	self._desc_bg = self._skillBg:getChildByName("_desc_bg")
	self._campIcon = self._skillBg:getChildByName("_campIcon")
	self._heroName = self._skillBg:getChildByName("_heroName")
	self._title = self._skillBg:getChildByName("_title")
	self._skillPanel = self._skillBg:getChildByName("_skillPanel")
	self._heroRoleBg = self._root:getChildByName("_heroRoleBg")
	self._professionBg = self._root:getChildByName("_professionBg")
	self._professionName = self._professionBg:getChildByName("_professionName")
	self._professionIcon = self._professionBg:getChildByName("_professionIcon")
	self._noTipsCheck = self._root:getChildByName("_noTipsCheck")
	self._extendTouch = self._noTipsCheck:getChildByName("_extendTouch")
	self._closeBtn = self._root:getChildByName("_closeBtn")
	self._noTipLabel = self._root:getChildByName("_noTipLabel")
	self._richParent = self._root:getChildByName("_richParent")
	self._videoBtn = self._root:getChildByName("_videoBtn")
	self._videoBtnLabel = self._videoBtn:getChildByName("_videoBtnLabel")
	self._goBtn = self._root:getChildByName("_goBtn")
	self._goBtnLabel = self._goBtn:getChildByName("_goBtnLabel")
	self._hero_limit_node = self._root:getChildByName("_hero_limit_node")

	self._descText = createRichLabel(20, cc.c3b(0xff,0xff,0xff), cc.p(0.5, 0.5), cc.p(220, 34),nil, nil, 500)
	self._desc_bg:addChild(self._descText)

	self._richText = createRichLabel(20, cc.c3b(0x25,0xff,0x25), cc.p(0.5, 0.5), cc.p(0, 0),nil, nil, 600)
	self._richParent:addChild(self._richText)

	self._heroName:setString(TI18N(""))
	self._title:setString(TI18N(""))
	self._professionName:setString(TI18N(""))
	self._goBtnLabel:setString(TI18N("语言_c_5179"))
	self._videoBtnLabel:setString(TI18N("语言_c_823"))
	setTextMaxWidth(self._videoBtnLabel,140,-10)

	self._noTipLabel:setString(TI18N("语言_c_2021"))
	local _width = self._noTipLabel:getContentSize().width
	local _total_width = _width + 40
	local posx = 360 - _total_width/2 + 15
	self._noTipsCheck:setPositionX(posx)
	self._noTipLabel:setPositionX(posx+25)
	self._orderTitle:setString(TI18N("语言_c_7351"))

	self._skills = {}
end

function ActionMainuiPushHeroPop:openRootWnd(data, noAni)
	self._data = data -- MainuiModel: getPopActionList 定义
	self:updateData()
	-- if not noAni then
	-- 	self:playEnterAnimatianByObj(self._ui._root, 2)
	-- end
end

function ActionMainuiPushHeroPop:updateData()
	if not self._data then
		return
	end
	local ui = self
	local cfg = self._data.cfg

	if cfg.bg_img and cfg.bg_img ~= "" then
		ui._bg:setVisible(true)
		-- ui._bg:loadSpriteTexture(PathTool.getActivityPush(cfg.bg_img), ResourcesType.single)
		loadSpriteTexture(ui._bg,PathTool.getActivityPush(cfg.bg_img),LOADTEXT_TYPE)
	else
		ui._bg:setVisible(false)
	end

	if cfg.title_img and cfg.title_img ~= "" then
		-- ui._titleSprite:loadSpriteTexture(PathTool.getActivityPush(cfg.title_img), ResourcesType.single)
		loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush(cfg.title_img), LOADTEXT_TYPE)
	else
		-- ui._titleSprite:loadSpriteTexture(PathTool.getActivityPush("txt_cn_activitypush_1"), ResourcesType.single)
		loadSpriteTexture(ui._titleSprite,PathTool.getActivityPush("txt_cn_activitypush_1"),LOADTEXT_TYPE)
	end
	if self._data.cfg.push_type == 7 then
		ui._videoBtn:setVisible(false)
		ui._professionBg:setVisible(false)
		ui._heroRoleBg:setVisible(false)
		ui._skillBg:setVisible(false)
		ui._heroOrderBg:setVisible(true)
		local page_index = 1
		local config = Config.SourceData.data_source_data[self._data.cfg.jump_id]
		if config then
			page_index = config.extend[1]
		end
		local list = {}
		local cfg = Config.HolidayNewWarOrderData.data_lev_reward_list[self._data.cfg.activity_id]
		if page_index ~= 0 then
			local str = ""
			if page_index == 1 then
				str = "rmb_reward"
			elseif page_index == 2 then
				str = "rmb_reward_2"
			elseif page_index == 3 then
				str = "rmb_reward_3"
			elseif page_index == 4 then
				str = "rmb_reward_4"
			end
			for key, value in pairs(cfg) do
				for k, v in pairs(value[""..str]) do
					table.insert(list,v)
				end
			end
		end
		local data_list = NeworderactionController:getInstance():getModel():getrewardList(list)
		local setting = {}
        setting.scale = 0.7
        setting.max_count = 4
        setting.is_center = true
        ui.item_list2 = commonShowSingleRowItemList(ui._orderScroll, ui.item_list2, data_list, setting)
		self._goBtnLabel:setString(TI18N("语言_c_1680"))
		ui._titleSprite:setAnchorPoint(cc.p(0.5,0.5))
		ui._titleSprite:setPositionX(360)
		NeworderactionController:getInstance():getModel():updateNeworderactionPop(self._data.cfg.activity_id)
		ui._noTipsCheck:setVisible(false)
		ui._noTipLabel:setVisible(false)
	else
		ui._videoBtn:setVisible(true)
		ui._professionBg:setVisible(true)
		ui._heroRoleBg:setVisible(true)
		ui._skillBg:setVisible(true)
		ui._heroOrderBg:setVisible(false)
		self._goBtnLabel:setString(TI18N("语言_c_5179"))
		ui._titleSprite:setAnchorPoint(cc.p(0,0.5))
		ui._titleSprite:setPositionX(0)
		ui._noTipsCheck:setVisible(true)
		ui._noTipLabel:setVisible(true)
	end
	if cfg.params and cfg.params[1] then
		local heroId = cfg.params[1]
		updateLimitEffect(1, heroId, self._hero_limit_node)
		local heroCfg = Config.PartnerData.data_partner_base[heroId]
		local hero_vo
		local pokedex_config = Config.PartnerData.data_partner_pokedex[heroId]
		if pokedex_config and pokedex_config[1] then
			local star = pokedex_config[1].star or 1
			local key = getNorKey(heroId,star)
			local model = HeroController:getInstance():getModel()
			hero_vo = model:getHeroPokedexByBid(key)
		end
		local res = PathTool.getResFrame("partnersummon","partner_rarity_10")
		self._descText:setString(string.format(TI18N("语言_c_7249"), res))
		local desc_width = self._descText:getContentSize().width
		local desc_height = self._descText:getContentSize().height
		if desc_width > 350 then
			self._desc_bg:setContentSize(cc.size(desc_width+70, desc_height+30))
			self._descText:setPositionY((desc_height+30)/2)
			self._descText:setPositionX((desc_width+70)/2+3)
		end

		if hero_vo and heroCfg then
			--显示人物的图片
			local drawId = "ninjacontract_"..heroId
			local bg_res = PathTool.getPlistImgForDownLoad("ninjacontract",drawId, false)
			if self._hero_img then
				self.heroimg_load = loadSpriteTextureFromCDN(self._hero_img, bg_res, ResourcesType.single, self.heroimg_load)
			end
			if cfg.res_offset and next(cfg.res_offset) then
				self._hero_img:setScale(cfg.res_offset[1][1])
				self._hero_img:setPosition(cc.p(self._hero_img:getPositionX() + cfg.res_offset[1][2],self._hero_img:getPositionY() + cfg.res_offset[1][3]))
			end
			-- -- if ui._heroDrawSpine then
			-- -- 	ui._heroDrawSpine:removeFromParent()
			-- -- end
			-- if not ui._heroDrawSpine then
			-- 	ui._heroDrawSpine = BaseRole.new(BaseRole.type.partner, hero_vo, nil, {scale = 1, skin_id = hero_vo.use_skin, bl_live2d = true})
			-- 	ui._heroDrawSpine:setAnimation(0,PlayerAction.show,true) 
			-- 	ui._heroDrawSpine:setCascade(true)
			-- 	ui._heroDrawSpine:setAnchorPoint(cc.p(0.5,0.5)) 
			-- 	-- ui._heroDrawSpine:setScale(1)
			-- 	ui._heroNode:addChild(ui._heroDrawSpine) 


			-- 	local offset = cc.p(0, 0)
			-- 	if cfg.res_offset and cfg.res_offset[1] then
			-- 		local info = cfg.res_offset[1]
			-- 		if info[1] and info[1] ~= 0 then				
			-- 			ui._heroDrawSpine:setScale(info[1])
			-- 		end
			-- 		offset.x = info[2] or 0
			-- 		offset.y = info[3] or 0
			-- 	end
			-- 	ui._heroDrawSpine:setPosition(offset)
			-- end

			if not ui._heroSpine then
				ui._heroSpine = BaseRole.new(BaseRole.type.partner, hero_vo, nil, {scale = 0.45})
				ui._heroSpine:setAnimation(0,PlayerAction.show,true) 
				ui._heroSpine:setCascade(true)
				ui._heroSpine:setAnchorPoint(cc.p(0.5,0.5))
				ui._heroRoleBg:addChild(ui._heroSpine)
				ui._heroSpine:setPosition(cc.p(ui._heroRoleBg:getContentSize().width/2 + 5,148))
			end
			if cfg.res_offset and next(cfg.res_offset) then
				ui._heroSpine:setScale(cfg.res_offset[1][1])
				ui._heroSpine:setPosition(cc.p(ui._heroSpine:getPositionX() + cfg.res_offset[1][2],ui._heroSpine:getPositionY() + cfg.res_offset[1][3]))
			end
			--名称
			ui._heroName:setString(hero_vo.name)
			local res = PathTool.getHeroCampTypeIcon(hero_vo.camp_type)
			loadSpriteTexture(ui._campIcon, res, LOADTEXT_TYPE_PLIST)
			ui._title:setString(heroCfg.title)
			-- autoPos(ui._skillBg, 5, nil, nil, nil,nil, nil, {ui._campIcon, ui._heroName})
			-- 技能
			local key = getNorKey(hero_vo.bid, hero_vo.star)
			local star_config = Config.PartnerData.data_partner_star(key)
			if star_config then
				local skill_list = {}
				for i,v in ipairs(star_config.skills) do
					-- 不是普通攻击 1表示普通攻击
					if v[1] ~= 1 then
						table.insert(skill_list, v)
					end
				end
				local cfg = Config.PartnerUltraData.data_ene_skill[hero_vo.bid]
				if cfg then
					table.sort(cfg,function(a,b) return a.lev > b.lev end)
					local list = {
						[1]=7,
						[2]=deepCopy(cfg[1].skill[1]),
					}
					table.insert(skill_list, list)
				end
				for k, v in pairs(skill_list) do
					v.sort = v[1]
					for key, value in pairs(hero_vo.skills) do
						if v[1] == value.pos then
							v[2] = value.skill_bid
						end
					end
				end

				if heroCfg then
					if heroCfg.score == 9 then
						for k, v in pairs(skill_list) do
							if v[1] == 2 then
								v.sort = 9999
							end
						end
					elseif heroCfg.score == 10 then
						for k, v in pairs(skill_list) do
							if v[1] == 2 then
								v.sort = 7
							elseif v[1] == 7 then
								v.sort = v[1]+1
							end
						end
						-- skill_num = tableLen(self.hero_vo.skills)
					end
				end
				table.sort(skill_list,function(a,b)
					return a.sort < b.sort
				end)

				local _width = (119*0.85) * #skill_list + 10 * (#skill_list-1)
				self._skillPanel:setContentSize(cc.size(_width, 110))
				
				local ult_tips = heroCfg.ult_tips
				for i,skill in ipairs(skill_list) do
					local config = Config.SkillData.data_get_skill(skill[2])
					if config then

						if ui._skills[i] == nil then
							ui._skills[i] = {}
							ui._skills[i] = SkillItem.new(true,true,true,0.85,true)

							ui._skillPanel:addChild(ui._skills[i])
						end


						-- local score = HeroController:getInstance():getModel():heroBidScore(hero_vo.bid)
						-- if i == tableLen(skill_list) and score == 10 then
						-- 	ui._skills[i].is_show_tips = false
						-- 	local fun = function()
						-- 		local setting = {}
						-- 		setting.hero_vo = hero_vo
						-- 		setting.is_lock = false
						-- 		setting.skill_id = config.bid
						-- 		setting.look_type = 1
						-- 		HeroController:getInstance():openHeroUrSkillTipPanel(true,setting)
						-- 	end
						-- 	ui._skills[i]:addCallBack(fun)
						-- else
						-- 	ui._skills[i].is_show_tips = true
						-- end
						ui._skills[i]:setData(config,{is_sp=true})
						ui._skills[i]:setPositionY(ui._skillPanel:getContentSize().height/2)
						ui._skills[i]:setPositionX((i-1)*(119*0.85+10) + 119*0.85*0.5)
						ui._skills[i]:setVisible(true)

						if ui._skills[i] and ui._skills[i].setSpSkillSubscript then
							if heroCfg and heroCfg.score >= 9 then
								if i == 5 then
									ui._skills[i]:setSpSkillSubscript(true,Config.PartnerData.data_partner_base[hero_vo.bid].hurt_type)
								elseif i == 6 then
									ui._skills[i]:setSpSkillSubscript(true,Config.PartnerData.data_partner_base[hero_vo.bid].hurt_type+2)
								else
									ui._skills[i]:setSpSkillSubscript(false)
								end
							else
								ui._skills[i]:setSpSkillSubscript(false)
							end
						end
					end
				end


			end

			-- 职业
			local hero_type = hero_vo.type or 4
			local professionName =  HeroConst.CareerName[hero_type] or TI18N("语言_c_2103")
			if hero_vo.introduce_str and hero_vo.introduce_str ~= "" then
				professionName = professionName .."/"..hero_vo.introduce_str
			end
			ui._professionName:setString(professionName)
			local w = ui._professionName:getContentSize().width
			local totalW = w + 35 + 10
			if totalW >= 205 then
				ui._professionName:setString(transformTextToShort(professionName,8))
				addEvt2showAllTextTips(ui._professionName,professionName,8)
			end
			w = ui._professionName:getContentSize().width
			totalW = w + 35 + 10
			local s = ui._professionBg:getContentSize()
			ui._professionBg:setContentSize(cc.size(totalW, s.height))
			ui._professionBg:setPositionX(109)
			local res = PathTool.getPartnerTypeIcon(hero_type)
			loadSpriteTexture(ui._professionIcon, res, LOADTEXT_TYPE_PLIST)
		end
	end

	local actionData = ActionController:getInstance():getOverViewActiondata(cfg.activity_id)
	if actionData then
		if actionData.remain_sec and actionData.remain_sec > 0 then
			commonCountDownTime(ui._richText, actionData.remain_sec, {
				time_color="#25ff25",
				outline="#232323",
				time_title=string.format("<div fontcolor=#25ff25 outline=2,#232323>%s</div>", TI18N("语言_c_13")),
				label_type= CommonAlert.type.rich,
				str_end = TI18N("语言_c_233")
			})
		else
			ui._richText:setString("")
		end
	end

end

-- desc: 
function ActionMainuiPushHeroPop:register_event()
	local ui = self
	registerButtonEventListener(self._closeBtn, handler(self, self.close), true, 2)
	registerButtonEventListener(ui._goBtn, handler(self, self._onClickGoBtn), true)
	
	registerButtonEventListener(ui._videoBtn, handler(self, self._onClickVideoBtn), true)

	registerButtonEventListener(ui._extendTouch, function ()
		if ui._noTipsCheck:isSelected() then
			ui._noTipsCheck:setSelected(false)
			-- RoleEnv:getInstance():set(RoleEnv.keys.activity_push_record_checkbox_status, false)
		else
			ui._noTipsCheck:setSelected(true)
			-- RoleEnv:getInstance():set(RoleEnv.keys.activity_push_record_checkbox_status, true)
			MainuiController:getInstance():getModel():recordShowTime(self._data, true)
		end
	end, true)

	ui._noTipsCheck:addEventListener(function(sender,event_type)
        if event_type == ccui.CheckBoxEventType.selected then
            playButtonSound2()
			-- RoleEnv:getInstance():set(RoleEnv.keys.activity_push_record_checkbox_status, true)
			MainuiController:getInstance():getModel():recordShowTime(self._data, true)
        elseif event_type == ccui.CheckBoxEventType.unselected then 
            playButtonSound2()
            -- RoleEnv:getInstance():set(RoleEnv.keys.activity_push_record_checkbox_status, false)
        end
    end)

end
-- desc: 
function ActionMainuiPushHeroPop:close_callback()
	if self._data then 
		ActionController:getInstance():openActionMainuiPushPop(false, self._data)
	end
	if not self._isJump then
		GlobalEvent:getInstance():Fire(MainuiEvent.TRY_POP_ACTION_EVENT)
	end
end
-- desc: 
function ActionMainuiPushHeroPop:_onClickGoBtn(param, sender, event_type)
	if self._data then
		local cfg = self._data.cfg
		self._isJump = true
		self:close()
		if self._data.cfg.push_type == 7 then
			local config = Config.SourceData.data_source_data[cfg.jump_id]
			if config then
				BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
			end
		else
			local actionData = ActionController:getInstance():getOverViewActiondata(cfg.activity_id)
			if actionData then
				JumpController:getInstance():jumpViewByEvtData({700,actionData.bid})
			-- 	ActionController:getInstance():openActionAactivityOverview(true, actionData.cli_type)
			end
		end
	end
end
-- desc: 
function ActionMainuiPushHeroPop:_onClickVideoBtn(param, sender, event_type)
	if self._data then
		local cfg = self._data.cfg
		local actionData = ActionController:getInstance():getOverViewActiondata(cfg.activity_id)
		if actionData then
			TimesummonController:getInstance():send23219(actionData.bid)
		end
	end
end