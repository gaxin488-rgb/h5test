--@ 子项
ActionLuckyUpNewShopItem = class("ActionLuckyUpNewShopItem", function()
    return ccui.Widget:create()
end)

function ActionLuckyUpNewShopItem:ctor()
	self:configUI()
	self:register_event()
end

function ActionLuckyUpNewShopItem:configUI(  )
	self.size = cc.size(684,235)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("action/action_lucky_up_new_shop_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title = self.main_container:getChildByName("title")
    self.goods_list = self.main_container:getChildByName("goods_list")

    local scroll_size = self.goods_list:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 25,                    -- x方向的间隔
        start_y = 8,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width * 0.9,   -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.9, -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scroll_view = CommonScrollViewLayout:create(self.goods_list, cc.p(0, 0), ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_size, setting)
    self.item_scroll_view:setSwallowTouches(false)
    self.item_scroll_view:setClickEnabled(false)

    self.txt_price = self.main_container:getChildByName("txt_price")
    self.img_cut_line = self.main_container:getChildByName("img_cut_line")
    self.txt_limit_time = self.main_container:getChildByName("txt_limit_time")
    self.btn_buy = self.main_container:getChildByName("btn_buy")
    self.txt_buy = self.btn_buy:getChildByName("txt_buy")    
end

function ActionLuckyUpNewShopItem:register_event(  )
	registerButtonEventListener(self.btn_buy, function()
        if self.data then
            if self.data and self.data.charge_id and self.data.left_time > 0 then
                self.cur_charge_id = self.data.charge_id
                ActionController:getInstance():sender21016(self.data.charge_id)
            end
        end
    end, true, 1)

    if not self.charge_data_event then
        self.charge_data_event = GlobalEvent:getInstance():Bind(ActionEvent.Is_Charge_Event,function(data)
            if data and data.status and data.charge_id and data.charge_id == self.cur_charge_id then
                local charge_config = Config.ChargeData.data_charge_data[data.charge_id]
                if charge_config and data.status == 1 then
                    sdkOnPay(charge_config.val, 1, charge_config.id, charge_config.name, charge_config.name)
                end
            end
        end)
    end
end

function ActionLuckyUpNewShopItem:setData( data )
    self.data = data
    local gift_txt = string.format(TI18N("语言_c_6969"),StringUtil.numToRoman(data.aim))
    self.title:setString(gift_txt)

    local price_list = keyfind('aim_args_key', ActionExtType.ActivityOldPrice, data.aim_args)
    local price = price_list.aim_args_val or 0
    self.txt_price:setString(string_format(TI18N("语言_c_4473"), price))
    local dis_price_list = keyfind('aim_args_key', ActionExtType.ActivityCurrentPrice, data.aim_args)
    local discount_price = dis_price_list.aim_args_val or 0
    self.txt_buy:setString(string_format(TI18N("语言_c_4440"), discount_price))
    local current_list = keyfind('aim_args_key', ActionExtType.RechageCurCount, data.aim_args)
    local totle_list = keyfind('aim_args_key', ActionExtType.RechageTotalCount, data.aim_args)
    local current_count = current_list.aim_args_val or 0
    local totle_count = totle_list.aim_args_val or 0
    self.txt_limit_time:setString(string_format(TI18N("语言_c_4472"),current_count,totle_count))
    data.left_time = totle_count - current_count
    if data.left_time <= 0 then
        self.txt_buy:setString(TI18N("语言_c_210"))
        self.txt_buy:enableOutline(Config.ColorData.data_color4[84],2)
        setChildUnEnabled(true, self.btn_buy)
    else
        setChildUnEnabled(false, self.btn_buy)
    end
    local charge_list = keyfind('aim_args_key', ActionExtType.ItemRechargeId, data.aim_args)
    --支付物品ID
    data.charge_id = charge_list.aim_args_val or 0
    local item_count = tableLen(data.item_list)
    if item_count > 5 then
        self.item_scroll_view:setClickEnabled(true)
        self.item_scroll_view:setPositionX(0)
    else
        self.item_scroll_view:setClickEnabled(false)
        self.item_scroll_view:setPositionX((5 - item_count) * 10 + (4 - item_count) * 55)
    end
    self.item_scroll_view:setData(data.item_list)
    self.item_scroll_view:addEndCallBack(function()
        local data = self.item_scroll_view:getItemList()
        for k,v in pairs(data) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
        end
    end)
end

function ActionLuckyUpNewShopItem:DeleteMe(  )
    if self.item_scroll_view then
        self.item_scroll_view:DeleteMe()
        self.item_scroll_view = nil
    end
    if self.charge_data_event then
        GlobalEvent:getInstance():UnBind(self.charge_data_event)
        self.charge_data_event = nil
    end
	self:removeAllChildren()
	self:removeFromParent()
end