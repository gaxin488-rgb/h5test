ActionFourGold = class("ActionFourGold", function()
	return ccui.Widget:create()
end)
local color_text = {
    [1] = cc.c4b(0x00,0xff,0x00,0xff),
    [2] = cc.c4b(0x64,0x35,0x23,0xff),
}
local controller = ActionController:getInstance()
local model = controller:getModel()
local string_format = string.format

function ActionFourGold:ctor(bid,id,remain_sec)
    self.remain_sec = remain_sec
    self.holiday_bid = bid
    self.list_data = {}
	self:configUI()
    self:register_event()

end

function ActionFourGold:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_four_gold"))
	self.root_wnd:setPosition(-40,-70)
	self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
    self:setAnchorPoint(0, 0)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.title_con = self.main_container:getChildByName("title_con")
    self.title_img = self.title_con:getChildByName("title_img")
    self.time_panel = self.title_con:getChildByName("time_panel")
    self.time_label = self.title_con:getChildByName("label_time_key")
    self.time_label:setPositionX(20)
    self.time_label:setString(TI18N("语言_c_1242"))
    self.time_text = self.title_con:getChildByName("label_time")
    self.time_text:setPositionX(self.time_label:getPositionX() + self.time_label:getContentSize().width + 10)
    self.time_text:setTextColor(color_text[1])
    self.time_text:setAnchorPoint(cc.p(0, 0.5))
    controller:getModel():setCountDownTime(self.time_text,self.remain_sec or 0)
    self.time_panel:setContentSize(cc.size(self.time_text:getContentSize().width + self.time_label:getContentSize().width + 50,26))
    self.time_panel:setPositionY(9)
    self.time_text:setPositionY(22)
    self.time_label:setPosition(cc.p(493, 22))
    self.time_panel:setPositionX(705 - self.time_panel:getContentSize().width)
    self.time_text:setAnchorPoint(cc.p(0, 0.5))
    self.time_label:setPositionX(self.time_panel:getPositionX() + 10)
    self.time_text:setPositionX(self.time_label:getPositionX() + self.time_label:getContentSize().width + 5)

    self:loadBannerImage()

    self.charge_con = self.main_container:getChildByName("charge_con")

    self.Sprite_3 = self.main_container:getChildByName("Sprite_3")
	controller:cs16603(self.holiday_bid)
end
--加载banner图片
function ActionFourGold:loadBannerImage()
    local str_banner = "txt_cn_welfare_banner200"
    local tab_vo = controller:getActionSubTabVo(self.holiday_bid)
    if tab_vo and tab_vo.reward_title ~= "" and tab_vo.reward_title then
        str_banner = tab_vo.reward_title
    end

    -- local res = PathTool.getWelfareBannerRes(str_banner)
    local res = PathTool.getPlistImgForDownLoad("welfare/welfare_banner", str_banner)
    if not self.item_load then
        self.item_load = createResourcesLoad(res, ResourcesType.single, function()
            if not tolua.isnull(self.title_img) then
                loadSpriteTexture(self.title_img, res, LOADTEXT_TYPE)
            end
        end,self.item_load)
    end
end
function ActionFourGold:register_event()
    if not self.update_option_event then
        self.update_option_event = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE,function (data)
            if data.bid == self.holiday_bid then
                self:setPanelData(data)
            end
        end)
    end    
end
function ActionFourGold:setPanelData(data)
    local item_list = {}
    for k, v in pairs(data.aim_list) do
        local list = {}
        list.charge_id = v.aim
        list.sort = keyfind('aim_args_key', 39, v.aim_args).aim_args_val
        list.limit_count = keyfind('aim_args_key', 2, v.aim_args).aim_args_val
        list.buy_count = keyfind('aim_args_key', 6, v.aim_args).aim_args_val
        list.status = list.buy_count >= list.limit_count and 2 or 1
        list.buy_items = {}
        list.deliver_items = {}
        local _num = 0
        for i = 1, tableLen(v.item_list) do
            _num = math.max(_num,v.item_list[i].num)
        end
        for i = 1, tableLen(v.item_list) do
            local _list = {v.item_list[i].bid,v.item_list[i].num}
            if v.item_list[i].num == _num and not next(list.deliver_items) then
                list.deliver_items=_list
            else
                table.insert(list.buy_items,_list)
            end
        end
        table.insert(item_list, list)
    end
    local sort_func = SortTools.tableCommonSorter({{"status", false},{"sort",false}})--{"id", false}
    table.sort(item_list, sort_func)
    if self.task_view == nil then
        local scroll_view_size = self.charge_con:getContentSize()
        local setting = {
            item_class = ActionFourGoldItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 3,                    -- 第一个单元的Y起点
            space_y = 3,                   -- y方向的间隔
            item_width = 694,               -- 单元的尺寸width
            item_height = 136,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.task_view = CommonScrollViewLayout.new(self.charge_con, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    self.task_view:setData(item_list)
end

function ActionFourGold:DeleteMe()
    if self.update_option_event then
        GlobalEvent:getInstance():UnBind(self.update_option_event)
        self.update_option_event = nil
    end
    if self.task_view then
		self.task_view:DeleteMe()
		self.task_view = nil
	end
end

--子项
ActionFourGoldItem = class("ActionFourGoldItem", function()
    return ccui.Widget:create()
end)

function ActionFourGoldItem:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function ActionFourGoldItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_four_gold_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(694,136))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.buy_scroll = self.main_container:getChildByName("buy_scroll")
    self.buy_scroll:setScrollBarEnabled(false)
    self.buy_scroll:setSwallowTouches(false)
	self.tip_txt = self.main_container:getChildByName("tip_txt")
	self.tip_img = self.main_container:getChildByName("tip_img")
	self.btn = self.main_container:getChildByName("btn")
	self.btn_txt = self.btn:getChildByName("label")
    self.btn_txt:setString(TI18N("语言_c_8"))
    self.give_img = createSprite(PathTool.getItemRes(3),253,70,self.main_container,cc.p(0.5,0.5),LOADTEXT_TYPE)
    self.give_num = CommonNum.new(23, self.main_container, 99999, - 2, cc.p(0, 0.5), 4)
    self.give_num:setPosition(300, 70)
    self.give_num:setScale(0.9)
    self.give_img:setVisible(false)
    self.give_num:setVisible(false)
end

function ActionFourGoldItem:setData(data)
    if not data or next(data) == nil then return end
    self.data = data

    if self.data.status == 1 then --未购买
        self.btn:setVisible(true)
        self.tip_img:setVisible(false)
        self.tip_txt:setVisible(true)
        local charge_data = Config.ChargeData.data_charge_data
        if charge_data[self.data.charge_id] then
            local pay_value = GetMoneyNum(charge_data[self.data.charge_id],"val")
            self.btn_txt:setString(string.format(TI18N("语言_c_4440"),pay_value))
        end
        self.tip_txt:setString(string.format(TI18N("语言_c_4050"),self.data.limit_count-self.data.buy_count))
    elseif self.data.status == 2 then --已购买
        self.btn:setVisible(false)
        self.tip_img:setVisible(true)
        self.tip_txt:setVisible(false)
    end

    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    local setting = {}
    setting.scale = 0.75
    setting.space_x = 2
    setting.max_count = 1
    setting.is_center = false
    self.item_list1 = commonShowSingleRowItemList(self.buy_scroll, self.item_list1, self.data.buy_items, setting)
    local item_cfg = Config.ItemData.data_get_data(self.data.deliver_items[1])
    loadSpriteTexture(self.give_img,PathTool.getItemRes(item_cfg.icon),LOADTEXT_TYPE)
    self.give_img:setVisible(true)
    self.give_num:setNum("x"..self.data.deliver_items[2])
    self.give_num:setVisible(true)
end

function ActionFourGoldItem:register_event( )
    registerButtonEventListener(self.btn, function()
        if self.data.charge_id then
            ActionController:getInstance():sender21016(self.data.charge_id)
        end
    end,true, 1)
    if not self.charge_data_event then
        self.charge_data_event = GlobalEvent:getInstance():Bind(ActionEvent.Is_Charge_Event, function(data)
            if data and data.status and data.charge_id and data.charge_id == self.data.charge_id then
                local charge_config = Config.ChargeData.data_charge_data[data.charge_id]
                if charge_config and data.status == 1 and data.charge_id == self.data.charge_id then
                    sdkOnPay(charge_config.val, 1, charge_config.id, charge_config.name, charge_config.name)
                end
            end
        end)
    end
end

function ActionFourGoldItem:DeleteMe()
    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.give_num then
        self.give_num:DeleteMe()
    end
    self.give_num = nil
    if self.charge_data_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.charge_data_event)
        self.charge_data_event = nil
    end
end