-- --------------------------------------------------------------------
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      无尽试炼排行榜数据
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
local controller = ActionController:getInstance()
local model = controller:getModel()
local _table_insert = table.insert

ActionLegendaryRankWindow =  ActionLegendaryRankWindow or BaseClass(BaseView)

function ActionLegendaryRankWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
    self.is_init = true
    self.layout_name = "action/action_legendary_rank_panel"
end

function ActionLegendaryRankWindow:open_callback(  )
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    controller:send21724(RankConstant.RankType.Legendary_Trial)
    self.rank_panel=self.root_wnd:getChildByName("rank_panel")
    self.rank_scroll = self.rank_panel:getChildByName("rank_scroll")
    self.rank_panel:getChildByName("rank_key1"):setString(TI18N("语言_c_255"))
    self.rank_panel:getChildByName("rank_key2"):setString(TI18N("语言_c_1486"))
    self.rank_panel:getChildByName("rank_key3"):setString(TI18N("语言_c_5236"))
    self.empty_bg = self.rank_scroll:getChildByName("empty_bg")
    self.empty_bg:setVisible(false)
    self.image_bg=self.root_wnd:getChildByName("image_bg")
    loadSpriteTexture(self.empty_bg, PathTool.getPlistImgForDownLoad("bigbg", "bigbg_3"), LOADTEXT_TYPE)
    self.desc_label = self.empty_bg:getChildByName("desc_label")
    self.desc_label:setPositionX(self.empty_bg:getContentSize().width / 2)
    self.desc_label:setPositionY(-30)
    self.desc_label:setString(TI18N("语言_c_1067"))
    self.type_btn_panel=self.root_wnd:getChildByName("type_btn_panel")
    self.rule_panel = self.root_wnd:getChildByName("rule_panel")
    self.rule_scroll = self.rule_panel:getChildByName("rule_scroll")
    self.rule_scroll:setScrollBarEnabled(false)
    self.scroll_size = self.rule_scroll:getContentSize()

    local size = cc.size(self.rank_scroll:getContentSize().width, self.rank_scroll:getContentSize().height-10)
    local setting = {
        item_class = ActionLegendaryRankItem,
        start_x = 4,
        space_x = 4,
        start_y = 0,
        space_y = -3,
        item_width = 650,
        item_height = 125,
        row = 0,
        col = 1,
        need_dynamic = true
    }
    self.scroll_view = CommonScrollViewLayout.new(self.rank_scroll, cc.p(0, 5), nil, nil, size, setting)
 
    local my_container = self.rank_panel:getChildByName("my_container")
    local key_label=my_container:getChildByName("key_label")
    key_label:setString(TI18N("语言_c_452"))
    self.rank_img = my_container:getChildByName("rank_img")
    self.rank_img:setVisible(false)
    self.rank_x = self.rank_img:getPositionX()
    self.rank_y = self.rank_img:getPositionY()
    local Image_my=my_container:getChildByName("Image_my")
    local my_rank=my_container:getChildByName("my_rank")
    my_rank:setString(TI18N("语言_c_258"))
    autoSizeTitleBg(my_rank,Image_my,20,110)
    self.role_name = my_container:getChildByName("role_name")
    self.role_power = my_container:getChildByName("role_power")
    self.power_bg = my_container:getChildByName("Image_1")
    self.no_rank = my_container:getChildByName("no_rank")
    self.no_rank:setString(TI18N("语言_c_285"))
    self.no_rank:setVisible(false)
    local keyx=key_label:getPositionX()+key_label:getContentSize().width+10
    self.power_bg:setPositionX(keyx)
    self.role_power:setPositionX(keyx+5)

    self.video_btn=my_container:getChildByName("video_btn")
    -- self.video_btn:getChildByName("label"):setString(TI18N("语言_c_4080"))
    self.data_btn= my_container:getChildByName("data_btn")

    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.role_head:setHeadLayerScale(0.95)
    self.role_head:setPosition(150, 65)
    self.role_head:setLev(99)
    self.role_head:setTouchEnabled(true)
    my_container:addChild(self.role_head)
    self.my_container = my_container

    self.reward_panel=self.root_wnd:getChildByName("reward_panel")
    self.reward_panel:getChildByName("reward_title"):setString(TI18N("语言_c_255"))
    self.reward_panel:getChildByName("award_title"):setString(TI18N("语言_c_282"))
    local my_rewardPanel = self.reward_panel:getChildByName("my_rewardPanel")
    self.rank_label = my_rewardPanel:getChildByName("rank_label")
    self.rank_label:setChangeScaleOffWidth(50)
    my_rewardPanel:setVisible(false)
    setTextMaxWidth(self.rank_label,100)
    local reward_scroll = self.reward_panel:getChildByName("reward_scroll")
    local size = reward_scroll:getContentSize()
    local setting = {
        item_class = ActionLegendaryRewardItem,
        start_x = 0,
        space_x = 4,
        start_y = 0,
        space_y = 0,
        item_width = 640,
        item_height = 124,
        row = 0,
        col = 1,
        need_dynamic = true
    }
    self.reward_view = CommonScrollViewLayout.new(reward_scroll, nil, nil, nil, size, setting)
    
    self.item_container=my_rewardPanel:getChildByName("item_container")
    
    local scroll_view_size = self.item_container:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 5,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width,               -- 单元的尺寸width
        item_height = BackPackItem.Height,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }

    self.item_scrollview = CommonScrollViewLayout.new(self.item_container, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
    self:initTypeBtnList()
    self:registerEvent()
end

-- 初始化Tab按钮列表
function ActionLegendaryRankWindow:initTypeBtnList()
    self.tab_array = {
        TI18N("语言_c_5440"),
        TI18N("语言_c_5441"),
        TI18N("语言_c_5465"),
    }
    self.tab_btn_list = {}
    for i=1,3 do
        local tab_btn = {}
        local item = self.type_btn_panel:getChildByName("tab_btn_"..i)
        tab_btn.btn = item
        tab_btn.index = i
        tab_btn.select_bg = item:getChildByName("select_img")
        tab_btn.select_bg:setVisible(false)
        tab_btn.title = item:getChildByName("label")
        tab_btn.title:getVirtualRenderer():setLineSpacing(-10)
        tab_btn.title:setTextColor(cc.c4b(247,238,117,255))
        tab_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
        tab_btn.title:setFontSize(25)
        tab_btn.title:setChangeScaleOffWidth(60)
        tab_btn.title:setString(self.tab_array[i])
        setTextSpacing(tab_btn.title,-15)
        tab_btn.red_point = item:getChildByName("red_point")
        tab_btn.red_point:setVisible(false)
        self.tab_btn_list[tab_btn.index] = tab_btn
    end

    for index, tab_btn in ipairs(self.tab_btn_list) do
        registerButtonEventListener(tab_btn.btn, function() self:_onClickTabBtn(tab_btn.index) end ,false, 2) 
    end
    self:_onClickTabBtn(1)
end

-- 点击Tab按钮
function ActionLegendaryRankWindow:_onClickTabBtn( index )
    if self.select_btn and self.select_btn.index == index then return end

    if self.select_btn then 
        self.select_btn.select_bg:setVisible(false)
        self.select_btn.title:setTextColor(cc.c4b(249,238,208,255))
        self.select_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
    end
    self.select_btn = self.tab_btn_list[index]
    if self.select_btn then 
        self.select_btn.select_bg:setVisible(true)
        self.select_btn.title:setTextColor(cc.c4b(248,239,118,255))
        self.select_btn.title:enableOutline(cc.c4b(92,39,5,255), 2)
        self:updateSubTabBtn(index)
    end
end

function ActionLegendaryRankWindow:updateSubTabBtn( index )
	self.rank_panel:setVisible(index == 1)
	self.reward_panel:setVisible(index == 2)
    self.rule_panel:setVisible(index == 3)
    if index==1 then
        self.image_bg:setContentSize(cc.size(680,520))
    else
        self.image_bg:setContentSize(cc.size(680,620))
    end
end

function ActionLegendaryRankWindow:registerEvent()
    -- if self.update_rank_event == nil then
    --     self.update_rank_event = GlobalEvent:getInstance():Bind(RankEvent.RankEvent_Get_Rank_data, function(data) 
    --         if data.type == RankConstant.RankType.Legendary_Trial then
    --             self:updateRankList(data)
    --         end
    --     end)
    -- end
    if self.background then 
        self.background:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                controller:openLegendaryRankView(false)
            end
        end)
    end

    registerButtonEventListener(self.role_head, function ()
        message(TI18N("语言_c_432"))
    end)
    registerButtonEventListener(self.data_btn, function (  )
        local bid=self.trialdata.bid
        ActionController:getInstance():sender21717(bid, self.ranknum)
    end, true, 1)
    registerButtonEventListener(self.video_btn, function (  )
        local bid=self.trialdata.bid
        ActionController:getInstance():sender21716(bid, self.ranknum)
    end, true,nil,nil,1.4)

    self:addGlobalEvent(ActionEvent.Get_LegendTrial_vedio_info, function ( data )
        if data.list and #data.list>=1 then
            local replay_id=data.list[1].replay_id
            playButtonSound2()
            BattleController:getInstance():csRecordBattle(replay_id or 0)
        end
    end)

    self:addGlobalEvent(ActionEvent.Get_LegendTrial_info, function ( data )
        if data then
           self:showBattleInfo(data)
        end
    end)
end

-- 查看伤害统计
function ActionLegendaryRankWindow:showBattleInfo(data)
    local harmInfo = {}
    harmInfo.hurt_statistics = {}
    harmInfo.atk_name=data.atk_name
    harmInfo.target_role_name=data.target_role_name
    if data.ext and next(data.ext) ~= nil then
        for k,v in pairs(data.ext) do
            if v.key == 1 then
                harmInfo.srv_id = v.str 
                break
            end
        end
    end
    harmInfo.srv_id = harmInfo.srv_id or data.a_srv_id     
    for i=1,2 do
        local temp_data = {}
        temp_data.type = i
        temp_data.partner_hurts = {}
        if i == 1 then
            for i,v in ipairs(data.a_plist) do
                _table_insert(temp_data.partner_hurts, v)
            end
        else
            for i,v in ipairs(data.b_plist) do
                _table_insert(temp_data.partner_hurts, v)
            end
        end
        table.insert(harmInfo.hurt_statistics, temp_data)
    end
    BattleController:getInstance():openBattleHarmInfoView(true, harmInfo)
end

function ActionLegendaryRankWindow:openRootWnd(actid)
     self.actid=actid
     self.trialdata=model:getLegendTrialData()
     local data= model:getTrialRankData()
     if data then
        self:updateRankList(data)
        self:updateRewardList(data)
        self:updateRuleList(data)
        local tmp_list = data.rank_list
        self.scroll_view:setData(tmp_list)
     end
end

function ActionLegendaryRankWindow:setNodeVisible(status)
    self:setVisible(status)
end

function ActionLegendaryRankWindow:updateRuleList(data)
    local data= model:getLegendTrialData()
    if not data then return end
    local buff_desc= Config.BuffData.data_get_buff_data[data.buff].des
    local hero_id= Config.HolidayLegendTrialData.data_constant[self.actid].hero_id
    local name=Config.PartnerData.data_partner_base[hero_id].name
    local str=""
    if data.bufflv>0 then
        str=string.format(TI18N("语言_trial_2"),name,buff_desc)
    else
        str=string.format(TI18N("语言_c_5399"),name)    
    end
    if not self.desc_txt or not self.desc_txt.setString then
		self.desc_txt = createRichLabel(24, cc.c4b(149, 83, 34, 255), cc.p(0,1), cc.p(10,self.scroll_size.height), 0, 0, self.scroll_size.width-10)
		self.rule_scroll:addChild(self.desc_txt)
	end
	self.desc_txt:setString(str)--
end

function ActionLegendaryRankWindow:updateRewardList(data)
    local reward_list  = Config.HolidayLegendTrialData.data_get_rank[self.actid]
    if reward_list ~= nil and next(reward_list) ~= nil then
        self.reward_view:setData(reward_list)
    end
    local myidx=data.my_idx
    local item_data
    for i,v in pairs(reward_list) do
        if v.rank1<= myidx and v.rank2>=myidx then
            item_data=v.award
            break
        end
    end
    if item_data then
		self.item_scrollview:setData(item_data)
        self.item_scrollview:addEndCallBack(function()
            local list = self.item_scrollview:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip()
            end
        end)
	end
    self.rank_label:setString(string.format(TI18N("语言_c_1392"),myidx))
end

function ActionLegendaryRankWindow:updateRankList(data)
    if data~=nil then
        self.role_name:setString(data.name)
        self.role_power:setString(data.my_val1)
        self.ranknum=data.my_idx
        if data.my_idx <= 3 then
            if data.my_idx == 0 then
                self.rank_img:setVisible(false)
                self.no_rank:setVisible(true)
                self.video_btn:setVisible(false)
                self.data_btn:setVisible(false)
            else
                self.no_rank:setVisible(false)
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.my_idx))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id  = res_id
                    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_img:setVisible(true)
                self.video_btn:setVisible(true)
                self.data_btn:setVisible(true)
            end
        else
            if self.rank_num == nil then
                self.rank_num = CommonNum.new(1, self.my_container, 1, -2, cc.p(0.5, 0.5))
                self.rank_num:setPosition(59,77)
            end
            self.rank_num:setVisible(true)
            self.rank_num:setNum(data.my_idx)
            self.rank_img:setVisible(false)
            self.video_btn:setVisible(false)
            self.data_btn:setVisible(false)
        end

        self.role_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
        self.role_head:setLev(data.lev)
        local avatar_bid = data.avatar_bid
        local vo = Config.AvatarData.data_avatar[avatar_bid]
        if vo then
            local res_id = vo.res_id or 1
            local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
            self.role_head:showBg(res, nil, false, vo.offy)
        end

        -- 创建排行榜
        if data.rank_list ~= nil and next(data.rank_list) ~= nil then
            self.scroll_view:setData(data.rank_list)
            self.empty_bg:setVisible(false)
        else
            self.empty_bg:setVisible(true)
        end
    end
end


function ActionLegendaryRankWindow:DeleteMe()
    -- if self.update_rank_event ~= nil then
    --     GlobalEvent:getInstance():UnBind(self.update_rank_event)
    --     self.update_rank_event = nil
    -- end

    if self.rank_num then
        self.rank_num:DeleteMe()
        self.rank_num = nil
    end
    if self.scroll_view then
        self.scroll_view:DeleteMe()
        self.scroll_view = nil
    end
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- @description:
--      循环赛排行榜单元
-- <br/>Create: new Date().toISOString()
--
-- --------------------------------------------------------------------
ActionLegendaryRankItem = class("ActionLegendaryRankItem",function()
    return ccui.Layout:create()
end)

function ActionLegendaryRankItem:ctor()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_legendary_rank_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    self.rank_img = container:getChildByName("rank_img")
    self.role_name = container:getChildByName("role_name")
    self.role_power = container:getChildByName("role_power")
    self.power_bg = container:getChildByName("Image_1")
    self.video_btn=container:getChildByName("video_btn")
    -- self.video_btn:getChildByName("label"):setString(TI18N("语言_c_4080"))
    self.data_btn= container:getChildByName("data_btn")
    local key_label=container:getChildByName("key_label")
    key_label:setString(TI18N("语言_c_452"))
    local keyx=key_label:getPositionX()+key_label:getContentSize().width+10
    self.power_bg:setPositionX(keyx)
    self.role_power:setPositionX(keyx+5)
    
    self.role_head = PlayerHead.new(PlayerHead.type.circle)
    self.role_head:setHeadLayerScale(0.95)
    self.role_head:setPosition(150, 65)
    self.role_head:setTouchEnabled(true)
    container:addChild(self.role_head)
    self.role_head:setLev(99)

    self.container = container

    self:registerEvent()
end

function ActionLegendaryRankItem:registerEvent()
    registerButtonEventListener(self.data_btn, function (  )
        local bid=self.trialdata.bid
        ActionController:getInstance():sender21717(bid, self.data.idx)
    end, true, 1)
    registerButtonEventListener(self.video_btn, function (  )
        local bid=self.trialdata.bid
        ActionController:getInstance():sender21716(bid, self.data.idx)
    end, true,nil,nil,1.4)
    
    registerButtonEventListener(self.role_head, function ()
        if self.data ~= nil then
            FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.data.srv_id, rid = self.data.rid})
        end
    end)
end

function ActionLegendaryRankItem:setData(data)
    local role_vo = RoleController:getInstance():getRoleVo()
    self.trialdata=model:getLegendTrialData()
    if data and role_vo then
        self.data = data
        self.role_name:setString(data.name)
        self.role_power:setString(data.val1)
        self.role_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
        self.role_head:setLev(data.lev)
        local avatar_bid = data.avatar_id 
        local vo = Config.AvatarData.data_avatar[avatar_bid]
        if vo then
            local res_id = vo.res_id or 1
            local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
            self.role_head:showBg(res, nil, false, vo.offy)
        end

        if data.idx <= 3 then
            if self.rank_num ~= nil then
                self.rank_num:setVisible(false)
            end
            if data.idx == 0 then
                self.rank_img:setVisible(false)
            else
                local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.idx))
                if self.rank_res_id ~= res_id then
                    self.rank_res_id = res_id
                    loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                end
                self.rank_img:setVisible(true)
            end
            self.video_btn:setVisible(true)
            self.data_btn:setVisible(true)
        else
            if self.rank_num == nil then
                self.rank_num = CommonNum.new(1, self.container, 1, -2, cc.p(0.5, 0.5))
                self.rank_num:setPosition(59, 77)
            end
            self.rank_num:setVisible(true)
            self.rank_num:setNum(data.idx)
            self.rank_img:setVisible(false)
            self.video_btn:setVisible(false)
            self.data_btn:setVisible(false)
        end
    end
end

function ActionLegendaryRankItem:DeleteMe()
    if self.rank_num ~= nil then
        self.rank_num:DeleteMe()
        self.rank_num = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

ActionLegendaryRewardItem = class("ActionLegendaryRewardItem",function()
    return ccui.Layout:create()
end)

function ActionLegendaryRewardItem:ctor()
    self.item_list = {}

    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_legendary_reward_item"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    self.rank_img = self.root_wnd:getChildByName("rank_img")
    self.rank_label = self.root_wnd:getChildByName("rank_label")
    self.item_container = self.root_wnd:getChildByName("item_container")
    local scroll_view_size = self.item_container:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 3,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width,               -- 单元的尺寸width
        item_height = BackPackItem.Height,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }

    self.item_scrollview = CommonScrollViewLayout.new(self.item_container, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)

    self:registerEvent()
end

function ActionLegendaryRewardItem:registerEvent()
end

function ActionLegendaryRewardItem:setData(data)
    if data ~= nil then
        if data.id ~= nil then
            if data.id <= 3 then
                self.rank_label:setVisible(false)
                if data.id == 0 then
                    self.rank_img:setVisible(false)
                else
                    local res_id = PathTool.getResFrame("common", string.format("common_200%s", data.id))
                    if self.rank_res_id ~= res_id then
                        self.rank_res_id = res_id
                        loadSpriteTexture(self.rank_img, res_id, LOADTEXT_TYPE_PLIST)
                    end
                    self.rank_img:setVisible(true)
                end
            else
                self.rank_img:setVisible(false)
                self.rank_label:setVisible(true)
                self.rank_label:setString(string.format("%s~%s", data.rank1, data.rank2))
            end 
        end
        
        self.item_scrollview:setData(data.award)
        self.item_scrollview:addEndCallBack(function()
            local list = self.item_scrollview:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip()
            end
        end)
    end
end

function ActionLegendaryRewardItem:DeleteMe()
    for i,v in ipairs(self.item_list) do
        v:DeleteMe()
    end
    self.item_list = nil
    self:removeAllChildren()
    self:removeFromParent()
end
