ActionLuckyUpShopPanel = class("ActionLuckyUpShopPanel", function()
	return ccui.Widget:create()
end)

local controller = ActionController:getInstance()
local model = ActionController:getInstance():getModel()
local string_format = string.format
local role_vo = RoleController:getInstance():getRoleVo()

function ActionLuckyUpShopPanel:ctor(bid)
	self.holiday_bid = bid
    self.gear_num = 1
    self.show_reward_list = {}
	self:configUI()
	self:register_event()
end

function ActionLuckyUpShopPanel:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_lucky_up_shop_panel"))
	self.root_wnd:setPosition(-40,-80)
	self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setAnchorPoint(0, 0)

	self.main_container = self.root_wnd:getChildByName("main_container")

    self.time_panel = self.main_container:getChildByName("time_panel") 		--剩余时间
    self.txt_time_title = self.time_panel:getChildByName("txt_time_title") 	--时间标题
    self.txt_time_title:setString(TI18N("语言_c_1242"))
    self.txt_time_val = self.time_panel:getChildByName("txt_time_val") 		--剩余时间
    self.time_panel:setContentSize(cc.size(self.txt_time_title:getContentSize().width+120, self.time_panel:getContentSize().height))
    setItemXOneByOne({self.txt_time_title,self.txt_time_val})

    self.panel_1 = self.main_container:getChildByName("panel_1")
    self.img_bg = self.panel_1:getChildByName("img_bg")
    self.txt_price_1 = self.panel_1:getChildByName("txt_price_1") 				--礼包原价
    self.txt_price_2 = self.panel_1:getChildByName("txt_price_2") 				--礼包原价
    self.txt_price_3 = self.panel_1:getChildByName("txt_price_3") 				--礼包原价

    self.img_cut_line_1 = self.panel_1:getChildByName("img_cut_line_1")
    self.img_cut_line_2 = self.panel_1:getChildByName("img_cut_line_2")
    self.img_cut_line_3 = self.panel_1:getChildByName("img_cut_line_3")

    --礼包限购次数
    self.txt_limit_time_1 = self.panel_1:getChildByName("txt_limit_time_1")
    self.txt_limit_time_2 = self.panel_1:getChildByName("txt_limit_time_2")
    self.txt_limit_time_3 = self.panel_1:getChildByName("txt_limit_time_3")

    self.btn_buy_1 = self.panel_1:getChildByName("btn_buy_1")
    self.txt_buy_1 = self.btn_buy_1:getChildByName("txt_buy")
    self.btn_buy_2 = self.panel_1:getChildByName("btn_buy_2")
    self.txt_buy_2 = self.btn_buy_2:getChildByName("txt_buy")
    self.btn_buy_3 = self.panel_1:getChildByName("btn_buy_3")
    self.txt_buy_3 = self.btn_buy_3:getChildByName("txt_buy")     

    self.goods_list_1 = self.panel_1:getChildByName("goods_list_1")
    local scroll_size = self.goods_list_1:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 25,                    -- x方向的间隔
        start_y = 8,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width * 0.9,   -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.9, -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scroll_view_1 = CommonScrollViewLayout:create(self.goods_list_1, cc.p(0, 0), ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_size, setting)
    self.item_scroll_view_1:setSwallowTouches(false)
    self.item_scroll_view_1:setClickEnabled(false)

    self.goods_list_2 = self.panel_1:getChildByName("goods_list_2")
    local scroll_size = self.goods_list_2:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 25,                    -- x方向的间隔
        start_y = 8,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width * 0.9,   -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.9, -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scroll_view_2 = CommonScrollViewLayout:create(self.goods_list_2, cc.p(0, 0), ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_size, setting)
    self.item_scroll_view_2:setSwallowTouches(false)
    self.item_scroll_view_2:setClickEnabled(false)

    self.goods_list_3 = self.panel_1:getChildByName("goods_list_3")
    local scroll_size = self.goods_list_3:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 25,                    -- x方向的间隔
        start_y = 8,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width * 0.9,   -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.9, -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scroll_view_3 = CommonScrollViewLayout:create(self.goods_list_3, cc.p(0, 0), ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_size, setting)
    self.item_scroll_view_3:setSwallowTouches(false)
    self.item_scroll_view_3:setClickEnabled(false)

    
    self.next_panel = self.main_container:getChildByName("next_panel")
    self.next_btn = self.next_panel:getChildByName("next_btn")
    self.next_title = self.next_btn:getChildByName("next_title")
    self.next_title:setString(TI18N("语言_c_6479"))
    self.next_tip_bg = self.next_panel:getChildByName("next_tip_bg")
    self.next_tip = createRichLabel(20,cc.c3b(0x7c,0x55,0x36),cc.p(0,0.5),cc.p(193,530),nil,nil,600)
    self.next_panel:addChild(self.next_tip)
    self.next_tip:setHorizontalLayoutType(2)

    controller:cs16603(self.holiday_bid)
end

function ActionLuckyUpShopPanel:register_event()
    if not self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.UPDATE_HOLIDAY_SIGNLE,function (data)
            if not data then return end
            if data.bid == self.holiday_bid then
                self:setData(data)
            end
        end)
    end

    registerButtonEventListener(self.btn_buy_1, function()
        if self.data then
            local list = self.data.aim_list[1]
            if list and list.charge_id and list.left_time > 0 then
                self.cur_charge_id = list.charge_id
                ActionController:getInstance():sender21016(list.charge_id)
            end
        end
    end, true, 1)
    registerButtonEventListener(self.btn_buy_2, function()
        if self.data then
            local list = self.data.aim_list[2]
            if list and list.charge_id and list.left_time > 0 then
                self.cur_charge_id = list.charge_id
                ActionController:getInstance():sender21016(list.charge_id)
            end
        end
    end, true, 1)
    registerButtonEventListener(self.btn_buy_3, function()
        if not self.data then return end
        local list = self.data.aim_list[3]
        if list and list.charge_id and list.left_time > 0 then
            self.cur_charge_id = list.charge_id
            ActionController:getInstance():sender21016(list.charge_id)
        end
    end, true, 1)
    registerButtonEventListener(self.next_btn, function()
        local _x,_y = self.next_btn:getPosition()
        local world_pos = self:convertToWorldSpace(cc.p(_x+350,_y))
        EsecsiceController:getInstance():openEserciseShowRewardWindow(true,self.show_reward_list,world_pos)
    end, true, 1)
    if not self.charge_data_event then
        self.charge_data_event = GlobalEvent:getInstance():Bind(ActionEvent.Is_Charge_Event,function(data)
            if data and data.status and data.charge_id then
                local charge_config = Config.ChargeData.data_charge_data[data.charge_id]
                if charge_config and data.status == 1 and data.charge_id == self.cur_charge_id then
                    sdkOnPay(charge_config.val, 1, charge_config.id, charge_config.name, charge_config.name)
                end
            end
        end)
    end
end

