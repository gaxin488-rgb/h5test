ActionLostTowerBattleReportPanel = ActionLostTowerBattleReportPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()

function ActionLostTowerBattleReportPanel:__init()
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "action/action_lost_tower_battle_report_panel"
	self.result_data = {}-----战报
	self.result_data_2 = {}-----擂主战报
end

function ActionLostTowerBattleReportPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1)
	local image_2 = main_container:getChildByName("image_2")
	local win_title = main_container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_2595"))
	image_2:setContentSize(cc.size(win_title:getContentSize().width + 120,image_2:getContentSize().height))
	self.close_btn = main_container:getChildByName("close_btn")
	self.top_title_bg = main_container:getChildByName("top_title_bg")
	self.top_title_txt = self.top_title_bg:getChildByName("top_title_txt")
	self.top_title_txt:setString(TI18N("语言_c_5919"))
	self.top_title_bg:setContentSize(cc.size(self.top_title_txt:getContentSize().width + 80,38))
	self.battle_report_panel = main_container:getChildByName("battle_report_panel")
	self.top_null_txt = main_container:getChildByName("top_null_txt")
	self.top_null_txt:setString(TI18N("语言_c_273"))
	self.top_null_img = main_container:getChildByName("top_null_img")

	
	self.top_title_bg_1 = main_container:getChildByName("top_title_bg_1")
	self.top_title_txt_1 = self.top_title_bg_1:getChildByName("top_title_txt")
	self.top_title_txt_1:setString(TI18N("语言_c_5920"))
	self.top_title_bg_1:setContentSize(cc.size(self.top_title_txt_1:getContentSize().width + 80,38))
	self.battle_report_panel_1 = main_container:getChildByName("battle_report_panel_1")
	self.top_null_txt_1 = main_container:getChildByName("top_null_txt_1")
	self.top_null_txt_1:setString(TI18N("语言_c_273"))
	self.top_null_img_1 = main_container:getChildByName("top_null_img_1")


	local bgSize = self.battle_report_panel:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height-8)
    local setting = {
        item_class = ActionLostTowerBattleReportItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 574,               -- 单元的尺寸width
        item_height = 160,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.award_scrollview = CommonScrollViewLayout.new(self.battle_report_panel, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.award_scrollview:setSwallowTouches(false)


	local bgSize = self.battle_report_panel_1:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height-8)
    local setting = {
        item_class = ActionLostTowerBattleReportItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 574,               -- 单元的尺寸width
        item_height = 160,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.award_scrollview_1 = CommonScrollViewLayout.new(self.battle_report_panel_1, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.award_scrollview_1:setSwallowTouches(false)
end

function ActionLostTowerBattleReportPanel:openRootWnd(  )
	controller:sender21911()
end

function ActionLostTowerBattleReportPanel:setData(data)
	if not data then return end
	self.data = data
	self.result_data = data.logs
	self.result_data_2 = data.cross_logs
	if #self.result_data > 0 then
        self.award_scrollview:setData(self.result_data)
        self.top_null_img:setVisible(false)
        self.top_null_txt:setVisible(false)
    else
        self.top_null_img:setVisible(true)
        self.top_null_txt:setVisible(true)
    end
	if #self.result_data_2 > 0 then
        self.award_scrollview_1:setData(self.result_data_2)
        self.top_null_img_1:setVisible(false)
        self.top_null_txt_1:setVisible(false)
    else
        self.top_null_img_1:setVisible(true)
        self.top_null_txt_1:setVisible(true)
    end
end

function ActionLostTowerBattleReportPanel:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	if not self.LostTowerBattleReport then
        self.LostTowerBattleReport = GlobalEvent:getInstance():Bind(ActionEvent.LostTowerBattleReport,function(data)
            if not data then return end
			self:setData(data)
        end
        )
    end
end

function ActionLostTowerBattleReportPanel:_onClickBtnClose(  )
	controller:openActionLostTowerBattleReportPanel(false)
end

function ActionLostTowerBattleReportPanel:close_callback(  )
	controller:openActionLostTowerBattleReportPanel(false)
	
    if self.LostTowerBattleReport then
        GlobalEvent:getInstance():UnBind(self.LostTowerBattleReport)
        self.LostTowerBattleReport = nil
    end
end

-----------------------------------@ 奖励item
ActionLostTowerBattleReportItem = class("ActionLostTowerBattleReportItem", function()
    return ccui.Widget:create()
end)

function ActionLostTowerBattleReportItem:ctor()
	self:configUI()
	self:register_event()
end

function ActionLostTowerBattleReportItem:configUI(  )
	self.size = cc.size(574,160)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("action/action_lost_tower_battle_report_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("main_container")
    self.container = container
	self.vs_img= self.container:getChildByName("vs_img")
	self.left_success_img= self.container:getChildByName("left_success_img")
	self.right_success_img= self.container:getChildByName("right_success_img")
	self.left_role= self.container:getChildByName("left_role")
	self.left_head = PlayerHead.new(PlayerHead.type.circle)
	self.left_head:setPosition(60, 60)
	self.left_role:addChild(self.left_head)
	self.right_role= self.container:getChildByName("right_role")
	self.right_head = PlayerHead.new(PlayerHead.type.circle)
	self.right_head:setPosition(60, 60)
	self.right_role:addChild(self.right_head)
	self.right_name= self.container:getChildByName("right_name")
	self.left_name= self.container:getChildByName("left_name")
	self.fight_type= self.container:getChildByName("fight_type")
	self.time= self.container:getChildByName("time")
	self.check_fight_btn= self.container:getChildByName("check_fight_btn")
end

function ActionLostTowerBattleReportItem:register_event(  )
	self.check_fight_btn:addTouchEventListener(function(sender, event_type)
		customClickAction_2(sender, event_type)
		if event_type == ccui.TouchEventType.ended then
			playButtonSound2()
			if self.data and self.data.replay_id ~= 0 then
				BattleController:getInstance():csRecordBattle(self.data.replay_id)
			end
		end
	end)
    self.right_head:addCallBack(function()
		if self.data ~= nil then
            if self.data.tar_srv_id == "" or self.data.tar_id == "" then
            else
			    FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.data.tar_srv_id, rid = self.data.tar_id})
            end
		end
	end, false)
	self.left_head:addCallBack(function()
		if self.data ~= nil then
            if self.data.srv_id == "" or self.data.id == "" then
            else
			    FriendController:getInstance():openFriendCheckPanel(true, {srv_id = self.data.srv_id, rid = self.data.id})
            end
		end
	end, false)
end

function ActionLostTowerBattleReportItem:setData( data )
	if data then
		self.data = data
		self.left_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
		self.left_name:setString(string.format("[%s]%s", getServerName(self.data.srv_id),self.data.name))
		self.left_name:ignoreContentAdaptWithSize(true)
		self.left_name:setTextAreaSize(cc.size(125,0))
		self.right_head:setHeadRes(self.data.tar_face_id, false, LOADTEXT_TYPE, self.data.tar_face_file, self.data.tar_face_update_time)
		self.right_name:setString(string.format("[%s]%s", getServerName(self.data.tar_srv_id),self.data.tar_name))
		self.right_name:ignoreContentAdaptWithSize(true)
		self.right_name:setTextAreaSize(cc.size(125,0))
		setTextSpacing(self.left_name,-10)
		setTextSpacing(self.right_name,-10)
		if self.data.is_win == 1 then
            self.left_success_img:loadTexture(PathTool.getResFrame("common", "txt_cn_common_90012"), LOADTEXT_TYPE_PLIST)
			self.right_success_img:loadTexture(PathTool.getResFrame("common", "txt_cn_common_90013"), LOADTEXT_TYPE_PLIST)
        else
            self.left_success_img:loadTexture(PathTool.getResFrame("common", "txt_cn_common_90013"), LOADTEXT_TYPE_PLIST)
			self.right_success_img:loadTexture(PathTool.getResFrame("common", "txt_cn_common_90012"), LOADTEXT_TYPE_PLIST)
        end
		if self.data.is_win == 1 then
			self.fight_type:setString(TI18N("语言_c_3850"))
		else
			self.fight_type:setString(TI18N("语言_c_3849"))
		end
		local nowtime = data.challenge_time or 0
		local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
		local H = TimeTool.xsdate("%H",nowtime,timezone)
		local M = TimeTool.xsdate("%M",nowtime,timezone)
		local S = TimeTool.xsdate("%S",nowtime,timezone)
		local y = TimeTool.xsdate("%Y",nowtime,timezone)
		local m = TimeTool.xsdate("%m",nowtime,timezone)
		local d = TimeTool.xsdate("%d",nowtime,timezone)
		local str = "%s-%s-%s %s:%s:%s"
		str = string.format(str,y,m,d,H,M,S)
        self.time:setString(str)
		if data.replay_id == 0 then
			self.check_fight_btn:setVisible(false)
		else
			self.check_fight_btn:setVisible(true)
		end
	end
end

function ActionLostTowerBattleReportItem:DeleteMe(  )
	if self.left_head then
		self.left_head:DeleteMe()
		self.left_head = nil
	end
	if self.right_head then
		self.right_head:DeleteMe()
		self.right_head = nil
	end
	self:removeAllChildren()
	self:removeFromParent()
end