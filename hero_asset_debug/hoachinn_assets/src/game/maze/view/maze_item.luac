end

function MazeItem:generateData(data)
	self.id = data.id
	self.round_point = data.round_point
	self.maze_type = data.maze_type
	self.is_walk = data.is_walk
	self.combat_power = data.combat_power
	self.is_sneak = data.is_sneak
	self.is_fight = data.is_fight
	self.chest_id = data.chest_id or 0
	self.is_open = false
	self.floor = 1
	-- 没数据临时屏蔽
	local mazeData = _model:getMazeData()
	if mazeData then
		self.floor = mazeData.floor
	end
end

function MazeItem:setData(data)
	self:generateData(data)
	self:updateBaseView()
end
 
function MazeItem:updateBaseView()
	self.maze_bg:setVisible(false)
	self.has_fight_img:setVisible(false)
	self.is_fight_img:setVisible(false)
	self.power_bg:setVisible(false)
	self.power_name:setVisible(false)
	self.fight_btn:setVisible(false)
	self.node_effect:setVisible(false)
	self.node_click:setVisible(false)
	self.box_click:setVisible(false)
	self.sbox_click:setVisible(false)
	local config = Config.MazeData
	local sneak_attack_arr = config.data_const["sneak_attack_dec"].val
	local raid_level = config.data_const["raid_level"].val
	local raid_vip = config.data_const["raid_vip"].val
	local role_lev = RoleController:getInstance():getRoleVo().lev or 0
	local role_vip = RoleController:getInstance():getRoleVo().vip_lev or 0
	local map_info = config.data_map_info[self.id]
	local power = self.combat_power
	if self.is_sneak > 0 then
		local sneak_attack = sneak_attack_arr[self.is_sneak]
		power = math.floor((1 - sneak_attack * 0.001) * self.combat_power)
	end
	
	if self.maze_type == MazeConst.Dun_Type.StartPoint then -- 起始点
		self.maze_bg:setVisible(true)
		setChildUnEnabled(false,self)
	elseif self.maze_type == MazeConst.Dun_Type.FightPrint then -- 战斗点
		self.node_effect:setVisible(true)
		self.node_click:setVisible(true)
		self.maze_bg:setVisible(true)
		if self.spine_model then
			self.spine_model:removeFromParent()
			self.spine_model = nil
		end
		self.node_effect:removeAllChildren()
		if map_info then
			local building = map_info.res_unit[self.floor]
			self.spine_model = createSpineByName(building, PlayerAction.action)
			self.spine_model:setPosition(20,50)
			self.node_effect:addChild(self.spine_model)
			self.spine_model:setAnimation(0, PlayerAction.action, true)
		end
		self.is_open = _model:checkPointIsOpen(self.floor,self.id)
		if self.is_open then -- 可攻打
			setChildUnEnabled(false,self)
			if self.is_walk == 0 then -- 未打过
				if role_lev >= raid_level or role_vip >= raid_vip then
					self.fight_btn:setVisible(true)
				end
				self.power_bg:setVisible(true)
				self.power_name:setVisible(true)
				self.power_name:setString(MoneyTool.moneyFormat(power))
				self.is_fight_img:setVisible(self.is_fight == 1) -- 正在攻打（攻打过并打输了）
			else -- 已经打过
				self.has_fight_img:setVisible(true)
				setChildUnEnabled(true,self)
				setChildUnEnabled(false,self.has_fight_img)
			end
		else -- 未解锁不可打
			setChildUnEnabled(true,self)
		end
	elseif self.maze_type == MazeConst.Dun_Type.RandomBox then --随机宝箱
		self.node_effect:setVisible(true)
		self.sbox_click:setVisible(true)
		self.is_open = _model:checkBoxCanGet(self.floor,self.id)
		local box_info = config.data_award[self.chest_id]
		if self.spine_model then
			self.spine_model:removeFromParent()
			self.spine_model = nil
		end
		self.node_effect:removeAllChildren()
		if box_info and self.chest_id and self.chest_id ~= 0  then
			local building = box_info.res
			self.spine_model = createSpineByName(building, PlayerAction.action)
			self.spine_model:setPosition(40,40)
			self.node_effect:addChild(self.spine_model)
			if self.is_open then -- 可以领取
				if self.is_walk == 0 then -- 没领过
					setChildUnEnabled(false,self)
					self.spine_model:setAnimation(0, PlayerAction.action_2, true)
				else --已领取
					setChildUnEnabled(false,self)
					self.spine_model:setAnimation(0, PlayerAction.action_3, true)
				end
			else -- 不可领取
				self.spine_model:setAnimation(0, PlayerAction.action_1, true)
				setChildUnEnabled(false,self)
			end
		end
	elseif self.maze_type == MazeConst.Dun_Type.GiftBox then --最终宝箱
		self.node_effect:setVisible(true)
		self.box_click:setVisible(true)
		self.is_open = _model:checkBoxCanGet(self.floor,self.id)
		if self.spine_model then
			self.spine_model:removeFromParent()
			self.spine_model = nil
		end
		self.node_effect:removeAllChildren()
		local data_diff_info = config.data_diff_info[self.floor]
		if data_diff_info then
			local maze_reward = data_diff_info.maze_reward
			if self.is_open then -- 可以领取
				if self.is_walk == 0 then -- 没领过
					self.spine_model = createSpineByName(maze_reward, PlayerAction.action)
					self.spine_model:setPosition(0,0)
					self.node_effect:addChild(self.spine_model)
					setChildUnEnabled(false,self)
					self.spine_model:setAnimation(0, PlayerAction.action_2, true)
				else --已领取
					if self.floor < Config.MazeData.data_diff_info_length then
						self.spine_model = createSpineByName("E27531", PlayerAction.action)
						self.spine_model:setScale(0.7, 0.7)
						self.spine_model:setPositionY(0)
						self.node_effect:addChild(self.spine_model)
						self.spine_model:setAnimation(0, PlayerAction.action_1, true)
					else
						self.spine_model = createSpineByName(maze_reward, PlayerAction.action)
						self.spine_model:setScale(1, 1)
						self.spine_model:setPositionY(0)
						self.node_effect:addChild(self.spine_model)
						self.spine_model:setAnimation(0, PlayerAction.action_3, true)
						setChildUnEnabled(false,self)
					end
					-- self.spine_model:setAnimation(0, PlayerAction.action_3, true)
					-- self.has_fight_img:setVisible(true)
					-- setChildUnEnabled(true,self)
					-- setChildUnEnabled(false,self.has_fight_img)
				end
			else -- 不可领取
				self.spine_model = createSpineByName(maze_reward, PlayerAction.action)
				self.spine_model:setPositionY(0)
				self.node_effect:addChild(self.spine_model)
				self.spine_model:setAnimation(0, PlayerAction.action_1, true)
				setChildUnEnabled(false,self)
			end
		end
	else	--随机宝箱（该点位没刷到）
		self.maze_bg:setVisible(false)
		self.has_fight_img:setVisible(false)
		self.is_fight_img:setVisible(false)
		self.power_bg:setVisible(false)
		self.power_name:setVisible(false)
		self.fight_btn:setVisible(false)
		self.node_effect:setVisible(false)
		self.node_click:setVisible(false)
		self.box_click:setVisible(false)
		self.sbox_click:setVisible(false)
	end

	-- self.node_boss:setVisible(self.dun_type == MazeConst.Dun_Type.MazeConst)
	-- if self.dun_type == MazeConst.Dun_Type.Boss then
	-- 	self.main_panel:setContentSize(cc.size(120, 220))
