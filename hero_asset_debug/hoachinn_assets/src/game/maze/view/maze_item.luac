	registerButtonEventListener(self.sbox_click, function ()
		if self.click == false then return end
		if _model.is_saodang == true then return end
		local mazeData = _model:getMazeData()
		if mazeData then
			self.floor = mazeData.floor
		end
		if self.chest_id and self.chest_id ~= 0  then
			if self.is_open then -- 可以领取
				if self.is_walk == 0 then -- 没领过
					MazeController:getInstance():openMazeBoxPanel(true,self.chest_id,self.id,self.is_open,self.is_walk)
					-- MazeController:getInstance():sender30300(self.id, {}, false, 0)
				else --已领取
				end
			else -- 不可领取
				MazeController:getInstance():openMazeBoxPanel(true,self.chest_id,self.id,self.is_open,self.is_walk)
			end
		end
	end, true, 1)

	registerButtonEventListener(self.box_click, function ()
		if self.click == false then return end
		if _model.is_saodang == true then return end
		local mazeData = _model:getMazeData()
