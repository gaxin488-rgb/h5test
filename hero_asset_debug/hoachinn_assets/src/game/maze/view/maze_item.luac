local _controller = MazeController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

MazeItem = class("MazeItem", function()
    return ccui.Widget:create()
end)

function MazeItem:ctor()
	self:configUI()
	self:register_event()
end

function MazeItem:configUI( )
	local csbPath = PathTool.getTargetCSB("maze/maze_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local main_panel = self.root_wnd:getChildByName("main_panel")
	self.main_panel = main_panel
	self.main_panel:setTouchEnabled(false)

	self.maze_bg = self.main_panel:getChildByName("maze_bg")
	self.node_effect = self.main_panel:getChildByName("node_effect")
	self.node_click = self.main_panel:getChildByName("node_click")
	self.node_click:setVisible(false)
	self.box_click = self.main_panel:getChildByName("box_click")
	self.box_click:setVisible(false)
	self.sbox_click = self.main_panel:getChildByName("sbox_click")
	self.sbox_click:setVisible(false)
	self.power_bg = self.main_panel:getChildByName("power_bg")
	self.power_name = self.main_panel:getChildByName("power_name")
	self.power_name:setString("0")
	setTextBg(self.power_name,self.power_bg,90)
	
	self.has_fight_img = self.main_panel:getChildByName("has_fight_img")
	self.is_fight_img = self.main_panel:getChildByName("is_fight_img")
	self.fight_btn = self.main_panel:getChildByName("fight_btn")
	self.fight_btn:setTouchEnabled(true)
	self.fight_label = self.fight_btn:getChildByName("fight_label")
	self.fight_label:setString(TI18N("语言_c_6847"))
	setTextBg(self.fight_label,self.fight_btn, 120,-10,28)
	self:setSwallowTouches(false)
	self.node_click:setSwallowTouches(false)
	self.box_click:setSwallowTouches(false)
	self.sbox_click:setSwallowTouches(false)
end

function MazeItem:register_event(  )
	registerButtonEventListener(self.fight_btn, function ()
		if _model.is_saodang == true then return end
		local mazeData = _model:getMazeData()
		if mazeData and mazeData.fight_count then
			if mazeData.fight_count <= 0 then
				message(TI18N("语言_c_6846"))
				return
			end
		end
		_controller:openMazeAlert(true,self.id)
		-- _model.is_saodang = true
		-- GlobalEvent:getInstance():Fire(MazeEvent.MOVE_ROLE,{id = self.id})
	end, true, 1)
	self:setTouchEnabled(true)
	self.click = true
	self:addTouchEventListener(function(sender, event_type) 
		if event_type == ccui.TouchEventType.ended then
			self.touch_end = sender:getTouchEndPosition()
			if self.touch_began ~= nil then
				self.click =
					math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
					math.abs(self.touch_end.y - self.touch_began.y) <= 20
			end
		elseif event_type == ccui.TouchEventType.began then
			self.touch_began = sender:getTouchBeganPosition()
		end
	end)
	registerButtonEventListener(self.node_click, function ()
		if self.click == false then return end
		if _model.is_saodang == true then return end
		local mazeData = _model:getMazeData()
		if mazeData then
			self.floor = mazeData.floor
		end
		if self.maze_type == MazeConst.Dun_Type.StartPoint then -- 起始点
		elseif self.maze_type == MazeConst.Dun_Type.FightPrint then -- 战斗点
			self.is_open = _model:checkPointIsOpen(self.floor,self.id)
			if self.is_open then -- 可攻打
				if mazeData and mazeData.fight_count then
					if mazeData.fight_count <= 0 then
						message(TI18N("语言_c_6846"))
						return
					end
				end
				if self.is_walk == 0 then -- 未打过
					GlobalEvent:getInstance():Fire(MazeEvent.MOVE_ROLE,{id = self.id})
					-- _controller:openMazeDes(true,self.id)
				else -- 已经打过
				end
			else -- 未解锁不可打
			end
		-- elseif self.maze_type == MazeConst.Dun_Type.RandomBox then --随机宝箱
		-- 	if self.chest_id and self.chest_id ~= 0  then
		-- 		if self.is_open then -- 可以领取
		-- 			if self.is_walk == 0 then -- 没领过
