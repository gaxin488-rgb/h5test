		-- 				-- MazeController:getInstance():sender30300(self.id, {}, false, 0)
		-- 			else --已领取
		-- 			end
		-- 		else -- 不可领取
		-- 			MazeController:getInstance():openMazeBoxPanel(true,self.chest_id,self.id,self.is_open,self.is_walk)
		-- 		end
		-- 	end
		-- elseif self.maze_type == MazeConst.Dun_Type.GiftBox then --最终宝箱
		-- 	if self.is_open then -- 可以领取
		-- 		if self.is_walk == 0 then -- 没领过
		-- 			MazeController:getInstance():openMazeBoxPanel(true,0,self.id,self.is_open,self.is_walk,self.floor)
		-- 			-- MazeController:getInstance():sender30300(self.id, {}, false, 0)
		-- 		else --已领取
		-- 			if _model:checkBoxAllGet(self.floor) then
		-- 				if self.floor < Config.MazeData.data_diff_info_length then
		-- 					MazeController:getInstance():sender30304()
		-- 				end
		-- 			else
		-- 				local function call_back()
		-- 					MazeController:getInstance():sender30309()
		-- 				end
		-- 				local str = TI18N("语言_maze_01_9")
		-- 				CommonAlert.show(str, TI18N("语言_c_63"), call_back, TI18N("语言_c_62"))
		-- 			end
		-- 		end
		-- 	else -- 不可领取
		-- 		MazeController:getInstance():openMazeBoxPanel(true,0,self.id,self.is_open,self.is_walk,self.floor)
		-- 	end
		else	--随机宝箱（该点位没刷到）
			self.maze_bg:setVisible(false)
			self.has_fight_img:setVisible(false)
			self.is_fight_img:setVisible(false)
			self.power_bg:setVisible(false)
			self.power_name:setVisible(false)
			self.fight_btn:setVisible(false)
			self.node_effect:setVisible(false)
			self.node_click:setVisible(false)
			self.box_click:setVisible(false)
