				-- MazeController:getInstance():sender30300(self.id, {}, false, 0)
			else --已领取
				if _model:checkBoxAllGet(self.floor) then
					if self.floor and self.floor < Config.MazeData.data_diff_info_length then
						MazeController:getInstance():sender30304()
					end
				else
					local function call_back()
						MazeController:getInstance():sender30309()
						if self.floor and self.floor < Config.MazeData.data_diff_info_length then
							MazeController:getInstance():sender30304()
						end
					end
					local str = TI18N("语言_maze_01_9")
					CommonAlert.show(str, TI18N("语言_c_63"), call_back, TI18N("语言_c_62"))
				end
			end
		else -- 不可领取
			MazeController:getInstance():openMazeBoxPanel(true,0,self.id,self.is_open,self.is_walk,self.floor)
		end
		
		
