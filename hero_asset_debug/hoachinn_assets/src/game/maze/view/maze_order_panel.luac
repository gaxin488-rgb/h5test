MazeOrderPanel = class("MazeOrderPanel", function()
    return ccui.Layout:create()
end)

function MazeOrderPanel:ctor(ctrl)
    self.ctrl = MazeController:getInstance()
    self.model = self.ctrl:getModel()
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("maze/maze_order_panel"))
    self:addChild(self.root_wnd)

    self.container = self.root_wnd:getChildByName("container")
    self.tab_bg1 = self.container:getChildByName("tab_bg1")
    self.tab_bg1_label = self.tab_bg1:getChildByName("tab_label")
    self.tab_bg1_label:setString(TI18N("语言_c_6869"))
    self.tab_bg2 = self.container:getChildByName("tab_bg2")
    self.tab_bg2_label = self.tab_bg2:getChildByName("tab_label")
    self.tab_bg2_label:setString(TI18N("语言_c_6850"))
    self.tab_bg3 = self.container:getChildByName("tab_bg3")
    self.tab_bg3_label = self.tab_bg3:getChildByName("tab_label")
    self.tab_bg3_label:setString(TI18N("语言_c_6851"))
    self.tab_bg3_btn_lock = self.tab_bg3:getChildByName("btn_lock")
    self.tab_bg3_btn_lock:setVisible(true)

    self.btn_open_lock = self.container:getChildByName("btn_open_lock")
    self.btn_open_lock_name = self.btn_open_lock:getChildByName("name")
    self.btn_open_lock_name:setString(TI18N("语言_c_2680"))

    self.time_bg = self.container:getChildByName("time_bg")
    self.time_tip = self.time_bg:getChildByName("time_tip")
    self.time_tip:setString(TI18N("语言_c_6166"))
    self.time_label = self.time_bg:getChildByName("time_label")

    self.item_icon = self.container:getChildByName("item_icon")
    self.item_icon:setScale(0.5, 0.5)
    self.item_num = self.container:getChildByName("item_num")
    self.item_panel = self.container:getChildByName("item_panel")
    self.btn_rule = self.container:getChildByName("btn_rule")
    self.reward_cfg = Config.MazeData.data_war_order
end

