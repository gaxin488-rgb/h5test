    end, true)
    registerButtonEventListener(self.btn_con, function()
        -- GlobalEvent:getInstance():Fire(MazeEvent.Maze_Order_Con_Event)
        if self.rmb_status == 1 then -- 战令激活
            if self.rmb_award_status == 0 then -- 进阶奖励未领取
