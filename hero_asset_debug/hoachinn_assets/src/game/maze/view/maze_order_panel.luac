            --         local charge_data = Config.ChargeData.data_charge_data[charge_id]
            --         if charge_data then
            --             sdkOnPay(charge_data.val, nil, charge_data.id, charge_data.name)
            --         else
            --             message("error")
            --         end
            --     end
            -- end
            -- local str = TI18N("语言_c_6469")
            -- CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, nil,
            --     nil, true)
        end
    end, true)
end

function MazeOrderItem:setData(data, index)
    --  {uint32, start_time, "开始时间"}
    -- ,{uint32, end_time, "结束时间"}
    -- ,{uint32, score, "积分"}
    -- ,{uint8, rmb_status, "是否激活特权"}
    -- ,{array, tuple, list, "奖励列表", [
    --     {uint32,    id,  "ID"}
    --     ,{uint8,    award_status,  "普通奖励领取状态（0：未领取，1：已领取）"}
    --     ,{uint8,    rmb_award_status, "进阶奖励领取状态（0：未领取，1：已领取）"}
    -- ]}
    self.rewardData = data
    local order_data = self.model:getOrderData()
    self.order_data_score = order_data.score
    self.rmb_status = order_data.rmb_status
    self.order_list = order_data.list
    self.award_status = 0 -- 普通奖励领取状态（0：未领取，1：已领取）
    self.rmb_award_status = 0 -- "进阶奖励领取状态（0：未领取，1：已领取）
    for i, v in pairs(self.order_list) do
        if v.id == self.rewardData.id then
            self.award_status = v.award_status
            self.rmb_award_status = v.rmb_award_status
            break
        end
    end
    self.index = index
    self.need_num = self.rewardData.score
    self.title:setString(string.format(TI18N("语言_c_6174"), self.need_num, self.order_data_score))
    local list = {}
    for index, value in ipairs(self.rewardData.reward) do
        table.insert(list, index, value)
    end
    for key, value in pairs(self.item_list) do
        value:DeleteMe()
        value = nil
    end
    self.item_list = {}
    local scale_num = 0.7
    for key, value in pairs(list) do
        local item = BackPackItem.new(true, true, false, scale_num)
        item:setBaseData(value[1], value[2])
        table.insert(self.item_list, item)
        self.free_layer:addChild(item)
        item:setDefaultTip(true, false)
    end
    if tableLen(self.item_list) == 1 then
        self.free_layer:setTouchEnabled(false)
    else
        self.free_layer:setTouchEnabled(true)
    end
    local list_num = 5
    local _w = self.free_layer:getContentSize().width
    local row_y = math.ceil(tableLen(self.item_list) / list_num)
    local _h = math.max(self.free_layer:getContentSize().height, row_y * BackPackItem.Height * scale_num)
    self.free_layer:setInnerContainerSize(cc.size(_w, _h))
    for key, value in pairs(self.item_list) do
        local _x = (119 * scale_num + 10) * key - (119 * scale_num * 0.5)
        local _y = self.free_layer:getContentSize().height * 0.5
        value:setPosition(cc.p(_x, _y))
    end

    local scale_num2 = 0.7
    local list2 = {}
    for index, value in ipairs(self.rewardData.rmb_reward) do
        table.insert(list2, index, value)
    end
    for key, value in pairs(self.item_list2) do
        value:DeleteMe()
        value = nil
    end
    self.item_list2 = {}
    for key, value in pairs(list2) do
        local item = BackPackItem.new(true, true, false, scale_num2)
        item:setBaseData(value[1], value[2])
        table.insert(self.item_list2, item)
        self.goods_con:addChild(item)
        item:setDefaultTip(true, false)

    end
    if tableLen(self.item_list2) <= 2 then
        self.goods_con:setTouchEnabled(false)
    else
        self.goods_con:setTouchEnabled(true)
    end
    local list_num = 5
    local _w = math.max(self.goods_con:getContentSize().width, tableLen(self.item_list2) * 129 * scale_num2)
    local _h = self.goods_con:getContentSize().height
    self.goods_con:setInnerContainerSize(cc.size(_w, _h))
    for key, value in pairs(self.item_list2) do
        local _x = (119 * scale_num2 + 10) * key - (119 * scale_num2 * 0.5)
        local _y = self.goods_con:getContentSize().height * 0.5
        value:setPosition(cc.p(_x, _y))
    end

    self.btn_get:setVisible(false)
    setChildUnEnabled(true, self.btn_get)
    self.btn_get:setTouchEnabled(false)
    self.buy_img:setVisible(false)
    self.btn_con:setVisible(false)
    setChildUnEnabled(false, self.btn_con)
    self.btn_con:setTouchEnabled(true)
    self.btn_go:setVisible(false)

    for key, value in pairs(self.item_list2) do
        value:showOrderWarLock(self.rmb_status == 0)
    end

    if self.order_data_score >= self.need_num then -- 积分已满足
        if self.award_status == 0 then -- 普通未领取
            self.btn_get:setVisible(true)
            setChildUnEnabled(false, self.btn_get)
            self.btn_get:setTouchEnabled(true)
            self.btn_go:setVisible(false)
        else -- 普通已领取
            if self.rmb_status == 1 then -- 战令激活
                if self.rmb_award_status == 0 then -- 进阶奖励未领取
                    self.btn_con:setVisible(true)
                    setChildUnEnabled(false, self.btn_con)
                    self.btn_con:setTouchEnabled(true)
                else -- 进阶奖励已领取
                    self.buy_img:setVisible(true)
                end
                self.btn_go:setVisible(false)
            else -- 战令未激活
                self.btn_con:setVisible(true)
                setChildUnEnabled(false, self.btn_get)
                self.btn_con:setTouchEnabled(true)
                self.btn_go:setVisible(false)
            end
        end
    else -- 积分不满足
        self.btn_get:setVisible(false)
        setChildUnEnabled(true, self.btn_get)
        self.btn_get:setTouchEnabled(false)
        self.btn_go:setVisible(true)
    end
end

function MazeOrderItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end

