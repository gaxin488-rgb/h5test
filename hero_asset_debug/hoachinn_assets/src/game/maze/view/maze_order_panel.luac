-- 滑动的时候处理显示
function MazeOrderPanel:updateSlideShowByVertical()
    local container_y = self.reward_list:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end
-- 奖励列表
function MazeOrderPanel:createTaskCell()
    local cell = MazeOrderItem.new()
    return cell
end

function MazeOrderPanel:numberOfTaskCells()
    if not self.reward_cfg then
        return 0
    end
    return #self.reward_cfg
end

function MazeOrderPanel:updateTaskCellByIndex(cell, index)
    if not self.reward_cfg then
        return
    end
    local cell_data = self.reward_cfg[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data, index)
end

-- 进度条
-- 功勋数数列表
function MazeOrderPanel:createTaskCell2()
    local cell = MazeOrderLineItem.new()
    return cell
end

function MazeOrderPanel:numberOfTaskCells2()
    if not self.reward_cfg then
        return 0
    end
    return #self.reward_cfg
end

function MazeOrderPanel:updateTaskCellByIndex2(cell, index)
    if not self.reward_cfg then
        return
    end
    local cell_data = self.reward_cfg[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data, index)
end

function MazeOrderPanel:setRewardPanel()
    if self.reward_list == nil then
        local scroll_view_size = self.item_panel:getContentSize()
        local setting = {
            start_x = 0,
            space_x = 0,
            start_y = 5,
            space_y = 4,
            item_width = 650,
            item_height = 124,
            row = 0,
            col = 1,
            need_dynamic = true,
            checkovercallback = handler(self, self.updateSlideShowByVertical)
        }
        self.reward_list = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,
            ScrollViewStartPos.top, scroll_view_size, setting)
        self.reward_list:setSwallowTouches(true)
        self.reward_list:registerScriptHandlerSingle(handler(self, self.createTaskCell),
            ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_list:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),
            ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_list:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),
            ScrollViewFuncType.UpdateCellByIndex) -- 更新cell

        -- 进度条相关
        local scroll_view_size2 = cc.size(100, scroll_view_size.height)
        local setting = {
            start_x = 10, -- 第一个单元的X起点
            space_x = 0, -- x方向的间隔
            start_y = 5, -- 第一个单元的Y起点
            space_y = 4, -- y方向的间隔
            item_width = 55, -- 单元的尺寸width
            item_height = 124, -- 单元的尺寸height
            row = 0, -- 行数，作用于水平滚动类型
            col = 1, -- 列数，作用于垂直滚动类型
            need_dynamic = true
        }
        self.reward_num_item = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,
            ScrollViewStartPos.top, scroll_view_size2, setting)
        self.reward_num_item:setClickEnabled(false)
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),
            ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),
            ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),
            ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    end
    self.reward_list:reloadData(nil, nil, true)
    self.reward_num_item:reloadData(nil, nil, true)
    self:setChangeLevelStatus()
end

function MazeOrderPanel:setChangeLevelStatus()
    local order_data = self.model:getOrderData()
    local title_pos = 1
    local order_status = order_data.rmb_status
    local data_war_order = deepCopy(Config.MazeData.data_war_order)
    local sort_func = SortTools.tableCommonSorter({{"id", false}})
    table.sort(data_war_order, sort_func)
    for i, v in pairs(data_war_order) do
        if order_data.list[v.id] then
            if order_status == 1 then--战令已经解锁
                if order_data.list[v.id].award_status == 0 or order_data.list[v.id].rmb_award_status == 0 then
                    title_pos = v.id
                    break
                end
            else
                if order_data.list[v.id].award_status == 0 then
                    title_pos = v.id
                    break
                end
            end
        else
            title_pos = v.id
            break
        end
    end
    self:jumpToMoveByY(124 * (title_pos - 1))
end

function MazeOrderPanel:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_cfg or 1
    local scroll_view_size = self.item_panel:getContentSize()
    local pos_per = pos * 100 / (len * 124 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_list:scrollToPercentVertical(pos_per, 0.5, true)
end

-- 事件
function MazeOrderPanel:registerEvent(status)
    if not status then
        if self.update_order_list then
            GlobalEvent:getInstance():UnBind(self.update_order_list)
            self.update_order_list = nil
        end

        -- if self.maze_order_con_event then
        --     self.maze_order_con_event = GlobalEvent:getInstance():Bind(MazeEvent.Maze_Order_Con_Event, function ()
        --         GlobalEvent:getInstance():UnBind(self.maze_order_con_event)
        --         self.maze_order_con_event = nil
        --     end)
        -- end
    else
        if not self.update_order_list then
            self.update_order_list = GlobalEvent:getInstance():Bind(MazeEvent.UpdateOrderList, function()
                self:updateOrderList()
            end)
        end

        registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
            TipsManager:getInstance():showCommonTips(TI18N("语言_maze_01_11"), sender:getTouchBeganPosition(), nil, nil, 500)
        end, false, 1)

        registerButtonEventListener(self.btn_open_lock, function()
            self:clickBuyBtn()
        end, false, 2)

        -- if not self.maze_order_con_event then
        --     self.maze_order_con_event = GlobalEvent:getInstance():Bind(MazeEvent.Maze_Order_Con_Event, function ()
        --         self:clickBuyBtn()
        --     end)
        -- end
    end
end

function MazeOrderPanel:updateOrderList()
    -- {uint32, start_time, "开始时间"}
    -- ,{uint32, end_time, "结束时间"}
    -- ,{uint32, score, "积分"}
    -- ,{uint8, rmb_status, "是否激活特权"}
    -- ,{array, tuple, list, "奖励列表", [
    --     {uint32,    id,  "ID"}
    --     ,{uint8,    award_status,  "普通奖励领取状态（0：未领取，1：已领取）"}
    --     ,{uint8,    rmb_award_status, "进阶奖励领取状态（0：未领取，1：已领取）"}
    -- ]}
    local data_war_order = Config.MazeData.data_war_order
    local order_data = self.model:getOrderData()
    local end_time = order_data.end_time
    local list = {}
    ActionController:getInstance():getModel():setCountDownTime(self.time_label,
        end_time - GameNet:getInstance():getTime())
    local status = order_data.rmb_status
    if status == 1 then -- 已激活
        self.tab_bg3_btn_lock:setVisible(false)
        setChildUnEnabled(true, self.btn_open_lock)
        self.btn_open_lock:setTouchEnabled(false)
    else
        self.tab_bg3_btn_lock:setVisible(true)
        setChildUnEnabled(false, self.btn_open_lock)
        self.btn_open_lock:setTouchEnabled(true)
    end

    local order_item = Config.MazeData.data_const["order_item"].val
    local item_config = Config.ItemData.data_get_data(order_item)
    if item_config then
        local res = PathTool.getItemRes(item_config.icon)
        loadSpriteTexture(self.item_icon, res, LOADTEXT_TYPE)
    end
    self.item_num:setString(order_data.score)
    self:setRewardPanel()
end

function MazeOrderPanel:setVisibleStatus(bool)
    self:setVisible(bool)
    self:registerEvent(bool)
end

function MazeOrderPanel:DeleteMe()
    if self.reward_list then
        self.reward_list:DeleteMe()
        self.reward_list = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.update_order_list then
        GlobalEvent:getInstance():UnBind(self.update_order_list)
        self.update_order_list = nil
    end
end

