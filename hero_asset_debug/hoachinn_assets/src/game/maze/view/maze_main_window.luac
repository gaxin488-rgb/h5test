-- --------------------------------------------------------------------
-- 地下迷宫任务成就战令总界面
-- --------------------------------------------------------------------
MazeMainWindow = MazeMainWindow or BaseClass(BaseView)

function MazeMainWindow:__init(extend_id)
    self.ctrl = MazeController:getInstance()
    self.is_full_screen = false
    self.title_str = TI18N("语言_c_1811")
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planesafkorderaction","planesafkorderaction"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("maze","maze"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("maze","txt_cn_maze_order_1"), type = ResourcesType.single},
	}
    self.layout_name = "maze/maze_main_panel"
    self.extend_id = extend_id
    self.win_type = WinType.Big  
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.btn_list = {}
    self.view_list = {}
    self.select_btn = nil
end

function MazeMainWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 1)
    local main_panel = main_container:getChildByName("main_panel")
    
    self.container = main_panel:getChildByName("container")
    self.close_btn = main_panel:getChildByName("close_btn")
    local Image_2 = main_panel:getChildByName("Image_2")
    local win_title = main_panel:getChildByName("win_title")
    win_title:setString(TI18N("语言_maze_1"))
    Image_2:setContentSize(cc.size(win_title:getContentSize().width + 120,63))
    local tab_container = main_panel:getChildByName("tab_container")
    local list = {[1]=TI18N("语言_c_6838"),[2]=TI18N("语言_c_6839"),[3]=TI18N("语言_c_6840")}
    for i=1,3 do
        local btn = tab_container:getChildByName("tab_btn_"..i)
        if btn then 
            local tab = {}
            tab.btn = btn
            tab.select_bg = btn:getChildByName("select_bg")
            tab.select_bg:setVisible(false)
            tab.title =  btn:getChildByName("title")
            tab.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
            tab.red_point = btn:getChildByName("tab_tips")
            tab.red_point:setVisible(false)
            if i == 1 then --日常红点
                local is_red = false 
                is_red = MazeController:getInstance():getModel():getTaskRedPoint()
                tab.red_point:setVisible(is_red)
                tab.red_status = is_red
            elseif i == 2 then --成就红点
                local is_red = false 
                is_red = MazeController:getInstance():getModel():getAchieveRedPoint()
                tab.red_point:setVisible(is_red)
                tab.red_status = is_red
            elseif i == 3 then --战令红点
                local is_red = false 
                is_red = MazeController:getInstance():getModel():getOrderRedPoint()
               -- debug_Print("is_red",is_red)
                tab.red_point:setVisible(is_red)
                tab.red_status = is_red
            end
            local str = list[i] or ""
            tab.title:setString(str)
            tab.index = i

            self.btn_list[i] = tab
            btn:addTouchEventListener(function(sender, event_type) 
                if event_type == ccui.TouchEventType.ended then
                    playButtonSound2()
                    self:changeTabIndex(i)
                end
            end)
        end
    end
end

function MazeMainWindow:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            MazeController:getInstance():openMazeMainWindow(false)
        end 
    end)

    registerButtonEventListener(self.close_btn, function()
        playCloseSound()
        MazeController:getInstance():openMazeMainWindow(false)
    end, true, 2)



    if self.update_order_red_status_event == nil then
        self.update_order_red_status_event = GlobalEvent:getInstance():Bind(MazeEvent.Update_Maze_Order_RedStatus, function(type) 
            local is_red = MazeController:getInstance():getModel():getOrderRedPoint()
            self:updateOrderRedStatus(is_red)
		end)
	end
    if self.update_task_red_status_event == nil then
        self.update_task_red_status_event = GlobalEvent:getInstance():Bind(MazeEvent.Update_Maze_Task_RedStatus, function(type) 
            local is_red = MazeController:getInstance():getModel():getTaskRedPoint()
            self:updateTaskRedStatus(is_red)
		end)
	end
    if self.update_daily_red_status_event == nil then
        self.update_daily_red_status_event = GlobalEvent:getInstance():Bind(MazeEvent.Update_Maze_Daily_RedStatus, function(type) 
            local is_red = MazeController:getInstance():getModel():getAchieveRedPoint()
            self:updateDailyRedStatus(is_red)
		end)
	end
end

function MazeMainWindow:updateDailyRedStatus(status)
    if self.btn_list and self.btn_list[2] then
        local btn = self.btn_list[2]
        btn.red_point:setVisible(status)
        btn.red_status = status
    end
end

function MazeMainWindow:updateTaskRedStatus(status)
    if self.btn_list and self.btn_list[1] then
        local btn = self.btn_list[1]
        btn.red_point:setVisible(status)
        btn.red_status = status
    end
end

function MazeMainWindow:updateOrderRedStatus(status)
    if self.btn_list and self.btn_list[3] then
        local btn = self.btn_list[3]
        btn.red_point:setVisible(status)
        btn.red_status = status
    end
end

function MazeMainWindow:changeTabIndex(index)
    if self.select_btn and self.select_btn.index == index then return end
    if self.select_btn then 
        self.select_btn.select_bg:setVisible(false)
        self.select_btn.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
    end
    if self.pre_panel then 
        self.pre_panel:setVisibleStatus(false)
    end
    self.pre_panel = self:createSubPanel(index)
    self.select_btn = self.btn_list[index] 
    if self.select_btn then 
        self.select_btn.select_bg:setVisible(true)
        self.select_btn.title:setTextColor(cc.c4b(0xff, 0xed, 0xd6, 0xff))
    end
    if self.pre_panel then 
        self.pre_panel:setVisibleStatus(true)
    end
    if self.select_btn then
        if self.select_btn.index == 1 then 
            self.ctrl:sender30313()
        elseif self.select_btn.index == 2 then 
            self.ctrl:sender30319()
        elseif self.select_btn.index == 3 then 
            self.ctrl:sender30317()
        end
    end
end

function MazeMainWindow:createSubPanel(index)
    local panel = self.view_list[index]
    local size = self.container:getContentSize()
    if panel == nil then
        if index == 1 then
            panel = MazeTaskPanel.new()
            panel:setPosition(cc.p(15,100))
        elseif index == 2 then
            panel = MazeFeatPanel.new()
            panel:setPosition(cc.p(15,100))
        elseif index == 3 then
            panel = MazeOrderPanel.new()
            panel:setPosition(cc.p(0,90))
        end
        self.container:addChild(panel)
        self.view_list[index] = panel
    end
    return panel
end

function MazeMainWindow:openRootWnd(index,data)
    self.data = data
    index = index or 1
    self:changeTabIndex(index)
end

function MazeMainWindow:close_callback()
    if self.update_task_red_status_event then
        GlobalEvent:getInstance():UnBind(self.update_task_red_status_event)
        self.update_task_red_status_event = nil
    end
    if self.update_order_red_status_event then
        GlobalEvent:getInstance():UnBind(self.update_order_red_status_event)
        self.update_order_red_status_event = nil
    end
    if self.update_daily_red_status_event then
        GlobalEvent:getInstance():UnBind(self.update_daily_red_status_event)
        self.update_daily_red_status_event = nil
    end
    for i,v in pairs(self.view_list) do 
        v:DeleteMe()
    end
    self.view_list = nil
    MazeController:getInstance():openMazeMainWindow(false)
end
