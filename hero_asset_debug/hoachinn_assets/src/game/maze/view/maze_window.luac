MazeWindow = MazeWindow or BaseClass(BaseView)

function MazeWindow:__init()
    self.is_full_screen = true
    self.layout_name = "maze/maze_window"
    self.win_type = WinType.Full
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("maze", "maze"),type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("activity/activity_warorder", "icon_7"),type = ResourcesType.single}
    }
    self.isLeadMove = false
    self.line = {}
    self.temp_point = 0

    _model:setMazeLoginRed(false)
end

