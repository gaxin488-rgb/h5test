function MazeWindow:openRootWnd()
    _controller:sender30303()
    _controller:sender30323()
    _controller:sender30319()
    _controller:sender30313()
    _controller:sender30317()
end

function MazeWindow:setData(data)
    -- print("------------------------MazeWindow:setData--------------------------")
    -- self.maze_data = {
        -- {uint16, floor, "当前所在层数"}
        -- ,{uint8, index, "当前所在格子序号"}
        -- ,{uint8, fight_count, "战斗次数"}
    -- ,{uint8, reset_count, "每日重置次数"}
    -- ,{uint8, sneak_count, "奇袭次数"}
    -- ,{uint8, fight_index, "当前正在战斗的点位"}
    -- ,{uint8, power_group, "当前分的战力组"}
    -- ,{array, maze_tile, tile_list, "格子列表", ?p_g_set(tile_info, [
    --     {uint8, index, "格子序号"}
    --     ,{uint8,  type, "格子类型 1初始点 2怪物 3随机宝箱 4终点宝箱"}
    --     ,{uint8,  is_walk, "是否行走过, 1是0否"}
    --     ,{uint32,  combat_power, "战斗事件战力"}
    --     ,{uint8, is_sneak, "是否奇袭过"}
    --     ,{uint32, chest_id, "宝箱id"}
    -- ])}
    --  }
    -- }
    if data then
        self:updateMaxPower()
        self:updateBg(data.floor)
        self:updateLine(data.tile_list)
        self:createMap(data.tile_list, data.fight_index)
        self:updateLead()
        self:updateFightCount(data)
        self:updateResetCount(data)
    end
end

function MazeWindow:updateFightCount(data)
    local fightCount = data.fight_count
    self.tip_key_value:setString(fightCount)
end

function MazeWindow:updateResetCount(data)
    local reset_count = data.reset_count
    self.icon_img:setVisible(false)
    self.icon_num:setVisible(false)
    self.free_txt:setVisible(false)
    self.refresh_bg:setVisible(false)
    addRedPointToNodeByStatus(self.refresh_btn,false)
    local cost = 0
    local can_reset = true
    local reset_cost = Config.MazeData.data_const["reset_cost"].val
    if reset_cost[reset_count + 1] then
        local item_config = Config.ItemData.data_get_data(reset_cost[reset_count + 1][1])
        self.icon_img:loadTexture(PathTool.getItemRes(item_config.icon), LOADTEXT_TYPE)
        cost = reset_cost[reset_count + 1][2]
    else
        can_reset = false
    end
    if can_reset then
        if cost > 0 then
            addRedPointToNodeByStatus(self.refresh_btn,false)
            self.icon_img:setVisible(true)
            self.icon_num:setVisible(true)
            self.refresh_bg:setVisible(true)
            self.icon_num:setString(cost)
        else
            addRedPointToNodeByStatus(self.refresh_btn,true)
            self.free_txt:setVisible(true)
            self.refresh_bg:setVisible(true)
        end        
    end
end

function MazeWindow:setVisible(bool)
    self.is_visible = bool
    if self.root_wnd == nil or tolua.isnull(self.root_wnd) then
        return
    end
    self.root_wnd:setVisible(bool)
    if bool == true then
        MainuiController:getInstance():setIsShowMainUIBottom(false) -- 隐藏底部UI
    else
        MainuiController:getInstance():setIsShowMainUIBottom(true) -- 隐藏底部UI
    end
end

function MazeWindow:close_callback()
    _model.is_saodang = false
    if self.bg_load_1 then
        self.bg_load_1:DeleteMe()
        self.bg_load_1 = nil
    end
    if self.bg_load_2 then
        self.bg_load_2:DeleteMe()
        self.bg_load_2 = nil
    end
    if self.bg_load_3 then
        self.bg_load_3:DeleteMe()
        self.bg_load_3 = nil
    end
    self:showRoleShowEffect(false)
    self:showFightEffect(false)
    MainuiController:getInstance():setIsShowMainUIBottom(true) -- 隐藏底部UI
    _controller:openMazeWindow(false)
end
