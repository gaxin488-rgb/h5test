MazeAlert = MazeAlert or BaseClass(BaseView)
local controller = MazeController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_remove = table.remove
local clickCell

function MazeAlert:__init()
    self.cell_pos = 0
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Mini   
    self.is_full_screen = false
    self.layout_name = "maze/maze_alert"

    self.res_list = {
        -- { path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_3"), type = ResourcesType.single }
    }

end

function MazeAlert:open_callback(id)
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel, 2)
    self.title_container = self.main_panel:getChildByName("title_container")
    self.titlebg = self.title_container:getChildByName("imgTitleBg")
    self.title_label = self.title_container:getChildByName("title_label")
    self.title_label:setString(TI18N("语言_maze_02_3"))
    moveTextBg(self.title_label,self.titlebg,60,300)

    self.alert_txt = self.main_panel:getChildByName("alert_txt")
    setTextMaxWidth(self.alert_txt,550)
    -- self.alert_txt = createRichLabel(20, cc.c4b(0xff, 0xff, 0xff,0xff), cc.p(0.5,0.5),  cc.p(0,0), -10, nil, 550)
    self.alert_txt:setString(TI18N("语言_maze_01_6"))
    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_btn:getChildByName("label"):setString(TI18N("语言_c_261"))

    self.checkBox = self.main_panel:getChildByName("checkbox")
    local check_txt = self.checkBox:getChildByName("name")
    check_txt:setString(TI18N("语言_maze_01_7"))
    self.checkBox:setPositionX(self.main_panel:getContentSize().width * 0.5 - check_txt:getContentSize().width * 0.5 - 19)
    
    self:setAutoSacrificeStatus()
    self.close_btn = self.main_panel:getChildByName("close_btn")
end

function MazeAlert:setAutoSacrificeStatus()
    local status = model:getSaoSelect()
    if status ~= 0 then
        self.checkBox:setSelected(true)
    else
        self.checkBox:setSelected(false)
    end
end

function MazeAlert:register_event()
    registerButtonEventListener(self.background, handler(self, self._onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose) ,true, 1)
    registerButtonEventListener(self.ok_btn, handler(self, self._onClickBtnSelect) ,true, 2)
    self:registerCheckBoxEvent(self.checkBox)
end

--注册选项框事件
function MazeAlert:registerCheckBoxEvent(btn)
    if not btn then return end
	btn:addEventListener(function(sender,event_type)
	    if event_type == ccui.CheckBoxEventType.selected then
            playButtonSound2()
            model:setSaoSelect(1,true)
	        btn:setSelected(true)
	    elseif event_type == ccui.CheckBoxEventType.unselected then 
            playButtonSound2()
            model:setSaoSelect(0,true)
            btn:setSelected(false)
	    end
    end)
end

--关闭
function MazeAlert:_onClickBtnClose()
    controller:openMazeAlert(false)
end

--选择
function MazeAlert:_onClickBtnSelect()
    model.is_saodang = true
    GlobalEvent:getInstance():Fire(MazeEvent.MOVE_ROLE,{id = self.id})
    self:_onClickBtnClose()
end

--@select_data 选择的数据
function MazeAlert:openRootWnd(id)
    self.id = id
end

function MazeAlert:close_callback()
    controller:openMazeAlert(false)
end