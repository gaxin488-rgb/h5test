 --------------------------------------------------------------------
MazeBoxPanel = MazeBoxPanel or BaseClass(BaseView)

local table_insert = table.insert
local controller = MazeController:getInstance()
local model = controller:getModel()

function MazeBoxPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Mini
    self.layout_name = "maze/maze_box_panel"
end 

function MazeBoxPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(container , 2)  
    self.win_title = container:getChildByName("win_title")

    self.scroll_view = container:getChildByName("scroll_view")
    self.scroll_view:setScrollBarEnabled(false)
    self.dec_val = createRichLabel(24, cc.c4b(0x68, 0x45, 0x2a, 0xff), cc.p(0.5,0.5), cc.p(280,40),FONT_COMMON_LINE_SPACE,nil,550)--50 491
    self.scroll_view:addChild(self.dec_val)
    self.image_2 = container:getChildByName("Image_2")

    -- container:addChild(self.dec_val)
    self.cancel_btn = container:getChildByName("cancel_btn")
    self.cancel_btn_label = self.cancel_btn:getChildByName("label")
    self.cancel_btn_label:setString(TI18N("语言_c_261"))
    self.cancel_btn_label:enableOutline(Config.ColorData.data_color4[263], 2)

    self.confirm_btn = container:getChildByName("confirm_btn")
    self.confirm_btn_label = self.confirm_btn:getChildByName("label")
    self.confirm_btn_label:setString(TI18N("语言_c_3112"))
    self.confirm_btn_label:enableOutline(Config.ColorData.data_color4[264], 2)
    self.list_view = container:getChildByName("list_view")
    local size = self.list_view:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 16,                  -- 第一个单元的X起点
        space_x = 32,                    -- x方向的间隔
        start_y = 6,                    -- 第一个单元的Y起点
        space_y = 10,                   -- y方向的间隔
        item_width = 119,               -- 单元的尺寸width
        item_height = 119,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 3,                         -- 列数，作用于垂直滚动类型
        once_num = 4,
        need_dynamic = true,
        is_center = true
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.list_view, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, size, setting)
    self.close_btn = container:getChildByName("close_btn")
    self.container = container
end

function MazeBoxPanel:register_event()
    registerButtonEventListener(self.close_btn, function() controller:openMazeBoxPanel(false) end ,true, 1)
    registerButtonEventListener(self.cancel_btn, function() controller:openMazeBoxPanel(false) end ,true, 2)
    registerButtonEventListener(self.confirm_btn, function() self:onConfirmButton() end ,true, 2)
end

function MazeBoxPanel:onConfirmButton()
    MazeController:getInstance():sender30300(self.id, {}, false, 0)
    controller:openMazeBoxPanel(false)
end

function MazeBoxPanel:openRootWnd(chest_id,id,is_open,is_walk,floor)
    self.chest_id = chest_id
    self.id = id
    self.is_open = is_open
    self.is_walk = is_walk
    self.floor = floor
    self.cancel_btn:setVisible(false)
    self.confirm_btn:setVisible(false)
    if self.is_open then -- 可以领取
        if self.is_walk == 0 then -- 没领过
            self.confirm_btn:setVisible(true)
        else --已领取
            self.cancel_btn:setVisible(true)
        end
    else -- 不可领取
        self.cancel_btn:setVisible(true)
    end
    local data_list = {}
    if chest_id == 0 then
        local box_info = Config.MazeData.data_diff_info[self.floor]
        local item_list = box_info.last_award
        for i,v in ipairs(item_list) do
            local info = {}
            info.id = v[1]
            info.num = v[2]
            table_insert(data_list, info)
        end
    else
        local box_info = Config.MazeData.data_award[self.chest_id]
        local item_list = box_info.award
        for i,v in ipairs(item_list) do
            local info = {}
            info.id = v[1]
            info.num = v[2]
            table_insert(data_list, info)
        end
    end
    self:setData(data_list)
    local str = TI18N("语言_maze_01_8")
    if chest_id == 0 then
        str = TI18N("语言_c_2884")
    end
    self.dec_val:setString(str)
    self.win_title:setString(TI18N("语言_c_21"))
    self.confirm_btn_label:setString(TI18N("语言_c_216"))
    local image_2_width = math.max(self.win_title:getContentSize().width + 100 , 332)
	local image_2_height = self.image_2:getContentSize().height
	self.image_2:setContentSize(image_2_width,image_2_height)
end

function MazeBoxPanel:setData(list)
    if not list then return end
    local item_list = {}
    for i,v in ipairs(list) do
        local item = {}
        item.id = v.id
        item.quantity = v.num
        table_insert(item_list, item)
    end
    local sort_func = SortTools.tableUpperSorter({"id"})
    -- local sort_func = SortTools.tableUpperSorter({"quality","lev"})
    table.sort(item_list, sort_func)
    self.item_scrollview:setData(item_list, nil, nil, {is_show_tips = true, is_other = true})
end

function MazeBoxPanel:close_callback()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    controller:openMazeBoxPanel(false)
end
