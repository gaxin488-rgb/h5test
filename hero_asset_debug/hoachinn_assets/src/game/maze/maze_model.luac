function MazeModel:getMazeMaxPower()
    return self.maze_data and self.maze_data.max_power or 0
end
function MazeModel:getMazeData()
    return self.maze_data
end

-- 获取某一章节 某一关卡 的通关状态 
function MazeModel:getOpenStatus(floor, id)
    -- debug_Print("getOpenStatus", id)
    -- debug_Print("self.maze_data.tile_list", self.maze_data.tile_list)
    local maze_tile = self.maze_data.tile_list
    if not maze_tile then
        return false
    end
    for i, v in ipairs(maze_tile) do
        if v.index == id then
            if v.is_walk == 1 then
                return true
            end
        end
    end
    -- debug_Print("maze_tile",maze_tile)
   
    -- for i, v in ipairs(maze_tile.index) do
        -- if v.id == id then
        --     if v.is_walk == 1 then
        --         return true
        --     end
        -- end
    -- end
    return false
end

-- 获取对应路的通过信息
function MazeModel:getTargetRoadPass(floor, pos)
    local maze_tile = self.maze_data.tile_list[floor]
    if not maze_tile then
        return {}
    end
    local road_ids = {}
    for k, v in pairs(maze_tile) do
        local config = Config.MazeData.data_map_info[v.id]
        if config.pos == pos then
            road_ids[#road_ids + 1] = v
        end
    end
    return road_ids
end

-- 检查卡位的激活
function MazeModel:checkPointIsOpen(floor, id)
    if floor == self.maze_data.floor then
        local maze_tile = self.maze_data.tile_list
        if not maze_tile then
            return false
        end
        local config = Config.MazeData.data_map_info[id]
        local is_open = false
        for i, v in ipairs(config.round_point) do
            for k, j in pairs(maze_tile) do
                if j.index == v then
                    if j.is_walk == 1 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- 检查宝箱的激活
function MazeModel:checkBoxCanGet(floor, id)
    if floor == self.maze_data.floor then
        local maze_tile = self.maze_data.tile_list
        if not maze_tile then
            return false
        end
        local config = Config.MazeData.data_map_info[id]
        local is_open = false
        for i, v in ipairs(config.chest_point) do
            for k, j in pairs(maze_tile) do
                if j.index == v then
                    if j.is_walk == 1 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- 检查是否所有激活的宝箱都已领取
function MazeModel:checkBoxAllGet(floor)
    if floor == self.maze_data.floor then
        local maze_tile = self.maze_data.tile_list
        if not maze_tile then
            return false
        end
        local allget = true
        for k, j in pairs(maze_tile) do
            if self:checkBoxCanGet(floor, j.index) and j.is_walk == 0 then -- 已激活的宝箱未领取
                return false
            end
        end
    end
    return true
end

-- 获取某一章节 某一关卡 的奇袭状态 
function MazeModel:getIsSneakStatus(floor, id)
    local maze_tile = self.maze_data.tile_list[floor]
    if not maze_tile then
        return false
    end
    for i, v in ipairs(maze_tile.ids) do
        if v.id == id then
            if v.is_sneak ~= 0 then
                return true
            end
        end
    end
    return false
end
function MazeModel:getTaskData()
    return self.task_list
end

function MazeModel:getOrderRedPoint()
    local red_Point = false
    if not Config or not Config.MazeData then
        require("config.maze_data")
    end
    self.reward_cfg = Config.MazeData.data_war_order
    --start_time = 1696867200,
    --end_time = 1698163199,
    --list = {
    --},
    --rmb_status = 0,
    --score = 0,
    if self.order_list then
        local list = {}
        local order_list_list = self.order_list.list
        -- award_status = 1,
        -- rmb_award_status = 0,
        -- id = 1,
        for k, v in pairs(self.reward_cfg) do
            local list_obj = {}
            list_obj.id = v.id
            list_obj.award_status = 0
            list_obj.rmb_award_status = 0
            list_obj.score = v.score
            for i, j in ipairs(order_list_list) do
                if v.id == j.id then
                    list_obj.award_status = j.award_status
                    list_obj.rmb_award_status = j.rmb_award_status
                    break
                end
            end
            table.insert(list,list_obj)
        end
        for i, j in ipairs(list) do
            if self.order_list.score >= j.score  then -- 积分已满足
                if j.award_status == 0 then -- 普通未领取
                    red_Point = true
                    break
                else -- 普通已领取
                    if self.order_list.rmb_status == 1 then -- 战令激活
                        if j.rmb_award_status == 0 then -- 进阶奖励未领取
                            red_Point = true
                            break
                        end
                    end
                end
            end
        end
    end
    return red_Point
end

function MazeModel:getAchieveRedPoint()
    local red_Point = false
    if self.achieve_list then
        for k, v in pairs(self.achieve_list) do
            if v.state == 1 then
                red_Point = true
                break
            end
        end
    end
    return red_Point
end

function MazeModel:getTaskRedPoint()
    local red_Point = false
    if self.task_list then
        for k, v in pairs(self.task_list) do
            if v.status == 1 then
                red_Point = true
                break
            end
        end
    end
    return red_Point
end

-- 有挑战次数和有可领取未领取的宝箱
function MazeModel:getMazeRedPoint()
    local red_Point = false
    if self.maze_data and self.maze_data.fight_count then
        if self.maze_data.fight_count > 0 then
            red_Point = true
        end
        local checkBoxAllGet = self:checkBoxAllGet(self.maze_data.floor)
        if checkBoxAllGet == false then
            red_Point = true
        end
    end
    return red_Point
end

-- 有免费重置次数
function MazeModel:getMazeResetRedPoint()
    local red_Point = false
    if self.maze_data and self.maze_data.reset_count  then
        local reset_count = self.maze_data.reset_count
        local cost = 0
        local reset_cost = Config.MazeData.data_const["reset_cost"].val
        if reset_cost[reset_count + 1] then
            cost = reset_cost[reset_count + 1][2]
        else
            return false
        end
        if cost > 0 then
        else
            red_Point = true
        end
    end
    return red_Point
end

function MazeModel:setTaskData(data)

    -- {array,  tuple,  task_info,  "任务信息", [
    --     {uint32,   id,          "任务id"}
    --     ,{uint32,  value,       "完成数量"}
    --     ,{uint32,  status,      "领取状态 0未领取 1已领取"}
    -- ]}

    local task_info = data.task_info
    self.task_list = {}
    local config = Config.MazeData.data_task
    -- [1001] = {id=1001, name="", sort=1, floor=1, param=1, commit_rewards={{1,99},{80251,100}}},
    -- [1002] = {id=1002, name="", sort=2, floor=2, param=2, commit_rewards={{1,99},{80251,100}}},
    -- [1003] = {id=1003, name="", sort=3, floor=3, param=3, commit_rewards={{1,99},{80251,100}}},
    -- [1004] = {id=1004, name="", sort=4, floor=4, param=4, commit_rewards={{1,99},{80251,100}}}
    if config ~= nil then
        for i, v in pairs(config) do
            local taskObj = {}
            taskObj.id = v.id
            taskObj.name = v.name
            taskObj.sort = v.sort
            taskObj.floor = v.floor
            taskObj.param = v.param
            taskObj.commit_rewards = v.commit_rewards
            taskObj.status = 0 -- 0不可领取 1 可领取 2 已领取
            taskObj.sort = 2 -- 2不可领取 3 可领取 1 已领取
            taskObj.finish_num = 0
            for a, b in pairs(task_info) do
                if v.id == b.id then
                    taskObj.finish_num = b.value
                    if b.value >= v.param then
                        if b.status == 1 then
                            taskObj.status = 2
                            taskObj.sort = 1
                        else
                            taskObj.status = 1
                            taskObj.sort = 3
                        end
                    else
                        taskObj.status = 0
                        taskObj.sort = 2
                    end
                    break
                end
            end
            table.insert(self.task_list, taskObj)
        end
    end
    local sort_func = SortTools.tableCommonSorter({{"sort", true}, {"id", false}})
    table.sort(self.task_list, sort_func)
end

