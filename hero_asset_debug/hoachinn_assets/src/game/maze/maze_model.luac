local _table_insert = table.insert

MazeModel = MazeModel or BaseClass()

function MazeModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
    self.maze_data = {}
    self.task_list = {}
    self.is_saodang = false
    self.maze_Login_red = false
end

function MazeModel:config()

end

function MazeModel:setFightCount(fight_count)
    if self.maze_data and self.maze_data.fight_count then
        self.maze_data.fight_count = fight_count
    end
end

