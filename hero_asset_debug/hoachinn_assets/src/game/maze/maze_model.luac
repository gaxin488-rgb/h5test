function MazeModel:getFeatData()
    return self.achieve_list
end

function MazeModel:setFeatData(data)
    -- {array,  tuple,  achieve_info,  "成就信息", [
    --     {uint32, id, "id"}
    --     ,{uint32, point, "红点状态"}
    --     ,{uint32, state, "任务完成状态 0 1 2"}
    --     ,{array, tuple, quest_state, "任务进度", [
    --         {string, label, "任务标签"}
    --         ,{uint32, num, "当前值"}
    --         ,{uint32, need_num, "所需值"}
    --     ]}
    -- ]}
    local achieve_info = data.achieve_info
    self.achieve_list = {}
    local config = Config.MazeData.data_achieve
    if achieve_info ~= nil then
        for i, v in pairs(achieve_info) do
            local achieveObj = {}
            achieveObj.id = v.id
            achieveObj.state = v.state -- 0不可领取 1 可领取 2 已领取
            achieveObj.sort = 1 -- 1不可领取 2 可领取 0 已领取
            if v.state == 1 then
                achieveObj.sort = 2
            elseif v.state == 2 then
                achieveObj.sort = 0
            end
            achieveObj.num = v.quest_state[1].num
            achieveObj.need_num = v.quest_state[1].need_num
            achieveObj.commit_rewards = {}
            achieveObj.name = ""
            if config and config[v.id] then
                achieveObj.commit_rewards = deepCopy(config[v.id].commit_rewards)
                achieveObj.name = deepCopy(config[v.id].name)
            end
            table.insert(self.achieve_list, achieveObj)
        end
    end
    local sort_func = SortTools.tableCommonSorter({{"sort", true}, {"id", false}})
    table.sort(self.achieve_list, sort_func)
end

function MazeModel:getOrderData()
    return self.order_list
end

