end

function MazeModel:setAdventureRedStatus()
    local scene_adventure_redpiont = self:getAdventureRedPoint()
    MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.adventure, {
        bid = AdventureActivityConst.Red_Type.maze,
        status = scene_adventure_redpiont
    })
end

function MazeModel:getAdventureRedPoint()
    local red_status = false
    local achieve_red = self:getAchieveRedPoint()
    local task_red = self:getTaskRedPoint()
    local order_red = self:getOrderRedPoint()
    local maze_red = self:getMazeRedPoint()
    local reset_red = self:getMazeResetRedPoint()
    if achieve_red == true or task_red == true or order_red == true or maze_red == true or reset_red == true or self.maze_Login_red then
        red_status = true
    end
    return red_status
end

function MazeModel:setSaoSelect(num,is_req)
	if self.isSaoSelect ~= num then
		self.isSaoSelect = num
        if is_req then
            MazeController:getInstance():sender30324(num)
        end
	end
end
function MazeModel:getSaoSelect()
	if self.isSaoSelect then
		return self.isSaoSelect
	end
	return 0
end

-- 是否屏蔽功能
function MazeModel:isHideMaze()
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	local featuresId = MainuiConst.FeaturesShield.maze
    if not table.indexof(nohideIds,featuresId) then
		return true
	end
end

function MazeModel:setMazeLoginRed(bl)
    self.maze_Login_red = bl

	self:setAdventureRedStatus()
end

function MazeModel:__delete()
end
