-- 打开地下迷宫宝箱界面
function MazeController:openMazeBoxPanel(status, chest_id ,id,is_open,is_walk,floor)
    if status == true then
        if not self.maze_box_panel then
            self.maze_box_panel = MazeBoxPanel.New()
        end
        if self.maze_box_panel:isOpen() == false then
            self.maze_box_panel:open(chest_id,id,is_open,is_walk,floor)
        end
    else
        if self.maze_box_panel then
            self.maze_box_panel:close()
            self.maze_box_panel = nil
        end
    end
end

--战令购买界面
function MazeController:openMazeOrderBuyWindow(status)
    if status == true then
        if not self.buy_card_view then
            self.buy_card_view = MazeBuyCardWindow.New()
        end
        self.buy_card_view:open()
    else
        if self.buy_card_view then 
            self.buy_card_view:close()
            self.buy_card_view = nil
        end
    end
end

--扫荡弹窗界面
function MazeController:openMazeAlert(status,id)
    if status == true then
        if not self.maze_alert then
            self.maze_alert = MazeAlert.New()
        end
        self.maze_alert:open(id)
    else
        if self.maze_alert then 
            self.maze_alert:close()
            self.maze_alert = nil
        end
    end
end



function MazeController:__delete()
    if self.model ~= nil then
        self.model:DeleteMe()
        self.model = nil
    end
end
