MazeController = MazeController or BaseClass(BaseController)

function MazeController:config()
    self.model = MazeModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function MazeController:getModel()
    return self.model
end

function MazeController:registerEvents()

end

function MazeController:registerProtocals()
    -- 主界面协议
    self:RegisterProtocal(30300, "handle30300") -- "操作指定格子事件"
    self:RegisterProtocal(30301, "handle30301") -- "进入副本"
    self:RegisterProtocal(30302, "handle30302") -- "副本重置"
    self:RegisterProtocal(30303, "handle30303") -- "该层格子数据信息"
    self:RegisterProtocal(30304, "handle30304") -- "进入下一层"
    self:RegisterProtocal(30305, "handle30305") -- "奇袭"
    self:RegisterProtocal(30309, "handle30309") -- "一键领取宝箱"
    self:RegisterProtocal(30313, "handle30313") -- "任务信息"
    self:RegisterProtocal(30314, "handle30314") -- "任务领奖"
    self:RegisterProtocal(30315, "handle30315") -- "战斗次数更新"
    self:RegisterProtocal(30316, "handle30316") -- "兑换战斗次数"
    self:RegisterProtocal(30319, "handle30319") -- "成就信息"
    self:RegisterProtocal(30320, "handle30320") -- "成就领奖"
    self:RegisterProtocal(30322, "handle30322") -- "扫荡结束通知"
    self:RegisterProtocal(30321, "handle30321") -- "扫荡"
    self:RegisterProtocal(30317, "handle30317") -- "战令信息"
    self:RegisterProtocal(30318, "handle30318") -- "战令领取"
    self:RegisterProtocal(30307, "handle30307") -- "获取挑战玩家信息"
    self:RegisterProtocal(30311, "handle30311") -- 保存阵法
    self:RegisterProtocal(30312, "handle30312") -- 请求阵法
    self:RegisterProtocal(30308, "handle30308") -- 战斗结算
    self:RegisterProtocal(30323, "handle30323") -- 扫荡打钩信息
    self:RegisterProtocal(30324, "handle30324") -- 扫荡设置打钩信息

    self:RegisterProtocal(30330, "handle30330") -- 地下迷宫登录红点
   
end

-- 操作指定格子事件
-- is_fight 是否进入战斗
function MazeController:sender30300(index, ext_list, is_fight, is_auto)
    local protocal = {}
    protocal.index = index
    protocal.ext_list = ext_list or {}
    if is_auto == true then
        protocal.is_auto = 1
    else
        protocal.is_auto = 0
    end
    -- if is_fight then
    self:SendProtocal(30300, protocal)
    -- else
    --     self:SendProtocal(28600, protocal)    
    -- end

end

