-- 地下迷宫登录红点
function MazeController:sender30330()
    local protocal = {}
    self:SendProtocal(30330, protocal)
end

function MazeController:handle30330(data)
    local status = false
    for k, v in pairs(data.red_point_list) do
        status = status or v.code == 1
        if status then
            break
        end
    end

    self.model:setMazeLoginRed(status)
end

function MazeController:getNextId(index)
    local next_id = 0
    local config = Config.MazeData.data_map_info[index]
    local maze_data = self.model:getMazeData()
    if config then
        if config.sweep_point ~= 0 then
            local open_status = self.model:getOpenStatus(maze_data.floor, config.sweep_point)
            if open_status == true then
                -- debug_Print("open_status",config.sweep_point)
                -- debug_Print("maze_data",maze_data)
                next_id = self:getNextId(config.sweep_point)
            else
                next_id = config.sweep_point
            end
        end
    end
    return next_id
end

-----------------------@ 界面相关
-- 打开地下迷宫主界面
function MazeController:openMazeWindow(status, cid)
    if status == true then
        if not self.maze_wnd then
            self.maze_wnd = MazeWindow.New(cid)
        end
        if self.maze_wnd:isOpen() == false then
            self.maze_wnd:open()
        end
    else
        if self.maze_wnd then
            self.maze_wnd:close()
            self.maze_wnd = nil
        end
    end
end
-- 打开地下迷宫对应点英雄信息界面
function MazeController:openMazeDes(status, cid)
    if status == true then
        if not self.maze_des_wnd then
            self.maze_des_wnd = MazeDes.New()
        end
        if self.maze_des_wnd:isOpen() == false then
            self.maze_des_wnd:open(cid)
        end
    else
        if self.maze_des_wnd then
            self.maze_des_wnd:close()
            self.maze_des_wnd = nil
        end
    end
end

