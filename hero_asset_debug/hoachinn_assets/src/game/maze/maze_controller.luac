-- 战斗结果
function MazeController:handle30308(data)
    BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.Maze, data)
end

-- 扫荡关卡
function MazeController:sender30321(index)
    local protocal = {}
    protocal.index = index
    self:SendProtocal(30321, protocal)
end

function MazeController:handle30321(data)
    -- debug_Print("handle30321", data)
    if data.flag == 0 then
        self.model.is_saodang = false
        if data.msg == TI18N("语言_c_3157") then
            HeroController:getInstance():openFormMainWindow(true, PartnerConst.Fun_Form.Maze, {
                index = data.index,
                is_setForm = true
            })
        end
        message(data.msg)
    end
    -- {uint8, flag, "是否成功 是1 否0"}
    -- {uint8,   index,          "格子序号"}
    -- ,{string, msg, "信息"}
end
function MazeController:handle30322(data)
    -- {uint8,     result,   "战斗结果(1:成功 2:失败)"}
    -- ,{uint8,     is_over,   "是否结束扫荡"}
    -- ,{uint8,   index,          "格子序号"}
    -- ,{array, tuple, award_list, "奖励", [
    -- 	{uint32, bid, "物品bid"}
    -- 	,{uint32, num, "个数"}
    -- ]}
    if data then
        if data.is_over == 1 then -- 结束扫荡
            self.model.is_saodang = false
            if data.result == 2 then
                BattleController:getInstance():openFailFinishView(true, BattleConst.Fight_Type.Maze, data.result)
            end
            if #data.award_list > 0 then
                MainuiController:getInstance():openGetItemView(true, data.award_list, 0, {is_backpack = true}, MainuiConst.item_open_type.normal)
            end
        else
            local next_id = self:getNextId(data.index)
            if next_id and next_id ~= 0 then
                delayOnce(function()
                    GlobalEvent:getInstance():Fire(MazeEvent.Maze_SaoDang_Next_Index, next_id)
                end,0.5)
            else
                self.model.is_saodang = false
            end
        end
        self:sender30303()
    end
end


