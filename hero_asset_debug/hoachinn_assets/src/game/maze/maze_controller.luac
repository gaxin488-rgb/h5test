-- 保存阵法
function MazeController:sender30311(formation_type, pos_info, hallows_id)
    local protocal = {}
    protocal.formation_type = formation_type
    protocal.pos_info = pos_info
    protocal.hallows_id = hallows_id
    self:SendProtocal(30311, protocal)
end

function MazeController:handle30311(data)
    if data.msg ~= "" then
        message(data.msg)
    end
    if data.flag == 1 then
        self:sender30312()
        GlobalEvent:getInstance():Fire(MazeEvent.Save_Form_Success_Event)
    end
end

-- 请求阵容
function MazeController:sender30312()
    self:SendProtocal(30312, {})
end

function MazeController:handle30312(data)
    data.type = PartnerConst.Fun_Form.Maze
    HeroController:getInstance():getModel():setFormList(data)
    GlobalEvent:getInstance():Fire(MazeEvent.Get_Form_Data_Event, data)
end

-- 进入副本
function MazeController:sender30301()
    local protocal = {}
    self:SendProtocal(30301, protocal)
end

function MazeController:handle30301(data)
    if data then
        if data.flag == 1 then
            MazeController:openMazeWindow(true)
        else
            message(data.msg)
        end
    end
end

-- 任务信息
function MazeController:sender30313()
    local protocal = {}
    self:SendProtocal(30313, protocal)
end

function MazeController:handle30313(data)
    if data then
        self.model:setTaskData(data)
        GlobalEvent:getInstance():Fire(MazeEvent.UpdateTaskList)
        GlobalEvent:getInstance():Fire(MazeEvent.Update_Maze_Task_RedStatus)
        GlobalEvent:getInstance():Fire(MazeEvent.Update_Maze_AllRed_Status)
        self.model:setAdventureRedStatus()
    end
end

