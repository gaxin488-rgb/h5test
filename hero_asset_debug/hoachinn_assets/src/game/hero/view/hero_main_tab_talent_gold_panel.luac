        self.skill_bg_item_load = createResourcesLoad(bg_res, ResourcesType.single, function()
            if not tolua.isnull(self.skill_item_list[3].skill_bg) then
                loadSpriteTexture(self.skill_item_list[3].skill_bg, bg_res, LOADTEXT_TYPE)
            end
        end,self.skill_bg_item_load)
        local res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_info_bg_tank", false)
        self.bg_box:loadTexture(res,LOADTEXT_TYPE)
        local res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_info_tank", false)
        loadSpriteTexture(self.skill_type,res,LOADTEXT_TYPE)
    end

    local bg_res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_bag_talent_bg_new2", false)
    self.item_load4 = createResourcesLoad(bg_res, ResourcesType.single, function()
        if not tolua.isnull(self.skill_item_list[4].skill_bg) then
            loadSpriteTexture(self.skill_item_list[4].skill_bg, bg_res, LOADTEXT_TYPE)
        end
        if not tolua.isnull(self.skill_item_list[5].skill_bg) then
