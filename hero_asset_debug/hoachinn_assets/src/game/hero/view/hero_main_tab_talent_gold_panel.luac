    -- local _img = career_img[hero_type]
    -- if _img then
    --     local res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_info_bg_".._img, false)
    --     self.bg_box:loadTexture(res,LOADTEXT_TYPE)
    --     local res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_info_".._img, false)
    --     loadSpriteTexture(self.skill_type,res,LOADTEXT_TYPE)
    -- end

