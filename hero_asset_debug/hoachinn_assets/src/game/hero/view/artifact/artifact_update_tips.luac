ArtifactUpdateTips = ArtifactUpdateTips or BaseClass(BaseView)

function ArtifactUpdateTips:__init()
    self.ctrl = HeroController:getInstance()
    self.is_full_screen = false
    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "hero/artifact_update_tips"
  
end

function ArtifactUpdateTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    
    self.Text_1 = self.main_panel:getChildByName("Text_1")
    self.Text_1:setString(TI18N("淬炼总览"))
    self.cur_img = self.main_panel:getChildByName("cur_img")
    self.cur_lab = self.main_panel:getChildByName("cur_lab")
    self.cur_lab:setString(TI18N("当前"))
    
    self.item_list = {}
    for i=1,3 do
        local obj = {}
        obj.title = self.main_panel:getChildByName("title_"..i)
        obj.title:setString(string.format(TI18N("阶段%s: "),StringUtil.numToChinese(i)))
        obj.item_name = self.main_panel:getChildByName("item_name_"..i)
        obj.desc_lab = self.main_panel:getChildByName("desc_lab_"..i)
        obj.item_node = self.main_panel:getChildByName("item_node_"..i)
        obj.item = BackPackItem.new(false, false, false,0.8)
        obj.item_node:addChild(obj.item)
        self.item_list[i] = obj
    end

    self.tips_lab = createRichLabel(20, cc.c4b(0xe0,0xbf,0x98,0xff), cc.p(0.5,0.5), cc.p(267.5,30), nil, nil, 400)
    self.main_panel:addChild(self.tips_lab)
    self.tips_lab:setString(string.format("（%s<div fontcolor=#8bff8e>%s</div>, %s<div fontcolor=#8bff8e>%s</div>）", TI18N("阶段三可炼就"),TI18N("星曜符文"),TI18N("开启"),TI18N("超级技能")))
end

function ArtifactUpdateTips:register_event()
    registerButtonEventListener(self.background, handler(self, self._onClickBtnClose) ,false, 1)
end

--关闭
function ArtifactUpdateTips:_onClickBtnClose()
    self.ctrl:openArtifactUpdateTips(false)
end

function ArtifactUpdateTips:openRootWnd(data)
    if not data then return end
    self.data = data
    self.item_config = self.data.config
    if not self.item_config then return end
    self:setData()
end

function ArtifactUpdateTips:setData( )
    local update_cfg = Config.PartnerArtifactData.data_artifact_update[self.item_config.id]
    if update_cfg then 
        local bg_y = {480,325.41,170}
        local lab_y = {492,336.45,182}
        for i,v in pairs(update_cfg) do
            local obj = self.item_list[i+1]
            if obj then
                if obj.desc_lab then
                    local desc = v.desc
                    local color = cc.c4b(0xe0,0xbf,0x98,0xff)
                    if self.data.step >= i+1 then
                        color = cc.c4b(0x8b,0xff,0x8e,0xff)
                        desc = string.format( "%s\n%s",desc,TI18N("（已激活）") )
                        if self.data.step == i+1 then
                            self.cur_img:setVisible(true)
                            self.cur_lab:setVisible(true)
                            self.cur_img:setPositionY(bg_y[i+1])
                            self.cur_lab:setPositionY(lab_y[i+1])
                        end
                    end
                    obj.desc_lab:setTextColor(color)
                    obj.desc_lab:setString(desc)
                end
                local item_id = 10455
                local item_step = 0
                if v.show[1] and v.show[1][1] and v.show[1][2] then
                    item_id = v.show[1][1]
                    item_step = v.show[1][2]
                end
                if obj.item then
                    obj.item:setBaseData(item_id,1)
                    if item_step>0 then
                        obj.item:setRightTopLab(true,item_step)
                    end
                end
                local item_config = Config.ItemData.data_get_data(item_id)
                if item_config and obj.item_name then
                    obj.item_name:setString(item_config.name)
                end
            end
        end
    end
end


function ArtifactUpdateTips:close_callback()
    if self.item_list then
        for k,v in pairs(self.item_list) do
            if v.item and v.item.DeleteMe then
                v.item:DeleteMe()
                v.item = nil
            end
        end
    end
    self.item_list = {}

    self.ctrl:openArtifactUpdateTips(false)
end







