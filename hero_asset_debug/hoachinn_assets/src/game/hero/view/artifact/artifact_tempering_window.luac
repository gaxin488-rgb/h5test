function ArtifactTemperingWindow:setData(data, partner_id)
	self.data = data
    self.item_config = data.config
    self.partner_id = partner_id or 0
	if self.data.config.id == 10455 then
		self.temperingTip:setString(TI18N("语言_c_5293"))
	elseif self.data.config.id == 10456 then
		self.temperingTip:setString(TI18N("语言_c_5194"))
	elseif self.data.config.id == 10457 then
		self.temperingTip:setString(TI18N("语言_c_5294"))
	end
	self:setAttributesPanel()
end
--设置属性
function ArtifactTemperingWindow:setAttributesPanel()
	self.next_id = self.item_config.id + 1
	self.next_item_config = Config.ItemData.data_get_data(self.next_id)
	if self.next_item_config then
		self.canTempered = true
	else
		self.canTempered = false
	end
	if self.canTempered then
		self:setNew(true,0,0)
		self.finish_panel:setVisible(false)
		self.undone_panel:setVisible(true)
		self:setLeftPanel()
		self:setRightPanel()
		self.recast_btn:setVisible(false)
		self.temper_txt:setString(TI18N("语言_c_5187"))
		self.temper_btn:setPositionX(326)
		setChildUnEnabled(false,self.temper_btn)
		self.temper_btn:setTouchEnabled(true)
		self:setCostPanel()
	else
		self:setNew(false,0,0)
		self.finish_panel:setVisible(true)
		self.undone_panel:setVisible(false)
		self:setMaxPanel()
		self.recast_btn:setVisible(true)
		self.temper_txt:setString(TI18N("语言_c_5195"))
		self.temper_btn:setPositionX(163)
		setChildUnEnabled(true,self.temper_btn)
		self.temper_btn:setTouchEnabled(false)
	end
end
-- 淬炼消耗
function ArtifactTemperingWindow:setCostPanel()
	local cfg = Config.PartnerArtifactData.data_artifact_refine[self.item_config.id]
	if cfg and cfg.cost then
		for i=1,2 do
			local cost_icon = self.cost_icon[i]
			local cost_txt = self.cost_txt[i]
			local cost_data = cfg.cost[i]
			if cost_data then
				local bid = cost_data[1]
				local num = cost_data[2]
				local item_config = Config.ItemData.data_get_data(bid)
    			if item_config then
    				cost_icon:loadTexture(PathTool.getItemRes(bid), LOADTEXT_TYPE)
    				local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
					-- local str = "<div><div fontcolor=#07e20b>%s</div><div fontcolor=#ffffff>/%s</div></div>"
					local str = ""
                    if have_num >= num then
						str = "<div><div fontcolor=#07e20b outline=1,#000000>%s</div><div fontcolor=#ffffff outline=1,#000000>/%s</div></div>"
                    else
						str = "<div><div fontcolor=#ff1519 outline=1,#000000>%s</div><div fontcolor=#ffffff outline=1,#000000>/%s</div></div>"
                    end
					cost_txt:setString(string.format(str,MoneyTool.GetMoneyString(have_num),MoneyTool.GetMoneyString(num)))
                end
			end
		end
	end
end
-- 左侧属性
function ArtifactTemperingWindow:setLeftPanel()
	self.item_left_node:setData(self.data)
	self.name_left_txt:setString(TI18N(self.item_config.name))
	self.item_left_bg_bottom:setContentSize(cc.size(self.name_left_txt:getContentSize().width + 80,self.item_left_bg_bottom:getContentSize().height))
	self:setBasicAttributesTxt(self.data.attr,self.base_list_left,self.Image_7,30,370,true,false)
	self:setSecretScrollSkills(self.data.extra,self.skill_list_left,self.Image_7,60,185,false)
end
-- 右侧属性
function ArtifactTemperingWindow:setRightPanel()
	self.item_right_node:setData(self.next_item_config)
	self.name_right_txt:setString(TI18N(self.next_item_config.name))
	self.item_right_bg_bottom:setContentSize(cc.size(self.name_right_txt:getContentSize().width + 80,self.item_right_bg_bottom:getContentSize().height))
	self:setBasicAttributesTxt(self.data.attr,self.base_list_right,self.Image_9,30,370,false,false)
	local data = {}
	local difference = self.next_item_config.id - 10455
	if difference == 1 then
		data = self.data.extra
	elseif difference == 2 then
		data = deepCopy(self.data.extra)
		for key, value in pairs(data) do
			local config = Config.PartnerArtifactData.data_artifact_skill_levup[value.extra_v]
			if config then
				value.extra_v = config.skill_next_id
				self:setNew(true,20,210)
				break
			end
		end
	elseif difference == 3 then
		data = deepCopy(self.data.extra)
		for i=3,1,-1 do
			local config = Config.PartnerArtifactData.data_artifact_skill_levup[data[i].extra_v]
			if config then
				data[i].extra_v = config.skill_next_id
				self:setNew(true,20,90)
				break
			end
		end
	end
	self:setSecretScrollSkills(data,self.skill_list_right,self.Image_9,60,185,false)
end
-- 不可升级单个属性
function ArtifactTemperingWindow:setMaxPanel()
	self.item_node:setData(self.data)
	self.name_txt:setString(TI18N(self.item_config.name))
	self.item_bg_bottom:setContentSize(cc.size(self.name_txt:getContentSize().width + 80,self.item_bg_bottom:getContentSize().height))
	self:setBasicAttributesTxt(self.data.attr,self.base_list_max,self.Image_7_0,350,380,true,true)
	self:setSecretScrollSkills(self.data.extra,self.skill_list_max,self.Image_7_0,80,120,true)
end
--设置基础属性
function ArtifactTemperingWindow:setBasicAttributesTxt(data,list,node,x,y,isLeft,ismax)
	local isLeft = isLeft
	for i,v in ipairs(data) do
        local attr_id = v.attr_id
        local attr_key = Config.AttrData.data_id_to_key[attr_id]
        local attr_val = v.attr_val/1000
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if attr_name then
            if not list[i] then 
				if ismax then
					list[i] = createRichLabel(22, cc.c4b(104,69,42,255), cc.p(0, 0.5), cc.p(20, 28), nil, nil, 380)
				else
					list[i] = createRichLabel(20, cc.c4b(104,69,42,255), cc.p(0, 0.5), cc.p(20, 28), nil, nil, 380)
				end
                node:addChild(list[i])
            end
            local label = list[i]
            local _x = 0
            local _y = 0
			if ismax then
				_x = x - i%2*250
            	_y = y - math.ceil(i/2)*50
			else
				_x = x
				_y = y - (i-1)*40
			end
            label:setPosition(cc.p(_x, _y))

            local icon = PathTool.getAttrIconByStr(attr_key)
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10).."%"
            end
            local attr_str = string_format("<img src='%s' scale=1 /> <div fontcolor=#4e1e0e> %s：</div><div fontcolor=#009300>+%s</div>", PathTool.getResFrame("common", icon), attr_name, attr_val)
            label:setString(attr_str)
        end
    end
	if not isLeft then
		if tableLen(data) == 2 then
			if not list[3] then 
                list[3] = createRichLabel(24, cc.c4b(0x4e,0x1e,0x0e,0xff), cc.p(0, 0.5), cc.p(20, 28), nil, nil, 380)
                node:addChild(list[3])
            end
            local label = list[3]
            local _x = x + 35
            local _y = y - (3-1)*40
            label:setPosition(cc.p(_x, _y))
            label:setString(TI18N("语言_c_2942"))
			if label:getContentSize().width > 240 then
				label:setPositionX(275 - label:getContentSize().width)
			end
			self:setNew(true,30,290)
		end
	end
end
--设置符文技能
function ArtifactTemperingWindow:setSecretScrollSkills(data,list,node,x,y,ismax)
	local index = 1
	for i,value in ipairs(data) do
        if value and value.extra_k and (value.extra_k == 1 or value.extra_k == 2 or value.extra_k == 8) then
			local config = Config.SkillData.data_get_skill(value.extra_v)
			if config then
				if not list[index] then
					local item = self:createSkillItem(node, index,x,y,ismax)
					list[index] = item
				end

				local skill_item = list[index]
				skill_item.skill:setData(config)
				skill_item.name:setString(transformTextToShort(config.name,15))
				addEvt2showAllTextTips(skill_item.name,config.name,15,nil,nil,nil,nil,nil,false)
				skill_item.desc:setString(config.des)
				skill_item.desc:setPositionY(skill_item.desc:getContentSize().height)
				skill_item.scroll:setInnerContainerSize(cc.size(skill_item.desc:getContentSize().width,skill_item.desc:getContentSize().height))

				local temp_lev = config.level
				if config.client_lev and config.client_lev>0 then
					temp_lev = config.client_lev
				end

				local name_color = PartnerConst.SkillColor[temp_lev]
				name_color = name_color or cc.c3b(104,69,42)
				skill_item.name:setTextColor(name_color)

				index = index + 1
			end
        end
	end
end
function ArtifactTemperingWindow:createSkillItem(parent, index, x, y , ismax)
	local item = {}
    local skill = SkillItem.new(true,true,true,0.8)
    parent:addChild(skill)
	local pos_x = 0
    local pos_y = 0
	if ismax then
		pos_x = x + (index-1)*300
		pos_y = y
	else
		pos_x = x
		pos_y = y - (index-1)*120
	end
    skill:setPosition(pos_x, pos_y)
    local name = createLabel(19,cc.c4b(0x4e,0x1e,0x0c,0xff),nil,pos_x + 50, pos_y+25,"",parent,1,cc.p(0,0))
	if ismax then
		name = createLabel(22,cc.c4b(0x4e,0x1e,0x0c,0xff),nil,pos_x + 50, pos_y+25,"",parent,1,cc.p(0,0))
	end
    local scroll = createScrollView(200,65,pos_x+50,pos_y-40,parent,ccui.ScrollViewDir.vertical)
    scroll:setBounceEnabled(false)
    local desc = createRichLabel(17,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0,1),cc.p(0, 0),0,nil,180)
	if ismax then
		desc = createRichLabel(20,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0,1),cc.p(0, 0),0,nil,180)
	end
    scroll:addChild(desc)
    item.skill = skill
    item.name = name
    item.desc = desc
    item.scroll = scroll
    return item
end

function ArtifactTemperingWindow:setNew(status,x,y)
	if status then
		if not self.new then
			self.new = createLabel(22, cc.c3b(0xff,0xfd,0x9a), cc.c3b(0xc1,0x46,0x09), x, y, "", self.Image_9, 2, cc.p(0,0.5))
			self.new:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))
			self.new:setString(TI18N("语言_c_5196"))
			self.new:setZOrder(9999)
		end
		self.new:setPosition(cc.p(x,y + 10))
	else
		if self.new then
			self.new = nil
		end
	end
end
function ArtifactTemperingWindow:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openArtifactTemperingWindow(false)
    end)
    
	registerButtonEventListener(self.background, function ( )
		controller:openArtifactTemperingWindow(false)
	end)
	-- registerButtonEventListener(self.undone_left_preview_bg, function ( )
	-- 	controller:openArtifactSkillWindow(true, 1, 3)
    -- end)
	-- registerButtonEventListener(self.undone_right_preview_bg, function ( )
	-- 	controller:openArtifactSkillWindow(true, 1, 3)
    -- end)
	registerButtonEventListener(self.finish_preview_bg, function ( )
		controller:openArtifactSkillWindow(true, 1, 3)
    end)
	registerButtonEventListener(self.temper_btn, function ( )
		if self.data.config.id == 10456 then
			local function call_back()
				controller:sender11039(self.partner_id,self.data.id)
			end
	
			CommonAlert.show(TI18N("语言_c_5289"), TI18N("语言_c_63"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich,nil,
				{timer = 3, timer_for = true, off_y = 0, title = TI18N("语言_c_154")},24)
		else
			controller:sender11039(self.partner_id,self.data.id)
		end
    end,true,2)
	registerButtonEventListener(self.recast_btn, function ( )
        controller:openArtifactRecastWindow(true, self.data, self.partner_id)
    end,true,2)
	registerButtonEventListener(self.explain_btn, function ( param, sender)
		controller:openArtifactPropertyPreviewPanel(true, self.data.config.id)
    end,true,2)
	self:addGlobalEvent(HeroEvent.Artifact_Save_Event, function (  )
		if not self.data or self.data.id == 0 then return end
        if self.partner_id and self.partner_id ~= 0 then
            local artifact_list = model:getPartnerArtifactList(self.partner_id)
            for k,vo in pairs(artifact_list) do
                if vo.id == self.data.id then
                    self:setData(vo, self.partner_id)
                    break
                end
            end
        else
            local item_data = BackpackController:getModel():getBackPackItemById(self.data.id)
            self:setData(item_data, self.partner_id)
        end
	end)
	self:addGlobalEvent(HeroEvent.Artifact_Tempering_Event, function (  )
		if not self.data or self.data.id == 0 then return end
        if self.partner_id and self.partner_id ~= 0 then
            local artifact_list = model:getPartnerArtifactList(self.partner_id)
            for k,vo in pairs(artifact_list) do
                if vo.id == self.data.id then
                    self:setData(vo, self.partner_id)
                    break
                end
            end
        else
            local item_data = BackpackController:getModel():getBackPackItemById(self.data.id)
            self:setData(item_data, self.partner_id)
        end
	end)
	-- 道具数量更新
    self:addGlobalEvent(BackpackEvent.ADD_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.DELETE_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
end
function ArtifactTemperingWindow:refreshExchangeItemNum( bag_code, data_list )
	if bag_code == BackPackConst.Bag_Code.BACKPACK then
		local cfg = Config.PartnerArtifactData.data_artifact_refine[self.item_config.id]
		if cfg and cfg.cost then
			for i=1,2 do
				local cost_data = cfg.cost[i]
				if cost_data then
					local bid = cost_data[1]
					for i,v in pairs(data_list) do 
						if v and v.base_id and bid == v.base_id then 
							self:setCostPanel()
						end
					end

				end
			end
		end
	end
end
function ArtifactTemperingWindow:openRootWnd( data, partner_id )
	self:setData(data, partner_id)
