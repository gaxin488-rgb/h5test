ArtifactGoldTipsAttachPop = ArtifactGoldTipsAttachPop or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()

function ArtifactGoldTipsAttachPop:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/artifact_gold_tips_attach_pop"
    self.res_list = {
    }

    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.cloth_type = 1
end

function ArtifactGoldTipsAttachPop:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
        -- self.background:setSwallowTouches(false)
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.main_panel_size = self.main_panel:getContentSize()
    self.top_panel = self.main_panel:getChildByName("top_panel")
    self.top_panel_size = self.top_panel:getContentSize()
    self.spine_node = self.top_panel:getChildByName("spine_node")
    self.evt_effect = createEffectSpine("E90005", cc.p(0, 0), cc.p(0.5, 0.5), true, "action")
    self.spine_node:addChild(self.evt_effect)
    self.spine_node:setVisible(false)
    self.holy_icon = self.top_panel:getChildByName("holy_icon")
    self.hero_panel = self.top_panel:getChildByName("hero_panel")
    self.no_panel = self.hero_panel:getChildByName("no_panel")
    self.have_panel = self.hero_panel:getChildByName("have_panel")
    self.have_node = self.have_panel:getChildByName("have_node")
    self.change_btn = self.hero_panel:getChildByName("change_btn")
    self.title_panel = self.main_panel:getChildByName("title_panel")
    self.close_btn = self.title_panel:getChildByName("close_btn")
    self.imgTitleBg = self.title_panel:getChildByName("imgTitleBg")
    self.title = self.title_panel:getChildByName("title")
    self.title:setString(TI18N("语言_c_7550"))
    autoSizeTitleBg(self.title,self.imgTitleBg,120,332)
    self.attr_panel = self.main_panel:getChildByName("attr_panel")
    self.attr_panel_size = self.attr_panel:getContentSize()
    self.attr_panel:setVisible(false)
    self.baseattr_panel = self.attr_panel:getChildByName("baseattr_panel")
    self.baseattr_panel_size = self.baseattr_panel:getContentSize()
    self.baseattr_line_1 = self.baseattr_panel:getChildByName("line_1")
    self.baseattr_txt = self.baseattr_panel:getChildByName("baseattr_txt")
    self.baseattr_txt:setString(TI18N("语言_c_7441"))
    self.baseattr_line_2 = self.baseattr_panel:getChildByName("line_2")
    setTextMaxWidth(self.baseattr_txt,300,-8)
    setLeftRightImg(self.baseattr_line_1,self.baseattr_txt,self.baseattr_line_2)
    self.skill_panel = self.attr_panel:getChildByName("skill_panel")
    self.skill_panel_size = self.baseattr_panel:getContentSize()
    self.skill_scroll = self.skill_panel:getChildByName("skill_scroll")
    self.skill_scroll:setScrollBarEnabled(false)
    self.randattr_line_1 = self.skill_panel:getChildByName("line_1")
    self.skill_txt = self.skill_panel:getChildByName("skill_txt")
    self.skill_txt:setString(TI18N("语言_c_7551"))
    self.randattr_line_2 = self.skill_panel:getChildByName("line_2")
    setTextMaxWidth(self.skill_txt,300,-8)
    setLeftRightImg(self.randattr_line_1,self.skill_txt,self.randattr_line_2)
    self.attachBtn = self.main_panel:getChildByName("attachBtn")
    self.attachBtn_y = self.attachBtn:getPositionY()
    self.attachLabel = self.attachBtn:getChildByName("attachLabel")
    setTextSpacing(self.attachLabel,-8)
    self.attachLabel:setString(TI18N("语言_c_645"))
    self.refiningBtn = self.main_panel:getChildByName("refiningBtn")
    self.refining_txt = self.refiningBtn:getChildByName("refining_txt")
    setTextSpacing(self.refining_txt,-8)
    self.refining_txt:setChangeScaleOffWidth(10)
    self.refining_txt:setString(TI18N("语言_c_7552"))
    self.synthesisBtn = self.main_panel:getChildByName("synthesisBtn")
    self.synthesis_txt = self.synthesisBtn:getChildByName("synthesis_txt")
    self.synthesis_txt:setChangeScaleOffWidth(10)
    setTextSpacing(self.synthesis_txt,-8)
    self.synthesis_txt:setString(TI18N("语言_c_7553"))
    self.recastBtn = self.main_panel:getChildByName("recastBtn")
    self.recast_txt = self.recastBtn:getChildByName("recast_txt")
    self.recast_txt:setChangeScaleOffWidth(10)
    setTextSpacing(self.recast_txt,-8)
    self.recast_txt:setString(TI18N("语言_c_7554"))
    self.remove_btn = self.main_panel:getChildByName("remove_btn")
    self.remove_txt = self.remove_btn:getChildByName("remove_txt")
    self.remove_txt:setChangeScaleOffWidth(10)
    setTextSpacing(self.remove_txt,-8)
    self.remove_txt:setString(TI18N("语言_c_2964"))
    self.no_attr_panel = self.main_panel:getChildByName("no_attr_panel")
    self.no_tip = self.no_attr_panel:getChildByName("no_tip")
    setTextMaxWidth(self.no_tip,500)
    self.no_tip:setString(TI18N("语言_c_7454"))
    self.no_attr_panel:setVisible(false)
end
function ArtifactGoldTipsAttachPop:register_event()
    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn() end ,true, 1) 
    registerButtonEventListener(self.background, function() self:onClickCloseBtn() end ,false, 0) 
    registerButtonEventListener(self.attachBtn, function() self:onClickCloseBtn() end ,true, 0) 
    registerButtonEventListener(self.refiningBtn, function() self:onClickRefiningBtn() end ,true, 0) 
    registerButtonEventListener(self.recastBtn, function() self:onClickRecastBtn() end ,true, 0) 
    registerButtonEventListener(self.synthesisBtn, function() self:onClickSynthesisBtn() end ,true, 0) 
    registerButtonEventListener(self.remove_btn, function() self:onClickRemoveBtn() end ,true, 0) 
    registerButtonEventListener(self.change_btn, function()
        controller:openArtifactListWindow(true,self.pos_id,self.hero_vo.partner_id)
    end ,true, 0) 
    registerButtonEventListener(self.hero_panel, function()
        controller:openArtifactListWindow(true,self.pos_id,self.hero_vo.partner_id)
    end ,true, 0) 
    self:addGlobalEvent(HeroEvent.Holy_Equipment_Update_Event, function(hero_vo)
        if not hero_vo or not self.partnerId then return end
        if hero_vo.partner_id == self.partnerId then
            self:updateData()
        end
    end)
    self:addGlobalEvent(HeroEvent.Artifact_Save_Event, function()
        self:updateData()
    end)
    self:addGlobalEvent(HeroEvent.Artifact_Tempering_Event, function()
        self:updateData()
    end)
    self:addGlobalEvent(HeroEvent.Artifact_Update_Event, function(hero_vo)
        if hero_vo.partner_id == self.hero_vo.partner_id then
            self.hero_vo = hero_vo
            self:updateData()
        end
    end)
end

--关闭
function ArtifactGoldTipsAttachPop:onClickCloseBtn()
    controller:openArtifactGoldTipsAttachPop(false)
end
--淬炼
function ArtifactGoldTipsAttachPop:onClickRefiningBtn()
    controller:openArtifactTemperingWindow(true, self.soul_vo, self.hero_vo.partner_id) 
end
--重铸
function ArtifactGoldTipsAttachPop:onClickRecastBtn()
    controller:openArtifactGoldTipsAttachPop(false)
    controller:openArtifactRecastWindow(true, self.soul_vo, self.hero_vo.partner_id)
end
--合成
function ArtifactGoldTipsAttachPop:onClickSynthesisBtn()
    local config = Config.CityData.data_base[CenterSceneBuild.mall]
    if config == nil then return end
    local is_open = MainuiController:getInstance():checkIsOpenByActivate(config.activate)
    if is_open then
        controller:openArtifactGoldTips(false)
        controller:openArtifactGoldTipsAttachPop(false)
        ForgeHouseController:getInstance():openForgeHouseView(true, ForgeHouseConst.Tab_Index.Artifact)
    end
end
--卸下
function ArtifactGoldTipsAttachPop:onClickRemoveBtn()
    controller:sender11030(self.hero_vo.partner_id,self.pos_id,self.soul_vo.id,0)
end


function ArtifactGoldTipsAttachPop:openRootWnd(hero_vo,pos_id)
	if not hero_vo or not pos_id then
		return
	end
	self.hero_vo = hero_vo
	self.pos_id = pos_id
	self:updateData()
end
function ArtifactGoldTipsAttachPop:updateData()
    self.gold_artiface_data = self.hero_vo.golden_artifact[self.pos_id]
    self.soul_vo = self.hero_vo.artifact_list[self.pos_id]
    self:setTopPanel()
    if self.soul_vo and next(self.soul_vo) then
        self:setAttrPanel()
        self:setSkillPanel()
        self.no_attr_panel:setVisible(false)
        self.attr_panel:setVisible(true)
        self.attachBtn:setVisible(false)
        local item_id = self.soul_vo.base_id
        local cfg = Config.ItemData.data_get_data(item_id)
        if cfg.quality >= BackPackConst.quality.red then
            self.refiningBtn:setVisible(true)
            self.synthesisBtn:setVisible(false)
        else
            self.refiningBtn:setVisible(false)
            self.synthesisBtn:setVisible(true)
        end
        self.recastBtn:setVisible(true)
        self.remove_btn:setVisible(true)
    else
        self.no_attr_panel:setVisible(true)
        self.attr_panel:setVisible(false)
        self.attachBtn:setVisible(true)
        self.refiningBtn:setVisible(false)
        self.synthesisBtn:setVisible(false)
        self.recastBtn:setVisible(false)
        self.remove_btn:setVisible(false)
    end
end
--设置赋魂红点
function ArtifactGoldTipsAttachPop:updateSoulRed()
    local is_redpoint = HeroCalculate.checkSingleHeroArtifactGoldSoulRedPoint(self.hero_vo,self.pos_id)
    addRedPointToNodeByStatus(self.no_panel,is_redpoint,10,10)
end
--设置顶部
function ArtifactGoldTipsAttachPop:setTopPanel()
    local cfg = Config.PartnerArtifactGoldenData.data_artifact_by_index[self.pos_id]
    local res = PathTool.getResFrame("artifact_golden", cfg.icon)
    loadSpriteTexture(self.holy_icon, res, LOADTEXT_TYPE_PLIST)
    if self.soul_vo and next(self.soul_vo) then
        self.no_panel:setVisible(false)
        self.have_panel:setVisible(true)
        self.change_btn:setVisible(true)
        if not self.have_item then
            self.have_item = BackPackItem.new(true, true, true, 1, false, false)
            self.have_node:addChild(self.have_item)
        end
        self.have_item:setData(self.soul_vo)
        local fun = function ()
            controller:openArtifactTipsWindow(true, self.soul_vo, PartnerConst.ArtifactTips.normal, self.hero_vo.partner_id, self.pos_id, false)
        end
        self.have_item:addCallBack(fun)
        self.spine_node:setVisible(true)
    else
        self.no_panel:setVisible(true)
        self.have_panel:setVisible(false)
        self.change_btn:setVisible(false)
        self.spine_node:setVisible(false)
    end
    self:updateSoulRed()
end
--设置属性
function ArtifactGoldTipsAttachPop:setAttrPanel()
    if not self.attr_list then
        self.attr_list = {}
    end
    if self.attr_list and next(self.attr_list) then
        for k,v in pairs(self.attr_list) do
            v:removeFromParent()
            v=nil
        end
        self.attr_list = {}
    end
    if self.soul_vo and next(self.soul_vo) then
        for k,v in pairs(self.soul_vo.attr) do
            local item = ArtifactGoldAttrItem2.new()
            item:setData(v)
            local _x = 11 + (k-1)%2*296
            local _y = 90 - (math.floor((k-1)/2)+1) * (ArtifactGoldAttrItem2.Height+3)
            item:setPosition(cc.p(_x,_y))
            self.baseattr_panel:addChild(item)
            table.insert(self.attr_list,item)
        end
    end
end
--设置技能
function ArtifactGoldTipsAttachPop:setSkillPanel()
    if not self.skill_list then
        self.skill_list = {}
    end
    if self.skill_list and next(self.skill_list) then
        for k,v in pairs(self.skill_list) do
            v:removeFromParent()
            v=nil
        end
        self.skill_list = {}
    end
    if self.soul_vo and next(self.soul_vo) then --已赋魂
        local index = 0
        for i,value in ipairs(self.soul_vo.extra) do
            if value and value.extra_k and (value.extra_k == 1 or value.extra_k == 2 or value.extra_k == 8) then
                local skill_id = value.extra_v
                local item = ArtifactGoldSkillItem2.new()
                item:setData(skill_id)
                table.insert(self.skill_list,item)
                index = index + 1
                self.skill_scroll:addChild(item)
            end
        end
        local _h = math.max(index * ArtifactGoldSkillItem2.Height,self.skill_scroll:getContentSize().height)
        self.skill_scroll:setInnerContainerSize(cc.size(self.skill_scroll:getContentSize().width,_h))
        if self.skill_list and next(self.skill_list) then
            for k, v in ipairs(self.skill_list) do
                v:setPosition(cc.p(0,_h - k * ArtifactGoldSkillItem2.Height))
            end
            commonShowEmptyIcon(self.skill_scroll,false)
        else
            commonShowEmptyIcon(self.skill_scroll,true,{text = TI18N("语言_c_7555")})
        end
    end
end
function ArtifactGoldTipsAttachPop:close_callback()
    if self.evt_effect then
        self.evt_effect:clearTracks()
        self.evt_effect:removeFromParent()
        self.evt_effect=nil
    end
    if self.attr_list and next(self.attr_list) then
        for k,v in pairs(self.attr_list) do
            v:removeFromParent()
            v=nil
        end
    end
    if self.skill_list and next(self.skill_list) then
        for k,v in pairs(self.skill_list) do
            v:removeFromParent()
            v=nil
        end
    end
    controller:openArtifactGoldTipsAttachPop(false)
end