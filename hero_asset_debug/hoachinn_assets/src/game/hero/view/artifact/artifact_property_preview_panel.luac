ArtifactPropertyPreviewPanel = ArtifactPropertyPreviewPanel or BaseClass(BaseView)

local string_format = string.format
local table_insert = table.insert
local controller = HeroController:getInstance()
local model =  controller:getModel()

function ArtifactPropertyPreviewPanel:__init()
	self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/artifact_property_preview_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
end

function ArtifactPropertyPreviewPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 
	self.image_bg_1 = main_container:getChildByName("image_bg_1")
	self.container = main_container:getChildByName("container")
	self.win_title = main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_5188"))

end

function ArtifactPropertyPreviewPanel:setData(index)
	for i=1,3 do
		local item = ActionUpstarOrderItem.new()
		self.container:addChild(item)
		item:setPosition(cc.p(0,(3-i)*160))
		item:setData(i,index)
	end
	self.tips = createRichLabel(22,cc.c4b(0x70,0x40,0x30,0xff),cc.p(0.5,0.5),cc.p(200,30),FONT_COMMON_LINE_SPACE,nil,400)
	self.main_container:addChild(self.tips)
	self.tips:setString(TI18N("语言_c_5200"))
end
function ArtifactPropertyPreviewPanel:register_event(  )
	registerButtonEventListener(self.background, function ( )
		controller:openArtifactPropertyPreviewPanel(false)
	end)
end
function ArtifactPropertyPreviewPanel:openRootWnd(index)
	self:setData(index)
end

function ArtifactPropertyPreviewPanel:close_callback(  )
	controller:openArtifactPropertyPreviewPanel(false)
end



-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      属性预览子界面
-- Create: 2018-06-28
-- --------------------------------------------------------------------
ActionUpstarOrderItem = class("ActionUpstarOrderItem", function()
    return ccui.Widget:create()
end)

function ActionUpstarOrderItem:ctor()
    self:configUI()
    self:register_event()
	self.tips_list = {TI18N("语言_c_5201"),TI18N("语言_c_5202"),TI18N("语言_c_5203").."\n"..TI18N("语言_c_5204")}
	self.tips_list2 = {TI18N("语言_c_5201")..TI18N("语言_c_5205"),TI18N("语言_c_5202")..TI18N("语言_c_5205"),TI18N("语言_c_5203")..TI18N("语言_c_5205").."\n"..TI18N("语言_c_5204")..TI18N("语言_c_5205")}
end

function ActionUpstarOrderItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_property_preview_item"))
    self:addChild(self.root_wnd)
    self:setAnchorPoint(0, 0)
    self:setContentSize(cc.size(680, 120))
    self.main_container = self.root_wnd:getChildByName("main_container")
	self.stage = self.main_container:getChildByName("stage")
	self.Node_1 = self.main_container:getChildByName("Node_1")
	self.name = self.main_container:getChildByName("name")
	self.ScrollView = createScrollView(260, 70, 135, 10, self.main_container, ccui.ScrollViewDir.vertical)
	self.tip = createLabel(20, cc.c4b(0xff,0xff,0xff,0xff), nil, 0, 0, 12, self.ScrollView, 0, cc.p(0,1))
	self.tip:setWidth(258)
	self.tip:setLineSpacing(FONT_COMMON_LINE_SPACE)
	-- setTextMaxWidth(self.tip,258,FONT_COMMON_LINE_SPACE)
	self.current = self.main_container:getChildByName("current")
end

function ActionUpstarOrderItem:register_event()
end

function ActionUpstarOrderItem:setData(i,index)
	local item = BackPackItem.new(false, false, false, 0.8, false)
	self.Node_1:addChild(item)
	local cfg = Config.ItemData.data_get_data(10455 + i)
	item:setData(cfg)
	self.name:setString(cfg.name)
	self.stage:setString(string.format(TI18N("语言_c_5206"),StringUtil.numToChinese(i)))
	if 10455 + i == index then
		self.current:setVisible(true)
	else
		self.current:setVisible(false)
	end
	if 10455 + i == index then
		self.tip:setColor(cc.c4b(0x49,0xd8,0x09,0xff))
		self.tip:setString(self.tips_list2[i])
	else
		self.tip:setColor(cc.c4b(0x9b,0x91,0x87,0xff))
		self.tip:setString(self.tips_list[i])
	end
	local max_height = math.max(self.tip:getContentSize().height, 70)
	self.ScrollView:setInnerContainerSize(cc.size(self.ScrollView:getContentSize().width, max_height))
	self.ScrollView:setTouchEnabled(self.tip:getContentSize().height > 70)
	self.tip:setPositionY(max_height)
end

function ActionUpstarOrderItem:DeleteMe()
end
