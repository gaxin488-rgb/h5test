ArtifactGoldSkillTitleCell = class("ArtifactGoldSkillTitleCell", function()
    return ccui.Widget:create()
end)

ArtifactGoldSkillTitleCell.Width = 690
ArtifactGoldSkillTitleCell.Height = 40

function ArtifactGoldSkillTitleCell:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldSkillTitleCell:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_skill_title_cell"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function ArtifactGoldSkillTitleCell:registerEvent(  )
end

function ArtifactGoldSkillTitleCell:setData(str)
	self._ui._title:setString(str)
end
function ArtifactGoldSkillTitleCell:addCallBack(add_back)
    self.add_back = add_back
end
function ArtifactGoldSkillTitleCell:setOpacity(opacity)
	self._ui._bg_1:setOpacity(opacity or 40)
	self._ui._bg_2:setOpacity(opacity or 40)
end

function ArtifactGoldSkillTitleCell:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end