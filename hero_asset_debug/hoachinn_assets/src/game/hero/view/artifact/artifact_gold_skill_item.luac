ArtifactGoldSkillItem = class("ArtifactGoldSkillItem", function()
    return ccui.Widget:create()
end)

ArtifactGoldSkillItem.Width = 119
ArtifactGoldSkillItem.Height = 119

function ArtifactGoldSkillItem:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldSkillItem:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_skill_item"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
    self._ui._main_container:setSwallowTouches(false)
    self._ui._now_txt:setVisible(false)
end

function ArtifactGoldSkillItem:registerEvent(  )
end

function ArtifactGoldSkillItem:getData()
    return self.data or {}
end

function ArtifactGoldSkillItem:setData(data,is_hero)
    self.data = data
    self.skill_id = self.data.skill_id
    self.hero_vo = self.data.hero_vo
    self.is_hero = is_hero
    local skill_cfg = Config.SkillData.data_get_skill(self.skill_id)
    if not skill_cfg then return end
    if not self.skill_item then
        self.skill_item = SkillItem.new(true, true, false, 1, true)
        self._ui._skill_node:addChild(self.skill_item)
    end
    self.skill_item:setClickInfo({clickScroll=true,click=true})
    self.skill_item:setData(skill_cfg)    
    local model = HeroController:getInstance():getModel()
    local hero_data = model:getArtifactExclusiveSkillUseListForId(self.skill_id)
    if is_hero and hero_data and next(hero_data) then
        self.skill_item:setHeroHead(true,hero_data.pid)
    else
        self.skill_item:setHeroHead(false)
    end
    if self.data.is_act == 1 then
        self.skill_item:showLockIcon(false,nil,nil,nil,nil,false)
    else
        self.skill_item:showLockIcon(true,nil,nil,nil,nil,true)
    end
    self._ui._now_txt:setVisible(is_hero and self.data.is_use == 1)
    self:updateRed()
end
function ArtifactGoldSkillItem:addCallBack(add_back)
    if self.skill_item then
        self.skill_item:addCallBack(add_back)
    end
end
function ArtifactGoldSkillItem:addLongTimeTouchCallback()
    if self.skill_item then
        self.skill_item:addLongTimeTouchCallback()
    end
end
function ArtifactGoldSkillItem:setTickSelected(status)
    if self.skill_item then
        self.skill_item:setTickSelected(status)
    end
end
function ArtifactGoldSkillItem:updateRed()
    local status = false
    if self.is_hero then
        status = HeroCalculate.checkSingleHeroArtifactGoldSkillStartRedPoint(self.skill_id)
        if not status then
            status = HeroCalculate.checkSingleHeroArtifactGoldSkillUpRedPoint(self.skill_id)
        end 
    end
    addRedPointToNodeByStatus(self.skill_item,status,10,10)
end
function ArtifactGoldSkillItem:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end