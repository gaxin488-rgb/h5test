ArtifactGoldSkillItem1 = class("ArtifactGoldSkillItem1", function()
    return ccui.Widget:create()
end)

ArtifactGoldSkillItem1.Width = 606
ArtifactGoldSkillItem1.Height = 118

function ArtifactGoldSkillItem1:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldSkillItem1:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_skill_item_1"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 0))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
    self.skill_des = createRichLabel(20,cc.c3b(0xc1,0xb7,0xab),cc.p(0,1),cc.p(0,0),nil,nil,460)
    self._ui._skill_scroll:addChild(self.skill_des)
    self._ui._skill_scroll:setScrollBarEnabled(false)
end

function ArtifactGoldSkillItem1:registerEvent(  )
    registerButtonEventListener(self._ui._change_btn, function()
        if self.add_back then
            self:add_back()
        end
    end ,true, 2)
end

function ArtifactGoldSkillItem1:setData(skill_id,is_change_btn)
    local skill_cfg = Config.SkillData.data_get_skill(skill_id)
    if not skill_cfg then return end
    if not self.skill_item then
        self.skill_item = SkillItem.new(true, true, true, 0.85, true)
        self._ui._skill_node:addChild(self.skill_item)
        -- self._ui._skill_node:setPosition(cc.p(67,64))
    end
    self.skill_item:setData(skill_cfg)
    local lev = skill_cfg.level
    if skill_cfg.client_lev and skill_cfg.client_lev>0 then
        lev = skill_cfg.client_lev
    end    
    self._ui._skill_name:setString(skill_cfg.name..string.format(TI18N("语言_c_4520"),lev))
    self.skill_des:setString(skill_cfg.des)
    local _h = math.max(self._ui._skill_scroll:getContentSize().height,self.skill_des:getContentSize().height)
    if _h > self._ui._skill_scroll:getContentSize().height then
        self._ui._skill_scroll:setInnerContainerSize(cc.size(self._ui._skill_scroll:getContentSize().width,_h))
    end
    self.skill_des:setPositionY(_h)
    self._ui._change_btn:setVisible(is_change_btn)

end
function ArtifactGoldSkillItem1:addCallBack(add_back)
    self.add_back = add_back
end

function ArtifactGoldSkillItem1:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end