ArtifactGoldAttrItem4 = class("ArtifactGoldAttrItem4", function()
    return ccui.Widget:create()
end)
ArtifactGoldAttrItem4.Width = 300
ArtifactGoldAttrItem4.Height = 42

function ArtifactGoldAttrItem4:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldAttrItem4:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_attr_item_4"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function ArtifactGoldAttrItem4:registerEvent(  )
end

function ArtifactGoldAttrItem4:setData(data,is_now)
    local attr_name = data[1]
    local attr_val = data[2]
    local next_attr_val = data[3]
    local icon = PathTool.getAttrIconByStr(attr_name)
    local res = PathTool.getResFrame("common", icon)
    loadSpriteTexture(self._ui._attr_icon, res, LOADTEXT_TYPE_PLIST)
    local _txt = Config.AttrData.data_key_to_name[attr_name]
    if not _txt then
        _txt = Config.AttrExtraData.data_key_to_name[attr_name]
    end
    local num = 10
    if judgingLanguage() then
        num = 5
    end
    self._ui._attr_name:setString(transformTextToShort(_txt,num))
    addEvt2showAllTextTips(self._ui._attr_name,_txt,num,nil,nil,nil,nil,true)
    local is_per = PartnerCalculate.isShowPerByStr(attr_name)
    if is_per == true then
        attr_val = (attr_val/10).."%"
        if next_attr_val then
            next_attr_val = (next_attr_val/10).."%"
        end
    end
    if is_now then
        self._ui._attr_value:setVisible(true)
        self._ui._attr_value:setString("+"..attr_val)
        self._ui._attr_max_value:setString("/"..next_attr_val)
        self._ui._attr_value:setPositionX(self._ui._attr_max_value:getPositionX() - self._ui._attr_max_value:getContentSize().width)
    else
        self._ui._attr_value:setVisible(false)
        self._ui._attr_max_value:setString(next_attr_val)
    end
end

function ArtifactGoldAttrItem4:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end