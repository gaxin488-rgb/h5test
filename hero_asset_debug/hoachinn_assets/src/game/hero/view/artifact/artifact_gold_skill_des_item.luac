ArtifactGoldSkillDesItem = class("ArtifactGoldSkillDesItem", function()
    return ccui.Widget:create()
end)

function ArtifactGoldSkillDesItem:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldSkillDesItem:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_skill_des_item"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)

    self.skill_des = createRichLabel(20,cc.c3b(0x6d,0x3c,0x2d),cc.p(0,1),cc.p(0,0),nil,nil,560)
    self.root_wnd:addChild(self.skill_des)
    self.skill_tip = createRichLabel(20,cc.c3b(0xff,0x15,0x15),cc.p(1,0),cc.p(self.size.width-10,0),nil,nil,560)
    self.root_wnd:addChild(self.skill_tip)


end

function ArtifactGoldSkillDesItem:registerEvent(  )
    
end

function ArtifactGoldSkillDesItem:setData(skill_id,is_act)
    local skill_cfg = Config.SkillData.data_get_skill(skill_id)
    if not skill_cfg then return end
    local cfg = Config.PartnerArtifactGoldenData.data_skill_1[skill_id]
    local res = PathTool.getPlistImgForDownLoad("hero", "txt_cn_level_"..cfg.skill_lv)
    if is_act then
        self.skill_tip:setVisible(false)
        setChildUnEnabled(false,self.skill_des)
        self.skill_des:setString(string.format("<div><img src=%s />%s</div>",res,skill_cfg.des))
        self.skill_tip:setString("")
    else
        self.skill_tip:setVisible(true)
        self.skill_tip:setString(string.format(TI18N("语言_c_7546"),cfg.skill_lv))
        self.skill_des:setString(string.format("<div fontcolor=#8d8177><img src=%s />%s</div>",res,skill_cfg.des))
        setChildUnEnabled(true,self.skill_des)
    end
    local _h = self.skill_des:getContentSize().height + self.skill_tip:getContentSize().height + 12
    self.size = cc.size(self.size.width,_h)
    self:setContentSize(self.size)
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setPositionY(_h*0.5)
    self.skill_des:setPositionY(_h-5)
    self.skill_tip:setPositionY(5)
end

function ArtifactGoldSkillDesItem:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end