-- @description    : 
		-- 金色秘卷消耗道具item
---------------------------------
ArtifactGoldCostItem = class("ArtifactGoldCostItem", function()
    return ccui.Widget:create()
end)

ArtifactGoldCostItem.Width = 148
ArtifactGoldCostItem.Height = 36

function ArtifactGoldCostItem:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldCostItem:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_cost_item"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function ArtifactGoldCostItem:registerEvent(  )
	if self.add_goods == nil then
        self.add_goods = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function(bag_code,temp_add)
			for i,item in pairs(temp_add) do
				if item.config and item.config.id == self.need_id then
					self:updateTxt()
					break
				end
			end
        end)
    end
    if self.delete_goods == nil then
        self.delete_goods = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function(bag_code,temp_del)
			for i,item in pairs(temp_del) do
				if item.config and item.config.id == self.need_id then
					self:updateTxt()
					break
				end
			end
        end)
    end
    if self.modify_goods_num == nil then
        self.modify_goods_num = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_list)
			for i,item in pairs(temp_list) do
				if item.config and item.config.id == self.need_id then
					self:updateTxt()
					break
				end
			end
        end)
    end
	registerButtonEventListener(self._ui._add_btn, function() self:onClickAddBtn() end ,true, 1) 
end
function ArtifactGoldCostItem:onClickAddBtn()
	BackpackController:getInstance():openTipsSource(true, self.need_id)
end
function ArtifactGoldCostItem:updateTxt()
	local ui = self._ui
	self.have_num = BackpackController:getInstance():getModel():getItemNumByBid(self.need_id)
	if self.have_num >= self.need_num then
		ui._item_num:setTextColor(cc.c3b(0x0e, 0xa8, 0x0e))
	else
		ui._item_num:setTextColor(cc.c3b(0xff, 0x15, 0x15))
	end
	ui._item_num:setString(string.format("%s/%s",MoneyTool.GetMoneyString(self.have_num), MoneyTool.GetMoneyString(self.need_num)))
end
function ArtifactGoldCostItem:setData(data)
	local ui = self._ui
	self.data = data
	self.need_id = self.data[1]
	self.need_num = self.data[2]
	self.item_cfg = Config.ItemData.data_get_data(self.need_id)
	local res = PathTool.getItemRes(self.item_cfg.icon)
	ui._item_icon:loadTexture(res,LOADTEXT_TYPE)
	self:updateTxt()
end

function ArtifactGoldCostItem:DeleteMe(  )	
    if self.add_goods ~= nil then
        GlobalEvent:getInstance():UnBind(self.add_goods)
        self.add_goods = nil
    end
    if self.delete_goods ~= nil then
        GlobalEvent:getInstance():UnBind(self.delete_goods)
        self.delete_goods = nil
    end
    if self.modify_goods_num ~= nil then
        GlobalEvent:getInstance():UnBind(self.modify_goods_num)
        self.modify_goods_num = nil
    end
	self:removeAllChildren()
	self:removeFromParent()
end