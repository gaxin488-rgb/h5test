-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      魂器item
-- <br/> 2021年5月13日
-- --------------------------------------------------------------------
GoldArtifactItem = class("GoldArtifactItem", function()
    return ccui.Widget:create()
end)

function GoldArtifactItem:ctor()
    self:configUI()
    self:register_event()
end

function GoldArtifactItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/gold_artifact_item"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)

    self._ui._lv_bg_tip:setVisible(false)
    self._ui._lv_bg:setVisible(false)
    self._ui._lv_txt_tip:setChangeScaleOffWidth(-999)
end

function GoldArtifactItem:register_event()
    self._ui._main_panel:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            if self.callback then
                self.callback()
            end
        end
    end)
end
--show_type 1非tips 用_lv_bg  2tips 用_lv_bg_tip
function GoldArtifactItem:setData(setting)
    if not setting then return end
    self.data = setting.data
    self.show_type = setting.show_type
    self.callback = setting.callback
    self._ui._lv_bg_tip:setVisible(self.show_type == HeroConst.Artiface_Gold_Type.tip)
    self._ui._lv_bg:setVisible(self.show_type == HeroConst.Artiface_Gold_Type.no_tip)
    self._ui._lv_txt:setString(self.data.enhance_level.." ")
    self._ui._lv_txt_tip:setString(self.data.enhance_level.." ")
    local icon_item = Config.PartnerArtifactGoldenData.data_artifact_by_id[self.data.artifact_id].icon
    local res = PathTool.getResFrame("artifact_golden", icon_item)
    loadSpriteTexture(self._ui._icon, res, LOADTEXT_TYPE_PLIST)
    self._ui._icon:setScale(0.65)
end

function GoldArtifactItem:DeleteMe()

end

