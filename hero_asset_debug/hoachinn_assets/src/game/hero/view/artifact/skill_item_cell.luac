SkillItemCell = SkillItemCell or class("SkillItemCell", CommonListViewBaseCell)

---@class SkillItemCellParams
---@field itemParams table @ SkillItem 列表参数数组
---@field refreshCb function @ 刷新时触发 自定义刷新函数 function（item, data, cell）

---@param params SkillItemCellParams
SkillItemCell.create = function (params)
	local cell = ccui.Layout:create()
	nativeBindClass(cell, SkillItemCell, params)
	return cell
end

---@param params SkillItemCellParams
function SkillItemCell:ctor(params)
	params = params or {}
	self._params = params
	local itemParams = params.itemParams or {}
	local item = SkillItem.new(unpack(itemParams, 1, #itemParams))
	self:addChild(item)

	local size = item:getSizeByScale()
	self:setContentSize(size)
	item:setPosition(cc.p(size.width/2, size.height/2))
	self._item = item
	self._refreshCb = params.refreshCb
end

function SkillItemCell:refresh()
	if self._refreshCb then
		self._refreshCb(self._item, self._data, self)
	else
		self._item:setData(self._data)
	end
end

