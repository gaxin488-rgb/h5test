		-- 金色秘卷属性词条
---------------------------------
ArtifactGoldAttrItem3 = class("ArtifactGoldAttrItem3", function()
    return ccui.Widget:create()
end)
ArtifactGoldAttrItem3.Width = 690
ArtifactGoldAttrItem3.Height = 48

function ArtifactGoldAttrItem3:ctor()
	self:configUI()
	self:registerEvent()
end

function ArtifactGoldAttrItem3:configUI(  )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/artifact_gold_attr_item_3"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 0))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function ArtifactGoldAttrItem3:registerEvent(  )
end

function ArtifactGoldAttrItem3:setData(data,index)
    local attr_name = data[1]
    local attr_val = data[2]
    local next_attr_val = data[3]
    local icon = PathTool.getAttrIconByStr(attr_name)
    local res = PathTool.getResFrame("common", icon)
    loadSpriteTexture(self._ui._icon, res, LOADTEXT_TYPE_PLIST)
    local _txt = Config.AttrData.data_key_to_name[attr_name]
    if not _txt then
        _txt = Config.AttrExtraData.data_key_to_name[attr_name]
    end
    local num = 10
    if judgingLanguage() then
        num = 5
    end
    self._ui._name:setString(transformTextToShort(_txt,num))
    addEvt2showAllTextTips(self._ui._name,_txt,num,nil,nil,nil,nil,true)
    local is_per = PartnerCalculate.isShowPerByStr(attr_name)
    if is_per == true then
        attr_val = (attr_val/10).."%"
        if next_attr_val then
            next_attr_val = (next_attr_val/10).."%"
        end
    end
    self._ui._now_value:setString(attr_val)
    if next_attr_val then
        self._ui._next_value:setString(next_attr_val)
    else
        self._ui._next_value:setString(TI18N("语言_c_7028"))
    end
    self._ui._bg:setVisible(index%2==0)
end

function ArtifactGoldAttrItem3:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end