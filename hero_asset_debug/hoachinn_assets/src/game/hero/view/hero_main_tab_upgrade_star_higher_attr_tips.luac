local _controller = HeroController:getInstance()
local _model = HeroController:getInstance():getModel()
local _string_format = string.format
local _table_insert = table.insert

HeroMainTabUpgradeStarHigherAttrtips = HeroMainTabUpgradeStarHigherAttrtips or BaseClass(BaseView)

function HeroMainTabUpgradeStarHigherAttrtips:__init()
    self.is_full_screen = false  
    self.win_type = WinType.Mini 
    self.view_tag = ViewMgrTag.DIALOGUE_TAG  
    self.layout_name = "hero/hero_main_tab_upgrade_star_higher_attr_tips"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }

    self.plan_data = {}
end

function HeroMainTabUpgradeStarHigherAttrtips:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.title_label = self.main_panel:getChildByName("title_label")
    setTextMaxWidth(self.title_label, 440, -10)
    self.title_label:setString(TI18N("语言_c_4391"))
    self.list_panel = self.main_panel:getChildByName("list_panel")
end

function HeroMainTabUpgradeStarHigherAttrtips:register_event()
	registerButtonEventListener(self.background, function()
		_controller:openHeroMainTabUpgradeStarHigherAttrtips(false)
	end, false, 2)
end

function HeroMainTabUpgradeStarHigherAttrtips:openRootWnd(obj)
    self.hero_vo = obj.hero_vo
    if self.hero_vo.star == 16 then
        self.title_label:setTextColor(cc.c4b(0xfd, 0xd5, 0x7e, 0xff))
        self.title_label:setFontSize(32)
        self.title_label:setString(TI18N("语言_c_7578"))
    end
    self.index = obj.index
    local scroll_view_size = self.list_panel:getContentSize()
    local setting = {
        start_x = 0,                   -- 第一个单元的X起点
        space_x = 0,                   -- x方向的间隔
        start_y = 0,                   -- 第一个单元的Y起点
        space_y = 10,                   -- y方向的间隔
        item_width = 416,              -- 单元的尺寸width
        item_height = 180,              -- 单元的尺寸height
        row = 0,                       -- 行数，作用于水平滚动类型
        col = 1,                       -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.plan_scrollview = CommonScrollViewSingleLayout.new(self.list_panel, cc.p(0, 0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.plan_scrollview:setSwallowTouches(false)

    self.plan_scrollview:registerScriptHandlerSingle(handler(self,self._createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
    self.plan_scrollview:registerScriptHandlerSingle(handler(self,self._numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
    self.plan_scrollview:registerScriptHandlerSingle(handler(self,self._updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    -- self.plan_scrollview:setClickEnabled(false)
    -- if self.hero_vo.star >= 13 then
    --     self.plan_scrollview:setClickEnabled(true)
    -- end
	self.plan_scrollview:reloadData()
end

function HeroMainTabUpgradeStarHigherAttrtips:_createNewCell(width, height)
    local cell = HeroMainTabUpgradeStarHigherAttrtipsItem.new(width, height, self.hero_vo.star)
    cell:setExtendData(self.hero_vo)
    return cell
end

function HeroMainTabUpgradeStarHigherAttrtips:_numberOfCells()
    if self.index == 1 then
        if self.hero_vo.star == 14 or self.hero_vo.star == 16 then
            return 5
        else
            return 4
        end
    else
        return 2
    end
end

function HeroMainTabUpgradeStarHigherAttrtips:_updateCellByIndex(cell, index)
    cell.index = index
    cell:setData(index,self.index)
end

function HeroMainTabUpgradeStarHigherAttrtips:close_callback( )
	_controller:openHeroMainTabUpgradeStarHigherAttrtips(false)
end


----------------------------@ item
HeroMainTabUpgradeStarHigherAttrtipsItem = class("HeroMainTabUpgradeStarHigherAttrtipsItem", function()
    return ccui.Widget:create()
end)

function HeroMainTabUpgradeStarHigherAttrtipsItem:ctor(width, height,star)
	self.size = cc.size(width, height)
    self:setContentSize(self.size)
    self.label_attr_des_list = {}
    self:layoutUI(star)
    self:registerEvents()
end

function HeroMainTabUpgradeStarHigherAttrtipsItem:layoutUI(star)
    if star == 16 then
        self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_main_tab_upgrade_star_higher_attr_tips_item2"))
    else
        self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_main_tab_upgrade_star_higher_attr_tips_item"))
    end
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(416,180))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.img_starup_star = self.main_container:getChildByName("img_starup_star")
    self.label_index = self.main_container:getChildByName("label_index")
    self.label_attr_des_list = {
        self.main_container:getChildByName("label_attr_des_1"),
        self.main_container:getChildByName("label_attr_des_2"),
        self.main_container:getChildByName("label_attr_des_3"),
        self.main_container:getChildByName("label_attr_des_4"),
        self.main_container:getChildByName("label_attr_des_5"),
    }
end

function HeroMainTabUpgradeStarHigherAttrtipsItem:registerEvents()
end
function HeroMainTabUpgradeStarHigherAttrtipsItem:setData(index,page_index)
    local key = getNorKey(self.hero_vo.bid, self.hero_vo.star, index)
    local star_rank_config = {}
    if page_index == 1 then
        star_rank_config = Config.PartnerData.data_partner_star_step(key)
    else
        star_rank_config = Config.PartnerSpecialData.data_partner_star_step(key)
    end
    if star_rank_config then
        local attr_show = star_rank_config.attr_show
        local _z = #attr_show
        for p,q in ipairs(self.label_attr_des_list) do
            q:setVisible(attr_show[p] ~= nil)
            if attr_show[p] then
                local str = attr_show[p][1]
                if #attr_show[p] > 1 then
                    str = string.format(attr_show[p][1], attr_show[p][2])
                end
                -- q:setString(transformTextToShort(str,20))
                -- q:setTouchEnabled(true)
                -- addEvt2showAllTextTips(q,str,20)
                if transformTextToShortByWidth(q, str, 260) then
                    q:setTouchEnabled(true)
                    q:setSwallowTouches(false)
                    addEvt2showAllTextTips(q,str,0)
                else
                    addEvt2showAllTextTips(q,"",0)
                end
            end
        end
        self.label_index:setString(TI18N("语言_c_1")..index)
        if _model:checkStarStepCompleteByIndex(self.hero_vo, index) then
            setChildUnEnabled(false, self, cc.c4b(0x9e,0x50,0x1b,0xff))
        else
            setChildUnEnabled(true, self, cc.c4b(0x7f,0x7f,0x7f,0xff))
        end
        if self.hero_vo.star >= 13 and self.hero_vo.star < 16 then
            local res = PathTool.getResFrame("hero/hero_star", "hero_star_10")
            self.img_starup_star:loadTexture(res, LOADTEXT_TYPE_PLIST)
            self.img_starup_star:ignoreContentAdaptWithSize(true)
            self.img_starup_star:setScale(1)
        end
        if self.hero_vo.star == 16 then
            self.label_index:setVisible(false)
            self.star_node = self.main_container:getChildByName("Node_2")
            self:updateTopBanner(index,_z)
            for i, v in ipairs(self.star_list or {}) do
                v:removeFromParent()
            end
            self.star_list = {}
            if not self.star_list or not next(self.star_list) then
                self.star_list = createOnlyStar(index,self.star_node,17,{res=PathTool.getResFrame("common_1","common_1_580")})
            end
            
        end
    else
        local attr_show = {
            [1]={
                [1] = Config.PartnerData.data_partner_const.staropen15_halo_text.desc
            },
            [2]={
                [1]=Config.PartnerData.data_partner_const.staropen15_frame_text.desc
            }
        }
        for p,q in ipairs(self.label_attr_des_list) do
            q:setVisible(attr_show[p] ~= nil)
            if attr_show[p] then
                local str = attr_show[p][1]
                if #attr_show[p] > 1 then
                    str = string.format(attr_show[p][1], attr_show[p][2])
                end
                q:setString(transformTextToShort(str,20))
                q:setTouchEnabled(true)
                addEvt2showAllTextTips(q,str,20)
            end
        end
        self.label_index:setString(string.format(TI18N("语言_c_6876"),self.hero_vo.star+1))
        setChildUnEnabled(true, self, cc.c4b(0x7f,0x7f,0x7f,0xff))
        if self.hero_vo.star >= 13 then
            local res = PathTool.getResFrame("hero/hero_star", "hero_star_10")
            self.img_starup_star:loadTexture(res, LOADTEXT_TYPE_PLIST)
            self.img_starup_star:ignoreContentAdaptWithSize(true)
            self.img_starup_star:setScale(1)
        end
    end
end

function HeroMainTabUpgradeStarHigherAttrtipsItem:updateTopBanner(index,p)
    local star = self.hero_vo.star
    local star_rank = index
    local talent_cfg = Config.PartnerSkillData.data_partner_skill_pos
    local is_talent = false
    local tal_num = 0
    for k, v in pairs(talent_cfg) do
        local limit = v.pos_limit
        local limit_star = limit[2]
        local limit_rank = limit[3]
        if star == limit_star and limit_rank == star_rank then
            is_talent = true
            tal_num = v.pos
            break
        end
    end
    if is_talent then
        local str = TI18N("语言_c_7579")
        -- self.label_attr_des_list[p+1]:setString(string.format(str,tal_num-3))
        if transformTextToShortByWidth(self.label_attr_des_list[p+1], string.format(str,tal_num-3), 260) then
            self.label_attr_des_list[p+1]:setTouchEnabled(true)
            self.label_attr_des_list[p+1]:setSwallowTouches(false)
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],string.format(str,tal_num-3),0)
        else
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],"",0)
        end
        self.label_attr_des_list[p+1]:setVisible(true)
        return
    end
    
    local mijuan_cfg = Config.PartnerArtifactGoldenData.data_const
    local lmijuan_1 = mijuan_cfg.golden_scroll_condition_1
    local limit_cond = lmijuan_1.val
    if star == limit_cond[1] and star_rank == limit_cond[2] then
        local str = TI18N("语言_c_7580") --"解锁金色秘卷1"
        -- self.label_attr_des_list[p+1]:setString(string.format(str,1))
        if transformTextToShortByWidth(self.label_attr_des_list[p+1], string.format(str,1), 260) then
            self.label_attr_des_list[p+1]:setTouchEnabled(true)
            self.label_attr_des_list[p+1]:setSwallowTouches(false)
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],string.format(str,1),0)
        else
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],"",0)
        end
        self.label_attr_des_list[p+1]:setVisible(true)
        return
    end

    local lmijuan_2 = mijuan_cfg.golden_scroll_condition_2
    local limit_cond = lmijuan_2.val
    if star == limit_cond[1] and star_rank == limit_cond[2] then
        local str = TI18N("语言_c_7580")
        -- self.label_attr_des_list[p+1]:setString(string.format(str,2))
        if transformTextToShortByWidth(self.label_attr_des_list[p+1], string.format(str,2), 260) then
            self.label_attr_des_list[p+1]:setTouchEnabled(true)
            self.label_attr_des_list[p+1]:setSwallowTouches(false)
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],string.format(str,2),0)
        else
            addEvt2showAllTextTips(self.label_attr_des_list[p+1],"",0)
        end
        self.label_attr_des_list[p+1]:setVisible(true)
    end
end

function HeroMainTabUpgradeStarHigherAttrtipsItem:setExtendData(hero_vo)
	self.hero_vo = hero_vo
end

function HeroMainTabUpgradeStarHigherAttrtipsItem:DeleteMe()
end