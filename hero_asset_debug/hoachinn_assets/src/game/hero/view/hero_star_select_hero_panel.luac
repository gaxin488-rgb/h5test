HeroStarSelectHeroPanel = HeroStarSelectHeroPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_remove = table.remove

function HeroStarSelectHeroPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Tips   
    self.is_full_screen = false
    self.layout_name = "hero/hero_select_hero_panel"

    self.res_list = {

    }
    --阵营
    self.select_camp = -1

end

function HeroStarSelectHeroPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2) 
    self.title = self.main_container:getChildByName("win_title")
    self.title:setString(TI18N("语言_c_3090"))

    self.lay_scrollview = self.main_container:getChildByName("lay_scrollview")
    self.tip = self.main_container:getChildByName("tip")
    self.tip:setChangeScaleOffWidth(80)
    self.tip:setString(TI18N("语言_c_6858"))
    self.tip:setVisible(true)
    self.cancel_btn = self.main_container:getChildByName("cancel_btn")
    self.cancel_btn_label = self.cancel_btn:getChildByName("label")
    self.cancel_btn_label:setString(TI18N("语言_c_395"))

    self.common_btn = self.main_container:getChildByName("common_btn")
    self.common_btn_label = self.common_btn:getChildByName("label")
    self.common_btn_label:setString(TI18N("语言_c_261"))

    -- self.tips_label = createRichLabel(22, cc.c4b(0x64,0x32,0x23,0xff), cc.p(0,0.5),cc.p(40, 530),nil,nil,1900)
    -- self.main_container:addChild(self.tips_label)
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.camp_pos = {
        [1] = cc.p(-225,0),
        [2] = cc.p(-150,0),
        [3] = cc.p(-75,0),
        [4] = cc.p(-0,0),
        [5] = cc.p(75,0),
        [6] = cc.p(150,0),
        [7] = cc.p(225,0),
    }
    local camp_node = self.main_container:getChildByName("camp_node")
    self.camp_btn_list = {}
    self.camp_btn_list_1 = {}
    self.camp_btn_list_1[0] = camp_node:getChildByName("camp_btn0")
    self.camp_btn_list_1[1] = camp_node:getChildByName("camp_btn1")
    self.camp_btn_list_1[2] = camp_node:getChildByName("camp_btn2")
    self.camp_btn_list_1[3] = camp_node:getChildByName("camp_btn3")
    self.camp_btn_list_1[4] = camp_node:getChildByName("camp_btn4")
    self.camp_btn_list_1[5] = camp_node:getChildByName("camp_btn5")
    self.camp_btn_list_1[7] = camp_node:getChildByName("camp_btn6")
    
    self.data_const = Config.ResonateData.data_const
    self.starLimit = self.data_const["star_cell_ele_limit"].val
    for key, value in pairs(self.camp_btn_list_1) do
        if key == HeroConst.CampType.eAlien then
            if model:checkSoulHeroIsOpen() and table.indexof(self.starLimit,key) then
                value:setVisible(true)
                value.camp = key
                table.insert(self.camp_btn_list,value)
            else
                value:setVisible(false)
            end
        elseif key == 0 then
            value:setVisible(true)
            value.camp = key
            table.insert(self.camp_btn_list,value)
        else
            if table.indexof(self.starLimit,key) then
                value:setVisible(true)
                value.camp = key
                table.insert(self.camp_btn_list,value)
            else
                value:setVisible(false)
            end
        end
    end
    for key, value in pairs(self.camp_btn_list) do
        value:setPosition(self.camp_pos[key])
    end
    self.img_select = camp_node:getChildByName("img_select")
    local x, y = self.camp_btn_list[1]:getPosition()
    self.img_select:setPosition(x - 0.5, y + 1)
end

function HeroStarSelectHeroPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self._onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose) ,true, 1)
    registerButtonEventListener(self.cancel_btn, handler(self, self._onClickBtnCancel) ,true, 2)
    registerButtonEventListener(self.common_btn, handler(self, self._onClickBtnComfirm) ,true, 2)
    --阵营按钮
    for index, v in pairs(self.camp_btn_list) do
        registerButtonEventListener(v, function() self:onClickBtnShowByIndex(v.camp,v:getPositionX()) end ,true, 2)
    end

    self:addGlobalEvent(TipsEvent.TipsGoToEvent, function( )
        self:_onClickBtnClose()
    end)
end
--显示根据类型 0表示全部
function HeroStarSelectHeroPanel:onClickBtnShowByIndex(index, pos)
    if pos then
        self.img_select:setPosition(pos - 0.5, 1)
    else
        if self.img_select and self.camp_pos[index+1] then
            local x = self.camp_pos[index+1].x
            local y = self.camp_pos[index+1].y
            self.img_select:setPosition(x - 0.5, y + 1)
        end
    end
    self:updateHeroList(index)
end
--关闭
function HeroStarSelectHeroPanel:_onClickBtnClose()
    controller:openHeroStarSelectHeroPanel(false)
end

--选择
function HeroStarSelectHeroPanel:_onClickBtnCancel()
    self:_onClickBtnClose()
end
--是否需要激活皮肤
function HeroStarSelectHeroPanel:checkSkin()
    for key, value in pairs(self.dic_cur_select_list) do
        local data = model:getStarData()
        if value.star == 13 and ((model:getMinStar(data) == 13 and model:getMinStarStep(data) ~= 0) or (model:getMinStar(data) > 13)) then
            local config4 = Config.PartnerData.data_partner_base[value.bid]
            if config4 and config4.high_star_limit and config4.high_star_limit ~= 0 then
                if not HeroController:getInstance():getModel():isUnlockHeroSkin(config4.high_star_limit) then
                    local skin_cfg = Config.PartnerSkinData.data_skin_info[config4.high_star_limit]
                    if skin_cfg then
                        local str = string.format(TI18N("语言_c_6512"),skin_cfg.skin_name)
                        CommonAlert.show( str, TI18N("语言_c_7"), function()
                            local setting = {}
                            setting.hero_vo = value
                            setting.is_look = true
                            controller:openHeroDrawMainWindow(true, setting)
                        end, TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_154"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
                        return false
                    end
                end
            end
        end
    end
    return true
end
--选择
function HeroStarSelectHeroPanel:_onClickBtnComfirm()
    if not self.dic_cur_select_list then return end
    if self:checkSkin() then
        GlobalEvent:getInstance():Fire(HeroEvent.Select_Hero_star_Event, self.dic_cur_select_list, self.form_type)
    end
    self:_onClickBtnClose()
end

--setting.select_condition 选择条件 
--setting.select_condition.star 表示过滤星级    注意: 和star_start, star_end 互斥 优先 star的
--setting.select_condition.star_start 表示过滤开始
--setting.select_condition.star_end 表示过滤结束
--setting.select_condition.max_lev 表示过来比此等级高的

--setting.select_condition.camp_type 阵营  0表示搜友阵营
--setting.select_condition.bid  英雄id  0 或者 nil 表示无
--setting.dic_selected 已选 结构 [id] = hero_vo
--setting.dic_filter_selected 需过滤的选择 结构 [id] = hero_vo
--setting.select_count 选择数量  默认 1个
--setting.form_type 来自那里的选择类型 如果有特殊就写.没有就用通用的
function HeroStarSelectHeroPanel:openRootWnd(setting)
    local setting = setting or {}

    self.select_condition = setting.select_condition or {}
    self.dic_selected = setting.dic_selected or {}
    self.dic_filter_selected = setting.dic_filter_selected or {}

    self.select_count = setting.select_count or 1
    self.form_type = setting.form_type or 0
    local tips = setting.tips or ""
    -- self.hero_list = {}
    -- --当前选择的
    self.dic_cur_select_list = {}

    -- self:initHeroList()

    self.is_not_source = false

    self.source_config = self:checkSource()

    if self.is_not_source then
        --如果没有显示来源  没有数据就默认空空如也
        local item_list = self.item_list or {}
        if #self.hero_list == 0 and #item_list == 0 then
            commonShowEmptyIcon(self.lay_scrollview, true, {font_size = 22,scale = 1, text = TI18N("语言_c_1795")})
            return 
        end
    end
    -- self:updateHeroList(0)
    self:onClickBtnShowByIndex(0)
    -- self.tips_label:setString(tips)
end

function HeroStarSelectHeroPanel:checkSource()
    local bid = self.select_condition.bid or 0
    local star = self.select_condition.star 
    local star_start = self.select_condition.star_start or 0
    if bid == 0 then    
        --随机卡 默认写死 没有来源 7星以上没有来源
        if (star and star >= 7) or star_start > 7 then
            self.is_not_source = true  --表示没有来源
        end 
    else
        local check_star_source = function(bid, star)
            local key = getNorKey(bid, star)
            local star_config = Config.PartnerData.data_partner_star(key)    
            if not star_config then 
                self.is_not_source = true
                return 
            end
            if star_config.source[1] == nil then --表示读item表
                
            else
                if type(star_config.source[1]) == "number" then
                    if star_config.source[1] == 1 then
                        self.is_not_source = true --表示没有来源
                    end
                elseif type(star_config.source[1]) == "table" then
                    --说明有来源 读这里的..
                    return star_config
                end
            end
        end
        if star then
            return check_star_source(bid, star)
        else
            local star_end = self.select_condition.star_end or 0
            if star_start == 0 and star_end == 0 then
                --说明没有设星级 拿最低级的
                local config = Config.PartnerData.data_partner_base(bid)
                if config then
                    star_start = config.init_star
                    star_end = config.init_star
                    self.select_condition.star_start = star_start
                    self.select_condition.star_end = star_start
                else
                    self.is_not_source = true
                    return 
                end
            end
            return check_star_source(bid, star_start)
        end
    end
end

--初始化英雄数据
function HeroStarSelectHeroPanel:initHeroList()
    --别人已选
    local dic_filter_selected = self.dic_filter_selected or {}
    --自己已选
    local dic_selected = self.dic_selected or {}
    --过滤
    local hero_array = model:getAllHeroArray()
    local size = hero_array:GetSize()

    local bid = self.select_condition.bid or 0
    local temp_list = {}
    local camp_type = self.select_condition.camp_type or 0
    for j=1, size do
        local hero_vo = hero_array:Get(j-1)
        if hero_vo and not hero_vo:isResonateHero() and (camp_type == 0 or hero_vo.camp_type == camp_type) and dic_filter_selected[hero_vo.id] == nil and hero_vo.resonate_lev ~= 0 then
            if self.select_count == 1  then --单选
                if dic_selected[hero_vo.id] then
                    self.dic_cur_select_list[hero_vo.id] = hero_vo
                else
                    table_insert(temp_list, hero_vo)
                end
            else
                if dic_selected[hero_vo.id] then
                    self.dic_cur_select_list[hero_vo.id] = hero_vo
                end
                table_insert(temp_list, hero_vo)
            end
        end
    end
    if #temp_list > 0 then
        --星级计算
        local star = self.select_condition.star
        if star then
            for i,hero_vo in ipairs(temp_list) do
                if star ==  hero_vo.star then
                   table_insert(self.hero_list, hero_vo) 
                end
            end
        else
            local star_start = self.select_condition.star_start or 0
            local star_end = self.select_condition.star_end or 1000
            for i,hero_vo in ipairs(temp_list) do
                if hero_vo and hero_vo.star >= star_start and hero_vo.star <= star_end   then
                   table_insert(self.hero_list, hero_vo) 
                end
            end
        end
    end
    local min_star = self.data_const["star_cell_star_limit"].val
    if self.form_type == HeroConst.SelectHeroType.eResonateSpStar then
        min_star = self.data_const["sp_star_cell_star_limit"].val
    end
    if min_star then
        temp_list = self.hero_list
        self.hero_list = {}
        for i,hero_vo in ipairs(temp_list) do
            if hero_vo.star >= min_star  then
                table_insert(self.hero_list, hero_vo) 
            end
        end
    end
end

--排序信息
function HeroStarSelectHeroPanel:getSortFun(a, b)
    local a_is_lock, b_is_lock
    if a.isInForm and a:isInForm() then
        a_is_lock = 1
    else
        a_is_lock = a.is_lock
    end 
    if b.isInForm and b:isInForm() then
        b_is_lock = 1
    else
        b_is_lock = b.is_lock
    end 
    if a_is_lock == b_is_lock then
        if a.star == b.star then
            if a.camp_type == b.camp_type then
                return a.sort_order < b.sort_order
            else
                return a.camp_type < b.camp_type
            end
            -- return a.sort_order < b.sort_order
        else
            return a.star > b.star
        end
    else
        return a_is_lock < b_is_lock
    end
end


--创建英雄列表 
function HeroStarSelectHeroPanel:updateHeroList(select_camp)
    local select_camp = select_camp or 1
    if select_camp == self.select_camp then 
        return
    end
    self.select_camp = select_camp
    if self.list_view == nil then
        if tolua.isnull(self.lay_scrollview) then return end
        local scroll_view_size = self.lay_scrollview:getContentSize()
        local list_setting = {
            start_x = 0,
            space_x = 0,
            start_y = 4,
            space_y = 0,
            item_width = 140,
            item_height = 130,
            row = 0,
            col = 4,
            need_dynamic = true
        }
        self.list_view = CommonScrollViewSingleLayout.new(self.lay_scrollview, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, list_setting, cc.p(0, 0)) 

        self.list_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.list_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        -- self.list_view:registerScriptHandlerSingle(handler(self,self.onCellTouched), ScrollViewFuncType.OnCellTouched) --更新cell
    end
    self.hero_list = {}
    --当前选择的
    if select_camp ~= 1 then
        self.dic_cur_select_list = {}
    end
    
    self:initHeroList()
    table.sort(self.hero_list, function(a, b) return self:getSortFun(a, b) end)
    if self.select_count == 1  then --单选
        self.is_select = false
        -- for i,v in pairs(self.dic_cur_select_list) do
        --     self.is_select = true
        --     table_insert(self.hero_list, 1, v)
        -- end

        self.hero_select_list = {}
        for k, config in pairs(self.hero_list) do
            local cfg = Config.PartnerData.data_partner_base[config.bid]
            if config.isLockByLocktype and not config:isLockByLocktype(HeroConst.LockType.eHeroUrEnableLock) then
                if self.form_type == HeroConst.SelectHeroType.eResonateStar then
                    if ((select_camp == 0 and table.indexof(self.starLimit,config.camp_type)) or (select_camp == config.camp_type)) and cfg.score < 9 then
                        table_insert(self.hero_select_list, config)    
                    end
                else
                    if ((select_camp == 0 and table.indexof(self.starLimit,config.camp_type)) or (select_camp == config.camp_type)) and cfg.score == 9 then
                        table_insert(self.hero_select_list, config)    
                    end
                end
            end
        end
        if self.is_select then
            self.list_view:reloadData(1)
        else
            self.list_view:reloadData()
        end
    else
        self.list_view:reloadData()
    end

end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroStarSelectHeroPanel:createNewCell(width, height)
    local cell = HeroExhibitionItem.new(1, true)
    cell:addCallBack(function() self:onCellTouched(cell) end)
    cell:setLongTimeTouchEffect(true)
    return cell
end
--获取数据数量
function HeroStarSelectHeroPanel:numberOfCells()
    if self.is_not_source then
        --没有来源
        return #self.hero_select_list
    else
        -- + 1 的那个是最后的加号 
        return #self.hero_select_list + 1
    end
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function HeroStarSelectHeroPanel:updateCellByIndex(cell, index)
    cell.index = index
    local hero_vo = self.hero_select_list[index]
    
    if hero_vo then
        if hero_vo.is_hero_hun then --保留的 目前没有用
            cell:setData(hero_vo) 
            if hero_vo.good_vo.config then
                cell:setQualityImg(hero_vo.good_vo.config.eqm_jie - 1)
                cell:setDefaultHead(hero_vo.good_vo.config.icon)
                cell.star_setting = cell:createStar(hero_vo.good_vo.config.eqm_jie, cell.star_con, cell.star_setting) 
                cell:setCampImg(hero_vo.good_vo.config.camp_type)
            end
            cell:setLev(nil)  
            cell:showLockIcon(false)  
        else
            cell:setData(hero_vo)
        end
        --设置选中状态 
        if self.dic_cur_select_list[hero_vo.id] then
        -- if cell == self.single_select_cell then
            cell:setSelected(true)
        else
            cell:setSelected(false)
        end
        cell:showAddIcon(false)
    else
        cell:setSelected(false)
        cell:setData(nil) 
        --空表示最后的加号
        cell:showAddIcon(true)
        cell:showLockIcon(false)
    end

end

--点击cell .需要在 createNewCell 设置点击事件
function HeroStarSelectHeroPanel:onCellTouched(cell)
    local index = cell.index
    local hero_vo = self.hero_select_list[index]
    if hero_vo then
        self:selectHero(cell, hero_vo)
    else
        if not self.select_condition then return end
        local item_id 
        if self.form_type == HeroConst.SelectHeroType.eResonateSpStar then
            controller:openHeroSpTipsSource(true)
            return
        end
        if self.select_condition.bid == 0 then
            if self.select_condition.star  then
                item_id = model:getSourceHeroCombinationByCampStar(self.select_condition.camp_type, self.select_condition.star)
            else
                local star_start = self.select_condition.star_start or 0
                item_id = model:getSourceHeroCombinationByCampStar(self.select_condition.camp_type, self.select_condition.star)
            end
        else
            if self.source_config then
                --先从升星表读..
                BackpackController:getInstance():openTipsOnlySource(true, self.source_config)
                return 
            end
            -- 如果没有在从item表读
            local partner_config = Config.PartnerData.data_partner_base[self.select_condition.bid] or {}
            item_id = partner_config.item_id
        end
        if item_id then 
            local config = Config.ItemData.data_get_data(item_id)
            if config and tableLen(self.hero_select_list) >= 0 then
                BackpackController:getInstance():openTipsOnlySource(true, config)
            end
        end
    end
end

function HeroStarSelectHeroPanel:selectHero(cell, hero_vo)
    if not hero_vo  then return end
    if not cell then return end
    local item = self.list_view:getCacheCellByIndex(1)
    item:setSelected(false)
    if self.select_count == 1  then --单选
        self.is_select = false
        --如果是单选.选把已选的去掉
        if self.single_select_cell then
            self.single_select_cell:setSelected(false)
        end
        if not self.is_select and self.dic_cur_select_list[hero_vo.id] then
            --保险
            cell:setSelected(false)
            self.dic_cur_select_list[hero_vo.id] = nil
        else
            self.single_select_cell = cell
            if self.single_select_cell then
                self.single_select_cell:setSelected(true)
            end   
            self.dic_cur_select_list = {}
            self.dic_cur_select_list[hero_vo.id] = hero_vo 
            self.is_select = false
        end
    else
        --多选
        if self.dic_cur_select_list[hero_vo.id] then
            cell:setSelected(false)
            self.dic_cur_select_list[hero_vo.id] = nil  
        else
            local count = 0
            for k,v in pairs(self.dic_cur_select_list) do
                count = count + 1
            end
            if count >= self.select_count then
                message(TI18N("语言_c_3039"))
                return
            end

            self.dic_cur_select_list[hero_vo.id] = hero_vo
            cell:setSelected(true)
        end
    end
end

function HeroStarSelectHeroPanel:close_callback()
    if self.list_view then 
        self.list_view:DeleteMe()
        self.list_view = nil
    end

    controller:openHeroStarSelectHeroPanel(false)
end