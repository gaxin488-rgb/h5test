HeroRecommendWindow = class("HeroRecommendWindow",function()
    return ccui.Layout:create()
end)
local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroRecommendWindow:ctor(hero_vo)
    self.hero_vo = hero_vo
    self.suit_item_load = {}
    self.border_item_load = {}
    -- self.border_item_sprite = {} 
    self.suit_item_sprite = {}   
    self.barrage_pool_list = {}
    self.cache_pool = {}
    self.cache_list = {}
    self.loop_step = 1
    self.list_step = 1
    self.list_interval = 2
    self.loop_interval = 3
    self.auto_id = 1
    self.container_index = 1
    self.barrage_list={}
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_recommend_window"))
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self:initView()
    self:registerEvent()
    _controller:sender11050(self.hero_vo.bid)
    PokedexController:getInstance():sender11041(self.hero_vo.bid,1,100)
end

function HeroRecommendWindow:initView()

    self.main_container = self.root_wnd:getChildByName("main_container")
    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)

    self.top_panel = self.main_container:getChildByName("top_panel")
    self.top_title_bg = self.top_panel:getChildByName("top_title_bg")
    self.top_title_txt = self.top_title_bg:getChildByName("top_title_txt")
    self.top_title_txt:setChangeScaleOffWidth(-1000)
    self.rule_btn = self.top_panel:getChildByName("rule_btn")
    self.bulletChat_open_btn = self.top_panel:getChildByName("bulletChat_open_btn")
    self.bulletChat_close_btn = self.top_panel:getChildByName("bulletChat_close_btn")
    self.Text_1 = self.top_panel:getChildByName("Text_1")
    self.Text_1:setString(TI18N("语言_c_273"))
    self.rank_scroll = self.top_panel:getChildByName("rank_scroll")
    self.bulletChat_close_btn:setVisible(false)
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.bottom_title_bg = self.bottom_panel:getChildByName("bottom_title_bg")
    self.bottom_title_txt = self.bottom_title_bg:getChildByName("bottom_title_txt")
    self.Text_1_0 = self.bottom_panel:getChildByName("Text_1_0")
    self.Text_1_0:setString(TI18N("语言_c_273"))
    self.recommend_scroll = self.bottom_panel:getChildByName("recommend_scroll")
    self.suit_panel = self.bottom_panel:getChildByName("suit_panel")
    for i=1,4 do
        self.suit_item_sprite[i] = self.suit_panel:getChildByName("item_icon_"..i)
        -- self.border_item_sprite[i] = self.suit_panel:getChildByName("border_"..i)
    end
    self.bottom_suit_bg = self.bottom_panel:getChildByName("bottom_suit_bg")
    self.bottom_suit_txt = self.bottom_suit_bg:getChildByName("bottom_suit_txt")
    -- self.bottom_suit_probability_txt = self.bottom_panel:getChildByName("bottom_suit_probability_txt")
    self.bottom_suit_probability_txt = createRichLabel(18,cc.c4b(0x4e,0x1e,0x0e,0xff),cc.p(0.5,0.5),cc.p(550,25))
    self.bottom_panel:addChild(self.bottom_suit_probability_txt)
    
    self.bottom_suit_txt:setString(TI18N("语言_c_273"))
    -- self.bottom_suit_bg:setVisible(false)
    self.bottom_suit_probability_txt:setString(TI18N("语言_c_273"))
    
    self.list_container = {}
    local container = nil
    for i=1,4 do
        container = self.top_panel:getChildByName("list_container_"..i)
        if container ~= nil then
            self.list_container[i] = container
        end
    end

    self.top_title_txt:setString(TI18N("语言_c_5227"))
    self.bottom_title_txt:setString(TI18N("语言_c_5228"))
    self.top_title_bg:setContentSize(cc.size(self.top_title_txt:getContentSize().width+60, self.top_title_bg:getContentSize().height))
    self.bottom_title_bg:setContentSize(cc.size(self.bottom_title_txt:getContentSize().width+60, self.bottom_title_bg:getContentSize().height))
    
    --弹幕
    -- local config_list = Config.SubtitleData.data_system[103]
    -- if config_list ~= nil then
    --     self.barrage_list = deepCopy(config_list)
    -- end
    self:setScheduleUpdate(true)
end
function HeroRecommendWindow:registerEvent()
    self.rule_btn:addTouchEventListener(function( sender,event_type )
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            TipsManager:getInstance():showCommonTips(Config.HolidayClientData.data_constant["ninja_god_rules"].desc,sender:getTouchBeganPosition())
        end
    end)
    -- registerButtonEventListener(self.rule_btn, function()
    --     self:onRuleBtn()
    -- end,false, 1)
    registerButtonEventListener(self.bulletChat_close_btn, function()
        self:onBulletChatBtn(1)
    end,false, 1)
    registerButtonEventListener(self.bulletChat_open_btn, function()
        self:onBulletChatBtn(2)
    end,false, 1)
    
    if not self.hero_rank_event then
        self.hero_rank_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Rank_Event, function(data)
            if data then
                self:setData(data)
            end
        end)
    end
    
    -- 请求整个评论列表
    if not self.get_list_event then 
        self.get_list_event= GlobalEvent:getInstance():Bind(PokedexEvent.Comment_List_Event,function(data)
            for i=1,tableLen(data.partner_comments) do
                local item = {}
                item.msg = data.partner_comments[i].msg
                table.insert(self.barrage_list,item)
                -- self.barrage_list[i].msg = data.partner_comments[i].msg
            end
        end)
    end    
end

