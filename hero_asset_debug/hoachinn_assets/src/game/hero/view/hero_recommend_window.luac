function HeroRecommendWindow:onRuleBtn()
    
    -- self.role_vo = RoleController:getInstance():getRoleVo()
    -- _controller:sender11051(self.role_vo.rid,self.role_vo.srv_id,self.hero_vo.bid)
end
--弹幕打开关闭
function HeroRecommendWindow:onBulletChatBtn(index)
    if index == 1 then -- 打开弹幕
        self:setScheduleUpdate(true)
        for index, value in ipairs(self.list_container) do
            value:setVisible(true)
        end
        self.bulletChat_close_btn:setVisible(false)
        self.bulletChat_open_btn:setVisible(true)
    else
        self:setScheduleUpdate(false)
        for index, value in ipairs(self.list_container) do
            value:setVisible(false)
        end
        self.bulletChat_close_btn:setVisible(true)
        self.bulletChat_open_btn:setVisible(false)
    end
end


function HeroRecommendWindow:setData(data)
    -- data.set_id = 101
    self.data = data
    --排行榜
    if self.rank_view == nil then
        local scroll_view_size = self.rank_scroll:getContentSize()
        local setting = {
            item_class = HeroRecommendItem,      -- 单元类
            start_x = 5,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = 620,               -- 单元的尺寸width
            item_height = 112,              -- 单元的尺寸height
            -- row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.rank_view = CommonScrollViewLayout.new(self.rank_scroll, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    local list = data.partner_collocations
    table.sort(list, function(a, b) return b.idx > a.idx end)
    self.rank_view:setData(list)
    if tableLen(list) ~= 0 then
        self.Text_1:setVisible(false)
    end
    --天赋使用率
    if self.list_view == nil then
        self.list_setting = {
            start_x = 0,
            space_x = 5,
            start_y = 0,
            space_y = 0,
            item_width = 119,
            item_height = 184,
            row = 1,
            -- col = 4,
            need_dynamic = true,
            -- position_data_list = position_data_list
        }
        -- local position_data_list, container_height, tittle_pos_y = self:initThirteenInfo()
        -- self.list_setting.position_data_list = position_data_list
        -- self.list_setting.container_height = container_height

        self.list_view = CommonScrollViewSingleLayout.new(self.recommend_scroll, cc.p(0, 0), ScrollViewDir.horizontal, ScrollViewStartPos.top, self.recommend_scroll:getContentSize(), self.list_setting, cc.p(0, 0)) 

        self.list_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.list_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    self.list_view:reloadData(self.data.dower_skills)
    if tableLen(self.data.dower_skills) ~= 0 then
        self.Text_1_0:setVisible(false)
    end
    --套装使用率
    local id = math.floor(data.set_id / 100)
    -- local id = 1
    if id ~= 0 then
        local config = Config.PartnerHolyEqmData.data_suit_res_prefix_fun(id)
        for pos=1,4 do
            local res_name = string.format("%s_%s", config.prefix, pos)
            self.suit_item_sprite[pos]:setVisible(true)
            self.suit_item_sprite[pos]:setScale(config.zoom)
            local res = PathTool.getPlistImgForDownLoad("hero/holy_eqm",res_name, false)
            self.suit_item_load[pos] = loadSpriteTextureFromCDN(self.suit_item_sprite[pos], res, ResourcesType.single, self.suit_item_load[pos])
            
            -- local res_name = string.format("border_10_%s", pos)
            -- self.border_item_sprite[pos]:setVisible(true)
            -- local res = PathTool.getPlistImgForDownLoad("hero/holy_eqm",res_name, false)
            -- self.border_item_load[pos] = loadSpriteTextureFromCDN(self.border_item_sprite[pos], res, ResourcesType.single, self.border_item_load[pos])
        end
        local config = Config.PartnerHolyEqmData.data_suit_info[data.set_id]
        if config then
            self.bottom_suit_txt:setString(transformTextToShort(config[1].name,10))
            addEvt2showAllTextTips(self.bottom_suit_txt,config[1].name,10,300)
            local prob = data.prob.."%"
            local str = string.format(TI18N("语言_c_5229"),prob)
            self.bottom_suit_probability_txt:setString(str)
        else
            self.bottom_suit_txt:setString(TI18N("语言_c_273"))
            -- self.bottom_suit_bg:setVisible(false)
            self.bottom_suit_probability_txt:setString(TI18N("语言_c_273"))
        end
    end
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroRecommendWindow:createNewCell(width, height)
    local cell = ccui.Widget:create()
   -- cell.root_wnd = createCSBNote(PathTool.getTargetCSB("action/action_acc_level_up_gift_item"))
   -- cell:addChild(cell.root_wnd)
   cell:setCascadeOpacityEnabled(true)
   cell:setAnchorPoint(0,0)
   cell:setContentSize(cc.size(width, height))
   cell.skill_item = SkillItem.new(true,true,false,nil,nil,false)
   cell.skill_item:setPosition(width * 0.5, 110)
   cell:addChild(cell.skill_item)
   -- local cell = SkillItem.new(true,true,false,nil,nil,false)
   cell:setScale(0.9)

   cell.skill_item:addCallBack(function() self:onCellTouched(cell) end)
   return cell
end
--获取数据数量
function HeroRecommendWindow:numberOfCells()
   if not self.data.dower_skills then return 0 end
   return #self.data.dower_skills
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function HeroRecommendWindow:updateCellByIndex(cell, index)
    cell.index = index
    local skill_data = self.data.dower_skills[index]
    local config = Config.SkillData.data_get_skill(skill_data.skill_id)
    cell:setVisible(true)
    if config then
        cell.skill_item:setData(config)
        -- cell.skill_item:showName(true,config.name, nil,nil,true)
        cell.skill_item:showProbability(true,skill_data.prob, cc.p(60,-32),nil,true)
        cell.skill_item:setSelected(false)
    end
end

--点击cell .需要在 createNewCell 设置点击事件
function HeroRecommendWindow:onCellTouched(cell)
    local index = cell.index
    local skill_data = self.data.dower_skills[index]
    local config = Config.SkillData.data_get_skill(skill_data.skill_id)
    TipsManager:getInstance():showSkillTips(config, false, true)
end

--弹幕
--==============================--
--desc:设置计时器
--time:2017-09-08 04:31:18
--@status:
--@return 
--==============================--
function HeroRecommendWindow:setScheduleUpdate(status)
    if status == true then
        if self.queue_timer == nil then
            self.queue_timer = GlobalTimeTicket:getInstance():add(function()
                if self.barrage_list ~= nil and next(self.barrage_list) ~= nil then
                    if self.list_step >= self.list_interval then
                        local data = table.remove( self.barrage_list, 1 )
                        self:updateBarrage(data)
                        self.list_step = 1
                    else
                        self.list_step = self.list_step + 1
                    end
                else
                    if self.cache_list == nil or next(self.cache_list) == nil then
                        if self.loop_step >= self.loop_interval then
                            self.barrage_list = deepCopy(self.barrage_pool_list)
                            self.barrage_pool_list = {}
                            self.loop_step = 1
                        else
                            self.loop_step = self.loop_step + 1
                        end
                    end
                end
            end, 1)
        end
    else
        if self.queue_timer ~= nil then
            GlobalTimeTicket:getInstance():remove(self.queue_timer)
            self.queue_timer = nil
        end
    end
end

--==============================--
--desc:创建并开始移动弹幕
--time:2017-09-08 02:04:38
--@data:
--@return 
--==============================--
function HeroRecommendWindow:updateBarrage(data)
    if data == nil or data.msg == "" then
        return 
    end

    local function finish_action_callback(list)
        if list ~= nil and list.clearInfo then
            list:clearInfo()
        end
        table.insert( self.cache_pool, list )
        self.cache_list[list.id] = nil
    end

    local item = nil
    if self.cache_pool == nil or next(self.cache_pool) == nil then
        item = BarrageItemList.new(self.auto_id)
        self.cache_list[self.auto_id] = item
        self.auto_id = self.auto_id + 1
    else
        item = table.remove( self.cache_pool, 1 )
        self.cache_list[item.id] = item
    end
    self.list_container[self.container_index]:addChild(item)
    if item ~= nil then
        item:setPosition(display.width+10, 15)
        item:actionFinishCallBack(finish_action_callback)
        item:update(data)
    end
    self.container_index = self.container_index + 1
    if self.container_index > 4 then
        self.container_index = 1
    end
end

function HeroRecommendWindow:DeleteMe()
    self:setScheduleUpdate(false)
    for k,v in pairs(self.cache_pool) do
        if v.DeleteMe then
            v:DeleteMe()
        end
    end
    self.cache_pool = nil
    for k,v in pairs(self.cache_list) do
        if v.DeleteMe then
            v:DeleteMe()
        end
    end
    if self.hero_rank_event then
        GlobalEvent:getInstance():UnBind(self.hero_rank_event)
        self.hero_rank_event = nil
    end
    if self.get_list_event then
        GlobalEvent:getInstance():UnBind(self.get_list_event)
        self.get_list_event = nil
    end
    if self.rank_view then
        self.rank_view:DeleteMe()
        self.task_view = nil
    end
    if self.suit_item_load then
        for k,v in pairs(self.suit_item_load) do
            v:DeleteMe()
        end
        self.suit_item_load = nil
    end
    if self.border_item_load then
        for k,v in pairs(self.border_item_load) do
            v:DeleteMe()
        end
        self.border_item_load = nil
    end
    -- doStopAllActions(self.main_container)

    -- if self.item_scrollview then
    --     self.item_scrollview:DeleteMe()
    -- end
    -- self.item_scrollview = nil
end



--子项
HeroRecommendItem = class("HeroRecommendItem", function()
    return ccui.Widget:create()
end)

function HeroRecommendItem:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function HeroRecommendItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_recommend_item"))
    self:setAnchorPoint(cc.p(0, 0))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	-- self:setContentSize(cc.size(580,540))
	self:setTouchEnabled(true)
	self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.bg = self.main_panel:getChildByName("bg")
    self.rank_id = self.main_panel:getChildByName("rank_id")
    self.head_img = self.main_panel:getChildByName("head_img")
    self.rank_image = self.main_panel:getChildByName("rank_image")
    self.attk_bg = self.main_panel:getChildByName("attk_bg")
    self.my_attk_label = self.main_panel:getChildByName("my_attk_label")
    -- self.attk_image = self.main_panel:getChildByName("attk_image")
    self.my_name_label = self.main_panel:getChildByName("my_name_label")
    self.Node_1 = self.main_panel:getChildByName("Node_1")
    self.thumbsUp_btn = self.main_panel:getChildByName("thumbsUp_btn")
    self.thumbsNum_btn = self.main_panel:getChildByName("thumbsNum_btn")
    self.thumbsNum_txt = self.main_panel:getChildByName("thumbsNum_txt")
    self.share_btn = self.main_panel:getChildByName("share_btn")
end

function HeroRecommendItem:setData( data)
    self.data = data
    --排名
    if data.idx > 3 then
        self.rank_image:setVisible(false)
        self.rank_id:setVisible(true)
        self.rank_id:setString(data.idx)
    else
        self.rank_image:setVisible(true)
        self.rank_id:setVisible(false)
        local path = string.format("common_200%s", data.idx)
        local src =  PathTool.getResFrame('common', path,false)
        loadSpriteTexture(self.rank_image,src,LOADTEXT_TYPE_PLIST)
    end
    --头像
    self.play_head = PlayerHead.new(PlayerHead.type.circle)
	self.play_head:setPosition(cc.p(43,43))
	self.play_head:setAnchorPoint(cc.p(0.5,0.5))
	self.play_head:setTouchEnabled(true)
    self.play_head:setSwallowTouches(false)
	self.play_head:setScale(0.8)
	self.head_img:addChild(self.play_head)
    -- self.play_head = self:createPlayerHead(105,60)
    local face_id = self.data.face_id
    local avatar_bid = self.data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.play_head:showBg(res, nil, false, vo.offy)
    end

    self.play_head:setHeadRes(face_id, false, LOADTEXT_TYPE, self.data.face_file, self.data.face_update_time)
    self.play_head:setLev(self.data.role_lev)
    -- self.play_head:setSever(self.data.srv_id)
    
    self.play_head:addCallBack(function( )
        FriendController:getInstance():openFriendCheckPanel(true,self.data)
    end)
    --名字战力
    local name_txt = "[" .. getServerName(self.data.srv_id) .. "]\n" .. data.name
    self.my_name_label:setChangeScaleOffWidth(480)
    self.my_name_label:setString(name_txt)
    -- setTextMaxWidth(self.my_name_label,150)
    self.my_attk_label:setString(MoneyTool.moneyFormat(data.power))
    --英雄展示
    self.hero_item = HeroExhibitionItem.new(0.7, true)
    self.hero_item:addCallBack(function() self:onClickHeroItemByIndex() end)
    self.hero_item:setBgOpacity(128)
    self.Node_1:addChild(self.hero_item)
    self.hero_item:setData(data)
    --点赞分享
    self.thumbsNum_txt:setString(data.like_num)
    self.thumbsNum_btn:setContentSize(cc.size(self.thumbsNum_txt:getContentSize().width + 60,self.thumbsNum_btn:getContentSize().height))

    if self.data.is_like == 1 then
        self.thumbsUp_btn:loadTexture(PathTool.getResFrame("vedio", "txt_cn_vedio_like_2"),LOADTEXT_TYPE_PLIST)
    end
    
end
--点击英雄
function HeroRecommendItem:onClickHeroItemByIndex()
    HeroController:getInstance():sender11051(self.data.rid,self.data.srv_id,self.data.bid,0)
    -- local hero_data = self.data
    -- HeroController:getInstance():openHeroTipsPanel(true, hero_data, {is_show_form_btn = false})
end
function HeroRecommendItem:register_event( )
    registerButtonEventListener(self.thumbsUp_btn, function()
        HeroController:getInstance():getModel().recommend_index = self.data._index
        HeroController:getInstance():sender11053(self.data.bid,self.data.rid,self.data.srv_id)
    end,false, 1)
    registerButtonEventListener(self.share_btn, function ( param, sender )
        local world_pos = sender:convertToWorldSpace(cc.p(0.5, 0))
        self:onClickSharetBtn(world_pos)
    end, false, 1)
    -- registerButtonEventListener(self.share_btn, function()
    --     -- self:onBulletChatBtn(1)
    -- end,false, 1)
    if not self.hero_data_event then
        self.hero_data_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Data_Event, function(data)
            if data.bid ~= 0 then
                local config = Config.PartnerData.data_partner_base[data.bid]
                local camp_type = 1
                local type = 1
                if config then
                    camp_type = config.camp_type
                    type = config.type
                end
                data.camp_type = camp_type
                data.type = type
                HeroController:getInstance():openHeroTipsPanel(true, data, {is_show_form_btn = false})
            end
            -- HeroController:getInstance():openHeroTipsPanel(true, data, {is_show_form_btn = false})
        end)
    end
    if not self.hero_thumbsUp_event then
        self.hero_thumbsUp_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_ThumbsUp_Event, function(data)
            if data.result == 1 and HeroController:getInstance():getModel().recommend_index == self.data._index then
                self.thumbsNum_txt:setString(self.data.like_num + 1)
                self.thumbsUp_btn:loadTexture(PathTool.getResFrame("vedio", "txt_cn_vedio_like_2"),LOADTEXT_TYPE_PLIST)
            end
        end)
    end
end
--分享
function HeroRecommendItem:onClickSharetBtn(world_pos)
    local callback = function(btn_type, setting)
        if not btn_type or not setting then return end
        if self.root_wnd and (not tolua.isnull(self.root_wnd)) then
            local hero_vo = setting.hero_vo
            if hero_vo then
                if btn_type == HeroConst.ShareBtnType.eHeroShareCross then
                    --跨服频道
                    HeroController:getInstance():sender11054(hero_vo.rid,hero_vo.srv_id,hero_vo.bid,"0",ChatConst.Channel.Cross)
                elseif btn_type == HeroConst.ShareBtnType.eHeroShareWorld then
                    --世界频道
                    HeroController:getInstance():sender11054(hero_vo.rid,hero_vo.srv_id,hero_vo.bid,"0",ChatConst.Channel.World)
                elseif btn_type == HeroConst.ShareBtnType.eHeroShareGuild then
                    --公会频道
                    HeroController:getInstance():sender11054(hero_vo.rid,hero_vo.srv_id,hero_vo.bid,"0",ChatConst.Channel.Gang)
                end
            end
        end
    end
    HeroController:getInstance():openHeroSharePanel(true, world_pos, callback, {offsetx = -60, offsety = -60, hero_vo = self.data})
end
function HeroRecommendItem:DeleteMe()
    if self.hero_data_event then
        GlobalEvent:getInstance():UnBind(self.hero_data_event)
        self.hero_data_event = nil
    end
    
    if self.hero_thumbsUp_event then
        GlobalEvent:getInstance():UnBind(self.hero_thumbsUp_event)
        self.hero_thumbsUp_event = nil
    end
end