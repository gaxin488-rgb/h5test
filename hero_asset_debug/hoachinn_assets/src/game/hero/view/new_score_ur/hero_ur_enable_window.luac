-- --------------------------------------------------------------------
-- 竖版神装装备穿戴
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2020-2-27
-- --------------------------------------------------------------------
HeroUrEnableWindow = HeroUrEnableWindow or BaseClass(BaseView)
    
local controller = HeroController:getInstance()
local model = controller:getModel()

--@holy_data 神装方案数据 结构参考 协议25220
function HeroUrEnableWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full
    self.layout_name = "hero/hero_ur_enable_window"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("hero","hero"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("hero","ultra_hero_awaken_bg"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("dungeon_abyss_circle","dungeon_abyss_circle"), type = ResourcesType.plist },
    }
end 

function HeroUrEnableWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
    self.container_size = self.main_container:getContentSize()
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.hero_panel = self.main_container:getChildByName("hero_panel")
    self.left_panel = self.hero_panel:getChildByName("left_panel")
    self.left_effect_node = self.left_panel:getChildByName("left_effect_node")
    self.left_star_node = self.left_panel:getChildByName("left_star_node")
    self.right_panel = self.hero_panel:getChildByName("right_panel")
    self.right_effect_node = self.right_panel:getChildByName("right_effect_node")
    self.right_star_node = self.right_panel:getChildByName("right_star_node")
    self.lock_tip = self.right_panel:getChildByName("lock_tip")
    self.choose_tip = self.right_panel:getChildByName("choose_tip")
    self.change_btn = self.right_panel:getChildByName("change_btn")
    self.arrow = self.hero_panel:getChildByName("arrow")
    self.top_bg = self.main_container:getChildByName("top_bg")
    self.discharge_btn = self.main_container:getChildByName("discharge_btn")
    self.discharge_btn:setVisible(false)
    self.discharge_txt = self.discharge_btn:getChildByName("label")
    self.discharge_txt:setChangeScaleOffWidth(-99999)
    self.discharge_txt:setString(TI18N("语言_par_ult_25"))
    setTextMaxWidth(self.discharge_txt,115,-8)
    self.no_discharge_btn = self.main_container:getChildByName("no_discharge_btn")
    self.no_discharge_btn:setVisible(false)
    self.no_discharge_txt = self.no_discharge_btn:getChildByName("label")
    self.no_discharge_txt:setChangeScaleOffWidth(-99999)
    self.no_discharge_txt:setString(TI18N("语言_par_ult_26"))
    setTextMaxWidth(self.no_discharge_txt,115,-8)
    self.lock_txt_tip = createRichLabel(24,cc.c3b(0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(360,684),-8,nil,600)
    self.main_container:addChild(self.lock_txt_tip)
    self.lock_txt_tip:setVisible(false)
    self.choose_panel = self.main_container:getChildByName("choose_panel")
    self.top_panel = self.choose_panel:getChildByName("top_panel")
    self.skill_name = self.top_panel:getChildByName("skill_name")
    self.skill_lev = self.top_panel:getChildByName("skill_lev")
    self.click_tip = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(1,0.5),cc.p(667,100),-8,nil,200)
    self.top_panel:addChild(self.click_tip)
    self.click_tip:setHorizontalLayoutType(3)
    local txt = TI18N("语言_par_ult_27")
    self.click_tip:setString(string.format(txt,PathTool.getResFrame("common", "common_1093")))
    local function clickLinkCallBack( _type, value )
        if _type == "href" then
            local cfg = Config.PartnerUltraData.data_ene_skill[self.hero_vo.bid]
            if cfg then
                table.sort(cfg,function(a,b) return a.lev>b.lev end)
                local skill_id = cfg[1].skill[1]
                local setting = {
                    hero_vo=self.hero_vo,
                    skill_id=skill_id,
                    is_lock=true,
                    look_type=1,
                }
                controller:openHeroUrSkillTipPanel(true,setting)
            end
        end
    end
    self.click_tip:addTouchLinkListener(clickLinkCallBack,{"href"})
    self.Image_2 = self.choose_panel:getChildByName("Image_2")
    self.skill_panel = self.choose_panel:getChildByName("skill_panel")
    self.skill_panel:setScrollBarEnabled(false)
    self.attr_panel = self.choose_panel:getChildByName("attr_panel")
    self.line_1 = self.attr_panel:getChildByName("line_1")
    self.attr_title = self.attr_panel:getChildByName("attr_title")
    self.attr_title:setString(TI18N("语言_par_ult_16"))
    self.line_2 = self.attr_panel:getChildByName("line_2")
    setLeftRightImg(self.line_1,self.attr_title,self.line_2,30)
    self.attr_scroll = self.attr_panel:getChildByName("attr_scroll")
    self.attr_scroll:setScrollBarEnabled(false)
    self.no_attr_panel = self.choose_panel:getChildByName("no_attr_panel")
    self.no_attr_tip = self.no_attr_panel:getChildByName("no_attr_tip")
    self.no_attr_tip:setString(TI18N("语言_par_ult_13"))
    setTextMaxWidth(self.no_attr_tip,650)
    self.rule_btn = self.main_container:getChildByName("rule_btn")
    self.title_top_bg = self.main_container:getChildByName("title_top_bg")
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.win_title = self.main_container:getChildByName("win_title")
    setTextSpacing(self.win_title,-8)
    self.win_title:setString(TI18N("语言_par_ult_14"))
    autoSizeTitleBg(self.win_title,self.title_bg,329,529)
    self.btn_preview = self.main_container:getChildByName("btn_preview")
    self.preview_txt = self.btn_preview:getChildByName("preview_txt")
    self.preview_txt:setChangeScaleOffWidth(-9999)
    self.preview_txt:setString(TI18N("语言_par_ult_15"))
    setTextMaxWidth(self.preview_txt,100,-8)
    self.skill_type_list = {}
    self:adaptationScreen()
end

--设置适配屏幕
function HeroUrEnableWindow:adaptationScreen()
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)

    local tab_y = self.title_bg:getPositionY()
    self.title_bg:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.title_top_bg:getPositionY()
    self.title_top_bg:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.win_title:getPositionY()
    self.win_title:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.rule_btn:getPositionY()
    self.rule_btn:setPositionY(top_y - (self.container_size.height - tab_y))
    local tab_y = self.btn_preview:getPositionY()
    self.btn_preview:setPositionY(top_y - (self.container_size.height - tab_y))

    local close_btn_y = self.hero_panel:getPositionY()
    self.hero_panel:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.top_bg:getPositionY()
    self.top_bg:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.discharge_btn:getPositionY()
    self.discharge_btn:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.no_discharge_btn:getPositionY()
    self.no_discharge_btn:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.lock_txt_tip:getPositionY()
    self.lock_txt_tip:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.choose_panel:getPositionY()
    self.choose_panel:setPositionY(bottom_y + close_btn_y)
    local close_btn_y = self.background:getPositionY()
    self.background:setPositionY(bottom_y + close_btn_y)
end
function HeroUrEnableWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        controller:openHeroUrEnableWindow(false)
    end, true, 2)
    registerButtonEventListener(self.change_btn, function()
        if self.look_type == 1 then return end
        local setting = {
            hero_vo = self.hero_vo,
            use_bid = self.use_bid,
        }
        controller:openHeroUrEnableSelectWindow(true,setting)
    end, true, 2)
    registerButtonEventListener(self.right_panel, function()
        if self.look_type == 1 then return end
        if self.open_status then
            if not self.use_bid or self.use_bid == 0 or self.use_bid ~= model:getHeroEnable(self.hero_vo.partner_id) then
                local setting = {
                    hero_vo = self.hero_vo,
                    use_bid = self.use_bid,
                }
                controller:openHeroUrEnableSelectWindow(true,setting)
            end
        end
    end, false, 2)
    registerButtonEventListener(self.discharge_btn, function()
        if not self.use_bid or self.use_bid == 0 or self.use_bid ~= model:getHeroEnable(self.hero_vo.partner_id) then
            local setting = {
                hero_vo = self.hero_vo,
                use_bid = self.use_bid,
            }
            controller:openHeroUrEnableConfirmWindow(true,setting)
        end
    end, true, 2)
    registerButtonEventListener(self.no_discharge_btn, function()
        if self.use_bid and self.use_bid ~= 0 and self.hero_vo then
            local str = TI18N("语言_par_ult_17")
            CommonAlert.show( str, TI18N("语言_c_63"), function()
                controller:sender11478(self.hero_vo.partner_id,self.use_bid,1)
            end, TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
        end
    end, true, 2)
    registerButtonEventListener(self.btn_preview, function()
        controller:openHeroUrAttrPreviewWindow(true)
    end, true, 2)
    registerButtonEventListener(self.rule_btn, function()
        if Config.PartnerUltraData.data_explain then
            MainuiController:getInstance():openCommonExplainView(true, Config.PartnerUltraData.data_explain)
        end
    end, true, 2)
    
    self:addGlobalEvent(HeroEvent.Hero_UR_Score_Enable_Event, function(data) 
        if data and self.hero_vo and data.pid and self.hero_vo.partner_id then
            if data.pid == self.hero_vo.partner_id then
                self.use_bid = data.use_pid
                self.skill_bid = model:getHeroEnableSkillId(self.hero_vo.partner_id,self.use_bid)
                if self.skill_bid == 0 then
                    local cfg = Config.PartnerUltraData.data_ene_skill[self.hero_vo.bid]
                    if cfg then
                        table.sort(cfg,function(a,b) return a.lev > b.lev end)
                        self.skill_bid = cfg[1].skill[1]
                        self.is_lock = true
                    end
                end
                self:updateHeroPanel()
            end
        end
   end)
    self:addGlobalEvent(HeroEvent.Hero_UR_Score_Enable_Click_Event, function(pid,use_pid)
        if pid and use_pid and self.hero_vo and pid and self.hero_vo.partner_id then
            if pid == self.hero_vo.partner_id then
                self.use_bid = use_pid
                self.skill_bid = model:getHeroEnableSkillId(self.hero_vo.partner_id,self.use_bid)
                self.is_lock = false
                self:updateHeroPanel()
                if not use_pid or use_pid == 0 or use_pid ~= model:getHeroEnable(self.hero_vo.partner_id) then
                    local setting = {
                        hero_vo = self.hero_vo,
                        use_bid = use_pid,
                    }
                    controller:openHeroUrEnableConfirmWindow(true,setting)
                end
            end
        end
    end)
end

function HeroUrEnableWindow:openRootWnd(setting)
    MainuiController:getInstance():setIsShowMainUIBottom(true)
    self.setting = setting or {}
    self.hero_vo = self.setting.hero_vo or {}
    self.skill_bid = self.setting.skill_id or 0
    self.is_lock = self.setting.is_lock or false
    self.look_type = self.setting.look_type or 0  --0技能查看 1预览
    self.use_bid = model:getHeroEnable(self.hero_vo.partner_id)
    self:updateHeroPanel()
end
function HeroUrEnableWindow:updateHeroPanel()
    if not self.left_role then
        self.left_role = BaseRole.new(BaseRole.type.partner, self.hero_vo, nil, {skin_id = self.hero_vo.use_skin,scale = 0.72})
        self.left_role:setCascade(true)
        self.left_role:setAnchorPoint(cc.p(0.5, 0))
        self.left_role:setPosition(cc.p(100, 178))
        self.left_role:setAnimation(0,PlayerAction.show,true)
        self.left_panel:addChild(self.left_role)
        self.left_role:setLocalZOrder(-9999)
    end
    if not tolua.isnull(self.right_effect_node) and self.right_random_effect == nil then
        self.right_random_effect = createEffectSpine("E24001", cc.p(0, 0), cc.p(0.5, 0), true, PlayerAction.action)
        self.right_effect_node:addChild(self.right_random_effect)
    end
    local width = 26
    if self.hero_vo and self.hero_vo.star and self.hero_vo.star >= 16 then
        width = 20
    end
    self.left_star_setting = model:createStar(self.hero_vo.star, self.left_star_node, self.left_star_setting, width, self.hero_vo.star_step)
    self.open_status = false
    if self.look_type ~= 1 and model:getHeroEnableIsOpen(self.hero_vo.partner_id) then
        self.open_status = true
    end
    if not self.open_status then --未开放
        self.choose_tip:setVisible(false)
        self.change_btn:setVisible(false)
        self.lock_tip:setVisible(true)
        self.discharge_btn:setVisible(false)
        self.no_discharge_btn:setVisible(false)
        self.lock_txt_tip:setVisible(true)
        local txt = TI18N("语言_par_ult_18")
        local hero_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
        local need_star = Config.PartnerUltraData.data_const.open_ur_star.val
        self.lock_txt_tip:setString(LangStringFormat(txt,hero_cfg.name,need_star))
        if self.right_role then
            self.right_role:DeleteMe()
            self.right_role = nil
        end
        self.no_attr_panel:setVisible(true)
        self.attr_panel:setVisible(false)
        self.right_random_effect:setVisible(true)
        self.arrow:setVisible(false)
        self.right_star_node:setVisible(true)
        self.Image_2:setContentSize(cc.size(self.Image_2:getContentSize().width,243))
        self.skill_panel:setContentSize(cc.size(self.Image_2:getContentSize().width,232))
    else --已达到开放星级
        if not self.use_bid or self.use_bid == 0 then --未选择
            if self.right_role then
                self.right_role:DeleteMe()
                self.right_role = nil
            end
            self.choose_tip:setVisible(true)
            self.change_btn:setVisible(false)            
            self.lock_tip:setVisible(false)
            self.discharge_btn:setVisible(false)
            self.no_discharge_btn:setVisible(false)
            self.lock_txt_tip:setString(TI18N("语言_par_ult_19"))
            self.lock_txt_tip:setVisible(true)
            self.no_attr_panel:setVisible(true)
            self.attr_panel:setVisible(false)
            self.right_random_effect:setVisible(true)
            if self.right_role then
                self.right_role:DeleteMe()
                self.right_role = nil
            end
            self.arrow:setVisible(false)
            self.right_star_node:setVisible(false)
            self.Image_2:setContentSize(cc.size(self.Image_2:getContentSize().width,243))
            self.skill_panel:setContentSize(cc.size(self.Image_2:getContentSize().width,232))
        else--已选择
            self.right_random_effect:setVisible(false)
            self.right_hero_vo = model:getHeroById(self.use_bid)
            if self.right_role then
                self.right_role:DeleteMe()
                self.right_role = nil
            end
            if not self.right_role then
                self.right_role = BaseRole.new(BaseRole.type.partner, self.right_hero_vo, nil, {skin_id = self.right_hero_vo.use_skin,scale = 0.72})
                self.right_role:setCascade(true)
                self.right_role:setAnchorPoint(cc.p(0.5, 0))
                self.right_role:setPosition(cc.p(100, 178))
                self.right_role:setAnimation(0,PlayerAction.show,true)
                self.right_panel:addChild(self.right_role)
                self.right_role:setLocalZOrder(-9999)
            end
            self.right_star_node:setVisible(true)
            self.Image_2:setContentSize(cc.size(self.Image_2:getContentSize().width,163))
            self.skill_panel:setContentSize(cc.size(self.Image_2:getContentSize().width,152))
            self.right_star_setting = model:createStar(self.right_hero_vo.star, self.right_star_node, self.right_star_setting, 26)
            self.choose_tip:setVisible(false)
            self.change_btn:setVisible(false)  
            self.lock_tip:setVisible(false)
            self.lock_txt_tip:setVisible(false)
            self.no_attr_panel:setVisible(false)
            self.attr_panel:setVisible(true)
            if self.use_bid ~= model:getHeroEnable(self.hero_vo.partner_id) then --未确认
                self.change_btn:setVisible(true)
                self.discharge_btn:setVisible(true)
                self.no_discharge_btn:setVisible(false)
            else --已确认
                self.change_btn:setVisible(false)
                self.discharge_btn:setVisible(false)
                self.no_discharge_btn:setVisible(true)
            end
            self.arrow:setVisible(true)
            self:updateAttrPanel()
        end
    end
    self:updateTopPanel()
    self:updateSkillPanel()
end
--刷新技能图标容器
function HeroUrEnableWindow:updateTopPanel()
    if not self.skillItem then
        self.skillItem = SkillItem.new(true, true, true,0.9)
        self.skillItem:setPosition(cc.p(69, 58))
        self.top_panel:addChild(self.skillItem)
    end
    local cfg = Config.PartnerUltraData.data_ene_skill[self.hero_vo.bid]
    local skill_id = self.skill_bid
    if self.use_bid == 0 or skill_id == 0 then
        table.sort(cfg,function(a,b) return a.lev>b.lev end)
        skill_id = cfg[1].skill[1]
    end
    local skill_cfg = Config.SkillData.data_get_skill(skill_id)
    if not skill_cfg then return end
    self.skillItem:setData(skill_cfg)
    self.skill_name:setString(skill_cfg.name)
    setTextMaxWidth(self.skill_name,300,-8)
    self.skill_lev:setString(string.format(TI18N("语言_c_4520"),skill_cfg.level))
    self.skill_lev:setPositionY(self.skill_name:getPositionY() - self.skill_name:getContentSize().height-1)
    
    local type_list = {}
    for k,v in pairs(cfg) do
        if v.skill[1] == skill_id then
            type_list = v.desc
        end
    end
    for k,v in pairs(self.skill_type_list) do
        v:setVisible(false)
    end
    for k,v in pairs(type_list) do
        if not self.skill_type_list[k] then
            self.skill_type_list[k] = createSprite("", 145+(k-1)*72, 27, self.top_panel, cc.p(0, 0.5),LOADTEXT_TYPE)
        end
        loadSpriteTexture(self.skill_type_list[k], PathTool.getPlistImgForDownLoad("hero", "txt_cn_skill_desc_"..v), LOADTEXT_TYPE)
        self.skill_type_list[k]:setVisible(true)
    end
end
--刷新技能列表
function HeroUrEnableWindow:updateSkillPanel()
    local cfg = Config.PartnerUltraData.data_ene_skill[self.hero_vo.bid]
    table.sort(cfg,function(a,b) return a.lev < b.lev end)
    if self.skill_desc_list and next(self.skill_desc_list) then
        for k,v in ipairs(self.skill_desc_list) do
            v:removeFromParent()
            v=nil
        end
    end
    self.skill_desc_list = {}
    local _h = 0
    local buff_list = {}
    local _buff_list = {}
    for k,v in ipairs(cfg) do
        local item = self:getSkillItem(v)
        table.insert(self.skill_desc_list,item)  
        self.skill_panel:addChild(item)
        _h = _h + item:getContentSize().height
        local cfg = Config.SkillData.data_get_skill(v.skill[1])
        if not cfg then return end
        for _k,_v in pairs(cfg.buff_des or {}) do
            for key,value in pairs(_v or {}) do
                _buff_list[value] = 1
            end
        end
    end
    for k,v in pairs(_buff_list) do
        table.insert(buff_list,k)
    end
    local buff_desc_str = ""
    if buff_list and next(buff_list) then
        if not self.buff_item then
            self.buff_item = createRichLabel(20,cc.c3b(0xff,0xff,0xff),cc.p(0,1),cc.p(16,0),nil,nil,641)
            self.skill_panel:addChild(self.buff_item)
        end
        local buff_config = Config.SkillData.data_get_buff 
        for i, v in ipairs(buff_list) do
            local config = buff_config[v]
            if config then
                if buff_desc_str ~= "" then
                    buff_desc_str = buff_desc_str.."<div fontcolor=#7c5536>\n</div>"
                end
                local buff_desc = string.format("<div fontcolor=#6d3c2d>【%s】</div><div fontcolor=#7c5536>\n%s</div>", config.name, config.desc)
                buff_desc_str = buff_desc_str..buff_desc
            end
        end
        self.buff_item:setString(buff_desc_str)
        _h = _h + self.buff_item:getContentSize().height + 40
    end
    if _h < self.skill_panel:getContentSize().height then
        self.skill_panel:setContentSize(cc.size(self.skill_panel:getContentSize().width,_h))
    end
    _h = math.max(_h,self.skill_panel:getContentSize().height)
    self.skill_panel:setInnerContainerSize(cc.size(self.skill_panel:getContentSize().width,_h))
    local all_h = _h
    local _y = _h
    for k,v in ipairs(self.skill_desc_list) do
        if not v.status then
            _y = _h
        end
        v:setPositionY(_h)
        _h = _h - v:getContentSize().height
    end
    if self.buff_item then
        local line = createImage(self.skill_panel,PathTool.getResFrame("common", "common_10"),336,_h-10,cc.p(0.5,0.5),true,nil,true)
        line:setContentSize(cc.size(600,20))
        self.buff_item:setPositionY(_h-30)
    end
    local atr_h = self.skill_panel:getContentSize().height
    local scr_y = (atr_h-all_h)+(all_h-_y)
    if scr_y > 0 then
        self.skill_panel:getInnerContainer():setPositionY(0)
    else
        self.skill_panel:getInnerContainer():setPositionY(scr_y)
    end
end
--单个技能描述
function HeroUrEnableWindow:getSkillItem(data)
    local item = ccui.Layout:create()
    item:setAnchorPoint(0,1)
    item:setPosition(0, 0)
    local cfg = Config.SkillData.data_get_skill(data.skill[1])
    if not cfg then return end
    item.desc_txt = createRichLabel(20,cc.c3b(0xff,0xff,0xff),cc.p(0,1),cc.p(13,0),nil,nil,641)
    item:addChild(item.desc_txt)
    local str = "<div> <img src=\'%s\' scale=0.7 />  <img src=\'%s\' /> <div fontcolor=#7c5536>%s</div></div>"
    local desc_str = string.format(str,PathTool.getResFrame("common", "common_90032"),PathTool.getPlistImgForDownLoad("hero", "txt_cn_level_"..cfg.level),cfg.des)
    if data.skill[1] > self.skill_bid or self.is_lock then
        item.need_txt = createRichLabel(18,cc.c3b(0xff,0x15,0x15),cc.p(1,0),cc.p(661,0),nil,nil,649)
        local str_parameter = {}
        for k,v in ipairs(data.limit) do
            if v[1] == "star" then
                table.insert(str_parameter,v[2])
            end
        end
        local need_str = LangStringFormat(data.txt,str_parameter)
        str = "<div><img src=\'%s\' scale=0.8 /> <img src=\'%s\' /> <div fontcolor=#7c5536>%s</div></div>"
        item:addChild(item.need_txt)
        item.need_txt:setString(need_str)
        desc_str = string.format(str,PathTool.getResFrame("common", "common_90009_1"),PathTool.getPlistImgForDownLoad("hero", "txt_cn_level_"..cfg.level),cfg.des)
        item.desc_txt:setPositionX(9)
    end
    item.desc_txt:setString(desc_str)
    local _h = item.desc_txt:getContentSize().height+23
    local status = false
    if item.need_txt then
        _h = item.desc_txt:getContentSize().height + item.need_txt:getContentSize().height + 14
        status = true
    end
    item:setContentSize(cc.size(549, _h))
    item.desc_txt:setPositionY(_h-11)
    item.status = status
    return item
end
--刷新属性列表
function HeroUrEnableWindow:updateAttrPanel()
    local cfg = model:getHeroEnableAttrList(self.right_hero_vo.partner_id)
    if not cfg or not next(cfg) then return end
    local attr_cfg = cfg.attr
    if self.attr_list and next(self.attr_list) then
        for key,value in pairs(self.attr_list) do
            value:removeFromParent()
            value = nil
        end
    end
    local _h = math.max(self.attr_scroll:getContentSize().height,math.ceil(#attr_cfg/2)*40)
    self.attr_scroll:setInnerContainerSize(cc.size(self.attr_scroll:getContentSize().width,_h))
    self.attr_scroll:setTouchEnabled(_h > self.attr_scroll:getContentSize().height)
    self.attr_list = {}
    for key,value in ipairs(attr_cfg) do
        local item = self:createAttrItem(value)
        self.attr_scroll:addChild(item)
        local _x = (key-1)%2*348
        local _y = _h-math.floor((key-1)/2)*40
        item:setPosition(cc.p(_x,_y))
        table.insert(self.attr_list,item)
    end
end
function HeroUrEnableWindow:createAttrItem(data)
    local item = ccui.Layout:create()
    item:setContentSize(cc.size(328, 34))
    item:setAnchorPoint(0,1)
    item:setPosition(0, 0)
    item.bg = createImage(item,PathTool.getResFrame("common", "common_1002"),0,0,cc.p(0,0),true,nil,true)
    item.bg:setContentSize(cc.size(328, 34))
    local attr_key = data[1]
    local attr_val = data[2]
    local icon = PathTool.getAttrIconByStr(attr_key)
    local icon_res = PathTool.getResFrame("common", icon)
    item.icon = createSprite(icon_res,19,18,item,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    local attr_name = Config.AttrData.data_key_to_name[attr_key]
    if not attr_name then
        attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
    end
    item.name_txt = createLabel(20,cc.c3b(0x6d,0x3c,0x2d),nil,43,18,attr_name,item,nil,cc.p(0,0.5))
    local is_per = PartnerCalculate.isShowPerByStr(attr_key)
    if is_per == true then
        attr_val = (attr_val/10) .."%"
    end
    item.value_txt = createLabel(20,cc.c3b(0x0e,0xa8,0x0e),nil,305,18,attr_val,item,nil,cc.p(1,0.5))
    return item
end
function HeroUrEnableWindow:close_callback()
    controller:openHeroUrEnableWindow(false)
    if self.right_random_effect then
        self.right_random_effect:clearTracks()
        self.right_random_effect:removeFromParent()
        self.right_random_effect = nil
    end
	if self.left_role then
		self.left_role:DeleteMe()
		self.left_role = nil
	end
	if self.right_role then
		self.right_role:DeleteMe()
		self.right_role = nil
	end
end