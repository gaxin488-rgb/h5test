HeroUrEnableConfirmWindow = HeroUrEnableConfirmWindow or BaseClass(BaseView)
    
local controller = HeroController:getInstance()
local model = controller:getModel()

--@holy_data 神装方案数据 结构参考 协议25220
function HeroUrEnableConfirmWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Big
    self.layout_name = "hero/hero_ur_enable_confirm_window"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("hero","hero"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("proscription","soul"), type = ResourcesType.plist },
    }
end 

function HeroUrEnableConfirmWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
    self.img_title_bg = self.main_container:getChildByName("img_title_bg")
    self.wnd_title = self.main_container:getChildByName("wnd_title")
    self.wnd_title:setString(TI18N("语言_par_ult_7"))
    autoSizeTitleBg(self.wnd_title,self.img_title_bg,120,320)
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.top_panel_size = self.top_panel:getContentSize()
    self.top_title_bg = self.top_panel:getChildByName("top_title_bg")
    self.top_title = self.top_panel:getChildByName("top_title")
    self.top_title:setString(TI18N("语言_par_ult_8"))
    self.top_scr = self.top_panel:getChildByName("top_scr")
    self.top_scr:setScrollBarEnabled(false)
    self.mid_panel = self.main_container:getChildByName("mid_panel")
    self.mid_panel_size = self.mid_panel:getContentSize()
    self.mid_title_bg = self.mid_panel:getChildByName("mid_title_bg")
    self.mid_title = self.mid_panel:getChildByName("mid_title")
    self.mid_title:setString(TI18N("语言_par_ult_9"))
    self.mid_scr = self.mid_panel:getChildByName("mid_scr")
    self.mid_scr:setScrollBarEnabled(false)
    self.mid_tip = self.mid_panel:getChildByName("mid_tip")
    self.mid_tip:setString(TI18N("语言_par_ult_21"))
    self.mid_tip:setVisible(false)
    self.bot_panel = self.main_container:getChildByName("bot_panel")
    self.bot_panel_size = self.bot_panel:getContentSize()
    self.line_1 = self.bot_panel:getChildByName("line_1")
    self.bot_title_bg = self.bot_panel:getChildByName("bot_title_bg")
    self.bot_title = self.bot_panel:getChildByName("bot_title")
    self.bot_title:setString(TI18N("语言_par_ult_10"))
    autoSizeTitleBg(self.bot_title,self.bot_title_bg,25,200)
    self.line_2 = self.bot_panel:getChildByName("line_2")
    setLeftRightImg(self.line_1,self.bot_title_bg,self.line_2,30)
    self.bot_scr = self.bot_panel:getChildByName("bot_scr")
    self.bot_scr:setScrollBarEnabled(false)
    self.bot_line = self.main_container:getChildByName("bot_line")
    self.confirm_btn = self.main_container:getChildByName("confirm_btn")
    self.confirm_txt = self.confirm_btn:getChildByName("label")
    self.confirm_txt:setString(TI18N("语言_c_63"))
    self.cancellation_btn = self.main_container:getChildByName("cancellation_btn")
    self.cancellation_txt = self.cancellation_btn:getChildByName("label")
    self.cancellation_txt:setString(TI18N("语言_c_62"))
end

function HeroUrEnableConfirmWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        self:_onClickClose()
    end, true, 2)
    registerButtonEventListener(self.background, function()
        self:_onClickClose()
    end, false, 2)
    registerButtonEventListener(self.cancellation_btn, function()
        self:_onClickClose()
    end, true, 2)
    registerButtonEventListener(self.confirm_btn, function()
        controller:sender11478(self.hero_vo.partner_id,self.use_hero_vo.partner_id,0)
    end, true, 2)
end
function HeroUrEnableConfirmWindow:_onClickClose()
    GlobalEvent:getInstance():Fire(HeroEvent.Hero_UR_Score_Enable_Click_Event, self.hero_vo.partner_id,0)
    controller:openHeroUrEnableConfirmWindow(false)
end
function HeroUrEnableConfirmWindow:openRootWnd(setting)
    self.setting = setting or {}
    self.hero_vo = setting.hero_vo or {}
    self.use_bid = setting.use_bid or {}
    self.use_hero_vo = model:getHeroById(self.use_bid)
    self:updateTopPanel()
    self:updateMidPanel()
    self:updateBotPanel()
    self:updatepPagePanel()
end
function HeroUrEnableConfirmWindow:updateTopPanel()
    local cfg = model:getHeroEnableAttrList(self.use_hero_vo.partner_id)
    if not cfg or not next(cfg) then return end
    local attr_cfg = cfg.attr
    if self.attr_list and next(self.attr_list) then
        for key,value in pairs(self.attr_list) do
            value:removeFromParent()
            value = nil
        end
    end
    local need_h = math.ceil(#attr_cfg*0.5)*36 + (math.ceil(#attr_cfg*0.5)-1)*6
    if need_h < self.top_scr:getContentSize().height then
        self.top_scr:setContentSize(cc.size(self.top_scr:getContentSize().width,need_h))
    end
    local _h = math.max(self.top_scr:getContentSize().height,need_h)
    self.top_scr:setInnerContainerSize(cc.size(self.top_scr:getContentSize().width,_h))
    self.top_scr:setTouchEnabled(_h > self.top_scr:getContentSize().height)
    self.attr_list = {}
    for key,value in ipairs(attr_cfg) do
        local item = self:createAttrItem(value)
        self.top_scr:addChild(item)
        local _x = (key-1)%2*313
        local _y = _h-math.floor((key-1)/2)*42
        item:setPosition(cc.p(_x,_y))
        table.insert(self.attr_list,item)
    end
    self.top_height = self.top_scr:getContentSize().height + 46
    self.top_title_bg:setPositionY(self.top_height - 16)
    self.top_title:setPositionY(self.top_height - 16)
end
function HeroUrEnableConfirmWindow:createAttrItem(data)
    local item = ccui.Layout:create()
    item:setContentSize(cc.size(290, 36))
    item:setAnchorPoint(0,1)
    item:setPosition(0, 0)
    item.bg = createImage(item,PathTool.getResFrame("common","common_1002"),0,0,cc.p(0,0),true,nil,true)
    item.bg:setContentSize(cc.size(290, 36))
    local attr_key = data[1]
    local attr_val = data[2]
    local icon = PathTool.getAttrIconByStr(attr_key)
    local icon_res = PathTool.getResFrame("common", icon)
    item.icon = createSprite(icon_res,18,18,item,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    local attr_name = Config.AttrData.data_key_to_name[attr_key]
    if not attr_name then
        attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
    end
    item.name_txt = createLabel(22,cc.c3b(0x6d,0x3c,0x2d),nil,42,18,attr_name,item,nil,cc.p(0,0.5))
    local is_per = PartnerCalculate.isShowPerByStr(attr_key)
    if is_per == true then
        attr_val = (attr_val/10) .."%"
    end
    item.value_txt = createLabel(22,cc.c3b(0x0e,0xa8,0x0e),nil,235,18,attr_val,item,nil,cc.p(0.5,0.5))
    return item
end

function HeroUrEnableConfirmWindow:updateMidPanel()
    local cfg = model:getHeroEnableSkillCfg(self.hero_vo.partner_id,self.use_hero_vo.partner_id)
    if not cfg or not next(cfg) then
        self.mid_tip:setVisible(true)
        return
    end
    self.mid_tip:setVisible(false)
    local skill_id = cfg.skill[1]
    local skill_cfg = Config.SkillData.data_get_skill(skill_id)
    if not self.skill_item then
        self.skill_item = SkillItem.new(true, false, true, 0.95)
        self.mid_panel:addChild(self.skill_item)
        self.skill_item:setPosition(cc.p(79,104))
    end
    self.skill_item:setData(skill_cfg)
    if not self.mid_scr_txt then
        self.mid_scr_txt = createRichLabel(20,cc.c3b(0x7c,0x55,0x36),cc.p(0,1),cc.p(0,100),-4,nil,410)
        self.mid_scr:addChild(self.mid_scr_txt)
    end
    local txt = "<div><img src=\'%s\' /> <div>%s</div></div>"
    self.mid_scr_txt:setString(string.format(txt,PathTool.getPlistImgForDownLoad("hero", "txt_cn_level_"..skill_cfg.level),skill_cfg.des))
    local _h = math.max(self.mid_scr_txt:getContentSize().height,self.mid_scr:getContentSize().height)
    self.mid_scr:setInnerContainerSize(cc.size(self.mid_scr:getContentSize().width,_h))
    self.mid_scr:setTouchEnabled(_h > self.mid_scr:getContentSize().height)
    self.mid_scr_txt:setPositionY(_h)
end

function HeroUrEnableConfirmWindow:updateBotPanel()
    if not self.bot_scr_txt then
        self.bot_scr_txt = createRichLabel(20,cc.c3b(0x7c,0x55,0x36),cc.p(0,1),cc.p(0,100),-4,nil,530)
        self.bot_scr:addChild(self.bot_scr_txt)
    end
    self.bot_scr_txt:setString(TI18N("语言_par_ult_11"))
    local _h = math.max(self.bot_scr_txt:getContentSize().height,self.bot_scr:getContentSize().height)
    self.bot_scr:setInnerContainerSize(cc.size(self.bot_scr:getContentSize().width,_h))
    self.bot_scr:setTouchEnabled(_h > self.bot_scr:getContentSize().height)
    self.bot_scr_txt:setPositionY(_h)
end
--自适应
function HeroUrEnableConfirmWindow:updatepPagePanel()
    local _h = self.top_height + self.mid_panel_size.height + self.bot_panel_size.height + 227
    self.main_container:setContentSize(cc.size(self.main_container:getContentSize().width,_h))
    self.close_btn:setPositionY(_h-8)
    self.img_title_bg:setPositionY(_h-4)
    self.wnd_title:setPositionY(_h-4)
end
function HeroUrEnableConfirmWindow:close_callback()
    controller:openHeroUrEnableConfirmWindow(false)
end