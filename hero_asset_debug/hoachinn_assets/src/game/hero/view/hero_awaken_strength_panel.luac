            end
            table.insert(_attr_data, {key,now_val,next_val})
        end
    else
        for i, v in ipairs(lev_cfg.attr) do
            local key = v[1]
            local next_val = v[2]
            local now_val = getAttrInfo(key)
            if self.base_data.lev == 0 then
                now_val = 0
            end
            table.insert(_attr_data, {key,now_val,next_val})
        end
