    for i=1,6 do
        self.attr_icon_list[i] = attr_panel:getChildByName("attr_icon"..i)
        self.attr_label_key_list[i] = attr_panel:getChildByName("attr_label_key"..i)
        self.attr_label_key_list[i]:setTouchEnabled(true)
        self.attr_labe_left_list[i] = attr_panel:getChildByName("attr_label_left"..i)
        self.attr_labe_right_list[i] = attr_panel:getChildByName("attr_label_right"..i)
        self.attr_arrow_list[i] = attr_panel:getChildByName("arrow_icon"..i)
        -- self.attr_imagebox_list[i] = attr_panel:getChildByName("imgbox_"..i)
    end
    -- self.attr_label_key_list[1]:setString(TI18N("语言_c_2000"))

    --技能
    self.skill_panel = self.main_container:getChildByName("skill_panel")
    self.skill_title = self.skill_panel:getChildByName("skill_title")
    self.skill_title:setString(TI18N("语言_c_4965"))
    self.scrollview_des = self.skill_panel:getChildByName("scrollview_des")
