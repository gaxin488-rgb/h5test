    --         self.attr_labe_left_list[i]:setString(attr_val)
    --         if lev_cfg_next and lev_cfg_next.attr and lev_cfg_next.attr[i] and lev_cfg_next.attr[i][2] then
    --             attr_val_next = lev_cfg_next.attr[i][2]
    --             if is_per == true then
    --                 attr_val_next = (attr_val_next/10).."%"
    --             end
    --         end
    --         self.attr_labe_right_list[i]:setString(self.is_max_lv and "max" or attr_val_next)

    --         self.attr_icon_list[i]:setVisible(true)
    --         self.attr_label_key_list[i]:setVisible(true)
    --         self.attr_labe_left_list[i]:setVisible(true)
    --         self.attr_labe_right_list[i]:setVisible(true)
    --         self.attr_arrow_list[i]:setVisible(true)
    --     else
    --         self.attr_icon_list[i]:setVisible(false)
    --         self.attr_label_key_list[i]:setVisible(false)
    --         self.attr_labe_left_list[i]:setVisible(false)
    --         self.attr_labe_right_list[i]:setVisible(false)
    --         self.attr_arrow_list[i]:setVisible(false)
    --     end
    -- end

    -- ccui.Helper:doLayout(self.main_container)
    --技能
    if self.data.panel_type == HERO_SOUL_TYPE then
        local des = ""
        local level = 0
        for i, v in ipairs(Config.PartnerUrAwakenData.data_lv_info[data.id][1] or {}) do
            if self.base_data.lev < i and v.desc and v.desc ~= "" then
