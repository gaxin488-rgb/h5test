    self.node_item_1:addChild(item)
    self.node_item_1.itemIcon = item
    self.node_item_2 = item_top_panel:getChildByName("node_item_2")
    local item = ExclusiveItem.new()
    self.node_item_2:addChild(item)
    self.node_item_2.itemIcon = item

    --top
    self.help_btn = self.main_container:getChildByName("help_btn")
    self.left_btn = self.main_container:getChildByName("left_btn")
    self.right_btn = self.main_container:getChildByName("right_btn")
    local Panel_3 = self.main_container:getChildByName("Panel_3")
    local size = Panel_3:getContentSize()
    self.scroll_view_size = size
    -- local setting = {
    --     item_class = HeroSuperHeartStrengItem,      -- 单元类
    --     start_x = 0,                    -- 第一个单元的X起点
    --     space_x = 0,                    -- x方向的间隔
    --     start_y = 0,                    -- 第一个单元的Y起点
    --     space_y = 50,                    -- y方向的间隔
    --     item_width = 720,               -- 单元的尺寸width
    --     item_height = 655,              -- 单元的尺寸height
    --     row = 0,                        -- 行数，作用于水平滚动类型
    --     col = 1,                        -- 列数，作用于垂直滚动类型
    --     -- once_num = 3,
    --     -- need_dynamic = true
    -- }
    -- self.page_scrollview = CommonScrollViewLayout.new(Panel_3, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.bottom, size, setting)

    if self.page_scrollview == nil then
        local list_setting = {
            start_x = 0,
            space_x = 0,
            start_y = 0,
            space_y = 50,
            item_width = 720,
            item_height = 655,
            row = 0,
            col = 1,
            once_num = 3,
            need_dynamic = true
        }
        self.page_scrollview = CommonScrollViewSingleLayout.new(Panel_3, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.bottom, self.scroll_view_size, list_setting, cc.p(0, 0)) 
        self.page_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.page_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.page_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end


    self.bottom_bg = self.root_wnd:getChildByName("bottom_bg")
    self.player_info_panel = PlayerInfoPanel.new()
    self.main_container:addChild(self.player_info_panel)
