            end
        end
    end

    if visit_cfg and visit_cfg.cost_num and next(visit_cfg.cost_num) and visit_cfg.cost_num[1][1] then
        local item_list = {}
        self.cost_panel.node_item:removeAllChildren()
        self.hero_item_list = {}
        self.dic_other_selected = {}
        local cost = visit_cfg.cost_num--{{10412,10},{24400,1}}
        local total_w = 0
        local item_width = 0
        for i, v in ipairs(cost) do
            local item = BackPackItem.new(false, true, false, 0.8, false, true, false)
            item:setDefaultTip(true,false)
            self.cost_panel.node_item:addChild(item)
            item:setData({bid = v[1], num = v[2]})
            local num = BackpackController:getInstance():getModel():getItemNumByBid(v[1])
            local config = Config.ItemData.data_get_data(v[1])
            if config.type == BackPackConst.item_type.NORMAL and config.sub_type == BackPackConst.item_tab_type.HERO then
                local bid = config.effect[1].val[1] 
                local hero_cfg = Config.PartnerData.data_partner_base[bid]
                num = #(controller:getModel():getHeroInfoByBidStar(hero_cfg.bid, config.eqm_jie))
            end
            item:setNeedNum(v[2], num)
            if item.num_label:getScale() < 0.7 then
                item:setNumScale(0.7)
            end 
            if self.is_max_lv then
                item:setNumLabel(false)
            end
            item_list[#item_list + 1]  = item
            local item_size = item:getContentSize()
            item_width = item_size.width
            item:setPosition(item_size.width/2*0.8 + 10 + (i - 1)*item_size.width*0.8, 40)
            total_w = total_w + item_size.width + 5*(i - 1)
        end
        local expend = visit_cfg.expend1[1]
        self.hero_item_data_list = {}
        if expend then
            --指定的 {10402,4,1} : 10402: 表示bid, 4: 表示星级 1:表示数量
            self.hero_item_data_list[#self.hero_item_data_list + 1]  = self:getHeroData(expend[1], expend[2], expend[3]) 
            local target_item = HeroExhibitionItem.new(0.8, true)
            target_item:addCallBack(function()
                self.dic_other_selected = {}--self.hero_item_list[1].dic_select_list
                local setting = {}
                setting.is_master = false
                local hero_cfg = Config.PartnerData.data_partner_base[expend[1]]
                local list = controller:getModel():getHeroInfoByBidStar(expend[1],expend[2])
                num = list and #list or 0
                if num == 0 then
                    BackpackController:getInstance():openTipsSource( true,hero_cfg.item_id)
                else 
                    controller:openHeroUpgradeStarSelectPanel(true, self.hero_item_data_list[1], self.dic_other_selected, HeroConst.SelectHeroType.eStarFuse, setting)
               end
            end)
            self.cost_panel.node_item:addChild(target_item)
            target_item:setData(self.hero_item_data_list[#self.hero_item_data_list])
            self.hero_item_list[#self.hero_item_list + 1] = target_item
            item_list[#item_list + 1]  = target_item
            local item_size = target_item:getContentSize()
            item_width = item_size.width
            target_item:setPosition(item_size.width/2*0.8 + 10 + (#item_list - 1)*item_size.width*0.8, 40)
            total_w = total_w + item_size.width + 5*(#item_list - 1)
            self:initCostHero(expend)
            if self.is_max_lv then
                target_item.num_label:setVisible(false)
            end
        end

        -- for i, v in ipairs(item_list) do
            -- v:setPositionX(- total_w/2 + item_width/2 + (i - 1)*(10 + item_width))
        -- end
        -- self.cost_panel.label:setPositionX(-total_w/2 - 5)
        self.cost_panel:setVisible(true)
    else
        self.cost_panel:setVisible(false)
    end
    self.image_resert:setVisible(0 < self.base_data.lev)
    if self.is_max_lv then
        setChildUnEnabled(true, self.streng_btn)
        self.streng_btn:getChildByName("label"):setString(TI18N("语言_c_2176"))
        self.streng_btn:setTouchEnabled(false)
        self.streng_btn:setVisible(false)
        self.cost_panel:setVisible(false)
        self.max_txt:setVisible(true)
    else
        setChildUnEnabled(false, self.streng_btn)
        self.streng_btn:getChildByName("label"):setString(TI18N("语言_c_4967"))
        self.streng_btn:setTouchEnabled(true)
        self.streng_btn:setVisible(true)
        self.cost_panel:setVisible(true)
        self.max_txt:setVisible(false)

        if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
            setChildUnEnabled(true, self.streng_btn)
        end
        
    end
end

---初始化吃卡材料
function HeroAwakenStrengthPanel:initCostHero(expend)
    local item = self.hero_item_list[1]
    local data = self.hero_item_data_list[1]
    local hero_list = model:getHeroList()

    self.conditions_hero_list = {}
    for k,hero in pairs(hero_list) do
        --指定卡
        if expend[1] == hero.bid and expend[2] == hero.star then
            table.insert(self.conditions_hero_list, hero)
        end
    end
    local sort_func = SortTools.tableCommonSorter({{"lev", true}, {"id", true}})
    table.sort(self.conditions_hero_list, sort_func)
    local count = 0
    for _,hero_vo in ipairs(self.conditions_hero_list) do
        if data.dic_select_list[hero_vo.id] == nil then
            data.dic_select_list[hero_vo.id] = hero_vo
            if not hero_vo:isInForm() and not hero_vo:isLock() then
                count = count + 1
            end
            if count >= data.count then
                break
            end
        end
    end
    self:updateHeroItemInfo()
end

function HeroAwakenStrengthPanel:updateHeroItemInfo()
    local item = self.hero_item_list[1]
    local data = self.hero_item_data_list[1]
    local count = 0
    for k, v in pairs(data.dic_select_list) do
        count = count + 1
    end
    data.lev = string_format("%s/%s", count, data.count)
    item.num_label:setString(data.lev)
    if count >= data.count then
        item:setHeadUnEnabled(false)
    else
        item:setHeadUnEnabled(true)
    end  
end

function HeroAwakenStrengthPanel:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s/%s", 0, count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end

--无技能显示信息
function HeroAwakenStrengthPanel:ShowNoneSkillInfo( ... )
    self.skill_title:setVisible(false)
    self.skill_name:setString(TI18N("语言_c_2001"))
    local size = self.skill_panel:getContentSize()
    local bg = createImage(self.skill_panel, self.empty_res, size.width/2, size.height/2, cc.p(0.5,0.5), false)
    bg:setScale(0.6)
end

--左边
function HeroAwakenStrengthPanel:_onClickBtnLeft()
    if not self.can_click then
        return
    end
    self.page_index = self.page_index -1
    if self.page_index <= 1 then
        self.page_index = 1
    end
    self.can_click = false
    -- self.page_scrollview:setData({self.page_data[self.page_index]})
    -- self.page_scrollview:scrollToPercentHorizontal((self.page_index-1)/self.total_page*100,1,true)--(100*self.page_index/self.total_page,1,true)
    self.left_btn:setVisible(self.page_index ~= 1)
    self.right_btn:setVisible(self.page_index ~= self.total_page)
    -- print("------------------",self.page_index)
    self.page_scrollview:updateCellAtIndex(self.page_index)
    local posx = -(self.page_index-1) * 720
    local function callback()
        self.can_click = true
    end
    self.page_scrollview:jumpToMove(cc.p(720, 31),0.3,callback)
end
--右边
function HeroAwakenStrengthPanel:_onClickBtnRight()
    if not self.can_click then
        return
    end
    self.page_index = self.page_index + 1
    if self.page_index >= self.total_page then
        self.page_index = self.total_page 
    end
    self.can_click = false
    -- self.page_scrollview:setData({self.page_data[self.page_index]})
    -- self.page_scrollview:scrollToPercentHorizontal((self.page_index-1)/self.total_page*100,1,true)
    self.left_btn:setVisible(self.page_index ~= 1)
    self.right_btn:setVisible(self.page_index ~= self.total_page)
    self.page_scrollview:updateCellAtIndex(self.page_index)
    local posx = -(self.page_index-1) * 720
    local function callback()
        self.can_click = true
    end
    self.page_scrollview:jumpToMove(cc.p(-720, 31),0.3,callback)
end

function HeroAwakenStrengthPanel:close_callback()
    if self.skill_item then 
        self.skill_item:DeleteMe()
        self.skill_item = nil
    end
    if self.player_info_panel then 
        self.player_info_panel:DeleteMe()
        self.player_info_panel = nil
    end
    controller:openHeroUrAweakenPanel(false)
end

----------------------------------------------item-----------------------
local _table_insert = table.insert

HeroSuperHeartStrengItem = class("HeroSuperHeartStrengItem", function()
    return ccui.Widget:create()
end)

function HeroSuperHeartStrengItem:ctor()
	self:configUI()
	self:register_event()
end

function HeroSuperHeartStrengItem:configUI( )
	local csbPath = PathTool.getTargetCSB("hero/hero_awaken_strength_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
    self:setContentSize(self.root_wnd:getContentSize())
    self:setAnchorPoint(cc.p(0,0))
	
	self.container = self.root_wnd:getChildByName("container")
    self.sp_bg1 = self.container:getChildByName("sp_bg1")
	self.sp_bg2 = self.container:getChildByName("sp_bg2")
	self.sp_bg3 = self.container:getChildByName("sp_bg3")

    self.image_list = {}
    for i = 1, 5, 1 do
        local image = self.container:getChildByName("image_"..i)
        image:setSwallowTouches(false)
        local icon = image:getChildByName("Image_icon")
        local next_icon = image:getChildByName("next_icon")
        image.icon = icon
        image.next_icon = next_icon
        self.image_list[#self.image_list + 1] = image
    end

    self.image_list_1 = {}
    for i = 1, 2, 1 do
        local image = self.container:getChildByName("image_1_"..i)
        image:setSwallowTouches(false)
        local icon = image:getChildByName("Image_icon")
        image.icon = icon

        local next_icon = image:getChildByName("next_icon")
        image.next_icon = next_icon

        local sp_mark = image:getChildByName("sp_mark")
        if sp_mark then 
            image.sp_mark = sp_mark
            sp_mark:setLocalZOrder(9)
        end
        self.image_list_1[#self.image_list_1 + 1] = image
    end

end

function HeroSuperHeartStrengItem:register_event(  )

end

function HeroSuperHeartStrengItem:setClickCallBack(back_fun)
	if back_fun then
		self.main_container:setTouchEnabled(true)
		self.back_fun = back_fun
	end
end

function HeroSuperHeartStrengItem:setItemTouchEnabled(enabled)
	self.main_container:setTouchEnabled(enabled)
end

function HeroSuperHeartStrengItem:setData(data)
	self.data = data
    if self.data.page_index == self.data.total_page then
        self.sp_bg3:setVisible(false)
    else
        self.sp_bg3:setVisible(true)
    end
    self:setLocalZOrder(self.data.page_index)
    for k, v in pairs(self.image_list) do
        v:setVisible(false)
    end
    for k, v in pairs(self.image_list_1) do
        v:setVisible(false)
    end

    local pos_list = {{398, 94},{494, 293},{268, 271},{185, 460},{382, 554}}
    local index_1 = 1
    local index_2 = 1

    local h_cfg = Config.PartnerData.data_partner_base_fun(data.hero_vo.bid)
    local hid = h_cfg.ur_awaken_id
    local ur_lev = 0
    if data.hero_vo.ur_awaken and data.hero_vo.ur_awaken[1] then
        ur_lev = data.hero_vo.ur_awaken[1].p_lev
    end

    for i = 1, 5 do
        local index = i + (data.page_index - 1)*5 
        local lev_cfg_visit = Config.PartnerUrAwakenData.data_lv_info[hid][1][index]
        local eff_name = "E29013"
        local config = Config.SkillData.data_get_skill(lev_cfg_visit.unlock[1] or 0)
        local item
        local eff_scale = 1
        if config then
            item = self.image_list_1[index_1]

            local bg_res = PathTool.getPlistImgForDownLoad("heroawaken/heroawaken_icon",lev_cfg_visit.icon, false)
            item.icon:ignoreContentAdaptWithSize(true)
            item.icon:loadTexture(bg_res, LOADTEXT_TYPE)
            item.icon:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    local index =  i + (self.data.page_index - 1) * 5
                    local config_list = Config.PartnerUrAwakenData.data_lv_info[hid][1]
                    if config_list then 
                        local config = config_list[index]
                        if config then  
                            local common_tpis = TipsManager:getInstance():showCommonTips(config.desc,sender:getTouchBeganPosition())
                            local posx = sender:getTouchBeganPosition().x - common_tpis:getContentSize().width/2
                            local posy = sender:getTouchBeganPosition().y
                            if posx + common_tpis:getContentSize().width/2 > 480 then 
                                posx = SCREEN_WIDTH - common_tpis:getContentSize().width
                            end
                            if posx < 0 then
                                posx = 0
                            end
                            common_tpis:setPosition(cc.p(posx,posy))
                        end
                    end
                end
            end)
            item:setVisible(true)

            eff_name = "E29014"
            eff_scale = 1.2
            index_1 = index_1 + 1
        else
            item = self.image_list[index_2]

            local bg_res = PathTool.getPlistImgForDownLoad("heroawaken/heroawaken_icon",lev_cfg_visit.icon, false)
            item.icon:ignoreContentAdaptWithSize(true)
            item.icon:loadTexture(bg_res, LOADTEXT_TYPE)
            item:setVisible(true)

            eff_name = "E"..lev_cfg_visit.icon
            index_2 = index_2 + 1

            local big_img = Config.PartnerUrAwakenData.data_constant.select_zoom.val
            if table.indexof(big_img, tonumber(lev_cfg_visit.icon)) then
                item.next_icon:setScale(1.15)
            else
                item.next_icon:setScale(1)
            end
        end
        item:setPosition(cc.p(pos_list[i][1], pos_list[i][2]))

        if item.spine then
            item.spine:removeFromParent()
            item.spine = nil
        end

        local size = item:getContentSize()
        local isGray = ur_lev < lev_cfg_visit.lv
        local spine = createEffectSpine(eff_name, cc.p(size.width/2-3, size.height/2), cc.p(0.5, 0.5), true, "action")
        spine:setScale(eff_scale)
        item:addChild(spine,10)
        item.spine = spine
        setChildUnEnabled(isGray, item.icon)
        if not isGray then
            item.spine:setVisible(true)
        else
            item.spine:setVisible(false)
        end
        if item.sp_mark then
            item.sp_mark:setVisible(ur_lev + 1 == lev_cfg_visit.lv)
        end
        if item.next_icon then
            item.next_icon:setVisible(ur_lev + 1 == lev_cfg_visit.lv)
        end
        item:setVisible(true)

    end

end
function HeroSuperHeartStrengItem:getItemPosition()
    if self then
        return cc.p(self:getPosition())
    end
end

function HeroSuperHeartStrengItem:DeleteMe(  )
	self:removeAllChildren()
    self:removeFromParent()
end