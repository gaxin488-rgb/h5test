    self.max_txt = self.main_container:getChildByName("max_txt")
    self.max_txt:setString(TI18N("语言_c_4810"))
    self.max_txt:setVisible(false)

    local item_top_panel = self.main_container:getChildByName("item_top_panel")
    self.img_name_1 = item_top_panel:getChildByName("img_name_1")
    self.label_name_cur = self.img_name_1:getChildByName("label_name")
    self.label_name_cur:setChangeScaleOffWidth(-600)
    self.img_name_2 = item_top_panel:getChildByName("img_name_2")
    self.label_name_next = self.img_name_2:getChildByName("label_name")
    self.label_name_next:setChangeScaleOffWidth(-600)
    self.node_item_1 = item_top_panel:getChildByName("node_item_1")
