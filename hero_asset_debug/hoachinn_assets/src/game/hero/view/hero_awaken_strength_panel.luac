HeroAwakenStrengthPanel = HeroAwakenStrengthPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
function HeroAwakenStrengthPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Full
    self.is_full_screen = false
    self.can_click = true
    self.layout_name = "hero/hero_awaken_strength_panel"

    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("heroawaken", "heroawaken"), type = ResourcesType.plist},
    }
end

function HeroAwakenStrengthPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_size = self.main_container:getContentSize()
    self:playEnterAnimatianByObj(self.main_container , 2)  
    self.imgTitleBg = self.main_container:getChildByName("imgTitleBg")
    self.title = self.main_container:getChildByName("win_title")
    self.title:setString(TI18N("语言_c_7242"))
    --消耗
    self.cost_panel = self.main_container:getChildByName("cost_panel")
    self.cost_panel.label = self.cost_panel:getChildByName("label")
    self.cost_panel.label:setString(TI18N("语言_role_wake_1"))
