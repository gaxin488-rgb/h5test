    self.player_info_panel:setPositionY(top_y)

    self:adaptationScreen()
end

function HeroAwakenStrengthPanel:createNewCell()
    local cell = HeroSuperHeartStrengItem.new()
    return cell
end
--获取数据数量
function HeroAwakenStrengthPanel:numberOfCells()
    return #self.page_data
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function HeroAwakenStrengthPanel:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.page_data[index]
    cell:setData(cell_data)
end

function HeroAwakenStrengthPanel:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    self.bottom_bg:setPositionY(bottom_y + 13)
    self.close_btn:setPositionY(bottom_y + 94)
    self.imgTitleBg:setPositionY(top_y - 48)
    self.title:setPositionY(top_y - 90)
    self.help_btn:setPositionY(top_y - 110)
end

--强化成功效果
function HeroAwakenStrengthPanel:showEffect()
    local item_top_panel = self.main_container:getChildByName("item_top_panel")
    if not self.up_effect then 
        local effect = createSpineByName("E50119")
        -- effect:setPosition(cc.p(self.size.width/2, self.size.height/2 + 10))
        item_top_panel:addChild(effect, 100)
        local size = item_top_panel:getContentSize()
        effect:setPosition(cc.p(size.width/2, size.height/2))
        self.up_effect = effect
    end
    self.up_effect:setAnimation(0, PlayerAction.action_1, false)
end

function HeroAwakenStrengthPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self._onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.streng_btn, handler(self, self._onClickBtnBreak) ,true, 2)
    registerButtonEventListener(self.help_btn, handler(self, self._onClickBtnHelp) ,true, 2)
    registerButtonEventListener(self.image_resert, function()
        if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
            message(TI18N("语言_c_7567"))
            return
        end
        controller:openHeroUrAweakenResetPanel(true,self.data)
    end ,true, 2)
    registerButtonEventListener(self.image_review, function()
        local data = {panel_type = HERO_SOUL_TYPE, hero_vo = self.hero_vo, is_lock = false}
        HeroController:getInstance():openHeroUrAweakenPreviewPanel(true, data)
    end,true, 2)

    --强化数据更新
    self:addGlobalEvent(HeroEvent.Hero_UR_Awaken_Update_Event, function(vo) 
        if not self.hero_vo then return end
        if self.hero_vo.partner_id ~= vo.partner_id then return end
        self.hero_vo = model:getHeroById(self.hero_vo.partner_id)
        self:showEffect()
        self:updateData()
        self:setData()
    end)

    --添加英雄选择返回事件
    self:addGlobalEvent(HeroEvent.Upgrade_Star_Select_Event, function(vo) 
        self:updateHeroItemInfo()
    end)

    -- registerButtonEventListener(self.left_btn, handler(self, self._onClickBtnLeft) ,true, 1)
    -- registerButtonEventListener(self.right_btn, handler(self, self._onClickBtnRight) ,true, 1)

    -- local function onTouchBegin(touch, event)
    --     self.touch_pointX = nil
    --     local tt =touch:getLocation()
    --     self.touch_pointX = tt.x;
    --     return true
    -- end
    -- local function onTouchEnded(touch, event)
    --     local tt =touch:getLocation()
    --     if self.touch_pointX then
    --         local moveX = tt.x - self.touch_pointX
    --         if moveX > 60 then
    --             if self.page_index ~= 1 then
    --                 self:_onClickBtnLeft()
    --             end
    --         elseif moveX < -60 then
    --             if self.page_index ~= self.total_page then
    --                 self:_onClickBtnRight()
    --             end
    --         end
    --     end
    --     self.touch_pointX = nil
    -- end 
    -- local listener = cc.EventListenerTouchOneByOne:create()
    -- listener:registerScriptHandler(onTouchBegin,cc.Handler.EVENT_TOUCH_BEGAN)
    -- listener:registerScriptHandler(onTouchEnded,cc.Handler.EVENT_TOUCH_ENDED)
    -- self.map_layout:getEventDispatcher():addEventListenerWithSceneGraphPriority(listener, self.map_layout)
end

--关闭
function HeroAwakenStrengthPanel:_onClickBtnClose()
    controller:openHeroUrAweakenPanel(false)
end
function HeroAwakenStrengthPanel:_onClickBtnHelp()
    local h_cfg = Config.PartnerData.data_partner_base_fun(self.hero_vo.bid)
    if h_cfg.score == 9 then
        local cfg = Config.PartnerUrAwakenData.data_constant["game_rule2"]
        local desc = cfg.desc
        local array = {
            [1] = {funct=4, lable=1, title=TI18N("语言_gui_ma_03_1"), desc=desc},
        }
        MainuiController:getInstance():openCommonExplainView(true, array)
    else
        local cfg = Config.PartnerUrAwakenData.data_constant["game_rule1"]
        local desc = cfg.desc
        local array = {
            [1] = {funct=4, lable=1, title=TI18N("语言_gui_ma_03_1"), desc=desc},
        }
        MainuiController:getInstance():openCommonExplainView(true, array)
    end

end

--强化
function HeroAwakenStrengthPanel:_onClickBtnBreak()
    if not self.hero_vo then return end
    if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
        message(TI18N("语言_c_7567"))
        return
    end
    if not self.is_full_cond then 
        local str = self.cond_txt:getString()
        message(str)
        return
    end
    local data = self.base_data
    local lev_cfg = self.lev_cfg_next
    local cost = lev_cfg and lev_cfg.cost
    if cost and next(cost) and cost[1][1] then
        for i, v in ipairs(cost) do
            if v[1] and v[1] ~= 0 then
                local config = Config.ItemData.data_get_data(v[1])
                local num =  BackpackController:getInstance():getModel():getItemNumByBid(v[1])
                if config.type == BackPackConst.item_type.NORMAL and config.sub_type == BackPackConst.item_tab_type.HERO then
                    local bid = config.effect[1].val[1] 
                    local hero_cfg = Config.PartnerData.data_partner_base[bid]
                    num = #(controller:getModel():getHeroInfoByBidStar(hero_cfg.bid, config.eqm_jie))
                end
                if num < v[2] then
                    BackpackController:getInstance():openTipsSource( true,config)
                    return 
                end
            end
        end
    end

    local hero_list = {}
    if self.hero_item_data_list and next(self.hero_item_data_list) then
        for k, v in pairs(self.hero_item_data_list[1].dic_select_list) do
            hero_list[#hero_list + 1] = {partner_id = k}
        end
    end
    local expend = self.lev_cfg_next.expend1[1]
    if expend and expend[1] then
        if expend[3] > #hero_list then
            local hero_cfg = Config.PartnerData.data_partner_base[expend[1]]
            local config = Config.ItemData.data_get_data(hero_cfg.item_id)
            BackpackController:getInstance():openTipsSource( true,hero_cfg.item_id)
            return
        end
    end
    if self.data.panel_type == HERO_SOUL_TYPE then
        -- if not HeroCalculate.checkIsSufficeStar(self.hero_vo) then
        --     local need_star = 0
        --     local data_cfg = Config.PartnerSoulData.data_const["lock_star"]
        --     if data_cfg then
        --         local next_lv = self.hero_vo.h_lev + 1
        --         for k, v in pairs(data_cfg.val) do
        --             if next_lv >= v[1] then
        --                 need_star = v[2]
        --             end
        --         end
        --     end
        --     message(string.format(TI18N("语言_c_6281"),need_star))
        --     return 
        -- end
        if self.hero_vo.isResonateHero and self.hero_vo:isResonateHero() then
            message(TI18N("语言_c_5489"))
            return 
        end
        controller:sender11466(self.hero_vo.partner_id, hero_list)
    else
        --这里需要判断魂器等级条件
        local limit_h_lev = self.lev_cfg_next.limit_h_lev
        if limit_h_lev > self.hero_vo.h_lev then
            message(string.format(TI18N("语言_c_5151"), limit_h_lev))
            return
        end
        controller:sender11027(self.hero_vo.partner_id, hero_list)
    end
end

function HeroAwakenStrengthPanel:openRootWnd(data)
    if not data then return end
    self.data = data
    self.hero_vo = data.hero_vo

    local h_cfg = Config.PartnerData.data_partner_base_fun(self.hero_vo.bid)
    self.max_level = controller:getModel():getHeroAwakenMaxLev(h_cfg.ur_awaken_id) 

    self:updateData()
    self:setData()
end

function HeroAwakenStrengthPanel:updateData()
    self.base_data = nil
    local hero_vo = self.hero_vo
    local h_cfg = Config.PartnerData.data_partner_base_fun(hero_vo.bid)
    if self.data.panel_type == HERO_SOUL_TYPE then
        local ur_lev = 0  --hero_vo.ur_awaken[1].p_lev
        local socre = 1000
        if hero_vo.ur_awaken and hero_vo.ur_awaken[1] then
            ur_lev = hero_vo.ur_awaken[1].p_lev
            socre = hero_vo.ur_awaken[1].p_score
        end

        self.base_data = {id = h_cfg.ur_awaken_id, lev = ur_lev, score_val = socre}
        -- if self.base_data.lev == 0 then
        --     self.base_data.lev = 1
        -- end
        self.base_cfg = Config.PartnerUrAwakenData.data_base_info[self.base_data.id]
        self.lev_cfg = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1][self.base_data.lev]
        if self.base_data.lev == 0 then
            self.lev_cfg = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1][self.base_data.lev + 1]
        end
        self.lev_cfg_next = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1][self.base_data.lev + 1]
        self.title:setString(TI18N("语言_c_7242"))
        if h_cfg.score == 9 then
            self.title:setString(TI18N("语言_c_6740"))
        end
        self:updateLevelList()
    elseif self.data.panel_type == HERO_HEART_TYPE then
        -- self.base_data = {id = (hero_vo.aid == 0 and h_cfg.alterheart or hero_vo.aid), lev = hero_vo.a_lev or 0, score_val = hero_vo.a_score or 1000}
        -- -- if self.base_data.lev == 0 then
        -- --     self.base_data.lev = 1
        -- -- end
        -- self.base_cfg = Config.PartnerHeartData.data_base_info[self.base_data.id]
        -- self.lev_cfg = Config.PartnerHeartData.data_soul_level[self.base_data.id][self.base_data.lev]
        -- self.lev_cfg_next = Config.PartnerHeartData.data_soul_level[self.base_data.id][self.base_data.lev + 1]
        -- self.title:setString(TI18N("语言_c_5005"))
    end
    self.is_max_lv = self.base_data.lev == self.max_level
end

function HeroAwakenStrengthPanel:updateLevelList()
    local config_list = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1]--[self.base_data.lev]
    local total_level = #config_list
    self.total_page = total_level/5
    self.page_data = {}
    for i = 1, self.total_page do
        local object = {
            page_index = i,
            hero_vo = deepCopy(self.hero_vo),
            base_data = deepCopy(self.base_data),
            total_page = self.total_page,
        }
        self.page_data[i] = object
    end

    -- self.page_index = math.ceil((self.base_data.lev)/5)
    -- self.page_index = self.page_index == 0 and 1 or self.page_index
    -- self.page_index = self.page_index <= self.total_page and self.page_index or self.total_page
    -- print("+++++++++++++",self.page_index)
    -- self.page_scrollview:setData(self.page_data)
    -- self.page_scrollview:addEndCallBack(function ( ... )
    --     local pos = self:getCurRoomPos(self.page_index)
    --     print("%%%%%%%%%%%",vardump(pos))
    --     -- if pos then
    --     --     local final_y = self:getY(pos)
    --     --     self.page_scrollview:updateMove(cc.p(self.page_scrollview:getCurContainerPosX(), final_y), 0.1)
    --     -- end
    -- end)

    local _index = math.ceil((self.base_data.lev + 1)/5)
    if _index == self.page_index then
        -- self.page_scrollview:setData(self.page_data)
        -- self.page_scrollview:reloadData(nil,nil,true)
        self.page_scrollview:reloadData(self.page_index)
    else
        self.page_index = _index--math.ceil((self.base_data.lev + 1)/5)
        self.page_index = self.page_index == 0 and 1 or self.page_index
        self.page_index = self.page_index <= self.total_page and self.page_index or self.total_page
        self.page_scrollview:reloadData(self.page_index)
        -- self.page_scrollview:reloadData()
        -- -- local pos = self:getCurRoomPos(self.page_index)
        -- local final_y = self:getY(pos)
        -- self:jumpToMoveByY((self.total_page-self.page_index - 1) * 705)
        -- self.page_scrollview:setData(self.page_data)--({self.page_data[self.page_index]})
        -- self.page_scrollview:addEndCallBack(function()
        --     local posx = -(self.page_index-1) * 720
        --     local function callback()
        --         self.can_click = true
        --     end
        --     self.page_scrollview:jumpToMove(cc.p(posx, 31),0.3,callback)
        -- end)
    end
end

function HeroAwakenStrengthPanel:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = self.total_page or 1
    local scroll_view_size = self.page_scrollview:getContentSize()
    local pos_per = pos * 100 / (len * 705 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.page_scrollview:scrollToPercentVertical(pos_per, 0.5, true)
end
function HeroAwakenStrengthPanel:getY(pos)
    local final_y= -pos.y
    if self.page_scrollview and not tolua.isnull(self.page_scrollview) then
        if final_y >= 0 then
            final_y = 0
        elseif final_y < (self.scroll_view_size.height - self.page_scrollview:getMaxSize().height) then
            final_y = self.scroll_view_size.height - self.page_scrollview:getMaxSize().height
        end
    end
    return final_y
end

function HeroAwakenStrengthPanel:getCurRoomPos(k)
    if self.page_scrollview then
        local list = self.page_scrollview:getItemList()
        if list then
            for i, item in ipairs(list) do
                if item and item.data._index == k then
                    return item:getItemPosition()
                end
            end
        end
    end
end

function HeroAwakenStrengthPanel:checkIsSuficeStar()
    --判断30级以后是否满足13星条件
    local data_cfg = Config.PartnerSoulData.data_const["lock_star"]
    local is_sufice_max = true
    if data_cfg then
        local next_lv = self.base_data.lev + 1
        for k, v in pairs(data_cfg.val) do
            if next_lv <= v[1] then
                is_sufice_max = self.hero_vo.star >= v[2]
            end
        end
    end
    return is_sufice_max
end

