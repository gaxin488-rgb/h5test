        self.label_name_1:setVisible(false)
        self.label_des_1:setVisible(false)
        self.node_skill_2:setVisible(false)
        self.label_name_2:setVisible(false)
        self.label_des_2:setVisible(false)
        self.arrow_icon:setVisible(false)
        self.imgbox:setVisible(true)
        self.imgbox_1:setVisible(true)
        self.imgbox_2:setVisible(true)

