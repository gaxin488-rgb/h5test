    --cost
    local visit_cfg = self.is_max_lv and lev_cfg or lev_cfg_next

    self.is_full_cond = true
    local up_cond = visit_cfg.up_cond
    self.cond_txt:setString("")
    for k, v in pairs(up_cond) do
        local condition_event = v[1]           -- 目标条件
        local target_value = v[2]              -- 目标值
        if condition_event == "partner_star" then
            if self.hero_vo.star < target_value then
                self.is_full_cond = false
