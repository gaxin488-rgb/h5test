            self.scrollview_des:setInnerContainerSize(cc.size(self.scrollview_des.init_size.width, self.skill_des:getContentSize().height))
            self.skill_des:setPositionY(self.skill_des:getContentSize().height/2)
        else
            self.scrollview_des:setInnerContainerSize(self.scrollview_des.init_size)
            self.skill_des:setPositionY(self.scrollview_des.init_size.height/2)
        end

