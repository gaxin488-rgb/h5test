    attr_title:setString(TI18N("语言_c_7243"))
    local left_title_bg = attr_panel:getChildByName("left_title_bg")
    local right_title_bg = attr_panel:getChildByName("right_title_bg")
    setLeftRightImg(left_title_bg, attr_title, right_title_bg, 20)
    
    self.attr_icon_list = {}
    self.attr_label_key_list = {}
    self.attr_labe_left_list = {}
    self.attr_labe_right_list = {}
    self.attr_arrow_list = {}
