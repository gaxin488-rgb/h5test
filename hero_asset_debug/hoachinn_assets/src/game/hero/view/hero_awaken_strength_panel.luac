    self.label_name_1 = self.skill_panel:getChildByName("label_name_1")
    self.label_des_1 = self.skill_panel:getChildByName("label_des_1")
    self.label_name_1:ignoreContentAdaptWithSize(true)
    self.label_name_1:setTextAreaSize(cc.size(300, 0))
    self.label_des_1:ignoreContentAdaptWithSize(true)
    self.label_des_1:setTextAreaSize(cc.size(300, 0))
    self.node_skill_2 = self.skill_panel:getChildByName("node_skill_2")
    self.label_name_2 = self.skill_panel:getChildByName("label_name_2")
    self.label_des_2 = self.skill_panel:getChildByName("label_des_2")
    self.label_name_2:ignoreContentAdaptWithSize(true)
    self.label_name_2:setTextAreaSize(cc.size(200, 0))
    self.label_des_2:ignoreContentAdaptWithSize(true)
    self.label_des_2:setTextAreaSize(cc.size(200, 0))
    self.imgbox = self.skill_panel:getChildByName("imgbox")
    self.imgbox_1 = self.skill_panel:getChildByName("imgbox_1")
    self.imgbox_2 = self.skill_panel:getChildByName("imgbox_2")

    self.streng_btn = self.main_container:getChildByName("streng_btn")
    self.image_resert = self.main_container:getChildByName("image_resert")
    self.image_resert:getChildByName("label"):setString(TI18N("语言_c_5330"))
    self.image_review = self.main_container:getChildByName("image_review")
    setTextMaxWidth(self.image_review:getChildByName("label"), 118)
    self.image_review:getChildByName("label"):setString(TI18N("语言_c_7241"))

    self.sp_new = self.main_container:getChildByName("sp_new")
    local label_new = self.sp_new:getChildByName("label_new")
    local posx = label_new:getPositionX()
    local posy = label_new:getPositionY()
    self.label_new = label_new
    -- self.label_new = createRichLabel(20, cc.c3b(0xff, 0xff, 0xff), cc.p(0, 1), cc.p(posx, posy), -4, nil, 600)
    -- self.sp_new:addChild(self.label_new)
    self.label_new = self.sp_new:getChildByName("label_new")
    self.label_new:setString(TI18N(""))
    self.label_new:ignoreContentAdaptWithSize(true)
    self.label_new:setChangeScaleOffWidth(-9999999)
    self.label_new:setTextAreaSize(cc.size(600, 0))
    self.sp_new:setVisible(false)
    self.skill_desc_bg = self.main_container:getChildByName("skill_desc_bg")
    self.skill_desc_bg:setVisible(false)

    self.map_layout = self.main_container:getChildByName("map_layout")
    self.close_btn = self.main_container:getChildByName("close_btn")
