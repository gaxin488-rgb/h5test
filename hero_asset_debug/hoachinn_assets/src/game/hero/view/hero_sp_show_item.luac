-- --------------------------------------------------------------------
-- sp忍者介绍子项
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: {DATE}
-- --------------------------------------------------------------------
HeroSpShowItem = class("HeroSpShowItem", function()
    return ccui.Widget:create()
end)

function HeroSpShowItem:ctor(type)
	self.ctrl = HeroController:getInstance()
	self.model = self.ctrl:getModel()
	self.role_vo = RoleController:getInstance():getRoleVo()
	self.item_list = {}

	self.scroe = {}
	self.max = {}

	self:configUI()
	self:register_event()
end

function HeroSpShowItem:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_sp_show_item"))
	
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(606,133))
	self:setTouchEnabled(true)

    self.main_container = self.root_wnd:getChildByName("main_container")
	self.main_container:setTouchEnabled(true)
	self.main_container:setSwallowTouches(false)

	self.bg = self.main_container:getChildByName("bg")

	self.name = self.main_container:getChildByName("name")
	self.title = self.main_container:getChildByName("title")
	self.title:setString(TI18N("语言_c_1361"))
	setTextMaxWidth(self.title,350)

	self.btn = self.main_container:getChildByName("btn")
	self.btn:setTitleText(TI18N("语言_c_1369"))
	self.btn.label = self.btn:getTitleRenderer()
    if self.btn.label ~= nil then
        self.btn.label:enableOutline(cc.c4b(0x29,0x4a,0x15,0xff), 2)
    end
	--[[self.btn.label = self.btn:getTitleRenderer()
    if self.btn.label ~= nil then
        self.btn.label:enableOutline(Config.ColorData.data_color4[177], 2)
    end--]]

    self.goods_icon = self.main_container:getChildByName("goods_icon")
end

function HeroSpShowItem:setData( data )
	self.data = data
	self.name:setString(data.title)
	if data.picture ~= "" then
		local res = PathTool.getResFrame("hero",data.picture,false,"sp_hero_desc")
		loadSpriteTexture(self.goods_icon, res, LOADTEXT_TYPE_PLIST)
	else
		loadSpriteTexture(self.goods_icon,PathTool.getHeadIcon(data.bid),LOADTEXT_TYPE)
	end
end

function HeroSpShowItem:register_event(  )
	self.btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
        	playButtonSound2()
			if self.btn_callback then
				self:btn_callback()
			end
        end
    end)

	self:addTouchEventListener(function(sender, event_type) 
		if event_type == ccui.TouchEventType.ended then
				self.touch_end = sender:getTouchEndPosition()
				local is_click = true
				if self.touch_began ~= nil then
					is_click =
						math.abs(self.touch_end.x - self.touch_began.x) <= 20 and
						math.abs(self.touch_end.y - self.touch_began.y) <= 20
				end
				if is_click == true then
					playButtonSound2()
					if self.callback then
						self:callback()
					end
				end
			elseif event_type == ccui.TouchEventType.moved then
			elseif event_type == ccui.TouchEventType.began then
				self.touch_began = sender:getTouchBeganPosition()
			elseif event_type == ccui.TouchEventType.canceled then
			end
	end)
end

--获取资源子项隐藏这些
function HeroSpShowItem:hideBg(  )
	local s=self.data.desc
	self.title:setString(transformTextToShort(s, 40))
	self.title:setTouchEnabled(true)
	self.title:setSwallowTouches(false)
	addEvt2showAllTextTips(self.title,s,40)
	self.btn:setPositionY(50)
end

function HeroSpShowItem:addCallBack( value )
	self.callback =  value
end

function HeroSpShowItem:setBtnCallBack( value )
	self.btn_callback = value
end

function HeroSpShowItem:getIsShow(  )
	return self.is_show
end

function HeroSpShowItem:setSelect(bool)
	local res 
	if bool then 
		res = PathTool.getResFrame("common","common_1020")
	else
		res = PathTool.getResFrame("common","common_1029")
	end
	self.bg:loadTexture(res, LOADTEXT_TYPE_PLIST)
end

function HeroSpShowItem:showMessagePanel( bool )
	self.is_show = bool
	if bool then 
		if self.msg_panel == nil then
			self:createMessagePanel()
		end
		self.btn:setTitleText(TI18N("语言_c_1367"))
	else
		self.btn:setTitleText(TI18N("语言_c_1369"))
	end
	self.msg_panel:setVisible(bool)
end

function HeroSpShowItem:createMessagePanel( )
	if self.msg_panel == nil then 
		self.msg_panel = ccui.Layout:create()
		self.msg_panel:setAnchorPoint(0,1)
		self.main_container:addChild(self.msg_panel)
	end
	if self.msg_panel_bg == nil then 
		self.msg_panel_bg = createImage(self.msg_panel,PathTool.getResFrame("common", "common_1078"),310,50,cc.p(0.5,0.5),true,nil,true)
	end
	if self.data then
		if not self.desc_txt then
			self.desc_txt = createRichLabel(22,175,cc.p(0,1),cc.p(0,0),nil,nil,600)
			self.msg_panel:addChild(self.desc_txt)
		end
		self.desc_txt:setString(self.data.txt)
		if self.data.skip ~= 0 then
			if not self.go_to_btn then
				self.go_to_btn = createImage(self.msg_panel,PathTool.getResFrame("common", "common_1027"),310,50,cc.p(0.5,0.5),true,nil,true)
				local btn_size = cc.size(110,54)
				self.go_to_btn:setContentSize(btn_size)
				self.go_to_btn:setTouchEnabled(true)
				self.go_to_txt = createLabel(22,cc.c3b(0xf8,0xef,0x76),cc.c3b(0x5c,0x27,0x05),btn_size.width*0.5,btn_size.height*0.5,TI18N("语言_c_7"),self.go_to_btn,2,cc.p(0.5,0.5))
			end
			self.go_to_btn:setVisible(true)
			registerButtonEventListener(self.go_to_btn,function()
				local config = Config.SourceData.data_source_data[self.data.skip]
				if config then
					HeroController:getInstance():openHeroSpShowWindow(false)
					BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
				end
			end,true, 1)
		else
			if self.go_to_btn then
				self.go_to_btn:setVisible(false)
			end
		end
		local time_status = false
		if not NewPartnersummonController:getInstance():getModel():getSpShield() then
			time_status = true
		end
		local hero_cfg = Config.PartnerData.data_partner_base[self.data.bid]
		local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("recruit_sp_data")
		local recruit_cfg = Config.RecruitData.data_hero_data[600]
		if recruit_cfg and not time_status then
			local recruit_data = recruit_cfg[hero_cfg.item_id]
			if recruit_data and (recruit_data.is_close == 0 and not table.indexof(nohideIds,recruit_data.base_id)) then 
				time_status = true
			end
		end
		if self.data.start_time ~= "" and time_status then
			if not self.go_time_txt then
				self.go_time_txt = createLabel(22,cc.c3b(0xff,0xff,0xff),cc.c3b(0x00,0x00,0x00),310,20,"",self.msg_panel,2,cc.p(0.5,0.5))
			end
			self.go_time_txt:setString(string.format(TI18N("语言_c_2341"),self.data.start_time))
			self.go_time_txt:setVisible(true)
			if self.go_to_btn then
				setChildUnEnabled(true,self.go_to_btn)
				self.go_to_btn:setTouchEnabled(false)
			end
		else
			if self.go_time_txt then
				self.go_time_txt:setVisible(false)
			end
			if self.go_to_btn then
				setChildUnEnabled(false,self.go_to_btn)
				self.go_to_btn:setTouchEnabled(true)
			end
		end
		if self.data.sp_star ~= 0 then
			if not self.star_btn then
				self.star_btn = createImage(self.msg_panel,PathTool.getResFrame("hero/special_hero_star", "special_hero_star_007"),310,70,cc.p(0.5,0.5),true,nil,false)
				local btn_size = cc.size(69,71)
				self.star_btn:setContentSize(btn_size)
				self.star_btn:setTouchEnabled(true)
				self.star_txt = createLabel(20,cc.c3b(0xff,0xff,0xff),cc.c3b(0x00,0x00,0x00),btn_size.width*0.5,0,TI18N("语言_c_567"),self.star_btn,2,cc.p(0.5,0.5))
			end
			self.star_btn:setVisible(true)
			registerButtonEventListener(self.star_btn,function()
				local hero_vo = HeroVo.New()
				local data = {}
				data.bid = self.data.bid
				data.lev = 340
				data.star = 13
				-- data.camp_type = value.camp_type
				hero_vo:updateHeroVo(data)
				HeroController:getInstance():openHeroStarupLookCostHelpPanel(true,hero_vo,true)
			end,true, 1)
		else
			if self.star_btn then
				self.star_btn:setVisible(false)
			end
		end
		if self.data.replay and next(self.data.replay) then
			local hero_vo = HeroVo.New()
			local data = {}
			data.bid = self.data.bid
			data.lev = 340
			data.star = 13
			hero_vo:updateHeroVo(data)
			if self.model:NewConvertSta(hero_vo) or self.model:ConvertSta(hero_vo) then
				if not self.five_show_panel then
					self.five_show_panel = ccui.Layout:create()
					self.five_show_panel:setContentSize(cc.size(620,220))
					self.five_show_panel:setAnchorPoint(cc.p(0, 0))
					self.msg_panel:addChild(self.five_show_panel)
					self.five_show_item = HeroSpFiveShow.new(self.data.bid)
					self.five_show_panel:addChild(self.five_show_item)
				end
				self.five_show_panel:setVisible(true)
			else
				if not self.replay_btn then
					self.replay_btn = createImage(self.msg_panel,PathTool.getFunctionRes("icon_4"),310,60,cc.p(0.5,0.5),false,nil,false)
					local btn_size = cc.size(74,74)
					self.replay_btn:setContentSize(btn_size)
					self.replay_btn:setTouchEnabled(true)
					self.replay_txt = createLabel(20,cc.c3b(0xff,0xff,0xff),cc.c3b(0x00,0x00,0x00),btn_size.width*0.5,0,TI18N("语言_c_6836"),self.replay_btn,2,cc.p(0.5,0.5))
				end
				self.replay_btn:setVisible(true)
				registerButtonEventListener(self.replay_btn,function()
					RoleController:getInstance():sender16825(self.data.replay[1][1],self.data.replay[1][2])
				end,true, 1)
			end
		else
			if self.replay_btn then
				self.replay_btn:setVisible(false)
			end
			if self.five_show_panel then
				self.five_show_panel:setVisible(false)
			end
		end
		local add_h = 20
		if (self.go_to_btn and self.go_to_btn:isVisible()) or (self.replay_btn and self.replay_btn:isVisible()) or (self.star_btn and self.star_btn:isVisible()) then
			add_h = 110
		end
		if self.five_show_panel and self.five_show_panel:isVisible() then
			add_h = add_h + self.five_show_panel:getContentSize().height
		end
		if self.data.start_time ~= "" and time_status then
			add_h = add_h + self.go_time_txt:getContentSize().height + 20
			if self.go_to_btn then
				self.go_to_btn:setPositionY(70)
			end
		else
			if self.go_to_btn then
				self.go_to_btn:setPositionY(50)
			end
		end

		local _h = math.max(self.desc_txt:getContentSize().height+ add_h,100)
		self.msg_panel:setContentSize(cc.size(620,_h))
		self.msg_panel_bg:setContentSize(cc.size(620,_h))
		self.desc_txt:setPosition(cc.p(10,_h-10))
		self.msg_panel_bg:setPosition(cc.p(310,_h*0.5))
		self.msg_panel:setPosition(5,0)
		local btn_list = {}
		local num = 0
		if self.replay_btn and self.replay_btn:isVisible() then
			num = num + 1
			btn_list[num] = self.replay_btn
		end
		if self.go_to_btn and self.go_to_btn:isVisible() then
			num = num + 1
			btn_list[num] = self.go_to_btn
		end
		if self.star_btn and self.star_btn:isVisible() then
			num = num + 1
			btn_list[num] = self.star_btn
		end
		if num == 1 then
			btn_list[1]:setPositionX(310)
		elseif num == 2 then
			btn_list[1]:setPositionX(186)
			btn_list[2]:setPositionX(434)
		elseif num == 3 then
			btn_list[1]:setPositionX(124)
			btn_list[2]:setPositionX(310)
			btn_list[3]:setPositionX(496)
		end
	end
end


--获取资源隐藏这些
function HeroSpShowItem:hideBgII(  )
	for k,v in pairs(self.item_list) do
		v:hideBg()
	end
end

--返回msgpanel大小
function HeroSpShowItem:getMsgPanleSize(  )
	if self.msg_panel then 
		return self.msg_panel:getContentSize()
	end
end

function HeroSpShowItem:clearList(  )
end

function HeroSpShowItem:DeleteMe(  )
	if self.five_show_item then
		self.five_show_item:removeFromParent()
		self.five_show_item = nil
	end
	if self.item_list and self.item_list ~= nil then 
		for k,v in pairs(self.item_list) do
			v:DeleteMe()
		end
	end
end