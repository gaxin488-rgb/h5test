HeroMainTabSoulHomologyPanel = class("HeroMainTabSoulHomologyPanel", function()
    return ccui.Widget:create()
end)

local string_format = string.format
local controller = HeroController:getInstance()
local model = controller:getModel()
local table_insert = table.insert
local role_vo = RoleController:getInstance():getRoleVo()

function HeroMainTabSoulHomologyPanel:ctor(parent)  
    self.parent = parent
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function HeroMainTabSoulHomologyPanel:config()
    -- self.size = cc.size(680,372.97)
    -- self:setContentSize(self.size)
end

function HeroMainTabSoulHomologyPanel:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_main_tab_soul_homology_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.tab_panel = self.root_wnd:getChildByName("tab_panel")

    self.item_node_my = self.tab_panel:getChildByName("item_node_my")
    self.hero_item_my = HeroExhibitionItem.new(0.9, false)
    -- self.hero_item_my:addCallBack(function() self:onClickHeroItem() end)
    self.item_node_my:addChild(self.hero_item_my) 

    self.item_node_other = self.tab_panel:getChildByName("item_node_other")
    self.hero_item_other = HeroExhibitionItem.new(0.9, true)
    self.hero_item_other:addCallBack(function() 
        local is_lock, lock_id = self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroSoulLock)
        if is_lock then
            message(TI18N("语言_c_4556"))
            return
        end
        HeroController:getInstance():openHeroResetWindow(true,HeroConst.SacrificeType.eSoulHomology, self.hero_vo)
    end)
    self.item_node_other:addChild(self.hero_item_other) 

    self.look_btn = self.tab_panel:getChildByName("look_btn")

    local soul_complete_img = self.tab_panel:getChildByName("soul_complete_img")
    soul_complete_img:setVisible(false)
    local pos = cc.p(soul_complete_img:getPosition())
	local effect = createSpineByName("E30001")
	effect:setAnimation(0, PlayerAction.action, true)
	effect:setPosition(pos)
    self.tab_panel:addChild(effect)

end

--事件
function HeroMainTabSoulHomologyPanel:registerEvents()
    --详情
    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.PartnerData.data_partner_const.sphero_desc
        if config then
            local pos = sender:getTouchBeganPosition()
            pos.y = pos.y - 240 
            TipsManager:getInstance():showCommonTips(config.desc, pos)
        end
    end ,true, 1)
end

--@hero_vo 英雄数据
function HeroMainTabSoulHomologyPanel:setData(hero_vo)
    self.hero_vo = hero_vo
    self.hero_item_my:setData(hero_vo)
    local is_lock, lock_id = self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroSoulLock)
    local passive_alien_hero_vo = nil
    if is_lock then
        passive_alien_hero_vo = model:getHeroById(lock_id)
    end
    self.hero_item_other:setData(passive_alien_hero_vo)
    self.hero_item_other:showAddIcon(not is_lock)
end

function HeroMainTabSoulHomologyPanel:updteData(  )
end

function HeroMainTabSoulHomologyPanel:setVisibleStatus(bool)
    self:setVisible(bool)
end
--移除
function HeroMainTabSoulHomologyPanel:DeleteMe()
end
