-- --------------------------------------------------------------------
-- 觉醒
-- --------------------------------------------------------------------
HeroMainTabAwakePanel = class("HeroMainTabAwakePanel", function()
    return ccui.Widget:create()
end)

local string_format = string.format
local controller = HeroController:getInstance()
local model = controller:getModel()
local table_insert = table.insert
local role_vo = RoleController:getInstance():getRoleVo()

function HeroMainTabAwakePanel:ctor(parent)  
    self.parent = parent
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function HeroMainTabAwakePanel:config()
    -- self.size = cc.size(680,372.97)
    -- self:setContentSize(self.size)

    --技能列表
    self.skill_item_list = {}
    self.base_list = {}
end

function HeroMainTabAwakePanel:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_main_tab_awake_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setPositionY(-100)
    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.tab_panel = self.root_wnd:getChildByName("tab_panel")
    self.effect_Panel = self.tab_panel:getChildByName("effect")
    self.Panel_1 = self.tab_panel:getChildByName("Panel_1")
    self.label_go = self.Panel_1:getChildByName("label_go")
    self.label_go:setString(TI18N("语言_c_1858"))
    self.label_lv = self.Panel_1:getChildByName("label_lv")
    self.label_lv:setString(TI18N("语言_role_wake_5"))
    self.tips = self.tab_panel:getChildByName("tips")
    setTextMaxWidth(self.tips, 160, -4)
    self.tips:setString(TI18N("语言_c_4789"))
    
end

--事件
function HeroMainTabAwakePanel:registerEvents()
    registerButtonEventListener(self.Panel_1, function(param,sender, event_type) 
        self:updateExclusivePropItem()
    end ,true, 1)
 
-- 获取到天赋信息
    if not self.hero_get_talent_event then
        self.hero_get_talent_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_UR_Awaken_Update_Event, function()
            if not self.hero_vo then return end
            self:setData(self.hero_vo)
        end)
    end
end

