function HeroMainTabAwakePanel:onClickExclusivePropItem(is_lock)
    if not self.hero_vo then return end
    local data = {panel_type = HERO_SOUL_TYPE, hero_vo = self.hero_vo}
    controller:openHeroUrAweakenPanel(true, data)
end

--@hero_vo 英雄数据
--@show_model_type 显示模式 1:英雄模式  2:图鉴模式 定义参考 HeroConst.BagTab.eBagHero
function HeroMainTabAwakePanel:setData(hero_vo)
    if not hero_vo then return end
    self.hero_vo = hero_vo
    self.init_attr = {}
    local partner_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    if partner_cfg and partner_cfg.ur_awaken_id and partner_cfg.ur_awaken_id ~= 0 and partner_cfg.ur_awaken_show ~= 0 then
        local ur_awaken_id = partner_cfg.ur_awaken_id
        print("ur_awaken_id...",ur_awaken_id)
        local ur_cfg = Config.PartnerUrAwakenData.data_get_open_lv[ur_awaken_id]
        local max_level = model:getHeroAwakenMaxLev(ur_awaken_id) or 30
        if (ur_cfg and self.hero_vo.star >= ur_cfg.star) or (partner_cfg.score == 9 and self.hero_vo.star >= 16) then
            local ur_lev = 0
            if hero_vo.ur_awaken and hero_vo.ur_awaken[1] then
                ur_lev = hero_vo.ur_awaken[1].p_lev
            end
            self.label_lv:setString(string.format(TI18N("语言_c_7240"),ur_lev,max_level))
            self.label_go:setVisible(true)
        else
            local lock_str = string.format(TI18N("语言_c_3035"),ur_cfg.star) 
            self.label_lv:setString(lock_str)
            self.label_go:setVisible(false)
        end

        local lv_cfg = Config.PartnerUrAwakenData.data_lv_info[ur_awaken_id][1][max_level]
        local max_attr = lv_cfg.attr
        for i, v in pairs(max_attr) do
            local attr_key = v[1]
            local attr_id = Config.AttrData.data_key_to_id[attr_key]
            local attr_value = 0
            local obj = {attr_id=attr_id,attr_val=attr_value}
            table.insert(self.init_attr, obj)
        end
    end

    self:setAttrPanel()
end

function HeroMainTabAwakePanel:setAttrPanel()
    local attr = {}
    local _temp_attr = {}
    if self.hero_vo.ur_awaken and self.hero_vo.ur_awaken[1] then
        _temp_attr = self.hero_vo.ur_awaken[1].p_attr
    end
    if #_temp_attr == 0 then
        attr = deepCopy(self.init_attr)
    else
        -- attr = deepCopy(self.init_attr)
        for k, v in pairs(self.init_attr) do
            local attr_id = v.attr_id
            local attr_val = 0
            for key, val in pairs(_temp_attr) do
                local _attr_id = val.attr_id
                local _attr_val = val.attr_val
                if _attr_id == attr_id then
                    attr_val = _attr_val
                end
            end
            local obj = {attr_id=attr_id,attr_val=attr_val}
            table.insert(attr, obj)
        end
    end

    for k, v in pairs(self.base_list) do
        v:setVisible(false)
    end

    for i,v in ipairs(attr) do
        local attr_id = v.attr_id
        local attr_val = v.attr_val

        local attr_key = Config.AttrData.data_id_to_key[attr_id]
        local attr_name = Config.AttrData.data_key_to_name[attr_key]

        if attr_name then
            if not self.base_list[i] then 
                self.base_list[i] = createRichLabel(21, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(0, 48), nil, nil, 380)
                self.tab_panel:addChild(self.base_list[i],9)
            end
            self.base_list[i]:setVisible(true)

            local label = self.base_list[i]
            local _x = 185 + (i-1)%3 * 170
            label:setPositionX(_x)
            local _y = 441 - (math.ceil(i/3) - 1) * 36

            label:setPositionY(_y)
            local icon = PathTool.getAttrIconByStr(attr_key)
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10).."%"
            end
            local attr_str = string_format("<img src='%s' scale=1 />  <div fontcolor=#dbceb6> %s</div>", PathTool.getResFrame("common", icon), attr_val)
            label:setString(attr_str)

        end
    end

end

function HeroMainTabAwakePanel:setVisibleStatus(bool)
    self:setVisible(bool)
end
--移除
function HeroMainTabAwakePanel:DeleteMe()
    if self.hero_get_talent_event then
        GlobalEvent:getInstance():UnBind(self.hero_get_talent_event)
        self.hero_get_talent_event = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end
