    self.baseattr_soul_label:setString(TI18N("语言_c_7441"))
    -- self.baseattr_soul_tip = self.baseattr_soul_panel:getChildByName("baseattr_soul_tip")
    self.baseattr_soul_tip = createRichLabel(22,cc.c3b(0x3e,0xa1,0x39),cc.p(0,0),cc.p(14,36),-6,nil,600)
    self.baseattr_soul_panel:addChild(self.baseattr_soul_tip)
