    -- self.baseattr_label = self.baseattr_panel:getChildByName("label")
    -- self.baseattr_label:setString(TI18N("语言_c_1282"))

    -- self.baseattr_attach_label = self.baseattr_panel:getChildByName("label2")
    -- self.baseattr_attach_label:setString(TI18N("语言_c_d_139"))
    -- self.baseattr_attach_label:setPositionX( self.baseattr_label:getContentSize().width + self.baseattr_label:getPositionX())

 
    --随机属性
