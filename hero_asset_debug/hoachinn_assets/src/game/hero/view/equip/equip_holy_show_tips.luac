-- --------------------------------------------------------------------
EquipHolyShowTips = EquipHolyShowTips or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()

function EquipHolyShowTips:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/equip_holy_show_tips"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }

    self.win_type = WinType.Tips

    self.view_tag = ViewMgrTag.DIALOGUE_TAG
end

function EquipHolyShowTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
        -- self.background:setSwallowTouches(false)
    end
    self.container = self.root_wnd:getChildByName("container")
    self.list_panel = self.container:getChildByName("list_panel")
    self.tip_txt1 = createRichLabel(23,cc.c3b(0xfe, 0xee, 0xba),cc.p(0.5,0.5),cc.p(173,322),-8,nil,300)
    self.tip_txt1:setHorizontalLayoutType(2)
    self.container:addChild(self.tip_txt1)
    self.tip_txt1:setString(TI18N("语言_c_7437"))
    self.tip_txt2 = self.container:getChildByName("tip_txt2")
    setTextMaxWidth(self.tip_txt2,300,-8)
    self.tip_txt2:setString(TI18N("语言_c_7438"))
    self.line_img = self.container:getChildByName("line_img")
    self.item_1 = self.root_wnd:getChildByName("item_1")
end

function EquipHolyShowTips:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onClickCloseBtn()
        end
    end)
end
--关闭
function EquipHolyShowTips:onClickCloseBtn()
    controller:openEquipHolyShowTips(false)
end
function EquipHolyShowTips:openRootWnd(pos)
    local node_pos = self.root_wnd:convertToNodeSpace(pos)
    local _x = node_pos.x
    local _y = node_pos.y
    if _x + self.container:getContentSize().width > self.root_wnd:getContentSize().width then
        _x = self.root_wnd:getContentSize().width - self.container:getContentSize().width
    end
    self.container:setPosition(cc.p(_x,_y))
    self.cfg = Config.PartnerHolyEqmData.data_const["star_rate"].val
    local item_w = 300
    local item_h = 43
    local scroll_h = #self.cfg * item_h
    local _h = scroll_h + self.tip_txt1:getContentSize().height + self.tip_txt2:getContentSize().height + 107
    self.list_panel:setContentSize(cc.size(self.list_panel:getContentSize().width,scroll_h))
    if not self.list_view then
        local scroll_view_size = self.list_panel:getContentSize()
        local setting = {
            -- item_class = HeroExhibitionItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 4,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 300,               -- 单元的尺寸width
            item_height = 43,              -- 单元的尺寸height
            delay = 1,
            -- row = 1,                        -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            need_dynamic = true
        }
        self.list_view = CommonScrollViewSingleLayout.new(self.list_panel, cc.p(0, 0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0,0))

        self.list_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.list_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        -- self.list_view:registerScriptHandlerSingle(handler(self,self.onCellTouched), ScrollViewFuncType.OnCellTouched) --更新cell
    end
    self.list_view:reloadData()
    self.list_view:setClickEnabled(false)

    self.container:setContentSize(cc.size(self.container:getContentSize().width,_h))
    self.tip_txt1:setPositionY(_h - self.tip_txt1:getContentSize().height*0.5-26)
    self.tip_txt2:setPositionY(self.tip_txt2:getContentSize().height*0.5 + 30)
    self.line_img:setPositionY(self.tip_txt2:getContentSize().height + 52)
    self.list_panel:setPositionY(self.tip_txt2:getContentSize().height + 60)

end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function EquipHolyShowTips:createNewCell(width, height)
    local cell = EquipHolyShowTipsItem.new(self.item_1)
     return cell
 end
 --获取数据数量
 function EquipHolyShowTips:numberOfCells()
     if not self.cfg then return 0 end
     return #self.cfg
 end
 --更新cell(拖动的时候.刷新数据时候会执行次方法)
 --cell :createNewCell的返回的对象
 --index :数据的索引
 function EquipHolyShowTips:updateCellByIndex(cell, index)
     cell.index = index
     local cell_data = self.cfg[index]
     if not cell_data then return end
     cell:setData(cell_data)
 end

function EquipHolyShowTips:close_callback()
    self:onClickCloseBtn()
end


EquipHolyShowTipsItem = class("EquipHolyShowTipsItem", function()
	return ccui.Layout:create()
end)

function EquipHolyShowTipsItem:ctor(node)
	self.size = cc.size(218,50)
	self:setExtralData(node)
end

function EquipHolyShowTipsItem:setExtralData(node)
	if not tolua.isnull(node) and self.root_wnd == nil then
		local size = node:getContentSize()
		self:setAnchorPoint(cc.p(0, 0.5))
		self:setContentSize(size)

		self.root_wnd = node:clone()
		self.root_wnd:setVisible(true)
		self.root_wnd:setAnchorPoint(0.5, 0.5)
		self.root_wnd:setPosition(size.width * 0.5, size.height * 0.5)
		self:addChild(self.root_wnd)

		self.star_img = self.root_wnd:getChildByName("star_img")
		self.star_txt = self.root_wnd:getChildByName("star_txt")
		self.num_txt = self.root_wnd:getChildByName("num_txt")
        setTextMaxWidth(self.num_txt,200,-8)
        self.num_txt:setString(TI18N("语言_c_7439"))
		self.num_value = self.root_wnd:getChildByName("num_value")
	end

end

function EquipHolyShowTipsItem:setData(data)
	if data then
		self.star_txt:setString(data[1].." ")
        self.num_value:setString(data[2].."%")
	end
end

function EquipHolyShowTipsItem:DeleteMe(  )
end