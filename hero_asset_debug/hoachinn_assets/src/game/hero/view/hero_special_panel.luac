HeroSpecialPanel = HeroSpecialPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()

function HeroSpecialPanel:__init()
	self.win_type = WinType.Full
	self.is_full_screen = true
	self.res_list = {
		-- {path = PathTool.getPlistImgForDownLoad("seerpalace", "seerpalace"), type = ResourcesType.plist},
	}
	self.layout_name = "hero/hero_special_panel"
	self.panel_list = {}
end

function HeroSpecialPanel:open_callback(  )
	-- self.background = self.root_wnd:getChildByName("background")
    -- self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 1)
	self.container = self.main_container:getChildByName("container")
	self.back_btn = self.main_container:getChildByName("back_btn")

	-- 适配
	local top_off = display.getTop(self.main_container)
    local container_size = self.main_container:getContentSize()
	local bottom_off = display.getBottom(self.main_container)
	-- local tab_y = self.back_btn:getPositionY()
	-- self.back_btn:setPositionY(bottom_off + tab_y)
end

function HeroSpecialPanel:register_event(  )
	registerButtonEventListener(self.back_btn, handler(self, self._onClickCloseBtn), nil, REGISTER_BUTTON_SOUND_CLOSED_TYPY)
end


-- 切换标签页
function HeroSpecialPanel:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end
	if self.select_panel then
		self.select_panel = nil
	end
	self.select_panel = self.panel_list[index]
	if self.select_panel == nil then
		if index == MainuiConst.special_type.special then
			self.select_panel = HeroSpecialSkillPanel.new(self.hero_vo)
		end
		if self.select_panel then
			self.container:addChild(self.select_panel)
			self.panel_list[index] = self.select_panel
		end
	end
end

function HeroSpecialPanel:openRootWnd(hero_vo,index)
    
    MainuiController:getInstance():getMainUi():changeBottomShowStatus(4)
    if hero_vo then
        self.hero_vo = hero_vo
    end
	local index = index or MainuiConst.special_type.special
	self:changeSelectedTab(index)
end

-----------------@ 按钮点击事件
-- 关闭
function HeroSpecialPanel:_onClickCloseBtn(  )
	controller:openHeroSpecialPanel(false)
end

function HeroSpecialPanel:close_callback(  )
	for k, panel in pairs(self.panel_list) do
        panel:DeleteMe()
    end
    self.panel_list = nil
    controller:openHeroSpecialPanel(false)
    MainuiController:getInstance():getMainUi():changeBottomShowStatus(1)
end