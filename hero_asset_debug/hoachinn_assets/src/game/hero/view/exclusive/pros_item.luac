-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      魂器item
-- <br/> 2021年5月13日
-- --------------------------------------------------------------------
ProsItem = class("ProsItem", function()
    return ccui.Widget:create()
end)

function ProsItem:ctor()
    self:configUI()
    self:register_event()
end

function ProsItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/pros_item"))
    self:setCascadeOpacityEnabled(true)
    self:addChild(self.root_wnd)

    local main_panel = self.root_wnd:getChildByName("main_panel")
    self.main_panel = main_panel
    self.bg = main_panel:getChildByName("bg")
    self.sprite_icon = main_panel:getChildByName("sprite_icon")
    self.icon = main_panel:getChildByName("icon")
    self.img_lv_bg = main_panel:getChildByName("common_2042_1")
    self.label_lev = main_panel:getChildByName("label_lev")
    self.all_lev_bg = main_panel:getChildByName("all_lev_bg")
    self.all_lev = main_panel:getChildByName("all_lev")
    self.all_lev_bg:setVisible(false)
    self.all_lev:setVisible(false)
end

function ProsItem:register_event()
    self.main_panel:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            if self.callback then
                self.callback()
            end
        end
    end)
end

function ProsItem:setTouchEnabledStatus(status)
    self.main_panel:setTouchEnabled(status or false)
end

function ProsItem:setData(id,data)
    if not data then return end
    self.all_lev:setVisible(false)
    self.all_lev_bg:setVisible(false)
    local data = data
    data.lev = data.lev or 0
    local config = Config.PartnerProscriptionData.data_base_info[id][data.p_type]
    loadSpriteTexture(self.sprite_icon, PathTool.getPlistImgForDownLoad("proscription/proscription_skill",config.show), LOADTEXT_TYPE) 
    self.label_lev:setString(data.p_lev or 0)
    if data.p_type == 4 then
        self.icon:setVisible(true)
        self:setBgVis(true)
        self.label_lev:setPositionY(-50)
        self.img_lv_bg:setPositionY(-50)
    else
        self.icon:setVisible(false)
        self:setBgVis(false)
        self.label_lev:setPositionY(0)
        self.img_lv_bg:setPositionY(0)
    end
end
--只显示icon
function ProsItem:setBaseData(id)
    local config = {}
    if Config.PartnerProscriptionData.data_base_info[id] and Config.PartnerProscriptionData.data_base_info[id][4] then
        config = Config.PartnerProscriptionData.data_base_info[id][4]
    end
    if config and config.show then
        loadSpriteTexture(self.sprite_icon, PathTool.getPlistImgForDownLoad("proscription/proscription_skill",config.show), LOADTEXT_TYPE) 
    end
    self.label_lev:setVisible(false)
    self.img_lv_bg:setVisible(false)
    self.all_lev_bg:setVisible(false)
    self.all_lev:setVisible(false)
end

--只显示icon
function ProsItem:setAllLev(data)
    local lev_num = 0
    for i,v in pairs(data.proscription or {}) do
        lev_num = lev_num + v.p_lev
    end
    self.label_lev:setVisible(false)
    self.img_lv_bg:setVisible(false)
    self.all_lev_bg:setVisible(true)
    self.all_lev:setVisible(true)
    self.all_lev:setString(lev_num)
end
function ProsItem:setItemScale(scale)
    self:setScale(scale)
    local num = 1/scale
    self.all_lev_bg:setScale(num)
    self.all_lev:setScale(num)
    self.all_lev_bg:setPositionX(self.all_lev_bg:getPositionX()* (1+(1-scale)*0.5))
    self.all_lev_bg:setPositionY(self.all_lev_bg:getPositionY()* (1+(1-scale)*0.5))
    self.all_lev:setPositionX(self.all_lev:getPositionX()* (1+(1-scale)*0.5))
    self.all_lev:setPositionY(self.all_lev:getPositionY()* (1+(1-scale)*0.5))
end
function ProsItem:addCallBack(back)
    self.callback = back
end
function ProsItem:setBgVis(status)
    self.bg:setVisible(status)
end
function ProsItem:DeleteMe()

end

