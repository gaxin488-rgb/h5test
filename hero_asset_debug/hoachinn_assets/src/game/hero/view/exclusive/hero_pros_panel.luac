--     if bool then
--         MainuiController:getInstance():setIsShowMainUIBottom(true)
--     end
-- end

-----------------@ 按钮点击事件
-- 关闭
function HeroProsPanel:_onClickCloseBtn(  )
	controller:openHeroProsPanel(false)
end

function HeroProsPanel:close_callback(  )
	for k, panel in pairs(self.panel_list) do
        panel:DeleteMe()
    end
    self.panel_list = nil
	
    if self.hero_pros_switch_event then
        GlobalEvent:getInstance():UnBind(self.hero_pros_switch_event)
        self.hero_pros_switch_event = nil
    end
    controller:openHeroProsPanel(false)
	controller:openExclusiveBackPanel(false)
    MainuiController:getInstance():getMainUi():changeBottomShowStatus(1)
end