HeroProsDetailsPanel = HeroProsDetailsPanel or BaseClass(BaseView)

local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroProsDetailsPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_pros_details_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
    self.now_attr_list = {}
end

function HeroProsDetailsPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    self.panel_1 = self.main_container:getChildByName("panel_1")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_6543"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.image_title:getContentSize().height))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.skill_panel = self.main_container:getChildByName("skill_panel")
    self.name_bg = self.skill_panel:getChildByName("name_bg")
    self.name = self.skill_panel:getChildByName("name")
    self.no_tip = self.skill_panel:getChildByName("no_tip")
    self.no_tip:setString(TI18N("语言_c_1891"))
    self.no_tip:setVisible(false)
    self.desc_scroll = self.skill_panel:getChildByName("desc_scroll")
    self.desc_scroll:setScrollBarEnabled(false)
    self.skill_tip = createRichLabel(20,cc.c3b(0x47, 0x1b, 0x06),cc.p(0,1),cc.p(0,0),nil,nil,540)
    self.desc_scroll:getInnerContainer():addChild(self.skill_tip)
    self.score_panel = self.main_container:getChildByName("score_panel")
    self.score_bg = self.score_panel:getChildByName("score_bg")
    self.icon = self.score_panel:getChildByName("icon")
    self.icon:ignoreContentAdaptWithSize(true)
    self.score_txt = self.score_panel:getChildByName("score_txt")
    self.score_txt:setString(TI18N("语言_c_6544"))
    self.fight_label = CommonNum.new(20, self.score_panel, 99999, - 2, cc.p(1, 0.5), 4)
    self.fight_label:setPosition(self.score_bg:getPositionX() - 40, 58) 
    self.fight_label:setScale(1.2)
    self.attr_panel = self.main_container:getChildByName("attr_panel")
    self.attr_line_right = self.attr_panel:getChildByName("attr_line_right")
    self.attr_title = self.attr_panel:getChildByName("attr_title")
    self.attr_title:setString(TI18N("语言_c_6545"))
    self.attr_line_left = self.attr_panel:getChildByName("attr_line_left")
    setTextTweenBg(self.attr_title,self.attr_line_left,self.attr_line_right,nil,30,false)
    self.effect_panel = self.main_container:getChildByName("effect_panel")
    self.effect_line_right = self.effect_panel:getChildByName("effect_line_right")
    self.effect_title = self.effect_panel:getChildByName("effect_title")
    self.effect_title:setString(TI18N("语言_c_6546"))
    self.effect_line_left = self.effect_panel:getChildByName("effect_line_left")
    setTextTweenBg(self.effect_title,self.effect_line_left,self.effect_line_right,nil,30,false)
    self.effect_scroll = self.effect_panel:getChildByName("effect_scroll")
    if self.task_view == nil then
        local scroll_view_size = self.effect_scroll:getContentSize()
        local setting = {
            item_class = HeroProsDetailsitem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 603,               -- 单元的尺寸width
            item_height = 130,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1,  
        }
        self.task_view = CommonScrollViewLayout.new(self.effect_scroll, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
end

function HeroProsDetailsPanel:register_event(  )

    registerButtonEventListener(self.select_btn, function ( )
        -- local str = TI18N("语言_c_5327")
        -- CommonAlert.show( str, TI18N("语言_c_63"), function()
        --     HalidomController:getInstance():sender22206(tonumber(self.halidom_index))
        -- end, TI18N("语言_c_62"),nil,nil,nil,{timer=5, timer_for=true, off_y = 10, title = TI18N("语言_c_5315"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
    end,2)

    registerButtonEventListener(self.background, function ( )
		_controller:openHeroProsDetailsPanel(false)
    end)
    registerButtonEventListener(self.close_btn, function ( )
		_controller:openHeroProsDetailsPanel(false)
    end)
end
function HeroProsDetailsPanel:openRootWnd(data)
    self.data = data
    self.hero_vo = data.hero_vo
    self.proscription_id = Config.PartnerData.data_partner_base[self.hero_vo.bid].proscription_id
    self:setData()
end
function HeroProsDetailsPanel:setData()
    local cfg = Config.PartnerProscriptionData.data_base_info[self.proscription_id]
    self.icon:loadTexture(PathTool.getPlistImgForDownLoad("proscription/proscription_skill",cfg[4].show),LOADTEXT_TYPE)
    local lv_info_cfg = Config.PartnerProscriptionData.data_lv_info[self.proscription_id]
    local lv_num = 0
    for k, v in pairs(lv_info_cfg) do
        lv_num = lv_num + tableLen(v)
    end
    local lev_cfg = Config.PartnerProscriptionData.data_rev_info
    if lv_num >= tableLen(lev_cfg) then
        lv_num = tableLen(lev_cfg)
    end
    self.fight_label:setNum(lev_cfg[lv_num].score)
    
    local _w = self.score_txt:getContentSize().width + self.fight_label:getContentSize().width + 80
    local max_w = math.max(_w,self.score_bg:getContentSize().width)
    self.score_bg:setContentSize(cc.size(max_w,self.score_bg:getContentSize().height))
    self.score_txt:setPositionX(self.fight_label:getPositionX() - self.fight_label:getContentSize().width - 20)
    local cfg = Config.PartnerProscriptionData.data_lv_info[self.proscription_id][4]
    local skill_cfg = Config.SkillData.data_get_skill(cfg[tableLen(cfg)].unlock[1])
    if skill_cfg then
        self.name:setChangeScaleOffWidth(178)
        self.name:setString(skill_cfg.name.."("..TI18N("语言_c_6416")..")")
    end
    if _model:getOneProsSkillIsShield(self.hero_vo) then
        self.skill_tip:setVisible(true)
        self.no_tip:setVisible(false)
    else
        self.skill_tip:setVisible(false)
        self.no_tip:setVisible(true)
    end
    self.skill_tip:setString(cfg[tableLen(cfg)].desc)
    local _h = math.max(self.skill_tip:getContentSize().height,self.desc_scroll:getContentSize().height)
    if _h > self.desc_scroll:getContentSize().height then
        self.desc_scroll:setTouchEnabled(true)
    else
        self.desc_scroll:setTouchEnabled(false)
    end
    self.desc_scroll:setInnerContainerSize(cc.size(self.desc_scroll:getContentSize().width,_h))
    self.skill_tip:setPositionY(_h)
    self:updateBasePanel()
    self:updateEffPanel()
end
function HeroProsDetailsPanel:updateBasePanel(  )
    local cfg = Config.PartnerProscriptionData.data_lv_info[self.proscription_id]
    local list = {}
    for k, v in pairs(self.hero_vo.proscription) do
        for key, value in pairs(v.p_attr) do
            local attr_name = Config.AttrData.data_id_to_key[value.attr_id]
            if list[attr_name] then
                list[attr_name] = list[attr_name] + value.attr_val
            else
                list[attr_name] = value.attr_val
            end
        end
    end
    local cfg_attr_list = {}
    for key, value in pairs(cfg) do
        for k, v in pairs(value[tableLen(value)].attr) do
            if cfg_attr_list[v[1]] then
                cfg_attr_list[v[1]] = cfg_attr_list[v[1]] + v[2]
            else
                cfg_attr_list[v[1]] = v[2]
            end
        end
    end
    local data = {}
    for key, value in pairs(cfg_attr_list) do
        local _list = {}
        _list[1] = key
        _list[2] = 0
        _list[3] = value
        for k, v in pairs(list) do
            if key == k then
                _list[2] = v
            end
        end
        table.insert(data,_list)
    end
    for k, v in pairs(self.now_attr_list) do
        v:removeFromParent()
        v = nil
    end
    self.now_attr_list = {}
    for k, v in pairs(data) do
        local _x = 20 + math.floor((k-1)%2) * 300
        local _y = 120 - math.floor((k-1)/2) * 45
        local item = ccui.Layout:create()
        item:setContentSize(cc.size(280, 40))
        item:setAnchorPoint(cc.p(0,1))
        local res = PathTool.getResFrame("common","common_90018")
        item.bg = createImage(item,res,0,0,cc.p(0,0),true,nil,true)
        item.bg:setContentSize(cc.size(280, 40))
        local icon = PathTool.getAttrIconByStr(v[1])
        item.icon = createSprite(PathTool.getResFrame("common", icon),20,20,item,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
        item.name = createLabel(22,cc.c4b(124,85,54,255),nil,55,20,Config.AttrData.data_key_to_name[v[1]],item,nil,cc.p(0,0.5))
        item.label = createRichLabel(22,cc.c4b(124,85,54,255), cc.p(1, 0.5), cc.p(270, 20), nil, nil, 380)
        item:addChild(item.label)
        local attr_val = v[2]
        local max_val = v[3]
        local icon = PathTool.getAttrIconByStr(v[1])
        local is_per = PartnerCalculate.isShowPerByStr(v[1])
        if is_per == true then
            attr_val = (attr_val/10).."%"
            max_val = (max_val/10).."%"
        end
        local attr_str = string_format("<div fontcolor=#0ea80e>+%s</div>/%s", attr_val,max_val)
        item.label:setString(attr_str)
        item:setPosition(cc.p(_x,_y))
        table.insert(self.now_attr_list,item)
        self.attr_panel:addChild(item)
    end
end

function HeroProsDetailsPanel:updateEffPanel()
    local data = {}
    local base_cfg = Config.PartnerProscriptionData.data_base_info[self.proscription_id]
    local cfg = Config.PartnerProscriptionData.data_lv_info[self.proscription_id]
    for key, value in pairs(cfg) do
        for k, v in pairs(value) do
            if v.type ~= 4 and v.unlock[1] then
                local list = {}
                list.id = v.unlock[1]
                list.desc = v.desc
                list.show = base_cfg[v.type].show
                list.is_act = 0
                for key, value in pairs(self.hero_vo.proscription) do
                    for k, v in pairs(value.p_extra) do
                        if list.id == v.extra_v then
                            list.is_act = 1
                        end
                    end
                end
                table.insert(data,list)
            end
        end
        -- local one_cfg = v[tableLen(v)]
    end
    table.sort(data,function(a,b) return a.is_act > b.is_act end)
    self.task_view:setData(data)
end

function HeroProsDetailsPanel:close_callback(  )
    if self.fight_label then
        self.fight_label:DeleteMe()
    end
    self.fight_label = nil
    _controller:openHeroProsDetailsPanel(false)
end




--子项
HeroProsDetailsitem = class("HeroProsDetailsitem", function()
    return ccui.Widget:create()
end)

function HeroProsDetailsitem:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function HeroProsDetailsitem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_pros_details_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(603,130))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.skill_node = self.main_container:getChildByName("skill_node")
    self.icon = self.main_container:getChildByName("icon")
    self.icon:ignoreContentAdaptWithSize(true)
    self.desc = self.main_container:getChildByName("desc")
    setTextMaxWidth(self.desc,430)
    self.skill_tip = createRichLabel(20,cc.c3b(0x7c, 0x55, 0x36),cc.p(0,0.5),cc.p(185,102),nil,nil,500)
    self.main_container:addChild(self.skill_tip)
end

function HeroProsDetailsitem:setData(data)
    if not self.skill_item then
        self.skill_item = SkillItem.new(true, false, true,0.8)
        self.skill_node:addChild(self.skill_item)
    end
    local skill_cfg = Config.SkillData.data_get_skill(data.id)
    if skill_cfg then
        self.skill_item:setData(skill_cfg)
        if data.is_act == 1 then
            self.skill_tip:setString(skill_cfg.name..TI18N("语言_c_6552"))
        else
            self.skill_tip:setString(skill_cfg.name..TI18N("语言_c_6553"))
        end
    end
    if self.skill_tip:getContentSize().width > 400 then
        self.skill_tip:setScale(400/self.skill_tip:getContentSize().width)
    else
        self.skill_tip:setScale(1)
    end
    local num = 100
    if judgingLanguage() then
        num = 65
    end
    self.desc:setString(transformTextToShort(data.desc,num))
    addEvt2showAllTextTips(self.desc,data.desc,num)
    self.icon:loadTexture(PathTool.getPlistImgForDownLoad("proscription/proscription_skill",data.show),LOADTEXT_TYPE)
end

function HeroProsDetailsitem:register_event( )
    
end

function HeroProsDetailsitem:DeleteMe()

end