HeroSuperHeartActivityPanel = HeroSuperHeartActivityPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
function HeroSuperHeartActivityPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Mini   
    self.is_full_screen = false
    self.layout_name = "hero/hero_super_heart_activity_panel"

    self.res_list = {
    }
end

function HeroSuperHeartActivityPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_size = self.main_container:getContentSize()
    self:playEnterAnimatianByObj(self.main_container , 2)  
    self.titlebg = self.main_container:getChildByName("imgTitleBg")
    self.title = self.main_container:getChildByName("win_title")
    self.title:setString(TI18N("语言_c_5023"))
    moveTextBg(self.title,self.titlebg,50,self.titlebg:getContentSize().width)
    --消耗
    self.cost_panel = self.main_container:getChildByName("cost_panel")
    self.cost_panel.label = self.cost_panel:getChildByName("label")
    self.cost_panel.label:setString(TI18N("语言_c_4803"))
    local node = cc.Node:create()
    self.cost_panel:addChild(node)
    self.cost_panel.node_item = node

    --属性
    local attr_panel = self.main_container:getChildByName("attr_panel")
    self.attr_panel = attr_panel
    self.attr_panel.pos = cc.p(self.attr_panel:getPosition())
    self.attr_panel_size = attr_panel:getContentSize()
    local attr_title = attr_panel:getChildByName("attr_title")
    attr_title:setString(TI18N("语言_c_5024"))
    self.attr_icon_list = {}
    self.attr_label_key_list = {}
    self.attr_labe_left_list = {}
    self.attr_labe_right_list = {}
    self.attr_arrow_list = {}
    self.attr_imagebox_list = {}
    for i=1,3 do
        self.attr_icon_list[i] = attr_panel:getChildByName("attr_icon"..i)
        self.attr_label_key_list[i] = attr_panel:getChildByName("attr_label_key"..i)
        self.attr_labe_left_list[i] = attr_panel:getChildByName("attr_label_left"..i)
        self.attr_imagebox_list[i] = attr_panel:getChildByName("imgbox_"..i)
    end

    --技能
    self.skill_panel = self.main_container:getChildByName("skill_panel")
    self.skill_title = self.skill_panel:getChildByName("skill_title")
    self.skill_title:setString(TI18N("语言_c_5025"))
    self.skill_des = self.skill_panel:getChildByName("skill_des")
    self.skill_des:ignoreContentAdaptWithSize(true)
    self.skill_des:setTextAreaSize(cc.size(600, 0))
    self.imgbox_1 = self.skill_panel:getChildByName("imgbox_1") --异能英雄显示
    self.imgbox_1.label_name_1 = self.imgbox_1:getChildByName("label_name_1")
    self.imgbox_1.label_des_1 = self.imgbox_1:getChildByName("label_des_1")
    self.imgbox_1.label_name_1:ignoreContentAdaptWithSize(true)
    self.imgbox_1.label_name_1:setTextAreaSize(cc.size(300, 0))
    self.imgbox_1.label_des_1:ignoreContentAdaptWithSize(true)
    self.imgbox_1.label_des_1:setTextAreaSize(cc.size(300, 0))

    local imgbox = self.skill_panel:getChildByName("imgbox")
    self.scrollview_skill = imgbox:getChildByName("scrollview_skill")
    self.scrollview_skill.size = self.scrollview_skill:getContentSize()
    self.scrollview_skill:setScrollBarEnabled(false)

    self.streng_btn = self.main_container:getChildByName("streng_btn")
    self.streng_btn:getChildByName("label"):setString(TI18N("语言_c_2904"))

    self.img_rule = self.main_container:getChildByName("img_rule")
    self.close_btn = self.main_container:getChildByName("close_btn")
    --head
    local activation_top_panel = self.main_container:getChildByName("activation_top_panel")

    self.node_activat_item = activation_top_panel:getChildByName("node_activat_item")
    local item = ExclusiveItem.new()
    self.node_activat_item:addChild(item)
    self.node_activat_item.itemIcon = item

    self.activat_name = activation_top_panel:getChildByName("activat_name")
    self.activat_name:setChangeScaleOffWidth(activation_top_panel:getContentSize().width - 380)
    self.activat_type = activation_top_panel:getChildByName("activat_type")
    self.activat_type:setChangeScaleOffWidth(activation_top_panel:getContentSize().width - 380)
    self.activat_score = activation_top_panel:getChildByName("activat_score")
    self.activat_score:setString(TI18N("语言_c_1742"))
    self.power_label = CommonNum.new(1, activation_top_panel, 1, - 2, cc.p(0, 0.5))
    self.power_label:setPosition(cc.p(self.activat_score:getPositionX() + self.activat_score:getContentSize().width + 5 , 32))
    self.power_label:setNum(0)
    -- self.power_label:setScale(0.8)
end

