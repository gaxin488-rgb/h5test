    --     self:updateData()
    --     self:setData()
    -- end)
    -- self:addGlobalEvent(HeroEvent.Hero_HEART_UPDATE_Event, function(vo) 
    --     if not self.hero_vo then return end
    --     local config = Config.PartnerHeartData.data_soul_level[vo.aid][vo.a_lev + 1]
    --     if not config then
    --         message(TI18N("语言_c_2104"))
    --         controller:openHeroSuperHeartActivityPanel(false)
    --         return
    --     end
    --     self:showEffect()
    --     self.hero_vo = vo
    --     self:updateData()
    --     self:setData()
    -- end)

