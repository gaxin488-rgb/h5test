HeroSuperHeartStrengPanel = class("HeroSuperHeartStrengPanel",function()
    return ccui.Layout:create()
end)
local controller = HeroController:getInstance()
local model = controller:getModel()
--禁术等级icon位置
local pos_list = {
    [1] = {244,242,0.64},
    [2] = {157,210,0.7},
    [3] = {112,164,0.77},
    [4] = {157,120,0.85},
    [5] = {245,93,0.92},
    [6] = {358,86,1},
    [7] = {474,98,0.92},
    [8] = {572,123,0.85},
    [9] = {608,163,0.77},
    [10] = {554,210,0.7},
    [11] = {454,242,0.64},
}

function HeroSuperHeartStrengPanel:ctor(data)
    self.data = data
    self.hero_vo = data.hero_vo or {}
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_super_heart_streng_panel"))
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self.hero_item_list = {}
    -- 资源加载
    local res_list = {
        { path = PathTool.getPlistImgForDownLoad("herolibrary","herolibrary"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("proscription","proscription"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("proscription","proscription_bg"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("proscription","soul"), type = ResourcesType.single },
    }
    if self.init_res_load then
        self.init_res_load:DeleteMe()
        self.init_res_load = nil
    end
    self.init_res_load = ResourcesLoad.New()
    self.init_res_load:addAllList(res_list, function()
        if not tolua.isnull(self.root_wnd) then
            self:loadResListCompleted()
        end
    end)
    self.is_can_click_up = true
end
function HeroSuperHeartStrengPanel:loadResListCompleted()
    self:initView()
    self:registerEvent()
    self:openRootWnd()
end
function HeroSuperHeartStrengPanel:initView()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.spine_panel = self.root_wnd:getChildByName("spine_panel")
    self.background_1 = self.root_wnd:getChildByName("background_1")
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.name_bg = self.top_panel:getChildByName("name_bg")
    self.name = self.top_panel:getChildByName("name")
    self.rebirth_btn = self.top_panel:getChildByName("rebirth_btn")
    self.rebirth_txt = self.rebirth_btn:getChildByName("label")
    self.rebirth_txt:setString(TI18N("语言_c_6528"))
    self.icon_panel = self.top_panel:getChildByName("icon_panel")
    self.choose_panel = self.top_panel:getChildByName("choose_panel")
    self.node_item = self.choose_panel:getChildByName("node_item")
    local item = ExclusiveItem.new()
    self.node_item:addChild(item)
    self.node_item.itemIcon = item
    self.next_bg = self.top_panel:getChildByName("next_bg")
    self.now_txt = self.next_bg:getChildByName("now_txt")
    setTextMaxWidth(self.now_txt,230)
    self.next_icon = self.next_bg:getChildByName("next_icon")
    self.next_txt = self.next_bg:getChildByName("next_txt")
    setTextMaxWidth(self.next_txt,230)
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.base_panel = self.bottom_panel:getChildByName("base_panel")
    self.base_txt = self.base_panel:getChildByName("base_txt")
    self.base_txt:setString(TI18N("语言_c_851"))
    self.attr_panel = self.base_panel:getChildByName("attr_panel")
    self.attr_icon_list = {}
    self.attr_label_key_list = {}
    self.attr_labe_left_list = {}
    self.attr_labe_right_list = {}
    self.attr_arrow_list = {}
    self.attr_imagebox_list = {}
    for i=1,3 do
        self.attr_icon_list[i] = self.attr_panel:getChildByName("attr_icon"..i)
        self.attr_label_key_list[i] = self.attr_panel:getChildByName("attr_label_key"..i)
        self.attr_label_key_list[i]:setTouchEnabled(true)
        self.attr_labe_left_list[i] = self.attr_panel:getChildByName("attr_label_left"..i)
        self.attr_labe_right_list[i] = self.attr_panel:getChildByName("attr_label_right"..i)
        self.attr_arrow_list[i] = self.attr_panel:getChildByName("arrow_icon"..i)
        self.attr_imagebox_list[i] = self.attr_panel:getChildByName("imgbox_"..i)
        self.attr_imagebox_list[i]:setVisible(false)
    end
    self.skill_panel = self.bottom_panel:getChildByName("skill_panel")
    self.skill_txt = self.skill_panel:getChildByName("skill_txt")
    self.skill_txt:setString(TI18N("语言_c_4965"))
    self.skill_max = self.skill_panel:getChildByName("skill_max")
    self.skill_max:setString(TI18N("语言_c_777"))
    self.skill_max:setVisible(false)
    self.skill_desc_scroll = self.skill_panel:getChildByName("skill_desc_scroll")
    self.skill_desc_scroll:setScrollBarEnabled(false)
    self.skill_desc = createRichLabel(22,cc.c3b(0x7c,0x55,0x36),cc.p(0,1),cc.p(0,100),-4,nil,560)
    self.skill_desc_scroll:addChild(self.skill_desc)
    self.cost_panel = self.bottom_panel:getChildByName("cost_panel")
    self.cost_txt = self.cost_panel:getChildByName("cost_txt")
    self.cost_txt:setString(TI18N("语言_c_6534"))
    self.up_btn = self.cost_panel:getChildByName("up_btn")
    self.up_txt = self.up_btn:getChildByName("label")
    self.up_txt:setString(TI18N("语言_c_4967"))
    self.item_node = self.cost_panel:getChildByName("item_node")
    self.max_tip = self.cost_panel:getChildByName("max_tip")
    setTextMaxWidth(self.max_tip,400)
    self.max_tip:setString(TI18N("语言_c_777"))
    self.max_tip:setVisible(false)
    self.rule_btn = self.bottom_panel:getChildByName("rule_btn")
    self:adaptationScreen()
    self:updateSpine()
end

function HeroSuperHeartStrengPanel:addToParent( status )
	status = status or false
    self:setVisible(status)
end
--设置适配屏幕
function HeroSuperHeartStrengPanel:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)

    local container_size = self.main_container:getContentSize()
    local tab_y = self.spine_panel:getPositionY()
    self.spine_panel:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.background_1:getPositionY()
    self.background_1:setPositionY(top_y - (container_size.height - tab_y))
end

function HeroSuperHeartStrengPanel:updateSpine()
    self.spine_list = {}
    local pos_list = {
        [1]={139,446,45},
        [2]={139,446,140},
        [3]={126,704,140},
        [4]={493,606,35},
        [5]={681,642,55},
        [6]={660,355,127},
    }
    for i=1,6 do
        self.spine_list[i] = createEffectSpine("E29002", cc.p(pos_list[i][1], pos_list[i][2]), cc.p(0.5, 0.5), true, PlayerAction.action)
        self.spine_panel:addChild(self.spine_list[i])
        self.spine_list[i]:setRotation(pos_list[i][3])
    end
end
function HeroSuperHeartStrengPanel:registerEvent()
    registerButtonEventListener(self.up_btn, function()
        if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
            message(TI18N("语言_c_7567"))
            return
        end
        if self.is_can_click_up then
            self:onClickBtnUp() 
        else
            message(TI18N("语言_s_2910"))
        end
    end, true, 2,nil,nil,0.5)
    registerButtonEventListener(self.rebirth_btn, handler(self, function()
        if self.hero_vo.h_lev and self.hero_vo.h_lev > 0 then
            if self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroConvertLock) then
                message(TI18N("语言_c_3287"))
                return
            elseif self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroLock) then
                message(TI18N("语言_c_3286"))
                return
            end
            controller:openExclusiveBackPanel(true,self.data)
        else
                message(TI18N("语言_s_1155"))
                return            
        end
    end) ,true, 2)
    
    registerButtonEventListener(self.rule_btn, function(param, sender, event_type)
        local config
        if self.data.panel_type == HERO_SOUL_TYPE then
            config = Config.PartnerSoulData.data_const["game_rule1"]
        else
            config = Config.PartnerHeartData.data_const["game_rule1"]
        end
        TipsManager:getInstance():showAdventureBuffTipsScroll(config.desc, sender:getTouchBeganPosition(),nil,nil,420,false,730)
    end ,true, 2)
    --强化数据更新
    self.hero_soul_updata_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_SOUL_UPDATE_Event,function(vo)
        if not self.hero_vo then return end
        if not vo.hid or vo.hid == 0 then
            vo.hid = Config.PartnerData.data_partner_base[vo.bid].horcruxes
        end
        -- local config = Config.PartnerSoulData.data_soul_level[vo.hid][vo.h_lev + 1]
        -- local max_lv = controller:getModel():getHorcruxesMaxLev() 
        -- if not config or vo.h_lev >= max_lv then
        --     message(TI18N("语言_c_2104"))
        --     controller:openHeroSuperHeartStrengPanel(false)
        --     return
        -- end
        self.hero_vo = vo
        self:updateData()
        self:setData()
        GlobalEvent:getInstance():Fire(HeroEvent.Hero_Pros_Switch_Back_Event,MainuiConst.pros_type.soul)
    end)
    self.hero_heart_updata_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_HEART_UPDATE_Event,function(vo)
        if not self.hero_vo then return end
        -- local config = Config.PartnerHeartData.data_soul_level[vo.aid][vo.a_lev + 1]
        -- if not config then
        --     message(TI18N("语言_c_2104"))
        --     controller:openHeroSuperHeartStrengPanel(false)
        --     return
        -- end
        self.hero_vo = vo
        self:updateData()
        self:setData()
    end)

    --添加英雄选择返回事件
    self.upgrade_star_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event,function(vo)
        self:updateHeroItemInfo()
    end)
end
function HeroSuperHeartStrengPanel:onClickBtnUp()
    if not self.hero_vo then return end
    if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
        message(TI18N("语言_c_7567"))
        return
    end

    local lev_cfg = self.lev_cfg_next
    if not lev_cfg then return end
    local cost = lev_cfg and lev_cfg.cost
    if cost and next(cost) and cost[1][1] then
        for i, v in ipairs(cost) do
            if v[1] and v[1] ~= 0 then
                local config = Config.ItemData.data_get_data(v[1])
                local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(v[1])
                if config.type == BackPackConst.item_type.NORMAL and config.sub_type == BackPackConst.item_tab_type.HERO then
                    local bid = config.effect[1].val[1] 
                    local hero_cfg = Config.PartnerData.data_partner_base[bid]
                    num = #(controller:getModel():getHeroInfoByBidStar(hero_cfg.bid, config.eqm_jie))
                end
                if num < v[2] then
                    BackpackController:getInstance():openTipsSource( true,config)
                    return 
                end
            end
        end
    end

    local hero_list = {}
    if self.hero_item_data_list and next(self.hero_item_data_list) then
        for k, v in pairs(self.hero_item_data_list[1].dic_select_list) do
            hero_list[#hero_list + 1] = {partner_id = k}
        end
    end
    local expend = self.lev_cfg_next.expend1[1]
    if expend and expend[1] then
        if expend[3] > #hero_list then
            local hero_cfg = Config.PartnerData.data_partner_base[expend[1]]
            local config = Config.ItemData.data_get_data(hero_cfg.item_id)
            BackpackController:getInstance():openTipsSource( true,hero_cfg.item_id)
            return
        end
    end
    if self.data.panel_type == HERO_SOUL_TYPE then
        if not HeroCalculate.checkIsSufficeStar(self.hero_vo) then
            local need_star = 0
            local data_cfg = Config.PartnerSoulData.data_const["lock_star"]
            if data_cfg then
                local next_lv = self.hero_vo.h_lev + 1
                for k, v in pairs(data_cfg.val) do
                    if next_lv >= v[1] then
                        need_star = v[2]
                    end
                end
            end
            message(string.format(TI18N("语言_c_6281"),need_star))
            return 
        end
        if self.hero_vo.isResonateHero and self.hero_vo:isResonateHero() then
            message(TI18N("语言_c_5489"))
            return 
        end
        self.is_can_click_up = false
        controller:sender11023(self.hero_vo.partner_id, hero_list)
    else
        --这里需要判断魂器等级条件
        local limit_h_lev = self.lev_cfg_next.limit_h_lev
        if limit_h_lev > self.hero_vo.h_lev then
            message(string.format(TI18N("语言_c_5151"), limit_h_lev))
            return
        end
        self.is_can_click_up = false
        controller:sender11027(self.hero_vo.partner_id, hero_list)
    end
end
function HeroSuperHeartStrengPanel:openRootWnd()
    self:updateData()
    self:setData()
end

function HeroSuperHeartStrengPanel:updateData()
    self.base_data = nil
    local hero_vo = self.hero_vo
    local h_cfg = Config.PartnerData.data_partner_base_fun(hero_vo.bid)
    if self.data.panel_type == HERO_SOUL_TYPE then
        self.base_data = {id = (hero_vo.hid == 0 and h_cfg.horcruxes or hero_vo.hid), lev = hero_vo.h_lev or 0, score_val = hero_vo.h_score or 1000}
        self.base_cfg = Config.PartnerSoulData.data_base_info[self.base_data.id]
        self.lev_cfg = Config.PartnerSoulData.data_soul_level[self.base_data.id][self.base_data.lev]
        self.lev_cfg_next = Config.PartnerSoulData.data_soul_level[self.base_data.id][self.base_data.lev + 1]
    elseif self.data.panel_type == HERO_HEART_TYPE then
        self.base_data = {id = (hero_vo.aid == 0 and h_cfg.alterheart or hero_vo.aid), lev = hero_vo.a_lev or 0, score_val = hero_vo.a_score or 1000}
        self.base_cfg = Config.PartnerHeartData.data_base_info[self.base_data.id]
        self.lev_cfg = Config.PartnerHeartData.data_soul_level[self.base_data.id][self.base_data.lev]
        self.lev_cfg_next = Config.PartnerHeartData.data_soul_level[self.base_data.id][self.base_data.lev + 1]
    end
    self.is_can_click_up = true
end

function HeroSuperHeartStrengPanel:setData()
    local data = self.base_data
    local base_cfg = self.base_cfg
    local name_str = ""
    if base_cfg and base_cfg.name and data.lev then
        name_str = base_cfg.name.."+"..data.lev
    end
    self.name:setString(name_str)
    -- self.name:setString(TI18N("语言_c_5004"))
    if self.name:getContentSize().width > 550 then
        setTextMaxWidth(self.name,550)
    end
    local _w = math.max(self.name_bg:getContentSize().width,self.name:getContentSize().width+50)
    self.name_bg:setContentSize(cc.size(_w,self.name_bg:getContentSize().height))

    local res_id = PathTool.getQualityBg(base_cfg.quality)
    local item_data = {}
    item_data.is_lock = false
    item_data.bg = res_id
    item_data.icon = PathTool.getSoulHorcruxIcon(base_cfg.icon)
    item_data.lev = data.lev
    self.node_item.itemIcon:setData(item_data) 
    self.now_txt:setString(name_str)
    if self.lev_cfg_next then
        local next_str = ""
        if base_cfg and base_cfg.name and data.lev then
            next_str = base_cfg.name.."+"..(data.lev + 1)
        end
        self.next_txt:setString(next_str)
        self.next_txt:setPositionX(391)
        self.next_icon:setPositionX(257)
        self.now_txt:setPositionX(123)
        self.next_txt:setVisible(true)
        self.next_icon:setVisible(true)
    else
        self.now_txt:setPositionX(257)
        self.next_txt:setVisible(false)
        self.next_icon:setVisible(false)
    end
    local _h = math.max(self.now_txt:getContentSize().height,self.now_txt:getContentSize().height+20,self.next_txt:getContentSize().height+20)
    self.next_bg:setContentSize(cc.size(self.next_bg:getContentSize().width, _h))
    self.next_txt:setPositionY(_h*0.5)
    self.next_icon:setPositionY(_h*0.5)
    self.now_txt:setPositionY(_h*0.5)
    --属性
    local lev_cfg = self.lev_cfg
    local lev_cfg_next = self.lev_cfg_next
    local attr_num = 0
    for i,v in ipairs(self.attr_label_key_list) do
        local value = lev_cfg and lev_cfg.attr[i]
        if value and value[1] and value[2] then
            local attr_key = value[1]
            local attr_val = value[2]
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10).."%"
            end
    
            local res_id = PathTool.getAttrIconByStr(attr_key)
            local res = PathTool.getResFrame("common",res_id)
            loadSpriteTexture(self.attr_icon_list[i], res, LOADTEXT_TYPE_PLIST)
    
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            v:setString(transformTextToShort(attr_name,5))
            addEvt2showAllTextTips(v,attr_name,5)
            
            self.attr_labe_left_list[i]:setString(attr_val)
            if i == 2 then
                self.attr_imagebox_list[i]:setVisible(true)
            end
        else
            value = lev_cfg_next and lev_cfg_next.attr[i]
            local attr_key = value[1]
            local attr_val = value[2]
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10).."%"
            end
            
            local res_id = PathTool.getAttrIconByStr(attr_key)
            local res = PathTool.getResFrame("common",res_id)
            loadSpriteTexture(self.attr_icon_list[i], res, LOADTEXT_TYPE_PLIST)
            
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            v:setString(transformTextToShort(attr_name,5))
            addEvt2showAllTextTips(v,attr_name,5)
            
            self.attr_labe_left_list[i]:setString(0)
            
            self.attr_icon_list[i]:setVisible(true)
            self.attr_label_key_list[i]:setVisible(true)
            self.attr_labe_left_list[i]:setVisible(true)
            self.attr_arrow_list[i]:setVisible(true)
            if i == 2 then
                self.attr_imagebox_list[i]:setVisible(true)
            end
        end
        attr_num = attr_num + 1
        if lev_cfg_next then
            local attr_val_next = lev_cfg_next.attr[i][2]
            if lev_cfg_next and lev_cfg_next.attr and lev_cfg_next.attr[i] and lev_cfg_next.attr[i][2] then
                attr_val_next = lev_cfg_next.attr[i][2]
                local is_per = PartnerCalculate.isShowPerByStr(lev_cfg_next.attr[i][1])
                if is_per == true then
                    attr_val_next = (attr_val_next/10).."%"
                end
            end
            self.attr_labe_right_list[i]:setString(attr_val_next)
            self.attr_labe_right_list[i]:setVisible(true)
        else
            self.attr_labe_right_list[i]:setString(TI18N("语言_c_4810"))
        end
    end
    --技能
    if self.data.panel_type == HERO_SOUL_TYPE then
        local des = ""
        for i, v in ipairs(Config.PartnerSoulData.data_soul_level[data.id] or {}) do
            if data.lev < i and v.desc and v.desc ~= "" then
                des = v.desc
                break
            end
        end
        if des ~= "" then
            self.skill_desc:setVisible(true)
            self.skill_max:setVisible(false)
            self.skill_desc:setString(des)
            self.skill_desc:setVisible(true)
            local size = self.skill_desc_scroll:getContentSize()
            if self.skill_desc:getContentSize().height > size.height then
                self.skill_desc_scroll:setInnerContainerSize(cc.size(size.width, self.skill_desc:getContentSize().height))
                self.skill_desc:setPositionY(self.skill_desc:getContentSize().height)
            else
                self.skill_desc_scroll:setInnerContainerSize(cc.size(size.width,size.height))
                self.skill_desc:setPositionY(size.height)
            end
        else
            -- self.skill_max:setVisible(true)
            self.skill_max:setVisible(false)
            self.skill_desc:setVisible(false)
        end
    else
        local t_cfg = {}
        for i, v in ipairs(Config.PartnerHeartData.data_soul_level[self.base_data.id] or {}) do
            t_cfg = v.unlock ~= 0 and v or t_cfg
            if v.unlock ~= 0 and i > self.base_data.lev then
                t_cfg = v
                break
            end
        end
        local config = Config.SkillData.data_get_skill(t_cfg.unlock)
        if config then
            if config.desc then
                self.skill_desc:setString(config.desc)
            end
            self.skill_desc:setVisible(true)
            local size = self.skill_desc_scroll:getContentSize()
            if self.skill_desc:getContentSize().height > size.height then
                self.skill_desc_scroll:setInnerContainerSize(cc.size(size.width, self.skill_desc:getContentSize().height))
                self.skill_desc:setPositionY(self.skill_desc:getContentSize().height)
            else
                self.skill_desc_scroll:setInnerContainerSize(cc.size(size.width,size.height))
                self.skill_desc:setPositionY(size.height)
            end
        else
            self.skill_desc:setVisible(false)
        end
        -- local is_redpoint = HeroCalculate.checkSingleHeroHeartStringRedPoint(self.hero_vo)
        -- addRedPointToNodeByStatus(self.streng_btn, is_redpoint, 5, 5)
    end

    --cost
    if lev_cfg_next and lev_cfg_next.cost and next(lev_cfg_next.cost) and lev_cfg_next.cost[1][1] then
        local item_list = {}
        self.item_node:removeAllChildren()
        self.hero_item_list = {}
        self.dic_other_selected = {}
        local cost = lev_cfg_next.cost--{{10412,10},{24400,1}}
        -- local total_w = 0
        local item_width = 0
        for i, v in ipairs(cost) do
            local item = BackPackItem.new(false, true, false, 0.7, false, true, false)
            item:setDefaultTip(true,false)
            self.item_node:addChild(item)
            item:setData({bid = v[1], num = v[2]})
            local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(v[1])
            local config = Config.ItemData.data_get_data(v[1])
            if config.type == BackPackConst.item_type.NORMAL and config.sub_type == BackPackConst.item_tab_type.HERO then
                local bid = config.effect[1].val[1] 
                local hero_cfg = Config.PartnerData.data_partner_base[bid]
                num = #(controller:getModel():getHeroInfoByBidStar(hero_cfg.bid, config.eqm_jie))
            end
            item:setNeedNum(v[2], num)
            item_list[#item_list + 1]  = item
            local item_size = item:getContentSize()
            item_width = item_size.width
            item:setPosition(item_size.width/2 + 10 + (i - 1)*item_size.width, 0)
            -- total_w = total_w + item_size.width + 10*(i - 1)
        end
        local expend = lev_cfg_next.expend1[1]
        if expend then
            --指定的 {10402,4,1} : 10402: 表示bid, 4: 表示星级 1:表示数量
            self.hero_item_data_list = {}
            self.hero_item_data_list[#self.hero_item_data_list + 1]  = self:getHeroData(expend[1], expend[2], expend[3]) 
            local target_item = HeroExhibitionItem.new(0.7, true)
            target_item:addCallBack(function()
                self.dic_other_selected = {}--self.hero_item_list[1].dic_select_list
                local setting = {}
                setting.is_master = false
                controller:openHeroUpgradeStarSelectPanel(true, self.hero_item_data_list[1], self.dic_other_selected, HeroConst.SelectHeroType.eStarFuse, setting)
            end)
            self.item_node:addChild(target_item)
            target_item:setData(self.hero_item_data_list[#self.hero_item_data_list])
            self.hero_item_list[#self.hero_item_list + 1] = target_item
            item_list[#item_list + 1]  = target_item
            local item_size = target_item:getContentSize()
            item_width = item_size.width
            target_item:setPosition(item_size.width/2 + 10 + (#item_list - 1)*item_size.width, 0)
            -- total_w = total_w + item_size.width + 10*(#item_list - 1)
            self:initCostHero(expend)
        else
            self.hero_item_data_list = {}
        end
        for i, v in ipairs(item_list) do
            -- v:setPositionX(- total_w/2 + item_width/2 + (i - 1)*(10 + item_width))
            v:setPositionX((i-1)*item_width)
        end
        self.item_node:setVisible(true)
        self.max_tip:setVisible(false)
        self.cost_txt:setVisible(true)
        local is_redpoint = HeroCalculate.checkSingleHeroHorcruxStringRedPoint(self.hero_vo)
        addRedPointToNodeByStatus(self.up_btn, is_redpoint, 5, 5)
        local is_sufice_max = HeroCalculate.checkIsSufficeStar(self.hero_vo)
        setChildUnEnabled(not is_sufice_max, self.up_btn)
        setChildUnEnabled(false,self.up_btn)
        
        if self.hero_vo.isTryoutHero and self.hero_vo:isTryoutHero() then
            setChildUnEnabled(true, self.up_btn)
        end

    else
        self.cost_txt:setVisible(false)
        self.item_node:setVisible(false)
        self.max_tip:setVisible(true)
        setChildUnEnabled(true,self.up_btn)
        addRedPointToNodeByStatus(self.up_btn, false)
    end
end

---初始化吃卡材料
function HeroSuperHeartStrengPanel:initCostHero(expend)
    local item = self.hero_item_list[1]
    local data = self.hero_item_data_list[1]
    local hero_list = model:getHeroList()

    self.conditions_hero_list = {}
    for k,hero in pairs(hero_list) do
        --指定卡
        if not next(hero.dic_locks) and not next(hero.dic_in_form) and expend[1] == hero.bid and expend[2] == hero.star then
            table.insert(self.conditions_hero_list, hero)
        end
    end
    local sort_func = SortTools.tableCommonSorter({{"lev", true}, {"id", true}})
    table.sort(self.conditions_hero_list, sort_func)
    local count = 0
    for _,hero_vo in ipairs(self.conditions_hero_list) do
        if data.dic_select_list[hero_vo.id] == nil then
            data.dic_select_list[hero_vo.id] = hero_vo
            if not hero_vo:isInForm() and not hero_vo:isLock() then
                count = count + 1
            end
            if count >= data.count then
                break
            end
        end
    end
    self:updateHeroItemInfo()
end

function HeroSuperHeartStrengPanel:updateHeroItemInfo()
    if self.hero_item_list and self.hero_item_list[1] then
        local item = self.hero_item_list[1]
        local data = self.hero_item_data_list[1]
        local count = #data.dic_select_list
        for k, v in pairs(data.dic_select_list) do
            count = count + 1
        end
        data.lev = string_format("%s/%s", count, data.count)
        item.num_label:setString(data.lev)
        if count >= data.count then
            item:setHeadUnEnabled(false)
        else
            item:setHeadUnEnabled(true)
        end  
    end
end
function HeroSuperHeartStrengPanel:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s/%s", 0, count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end

function HeroSuperHeartStrengPanel:DeleteMe()
    if self.spine_list and next(self.spine_list) then
        for k,v in ipairs(self.spine_list) do
            if v then
                v:clearTracks()
                v:removeFromParent()
                v = nil
            end
        end
    end
    if self.hero_soul_updata_event then
        GlobalEvent:getInstance():UnBind(self.hero_soul_updata_event)
        self.hero_soul_updata_event = nil
    end
    if self.hero_heart_updata_event then
        GlobalEvent:getInstance():UnBind(self.hero_heart_updata_event)
        self.hero_heart_updata_event = nil
    end
    if self.upgrade_star_select_event then
        GlobalEvent:getInstance():UnBind(self.upgrade_star_select_event)
        self.upgrade_star_select_event = nil
    end
end