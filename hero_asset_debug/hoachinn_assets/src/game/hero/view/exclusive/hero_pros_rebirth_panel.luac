HeroProsRebirthPanel = HeroProsRebirthPanel or BaseClass(BaseView)

local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroProsRebirthPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_pros_rebirth_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
	}
end

function HeroProsRebirthPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    self.panel_1 = self.main_container:getChildByName("panel_1")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_6547"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.image_title:getContentSize().height))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.top_title = createRichLabel(24,cc.c3b(0x7c,0x55,0x36),cc.p(0.5,0.5),cc.p(340,396),-4,nil,600)
    self.main_container:addChild(self.top_title)
    self.top_title:setString(TI18N("语言_c_6549"))
    self.reward_scroll = self.main_container:getChildByName("reward_scroll")
    self.cost_panel = self.main_container:getChildByName("cost_panel")
    self.cost_tip = self.cost_panel:getChildByName("cost_tip")
    self.cost_tip:setString(TI18N("语言_c_6548"))
    self.cost_bg = self.cost_panel:getChildByName("cost_bg")
    self.cost_icon = self.cost_panel:getChildByName("cost_icon")
    self.cost_txt = self.cost_panel:getChildByName("cost_txt")
    self.select_btn = self.main_container:getChildByName("select_btn")
    self.select_txt = self.select_btn:getChildByName("label")
    self.select_txt:setString(TI18N("语言_c_6550"))
end

function HeroProsRebirthPanel:register_event(  )

    registerButtonEventListener(self.select_btn, function ( )
        local str = TI18N("语言_c_6551")
        CommonAlert.show( str, TI18N("语言_c_63"), function()
            _controller:sender11423(self.hero_vo.partner_id)
            _controller:openHeroProsRebirthPanel(false)    
        end, TI18N("语言_c_62"),nil,nil,nil,{timer=3, timer_for=true, off_y = 10, title = TI18N("语言_c_6547"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
    end,2)

    registerButtonEventListener(self.background, function ( )
		_controller:openHeroProsRebirthPanel(false)
    end)
    registerButtonEventListener(self.close_btn, function ( )
		_controller:openHeroProsRebirthPanel(false)
    end)
    self.hero_pros_item_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Pros_Item_Event,function(data)
        if not data then return end
        -- if data.partner_id == self.hero_vo.partner_id then
            self:setData(data)
        -- end
    end)
end
function HeroProsRebirthPanel:openRootWnd(data)
    self.data = data
    self.hero_vo = data.hero_vo
    _controller:sender11422(self.hero_vo.partner_id)
end
function HeroProsRebirthPanel:setData(data)
    if self.task_view == nil then
        local scroll_view_size = self.reward_scroll:getContentSize()
        local setting = {
            item_class = BackPackItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 2,                   -- y方向的间隔
            item_width = BackPackItem.Width,               -- 单元的尺寸width
            item_height = BackPackItem.Height,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 4,
            -- scale = 0.80,
            is_backpack_item = true            
        }
        self.task_view = CommonScrollViewLayout.new(self.reward_scroll, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    self.task_view:setData(data.items)
    local lev_num = 0
    for k, v in pairs(self.hero_vo.proscription) do
        lev_num = lev_num + v.p_lev
    end
    local cfg = Config.PartnerProscriptionData.data_rev_info[lev_num]
    if cfg then
        local id = cfg.rev_cost[1][1]
        local have_num = BackpackController:getInstance():getModel():getItemNumByBid(id)
        local need_num = cfg.rev_cost[1][2]
        loadSpriteTexture(self.cost_icon,PathTool.getItemRes(id),LOADTEXT_TYPE)
        if need_num > have_num then
            self.cost_txt:setTextColor(cc.c3b(0xff, 0x15, 0x15))
        else
            self.cost_txt:setTextColor(cc.c3b(0x7c, 0x55, 0x36))
        end
        self.cost_txt:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(need_num))
    else
        _controller:openHeroProsRebirthPanel(false)
    end
end
function HeroProsRebirthPanel:close_callback(  )    
    if self.hero_pros_item_event then
        GlobalEvent:getInstance():UnBind(self.hero_pros_item_event)
        self.hero_pros_item_event = nil
    end
    _controller:openHeroProsRebirthPanel(false)
end