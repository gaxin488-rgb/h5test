function HolyequipmentUpStarPanel:register_event(  )
    registerButtonEventListener(self.background, function () self:onClickCloseBtn() end, false, 2)
    registerButtonEventListener(self.tip_background, function () 
        self:lookDetails(false)
    end, false, 2)
    registerButtonEventListener(self.close_btn, function () self:onClickCloseBtn() end, true, 2)
    registerButtonEventListener(self.refine_btn, function () 
        controller:openHolyequipmentRefreshAttPanel(true, self.data, self.partner_id)
    end, true, 2)
    registerButtonEventListener(self.fin_refine_btn, function () 
        controller:openHolyequipmentRefreshAttPanel(true, self.data, self.partner_id)
    end, true, 2)
	registerButtonEventListener(self.explain_btn, function ( param, sender)
		local desc= Config.PartnerHolyEqmData.data_const["starup_desc"].desc
        if desc then
            TipsManager:getInstance():showCommonTips(desc, sender:getTouchBeganPosition())
        end
    end,true,2)
    registerButtonEventListener(self.up_star_btn, function () 
        local num = model:canUpStar(self.data,self.item_config)
        if num[1] == 2 then
            message(string.format(TI18N("语言_c_5868"),num[2]))
            return
        elseif num[1] == 3 then
            message(string.format(TI18N("语言_c_5869"),num[2]))
            return
        end
        local data = Config.PartnerHolyEqmData.data_step_info(self.data.base_id)
        if data and data.step_price then
            for key, value in pairs(data.step_price) do
                local need_id = value[1]
                local need_num = value[2]
                local have_num = BackpackController:getInstance():getModel():getItemNumByBid(need_id)
                if have_num < need_num then
                    local item_config = Config.ItemData.data_get_data(need_id)
                    BackpackController:getInstance():openTipsSource(true, item_config)
                    return
                end
            end
        end

        if data and data.eq_cost and next(data.eq_cost) then
            for key, value in pairs(data.eq_cost) do
                local num = value[3]
                if tableLen(self.select_data) < num then
                    message(TI18N("语言_c_3021"))
                    return
                end
            end
        end

        local function call_back()
            self.up_star_btn:setTouchEnabled(false)
            local function func()
                local list = {}
                for k, v in pairs(self.select_data) do
                    local _list = {}
                    _list.id = v.id
                    table.insert(list, _list)
                end
                controller:sender11085(self.data.id, self.partner_id or 0,list)
                self.up_star_btn:setTouchEnabled(true)
                self.select_data = {}
                self:setSelectHolyItem()
            end
            self.is_selected = nil
            self.is_tab_touch = nil
            self:releaseCompositeEffect()
            AudioManager:getInstance():playEffect(AudioManager.AUDIO_TYPE.COMMON, "c_equipment_forging")
            playEffectOnce(PathTool.getEffectRes(269), 326, 117, self.top_panel,func, nil, nil, nil, PlayerAction.action, 1,nil,2)
            -- CommonAlert:close()
        end
        if self.isCanUp then
            if self.data.holy_eqm_attr and self.next_cfg.eqm_star then
                for key, value in pairs(self.data.holy_eqm_attr) do
                    if value.pos > 100 then
                        local txt = string.format(TI18N("语言_c_6043"),self.next_cfg.eqm_star)
                        CommonAlert.show(txt, TI18N("语言_c_63"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich,nil,
                        {timer = 3, timer_for = true, off_y = 0, title = TI18N("语言_c_154")},24)
                        return
                    end
                end
            end
            if self.next_cfg and self.next_cfg.eqm_star then
                local txt = string.format(TI18N("语言_c_6036"),self.next_cfg.eqm_star,self.next_cfg.eqm_star)
                CommonAlert.show(txt, TI18N("语言_c_63"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich,nil,
                {timer = 3, timer_for = true, off_y = 0, title = TI18N("语言_c_154")},24)
            end
        else
            if self.data.holy_eqm_attr then
                for key, value in pairs(self.data.holy_eqm_attr) do
                    if value.pos > 100 then
                        CommonAlert.show(TI18N("语言_c_6042"), TI18N("语言_c_63"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich,nil,
                        {timer = 3, timer_for = true, off_y = 0, title = TI18N("语言_c_154")},24)
                        return
                    end
                end
            end
                call_back()
        end
    end, true, 2)
    -- 道具数量更新
    self:addGlobalEvent(BackpackEvent.ADD_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.DELETE_GOODS,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
    end)
    self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM,function(bag_code, data_list)
        self:refreshExchangeItemNum(bag_code,data_list)
        if bag_code == 3 then
            for key, value in pairs(data_list) do
               if value.id == self.data.id then
                    self.data = value
                    self:setData()
               end
            end
        end
    end)
    if self.role_vo then
        if self.role_update_lev_event == nil then
            self.role_update_lev_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE,function(key,value)
                if key == "coin" then
                    self:setCostPanel()
                end
            end)
        end
    end
    if self.hero_holy_equipment_update_event == nil then
        self.hero_holy_equipment_update_event = GlobalEvent:getInstance():Bind(HeroEvent.Holy_Equipment_Update_Event, function(hero_vo)
            if not hero_vo or not self.data then return end
            if hero_vo.partner_id == self.partner_id then
                self:setData()
            end
        end)
    end
    if self.hero_holy_equipment_select_event == nil then
        self.hero_holy_equipment_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Holy_Equipment_Select_Event, function(list)
            if not list or not self.data then return end
            self.select_data = list or {}
            self:setSelectHolyItem()
        end)
    end
end
function HolyequipmentUpStarPanel:releaseCompositeEffect()
	if self.composite_effect ~= nil then
        GlobalTimeTicket:getInstance():remove(self.composite_effect)
        self.composite_effect = nil
    end
end
function HolyequipmentUpStarPanel:refreshExchangeItemNum( bag_code, data_list )
	if bag_code == BackPackConst.Bag_Code.BACKPACK then
		local data = Config.PartnerHolyEqmData.data_step_info(self.data.base_id)
		if data and data.step_price then
            for key, value in pairs(data.step_price) do
                local need_id = value[1]
                for i,v in pairs(data_list) do 
                    if v and v.base_id and need_id == v.base_id then 
                        self:setCostPanel()
                    end
                end
            end
		end
	end
end
function HolyequipmentUpStarPanel:onClickCloseBtn()
    controller:openHolyequipmentUpStarPanel(false)
end

--@ data 结构: goodsvo  
function HolyequipmentUpStarPanel:openRootWnd( data, partner_id )
    self.data = data
    self.partner_id = partner_id
    self:setData()
end

function HolyequipmentUpStarPanel:setData()
    local item_config = nil
    if type(self.data) == "number" then
        item_config = Config.ItemData.data_get_data(self.data)
    else
        if self.data.config then
            item_config = self.data.config
        else
            if self.data.bid then
                item_config = Config.ItemData.data_get_data(self.data.bid)
            elseif self.data.id then
                item_config = Config.ItemData.data_get_data(self.data.id)
            else
                item_config = self.data
            end
        end
    end
    self.item_config = item_config

    self.now_id = self.data.base_id
    self.equ_cfg = Config.PartnerHolyEqmData.data_step_info(self.now_id)
    if self.equ_cfg then
        self.next_id = self.equ_cfg.next_id
    end
    self.now_cfg = Config.ItemData.data_get_data(self.now_id)

    local nohideIds2 = RoleController:getInstance():getModel():getSeverShowIds("partner_holy_eqm_data")
    local cfg = Config.PartnerHolyEqmData.data_step_info(self.next_id)

    if self.next_id and self.next_id ~= 0 and RoleController:getInstance():getRoleVo().lev >= Config.PartnerHolyEqmData.data_const["open_lev_star_up"].val and cfg and (cfg.isshow == 1 or (cfg.isshow == 0 and table.indexof(nohideIds2,self.next_id))) then
        self.next_cfg = Config.ItemData.data_get_data(self.next_id)
        if self.now_cfg.eqm_star ~= self.next_cfg.eqm_star then
            self.isCanUp = true
        else
            self.isCanUp = false
        end
        self.next_equ_cfg = Config.PartnerHolyEqmData.data_step_info(self.next_id)
        self.up_star_panel:setVisible(true)
        self.finish_panel:setVisible(false)
        for key, value in pairs(self.base_left_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.base_left_panel) then
                self.base_left_panel:removeChild(value)
            end
            value = nil
        end
        self.base_left_list = {}
        for key, value in pairs(self.base_right_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.base_right_panel) then
                self.base_right_panel:removeChild(value)
            end
            value = nil
        end
        self.base_right_list = {}
        for key, value in pairs(self.rand_left_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.random_left_panel) then
                self.random_left_panel:removeChild(value)
            end
            value = nil
        end
        self.rand_left_list = {}
        for key, value in pairs(self.rand_right_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.random_right_panel) then
                self.random_right_panel:removeChild(value)
            end
            value = nil
        end
        self.rand_right_list = {}
        if self.now_cfg and self.next_cfg then
            self:setUpPanel()
        end
    else
        for key, value in pairs(self.fin_base_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.fin_base_panel) then
                self.fin_base_panel:removeChild(value)
            end
            value = nil
        end
        for key, value in pairs(self.fin_rand_list) do
            if value and not tolua.isnull(value) and not tolua.isnull(self.fin_random_panel) then
                self.fin_random_panel:removeChild(value)
            end
            value = nil
        end
        self.up_star_panel:setVisible(false)
        self.finish_panel:setVisible(true)
        self:setFinishPanel()
    end
end
--完成升星面板
function HolyequipmentUpStarPanel:setFinishPanel()
    self.add_h = 0
    self.fin_name_left_txt:setString(self.now_cfg.name)
    self.fin_item_left_bg_bottom:setContentSize(cc.size(self.fin_name_left_txt:getContentSize().width + 70,51))
    self.fin_item = BackPackItem.new(false, false, false)
    self.fin_item:setPositionY(15)
    self.fin_pos_left_item:addChild(self.fin_item)
    self.fin_item:setData(self.now_cfg)
    self.fin_base_txt:setString(TI18N("语言_c_1282"))
    --基础属性
    if #self.now_cfg.ext[1][2] > 4 then
        local num = math.ceil((#self.now_cfg.ext[1][2] - 4)/2)
        self.add_h = self.add_h + num * 55
        self.fin_base_panel:setContentSize(cc.size(652, self.fin_base_panel_height + self.add_h))
        self.fin_base_bg:setContentSize(cc.size(652, self.fin_base_panel_height))
        self.fin_base_txt:setPositionY(self.fin_base_txt:getPositionY() + self.add_h)
    end
    for key, value in pairs(self.now_cfg.ext[1][2]) do
        local item = self:createBaseItem(value,false)
        if item then
            self.fin_base_panel:addChild(item)
            local _y = self.fin_base_panel_height - 70 - (math.ceil(key/2) - 1) * 55
            local _x = 400 - key%2 * 350
            item:setPosition(cc.p(_x,_y))
            table.insert(self.fin_base_list,key,item)
        end
    end
    self.fin_random_txt:setString(TI18N("语言_c_2942"))
    local rand_list = deepCopy(self.data.holy_eqm_attr)
    table.sort(rand_list,function(a,b) return a.pos<b.pos end)
    local rand_num = #rand_list
    if rand_num > 6 then
        local num = math.ceil((rand_num - 6)/2) * 60
        self.add_h = self.add_h + num
        self.fin_random_panel:setContentSize(cc.size(652, self.fin_random_panel_height + num))
        self.fin_random_bg:setContentSize(cc.size(652, self.fin_random_panel_height))
        self.fin_random_txt:setPositionY(self.fin_random_bg:getContentSize().height - 15)
    end
    for key, value in pairs(rand_list) do
        if value.pos < 100 then
            local item = self:createRandItem(value,self.now_id,false)
            if item then
                self.fin_random_panel:addChild(item)
                local _y = self.fin_random_panel_height - 80 - (math.ceil(key/2) - 1) * 60
                local _x = 400 - key%2 * 350
                item:setPosition(cc.p(_x,_y))
                table.insert(self.fin_rand_list,item)
            end
        end
    end
    self.main_container:setContentSize(cc.size(652,self.main_container_height + self.add_h))
    self.image_bg:setContentSize(cc.size(672,self.main_container_height))
    self.finish_panel:setContentSize(cc.size(652,self.finish_panel_height + self.add_h))
    self.fin_top_panel:setPositionY(self.finish_panel_height - 8)
    self.fin_attributes_panel:setContentSize(cc.size(652,self.fin_attributes_panel_height + self.add_h))
    self.fin_base_panel:setPositionY(self.fin_attributes_panel_height)
    self.title_panel:setPositionY(self.main_container_height-5)
end
function HolyequipmentUpStarPanel:lookDetails(status)
    if status then
        self.tip_background:setVisible(true)
        self.tip_panel:setVisible(true)
        local suitattr_height = 0
        local need_show_skill = nil
        suitattr_height, need_show_skill = self:setSuitAttrInfo()
        if need_show_skill ~= nil then
            self.skill_panel:setVisible(true)
            local config = Config.SkillData.data_get_skill(need_show_skill)
            if config then
                suitattr_height = suitattr_height + self.skill_panel_height
                if self.skill_item == nil then
                    self.skill_item = self:createSkillItem(self.skill_panel)
                end
                self.skill_item.skill:showLockIcon(false)
                self.skill_item.skill:setData(config)
                self.skill_item.desc:setString(transformTextToShort(config.des, 50))
                addEvt2showAllTextTips(self.skill_item.desc,config.des,50,nil,nil,nil,true,true)
            else
                need_show_skill = false
            end
        else
            self.skill_panel:setVisible(false)
        end
        self.tip_panel:setContentSize(cc.size(413,suitattr_height + self.suitattr_name:getContentSize().height + 20))
        self.suitattr_name:setPositionY(self.tip_panel:getContentSize().height - 10)
        self.suitattr_panel:setPositionY(self.suitattr_name:getPositionY() - self.suitattr_name:getContentSize().height)
    else
        self.tip_background:setVisible(false)
        self.tip_panel:setVisible(false)
    end
end
--==============================--
--desc:创建技能显示单例
--==============================--
function HolyequipmentUpStarPanel:createSkillItem(parent)
    local item = {}
    local skill = SkillItem.new(true,true,true,0.8)
    parent:addChild(skill)
    skill:setPosition(70, 62)
    local desc = createRichLabel(18,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(138, 105),4,nil,260)
    parent:addChild(desc)
    item.skill = skill
    item.desc = desc
    return item
end
--升星面板
function HolyequipmentUpStarPanel:setUpPanel()
    if self.now_cfg.eqm_star ~= self.next_cfg.eqm_star then
        self.add_h = 40
        self.rand_y = 40
        if not self.suit_tip then
            self.suit_tip = createRichLabel(24,cc.c4b(0x5c,0x27,0x05,0xff),cc.p(0.5,0),cc.p(326,-18),-6,nil,600)
            self.attributes_panel:addChild(self.suit_tip)
        end
        local str = TI18N("语言_c_5867")
        self.suit_tip:setString(str)
        local function clickLinkCallBack( _type, value )
            if _type == "href" then
                self:lookDetails(true)
            end
        end
        self.suit_tip:addTouchLinkListener(clickLinkCallBack,{"href"})
    else
        self.add_h = 0
        self.rand_y = 0
        if self.suit_tip and not tolua.isnull(self.suit_tip)  then
            self.attributes_panel:removeChild(self.suit_tip)
            self.suit_tip = nil
        end
    end
    self.name_left_txt:setString(self.now_cfg.name)
    self.item_left_bg_bottom:setContentSize(cc.size(self.name_left_txt:getContentSize().width + 70,51))
    self.name_right_txt:setString(self.next_cfg.name)
    self.item_right_bg_bottom:setContentSize(cc.size(self.name_right_txt:getContentSize().width + 70,51))
    if not self.now_item then
        self.now_item = BackPackItem.new(false, false, false)
        self.now_item:setPositionY(15)
        self.pos_left_item:addChild(self.now_item)
    end
    self.now_item:setData(self.now_cfg)
    if not self.next_item then
        self.next_item = BackPackItem.new(false, false, false)
        self.next_item:setPositionY(15)
        self.pos_right_item:addChild(self.next_item)
    end
    self.next_item:setData(self.next_cfg)
    self.base_left_txt:setString(TI18N("语言_c_1282"))
    self.base_right_txt:setString(TI18N("语言_c_1282"))
    --基础属性
    local add_height = 0
    if math.max(#self.now_cfg.ext[1][2], #self.next_cfg.ext[1][2]) > 3 then
        local num = math.max(#self.now_cfg.ext[1][2], #self.next_cfg.ext[1][2]) - 3
        add_height = num * 40
        self.add_h = self.add_h + add_height
        self.base_left_panel:setContentSize(cc.size(305, self.base_left_panel_height + add_height))
        self.base_left_bg:setContentSize(cc.size(305, self.base_left_panel_height + add_height))
        self.base_left_txt:setPositionY(143 + add_height)
        self.base_right_panel:setContentSize(cc.size(305, self.base_right_panel_height + add_height))
        self.base_right_bg:setContentSize(cc.size(305, self.base_right_panel_height + add_height))
        self.base_right_txt:setPositionY(143 + add_height)
        self.base_panel:setContentSize(cc.size(652,self.base_panel_height + add_height))
    end
    self.random_panel:setPositionY(self.rand_y)
    for key, value in pairs(self.now_cfg.ext[1][2]) do
        local item = self:createBaseItem(value,false)
        if item then
            self.base_left_panel:addChild(item)
            local _y = self.base_left_panel_height + add_height - 60 - (key - 1) * 40
            item:setPosition(cc.p(20,_y))
            table.insert(self.base_left_list,key,item)
        end
    end
    for key, value in pairs(self.next_cfg.ext[1][2]) do
        local have_up = false
        if self.now_cfg.ext[1][2][key] then
            local now_value = self.now_cfg.ext[1][2][key]
            if value[1] == now_value[1] and value[2] > now_value[2] then
                have_up = true
            end
        end
        local item = self:createBaseItem(value,have_up)
        if item then
            self.base_right_panel:addChild(item)
            local _y = self.base_right_panel_height + add_height - 60 - (key - 1) * 40
            item:setPosition(cc.p(20,_y))
            if self.next_equ_cfg.is_base >= 1 and key > (#self.next_cfg.ext[1][2] - self.next_equ_cfg.is_base) then
                local _x = item:getContentSize().width + 30
                if self.base_new_x > 0 then
                    _x = self.base_new_x + 5
                end
                self:createBaseNewItem(true,_x,_y-10,self.base_right_panel)
            else
                self:createBaseNewItem(false)
            end
            table.insert(self.base_right_list,key,item)
        end
    end
    if self.isCanUp then
        self.random_left_txt:setString(TI18N("语言_c_5979"))
        self.random_right_txt:setString(TI18N("语言_c_5979"))
    else
        self.random_left_txt:setString(TI18N("语言_c_2942"))
        self.random_right_txt:setString(TI18N("语言_c_2942"))
    end
    local rand_list = deepCopy(self.data.holy_eqm_attr)
    table.sort(rand_list,function(a,b) return a.pos<b.pos end)
    local rand_num = 0
    for key, value in pairs(rand_list) do
        if value.pos < 100 then
            rand_num = rand_num + 1
        end
    end
    if self.next_equ_cfg and self.next_equ_cfg.is_rand > 0 then
        rand_num = rand_num + 1
    end
    local num = 0
    if rand_num > 4 and not self.isCanUp then
        num = (rand_num - 4) * 50
        self.add_h = self.add_h + num
        self.random_left_panel:setContentSize(cc.size(305, self.random_left_panel_height + num))
        self.random_left_bg:setContentSize(cc.size(305, self.random_left_panel_height + num))
        self.random_left_txt:setPositionY(222 + num)
        self.random_right_panel:setContentSize(cc.size(305, self.random_right_panel_height + num))
        self.random_right_bg:setContentSize(cc.size(305, self.random_right_panel_height + num))
        self.random_right_txt:setPositionY(222 + num)
    end
    if not self.isCanUp then
        if self.left_suit then
            self.left_suit:setVisible(false)
        end
        if self.right_suit then
            self.right_suit:setVisible(false)
        end
        for key, value in pairs(rand_list) do
            if value.pos < 100 then
                local item = self:createRandItem(value,self.now_id,false)
                if item then
                    self.random_left_panel:addChild(item)
                    local _y = self.random_left_panel_height + num - 60 - (key - 1) * 50
                    item:setPosition(cc.p(20,_y))
                end
                table.insert(self.rand_left_list,key,item)
            end
        end
        for key, value in pairs(rand_list) do
            if value.pos < 100 then
                local item = self:createRandItem(value,self.next_id,true,self.now_id)
                if item then
                    self.random_right_panel:addChild(item)
                    local _y = self.random_right_panel_height + num - 60 - (key - 1) * 50
                    item:setPosition(cc.p(20,_y))                
                    table.insert(self.rand_right_list,key,item)
                end
            end
        end
    else
        if self.left_suit then
            self.left_suit:removeFromParent()
            self.left_suit = nil
        end
        if not self.left_suit then
            self.left_suit = self:createSuitItem(self.now_cfg,false)
            self.random_left_panel:addChild(self.left_suit)
            self.left_suit:setPosition(cc.p(0,0))
        else
            self.left_suit:setVisible(true)
        end
        if self.right_suit then
            self.right_suit:removeFromParent()
            self.right_suit = nil
        end
        if not self.right_suit then
            self.right_suit = self:createSuitItem(self.next_cfg,true,self.now_cfg)
            self.random_right_panel:addChild(self.right_suit)
            self.right_suit:setPosition(cc.p(0,0))
        else
            self.right_suit:setVisible(true)
        end
    end
    if self.next_equ_cfg and self.next_equ_cfg.is_rand > 0 then
        if not self.rand_str then
            self.rand_str = createRichLabel(24, cc.c4b(0x4e,0x1e,0x0e,0xff), cc.p(0, 0.5), cc.p(20, 28), nil, nil, 180)
            self.random_right_panel:addChild(self.rand_str)
        end
        self.rand_str:setVisible(true)
        local _y = self.random_right_panel_height + num - 60 - #self.rand_right_list * 50
        self.rand_str:setPosition(cc.p(40,_y))
        self.rand_str:setString(TI18N("语言_c_2942"))
        self:createRandNewItem(true,self.rand_str:getContentSize().width + 40,_y,self.random_right_panel)
    else
        self:createRandNewItem(false)
        if not tolua.isnull(self.rand_str) then
            self.rand_str:setVisible(false)
            self.rand_str:removeFromParent()
            self.rand_str = nil
        end
    end
    local cfg = Config.PartnerHolyEqmData.data_step_info(self.data.base_id)
    if cfg and cfg.reset_times and cfg.reset_times ~= 0 then
        local count = 0
        for k,v in pairs(self.data.extra) do
            if v.extra_k == 10 then
                count = v.extra_v
            end
        end
        if count >= cfg.reset_times then
            self.refine_txt:setString(string.format(TI18N("语言_c_6567"),cfg.reset_times,count,cfg.reset_times))
        else
            self.refine_txt:setString(string.format(TI18N("语言_c_6566"),cfg.reset_times,count,cfg.reset_times))
        end
        self.add_h = self.add_h + self.refine_txt:getContentSize().height
        if self.suit_tip then
            self.suit_tip:setPositionY(self.refine_txt:getContentSize().height*0.5)
        end
        -- self.random_panel
    else
        self.refine_txt:setString("")
        self.add_h = self.add_h + 0
    end
    self.main_container:setContentSize(cc.size(652,self.main_container_height + self.add_h))
    self.image_bg:setContentSize(cc.size(672,self.main_container_height + self.add_h))
    self.up_star_panel:setContentSize(cc.size(652,self.up_star_panel_height + self.add_h))
    self.top_panel:setPositionY(self.up_star_panel_height + self.add_h - 8)
    self.attributes_panel:setContentSize(cc.size(652,self.attributes_panel_height + self.add_h))
    self.base_panel:setPositionY(self.attributes_panel_height + self.add_h)
    self.random_panel:setPositionY(self.attributes_panel_height + self.add_h-self.base_panel:getContentSize().height)
    self.title_panel:setPositionY(self.main_container_height  + self.add_h-5)
    self:setCostPanel()
end
--创建随机属性
function HolyequipmentUpStarPanel:createRandItem(rand_data,id,isright,now_id)
    local attr_key = ""
    local attr_name = ""
    if type(rand_data.attr_id) == "number" and rand_data.attr_id > 200 then
        attr_key = Config.AttrExtraData.data_id_to_key[rand_data.attr_id]
        attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
    else
        attr_key = Config.AttrData.data_id_to_key[rand_data.attr_id]
        attr_name = Config.AttrData.data_key_to_name[attr_key]
    end
    local attr_val = deepCopy(rand_data.attr_val)
    if attr_name then
        local item = ccui.Layout:create()
        item:setAnchorPoint(cc.p(0, 0.5))
        item:setContentSize(cc.size(200, 50))
        local icon = PathTool.getAttrIconByStr(attr_key)
        local res = PathTool.getResFrame("common", icon)
        local attr_icon = createSprite(res,0,30,item,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
        attr_icon:setScale(1.2)
        local label = createLabel(22,cc.c4b(0x4e,0x1e,0x0e,0xff),nil,40,28,"",item,nil,cc.p(0,0))
        local is_per = PartnerCalculate.isShowPerByStr(attr_key)
        if is_per == true then
            attr_val = (attr_val*0.1).."%"
        end
        local attr_str = string.format(" %s：", attr_name)
        label:setString(transformTextToShort(attr_str,15))
        addEvt2showAllTextTips(label,attr_str,15,false,false,false,false,true)

        local res = PathTool.getResFrame("common","common_90005")
        local res1 = PathTool.getResFrame("common","common_90006")
        local size = cc.size(160, 18)
        local bg,comp_bar = createLoadingBar(res, res1, size, item, cc.p(0,1), 40, 28, true, true)
        local quality = model:getHolyEquipmentQualityByItemIdAttrKey(id, attr_key, rand_data.attr_val)
        local res = PathTool.getBarQualityBg(quality)
        comp_bar:loadTexture(res,LOADTEXT_TYPE_PLIST)
        local max_count = model:getHolyEquipmentMaxAttrByItemIdAttrKey(id, attr_key)
        local per = rand_data.attr_val * 100/max_count
        comp_bar:setPercent(per)
        item.comp_bar_label = createLabel(18, cc.c3b(255,255,255), cc.c3b(0,0,0), size.width/2, size.height/2, "", comp_bar, 2, cc.p(0.5, 0.5))
        item.comp_bar_label:setString(attr_val)
        if isright then
            if now_id then
                local holy_equip_config = Config.PartnerHolyEqmData.data_base_info(id)
                local group_id = holy_equip_config.group_id
                local now_config = Config.PartnerHolyEqmData.data_base_info(now_id)
                local now_id = now_config.group_id
                if now_id ~= group_id then
                    item.comp_bar_label:setString(attr_val .. "+???")
                end
            end
        end
        item.comp_bar = comp_bar
        item.comp_bar_bg = bg
        return item
    end
    return false
end
--创建基础属性
function HolyequipmentUpStarPanel:createBaseItem(base_data,have_up)
    local attr_key = base_data[1]
    local attr_val = base_data[2]
    local attr_name = Config.AttrData.data_key_to_name[attr_key]
    if not attr_name then
        attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
    end
    if attr_name then
        local label = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 28), nil, nil, 380)
        local icon = PathTool.getAttrIconByStr(attr_key)
        local is_per = PartnerCalculate.isShowPerByStr(attr_key)
        if is_per == true then
            attr_val = (attr_val*0.1).."%"
        end
        local attr_str = string.format("<img src='%s' scale=1 /> <div fontcolor=#4e1e0e> %s：</div><div fontcolor=#009300>%s</div>", PathTool.getResFrame("common", icon), attr_name, attr_val)
        label:setString(attr_str)
        if have_up then
            local res = PathTool.getResFrame("common","common_zbjiantou")
            local up_img = createSprite(res,label:getContentSize().width+20,14,label,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
            self.base_new_x = label:getContentSize().width+20
        else
            self.base_new_x = 0
        end
        return label
    end
    return false
end
--创建 新属性 提示
function HolyequipmentUpStarPanel:createBaseNewItem(status,x,y,parent)
    if status then
		if not self.new_1 then
			self.new_1 = createLabel(22, cc.c3b(0xff,0xfd,0x9a), cc.c3b(0xc1,0x46,0x09), x, y, "", parent, 2, cc.p(0,0.5))
			self.new_1:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))
			self.new_1:setString(TI18N("语言_c_5196"))
			self.new_1:setZOrder(9999)
		end
		self.new_1:setPosition(cc.p(x,y + 10))
	else
		if self.new_1 then
            doStopAllActions(self.new_1)
            self.new_1:removeFromParent()
			self.new_1 = nil
		end
	end
end
--创建 新属性 提示
function HolyequipmentUpStarPanel:createRandNewItem(status,x,y,parent)
    if status then
		if not self.new then
			self.new = createLabel(22, cc.c3b(0xff,0xfd,0x9a), cc.c3b(0xc1,0x46,0x09), x, y, "", parent, 2, cc.p(0,0.5))
			self.new:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))
			self.new:setString(TI18N("语言_c_5196"))
			self.new:setZOrder(9999)
		end
		self.new:setPosition(cc.p(x,y + 10))
	else
		if self.new then
            doStopAllActions(self.new)
            self.new:removeFromParent()
			self.new = nil
		end
	end
end
function HolyequipmentUpStarPanel:setCostPanel()
    for k, v in pairs(self.cost_list) do
        v:setVisible(false)
    end
    local item_num = 0
    for i = 1, tableLen(self.equ_cfg.step_price) do
        local value = self.equ_cfg.step_price[i]
        local bid = value[1]
        local need_num = value[2]
        local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
        if i == 1 then
            local cfg = Config.ItemData.data_get_data(bid)
            self.cost_icon:loadTexture(PathTool.getItemRes(cfg.icon), LOADTEXT_TYPE)
            self.item_tip:setVisible(cfg.type == BackPackConst.item_type.HOLY_CHIP)
            local str = ""
            if have_num >= need_num then
                str = "<div fontcolor=#0ea80e>%s/%s</div>"
            else
                str = "<div fontcolor=#FF1515>%s/%s</div>"
            end
            self.cost_txt:setString(string.format(str,MoneyTool.GetMoneyString(have_num),MoneyTool.GetMoneyString(need_num)))
        else
            local index = 0
            if next(self.equ_cfg.eq_cost) then
                index = i
            else
                index = i - 1
            end
            local item = self.cost_list[index]
            item_num = item_num + 1
            item:setVisible(true)
            local cfg = Config.ItemData.data_get_data(bid)
            item.item:setData(cfg)
            item.item:setOptionalHoly()
            local callback = function()
                TipsManager:getInstance():showGoodsTips(cfg)
            end
            item.item:addCallBack(callback)
            local str = ""
            if have_num >= need_num then
                str = "<div fontcolor=#0ea80e>%s/%s</div>"
            else
                str = "<div fontcolor=#FF1515>%s/%s</div>"
            end
            item.txt:setString(string.format(str,MoneyTool.GetMoneyString(have_num),MoneyTool.GetMoneyString(need_num)))
        end
    end
    local num = self:setSelectHolyItem()
    item_num = item_num + num
    local pos_list = {
        [1]={[1] = 293 ,[2] = 293,[3] = 440},
        [2]={[1] = 205 ,[2] = 381,[3] = 440},
        [3]={[1] = 146 ,[2] = 293,[3] = 440},
    }
    for i = 1, tableLen(self.cost_list) do
        self.cost_list[i]:setPositionX(pos_list[item_num][i])
    end
end
function HolyequipmentUpStarPanel:setSelectHolyItem()
    local num = 0
    for i = 1, tableLen(self.equ_cfg.eq_cost) do
        num = num + 1
        local list = self.equ_cfg.eq_cost[i]
        local item = self.cost_list[i]
        item:setVisible(true)
        item.item:setOptionalHoly(list)
        local num = tableLen(self.select_data) or 0
        local str = ""
        if num >= list[3] then
            str = "<div fontcolor=#0ea80e>%s/%s</div>"
        else
            str = "<div fontcolor=#FF1515>%s/%s</div>"
        end
        item.txt:setString(string.format(str,num,list[3]))
        local back = function()
            local setting = {}
            setting.target = list --目标
            setting.select_data = self.select_data --已经选择的
            controller:openHeroHolyUpgradeStarSelectPanel(true,setting)
        end
        item.item:addCallBack(back)
        if num < list[3] then
            setChildUnEnabled(true,item.item.item_icon)
        else
            setChildUnEnabled(false,item.item.item_icon)
        end
    end
    return num
end
--套装属性
function HolyequipmentUpStarPanel:createSuitItem(cfg,have_up,now_cfg)
    local suit_config = Config.PartnerHolyEqmData.data_suit_info[cfg.eqm_set]
    if not suit_config then return -1 end
    if not cfg then return -1 end
    local have_up_list = {}
    local have_up = have_up or false
    
    local item = ccui.Layout:create()
    item:setAnchorPoint(cc.p(0, 0))
    item:setContentSize(cc.size(305, 200))
    
    --套装列表
    local suit_list = {}
    
    for i,v in ipairs(suit_config) do

        if v.skill_id and next(v.skill_id) ~= nil then
            local suit = {}
            suit.count = v.num
            if cfg.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --神装
                local eqm_set = nil
                suit.attr = v.skill_id[#v.skill_id]
                eqm_set = v.id
                if v.all_skill_desc then
                    suit.skill_desc = v.all_skill_desc[#v.all_skill_desc] --神装套装描述 
                end
                local star = eqm_set%100
                suit.suit_name = string.format(TI18N("语言_c_3055"), star)
            end
            
            table.insert(suit_list, suit)
        end
    end
    table.sort(suit_list,function(a,b)
        return a.count < b.count
    end)
    --套装列表
    local now_suit_list = {}
    if have_up and now_cfg then
        local now_suit_config = Config.PartnerHolyEqmData.data_suit_info[now_cfg.eqm_set]
        for i,v in ipairs(now_suit_config) do
            if v.skill_id and next(v.skill_id) ~= nil then
                local suit = {}
                suit.count = v.num
                if cfg.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --神装
                    local eqm_set = nil
                    suit.attr = v.skill_id[#v.skill_id]
                    eqm_set = v.id
                    if v.all_skill_desc then
                        suit.skill_desc = v.all_skill_desc[#v.all_skill_desc] --神装套装描述 
                    end
                    local star = eqm_set%100
                    suit.suit_name = string.format(TI18N("语言_c_3055"), star)
                end
                
                table.insert(now_suit_list, suit)
            end
        end
        table.sort(now_suit_list,function(a,b)
            return a.count < b.count
        end)
    end
    for k, v in pairs(suit_list) do
        have_up_list[v.count] = have_up
        for key, value in pairs(now_suit_list) do
            if v.count == value.count then
                if type(v.attr) == "table" then
                    if v.attr[1] == value.attr[1] and v.attr[2] == value.attr[2] then
                        have_up_list[v.count] = false
                    end
                else
                    have_up_list[v.count] = v.attr ~= value.attr
                end
            end
        end
    end
    local show_skill_id = nil --是否有显示技能id
    for i,suit in ipairs(suit_list) do
        local type_str = type(suit.attr)
        local suit_txt = createRichLabel(22, cc.c3b(0x7c,0x55,0x36), cc.p(0,0), cc.p(20,0), -10, nil, 380)
        item:addChild(suit_txt)
        if i == 1 then
            suit_txt:setPositionY(175)
        elseif i == 2 then
            suit_txt:setPositionY(110)
        end
        local act_str = string.format("%s(%s)", suit.suit_name, suit.count)
        suit_txt:setString(act_str)
        if type_str == "table" then
            --说明是属性
            local attr_item = self:createBaseItem(suit.attr,have_up_list[suit.count])
            item:addChild(attr_item)
            if i == 1 then
                attr_item:setPosition(20,155)
            elseif i == 2 then
                attr_item:setPosition(20,90)
            end
        elseif type_str == "number" then
            if suit.skill_desc then
                if suit.skill_desc[1] and suit.skill_desc[1] == 2 then
                    show_skill_id = suit.attr
                else
                    local attr_name 
                    if suit.skill_desc then
                        attr_name = suit.skill_desc[2] or TI18N("语言_c_3058")
                        if suit.skill_desc[1] and suit.skill_desc[1] == 2 then
                            show_skill_id = suit.attr
                        end
                    else
                        attr_name = TI18N("语言_c_3058")
                    end
                    local icon = PathTool.getAttrIconByStr("skill")
                    local attr_str = string_format("<img src='%s' scale=1 /><div fontcolor=#4e1e0e> %s</div>", PathTool.getResFrame("common", icon), attr_name)
                    local label = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 1), cc.p(20, 100), 0, nil, 230)
                    label:setString(attr_str)   
                    if have_up_list[suit.count] then
                        local res = PathTool.getResFrame("common","common_zbjiantou")
                        local up_img = createSprite(res,label:getContentSize().width+20,14,label,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
                    end
                    item:addChild(label)
                end
            end
            if show_skill_id ~= nil then
                self.skill_panel:setVisible(true)
                local config = Config.SkillData.data_get_skill(show_skill_id)
                if config then
                    local skill_item = self:createSkillItem(item)
                    skill_item.skill:showLockIcon(false)
                    skill_item.skill:setData(config)
                    skill_item.desc:setString("")
                    skill_item.skill:setAnchorPoint(cc.p(0,0))
                    skill_item.skill:setPosition(cc.p(20,10))
                    if have_up_list[suit.count] then
                        local res = PathTool.getResFrame("common","common_zbjiantou")
                        local up_img = createSprite(res,130,80,item,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
                    end
                end
            end
        end
    end
    return item
end
--套装详情
function HolyequipmentUpStarPanel:setSuitAttrInfo()
    self.suit_config = Config.PartnerHolyEqmData.data_suit_info[self.next_cfg.eqm_set]
    if not self.suit_config then return -1 end
    if not self.next_cfg then return -1 end

    -- [4005] = {id=4005, name="@冒险套装", add_attr1={{'atk',100}}, add_attr2={{'def',100}}, add_attr3={{'speed',10}}},
    --计算激活数量 (只有穿带才可能激活)

    --套装列表
    local suit_list = {}
    local max_config = self.suit_config[#self.suit_config]
    local max_count = max_config.num
    local name = nil
    
    for i,v in ipairs(self.suit_config) do
        if name == nil then
            name = v.name
        end

        if v.skill_id and next(v.skill_id) ~= nil then
            local suit = {}
            suit.count = v.num
            if self.next_cfg.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --神装
                local eqm_set = nil
                suit.attr = v.skill_id[#v.skill_id]
                eqm_set = v.id
                if v.all_skill_desc then
                    suit.skill_desc = v.all_skill_desc[#v.all_skill_desc] --神装套装描述 
                end
                local star = eqm_set%100
                suit.suit_name = string.format(TI18N("语言_c_3055"), star)
            end
            
            table.insert(suit_list, suit)
        end
    end
    table.sort(suit_list,function(a,b)
        return a.count < b.count
    end)
    local count = #suit_list
    --神装名字特殊显示
    if self.next_cfg.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --神装 
        local eqm_key = math.floor(self.next_cfg.eqm_set/100)
        local res_config = Config.PartnerHolyEqmData.data_suit_res_prefix[eqm_key]
        name = res_config.name
        local tips = TI18N("语言_c_3056")
        local str = string.format("%s(%s)", name, tips)
        self.suitattr_name:setString(str)
    end

    local show_skill_id = nil --是否有显示技能id
    for i,suit in ipairs(suit_list) do
        if self.suit_item_list[i] == nil then
            self.suit_item_list[i] = self:createattrItem(i, self.suitattr_panel,#suit_list)
        end
        
        local type_str = type(suit.attr)
        local attr_color = "c1b7ab"
        local val_color = "ffeedd"
        if type_str == "table" then
            --说明是属性
            local attr_key = suit.attr[1]
            local attr_val = suit.attr[2]
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            if not attr_name then
                attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
            end
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val*0.1).."%"
            end
            local icon = PathTool.getAttrIconByStr(attr_key)
            local attr_str = string.format("<img src='%s' scale=1 /> <div fontcolor=#%s> %s：</div><div fontcolor=#%s>%s</div>", PathTool.getResFrame("common", icon), attr_color, attr_name, val_color, attr_val)
            self.suit_item_list[i].attr:setString(attr_str)
        elseif type_str == "number" then
            local attr_name 
            if suit.skill_desc then
                attr_name = suit.skill_desc[2] or TI18N("语言_c_3058")
                if suit.skill_desc[1] and suit.skill_desc[1] == 2 then
                    show_skill_id = suit.attr
                end
            else
                attr_name = TI18N("语言_c_3058")
            end
            local icon = PathTool.getAttrIconByStr("skill")
            local attr_str = string.format("<img src='%s' scale=1 /><div fontcolor=#%s> %s</div>", PathTool.getResFrame("common", icon), attr_color, attr_name)
            self.suit_item_list[i].attr:setString(attr_str)    
        end
        if self.next_cfg.sub_type == BackPackConst.item_tab_type.HOLYEQUIPMENT then --神装 
            local act_str = string.format("<div fontcolor=#%s>%s(%s)</div>", val_color, suit.suit_name, suit.count)
            self.suit_item_list[i].act_info:setString(act_str)
        end
    end
    return 20 + count * 40, show_skill_id
end
function HolyequipmentUpStarPanel:createattrItem(index, parent,count)
    if not parent then return end
    local object = {}
    object.node = ccui.Layout:create()
    object.node:setAnchorPoint(cc.p(0, 0.5))
    object.node:setContentSize(cc.size(360, 28))
    object.node:setPosition(0, 26 + (count - index) * 40)
    parent:addChild(object.node)
    object.node:setTouchEnabled(true)
    object.attr = createRichLabel(20, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 14), -10, nil, 380)
    object.node:addChild(object.attr)
    object.act_info = createRichLabel(20, cc.c4b(0xff,0xee,0xdd,0xff), cc.p(1, 0.5), cc.p(380, 14), -10, nil, 380)
    object.node:addChild(object.act_info)
    return object
end
function HolyequipmentUpStarPanel:close_callback(  )
    if self.role_vo ~= nil then
        if self.role_update_lev_event ~= nil then
            self.role_vo:UnBind(self.role_update_lev_event)
            self.role_update_lev_event = nil
        end
        self.role_vo = nil
    end
    
    if self.hero_holy_equipment_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_holy_equipment_update_event)
        self.hero_holy_equipment_update_event = nil
    end
    if self.hero_holy_equipment_select_event then
        GlobalEvent:getInstance():UnBind(self.hero_holy_equipment_select_event)
        self.hero_holy_equipment_select_event = nil
    end
    self:createRandNewItem(false)
    self:createBaseNewItem(false)
    controller:openHolyequipmentUpStarPanel(false)
end
