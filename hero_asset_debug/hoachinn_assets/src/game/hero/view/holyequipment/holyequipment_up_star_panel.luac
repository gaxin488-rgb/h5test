function HolyequipmentUpStarPanel:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.layout_name = "hero/holyequipment_up_star_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("artifact", "artifact"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("common", "common_1"), type = ResourcesType.plist},
    }
    self.add_h = 0
    self.rand_y = 0
    self.base_new_x = 0
    self.cost_list = {}
    self.fin_base_list = {}
    self.fin_rand_list = {}
    self.base_left_list = {}
    self.base_right_list = {}
    self.rand_left_list = {}
    self.rand_right_list = {}
    self.suit_item_list = {}
    self.isCanUp = false
    self.select_data = {}

end

