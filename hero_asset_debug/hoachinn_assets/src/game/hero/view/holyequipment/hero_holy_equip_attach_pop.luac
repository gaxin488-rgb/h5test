HeroHolyEquipAttachPop = HeroHolyEquipAttachPop or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()

function HeroHolyEquipAttachPop:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_holy_equip_attach_pop"
    self.res_list = {
    }

    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.cloth_type = 1
end

function HeroHolyEquipAttachPop:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
        -- self.background:setSwallowTouches(false)
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.main_panel_size = self.main_panel:getContentSize()
    self.top_panel = self.main_panel:getChildByName("top_panel")
    self.top_panel_size = self.top_panel:getContentSize()
    self.spine_node = self.top_panel:getChildByName("spine_node")
    self.evt_effect = createEffectSpine("E90005", cc.p(0, 0), cc.p(0.5, 0.5), true, "action")
    self.spine_node:addChild(self.evt_effect)
    self.spine_node:setVisible(false)
    self.holy_icon = self.top_panel:getChildByName("holy_icon")
    self.hero_panel = self.top_panel:getChildByName("hero_panel")
    self.no_panel = self.hero_panel:getChildByName("no_panel")
    self.have_panel = self.hero_panel:getChildByName("have_panel")
    self.change_btn = self.hero_panel:getChildByName("change_btn")
    self.show_panel = self.top_panel:getChildByName("show_panel")
    self.show_tip = self.show_panel:getChildByName("show_tip")
    setTextMaxWidth(self.show_tip,550,-10)
    self.show_tip:setChangeScaleOffWidth(20)
    self.show_tip:setString(TI18N("语言_c_7449"))
    self.title_panel = self.main_panel:getChildByName("title_panel")
    self.close_btn = self.title_panel:getChildByName("close_btn")
    self.imgTitleBg = self.title_panel:getChildByName("imgTitleBg")
    self.title = self.title_panel:getChildByName("title")
    self.title:setString(TI18N("语言_c_7450"))
    autoSizeTitleBg(self.title,self.imgTitleBg,120,332)
    self.attr_panel = self.main_panel:getChildByName("attr_panel")
    self.attr_panel_size = self.attr_panel:getContentSize()
    self.attr_panel:setVisible(false)
    self.baseattr_panel = self.attr_panel:getChildByName("baseattr_panel")
    self.baseattr_panel_size = self.baseattr_panel:getContentSize()
    self.baseattr_line_1 = self.baseattr_panel:getChildByName("line_1")
    self.baseattr_line_2 = self.baseattr_panel:getChildByName("line_2")
    self.randattr_panel = self.attr_panel:getChildByName("randattr_panel")
    self.randattr_panel_size = self.baseattr_panel:getContentSize()
    self.randattr_line_1 = self.randattr_panel:getChildByName("line_1")
    self.randattr_line_2 = self.randattr_panel:getChildByName("line_2")
    self.suitattr_panel = self.attr_panel:getChildByName("suitattr_panel")
    self.suitattr_panel_size = self.baseattr_panel:getContentSize()
    self.suitattr_line_1 = self.suitattr_panel:getChildByName("line_1")
    self.suitattr_line_2 = self.suitattr_panel:getChildByName("line_2")
    self.no_panel = self.suitattr_panel:getChildByName("no_panel")
    self.no_tip = self.no_panel:getChildByName("no_tip")
    self.no_tip:setString(TI18N("语言_c_7451"))
    self.no_panel:setVisible(false)
    self.attachBtn = self.main_panel:getChildByName("attachBtn")
    self.attachBtn_y = self.attachBtn:getPositionY()
    self.attachLabel = self.attachBtn:getChildByName("attachLabel")
    self.attachLabel:setString(TI18N("语言_c_645"))
    self.succinctBtn = self.main_panel:getChildByName("succinctBtn")
    self.succinct_txt = self.succinctBtn:getChildByName("succinct_txt")
    setTextSpacing(self.succinct_txt,-8)
    self.succinct_txt:setChangeScaleOffWidth(10)
    self.succinct_txt:setString(TI18N("语言_c_7452"))
    self.up_star_btn = self.main_panel:getChildByName("up_star_btn")
    self.up_star_txt = self.up_star_btn:getChildByName("up_star_txt")
    setTextSpacing(self.up_star_txt,-8)
    self.up_star_txt:setChangeScaleOffWidth(10)
    self.up_star_txt:setString(TI18N("语言_c_7453"))
    self.remove_btn = self.main_panel:getChildByName("remove_btn")
    self.remove_txt = self.remove_btn:getChildByName("remove_txt")
    setTextSpacing(self.remove_txt,-8)
    self.remove_txt:setChangeScaleOffWidth(10)
    self.remove_txt:setString(TI18N("语言_c_2964"))
    self.no_attr_panel = self.main_panel:getChildByName("no_attr_panel")
    self.no_tip = self.no_attr_panel:getChildByName("no_tip")
    setTextMaxWidth(self.no_tip,500)
    self.no_tip:setString(TI18N("语言_c_7454"))
    self.no_attr_panel:setVisible(false)
    self.item_1 = self.root_wnd:getChildByName("item_1")
    self.item_2 = self.root_wnd:getChildByName("item_2")
    self.star_item = self.root_wnd:getChildByName("star")
end
function HeroHolyEquipAttachPop:register_event()
    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn() end ,true, 1) 
    registerButtonEventListener(self.background, function() self:onClickCloseBtn() end ,false, 0) 
    registerButtonEventListener(self.attachBtn, function() self:onClickCloseBtn() end ,true, 0) 
    registerButtonEventListener(self.succinctBtn, function() self:onClickSuccinctBtn() end ,true, 0) 
    registerButtonEventListener(self.up_star_btn, function() self:onClickUpStarBtn() end ,true, 0) 
    registerButtonEventListener(self.remove_btn, function() self:onClickRemoveBtn() end ,true, 0) 
    registerButtonEventListener(self.change_btn, function()
        controller:openHeroHolyEquipAttachSelectPop(true,self.partnerId,self.itemType)
    end ,true, 0) 
    registerButtonEventListener(self.hero_panel, function()
        controller:openHeroHolyEquipAttachSelectPop(true,self.partnerId,self.itemType)
    end ,true, 0) 
    self:addGlobalEvent(HeroEvent.Holy_Equipment_Update_Event, function(hero_vo)
        if not hero_vo or not self.partnerId then return end
        if hero_vo.partner_id == self.partnerId then
            self:updateData()
        end
    end)
end

--关闭
function HeroHolyEquipAttachPop:onClickCloseBtn()
    controller:openHeroHolyEquipAttachPop(false)
end
--洗练
function HeroHolyEquipAttachPop:onClickSuccinctBtn()
    controller:openHolyequipmentRefreshAttPanel(true, self.equip_attach_vo, self.partnerId)
end
--升星
function HeroHolyEquipAttachPop:onClickUpStarBtn()
    controller:openHolyequipmentUpStarPanel(true, self.equip_attach_vo, self.partnerId)
end
--卸下
function HeroHolyEquipAttachPop:onClickRemoveBtn()
    controller:sender11415(self.partnerId,self.equip_attach_vo.id,0)
end


function HeroHolyEquipAttachPop:openRootWnd(partnerId, itemType)
	if not partnerId or not itemType then
		return
	end
	self.partnerId = partnerId
	self.itemType = itemType
    self:updateShowPanel()
	self:updateData()
end
function HeroHolyEquipAttachPop:updateData()
	if self.partnerId and self.itemType then
		self.equip_vo = model:getHolyEquipByPartnerIdAndTp(self.partnerId, self.itemType)
        local cfg = Config.PartnerHolyEqmData.data_base_info(self.equip_vo.base_id)
        local res = PathTool.getPlistImgForDownLoad("hero/gold_eqm",cfg.show_img, false)
        loadSpriteTexture(self.holy_icon, res, LOADTEXT_TYPE)
		self.equip_attach_vo = model:getHolyAttachEquipByPartnerIdAndTp(self.partnerId, self.itemType)
        self.equip_list = model:getHeroHolyEquipList(self.partnerId)
        self.Attach_equip_list = model:getHeroHolyEquipAttachList(self.partnerId)
        self.all_equip_list = {}
        for k, v in pairs(self.equip_list) do
            table.insert(self.all_equip_list,v)
        end
        for k, v in pairs(self.Attach_equip_list or {}) do
            table.insert(self.all_equip_list,v)
        end
        if self.equip_attach_vo and next(self.equip_attach_vo) then
            self.base_cfg = Config.PartnerHolyEqmData.data_base_info(self.equip_attach_vo.base_id)
            self.rate_num = 0
            for i = 1, #self.show_list do
                if self.rate_cfg[i][1] == self.equip_attach_vo.eqm_star then
                    self.rate_num = self.rate_cfg[i][2]
                end
            end
            self.no_attr_panel:setVisible(false)
            self.attachBtn:setVisible(false)
            self.succinctBtn:setVisible(true)
            self.remove_btn:setVisible(true)
            self.attr_panel:setVisible(true)
            self.no_panel:setVisible(false)
            self.spine_node:setVisible(true)
            self.have_panel:setVisible(true)
            self.change_btn:setVisible(true)
            if not self.attach_item then
                self.attach_item = BackPackItem.new(true, true,false,1,true,true)
                self.attach_item:setPosition(cc.p(60,60))
                self.have_panel:addChild(self.attach_item)
            end
            self.attach_item:setData(self.equip_attach_vo)
            self:updatePage()
            local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
            local featuresId = MainuiConst.FeaturesShield.godOutfit
            local nohideIds2 = RoleController:getInstance():getModel():getSeverShowIds("partner_holy_eqm_data")
            local cfg = Config.PartnerHolyEqmData.data_step_info(self.item_config.id)
            if RoleController:getInstance():getRoleVo().lev >= Config.PartnerHolyEqmData.data_const["open_lev_star_up"].val and table.indexof(nohideIds,featuresId) and cfg and (cfg.isshow == 1 or (cfg.isshow == 0 and table.indexof(nohideIds2,cfg.next_id))) then
                self.up_star_btn:setVisible(true)
            else
                self.up_star_btn:setVisible(false)
            end
        else
            self.no_attr_panel:setVisible(true)
            self.attachBtn:setVisible(true)
            self.succinctBtn:setVisible(false)
            self.up_star_btn:setVisible(false)
            self.remove_btn:setVisible(false)
            self.attr_panel:setVisible(false)
            self.no_panel:setVisible(true)
            self.spine_node:setVisible(false)
            self.have_panel:setVisible(false)
            self.change_btn:setVisible(false)
            self.main_panel:setContentSize(cc.size(self.main_panel:getContentSize().width,830))
            self.top_panel:setPositionY(820)
            self.title_panel:setPositionY(824)
            self.no_attr_panel:setPositionY(114)
            self.attachBtn:setPositionY(64)
            self.attr_h = self.attr_panel_size.height
        end
        self.main_spacing_top = 10
        self.main_spacing_bottom = 114
        self.main_spacing_mid = 9
        self.main_title_spacing_top = 6
        self.main_h = self.main_spacing_top + self.main_spacing_bottom + self.main_spacing_mid + self.top_panel_size.height + self.attr_h
        -- self.main_h = math.max(self.main_panel_size.height,self.main_h)
        self.main_panel:setContentSize(cc.size(self.main_panel_size.width,self.main_h))

        self.top_panel:setPositionY(self.main_h - self.main_spacing_top)
        self.title_panel:setPositionY(self.main_h - self.main_title_spacing_top)
        self.no_attr_panel:setPositionY(self.main_spacing_bottom)
        self.attr_panel:setPositionY(self.main_spacing_bottom)
        self.attachBtn:setPositionY(self.attachBtn_y)
	end
end
function HeroHolyEquipAttachPop:updateShowPanel()
    self.rate_cfg = Config.PartnerHolyEqmData.data_const["star_rate"].val
    self.show_list = {}
    local start_x = 110
    local space_x = (482-110)/(#self.rate_cfg-1)
    for i=1,#self.rate_cfg do
        local star = self.star_item:clone()
        star.star_txt = star:getChildByName("star_txt")
        star.star_value = star:getChildByName("star_value")
        star.star_txt:setString(self.rate_cfg[i][1].." ")
        star.star_value:setString(self.rate_cfg[i][2].."%")
        table.insert(self.show_list,star)
        self.show_panel:addChild(star)
        star:setPosition(cc.p(start_x + (i-1)*space_x,22))
    end
end
function HeroHolyEquipAttachPop:updatePage()
    self.base_h = 0
    self.rand_h = 0
    self.suit_h = 0
    self.attr_spacing_top = 10
    self.attr_spacing_bottom = 10
    self:updateBasePanel()
    self:updateRandPanel()
    self:updateSuitPanel()

    self.attr_h = self.base_h + self.rand_h + self.suit_h + self.attr_spacing_top + self.attr_spacing_bottom
    self.attr_panel:setContentSize(cc.size(self.attr_panel_size.width,self.attr_h))
    self.suitattr_panel:setPositionY(self.attr_spacing_bottom)
    self.randattr_panel:setPositionY(self.attr_spacing_bottom + self.suit_h)
    self.baseattr_panel:setPositionY(self.attr_h - self.attr_spacing_top)
end
function HeroHolyEquipAttachPop:updateBasePanel()
    --标题定位
    self.base_line_spacing_top = 19
    self.base_name_spacing_top = 18

    --属性定位
    self.base_space_x = 12
    self.base_space_y = 4
    self.base_spacing_top = 38
    self.base_spacing_bottom = 9
    self.base_start_x = 11
    self.base_item_w = self.item_1:getContentSize().width
    self.base_item_h = self.item_1:getContentSize().height
    if not self.base_attr_tip then
        self.base_attr_tip = createRichLabel(22,cc.c3b(0x7c, 0x55, 0x36),cc.p(0.5,0.5),cc.p(300,105),-8,nil,350)
        self.base_attr_tip:setHorizontalLayoutType(2)
        self.baseattr_panel:addChild(self.base_attr_tip)
    end
    self.base_attr_tip:setString(string.format(TI18N("语言_c_7455"),self.rate_num))
    setLeftRightImg(self.baseattr_line_1,self.base_attr_tip,self.baseattr_line_2,30)

    self.item_config = Config.ItemData.data_get_data(self.equip_attach_vo.base_id)
    local base_attr = deepCopy(self.item_config.ext[1][2] or {})
    local col = 2 --列
    local row = math.ceil(#base_attr/col) --行
    self.base_h = row*self.base_item_h + (row-1)*self.base_space_y + self.base_spacing_top + self.base_spacing_bottom
    -- self.base_h = math.max(self.base_h,self.baseattr_panel_size.height)
    self.baseattr_panel:setContentSize(cc.size(self.baseattr_panel_size.width,self.base_h))
    self.baseattr_line_1:setPositionY(self.base_h - self.base_line_spacing_top)
    self.baseattr_line_2:setPositionY(self.base_h - self.base_line_spacing_top)
    self.base_attr_tip:setPositionY(self.base_h - self.base_name_spacing_top)


    if not self.base_attr_list then 
        self.base_attr_list = {} 
    end
    for k, v in pairs(self.base_attr_list) do
        v:setVisible(false)
    end
    for i = 1, #base_attr do
        if not self.base_attr_list[i] then
            local item = self.item_1:clone()
            item:setVisible(true)
            item:setAnchorPoint(0, 1)
            self.baseattr_panel:addChild(item)
            item.attr_icon = item:getChildByName("attr_icon")
            item.attr_name = item:getChildByName("attr_name")
            item.attr_value = item:getChildByName("attr_value")
            self.base_attr_list[i] = item
        end
        local attr_key = base_attr[i][1]
        local attr_val = math.floor(base_attr[i][2]*(self.base_cfg.append_attr_rate or 0)/1000+0.5)
        local item = self.base_attr_list[i]
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if not attr_name then
            attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
        end
        if attr_name then
            local icon = PathTool.getAttrIconByStr(attr_key)
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val*0.1).."%"
            end
            local res = PathTool.getResFrame("common", icon)
            item.attr_icon:loadTexture(res, LOADTEXT_TYPE_PLIST)
            item.attr_name:setString(attr_name)
            item.attr_value:setString(attr_val)
        end
        local _x = (i-1)%col * (self.base_item_w + self.base_space_x) + self.base_start_x
        local _y = self.base_h - self.base_spacing_top - math.floor((i-1)/col) * (self.base_item_h + self.base_space_y)
        item:setPosition(cc.p(_x,_y))
        item:setVisible(true)
    end
end
function HeroHolyEquipAttachPop:updateRandPanel()
    --标题定位
    self.rand_line_spacing_top = 18
    self.rand_name_spacing_top = 18

    --套装定位
    self.rand_space_x = 12
    self.rand_space_y = 3
    self.rand_spacing_top = 38
    self.rand_spacing_bottom = 5
    self.rand_start_x = 11
    self.rand_item_w = self.item_1:getContentSize().width
    self.rand_item_h = self.item_1:getContentSize().height
    if not self.rand_attr_tip then
        self.rand_attr_tip = createRichLabel(22,cc.c3b(0x7c, 0x55, 0x36),cc.p(0.5,0.5),cc.p(300,102),-8,nil,350)
        self.rand_attr_tip:setHorizontalLayoutType(2)
        self.randattr_panel:addChild(self.rand_attr_tip)
    end
    self.rand_attr_tip:setString(string.format(TI18N("语言_c_7456"),self.rate_num))
    setLeftRightImg(self.randattr_line_1,self.rand_attr_tip,self.randattr_line_2,30)

    local rand_attr = {}
    for k, v in pairs(self.equip_attach_vo.holy_eqm_attr) do
        if v.pos < 100 then
            rand_attr[v.pos] = v
        end
    end
    local col = 2 --列
    local row = math.ceil(#rand_attr/col) --行
    self.rand_h = row*self.rand_item_h + (row-1)*self.rand_space_y + self.rand_spacing_top + self.rand_spacing_bottom
    -- self.rand_h = math.max(self.rand_h,self.randattr_panel_size.height)
    self.randattr_panel:setContentSize(cc.size(self.randattr_panel_size.width,self.rand_h))
    self.randattr_line_1:setPositionY(self.rand_h - self.rand_line_spacing_top)
    self.randattr_line_2:setPositionY(self.rand_h - self.rand_line_spacing_top)
    self.rand_attr_tip:setPositionY(self.rand_h - self.rand_name_spacing_top)

    if not self.rand_attr_list then 
        self.rand_attr_list = {} 
    end
    for k, v in pairs(self.rand_attr_list) do
        v:setVisible(false)
    end
    for i = 1, #rand_attr do
        if not self.rand_attr_list[i] then
            local item = self.item_1:clone()
            item:setVisible(true)
            item:setAnchorPoint(0, 1)
            self.randattr_panel:addChild(item)
            item.attr_icon = item:getChildByName("attr_icon")
            item.attr_name = item:getChildByName("attr_name")
            item.attr_value = item:getChildByName("attr_value")
            self.rand_attr_list[i] = item
        end
        local attr_id = rand_attr[i].attr_id
        local attr_val = math.floor(rand_attr[i].attr_val*(self.base_cfg.append_attr_rate or 0)/1000+0.5)
        local item = self.rand_attr_list[i]
        local attr_key = Config.AttrData.data_id_to_key[attr_id]
        if not attr_key then
            attr_key = Config.AttrExtraData.data_id_to_key[attr_id]
        end
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if not attr_name then
            attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
        end
        if attr_name then
            local icon = PathTool.getAttrIconByStr(attr_key)
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val*0.1).."%"
            end
            local res = PathTool.getResFrame("common", icon)
            item.attr_icon:loadTexture(res, LOADTEXT_TYPE_PLIST)
            item.attr_name:setString(attr_name)
            item.attr_value:setString(attr_val)
        end
        local _x = (i-1)%col * (self.rand_item_w + self.rand_space_x) + self.rand_start_x
        local _y = self.rand_h - self.rand_spacing_top - math.floor((i-1)/col) * (self.rand_item_h + self.rand_space_y)
        item:setPosition(cc.p(_x,_y))
        item:setVisible(true)
    end
end
function HeroHolyEquipAttachPop:updateSuitPanel()
    --标题定位
    self.suit_line_spacing_top = 22
    self.suit_name_spacing_top = 20

    --套装定位
    self.suit_space_x = 0
    self.suit_start_x = 11
    self.suit_space_y = 3
    self.suit_spacing_top = 39
    self.suit_spacing_bottom = 10
    self.suit_item_w = self.item_2:getContentSize().width
    self.suit_item_h = self.item_2:getContentSize().height
    if not self.suitattr_name then
        self.suitattr_name = createRichLabel(22,cc.c3b(0x7c, 0x55, 0x36),cc.p(0.5,0.5),cc.p(300,102),-8,nil,350)
        self.suitattr_name:setHorizontalLayoutType(2)
        self.suitattr_panel:addChild(self.suitattr_name)
    end
    self.suitattr_name:setString(TI18N("语言_c_7457"))
    setLeftRightImg(self.suitattr_line_1,self.suitattr_name,self.suitattr_line_2,30)
    local suit_config = model:getHolyEquipSuitDes(self.all_equip_list)
    table.sort(suit_config,function(a,b) return a.num > b.num end)
    if suit_config and next(suit_config) then
        self.no_panel:setVisible(false)
        self.spine_node:setVisible(true)
        local col = 1 --列
        local row = math.ceil(#suit_config/col) --行
        self.suit_h = row*self.suit_item_h + (row-1)*self.suit_space_y + self.suit_spacing_top + self.suit_spacing_bottom
        -- self.suit_h = math.max(self.suit_h,self.suitattr_panel_size.height)
        
        if not self.suit_attr_list then
            self.suit_attr_list = {}
        end
        for k, v in pairs(self.suit_attr_list) do
            v:setVisible(false)
        end
        for i = 1, #suit_config do
            if not self.suit_attr_list[i] then
                local item = self.item_2:clone()
                item:setVisible(true)
                item:setAnchorPoint(0, 1)
                self.suitattr_panel:addChild(item)
                item.suit_icon = item:getChildByName("suit_icon")
                item.suit_name = item:getChildByName("suit_name")
                item.suit_value = item:getChildByName("suit_value")
                self.suit_attr_list[i] = item
            end
            local item = self.suit_attr_list[i]
            local _x = (i-1)%col * (self.suit_item_w + self.suit_space_x) + self.suit_start_x
            local _y = self.suit_h - self.suit_spacing_top - math.floor((i-1)/col) * (self.suit_item_h + self.suit_space_y)
            item:setPosition(cc.p(_x,_y))

            local eqm_set = suit_config[i].id
            local star = eqm_set%100
            local eqm_key = math.floor(eqm_set/100)
            local res_config = Config.PartnerHolyEqmData.data_suit_res_prefix[eqm_key]
            local res = PathTool.getSuitRes(res_config.prefix)
            item.suit_icon:loadTexture(res, LOADTEXT_TYPE)
            item.suit_name:setString(res_config.name)
            local star_txt = string.format(TI18N("语言_c_3055"),star)
            item.suit_value:setString(suit_config[i].name)
            if suit_config[i].num == 4 then
                item.suit_value:setTextColor(cc.c3b(0xdf,0x2c,0xff))
            else
                item.suit_value:setTextColor(cc.c3b(0x0e,0xa8,0x0e))
            end
            item:setVisible(true)
        end
    else
        self.spine_node:setVisible(false)
        self.no_panel:setVisible(true)
        if self.suit_attr_list and next(self.suit_attr_list) then
            for k, v in pairs(self.suit_attr_list) do
                v:setVisible(false)
            end
        end
        self.suit_h = self.suitattr_panel_size.height
    end
    self.suitattr_panel:setContentSize(cc.size(self.suitattr_panel_size.width,self.suit_h))
    self.suitattr_line_1:setPositionY(self.suit_h - self.suit_line_spacing_top)
    self.suitattr_line_2:setPositionY(self.suit_h - self.suit_line_spacing_top)
    self.suitattr_name:setPositionY(self.suit_h - self.suit_name_spacing_top)
end
--获取装备激活数量
function HeroHolyEquipAttachPop:getEquipActiveCount()
    if not self.all_equip_list or not next(self.all_equip_list) then
        return 0
    end
    --组合神装的套装信息
    local suit_config = {} 
    local eqm_set_list = {}
    for k, goodvo in pairs(self.all_equip_list) do
        local item_cfg = Config.ItemData.data_get_data(goodvo.base_id)
        if item_cfg then
            local eqm_key = math.floor(item_cfg.eqm_set/100)
            if eqm_set_list[eqm_key] then
                table.insert(eqm_set_list[eqm_key],item_cfg.eqm_set)
            else
                eqm_set_list[eqm_key] = {item_cfg.eqm_set}
            end
        end
    end
    for key,value in pairs(eqm_set_list) do
        table.sort( value, function(a,b) return a > b end)
    end
    if eqm_set_list and next(eqm_set_list) then
        for key,value in pairs(eqm_set_list) do
            local cur_config = nil
            local cur_eqm_set = nil
            local status = false
            for i,eqm_set in ipairs(value) do
                if cur_eqm_set == nil then
                    cur_eqm_set = eqm_set
                    cur_config = Config.PartnerHolyEqmData.data_suit_info[eqm_set]
                    table.sort( cur_config, function(a, b) return a.num < b.num end)
                else
                    if cur_eqm_set ~= eqm_set then
                        cur_config = Config.PartnerHolyEqmData.data_suit_info[eqm_set]
                        table.sort( cur_config, function(a, b) return a.num < b.num end)   
                        status = false 
                    end
                    for _,suit_info in ipairs(cur_config) do
                        if suit_info.num == i then
                            suit_info.have_num = 0
                            for _k,_v in ipairs(value) do
                                if _v >= suit_info.id then
                                    suit_info.have_num = suit_info.have_num + 1
                                end
                            end

                            suit_config[suit_info.id] = suit_info
                            status = true
                            -- table.insert(suit_config, suit_info)
                            -- break
                        end
                    end
                end
            end
            if not status and cur_config and next(cur_config) then
                table.sort(cur_config,function(a,b) return a.num < b.num end)
                cur_config[1].have_num = 1
                suit_config[cur_config[1].id] = cur_config[1]
            end
        end
    end
    local list = {}
    for key,value in pairs(suit_config) do
        table.insert(list,value)
    end
    table.sort(list,function(a,b) return a.have_num > b.have_num end)
    return list
end
function HeroHolyEquipAttachPop:close_callback()
    if self.evt_effect then
        self.evt_effect:clearTracks()
        self.evt_effect:removeFromParent()
        self.evt_effect=nil
    end
    controller:openHeroHolyEquipAttachPop(false)
end