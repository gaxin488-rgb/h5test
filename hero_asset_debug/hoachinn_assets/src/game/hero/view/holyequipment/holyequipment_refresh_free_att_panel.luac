HolyequipmentRefreshFreeAttPanel = HolyequipmentRefreshFreeAttPanel or BaseClass(BaseView)
local controller = HeroController:getInstance()
local model = controller:getModel()

function HolyequipmentRefreshFreeAttPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/holyequipment_refresh_free_att_panel"
    self.color_id = 0
    self.choose_list ={}
end

function HolyequipmentRefreshFreeAttPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.main_container = self.root_wnd:getChildByName("container")
    self.image_bg = self.main_container:getChildByName("image_bg")
    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_5329"))
    self.image_title:setContentSize(cc.size(self.win_title:getContentSize().width + 120,63))
    self.tip = self.main_container:getChildByName("tip")
    setTextMaxWidth(self.tip,600)
    self.tip:setString(TI18N("语言_c_6563"))
    self.now_item = self.main_container:getChildByName("now_item")
    self.now_txt = self.main_container:getChildByName("now_txt")
    self.now_txt:setString(TI18N("语言_c_6564"))
    self.choose_txt = self.main_container:getChildByName("choose_txt")
    self.choose_txt:setString(TI18N("语言_c_6565"))
    setTextMaxWidth(self.choose_txt,100)
    self.choose_panel = self.main_container:getChildByName("choose_panel")
    self.choose_panel:setScrollBarEnabled(false)
    self.click_bg = self.choose_panel:getChildByName("click_bg")
    self.ok_btn = self.main_container:getChildByName("ok_btn")
    self.ok_txt = self.ok_btn:getChildByName("label")
    self.ok_txt:setString(TI18N("语言_c_63"))
    self.close_btn = self.main_container:getChildByName("close_btn")
end
function HolyequipmentRefreshFreeAttPanel:register_event()
    registerButtonEventListener(self.background, function()
        self:clickClose()
    end,true, 1)
    registerButtonEventListener(self.close_btn, function()
        self:clickClose()
    end,true, 1)
    registerButtonEventListener(self.ok_btn, function()
        if self.color_id ~= 0 then
            controller:sender11420(self.partner_id,self.holy_eqm_id,self.pos,self.color_id)
        end
        self:clickClose()
    end,true, 1)
end
function HolyequipmentRefreshFreeAttPanel:clickClose()
    controller:openHolyequipmentRefreshFreeAttPanel(false)
end
function HolyequipmentRefreshFreeAttPanel:openRootWnd(seetting)
    self.partner_id = seetting.partner_id or 0
    self.holy_eqm_id = seetting.holy_eqm_id or 1
    self.pos = seetting.pos or 1
    self.col_data = seetting.col_data or {}
    self.now_id = seetting.now_id or 1
    self:setData()
    self:setScrollPanel()
end

function HolyequipmentRefreshFreeAttPanel:setData()
    if self.now_attr then
        self.now_attr:removeFromParent()
        self.now_attr = nil
    end
    if not self.now_attr then
        self.now_attr = self:createNewAttrItem(self.color_id == 0 and self.now_id or self.color_id)
        self.now_item:addChild(self.now_attr)
    end
end
function HolyequipmentRefreshFreeAttPanel:setScrollPanel()
    for i,v in pairs(self.choose_list) do
        v:removeFromParent()
        v = nil
    end
    -- local _h = math.max(self.choose_panel:getContentSize().height,math.ceil(tableLen(self.col_data)/4)*80+20)
    -- self.choose_panel:setInnerContainerSize(cc.size(self.choose_panel:getContentSize().width,_h))
    self.choose_panel:setInnerContainerSize(cc.size(tableLen(self.col_data)*115,self.choose_panel:getContentSize().height))
    for i,v in pairs(self.col_data) do
        local _x = (i-1)*115+45
        -- local _y = _h - math.floor((i-1)/4)*80-40
        local item = self:createNewAttrItem(v)
        self.choose_panel:getInnerContainer():addChild(item)
        item:setPosition(cc.p(_x,self.choose_panel:getInnerContainerSize().height*0.5))
        registerButtonEventListener(item, function()
            self.color_id = item.id
            self.click_bg:setPosition(cc.p(item:getPositionX(),item:getPositionY()))
            self:setData()
        end,true, 1)
    end
end
function HolyequipmentRefreshFreeAttPanel:createNewAttrItem(id)
    local size = cc.size(60,60)
    local item = ccui.Layout:create()
    item:setAnchorPoint(cc.p(0.5, 0.5))
    item:setTouchEnabled(true)
    item:setContentSize(size)
    item.bg = createImage(item,PathTool.getResFrame("common", "common_1095"),size.width*0.5,size.height*0.5,cc.p(0.5,0.5),true,nil,true)
    item.bg:setContentSize(size)
    item.icon = createImage(item,PathTool.getResFrame("holy_starup","holy_starup_"..5+id),size.width*0.5,size.height*0.5,cc.p(0.5,0.5),true)
    item.icon:setScale(1.5)
    item.id = id
    return item
end
function HolyequipmentRefreshFreeAttPanel:close_callback()
    self:clickClose()
end