-- type 1活动2常驻抽奖
function YingShowPlayWindow:openRootWnd(hero_vo)
    self.hero_vo = hero_vo
    local res_id = PathTool.getPlistImgForDownLoad("ninjacontract", "ninjacontract_"..self.hero_vo.bid)
    self.load1 = createResourcesLoad(res_id, ResourcesType.single, function()
        if self.panel_list[1] and not tolua.isnull(self.panel_list[1]) then
            -- loadSpriteTexture(self.panel_list[1], res_id, LOADTEXT_TYPE)
            self.panel_list[1]:loadTexture(res_id, LOADTEXT_TYPE)
            self:ocClickBtn(1)
        end
	end, self.load1)
end

function YingShowPlayWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        _controller:openYingShowPlayWindow(false)
    end, true, 2)
    registerButtonEventListener(self.background, function()
        _controller:openYingShowPlayWindow(false)
    end, false, 2)
    registerButtonEventListener(self.grow_gift_btn, function()
        JumpController:getInstance():jumpViewByEvtData({114,11})
        _controller:openYingShowPlayWindow(false)
        -- local controller = ActionController:getInstance()
        -- local tab_vo = controller:getActionSubTabVo(ActionRankCommonType.grow_gift)
        -- if tab_vo then
        --     ActionController:getInstance():openActionMainPanel(false)
        --     controller:getModel():setGrowIndex(3)
        --     controller:openActionMainPanel(true, nil, tab_vo.bid)
        --     _controller:openYingShowPlayWindow(false)
        -- else
        --     message(TI18N("语言_c_1472"))
        -- end
    end, true, 1)
    for k, v in pairs(self.btn_list) do
        registerButtonEventListener(v, function()
            self:ocClickBtn(k)
        end, false, 1)
    end
end

function YingShowPlayWindow:ocClickBtn(index)
    if self.select_index == index then return end
    self.select_index = index
    for k, v in pairs(self.btn_list) do
        if k == self.select_index then
            v.label:setTextColor(cc.c3b(0xff,0xee,0x8e))
			v.label:enableOutline(cc.c3b(0x46,0x0f,0x00),2)
        else
            v.label:setTextColor(cc.c3b(0xff,0xff,0xff))
			v.label:enableOutline(cc.c3b(0x00,0x00,0x00),2)
        end
    end
    self.click_bg:setPosition(cc.p(self.btn_list[index]:getPositionX(),self.btn_list[index]:getPositionY()))

    self:updatePage(index)
end

function YingShowPlayWindow:updatePage(index)
    for i, v in ipairs(self.panel_list) do
        v:setVisible(false)
    end
    self.panel_list[index]:setVisible(true)

    local label_list = {
        [1]=TI18N("语言_c_7601"),
        [2]=TI18N("语言_c_7602"),
        [3]=string.format(TI18N("语言_c_7603"), TI18N("语言_sour_01_1100"),TI18N("语言_daily_boss_title")),
    }
 --   print(TI18N("语言_c_7601"))
    self.desc_txt:setString(label_list[index])
    local _h = math.max(self.desc_txt:getContentSize().height,self.skill_container:getContentSize().height)
    self.skill_container:setInnerContainerSize(cc.size(self.skill_container:getContentSize().width,_h))
    self.desc_txt:setPositionY(_h)
end

function YingShowPlayWindow:close_callback()
    if self.load1 then
        self.load1:DeleteMe()
        self.load1 = nil
    end
    _controller:openYingShowPlayWindow(false)
end

