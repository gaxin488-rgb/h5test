                end
                if not self.camp_list[self.click_index].is_lock then
                    if Config.PartnerData.data_partner_transform[self.camp_list[self.click_index].bid] then
                        _controller:sender11412(self.hero_vo.partner_id)
                    else
                        if num > 0 then
                            message(TI18N("语言_c_6444"))
                            return
                        end
                        local num = Config.PartnerData.data_partner_const.commutation_num_5.val
                        if self.data.day_num < num then
                            _controller:sender11411(self.hero_vo.partner_id,self.camp_list[self.click_index].bid,{},{})
                        else
                            message(TI18N("语言_c_6443"))
                        end
                    end
                else
                    if num > 0 then
                        message(TI18N("语言_c_6444"))
                        return
                    end
