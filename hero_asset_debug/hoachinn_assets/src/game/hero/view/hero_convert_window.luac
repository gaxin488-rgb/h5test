                        local random_list = {}
                        local dic_item_expend = {}
                        for i,item in ipairs(self.hero_item_data_list) do
                            local count = 0
                            for k,v in pairs(item.dic_select_list) do
                                count = count + 1
                            end
                            if count < item.count then
                                message(TI18N("语言_c_3021"))
                                return
                            end
                            for k,v in pairs(item.dic_select_list) do
                                if v.is_hero_hun then --是否英魂 参考 HeroUpgradeStarSelectPanel:initHeroList(dic_other_selected) 里面的定义
                                    if v.good_vo then
                                        if dic_item_expend[v.good_vo.base_id] == nil then
                                            dic_item_expend[v.good_vo.base_id] = 1
                                        else
                                            dic_item_expend[v.good_vo.base_id] = dic_item_expend[v.good_vo.base_id] + 1
                                        end
                                    end
                                else
                                    local data = {}
                                    data.id = k
                                    if item.bid == 0 then
                                        --随机卡
                                        table.insert(random_list, data)
                                    else
                                        --指定卡
                                        table.insert(hero_list, data)
                                    end
                                end
                            end
                        end 
                        _model:setUpgradeStarUpdateRecord(false)
                        self.is_hero_data_update = false
                        self.is_del_hero_event = false
                
                        local item_list = {}
                        for item_id, num in pairs(dic_item_expend) do
                            local data = {}
                            data.item_id = item_id
                            data.num = num
                            table.insert(item_list, data)
                        end
                        local num = Config.PartnerData.data_partner_const.commutation_num_5.val
                        if self.data.day_num < num then
                            _controller:sender11411(self.hero_vo.partner_id,self.camp_list[self.click_index].bid , random_list, item_list)
                        else
                            message(TI18N("语言_c_6443"))
                        end
                    end         
                end
            end
            if self.hero_vo.isLockByLocktype and self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroHalidomLock) then
                local txt = ""
                if self.hero_vo.isLockByLocktype and self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroHalidomLock) then
                    txt = txt .. "\n" .. TI18N("语言_c_6891")
                end
                local str = string.format(TI18N("语言_c_6888"),txt)
                CommonAlert.show( str, TI18N("语言_c_63"), function()
                    _controller:sender11461(self.hero_vo.partner_id)
                end, TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
            else
                fun()
            end
        end
    end,true, 1)
    for i=1,5 do
        registerButtonEventListener(self.camp_btn_list[i],function()
            if not self.is_can_click then return end
            self:ClickCampType(i)
        end,false, 1)
    end
    if self.hero_convert_event == nil then
        self.hero_convert_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Convert_Event, function(data)
            if data and next(data) and data.partner_id == self.partner_id then
                self.is_can_click = true
                self.data = data
                self:setData()
            end
        end)
    end
    --添加英雄选择返回事件
    if self.upgrade_star_select_event == nil then
        self.upgrade_star_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event, function()
            self:updateHeroItemInfo()
        end)
    end    
    self:addGlobalEvent(HeroEvent.Hero_Convert_OK_Event, function()
        self.click_index = 0
        self.hero_item_list = {}
        self.is_can_click = false
        self:openRootWnd(self.hero_vo.partner_id,true)
    end)
end


--关闭
function HeroConvertWindow:onClickBtnClose()
    _controller:openHeroConvertWindow(false)
end

--更新选中英雄信息
function HeroConvertWindow:updateHeroItemInfo()
    if not self.hero_item_data_list then return end
    self.dic_other_selected = {}
    --过滤自己
    if self.hero_vo then
        self.dic_other_selected[self.hero_vo.partner_id] = self.hero_vo
    end
    for i,v in ipairs(self.hero_item_data_list) do
        if v.is_select then
            v.is_select = false
            local count = 0
            for k,vo in pairs(v.dic_select_list) do
                count = count + 1
                self.dic_other_selected[k] = vo
            end
            v.lev = string_format("%s/%s", count, v.count)
            if self.hero_item_list[i] then
                self.hero_item_list[i].num_label:setString(v.lev)
                if count > 0 then
                    self.hero_item_list[i]:setHeadUnEnabled(false)
                else
                    self.hero_item_list[i]:setHeadUnEnabled(true)
                end
            end
        else
            for k,vo in pairs(v.dic_select_list) do
                self.dic_other_selected[k] = vo
            end
        end
    end
    self:updateCentreHeroItemRedPoint()
end

--计算中间item红点显示
function HeroConvertWindow:updateCentreHeroItemRedPoint()
    if not self.conditions_hero_list then return end
    if not self.dic_other_selected then return end
    self.item_list = {}
    for i,item in ipairs(self.hero_item_list) do
        --模拟的hero_vo数据
        local hero_vo = self.hero_item_data_list[i]
        local conditions_list =  self.conditions_hero_list[i] or {}
        if hero_vo then
            local count = 0
            for k,v in pairs(hero_vo.dic_select_list) do
                count = count + 1
            end
            --已经填满了就不显示红点了
            if count < hero_vo.count then
                --随机卡的 --指定卡 逻辑一样的
                local num = hero_vo.count
                for j,each_hero in ipairs(conditions_list) do
                    --自已选的.和 别人没选的 都算数 
                    if hero_vo.dic_select_list[each_hero.id] or self.dic_other_selected[each_hero.id] == nil then 
                        if conditions_list[j] and conditions_list[j].is_in_form == 0 and conditions_list[j].is_lock == 0 then
                            num = num -1
                            if num == 0 then
                                break
                            end
                        end
                    end
                    local dic_select = self.hero_item_data_list[i]
                    local list = BackpackController:getInstance():getModel():getHeroHunList()
                    if self.item_list == nil then
                        self.item_list = {}
                    end
                    for _,v in pairs(list) do
                        if v.config and (v.config.camp_type == each_hero.camp_type or 0) and v.config.eqm_jie ==hero_vo.star then
                            for i=1, v.quantity do
                                local hero_vo = {}
                                hero_vo.id = -(i + v.config.camp_type * 10)  --因为英雄id是正序的..这里就负序
                                hero_vo.partner_id = hero_vo.id
                                hero_vo.is_hero_hun = true
                                hero_vo.good_vo = v
                                if dic_select[hero_vo.id] then
                                    conditions_list[hero_vo.id] = hero_vo
                                end
                                table.insert(self.item_list, hero_vo)
                            end
                        end
                    end
                    for key, value in pairs(self.item_list) do
                        if each_hero.id == value.id then 
                            num = num -1
                            if num == 0 then
                                break
                            end
                        end
                    end 

                end
                --说明数量够 显示红点
                local status = (num <= 0) 
                item:showRedPoint(status, 8, 8)

            else
                item:showRedPoint(false)
            end
        end
    end
end
function HeroConvertWindow:openRootWnd(partner_id,is_show)
    self.partner_id = partner_id
    self.hero_vo = _model:getHeroById(partner_id)
    if _model:getNewConvertFirstRed(self.hero_vo) then
        ActionController:getInstance():sender16809(self.hero_vo.partner_id+10000,1,"")
    end
    self.hero_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    local bid = _model:getNewConvertStaBid(self.hero_vo.bid)
    self.cfg = Config.PartnerData.data_partner_transform[bid]
    self.self_cfg = Config.PartnerData.data_partner_base[bid]
    _controller:sender11410(partner_id)
    local need_star = Config.PartnerData.data_partner_const["commutation_open_starlev_5"].val
    if self.hero_vo.star and need_star and type(self.hero_vo.star) == "number" and type(need_star) == "number" and self.hero_vo.star < need_star then
        self.star_tips:setVisible(true)
        self.star_tips:setString(string.format(TI18N("语言_c_6318"),need_star))
        setChildUnEnabled(true,self.discharge_btn)
    else
        self.star_tips:setVisible(false)
        setChildUnEnabled(false,self.discharge_btn)
    end
    if is_show then
        self:handleLeftChangeEffect(true)
    else
        self:handleLeftChangeEffect(false)
    end
    if self.left_role then
        self.left_role:DeleteMe()
        self.left_role = nil
    end
    self.left_role = BaseRole.new(BaseRole.type.partner, self.hero_vo, nil, {skin_id = self.hero_vo.use_skin,scale = 0.72}) 
    self.left_role:setCascade(true)
    self.left_role:setAnchorPoint(cc.p(0.5, 0))
    self.left_role:setPosition(cc.p(100, 170))
    self.left_role:setAnimation(0,PlayerAction.show,true)
    self.left_panel:addChild(self.left_role)
    self.left_role:setLocalZOrder(-9999)
    self:handleLeftEmptyEffect(false)
    self:handleRightRandomEffect(false)
end
--获取技能列表
function HeroConvertWindow:getSkillList(bid)
    local base_cfg = Config.PartnerData.data_partner_base[bid]
    local star = Config.PartnerData.data_partner_max_star[bid]
    local key = getNorKey(bid, star)
    local star_config = deepCopy(Config.PartnerData.data_partner_star(key))
    if star_config == nil then return end
    local skill_list = {}
    for i,v in ipairs(star_config.skills) do
        -- 不是普通攻击 1表示普通攻击
        if v[1] ~= 1 then
            v.sort = v[1]
            table.insert(skill_list, v)
        end
    end
    if base_cfg.score == 9 then
        for k, v in pairs(skill_list) do
            if v[1] == 2 then
                v.sort = 9999
            end
        end
    end
    table.sort(skill_list,function(a,b)
        return a.sort < b.sort
    end)
    return skill_list
end
function HeroConvertWindow:updateCampTypeLock()
    local num = 1
    self.camp_list = {}
    for i = 1, 5 do
        self.camp_list[i]={}
        self.camp_list[i].is_have = false
        self.camp_list[i].is_lock = true
        self.camp_list[i].bid = 0
    end
    local cfg = Config.PartnerData.data_partner_base
    if not cfg or not self.cfg or not self.cfg.bid then return end
    local hero_cfg = cfg[self.cfg.bid]
    self.camp_list[hero_cfg.camp_type].is_have = true
    self.camp_list[hero_cfg.camp_type].is_lock = false
    self.camp_list[hero_cfg.camp_type].bid = hero_cfg.bid
    local is_try = _model:checkIsTryout(self.partner_id)
    for k, v in pairs(self.cfg.transform_bid_list) do
        local cfg = Config.PartnerData.data_partner_base
        local hero_cfg = cfg[v]
        self.camp_list[hero_cfg.camp_type].is_have = true
        self.camp_list[hero_cfg.camp_type].bid = hero_cfg.bid
        num = num + 1
        for key, value in pairs(self.data.use_list) do
            if value.bid == v then
                self.camp_list[hero_cfg.camp_type].is_lock = false
            end
        end
    end
    if is_try then
        for k, v in pairs( self.camp_list) do
            v.is_lock = false
        end
    end
    for i=1,5 do
        self.camp_btn_list[i]:setVisible(self.camp_list[i].is_have)
        setChildUnEnabled(self.camp_list[i].is_lock,self.camp_btn_list[i])
        self.camp_lock_list[i]:setVisible(self.camp_list[i].is_lock)
        if self.camp_list[i].is_have then
            if num%2 == 0 then
                self.camp_btn_list[i]:setPositionX(329-(math.ceil(num/2-i))*78)
            else
                self.camp_btn_list[i]:setPositionX(369-(math.ceil(num/2-i))*78)
            end
        end
    end
    self:ClickCampType(self.hero_cfg.camp_type)
end
function HeroConvertWindow:ClickCampType(index)
    if self.click_index == index then return end
    self.click_index = index
    self.click_img:setPositionX(self.camp_btn_list[index]:getPositionX())
    local skill_list = self:getSkillList(self.camp_list[index].bid)
    for k,v in pairs(self.skill_item_list) do
        v:setVisible(false)
    end
    if not self.cfg or not next(self.cfg["replay"..index]) then
        self.btn_video:setVisible(false)
    else
        self.btn_video:setVisible(true)
    end
    self:setSkillList(self.camp_list[index].bid,skill_list,self.skill_bg)
    self:updateCostPanel(index)
    if self.hero_cfg.camp_type == index then
        self:handleRightChangeEffect(false)
        self:handleRightRandomEffect(true)
        if self.right_role then
            self.right_role:DeleteMe()
            self.right_role = nil
        end
        self.change_camp:setVisible(false)
    else
        self.change_camp:setVisible(true)
        loadSpriteTexture(self.change_camp,PathTool.getHeroCampTypeIcon(index),LOADTEXT_TYPE_PLIST)
        self:handleRightChangeEffect(true)
        self:handleRightRandomEffect(false)
        if self.right_role then
            self.right_role:DeleteMe()
            self.right_role = nil
        end
        local vo = {bid=self.camp_list[index].bid,star=self.hero_vo.star}
        self.right_role = BaseRole.new(BaseRole.type.partner, vo, nil, {skin_id = self.hero_vo.use_skin,scale = 0.72}) 
        self.right_role:setCascade(true)
        self.right_role:setAnchorPoint(cc.p(0.5, 0))
        self.right_role:setPosition(cc.p(100, 170))
        self.right_role:setAnimation(0,PlayerAction.show,true)
        self.right_panel:addChild(self.right_role)
        self.right_role:setLocalZOrder(-9999)
    end
end
function HeroConvertWindow:setData()
    if self.cfg and self.cfg.content then
        self.title:setString(self.cfg.content)
    end
    local _h = math.max(self.txt_scroll:getContentSize().height,self.title:getContentSize().height)
    self.txt_scroll:setInnerContainerSize(cc.size(self.txt_scroll:getContentSize().width,_h))
    self.title:setPositionY(_h)
    loadSpriteTexture(self.now_camp,PathTool.getHeroCampTypeIcon(self.hero_cfg.camp_type),LOADTEXT_TYPE_PLIST)
    if self.self_cfg and self.self_cfg.camp_type then
        self.body_txt:setPositionX(self.camp_btn_list[self.self_cfg.camp_type]:getPositionX()-5)
        self.body_txt:setVisible(true)
    else
        self.body_txt:setVisible(false)
    end
    if not self.body_eff then
        self.body_eff = createImage(self.body_node, PathTool.getResFrame("common", "common_1101"), 0, 0, cc.p(0.5, 0.5), true)
        self.body_eff:setScale(0.55)
        doStopAllActions(self.select)
        local fadein = cc.FadeIn:create(0.6)
        local fadeout = cc.FadeOut:create(0.6)
        self.body_eff:runAction(cc.RepeatForever:create(cc.Sequence:create(fadein, fadeout)))
    end
    self.body_node:setPositionX(self.camp_btn_list[self.hero_cfg.camp_type]:getPositionX()-1)
    local num = 0
    if self.data.end_time ~= 0 and self.data.end_time > GameNet:getInstance():getTime() then
        num = self.data.end_time - GameNet:getInstance():getTime()
    end
    self.cd_num:setVisible(true)
    self.cd_txt:setVisible(true)
    doStopAllActions(self.cd_num)
    commonCountDownTime(self.cd_num,num,{end_callback=function()
        self.cd_num:setVisible(false)
        self.cd_txt:setVisible(false)
        doStopAllActions(self.cd_num)
    end})
    local num = Config.PartnerData.data_partner_const.commutation_num_5.val
    local remain_num = num - self.data.day_num
    self.num_txt:setString(string.format(TI18N("语言_c_6442"),remain_num))
    
    self:updateCampTypeLock()
end

--初始化英雄列表匹配信息
function HeroConvertWindow:initHeroListByMatchInfo(conditions_list)
    local hero_list = _model:getHeroList()

    self.conditions_hero_list = {}
    for k,hero in pairs(hero_list) do
        for i,conditions in ipairs(conditions_list) do
            if self.conditions_hero_list[i] == nil then
                self.conditions_hero_list[i] = {}
            end

            if self.hero_item_data_list[i].bid == 0 then
                --表示随机卡 0表示全部阵营
                if conditions[0] then
                    if conditions[0][hero.star] then
                        table.insert(self.conditions_hero_list[i], hero)
                    end
                else
                    if conditions[hero.camp_type] and conditions[hero.camp_type][hero.star] ~= nil then
                        table.insert(self.conditions_hero_list[i], hero)
                    end
                end
            else
                --指定卡
                if conditions[hero.bid] and conditions[hero.bid][hero.star] then   -- 指定卡要剔除自己
                    if self.hero_vo and self.hero_vo.partner_id ~= hero.partner_id then
                        table.insert(self.conditions_hero_list[i], hero)
                    end
                end
            end
        end
    end
    
    --新加需求.自动填满指定定的位置的英雄
    -- if self.hero_vo and self.hero_vo.red_point[HeroConst.RedPointType.eRPStar] then
        self.dic_other_selected = {}
        if self.hero_vo then
            self.dic_other_selected[self.hero_vo.partner_id] = self.hero_vo
        end
        for i,v in ipairs(self.hero_item_data_list) do
            --策划要求指定才需要填充 
            if v.bid ~= 0 then
                if self.conditions_hero_list[i] and #self.conditions_hero_list[i] > 0 then
                    local sort_func = SortTools.tableCommonSorter({{"lev", false}, {"id", true}}) 
                    table.sort(self.conditions_hero_list[i], sort_func)
                    local count = 0
                    for _,hero_vo in ipairs(self.conditions_hero_list[i]) do
                        if self.dic_other_selected[hero_vo.id] == nil and not hero_vo:checkHeroLockTips(true, nil, true) then
                            v.dic_select_list[hero_vo.id] = hero_vo
                            count = count + 1
                            if count >= v.count then
                                break
                            end
                        end
                    end
                    if count < v.count then
                        --说明不够..就不显示了
                        v.dic_select_list = {}
                    else
                        for k,v in pairs(v.dic_select_list) do
                            self.dic_other_selected[k] = v
                        end
                        v.lev = string_format("%s/%s", count, v.count)
                        if self.hero_item_list[i] then
                            self.hero_item_list[i].num_label:setString(v.lev)
                            if count > 0 then
                                self.hero_item_list[i]:setHeadUnEnabled(false)
                            else
                                self.hero_item_list[i]:setHeadUnEnabled(true)
                            end
                        end      
                    end
                end
            end
        end
    -- end


    local list = BackpackController:getInstance():getModel():getHeroHunList()
    for k, good_vo in pairs(list) do
        if good_vo.config then
            for i,conditions in ipairs(conditions_list) do
                if self.conditions_hero_list[i] == nil then
                    self.conditions_hero_list[i] = {}
                end
                if self.hero_item_data_list[i].bid == 0 then
                    --表示随机卡 0表示全部阵营
                    local camp_type = good_vo.config.camp_type
                    local star = good_vo.config.eqm_jie
                    if conditions[camp_type] and conditions[camp_type][star] ~= nil then
                        for j=1,good_vo.quantity do
                            local data = {}
                            data.id = -(j + camp_type * 10)
                            data.partner_id = data.id
                            data.good_vo = good_vo
                            table.insert(self.conditions_hero_list[i], data)
                        end
                    end
                end
            end
        end
    end

end

function HeroConvertWindow:updateCostPanel(index)
    if self.camp_list[index].is_lock then
        self.no_cost_panel:setVisible(false)
        self.cost_panel:setVisible(true)
        self.hero_item_data_list = {}
        local conditions_list = {}
        --随机的 {1,4,2} : 1 表示阵营  4: 表示星级 2表示数量
        local cost_index = 1
        for i,expend in ipairs(self.cfg["cost"..index]) do
            self.hero_item_data_list[cost_index] = self:getHeroData(nil, expend[2], expend[3], expend[1])
            conditions_list[cost_index] = {}
            conditions_list[cost_index][expend[1]] = {}
            conditions_list[cost_index][expend[1]][expend[2]] = expend[3]
            cost_index = cost_index + 1
        end
        
        for i,hero_vo in ipairs(self.hero_item_data_list) do
            if self.hero_item_list[i] == nil then
                self.hero_item_list[i] = HeroExhibitionItem.new(0.8, true)
                self.hero_item_list[i]:setPosition( (i-1) * (HeroExhibitionItem.Width * 0.8 + 10) , 0)
                self.hero_item_list[i]:addCallBack(function() self:_onClickItemData(i) end)
                self.cost_node:addChild(self.hero_item_list[i])
            end
            self.hero_item_list[i]:setVisible(true)
            if hero_vo.bid == 0 then
                --随机卡的头像id
                local default_head_id = _model:getRandomHeroHeadByQuality(hero_vo.star)
                self.hero_item_list[i]:setData(hero_vo)
                self.hero_item_list[i]:setDefaultHead(default_head_id)
                -- self.hero_item_list[i]:setHeroName(true, string_format(TI18N("语言_c_3022"), hero_vo.star))
            else
                self.hero_item_list[i]:setData(hero_vo)
                self.hero_item_list[i]:setHeroName(false)
            end
            
            self.hero_item_list[i]:setHeadUnEnabled(true)
        end
        setChildUnEnabled(self.star_tips:isVisible(),self.discharge_btn)
        self:initHeroListByMatchInfo(conditions_list)
        self:updateCentreHeroItemRedPoint()
    else
        self.cost_panel:setVisible(false)
        self.no_cost_panel:setVisible(true)
        if self.hero_vo.camp_type == index then
            if self.self_cfg.camp_type == index then
                self.no_cost_txt:setString(TI18N("语言_c_6883"))
            else
                self.no_cost_txt:setString(TI18N("语言_c_6881"))
            end
            setChildUnEnabled(true,self.discharge_btn)
        else
            if self.self_cfg.camp_type == index then
                self.no_cost_txt:setString(TI18N("语言_c_6883"))
            else
                self.no_cost_txt:setString(TI18N("语言_c_6882"))
            end
            setChildUnEnabled(self.star_tips:isVisible(),self.discharge_btn)
        end
    end
    if self.self_cfg.camp_type == index then
        self.cd_num:setVisible(false)
        self.cd_txt:setVisible(false)
    else
        local num = 0
        if self.data.end_time ~= 0 and self.data.end_time > GameNet:getInstance():getTime() then
            num = self.data.end_time - GameNet:getInstance():getTime()
        end
        if num <= 0 then
            self.cd_num:setVisible(false)
            self.cd_txt:setVisible(false)
        else
            self.cd_num:setVisible(true)
            self.cd_txt:setVisible(true)
        end
    end
end

--点击材料数据
function HeroConvertWindow:_onClickItemData(index)
    if not self.hero_item_data_list[index] then return end
    if not self.hero_vo then return end
    --标志点击了那个
    self.hero_item_data_list[index].is_select = true
    --被其他人选择的列表 [id] = hero_vo 模式
    local dic_other_selected = {}
    --把自己也过滤
    dic_other_selected[self.hero_vo.partner_id] = self.hero_vo
    for i,item in ipairs(self.hero_item_data_list) do
        if i ~= index then
            for k,v in pairs(item.dic_select_list) do
                dic_other_selected[k] = v
            end
        end
    end

    local setting = {}
    if self.hero_item_data_list[index].bid == 0 and self.hero_item_data_list[index].star == 5 then
        -- 表示随机卡
        setting.self_mark_bid = self.hero_vo.bid
    end

    _controller:openHeroUpgradeStarSelectPanel(true, self.hero_item_data_list[index], dic_other_selected, HeroConst.SelectHeroType.eConvertFive, setting)
end
--@ bid 英雄bid 特殊判断 如果 == nil 说明是随机卡
--@ star 星级
--@ count 数量
--@ camp_type 阵营  如果是随机卡.此一定需要有值
function HeroConvertWindow:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s/%s", 0, count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
            data.name = base_config.name
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end
function HeroConvertWindow:setSkillList(bid,list,panel)
    if not list then
        return
    end
    local cfg = Config.PartnerData.data_partner_base[bid]
    local skill_container_size = panel:getContentSize()
    local skill_width = 84
    --技能item的宽度
    local item_width = skill_width + 15
    local total_width = item_width * #list
    local max_width = math.max(skill_container_size.width, total_width)
    -- panel:setContentSize(cc.size(max_width, skill_container_size.height))
    
    local x = 0
    
    for i,skill in ipairs(list) do
        local config = Config.SkillData.data_get_skill(skill[2])
        if config then
            if self.skill_item_list[i] == nil then
                self.skill_item_list[i] = SkillItem.new(true,true,true,0.7, true)
                self.skill_item_list[i]:setCascadeOpacityEnabled(true)
                panel:addChild(self.skill_item_list[i])
            end
            self.skill_item_list[i]:setVisible(true)
            self.skill_item_list[i]:setData(config)
            self.skill_item_list[i]:setSkillSubscript(Config.PartnerData.data_partner_base[bid].hurt_type)
            if self.skill_item_list[i] and self.skill_item_list[i].setSpSkillSubscript then
                if cfg and cfg.score >= 9 and i == 5 then
                    self.skill_item_list[i]:setSpSkillSubscript(true,Config.PartnerData.data_partner_base[bid].hurt_type)
                else
                    self.skill_item_list[i]:setSpSkillSubscript(false)
                end
            end
            self.skill_item_list[i]:setVisible(true)
            if #list%2 == 0 then
                self.skill_item_list[i]:setPosition(cc.p(275-item_width*0.5-(math.ceil(#list/2-i))*item_width, skill_container_size.height/2))
            else
                self.skill_item_list[i]:setPosition(cc.p(275-(math.ceil(#list/2-i))*item_width, skill_container_size.height/2))
            end
        else 
            print(string_format("@技能表id: %s 没发现", tostring(skill.skill_bid)))
        end
    end
end

-- 左边为空时播放的特效
function HeroConvertWindow:handleLeftEmptyEffect( status )
	if status == false then
        if self.left_empty_effect then
            self.left_empty_effect:clearTracks()
            self.left_empty_effect:removeFromParent()
            self.left_empty_effect = nil
        end
    else
        if not tolua.isnull(self.left_effect_node) and self.left_empty_effect == nil then
            self.left_empty_effect = createEffectSpine(Config.EffectData.data_effect_info[620], cc.p(0, 0), cc.p(0.5, 0), true, PlayerAction.action)
            self.left_effect_node:addChild(self.left_empty_effect)
        end
    end
end

-- 右边为随机时的特效
function HeroConvertWindow:handleRightRandomEffect( status )
	if status == false then
        if self.right_random_effect then
            self.right_random_effect:clearTracks()
            self.right_random_effect:removeFromParent()
            self.right_random_effect = nil
        end
    else
        if not tolua.isnull(self.right_effect_node) and self.right_random_effect == nil then
            self.right_random_effect = createEffectSpine(Config.EffectData.data_effect_info[621], cc.p(0, 0), cc.p(0.5, 0), true, PlayerAction.action)
            self.right_effect_node:addChild(self.right_random_effect)
        end
    end
end

-- 左边置换成功的特效
function HeroConvertWindow:handleLeftChangeEffect( status )
	if status == false then
        if self.left_change_effect then
            self.left_change_effect:clearTracks()
            self.left_change_effect:removeFromParent()
            self.left_change_effect = nil
        end
    else
        if not tolua.isnull(self.left_effect_node) and self.left_change_effect == nil then
            self.left_change_effect = createEffectSpine(Config.EffectData.data_effect_info[622], cc.p(0, 0), cc.p(0.5, 0), false, PlayerAction.action)
            self.left_effect_node:addChild(self.left_change_effect)
        elseif self.left_change_effect then
        	self.left_change_effect:setAnimation(0, PlayerAction.action, false)
        end
    end
end

-- 右边置换成功的特效
function HeroConvertWindow:handleRightChangeEffect( status )
	if status == false then
        if self.right_change_effect then
            self.right_change_effect:clearTracks()
            self.right_change_effect:removeFromParent()
            self.right_change_effect = nil
        end
    else
        if not tolua.isnull(self.right_effect_node) and self.right_change_effect == nil then
            self.right_change_effect = createEffectSpine(Config.EffectData.data_effect_info[622], cc.p(0, 0), cc.p(0.5, 0), false, PlayerAction.action)
            self.right_effect_node:addChild(self.right_change_effect)
        elseif self.right_change_effect then
        	self.right_change_effect:setAnimation(0, PlayerAction.action, false)
        end
    end
end
function HeroConvertWindow:close_callback()
    self:handleLeftEmptyEffect(false)
    self:handleRightRandomEffect(false)    
	self:handleRightChangeEffect(false)
    self:handleLeftChangeEffect(false)
    if self.hero_convert_event then
        GlobalEvent:getInstance():UnBind(self.hero_convert_event)
        self.hero_convert_event = nil
    end
    if self.upgrade_star_select_event then
        GlobalEvent:getInstance():UnBind(self.upgrade_star_select_event)
        self.upgrade_star_select_event = nil
    end
	if self.left_role then
		self.left_role:DeleteMe()
		self.left_role = nil
	end
	if self.right_role then
		self.right_role:DeleteMe()
		self.right_role = nil
	end
    _controller:openHeroConvertWindow(false)
    GlobalEvent:getInstance():Fire(HeroEvent.Hero_Convert_Close_Event)
end