function HeroLineupItem:getJinPosInfo(pos,lev)
    local base_cfg = Config.ProhibitorData.data_get_constant.position_unlock.val
    local now_step = lev
    local unlock_step = nil
    local unlock_status = false
    for i, v in ipairs(base_cfg) do
        local info = v
        if v[1] == pos and v[2] <= now_step then
            unlock_status = true
            unlock_step = v[2] 
        end
    end
    return unlock_status
end

--点击英雄
function HeroLineupItem:onClickHeroItemByIndex(index)
    if self.data.partner_infos[index].bid then
        HeroController:getInstance():sender11051(self.data.rid,self.data.sid,_model.recommend_bid,self.data.partner_infos[index].bid)
    end
end
function HeroLineupItem:DeleteMe()
    if self.hero_data_event then
        GlobalEvent:getInstance():UnBind(self.hero_data_event)
        self.hero_data_event = nil
    end
    for k, item in pairs(self.elfin_item_list) do
        item:DeleteMe()
        item = nil
    end
    for k, item in pairs(self.hero_item_list) do
        item:DeleteMe()
        item = nil
    end
    for k, item in pairs(self.four_blank_img) do
        item:DeleteMe()
        item = nil
    end
    -- doStopAllActions(self.main_container)
    doStopAllActions(self.top_equip_btn)
    doStopAllActions(self.top_elfin_btn)
    doStopAllActions(self.top_jinqi_btn)

    -- if self.item_scrollview then
    --     self.item_scrollview:DeleteMe()
    -- end
    -- self.item_scrollview = nil
end