-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      献祭卸下失败
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
HeroFailTipsWindow = HeroFailTipsWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort

function HeroFailTipsWindow:__init()
    self.pos_list = {} 
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_fail_tips_window"
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end

function HeroFailTipsWindow:open_callback()
    self.background_panel = self.root_wnd:getChildByName("background_panel")
    if self.background_panel ~= nil then
        self.background_panel:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.main_container = self.main_panel:getChildByName("main_container")
    self.title_container = self.main_panel:getChildByName("title_container")
    self.Image_1_0 = self.title_container:getChildByName("Image_1_0")
    self.title_label = self.title_container:getChildByName("title_label")
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.title_label_0 = self.main_panel:getChildByName("title_label_0")
    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_label = self.ok_btn:getChildByName("label")
    self.panel_bg = self.main_panel:getChildByName("panel_bg")
    self.scroll_container = self.main_panel:getChildByName("scroll_container")
end
function HeroFailTipsWindow:openRootWnd(data)
    self.title_label:setString(TI18N("语言_c_4277"))
    self.title_label_0:setString(TI18N("语言_c_4553"))
    self.ok_label:setString(TI18N("语言_c_63"))
    self.data = data
    self:updateList()
end
function HeroFailTipsWindow:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.scroll_container:getContentSize()
        local setting = {
            item_class = HeroFailTipsItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 570,               -- 单元的尺寸width
            item_height = 124,              -- 单元的尺寸height
            -- row = 0,                        -- 行数，作用于水平滚动类型
            col = 1                    -- 列数，作用于垂直滚动类型
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.scroll_container, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
        self.item_scrollview:setData(self.data)
        
    end
end
function HeroFailTipsWindow:register_event()
    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn()  end ,true, 2, nil , 0.8)
    registerButtonEventListener(self.ok_btn, function() self:onClickOkBtn()  end ,true, 2, nil , 0.8)
end
--确认
function HeroFailTipsWindow:onClickOkBtn()
    controller:openHeroFailTipsWindow(false)
end
--确认
function HeroFailTipsWindow:onClickCloseBtn()
    controller:openHeroFailTipsWindow(false)
end
function HeroFailTipsWindow:close_callback()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
    end
    self.item_scrollview = nil
    controller:openHeroFailTipsWindow(false)
end
