--更新属性
function HeroAwakenResultPanel:updateAttrList()
    local show_list = {} 
    --战斗力
    -- table_insert(show_list, {left_value = self.old_data.power, right_value = self.new_data.power})

    local h_cfg = Config.PartnerData.data_partner_base_fun(self.isBinding)
    local a_id = h_cfg.ur_awaken_id

    --属性
    local config = Config.PartnerUrAwakenData.data_lv_info[a_id][1][self.base_data.old_lv]
    local config_next = Config.PartnerUrAwakenData.data_lv_info[a_id][1][self.base_data.new_lv]
    local attr_list = {}
    for i, v in ipairs(config_next.attr) do
        attr_list[#attr_list + 1] = v[1]
    end
    local function getAttrInfo(key,_attr)
        for k, v in pairs(_attr) do
            local _key = v[1]
            if _key == key then
                return v[2]
            end
        end
        return 0
    end
    local old_value = {}
    local new_value = {}
    for i, v in ipairs(attr_list) do
        old_value[v] = getAttrInfo(v,config.attr)
        new_value[v] = getAttrInfo(v,config_next.attr)
    end
    for i,attr_str in ipairs(attr_list) do
        local attr_name = Config.AttrData.data_key_to_name[attr_str]
        local old_value = old_value[attr_str] or 0
        local new_value = new_value[attr_str] or 0
        local is_per = PartnerCalculate.isShowPerByStr(attr_str)
        if is_per == true then
            old_value = (old_value/10).."%"
            new_value = (new_value/10).."%"
        end
        local str2 = string_format("%s: %s", attr_name, old_value)
        table_insert(show_list, {left_value = str2, right_value = new_value})
    end
    -- for i, v in ipairs(config.attr) do
    --     attr_list[#attr_list + 1] = v[1]
    --     old_value[v[1]] = v[2]
    --     new_value[config_next.attr[i][1]] = config_next.attr[i][2]
    -- end
    -- for i,attr_str in ipairs(attr_list) do
    --     local attr_name = Config.AttrData.data_key_to_name[attr_str]
    --     local old_value = old_value[attr_str] or 0
    --     local new_value = new_value[attr_str] or 0
    --     local is_per = PartnerCalculate.isShowPerByStr(attr_str)
    --     if is_per == true then
    --         old_value = (old_value/10).."%"
    --         new_value = (new_value/10).."%"
    --     end
    --     local str2 = string_format("%s: %s", attr_name, old_value)
    --     table_insert(show_list, {left_value = str2, right_value = new_value})
    -- end
    
    for i,v in ipairs(show_list) do
        self.attr_labe_left_list[i]:setVisible(true)
        self.attr_labe_right_list[i]:setVisible(true)
        self.attr_arrow_list[i]:setVisible(true)
        self.attr_labe_left_list[i]:setString(v.left_value)
        self.attr_labe_right_list[i]:setString(v.right_value)
    end
    --技能
    local config = config_next--Config.PartnerSoulData.data_soul_level[self.new_data.hid][self.new_data.h_lev]
    if config.desc and config.desc ~= "" then
        local des = createLabel(24,Config.ColorData.data_color4[1],nil,0,0, config.desc,self.skill_node,2, cc.p(0.5,0.5))
        des:setAlignment(cc.TEXT_ALIGNMENT_CENTER)
        des:setDimensions(660, 0)
    else
        local des = createLabel(24,Config.ColorData.data_color4[1],nil,0,0,TI18N("语言_c_2937"),self.skill_node,2, cc.p(0.5,0.5)) 
        des:setAlignment(cc.TEXT_ALIGNMENT_CENTER)
        des:setDimensions(660, 0)
    end
    -- self.left_lv:setString(string.format(TI18N("语言_c_4520"), self.old_data.h_lev))
    -- self.right_lv:setString(string.format(TI18N("语言_c_4520"), self.new_data.h_lev))
end



function HeroAwakenResultPanel:handleEffect(status, open_type)
    if status == false then
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
    else
        local action = PlayerAction.action_6
        if not tolua.isnull(self.title_container) and self.play_effect == nil then
            local res = PathTool.getEffectRes(103)
            -- if not self.isBinding then
            --     action = PlayerAction.action_2
            -- end
            self.play_effect = createEffectSpine(res, cc.p(self.title_width * 0.5, self.title_height * 0.5), cc.p(0.5, 0.5), false, action)
            self.title_container:addChild(self.play_effect)
        end
    end
end 

function HeroAwakenResultPanel:close_callback()
    self:handleEffect(false)
    if self.left_item then
        self.left_item:DeleteMe()
        self.left_item = nil
    end 
    if self.right_item then
        self.right_item:DeleteMe()
        self.right_item = nil
    end 
    -- if self.new_data.star == 13 then
    -- if self.new_data.star > 0 then
        --目前专门处理显示13星开启天赋处理 
        -- GlobalEvent:getInstance():Fire(HeroEvent.Hero_Update_Star_Close_Event, self.new_data)
    -- end
    self.ctrl:openHeroUrAwakenLvupPanel(false)
end

