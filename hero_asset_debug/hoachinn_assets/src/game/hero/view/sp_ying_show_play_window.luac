

-- 16星 影级 玩法一览
SPYingShowPlayWindow = SPYingShowPlayWindow or BaseClass(BaseView)

local table_insert = table.insert
local _controller = HeroController:getInstance()
local action_controller = ActionController:getInstance()
local model = action_controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()

function SPYingShowPlayWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "elitesummon/sp_ying_show_play_window"
    -- self.res_list = {
    --     { path = PathTool.getPlistImgForDownLoad("actioneightlogin", "actioneightlogin"), type = ResourcesType.plist },
    --     { path = PathTool.getPlistImgForDownLoad("hero", "hero"), type = ResourcesType.plist}
    -- }
    self.skill_item_list = {}
    self.select_index = 0
end

function SPYingShowPlayWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_panel = self.main_container:getChildByName("main_panel")

    self.title_2 = self.main_panel:getChildByName("title_2")
    self.container = self.main_panel:getChildByName("container")
    self.skill_container = self.container:getChildByName("skill_container")
    self.desc_txt = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(0,0),nil,nil,530)
    self.skill_container:addChild(self.desc_txt)
    self.desc_txt:addTouchLinkListener(function(type, value, sender, pos)
        if self.select_index == 2 and type == "href" and value == "build" then
            JumpController:getInstance():jumpViewByEvtData({831})
            _controller:openYingShowPlayWindow(false)
        end
        if self.select_index == 2 and type == "href" and value == "liudao" then
            JumpController:getInstance():jumpViewByEvtData({830})
            _controller:openYingShowPlayWindow(false)
        end
    end, { "click", "href" })

    self.skill_container:setScrollBarEnabled(false)
    self.close_btn = self.main_panel:getChildByName("close_btn")
    
    self.btn_panel = self.main_panel:getChildByName("btn_panel")
    self.click_bg = self.btn_panel:getChildByName("click_bg")
    self.btn_list = {}
    local label_list = {
        [1]=TI18N("语言_hon_01_91925"),
        [2]=TI18N("语言_c_7607"),
    }
    for i=1,2 do
        local item = self.btn_panel:getChildByName("btn_"..i)
        item.label = item:getChildByName("label")
        item.label:setString(label_list[i])
        item.index = i
        item.label:setChangeScaleOffWidth(-9999)
        setTextMaxWidth(item.label,120,-10)
        self.btn_list[i] = item
        if label_list[i] then
            item:setVisible(true)
            item.label:setString(label_list[i])
        else
            item:setVisible(false)
        end
    end

    self.panel_list = {}
    self.panel_list[1] = self.main_panel:getChildByName("model_icon_1")
    self.panel_list[1]:ignoreContentAdaptWithSize(true)
    self.panel_list[1]:setVisible(false)
    self.panel_list[2] = self.main_panel:getChildByName("model_icon_2")
    self.panel_list[2]:setVisible(false)

    self.grow_gift_btn = self.panel_list[1]:getChildByName("grow_gift_btn")
    self.grow_gift_btn_label = self.grow_gift_btn:getChildByName("label")
    setTextMaxWidth(self.grow_gift_btn_label, 110, -10)
    self.grow_gift_btn_label:setString(TI18N("语言_sour_01_95"))

end

-- type 1活动2常驻抽奖
function SPYingShowPlayWindow:openRootWnd(hero_vo)
    self.hero_vo = hero_vo
    local res_id = PathTool.getPlistImgForDownLoad("ninjacontract", "ninjacontract_"..self.hero_vo.bid)
    self.load1 = createResourcesLoad(res_id, ResourcesType.single, function()
        if self.panel_list[1] and not tolua.isnull(self.panel_list[1]) then
            -- loadSpriteTexture(self.panel_list[1], res_id, LOADTEXT_TYPE)
            self.panel_list[1]:loadTexture(res_id, LOADTEXT_TYPE)
            self:ocClickBtn(1)
        end
	end, self.load1)
    self:ocClickBtn(1)
end

function SPYingShowPlayWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        _controller:openYingShowPlayWindow(false)
    end, true, 2)
    registerButtonEventListener(self.background, function()
        _controller:openYingShowPlayWindow(false)
    end, false, 2)
    registerButtonEventListener(self.grow_gift_btn, function()
        JumpController:getInstance():jumpViewByEvtData({114,11})
        _controller:openYingShowPlayWindow(false)
    end, true, 1)
    for k, v in pairs(self.btn_list) do
        registerButtonEventListener(v, function()
            self:ocClickBtn(k)
        end, false, 1)
    end
end

function SPYingShowPlayWindow:ocClickBtn(index)
    if self.select_index == index then return end
    self.select_index = index
    for k, v in pairs(self.btn_list) do
        if k == self.select_index then
            v.label:setTextColor(cc.c3b(0xff,0xee,0x8e))
			v.label:enableOutline(cc.c3b(0x46,0x0f,0x00),2)
        else
            v.label:setTextColor(cc.c3b(0xff,0xff,0xff))
			v.label:enableOutline(cc.c3b(0x00,0x00,0x00),2)
        end
    end
    self.click_bg:setPosition(cc.p(self.btn_list[index]:getPositionX(),self.btn_list[index]:getPositionY()))

    self:updatePage(index)
end

function SPYingShowPlayWindow:updatePage(index)
    for i, v in ipairs(self.panel_list) do
        v:setVisible(false)
    end
    self.panel_list[index]:setVisible(true)

    local label_list = {
        [1]=TI18N("语言_c_7875"),
        [2]=string.format(TI18N("语言_c_7876"), TI18N("语言_sour_01_1100"),TI18N("语言_daily_boss_title")),
    }
    self.desc_txt:setString(label_list[index])
    local _h = math.max(self.desc_txt:getContentSize().height,self.skill_container:getContentSize().height)
    self.skill_container:setInnerContainerSize(cc.size(self.skill_container:getContentSize().width,_h))
    self.desc_txt:setPositionY(_h)
end

function SPYingShowPlayWindow:close_callback()
    if self.load1 then
        self.load1:DeleteMe()
        self.load1 = nil
    end
    _controller:openYingShowPlayWindow(false)
end

