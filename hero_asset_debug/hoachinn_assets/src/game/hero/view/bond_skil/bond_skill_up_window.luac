BondSkillUpWindow = BondSkillUpWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
--技能属性的位置
local pos_list = {
    [1] = cc.p(70,44),
    [2] = cc.p(200,44),
    [3] = cc.p(330,44),
    [4] = cc.p(70,14),
    [5] = cc.p(200,14),
}

function BondSkillUpWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.layout_name = "skill/bond_skill_up_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("bondskill", "bondskill"), type = ResourcesType.plist}
    }
    self.role_vo = RoleController:getInstance():getRoleVo()
    self.cost_list = {}
    self.attr_list = {}
    self.btn_type = 1 --1激活2升级
    self.con_status = true --条件是否满足
    self.cost_status = 0 --消耗是否满足
    self.bond_atr_list = {}
    self.hero_item_data_list = {}
    self.hero_item_list = {}
end

