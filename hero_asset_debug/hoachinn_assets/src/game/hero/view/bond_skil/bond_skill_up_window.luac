    self.base_name:setString(TI18N("语言_c_6195"))
    self.effect_panel = self.eff_panel:getChildByName("effect_panel")
    self.eff_name = self.effect_panel:getChildByName("eff_name")
    setTextMaxWidth(self.eff_name,90,-4)
    self.eff_name:setString(TI18N("语言_c_6219"))
    self.eff_desc = self.effect_panel:getChildByName("eff_desc")
    self.eff_desc:setScrollBarEnabled(false)
    self.con_panel = self.main_container:getChildByName("con_panel")
    self.con_title = self.con_panel:getChildByName("con_title")
    self.con_title:setString(TI18N("语言_c_6198"))
    self.con_bg = self.con_panel:getChildByName("con_bg")
    self.tip = createRichLabel(22,cc.c4b(0x7c,0x55,0x36,0xff),cc.p(0.5,0.5),cc.p(326,140),nil,nil,550)
    self.tip:setHorizontalLayoutType(2)
    self.main_container:addChild(self.tip)
    self.cost_card_panel = self.main_container:getChildByName("cost_card_panel")
    self.cost_card_bg = self.cost_card_panel:getChildByName("cost_card_bg")
    self.cost_card_title = self.cost_card_panel:getChildByName("cost_card_title")
    self.cost_panel = self.main_container:getChildByName("cost_panel")
    self.cost_title = self.cost_panel:getChildByName("cost_title")
    self.cost_title:setString(TI18N("语言_c_982"))
    self.cost_list = self.cost_panel:getChildByName("cost_bg_1")
    self.cost_list.icon = self.cost_list:getChildByName("cost_icon_1")
    self.cost_list.txt = self.cost_list:getChildByName("cost_txt_1")
    self.title_panel = self.main_container:getChildByName("title_panel")
    self.Image_2 = self.title_panel:getChildByName("Image_2")
