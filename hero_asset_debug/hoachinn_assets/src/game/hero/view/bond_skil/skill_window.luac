SkillWindow = SkillWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()

function SkillWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Full
    self.layout_name = "skill/skill_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("bondskill", "bondskill"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("bondskill", "txt_cn_bondskill"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/1", "bondskill_bg_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/1", "bondskill_bg2_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/2", "bondskill_bg_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/2", "bondskill_bg2_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/3", "bondskill_bg_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/3", "bondskill_bg2_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/4", "bondskill_bg_4"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg/4", "bondskill_bg2_4"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("bondskill/bg", "bondskill_bg_5"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("tips", "tips"), type = ResourcesType.plist}
    }

    self.view_list = {}
    self.title_list = {}
    self.role_vo = RoleController:getInstance():getRoleVo()
end

function SkillWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    -- self:setBackgroundImg("hero_resonate_bg1")

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container:setZOrder(2)
    -- self.main_container:setScale(display.getMaxScale())

    self.main_panel = self.main_container:getChildByName("main_panel")
    -- self.main_panel:setScale(display.getMaxScale())
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title = self.title_bg:getChildByName("title")
    self.title:setString(TI18N("语言_c_6215"))

    self.title_panel = self.main_container:getChildByName("title_panel")
    self.title_panel:setVisible(false)
    local mainTitle = {
        [1] = TI18N("语言_c_6215"),
        [2] = TI18N("语言_c_6216"),
    }
    for i = 1, 2 do
        local item = self.title_panel:getChildByName("title_"..i)
        item.unclick_bg = item:getChildByName("unclick_bg")
        item.click_bg = item:getChildByName("click_bg")
        item.title = item:getChildByName("title")
        item.title:setString(mainTitle[i])
        self.title_list[i] = item 
    end
    self.close_btn = self.main_container:getChildByName("close_btn")
    self:adaptationScreen()
end

--设置适配屏幕
function SkillWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)

    local container_size = self.main_container:getContentSize()
    local tab_y = self.title_panel:getPositionY()
    self.title_panel:setPositionY(top_y - (container_size.height - tab_y))
    local tab_y = self.title_bg:getPositionY()
    self.title_bg:setPositionY(top_y - (container_size.height - tab_y))
    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)
end

function SkillWindow:register_event()
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,true, 2)
    -- for k, object in pairs(self.tab_list) do
    for i = 1, 2 do
        if self.title_list[i] then
            self.title_list[i]:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playTabButtonSound()
                    if i == HeroConst.BondSkillType.efitskill then
                        message(TI18N("语言_c_6217"))
                        return
                    end
                    self:changeSelectedTab(i)
                end
            end)
        end
    end
    
    --刷新数据
    if not self.updateBond then
        self.updateBond = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Bond_Skill_Open_Event,function ( data )
			if self.select_index == HeroConst.BondSkillType.ebondskill then
                self.pre_panel:setData(self)
            end
        end)
    end
end
function SkillWindow:onClickBtnClose()
    controller:openSkillWindow(false)
end
-- 切换标签页
function SkillWindow:changeSelectedTab(index)
    for i = 1, 2 do
        if i == index then
            self.title_list[i].click_bg:setVisible(true)
            self.title_list[i].unclick_bg:setVisible(false)
            self.title_list[i].title:setColor(cc.c3b(0xf1,0xee,0xdd))
        else
            self.title_list[i].click_bg:setVisible(false)
            self.title_list[i].unclick_bg:setVisible(true)
            self.title_list[i].title:setColor(cc.c3b(0xb4,0xc4,0x87))
        end
    end
    self:setPrePanel()
end


function SkillWindow:setPrePanel()
    if not self.select_index then return end

    if self.pre_panel ~= nil then
        if self.pre_panel.setVisibleStatus then
            self.pre_panel:setVisibleStatus(false)
        else
            self.pre_panel:setVisible(false)
        end
    end
    self.pre_panel = self:createSubPanel(self.select_index)
    if self.pre_panel ~= nil then
        if self.pre_panel.setVisibleStatus then
            self.pre_panel:setVisibleStatus(true)
        else
            self.pre_panel:setVisible(true)
        end
    end
    if self.select_index == HeroConst.BondSkillType.ebondskill then
        controller:sender11400()
    else
        self.pre_panel:setData(self)
    end
end

function SkillWindow:createSubPanel(index)
    local panel = self.view_list[index]
    if panel == nil then
        if index == HeroConst.BondSkillType.ebondskill then
            --羁绊技
            panel = BondSkillPanel.new(self.partner_id)
        elseif index == HeroConst.BondSkillType.efitskill then
            --合体技
            panel = HeroResonateTabStoneTabletPanel.new()
        end
        local size = self.main_panel:getContentSize()
        panel:setPosition(cc.p(size.width * 0.5 , size.height * 0.5))
        self.main_panel:addChild(panel)
        self.view_list[index] = panel
    end
    return panel
end

function SkillWindow:openRootWnd(index,data)
    self.select_index =  index or HeroConst.BondSkillType.ebondskill
    self.partner_id = data
    self.is_send_proto = nil
    -- self:changeSelectedTab(self.select_index)
    self:setPrePanel()
    if model:getIsFirst() == 0 then
        ActionController:getInstance():sender16809(ActionStorageBool.BonsSkill, 1 ,"")
    end
end

function SkillWindow:close_callback()
    if self.updateBond then
        self.updateBond = GlobalEvent:getInstance():UnBind(self.updateBond)
        self.updateBond = nil
    end
    controller:openSkillWindow(false)
end