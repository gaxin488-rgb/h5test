end

function HeroResonateComfirmUplvPanel:register_event()
    -- 添加英雄选择返回事件
    if self.upgrade_star_select_event == nil then
        self.upgrade_star_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event, function()
            self:updateHeroItemInfo()
        end)
    end
    registerButtonEventListener(self.rule_btn, function (param,sender, event_type)
        TipsManager:getInstance():showCommonTips(TI18N("语言_res_01_11"), sender:getTouchBeganPosition())
    end, true, 2)
    registerButtonEventListener(self.background, handler(self, self.onClickBtnClose), false, 2)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose), true, 2)
    registerButtonEventListener(self.left_btn, handler(self, self.onClickBtnClose), true, 1)
    registerButtonEventListener(self.right_btn, handler(self, self.onClickBtnRight), true, 1)
    registerButtonEventListener(self.up_btn, handler(self, self.onClickBtnRight), true, 1)
    for i = 1, 2 do
        -- registerButtonEventListener(self.cost_list[i].cost_bg, function() self:onClickHeroAddBtn(i)  end ,true, 2)
        registerButtonEventListener(self.cost_list[i].add_btn, function()
            self:onClickHeroAddBtn(i)
        end, true, 2)
    end
end

-- @ bid 英雄bid 特殊判断 如果 == nil 说明是随机卡
-- @ star 星级
-- @ count 数量
-- @ camp_type 阵营  如果是随机卡.此一定需要有值
function HeroResonateComfirmUplvPanel:getHeroData(bid, star, count, camp_type)
    -- 模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s/%s", 0, count)

    if bid == nil then
        data.bid = 0 -- 表示随机卡
        data.camp_type = 0
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
            data.name = base_config.name
        else
            return nil
        end
    end
    -- 当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end

function HeroResonateComfirmUplvPanel:onClickHeroAddBtn(index)
    -- 标志点击了那个
    self.hero_item_data_list[index].is_select = true
    -- 被其他人选择的列表 [id] = hero_vo 模式
    local dic_other_selected = {}
    for i, item in ipairs(self.hero_item_data_list) do
        if i ~= index then
            for k, v in pairs(item.dic_select_list) do
                dic_other_selected[k] = v
            end
        end
    end
    local setting = {}
    controller:openHeroUpgradeStarSelectPanel(true, self.hero_item_data_list[index], dic_other_selected,
        HeroConst.SelectHeroType.eResonateCrystalHigh, setting)
end

-- 关闭
function HeroResonateComfirmUplvPanel:onClickBtnClose()
    controller:openHeroResonateComfirmUplvPanel(false)
end

-- 确定使用
function HeroResonateComfirmUplvPanel:onClickBtnRight()
    local tree_star_limit = Config.ResonateData.data_const["tree_star_limit"].val
    local maxLv = tree_star_limit[#tree_star_limit][3]
    local share_lv = model:getUpStarShareLevel()
    if share_lv >= maxLv then
        message(TI18N("语言_s_1327"))
    else
        -- print("3333333333333333333333333333333333333")
        local expend1 = {}
        local item_expend = {}
        local item_expend2 = {}
        local item_list = {}
        for key, value in pairs(self.hero_item_data_list) do
            if value.bid == 0 then
                for k, v in pairs(value.dic_select_list) do
                    if k > 0 then
                        local list = {}
                        list.partner_id = v.partner_id
                        table.insert(expend1, list)
                    else
                        local list = {}
                        list.item_id = v.good_vo.base_id
                        if item_list[list.item_id] then
                            item_list[list.item_id] = item_list[list.item_id] + 1
                        else
                            item_list[list.item_id] = 1
                        end
                    end
                end
            else
                for k, v in pairs(value.dic_select_list) do
                    if k > 0 then
                        local list = {}
                        list.partner_id = v.partner_id
                        table.insert(expend1, list)
                    else
                        local list = {}
                        list.item_id = v.good_vo.base_id
                        if item_list[list.item_id] then
                            item_list[list.item_id] = item_list[list.item_id] + 1
                        else
                            item_list[list.item_id] = 1
                        end
                    end
                end
            end
        end
        for k, v in pairs(item_list) do
            local list = {}
            list.item_id = k
            list.num = v
            table.insert(item_expend, list)
            table.insert(item_expend2, list)
        end
        local share_lv = model:getUpStarShareLevel()
        local config = Config.ResonateData.data_share_lev_up_cost[share_lv]
        local cost_data = config.cost_item
        if cost_data then
            for k, v in pairs(cost_data) do
                local bid = v[1]
                local num = v[2]
                local list = {}
                list.item_id = bid
                list.num = num
                table.insert(item_expend, list)
            end
        end
        for k, v in pairs(item_expend) do
            local have_num = BackpackController:getInstance():getModel():getItemNumByBid(v.item_id)
            if have_num < v.num then
                BackpackController:getInstance():openTipsSource(true, v.item_id)
                self:onClickBtnClose()
                return
            end
        end

        if config and next(config.cost_p) ~= nil then
            local num = tableLen(config.cost_p)
            for i = 1, num do
                if tableLen(self.hero_item_data_list[i].dic_select_list) < config.cost_p[i][3] then
                    message(TI18N("语言_c_3781"))
                    return
                end
            end
        end
        controller:sender26450(expend1, item_expend2)
    end
    self:onClickBtnClose()
end

function HeroResonateComfirmUplvPanel:openRootWnd()
    local share_lv = model:getUpStarShareLevel()
    local next_share_lv = share_lv + 1
    local tree_star_limit = Config.ResonateData.data_const["tree_star_limit"].val
    local cur_star = 14
    local cur_star_step = 0
    local next_star = 1
    local next_star_step = 0
    for k, v in pairs(tree_star_limit) do
        if v[3] == share_lv then
            cur_star = v[1]
            cur_star_step = v[2]
        end
        if v[3] == next_share_lv then
            next_star = v[1]
            next_star_step = v[2]
        end
    end
    self.left_lv:setString(string.format(TI18N("语言_c_4712"), share_lv))
    self.right_lv:setString(string.format(TI18N("语言_c_4712"), next_share_lv))
    self:createStar(self.left_star, cur_star)
    self:createStar(self.right_star, next_star)
    self.left_star_step:setString(string.format(TI18N("语言_c_6282"), cur_star_step))
    self.right_star_step:setString(string.format(TI18N("语言_c_6282"), next_star_step))
    self:updateAttrPanel(share_lv)
    self:updateHeroPanel(share_lv)
    self:updateCostInfo(share_lv)
end

function HeroResonateComfirmUplvPanel:updateAttrPanel(share_lv)
    local cfg = Config.ResonateData.data_share_lev_up_cost[share_lv+1]
    if cfg.attr and next(cfg.attr) then
        self.item_list = {}
        for i = 1, tableLen(cfg.attr) do
            local item = ccui.Layout:create()
            item:setAnchorPoint(cc.p(0.5, 0))
            item:setContentSize(cc.size(560, 30))
            self.attr_panel:addChild(item)
            item.icon = createSprite(PathTool.getResFrame("common", "common_90021"),200,15,item,cc.p(0.5,0.5))
            item.icon:setScale(0.8)
            if item.txt then
                item.txt:removeAllChildren()
                item.txt:removeFromParent()
                item.txt = nil
            end
            if not item.txt then
                -- if model:checkEnoughResUpStar(cfg.level) then
                item.txt = createLabel(20,cc.c3b(0xff,0xff,0xff),cc.c3b(0x00,0x00,0x00),230,15,"",item,2,cc.p(0,0.5))
                -- else
                --     item.txt = createLabel(20,cc.c3b(0x89,0x78,0x65),nil,230,15,"",item,nil,cc.p(0,0.5))
                -- end
            end
            local attr_key = cfg.attr[i][1]
            local attr_val = cfg.attr[i][2]
            local res_id = PathTool.getAttrIconByStr(attr_key)
            local res = PathTool.getResFrame("common",res_id)
            loadSpriteTexture(item.icon, res, LOADTEXT_TYPE_PLIST)
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10).."%"
            end
            item.txt:setString(attr_name.."+"..attr_val)
            item.index = i
            self.item_list[i] = item
            item:setPositionX(339)
            item:setPositionY(self.attr_panel:getContentSize().height-40-i*30)
        end
        self.attr_panel:setVisible(true)
        self.star_panel:setPositionY(566)
        self.hero_panel:setPositionY(279)
    else
        self.attr_panel:setVisible(false)
        self.star_panel:setPositionY(513)
        self.hero_panel:setPositionY(315)
    end
end
function HeroResonateComfirmUplvPanel:updateHeroPanel(share_lv)
    local cfg = Config.ResonateData.data_share_lev_up_cost[share_lv + 1]
    local next_star = cfg.star[1][1]
    self.name_list = {}
    for key, value in pairs(model:getUpStarReList()) do
        local hero_vo = model:getHeroById(value.id)
        local max_num = Config.PartnerData.data_partner_max_star[hero_vo.bid] or 0
        local hero_cfg = Config.PartnerData.data_partner_base[hero_vo.bid]
        if max_num >= next_star then
            local item = createLabel(20,cc.c3b(0x49,0xd8,0x09),cc.c3b(0x00,0x00,0x00),self.hero_scroll:getContentSize().width*0.5,15,hero_cfg.name,self.hero_scroll,2,cc.p(0.5,0.5))
            table.insert(self.name_list,item)
        end
    end
    local _h = math.max(tableLen(self.name_list)*30,self.hero_scroll:getContentSize().height)
    self.hero_scroll:setInnerContainerSize(cc.size(self.hero_scroll:getContentSize().width,_h))
    for i = 1, tableLen(self.name_list) do
        self.name_list[i]:setPositionY(_h-(i-0.5)*30)
    end
end

function HeroResonateComfirmUplvPanel:updateHeroItemInfo()
    for i = 1, 2 do
        local list = self.cost_list[i]
        local cost_txt = self.cost_bg_list[i].cost_txt
        local data = self.hero_item_data_list[i]
        if data then
            list.cost_txt:setString(string.format("%s/%s", tableLen(data.dic_select_list), data.count))
            if tableLen(data.dic_select_list) >= data.count then
                list.hero_item:setHeadUnEnabled(false)
                addRedPointToNodeByStatus(list.add_btn,false)
            else
                list.hero_item:setHeadUnEnabled(true)
                local status = model:checkSingleStarFuseRedPointByStarConfig({lev_up_expend2={},lev_up_expend3={list.data}})
                addRedPointToNodeByStatus(list.add_btn,status,15,15)
            end
        end
    end
end

function HeroResonateComfirmUplvPanel:createStar(parent_panel, num)
    local spine = parent_panel
    parent_panel.star_node = cc.Node:create()
    parent_panel.star_node:setCascadeOpacityEnabled(true)
    parent_panel.star_node:setName("createStar")
    parent_panel.star_node:setPosition(90, 15)
    parent_panel:addChild(parent_panel.star_node)
    local num = num or 0
    local width = 26
    parent_panel.star_setting = model:createStar(num, parent_panel.star_node, parent_panel.star_setting, width)
end

function HeroResonateComfirmUplvPanel:updateCostInfo(lev)
    local config = Config.ResonateData.data_share_lev_up_cost[lev]
    self.cost_panel:setVisible(false)
    self.up_btn:setVisible(false)
    self.max_tips:setVisible(false)
    self.btn_panel:setVisible(false)
    if config then
        if #config.cost_item <= 0 and #config.cost_p <= 0 then
            self.up_btn:setVisible(true)
            self.max_tips:setVisible(true)
        else
            self.cost_panel:setVisible(true)
            self.btn_panel:setVisible(true)
        end
    end
    local status = tableLen(config.cost_item) > 3
    if config and next(config.cost_item) ~= nil then
        local num = tableLen(config.cost_item)
        for i = 1, num do
            local cost_data = config.cost_item[i]
            local cost_icon = self.cost_bg_list[i].cost_icon
            local cost_txt = self.cost_bg_list[i].cost_txt
            if cost_data then
                local bid = cost_data[1]
                local num = cost_data[2]
                local item_config = Config.ItemData.data_get_data(bid)
                if item_config then
                    cost_icon:loadTexture(PathTool.getItemRes(item_config.icon), LOADTEXT_TYPE)
                    local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
                    cost_txt:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(num))
                    if have_num >= num then
                        cost_txt:setTextColor(cc.c3b(255, 246, 228))
                    else
                        cost_txt:setTextColor(cc.c3b(0xff, 0x15, 0x15))
                    end
                end
            else
                cost_txt:setString("")
            end
        end
        for i = 1, 6 do
            if i > num then
                self.cost_bg_list[i].cost_bg:setVisible(false)
            else
                self.cost_bg_list[i].cost_bg:setVisible(true)
                self.cost_bg_list[i].cost_bg:setPositionX(cost1_pos_list[num][i].x)
                self.cost_bg_list[i].cost_bg:setPositionY(status and cost1_pos_list[num][i].y or cost1_pos_list[num][i].y-20)
            end
        end
    end

    if config and next(config.cost_p) ~= nil then
        local num = tableLen(config.cost_p)
        for i = 1, tableLen(config.cost_p) do
            local list = self.cost_list[i]
            if not list.hero_item then
                local hero_item = HeroExhibitionItem.new(0.4, false, 0, false, true)
                hero_item:setPosition(cc.p(23, 23))
                list.icon:addChild(hero_item)
                list.hero_item = hero_item
            end
            self.hero_item_data_list[i] = self:getHeroData(nil, config.cost_p[i][2], config.cost_p[i][3],
                config.cost_p[i][1])
            list.hero_item:setData(self.hero_item_data_list[i])
            list.hero_item:setLev(nil)
            local default_head_id = model:getRandomHeroHeadByQuality(
                self.hero_item_data_list[i] and self.hero_item_data_list[i].star)
            list.hero_item:setDefaultHead(default_head_id)
            list.cost_tip:setString(string.format(TI18N("语言_c_3022"), config.cost_p[i][2]))
            list.cost_txt:setString(string.format("%s/%s", tableLen(self.hero_item_data_list[i].dic_select_list),
                config.cost_p[i][3]))
            list.data = config.cost_p[i]
        end
        for i = 1, 2 do
            if i > num then
                self.cost_list[i].cost_bg:setVisible(false)
            else
                self.cost_list[i].cost_bg:setVisible(true)
                self.cost_list[i].cost_bg:setPositionX(cost_pos_list[num][i].x)
                self.cost_list[i].cost_bg:setPositionY(status and cost_pos_list[num][i].y or cost_pos_list[num][i].y+20)
            end
        end
        self:updateHeroItemInfo()
    end
end

function HeroResonateComfirmUplvPanel:close_callback()
    if self.left_hero_item then
        self.left_hero_item:DeleteMe()
        self.left_hero_item = nil
    end

    if self.right_hero_item then
        self.right_hero_item:DeleteMe()
        self.right_hero_item = nil
    end
    if self.upgrade_star_select_event then
        GlobalEvent:getInstance():UnBind(self.upgrade_star_select_event)
        self.upgrade_star_select_event = nil
    end
    controller:openHeroResonateComfirmUplvPanel(false)
end
