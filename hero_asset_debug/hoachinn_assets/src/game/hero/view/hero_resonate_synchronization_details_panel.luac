-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      共鸣水晶同步进度
-- <br/> 2020年3月6日
-- --------------------------------------------------------------------
HeroResonateSynchronizationDetailsPanel = HeroResonateSynchronizationDetailsPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()


function HeroResonateSynchronizationDetailsPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big
    self.camp_btn_list = {}
    self.is_full_screen = false
    self.click_index = 1
    self.click_sort = 1 -- 1大-小 2 小-大
    self.layout_name = "hero/hero_resonate_synchronization_details_panel"

    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"), type = ResourcesType.plist },
    }
    
end

function HeroResonateSynchronizationDetailsPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2)  
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title = self.main_container:getChildByName("title")
    self.title:setString(TI18N("语言_c_6504"))
    local _w = math.max(self.title:getContentSize().width+120,self.title_bg:getContentSize().width)
    self.title_bg:setContentSize(cc.size(_w, self.title_bg:getContentSize().height))
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.hero_panel = self.main_container:getChildByName("hero_panel")
    self.hero_img = self.hero_panel:getChildByName("hero_img")
    self.hero_name = self.hero_panel:getChildByName("hero_name")
    self.tip = self.main_container:getChildByName("tip")
    self.activation_tip = self.main_container:getChildByName("activation_tip")
    self.finish_txt = self.main_container:getChildByName("finish_txt")
    self.finish_txt:setString(transformTextToShort(TI18N("语言_c_6505"),13))
    addEvt2showAllTextTips(self.finish_txt,TI18N("语言_c_6505"),13)
    self.finish_val = self.main_container:getChildByName("finish_val")
    self.item_panel = self.main_container:getChildByName("item_panel")
end

function HeroResonateSynchronizationDetailsPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickBtnClose) ,false, 2)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,false, 2)
end

--关闭
function HeroResonateSynchronizationDetailsPanel:onClickBtnClose()
    controller:openHeroResonateSynchronizationDetailsPanel(false)
end

function HeroResonateSynchronizationDetailsPanel:openRootWnd(bid)
    local data = model:getResonateDetailsForBid(bid)
    local star = data and data.star or 5
    self.sync_cfg = Config.ResonateData.data_crystal_sync_exp[bid]
    self.reward_list = {}
    for k, v in pairs(self.sync_cfg) do
        if v.id ~= 0 then
            table.insert(self.reward_list, v)
        end
    end
    table.sort(self.reward_list,function(a,b) return a.id < b.id end)
    self.cfg = self.sync_cfg[star]
    loadSpriteTexture(self.hero_img, PathTool.getPartnerBustRes(self.cfg.show_partner), LOADTEXT_TYPE)
    self.hero_img:setPosition(cc.p(495 + self.cfg.x_offset,210 + self.cfg.y_offset))
    local res = PathTool.checkRes(string_format("resource/sync/sync_ninja_name/%s.png", self.cfg.name_pic))
    loadSpriteTexture(self.hero_name, res, LOADTEXT_TYPE)
    if not self.head_icon then
        self.head_icon = BackPackItem.new(false, true, false, 0.8, false, true)
        self.main_container:addChild(self.head_icon)
        self.head_icon:setPosition(cc.p(335,97))
    end
    for k, v in pairs(self.sync_cfg) do
        if v.unlock_face ~= 0 then
            self.head_icon:setData({v.unlock_face,1})
        end
    end
    local unlock_star = 0
    for k,v in pairs(self.reward_list) do
        if v.unlock_face ~= 0 then
            unlock_star = v.star
        end
    end
    local max_star = self.reward_list[tableLen(self.reward_list)].star
    if star >= unlock_star then
        self.tip:setString(TI18N("语言_c_6506"))
        self.tip:setTextColor(cc.c4b(0x19,0xcd,0x19,0xff))
        self.tip:enableOutline(cc.c4b(0x00,0x00,0x00,0xff),2)
    else
        self.tip:setString(TI18N("语言_c_6496"))
        self.tip:setTextColor(cc.c4b(0xff,0x15,0x15,0xff))
        self.tip:enableOutline(cc.c4b(0x00,0x00,0x00,0xff),2)
    end
    local str = LangStringFormat(TI18N("语言_c_6507"),unlock_star,Config.PartnerData.data_partner_base[bid].name)
    self.activation_tip:setString(transformTextToShort(str,40))
    addEvt2showAllTextTips(self.activation_tip,str,40)
    if data then
        self.finish_val:setString(string.format("%s/%s",star,max_star))
    else
        self.finish_val:setString(string.format("%s/%s",0,max_star))
    end
    
    ---进度条相关
    local scroll_view_size2 = self.item_panel:getContentSize()
    local setting = {
        start_x = -2, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 143, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.reward_num_item = CommonScrollViewSingleLayout.new(self.item_panel, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    self.reward_num_item:reloadData()
end

-- 进度条
-- 功勋数数列表
function HeroResonateSynchronizationDetailsPanel:createTaskCell2()
    local cell = HeroResonateSynchronizationDetailsItem.new()
    return cell
end

function HeroResonateSynchronizationDetailsPanel:numberOfTaskCells2()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function HeroResonateSynchronizationDetailsPanel:updateTaskCellByIndex2(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,index,self.reward_list)
end
function HeroResonateSynchronizationDetailsPanel:close_callback()
    
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    self:onClickBtnClose()
end


--------------------------------
-- 功勋子项
HeroResonateSynchronizationDetailsItem = class("HeroResonateSynchronizationDetailsItem", function()
    return ccui.Widget:create()
end)

function HeroResonateSynchronizationDetailsItem:ctor()
    self.size = cc.size(143, 139)
    self:configUI()
    self:register_event()
end

function HeroResonateSynchronizationDetailsItem:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("sync", "sync_4"),
    72,81, cc.p(0.5, 1), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(153, 47))
    self.num_txt = createRichLabel(18,cc.c3b(0xff,0xff,0xff),cc.p(0.5,1),cc.p(65,79),nil,nil,120)
    self.root_wnd:addChild(self.num_txt)
    if self.star_node == nil then
		self.star_node = cc.Node:create()
		self.star_node:setPosition(99, 110)
		self.root_wnd:addChild(self.star_node)
        self.star_node:setScale(0.9)
	end
end

function HeroResonateSynchronizationDetailsItem:register_event()
end

function HeroResonateSynchronizationDetailsItem:setData(data,index,all_list)
    if not data then
        return
    end
    self.data = data
    self.all_list = all_list
    if not self.select_img then 
        self.select_bg = createSprite(PathTool.getResFrame("planesafkorderaction","planesafkaction_2"),33,107,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
        setChildUnEnabled(true,self.select_bg)
        self.select_img = createSprite(PathTool.getResFrame("planesafkorderaction","planesafkaction_1"),33,107,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    end
    self.select_img:setVisible(false)
    if self.data.star < self.all_list[tableLen(self.all_list)].star then
        if self.comp_bar == nil then
            local size = cc.size(139, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(50, 77))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), -14, -17, true, true, 0, 0)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(110, 27))
            self.comp_bar:setContentSize(cc.size(110, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        local list = model:getResonateDetailsForBid(self.data.bid)
        local star = 0
        if list then
            star = list.star
        end
        if self.data then
            local nextData = self.all_list[self.data.id + 1]
            if star >= self.data.star then
                self.select_img:setVisible(true)
                if nextData and star < nextData.star then
                    self.comp_bar:setPercent((star - self.data.star)/(nextData.star - self.data.star)*100)
                else
                    self.comp_bar:setPercent(100)
                end
            else
                self.comp_bar:setPercent(0)
            end
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
        local list = model:getResonateDetailsForBid(self.data.bid)
        local star = 0
        if list then
            star = list.star
        end
        if self.data.star == star then
            self.select_img:setVisible(true)
        end
    end
    if self.select_img:isVisible() then
        self.num_txt:setString(string.format(TI18N("语言_c_6502"),data.exp))
        self.num_bg:loadTexture(PathTool.getResFrame("sync", "sync_4"), LOADTEXT_TYPE_PLIST)
    else
        self.num_txt:setString(string.format(TI18N("语言_c_6503"),data.exp))
        self.num_bg:loadTexture(PathTool.getResFrame("sync", "sync_3"), LOADTEXT_TYPE_PLIST)
    end
    local _h = math.max(57,self.num_txt:getContentSize().height+10)
    self.num_bg:setContentSize(cc.size(self.num_bg:getContentSize().width,_h))
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(index)
    
    if self.star_setting and self.star_setting.star_list then
        for i,v in pairs(self.star_setting.star_list) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        self.star_setting.star_list = {}
    end
    if self.star_setting and self.star_setting.star_list2 then
        for i,v in pairs(self.star_setting.star_list2) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        self.star_setting.star_list2 = {}
    end
    if self.star_setting and self.star_setting.star10 and not tolua.isnull(self.star_setting.star10) then
        self.star_setting.star10:removeFromParent()
        self.star_setting.star10 = nil
    end
    if self.star_setting and self.star_setting.moon and not tolua.isnull(self.star_setting.moon) then
        self.star_setting.moon:removeFromParent()
        self.star_setting.moon = nil
    end
    self.star_setting = HeroController:getInstance():getModel():createStar(self.data.star, self.star_node, self.star_setting, 17)
end

function HeroResonateSynchronizationDetailsItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end

