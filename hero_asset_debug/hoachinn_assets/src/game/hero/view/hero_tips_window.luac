-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      献祭卸下英雄信息tips
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
HeroTipsWindow = HeroTipsWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort

function HeroTipsWindow:__init()
    self.pos_list = {} 
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_tips_window"
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end

function HeroTipsWindow:open_callback()
    self.background_panel = self.root_wnd:getChildByName("background_panel")
    if self.background_panel ~= nil then
        self.background_panel:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.line = self.main_panel:getChildByName("line")
    self.main_container = self.main_panel:getChildByName("main_container")
    self.title_container = self.main_panel:getChildByName("title_container")
    self.Image_1_0 = self.title_container:getChildByName("Image_1_0")
    self.title_label = self.title_container:getChildByName("title_label")
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_label = self.ok_btn:getChildByName("label")
    self.ok_label:setString(TI18N("语言_c_3"))
    self.cancel_btn = self.main_panel:getChildByName("cancel_btn")
    self.cancel_label = self.cancel_btn:getChildByName("label")
    self.cancel_label:setString(TI18N("语言_c_10"))
    
end
function HeroTipsWindow:openRootWnd(data , hero_vo)
    self.title_label:setString(TI18N("语言_c_154"))
    self.hero_id = hero_vo.id
    self.tips_label = createRichLabel(24, 175, cc.p(0.5,0.5), cc.p(0,50), nil, nil, 580)
    local str = string.format(TI18N("语言_c_4570"),data)
    self.tips_label:setString(str)
    self.main_container:addChild(self.tips_label)
    local main_size = self.main_container:getSize()
    local main_height = main_size.height
    local main_width = main_size.width
    local label_x = main_width / 2
    local label_y = main_height / 2
    self.tips_label:setPosition(label_x,label_y)
    for key, value in pairs(hero_vo.dic_in_form) do
        local fun_form_type = key
        if fun_form_type == PartnerConst.Fun_Form.EliteMatch then
            ElitematchController:getInstance():sender24920(1)
        elseif fun_form_type == PartnerConst.Fun_Form.EliteKingMatch then
            ElitematchController:getInstance():sender24920(2)
        elseif fun_form_type == PartnerConst.Fun_Form.CrossArenaDef then
            CrossarenaController:getInstance():sender25605(2)
        elseif fun_form_type == PartnerConst.Fun_Form.ArenapeakchampionDef then
            ArenapeakchampionController:getInstance():sender27726()
        else 
            --其他的都根据协议获取阵容
            controller:sender11211(fun_form_type)
        end
    end
    
end
function HeroTipsWindow:register_event()
    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn()  end ,true, 2, nil , 0.8)
    registerButtonEventListener(self.cancel_btn, function() self:onClickCloseBtn()  end ,true, 2, nil , 0.8)
    registerButtonEventListener(self.ok_btn, function() self:onClickOkBtn()  end ,true, 2, nil , 0.8)
    self:addGlobalEvent(ElitematchEvent.Update_Elite_Fun_Form, function(data)
        if not data then return end
        for key, value in pairs(data.formations) do
            local list = value.pos_info
            for key, value in pairs(list) do
                if value.id == self.hero_id then
                    table.remove(list,key)
                end
            end
        end
        table_insert(self.pos_list,PartnerConst.Fun_Form.EliteMatch,data.formations)
    end)
    self:addGlobalEvent(CrossarenaEvent.Update_Form_Data_Event, function(data)
        if not data then return end
        for key, value in pairs(data.formations) do
            local list = value.pos_info
            for key, value in pairs(list) do
                if value.id == self.hero_id then
                    table.remove(list,key)
                end
            end
        end
        table_insert(self.pos_list,PartnerConst.Fun_Form.CrossArenaDef,data.formations)
    end)
    self:addGlobalEvent(ArenapeakchampionEvent.ARENAPEAKCHAMPION_FROM_EVENT, function(data)
        if not data then return end
        for key, value in pairs(data.formations) do
            local list = value.pos_info
            for key, value in pairs(list) do
                if value.id == self.hero_id then
                    table.remove(list,key)
                end
            end
        end
        table_insert(self.pos_list,PartnerConst.Fun_Form.ArenapeakchampionDef,data.formations)
    end)
    self:addGlobalEvent(HeroEvent.Update_Fun_Form, function(data)
        if not data then return end
        local list = data.pos_info
        for key, value in pairs(list) do
            if value.id == self.hero_id then
                table.remove(list,key)
            end
        end
        table_insert(self.pos_list,data)
    end)
end
--确认
function HeroTipsWindow:onClickOkBtn()
    for key, value in pairs(self.pos_list) do
        if key == PartnerConst.Fun_Form.EliteMatch then
            ElitematchController:getInstance():sender24921(1,value,1)
        elseif key == PartnerConst.Fun_Form.EliteKingMatch then
            ElitematchController:getInstance():sender24921(2,value,1)
        elseif key == PartnerConst.Fun_Form.CrossArenaDef then
            CrossarenaController:getInstance():sender25604( 2, value , 1)
        elseif key == PartnerConst.Fun_Form.ArenapeakchampionDef then
            ArenapeakchampionController:getInstance():sender27725(value,1)
        else 
            controller:sender11212(value.type,value.formation_type,value.pos_info,value.hallows_id,1)
        end
    end
    GlobalEvent:getInstance():Fire(HeroEvent.Hero_Sacrifice_bttom_Event)
    controller:openHeroTipsWindow(false)
end

--关闭
function HeroTipsWindow:onClickCloseBtn()
    controller:openHeroTipsWindow(false)
end

function HeroTipsWindow:close_callback()
    controller:openHeroTipsWindow(false)
end
