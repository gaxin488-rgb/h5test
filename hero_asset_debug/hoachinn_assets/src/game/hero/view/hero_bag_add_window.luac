--------------------------------------------
--忍者背包扩容
---------------------------------
HeroBagAddWindow = HeroBagAddWindow or BaseClass(BaseView)

local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroBagAddWindow:__init()
	self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "hero/hero_bag_add_window"
    self.role_vo = RoleController:getInstance():getRoleVo()
	self.res_list = {
		
	}
end

function HeroBagAddWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    self.bg = self.main_container:getChildByName("bg")
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.tip_scroll = self.main_container:getChildByName("tip_scroll")
    self.tip_scroll:setScrollBarEnabled(false)
    self.tip_txt = createRichLabel(20,cc.c3b(0x5a,0x1b,0x07),cc.p(0,1),cc.p(0,0),-4,nil,300)
    self.tip_scroll:addChild(self.tip_txt)
    self.item_scroll = self.main_container:getChildByName("item_scroll")
    self.item_scroll:setScrollBarEnabled(false)
    self.buy_txt = createRichLabel(22,cc.c3b(0x7c,0x55,0x36),cc.p(0.5,0.5),cc.p(333,170),-4,nil,600)
    self.main_container:addChild(self.buy_txt)
    self.jump_btn = self.main_container:getChildByName("jump_btn")
    self.jump_txt = self.jump_btn:getChildByName("jump_txt")
    self.jump_txt:setChangeScaleOffWidth(-9999)
    setTextMaxWidth(self.jump_txt,120)
    self.jump_txt:setString(TI18N("语言_c_1680"))
    self.Image_1 = self.main_container:getChildByName("Image_1")
    self.title = self.main_container:getChildByName("title")
    self.title:setString(TI18N("语言_c_154"))
    autoSizeTitleBg(self.title,self.Image_1,120,300)
    self.back_btn = self.main_container:getChildByName("back_btn")
    self.back_txt = self.back_btn:getChildByName("back_txt")
    self.back_txt:setString(TI18N("语言_c_62"))
    self.ok_btn = self.main_container:getChildByName("ok_btn")
    self.ok_txt = self.ok_btn:getChildByName("ok_txt")
    self.ok_txt:setString(TI18N("语言_c_63"))
end

function HeroBagAddWindow:register_event(  )
    registerButtonEventListener(self.background, function ( )
		_controller:openHeroBagAddWindow(false)
    end)
    registerButtonEventListener(self.close_btn, function ( )
		_controller:openHeroBagAddWindow(false)
    end,true)
    registerButtonEventListener(self.back_btn, function ( )
		_controller:openHeroBagAddWindow(false)
    end,true)
    registerButtonEventListener(self.ok_btn, function ( )
        _controller:sender11009()
		_controller:openHeroBagAddWindow(false)
    end,true)
    registerButtonEventListener(self.jump_btn, function ( )
        VipController:getInstance():openVipMainWindow(true, VIPTABCONST.CHARGE)
		_controller:openHeroBagAddWindow(false)
    end,true)
end
function HeroBagAddWindow:openRootWnd()
    local buy_num = _model:getHeroBuyNum()
    local config = Config.PartnerData.data_partner_buy[buy_num + 1]
    if config then 
        local item_id = config.expend[1][1] or 3
        local count = config.expend[1][2] or 100
        local iconsrc = PathTool.getItemRes(Config.ItemData.data_get_data(item_id).icon)
        local str = string_format(TI18N("语言_c_3105"), iconsrc, count, config.add_num)
        self.buy_txt:setString(str)
    else
        self.buy_txt:setString(TI18N("语言_s_1868"))
    end
    local txt = TI18N("语言_c_7359")
    local vip_lev = self.role_vo.vip_lev
    local cfg = Config.VipData.data_get_vip_info[vip_lev+1]
    local bag_add_num = 0
    if cfg then
        for k, v in pairs(cfg.val) do
            if v[1] == "baglimit" then
                bag_add_num = v[2]
            end
        end
    end
    local now_cfg = Config.VipData.data_get_vip_info[vip_lev]
    local bag_add_num2 = 0
    if now_cfg then
        for k, v in pairs(now_cfg.val) do
            if v[1] == "baglimit" then
                bag_add_num2 = v[2]
            end
        end
    end
    local max, count = _model:getHeroMaxCount()
    local str = LangStringFormat(txt,vip_lev+1,max+(bag_add_num-bag_add_num2),max)
    self.tip_txt:setString(str)
    local _h = math.max(self.tip_scroll:getContentSize().height,self.tip_txt:getContentSize().height)
    self.tip_scroll:setInnerContainerSize(cc.size(self.tip_scroll:getContentSize().width,_h))
    self.tip_txt:setPositionY(_h)

    local reward_cfg = Config.VipData.data_get_reward[vip_lev+1]
    if reward_cfg then
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 0
        setting.max_count = 3
        setting.is_center = false
        self.item_list = commonShowSingleRowItemList(self.item_scroll, self.item_list, reward_cfg.items, setting)
    end
end
function HeroBagAddWindow:close_callback(  )
    _controller:openHeroBagAddWindow(false)
end