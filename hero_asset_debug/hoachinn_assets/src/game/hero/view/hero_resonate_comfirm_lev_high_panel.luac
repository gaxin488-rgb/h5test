HeroResonateComfirmLevHighPanel = HeroResonateComfirmLevHighPanel or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local cost_pos_list = {
    [1] = {cc.p(339,86)},
    [2] = {cc.p(203,86),cc.p(474,86)},
}


function HeroResonateComfirmLevHighPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big   
    self.is_full_screen = false
    self.layout_name = "hero/hero_resonate_comfirm_lev_high_panel"

    self.res_list = {
        -- { path = PathTool.getPlistImgForDownLoad("planes","planes_map"), type = ResourcesType.plist }
    }
    
end

function HeroResonateComfirmLevHighPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2)  
    self.main_panel = self.main_container:getChildByName("main_panel")
    self.panel_bg = self.main_panel:getChildByName("panel_bg")
    self.title_panel = self.main_panel:getChildByName("title_panel")
    self.Image_2 = self.title_panel:getChildByName("Image_2")
    self.win_title = self.title_panel:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_766"))
    self.close_btn = self.title_panel:getChildByName("close_btn")
    self.lev_panel = self.main_panel:getChildByName("lev_panel")
    self.lev_key = self.lev_panel:getChildByName("lev_key")
    self.lev_key:setString(TI18N("语言_c_3107"))
    self.left_lv = self.lev_panel:getChildByName("left_lv")
    self.right_lv = self.lev_panel:getChildByName("right_lv")
    self.power_panel = self.main_panel:getChildByName("power_panel")
    self.power_key = self.power_panel:getChildByName("power_key")
    self.power_key:setString(TI18N("语言_c_3108"))
    self.left_power = createRichLabel(24, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5, 0.5), cc.p(210,43),nil,nil,600)
    self.power_panel:addChild(self.left_power)
    self.right_power = createRichLabel(24, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0.5, 0.5), cc.p(460,43),nil,nil,600)
    self.power_panel:addChild(self.right_power)
    self.node_panel = self.main_panel:getChildByName("node_panel")
    self.node_key = self.node_panel:getChildByName("node_key")
    self.node_key:setString(TI18N("语言_c_6491"))
    self.cost_panel = self.main_panel:getChildByName("cost_panel")
    self.cost_other = self.cost_panel:getChildByName("cost_other")
    self.cost_other_icon = self.cost_other:getChildByName("cost_icon")
    self.cost_other_txt = self.cost_other:getChildByName("cost_txt")
    self.cost_bg_list = {}
    for i=1, 3 do
        local cost_bg = self.cost_panel:getChildByName("cost_bg_"..i)
        self.cost_bg_list[i] = {}
        self.cost_bg_list[i].cost_bg = cost_bg
        self.cost_bg_list[i].cost_icon = cost_bg:getChildByName("cost_icon")
        self.cost_bg_list[i].cost_txt = cost_bg:getChildByName("cost_txt")
    end
    self.cost_list = {}
    for i=1, 2 do
        local cost_bg = self.cost_panel:getChildByName("cost_"..i)
        self.cost_list[i] = {}
        self.cost_list[i].cost_bg = cost_bg
        self.cost_list[i].icon = cost_bg:getChildByName("icon")
        self.cost_list[i].cost_tip = cost_bg:getChildByName("cost_tip")
        self.cost_list[i].cost_txt = cost_bg:getChildByName("cost_txt")
        self.cost_list[i].cost_bg:setVisible(false)
    end
    self.cost_appoint = self.cost_panel:getChildByName("cost_appoint")
    self.cost_appoint_icon = self.cost_appoint:getChildByName("icon")
    self.cost_appoint_tip = self.cost_appoint:getChildByName("cost_tip")
    self.cost_appoint_txt = self.cost_appoint:getChildByName("cost_txt")
    self.cost_appoint_list = {
        cost_bg = self.cost_appoint,
        icon = self.cost_appoint_icon,
        cost_tip = self.cost_appoint_tip,
        cost_txt = self.cost_appoint_txt
    }
    self.btn_panel = self.main_panel:getChildByName("btn_panel")
    self.left_btn = self.btn_panel:getChildByName("left_btn")
    self.left_txt = self.left_btn:getChildByName("label")
    self.left_txt:setString(TI18N("语言_c_395"))
    self.right_btn = self.btn_panel:getChildByName("right_btn")
    self.right_txt = self.right_btn:getChildByName("label")
    self.right_txt:setString(TI18N("语言_c_261"))
end

function HeroResonateComfirmLevHighPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickBtnClose) ,false, 2)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,true, 2)
    registerButtonEventListener(self.left_btn, handler(self, self.onClickBtnClose) ,true, 1)
    registerButtonEventListener(self.right_btn, handler(self, self.onClickBtnRight) ,true, 1)

    self:addGlobalEvent(HeroEvent.Hero_Resonate_Crystal_Power_Event, function(data)
        if not data then return end
        self:setPowerInfo(data.power)
    end)
end

--关闭
function HeroResonateComfirmLevHighPanel:onClickBtnClose()
    controller:openHeroResonateComfirmLevHighPanel(false)
end


-- 确定使用
function HeroResonateComfirmLevHighPanel:onClickBtnRight()
    if self.power then
        if model.resonate_cystal_lev >= model:getMaxCystalLev() then
            message(TI18N("语言_s_1327"))
        else
            local expend1 = {}
            local expend2 = {}
            local item_expend = {}
            local item_list = {}
            for key, value in pairs(self.hero_item_data_list) do
                if value.bid == 0 then
                    for k, v in pairs(value.dic_select_list) do
                        if k > 0 then
                            local list = {}
                            list.partner_id = v.partner_id
                            table.insert(expend2,list)
                        else
                            local list = {}
                            list.item_id = v.good_vo.base_id
                            if item_list[list.item_id] then
                                item_list[list.item_id] = item_list[list.item_id] + 1
                            else
                                item_list[list.item_id] = 1
                            end
                        end
                    end
                else
                    for k, v in pairs(value.dic_select_list) do
                        if k > 0 then
                            local list = {}
                            list.partner_id = v.partner_id
                            table.insert(expend1,list)
                        else
                            local list = {}
                            list.item_id = v.good_vo.base_id
                            if item_list[list.item_id] then
                                item_list[list.item_id] = item_list[list.item_id] + 1
                            else
                                item_list[list.item_id] = 1
                            end
                        end
                    end
                end
            end
            for k, v in pairs(item_list) do
                local list = {}
                list.item_id = k
                list.num = v
                table.insert(item_expend,list)
            end
            local config = Config.ResonateData.data_crystal_cost_h[self.setting.left_lv]
            local cost_data = config.lev_up_expend[1]
            if cost_data then
                local bid = cost_data[1]
                local num = cost_data[2]
                local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
                if have_num < num then
                    BackpackController:getInstance():openTipsSource(true, bid) 
                    self:onClickBtnClose()
                    return
                end
            end
            local cost_data = config.cost
            if cost_data then
                for k, v in pairs(cost_data) do
                    local bid = v[1]
                    local num = v[2]
                    local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
                    if have_num < num then
                        BackpackController:getInstance():openTipsSource(true, bid) 
                        self:onClickBtnClose()
                        return
                    end
                end
            end
            controller:sender26433(expend1,expend2,item_expend)
        end
    end
    self:onClickBtnClose()
end
--setting
--setting.left_lv 
--setting.right_lv 
--setting.left_power
--setting.right_power

function HeroResonateComfirmLevHighPanel:openRootWnd(setting)
    controller:sender26431()
    self.node_list = {}
    self.setting = setting
    local setting = setting or {}
    local left_lv = setting.left_lv or 0
    local right_lv = setting.right_lv or 0 
    local left_power = setting.left_power or 0
    self.hero_item_data_list = setting.hero_item_data_list or {}
    self.left_lv:setString(string.format(TI18N("语言_c_4712"),left_lv))
    self.right_lv:setString(string.format(TI18N("语言_c_4712"),right_lv))
    local res = PathTool.getResFrame("common", "common_2016")
    local str = string.format("<img src='%s' scale=1 /><div fontsize=24 outline=2,#000000>%s</div>",res,MoneyTool.moneyFormat(left_power))
    self.left_power:setString(str)
    self:updateCostInfo(left_lv)
    self:setNodeInfo(left_lv)
end
function HeroResonateComfirmLevHighPanel:setNodeInfo(lev)
    local config = Config.ResonateData.data_crystal_cost_h[lev + 1]
    if config and config.attr_show and next(config.attr_show) ~= nil then
        self.node_panel:setVisible(true)
        self.power_panel:setPositionY(453)
        self.lev_panel:setPositionY(577)
        for i = 1, tableLen(config.attr_show[1]) do
            if not self.node_list[i] then
                local item = ccui.Layout:create()
                item:setAnchorPoint(cc.p(0.5, 1))
                item:setContentSize(cc.size(220, 50))
                self.node_panel:addChild(item)
                item:setPosition(cc.p(339,140 - (i-1)*50))
                item.icon = createSprite(PathTool.getResFrame("common", "common_90021"),10,25,item,cc.p(0.5,0.5))
                item.txt = createLabel(20,cc.c3b(0xff,0xff,0xff),nil,50,25,"",item,nil,cc.p(0,0.5))
                item.txt:enableOutline(Config.ColorData.data_color4[2], 2)
                self.node_list[i] = item
            end
            local item = self.node_list[i]
            local res_id = PathTool.getAttrIconByStr(config.attr_show[1][i][1])
            local res = PathTool.getResFrame("common",res_id)
            loadSpriteTexture(item.icon, res, LOADTEXT_TYPE_PLIST)
            item.txt:setString(string.format(config.attr_show[1][i][2],config.attr_show[1][i][3]))
        end
    else
        self.node_panel:setVisible(false)
        self.power_panel:setPositionY(378)
        self.lev_panel:setPositionY(528)
    end
end
function HeroResonateComfirmLevHighPanel:setPowerInfo(power)
    self.power = power
    local res = PathTool.getResFrame("common", "common_2016")
    local str = string.format("<img src='%s' scale=1 /><div fontsize=24 outline=2,#000000>%s</div>",res,MoneyTool.moneyFormat(power))
    self.right_power:setString(str)
end

function HeroResonateComfirmLevHighPanel:updateCostInfo(lev)
    local config = Config.ResonateData.data_crystal_cost_h[lev]
    if config and next(config.cost) ~= nil then
        for i=1,3 do
            local cost_data = config.cost[i]
            local cost_icon = self.cost_bg_list[i].cost_icon
            local cost_txt = self.cost_bg_list[i].cost_txt
            if cost_data then
                local bid = cost_data[1]
                local num = cost_data[2]
                local item_config = Config.ItemData.data_get_data(bid)
                if item_config then
                    cost_icon:loadTexture(PathTool.getItemRes(item_config.icon), LOADTEXT_TYPE)
                    local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
                    cost_txt:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(num))
                    if have_num >= num then
                        cost_txt:setTextColor(cc.c3b(255, 246, 228))
                    else
                        cost_txt:setTextColor(cc.c3b(0xff,0x15,0x15))
                    end
                end
            else
                cost_txt:setString("")
            end
        end
    end
    if config and next(config.lev_up_expend2) ~= nil then
        self.cost_appoint:setVisible(true)
        local list = self.cost_appoint_list
        if not list.hero_item then
            local hero_item = HeroExhibitionItem.new(0.4, false, 0, false,true)
            hero_item:setPosition(cc.p(23,23))
            list.icon:addChild(hero_item)
            list.hero_item = hero_item
        end
        list.hero_item:setData(self.hero_item_data_list[1])
        list.hero_item:setLev(nil)
        list.cost_tip:setString(TI18N("语言_c_6489"))
        list.cost_txt:setString(string.format("%s/%s",tableLen(self.hero_item_data_list[1].dic_select_list),config.lev_up_expend2[1][3]))
    else
        self.cost_appoint:setVisible(false)
    end
    if config and next(config.lev_up_expend3) ~= nil then
        local num = tableLen(config.lev_up_expend3)
        for i = 1, tableLen(config.lev_up_expend3) do
            local list = self.cost_list[i]
            if not list.hero_item then
                local hero_item = HeroExhibitionItem.new(0.4, false, 0, false,true)
                hero_item:setPosition(cc.p(23,23))
                list.icon:addChild(hero_item)
                list.hero_item = hero_item
            end
            list.hero_item:setData(self.hero_item_data_list[i])
            list.hero_item:setLev(nil)
            local default_head_id = model:getRandomHeroHeadByQuality(self.hero_item_data_list[i] and self.hero_item_data_list[i].star)
            list.hero_item:setDefaultHead(default_head_id)
            list.cost_tip:setString(string.format(TI18N("语言_c_3022"),config.lev_up_expend3[i][2]))
            list.cost_txt:setString(string.format("%s/%s",tableLen(self.hero_item_data_list[i].dic_select_list),config.lev_up_expend3[i][3]))
        end
        for i=1,2 do
            if i > num then
                self.cost_list[i].cost_bg:setVisible(false)
            else
                self.cost_list[i].cost_bg:setVisible(true)
                self.cost_list[i].cost_bg:setPosition(cost_pos_list[num][i])
            end
        end
    end
    if config and next(config.lev_up_expend) ~= nil then
        self.cost_other:setVisible(true)
        local cost_data = config.lev_up_expend[1]
        local cost_icon = self.cost_other_icon
        local cost_txt = self.cost_other_txt
        if cost_data then
            local bid = cost_data[1]
            local num = cost_data[2]
            local item_config = Config.ItemData.data_get_data(bid)
            if item_config then
                cost_icon:loadTexture(PathTool.getItemRes(item_config.icon), LOADTEXT_TYPE)
                local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
                cost_txt:setString(MoneyTool.GetMoneyString(have_num) .. "/" .. MoneyTool.GetMoneyString(num))
                if have_num >= num then
                    cost_txt:setTextColor(cc.c3b(255, 246, 228))
                else
                    cost_txt:setTextColor(cc.c3b(0xff,0x15,0x15))
                end
            end
        else
            cost_txt:setString("")
        end
        self.cost_panel:setPositionY(120)
    else
        self.cost_other:setVisible(false)
        self.cost_panel:setPositionY(70)
    end
end

function HeroResonateComfirmLevHighPanel:close_callback()
    if self.line_load  then
        self.line_load:DeleteMe()
    end
    self.line_load = nil

    if self.left_hero_item then
        self.left_hero_item:DeleteMe()
        self.left_hero_item = nil
    end

    if self.right_hero_item then
        self.right_hero_item:DeleteMe()
        self.right_hero_item = nil
    end

    controller:openHeroResonateComfirmLevHighPanel(false)
end
