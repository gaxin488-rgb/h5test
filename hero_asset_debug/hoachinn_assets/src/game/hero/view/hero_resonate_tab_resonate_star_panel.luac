-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      升星神树  查克拉共享
-- <br/> 2019年8月1日
-- --------------------------------------------------------------------
HeroResonateTabResonateStarPanel = class("HeroResonateTabResonateStarPanel", function()
    return ccui.Widget:create()
end)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort
local role_vo = RoleController:getInstance():getRoleVo()

local math_floor = math.floor

function HeroResonateTabResonateStarPanel:ctor(parent)  
    self.parent = parent
    self.con_list = {}
    self.title_list = {}
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function HeroResonateTabResonateStarPanel:config()
    --槽位上限
    self.item_max_count = 20
    local config = Config.ResonateData.data_const.star_cell_max
    if config then
        self.item_max_count = config.val
    end
    self.sp_item_max_count = 20
    local config = Config.ResonateData.data_const.sp_star_cell_max
    if config then
        self.sp_item_max_count = config.val
    end

    self.cystal_max_lev_limit = 400
    local config = Config.ResonateData.data_const.cystal_max_lev_limit
    if config then
        self.cystal_max_lev_limit = config.val
    end

    self.hero_param = 100

    self.time_desc_list = {}
    self.sp_time_desc_list = {}
    --能否更新list
    self.can_update_list = true
    self.can_sp_update_list = true
    self.con_tips_list = {false,false}
end

function HeroResonateTabResonateStarPanel:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_resonate_tab_resonate_star_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.lock_container = self.root_wnd:getChildByName("lock_container")
    self.lock_panel_x, self.lock_panel_y = self.lock_container:getPosition()
    self.con_panel = self.lock_container:getChildByName("con_panel")
    self.con_panel:setScrollBarEnabled(false)
    self.title_bg = self.lock_container:getChildByName("title_bg")
    self.title = self.lock_container:getChildByName("title")
    self.title:setString(transformTextToShort(TI18N("语言_c_6045"),40))
    addEvt2showAllTextTips(self.title,TI18N("语言_c_6045"),40)
    self.title_bg:setContentSize(cc.size(self.title:getContentSize().width + 160,29))
    self.open_btn = self.lock_container:getChildByName("open_btn")
    self.open_txt = self.open_btn:getChildByName("label")
    self.open_txt:setChangeScaleOffWidth(-1000)
    self.open_txt:setString(TI18N("语言_c_5950"))
    setTextSpacing(self.open_txt,-10)
    local _w = math.max(self.open_txt:getContentSize().width + 20,100)
    self.open_btn:setContentSize(cc.size(_w,65))
    self.open_txt:setPositionX(self.open_btn:getContentSize().width * 0.5)

    self.hero_panel = self.root_wnd:getChildByName("hero_panel")
    self.hero_param = 100
    local pos = {
        [5] = {-600,-600},
        [3] = {-400,-600},
        [1] = {0,-700},
        [2] = {400,-600},
        [4] = {600,-600},
    }
    self.item_lay_list = {}
    for i=1, 5 do
        local item_lay = self.hero_panel:getChildByName("item_lay_"..i)
        self.item_lay_list[i] = {}
        self.item_lay_list[i].btn = item_lay
        self.item_lay_list[i].add_img = item_lay:getChildByName("add_img")
        self.item_lay_list[i].add_img:setVisible(false)
        local x, y = item_lay:getPosition()
        self.item_lay_list[i].x = x
        self.item_lay_list[i].y = y + 20
        self.item_lay_list[i].pos = pos[i]

        y = y + self.hero_param
        local zorder = math_floor(1000 - y)
        item_lay:setZOrder(zorder)
    end
    
    -- if model:isCanResonateStar() then
        self:updateHeroList(model:getUpStarCon())
    -- else
    --     self:updateHeroList(model:getTreeList())
    -- end


    self.main_container = self.root_wnd:getChildByName("main_container")
    
    self.background = self.root_wnd:getChildByName("bg")
    self.background:setScale(display.getMaxScale())
    self.look_btn = self.main_container:getChildByName("look_btn")
    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.bottom_panel_x, self.bottom_panel_y = self.bottom_panel:getPosition()
    self.ordinary_panel = self.bottom_panel:getChildByName("ordinary_panel")

    self.tips = self.ordinary_panel:getChildByName("tips")
    self.tips:setString(TI18N("语言_c_5949"))
    self.sp_tip = self.ordinary_panel:getChildByName("sp_tip")
    self.sp_tip:setChangeScaleOffWidth(340)
    self.sp_tip:setString(TI18N("语言_c_6858"))
    self.lay_scrollview = self.ordinary_panel:getChildByName("lay_scrollview")
    
    local item_buy_panel = self.ordinary_panel:getChildByName("item_buy_panel")
    self.add_btn = item_buy_panel:getChildByName("add_btn")
    self.count_label = item_buy_panel:getChildByName("label")

    local item_panel = self.ordinary_panel:getChildByName("item_panel")
    self.item_img = item_panel:getChildByName("item_img")
    self.item_add_btn = item_panel:getChildByName("item_add_btn")
    self.item_label = item_panel:getChildByName("item_label")
    self:updateItemNum()

    self.special_panel = self.bottom_panel:getChildByName("special_panel")
    self.special_panel:setVisible(false)

    self.sp_tips = self.special_panel:getChildByName("sp_tips")
    self.sp_tips:setString(TI18N("语言_partner_sp_star_002"))
    setTextMaxWidth(self.sp_tips,600)
    self.sp_lay_scrollview = self.special_panel:getChildByName("sp_lay_scrollview")
    
    local sp_item_buy_panel = self.special_panel:getChildByName("sp_item_buy_panel")
    self.sp_add_btn = sp_item_buy_panel:getChildByName("sp_add_btn")
    self.count_sp_label = sp_item_buy_panel:getChildByName("sp_label")

    self.sp_look_btn = self.special_panel:getChildByName("look_btn")
    local sp_item_panel = self.special_panel:getChildByName("sp_item_panel")
    self.sp_item_img = sp_item_panel:getChildByName("sp_item_img")
    self.sp_item_add_btn = sp_item_panel:getChildByName("sp_item_add_btn")
    self.sp_item_label = sp_item_panel:getChildByName("sp_item_label")
    self:updateSpItemNum()
    self.tab_container = self.bottom_panel:getChildByName("tab_container")
    self.tab_container:setVisible(false)
    local list = {
        [1] = TI18N("语言_c_6785"),
        [2] = TI18N("语言_c_6784")
    }
    for i=1,2 do
        local item = self.tab_container:getChildByName("tab_btn_"..i)
        item.unselect_bg = item:getChildByName("unselect_bg")
        item.unselect_bg:setVisible(true)
        item.select_bg = item:getChildByName("select_bg")
        item.select_bg:setVisible(false)
        item.title = item:getChildByName("title")
        item.title:setString(list[i])
        item.index = i
        self.title_list[i] = item
    end

    local top_y = display.getTop(self.main_container)
    local container_size = self.main_container:getContentSize()
    local tab_y = self.look_btn:getPositionY()
    self.look_btn:setPositionY(top_y - (container_size.height - tab_y))
end
function HeroResonateTabResonateStarPanel:updateItemNum()
    local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    local count = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
    self.item_label:setString(count)
end
function HeroResonateTabResonateStarPanel:updateSpItemNum()
    local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    local count = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_id)
    self.sp_item_label:setString(count)
end
function HeroResonateTabResonateStarPanel:playEnterAnimatian()
    if not self.bottom_panel then return end
    commonOpenActionLeftMove(self.bottom_panel)
end

--事件
function HeroResonateTabResonateStarPanel:registerEvents()
    registerButtonEventListener(self.item_add_btn, function() self:onClickAddBtn()  end ,true, 2)
    registerButtonEventListener(self.sp_item_add_btn, function() self:onClickSpAddBtn()  end ,true, 2)
    registerButtonEventListener(self.add_btn, function() self:onAddBtn()  end ,true, 2)
    registerButtonEventListener(self.sp_add_btn, function() self:onSpAddBtn()  end ,true, 2)
    registerButtonEventListener(self.open_btn, function() self:onClickOpenBtn()  end ,true, 2)
    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.ResonateData.data_const.star_rule_tips
        if config then
            TipsManager:getInstance():showAdventureBuffTipsScroll(config.desc,sender:getTouchBeganPosition(),nil,nil,500,false,600)
        end
    end ,true, 1)
    registerButtonEventListener(self.sp_look_btn, function(param,sender, event_type)
        local config = Config.ResonateData.data_const.sp_star_rule_tips
        if config then
            TipsManager:getInstance():showAdventureBuffTipsScroll(config.desc,sender:getTouchBeganPosition(),nil,nil,500,false,400)
        end
    end ,true, 1)

	for k, object in pairs(self.title_list) do
		if object then
			object:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab(object.index)
				end
			end)
		end
    end
    --共鸣信息更新
    if self.hero_resonate_info_event == nil then
        self.hero_resonate_info_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_UpStar_Crystal_Info_Event, function(data)
           if not data then return end
           if model:getSpHeroTreeShield() then
            self.tab_container:setVisible(true)
        else
            self.tab_container:setVisible(false)
        end
           self:setPanel(data.flag == 1)
           self:updateHeroList(data.con_list)
           self:setScData(data)
        end)
    end  
    if self.hero_sp_resonate_info_event == nil then
        self.hero_sp_resonate_info_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Sp_UpStar_Crystal_Info_Event, function(data)
           if not data then return end
           self:setSpData(data)
        end)
    end  

    --能否更新list
    if self.hero_resonate_crystal_can_list_event == nil then
        self.hero_resonate_crystal_can_list_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_UpStar_Crystal_Can_List_Event, function(status)
            self.can_update_list = status 
            self.can_sp_update_list = status
        end)
    end  
    --更新单个英雄信息
    if self.hero_resonate_crystal_put_in_event == nil then
        self.hero_resonate_crystal_put_in_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_UpStar_Crystal_Update_One_Event, function(pos)
            self.can_update_list = true
            self.can_sp_update_list = true
            if pos and self.scroll_view then
                self.scroll_view:resetItemByIndex(pos)
                self:updateItemNum()
                self:updateSpItemNum()
            end
        end)
    end  

    -- 选择英雄选择返回事件
    if self.select_hero_event == nil then
        self.select_hero_event = GlobalEvent:getInstance():Bind(HeroEvent.Select_Hero_star_Event, function(dic_cur_select_list, form_type)
            if not self.select_pos then return end
            if form_type  and form_type == HeroConst.SelectHeroType.eResonateStar then
                if tableLen(self.dic_partner_id) < Config.ResonateData.data_const["star_open_condition"].val[1][1] then
                    message(TI18N("语言_c_6052"))
                    return
                end
                for key, value in pairs(self.dic_partner_id) do
                    if value.star < Config.ResonateData.data_const["star_open_condition"].val[1][2] then
                        message(TI18N("语言_c_6052"))
                        return
                    end
                end
                if dic_cur_select_list == nil or next(dic_cur_select_list) == nil then
                    return
                end
                for id,v in pairs(dic_cur_select_list) do
                    local list = {}
                    list.con_list = model:getUpStarCon()
                    local star_num = model:getMinStar(list)
                    local star_step_num = model:getMinStarStep(list)
                    local max_star = Config.PartnerData.data_partner_max_star[v.bid]
                    if star_num < 13 and v.star >= model:getMinStar(list) then
                        message(TI18N("语言_c_6055"))
                    elseif v.star == max_star and max_star <= star_num then
                        message(TI18N("语言_c_6437"))
                    else
                        local iscan = true
                        for key, value in pairs(model:getUpStarCon()) do
                            local hero_vo = model:getHeroById(value.id)
                            if hero_vo.bid == v.bid then
                                message(TI18N("语言_c_6057"))
                                iscan = false
                            end
                        end
                        for key, value in pairs(model:getUpStarReList()) do
                            local hero_vo = model:getHeroById(value.id)
                            if hero_vo.bid == v.bid then
                                message(TI18N("语言_c_6058"))
                                iscan = false
                            end
                        end
                        if iscan then
                            if star_num == 13 then 
                                if v.star > 13 then
                                    message(TI18N("语言_c_6436"))
                                elseif v.star == 13 then
                                    if v.star_step >= star_step_num then
                                        message(TI18N("语言_c_6436"))
                                    else
                                        controller:sender26406(v.partner_id, self.select_pos)
                                        break
                                    end
                                else
                                    controller:sender26406(v.partner_id, self.select_pos)
                                    break
                                end
                            elseif star_num == 14 then 
                                if v.star > 14 then
                                    message(TI18N("语言_c_6436"))
                                elseif v.star == 14 then
                                    if v.star_step >= star_step_num then
                                        message(TI18N("语言_c_6436"))
                                    else
                                        controller:sender26406(v.partner_id, self.select_pos)
                                        break
                                    end
                                else
                                    controller:sender26406(v.partner_id, self.select_pos)
                                    break
                                end
                            else
                                -- model:getMinStarStep(list)
                                controller:sender26406(v.partner_id, self.select_pos)
                                break
                            end
                        end
                    end
                end
                self.select_pos = nil
            elseif form_type  and form_type == HeroConst.SelectHeroType.eResonateSpStar then
                if tableLen(self.dic_partner_id) < Config.ResonateData.data_const["star_open_condition"].val[1][1] then
                    message(TI18N("语言_c_6052"))
                    return
                end
                for key, value in pairs(self.dic_partner_id) do
                    if value.star < Config.ResonateData.data_const["star_open_condition"].val[1][2] then
                        message(TI18N("语言_c_6052"))
                        return
                    end
                end
                if dic_cur_select_list == nil or next(dic_cur_select_list) == nil then
                    return
                end
                for id,v in pairs(dic_cur_select_list) do
                    local list = {}
                    list.con_list = model:getUpStarCon()
                    local star_num = model:getMinStar(list)
                    local star_step_num = model:getMinStarStep(list)
                    local max_star = Config.PartnerData.data_partner_max_star[v.bid]
                    if star_num < 13 and v.star >= model:getMinStar(list) then
                        message(TI18N("语言_c_6055"))
                    elseif v.star == max_star and max_star <= star_num then
                        message(TI18N("语言_c_6437"))
                    else
                        local iscan = true
                        for key, value in pairs(model:getUpStarCon()) do
                            local hero_vo = model:getHeroById(value.id)
                            if hero_vo.bid == v.bid then
                                message(TI18N("语言_c_6057"))
                                iscan = false
                            end
                        end
                        for key, value in pairs(model:getUpStarReList()) do
                            local hero_vo = model:getHeroById(value.id)
                            if hero_vo.bid == v.bid then
                                message(TI18N("语言_c_6058"))
                                iscan = false
                            end
                        end
                        if iscan then
                            if star_num == 13 then 
                                if v.star > 13 then
                                    message(TI18N("语言_c_6436"))
                                elseif v.star == 13 then
                                    if v.star_step >= star_step_num then
                                        message(TI18N("语言_c_6436"))
                                    else
                                        self:upSpHero(v, self.select_pos)
                                        break
                                    end
                                else
                                    self:upSpHero(v, self.select_pos)
                                    break
                                end
                            elseif star_num == 14 then 
                                if v.star > 14 then
                                    message(TI18N("语言_c_6436"))
                                elseif v.star == 14 then
                                    if v.star_step >= star_step_num then
                                        message(TI18N("语言_c_6436"))
                                    else
                                        self:upSpHero(v, self.select_pos)
                                        break
                                    end
                                else
                                    self:upSpHero(v, self.select_pos)
                                    break
                                end
                            else
                                self:upSpHero(v, self.select_pos)
                                break
                            end
                        end
                    end
                end
                self.select_pos = nil
            end
        end)
    end
    
    -- 道具数量更新
    if self.add_goods == nil then
        self.add_goods = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function(bag_code, data_list)
            self:refreshExchangeItemNum(bag_code,data_list)
        end)
    end 
    if self.delete_goods == nil then
        self.delete_goods = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function(bag_code, data_list)
            self:refreshExchangeItemNum(bag_code,data_list)
        end)
    end
    if self.modify_goods == nil then
        self.modify_goods = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code, data_list)
            self:refreshExchangeItemNum(bag_code,data_list)
        end)
    end
end
function HeroResonateTabResonateStarPanel:upSpHero(hero_vo,pos)
    if hero_vo.star_step ~= 0 then
        controller:openHeroSpTreeTipPanel(true,hero_vo,pos,1)
    else
        controller:sender26446(hero_vo.partner_id, pos)
    end
end
-- 切换标签页
function HeroResonateTabResonateStarPanel:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end
	if index == 1 then --普通忍者
		self.ordinary_panel:setVisible(true)
        self.special_panel:setVisible(false)
	else--sp忍者
		self.ordinary_panel:setVisible(false)
        self.special_panel:setVisible(true)
	end
    
    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        self.tab_object = nil
    end
    self.tab_object = self.title_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
    end

	for i=1, tableLen(self.title_list) do
		local object = self.title_list[i]
		if i == index then
			object.title:setTextColor(cc.c4b(0xf8,0xef,0x76,0xff))
			object.title:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		else
			object.title:setTextColor(cc.c4b(0xf9,0xee,0xd0,0xff))
			object.title:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		end
	end
end

function HeroResonateTabResonateStarPanel:refreshExchangeItemNum( bag_code, data_list )
	if bag_code == BackPackConst.Bag_Code.BACKPACK then
        local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
        for i,v in pairs(data_list) do 
            if v and v.base_id and item_id == v.base_id then 
                self:updateItemNum()
            end
        end
        local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
        for i,v in pairs(data_list) do 
            if v and v.base_id and item_id == v.base_id then
                self:updateSpItemNum()
            end
        end
	end
end

function HeroResonateTabResonateStarPanel:onClickOpenBtn()
    for key, value in pairs(self.con_tips_list) do
        if not value then
            message(TI18N("语言_c_5951"))
            return
        end
    end
    controller:sender26404()
end

function HeroResonateTabResonateStarPanel:onClickAddBtn()
    local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    local item_config = Config.ItemData.data_get_data(item_id)
    BackpackController:getInstance():openTipsSource(true, item_config)
end
function HeroResonateTabResonateStarPanel:onClickSpAddBtn()
    local item_id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    local item_config = Config.ItemData.data_get_data(item_id)
    BackpackController:getInstance():openTipsSource(true, item_config)
end

function HeroResonateTabResonateStarPanel:onSpAddBtn()
    if not self.spdata then return end
    if not self.sp_open_pos_count then return end

    --等级限制
    local cfg = deepCopy(Config.ResonateData.data_const["sp_star_cell_lv_limit"].val)
    table.sort(cfg, function(a,b)
        return a[2]<b[2]
    end)

    local function unLock()
        local cost_count1 = self.spdata.item_count or 1
        cost_count1 = cost_count1 + 1
        if cost_count1 <= 0 then
            cost_count1 = 1
        end
        local config = Config.ResonateData.data_cell_cost_2_sp[cost_count1]
        if not config then return end
        local list1 = config.loss1
        local bid1 = list1[1][1]
        local num1 = list1[1][2]
        local now_num1 = BackpackController:getInstance():getModel():getItemNumByBid(bid1)
        local cost_count2 = self.spdata.gold_count or 1
        cost_count2 = cost_count2 + 1
        if cost_count2 <= 0 then
            cost_count2 = 1
        end
        local config = Config.ResonateData.data_cell_cost_2_sp[cost_count2]
        if not config then return end
        local list2 = config.loss2
        local bid2 = list2[1][1]
        local num2 = list2[1][2]
        local now_num2 = BackpackController:getInstance():getModel():getItemNumByBid(bid2)
        local re_num = self.item_max_count + model:getSyncStarAddPos() - self.sp_open_pos_count
        local num_1 = Config.ResonateData.data_const["sp_star_cell_item1_limit"].val
        if re_num < num_1 then
            num_1 = re_num
        end
        local num_2 = Config.ResonateData.data_const["sp_star_cell_item2_limit"].val
        if re_num < num_2 then
            num_2 = re_num
        end
        local max_num = Config.ResonateData.data_const["sp_star_cell_item2_limit"].val
        if cost_count1 <= Config.ResonateData.data_const["sp_star_cell_item1_limit"].val then
            if now_num1 >= num1 then
                if self.sp_open_pos_count then
                    local fun = function()
                        controller:sender26449(self.sp_open_pos_count + 1, 1)
                    end
                    local item_config = Config.ItemData.data_get_data(bid1)
                    local res = PathTool.getItemRes(item_config.icon)
		    local str = LangStringFormat(TI18N("语言_c_6708"),{res,num1})

