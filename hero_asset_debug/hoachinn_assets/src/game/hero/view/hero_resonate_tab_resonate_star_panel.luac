                end
            end
        end
    end
    local sp_open_pos_count = self.sp_open_pos_count + 1
    for key, value in pairs(cfg) do
        if sp_open_pos_count <= value[2] then
            if role_vo.lev < value[1] then
                message(string.format(TI18N("语言_c_1027"),value[1]))
            else
                unLock()
            end
            return 
        end
    end
    unLock()
end
--支付类型 1 物品 2 钻石 后端定义的 根据 26429
function HeroResonateTabResonateStarPanel:onAddBtn()
    if not self.scdata then return end
    if not self.open_pos_count then return end

    --等级限制
    local cfg = deepCopy(Config.ResonateData.data_const["star_cell_lv_limit"].val)
    table.sort(cfg, function(a,b)
        return a[2]<b[2]
    end)

    local function unLock()
        local cost_count1 = self.scdata.item_count or 1
        cost_count1 = cost_count1 + 1
        if cost_count1 <= 0 then
            cost_count1 = 1
        end
        local config = Config.ResonateData.data_cell_cost_2[cost_count1]
        if not config then return end
        local list1 = config.loss1
        local bid1 = list1[1][1]
        local num1 = list1[1][2]
        local now_num1 = BackpackController:getInstance():getModel():getItemNumByBid(bid1)
        local cost_count2 = self.scdata.gold_count or 1
        cost_count2 = cost_count2 + 1
        if cost_count2 <= 0 then
            cost_count2 = 1
        end
        local config = Config.ResonateData.data_cell_cost_2[cost_count2]
        if not config then return end
        local list2 = config.loss2
        local bid2 = list2[1][1]
        local num2 = list2[1][2]
        local now_num2 = BackpackController:getInstance():getModel():getItemNumByBid(bid2)
        local re_num = self.item_max_count + model:getSyncStarAddPos() - self.open_pos_count
        local num_1 = Config.ResonateData.data_const["star_cell_item1_limit"].val
        if re_num < num_1 then
            num_1 = re_num
        end
        local num_2 = Config.ResonateData.data_const["star_cell_item2_limit"].val
        if re_num < num_2 then
            num_2 = re_num
        end
        local max_num = Config.ResonateData.data_const["star_cell_item2_limit"].val
        if cost_count1 <= Config.ResonateData.data_const["star_cell_item1_limit"].val then
            if now_num1 >= num1 then
                if self.open_pos_count then
                    local fun = function()
                        controller:sender26409(self.open_pos_count + 1, 1)
                    end
                    local item_config = Config.ItemData.data_get_data(bid1)
                    local res = PathTool.getItemRes(item_config.icon)
                    -- if cost_count1-1 > num_1 then
                    --     cost_count1 = num_1 + 1
                    -- end
                    --道具
                    -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num1,cost_count1-1,num_1})
                    local str = LangStringFormat(TI18N("语言_c_6708"),{res,num1})
                    CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                end
            else
                if cost_count2 <= Config.ResonateData.data_const["star_cell_item2_limit"].val then
                    if now_num2 >= num2 then
                        if self.open_pos_count then
                            local fun = function()
                                controller:sender26409(self.open_pos_count + 1, 2)
                            end
                            local item_config = Config.ItemData.data_get_data(bid2)
                            local res = PathTool.getItemRes(item_config.icon)
                            -- if cost_count2-1 > num_2 then
                            --     cost_count2 = num_2 + 1
                            -- end
                            --金币
                            -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,num_2})
                            local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,max_num})
                            CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                        end
                    else
                        if self.open_pos_count then
                            local fun = function()
                                local item_config = Config.ItemData.data_get_data(bid1)
                                BackpackController:getInstance():openTipsSource(true, item_config)
                            end
                            local item_config = Config.ItemData.data_get_data(bid1)
                            local res = PathTool.getItemRes(item_config.icon)
                            -- if cost_count1-1 > num_1 then
                            --     cost_count1 = num_1 + 1
                            -- end
                            -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num1,cost_count1-1,num_1})
                            local str = LangStringFormat(TI18N("语言_c_6708"),{res,num1})
                            CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                        end
                    end
                else
                    if self.open_pos_count then
                        local fun = function()
                            local item_config = Config.ItemData.data_get_data(bid1)
                            BackpackController:getInstance():openTipsSource(true, item_config)
                        end
                        local item_config = Config.ItemData.data_get_data(bid1)
                        local res = PathTool.getItemRes(item_config.icon)
                        -- if cost_count1-1 > num_1 then
                        --     cost_count1 = num_1 + 1
                        -- end
                        -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num1,cost_count1-1,num_1})
                        local str = LangStringFormat(TI18N("语言_c_6708"),{res,num1})
                        CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                    end
                end
            end
        else
            if cost_count2 <= Config.ResonateData.data_const["star_cell_item2_limit"].val then
                if now_num2 >= num2 then
                    if self.open_pos_count then
                        local fun = function()
                            controller:sender26409(self.open_pos_count + 1, 2)
                        end
                        local item_config = Config.ItemData.data_get_data(bid2)
                        local res = PathTool.getItemRes(item_config.icon)
                        -- if cost_count2-1 > num_2 then
                        --     cost_count2 = num_2 + 1
                        -- end
                        -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,num_2})
                        local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,max_num})
                        CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                    end
                else
                    if self.open_pos_count then
                        local fun = function()
                            local item_config = Config.ItemData.data_get_data(bid2)
                            BackpackController:getInstance():openTipsSource(true, item_config)
                        end
                        local item_config = Config.ItemData.data_get_data(bid2)
                        local res = PathTool.getItemRes(item_config.icon)
                        -- if cost_count2-1 > num_2 then
                        --     cost_count2 = num_2 + 1
                        -- end
                        -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,num_2})
                        local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,max_num})
                        CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                    end
                end
            else
                if self.open_pos_count then
                    local fun = function()
                        local item_config = Config.ItemData.data_get_data(bid2)
                        BackpackController:getInstance():openTipsSource(true, item_config)
                    end
                    local item_config = Config.ItemData.data_get_data(bid2)
                    local res = PathTool.getItemRes(item_config.icon)
                    -- if cost_count2-1 > num_2 then
                    --     cost_count2 = num_2 + 1
                    -- end
                    -- local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,num_2})
                    local str = LangStringFormat(TI18N("语言_c_6041"),{res,num2,cost_count2-1,max_num})
                    CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
                end
            end
        end
    end
    local open_pos_count = self.open_pos_count + 1
    for key, value in pairs(cfg) do
        if open_pos_count <= value[2] + model:getSyncStarAddPos() then
            if role_vo.lev < value[1] then
                message(string.format(TI18N("语言_c_1027"),value[1]))
            else
                unLock()
            end
            return 
        end
    end
    unLock()
end

--是否首次进入  是否完成
function HeroResonateTabResonateStarPanel:setPanel(status)
    if not status then
        self.lock_container:setVisible(true)
        self.main_container:setVisible(false)
        loadSpriteTexture(self.background, "resource/heroresonate/hero_resonate_11.jpg", LOADTEXT_TYPE)
    else
        self.lock_container:setVisible(false)
        self.main_container:setVisible(true)
        if self.tab_object and self.tab_object.index then
            self:changeSelectedTab(self.tab_object.index)
        else    
            self:changeSelectedTab(1)
        end
        loadSpriteTexture(self.background, "resource/heroresonate/hero_resonate_12.png", LOADTEXT_TYPE)
    end
end
function HeroResonateTabResonateStarPanel:setData(parent)
    self.parent = parent
    self.is_init_hero = true
    if model:getSpHeroTreeShield() then
        self.tab_container:setVisible(true)
    else
        self.tab_container:setVisible(false)
    end
    controller:sender26405()
    controller:sender26445()
    local id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    loadSpriteTexture(self.item_img, PathTool.getItemRes(id) , LOADTEXT_TYPE)
    local id = Config.ResonateData.data_cell_cost_2[1].loss1[1][1]
    loadSpriteTexture(self.sp_item_img, PathTool.getItemRes(id) , LOADTEXT_TYPE)
end
function HeroResonateTabResonateStarPanel:setConPanel()
    local cfg = Config.ResonateData.data_const
    local list = {
        [1] = "star_open_lv",
        [2] = "star_open_condition",
    }
    self.con_panel:removeAllChildren()
    self.con_tips_list = {}
    for i=1,tableLen(list) do
        self.con_list[i] = {}
        local con = createLabel(22,cc.c4b(0x5c,0x27,0x05,0xff),nil,0,0,"",self.con_panel,nil,cc.p(0,1))
        con:setString(self:setTxt(list[i],cfg[list[i]]))
        local tip = createRichLabel(22,cc.c4b(0x5c,0x27,0x05,0xff),cc.p(1,1),cc.p(self.con_panel:getContentSize().width,0))
        self.con_panel:addChild(tip)
        local str,status = self:setTip(list[i],cfg[list[i]])
        self.con_tips_list[i] = status
        tip:setString(str)
        self.con_list[i].con = con
        self.con_list[i].tip = tip
    end
    local _h = 0
    for key, value in pairs(self.con_list) do
        local _w = value.con:getContentSize().width + value.tip:getContentSize().width
        if _w < self.con_panel:getContentSize().width then
        else
            value.con:setWidth(self.con_panel:getContentSize().width - value.tip:getContentSize().width - 10)
        end
        _h = _h + value.con:getContentSize().height + 12
    end
    local max_h = math.max(_h,self.con_panel:getContentSize().height)
    self.con_panel:setInnerContainerSize(cc.size(self.con_panel:getContentSize().width,max_h))
    local _y = max_h
    for key, value in pairs(self.con_list) do
        value.con:setPositionY(_y)
        -- value.tip:setPositionY(_y - value.con:getContentSize().height/2)
        value.tip:setPositionY(_y)
        _y = _y - value.con:getContentSize().height - 12
    end
    for key, value in pairs(self.con_tips_list) do
        if not value then
            setChildUnEnabled(true,self.open_btn)
            return
        end
    end
end
function HeroResonateTabResonateStarPanel:setTxt(desc,list)
    if not list then return "" end
    local str = ""
    if desc == "star_open_lv" then
        str = string.format(TI18N("语言_c_1027"),list.val)
    elseif desc == "star_open_condition" then
        str = LangStringFormat(TI18N("语言_c_5953"),list.val[1])
    end
    return str
end
function HeroResonateTabResonateStarPanel:setTip(desc,list)
    if not list then return "" end
    local str = TI18N("语言_c_3561")
    local status = false
    if desc == "star_open_lv" then
        if role_vo.lev >= list.val then
            str = TI18N("语言_c_3560")
            status = true
        end
    elseif desc == "star_open_condition" then
        if tableLen(self.scdata.con_list) >= list.val[1][1] then
            str = TI18N("语言_c_3560")
            status = true
        end
    end
    return str,status
end
function HeroResonateTabResonateStarPanel:setScData(scdata)
    self.scdata = scdata
    self:setConPanel()
    -- self.dic_hero_vo = {}
    -- for i,v in ipairs(scdata.con_list) do
    --     if v.id ~= 0 then
    --         local hero_vo = model:getHeroById(v.id)
    --         if hero_vo and next(hero_vo) ~= nil then
    --             table_insert(self.dic_hero_vo, hero_vo)
    --         end
    --     end
    -- end

    self.show_list = self.scdata.res_list
    table_sort(self.show_list, function(a,b) return a.pos < b.pos end)
    self.open_pos_count = #self.show_list
    local item_max_count
    -- if model:isResonateCystalMaxLev() then
    --     item_max_count = self.item_max_count + 5
    --     self.count_label:setString(string_format("%s/%s", self.open_pos_count, item_max_count))
    -- else
        item_max_count = self.item_max_count + model:getSyncStarAddPos()
        self.count_label:setString(string_format("%s/%s", self.open_pos_count, self.item_max_count + model:getSyncStarAddPos()))
    -- end
    if self.open_pos_count < item_max_count  then
        self.add_btn:setVisible(true)
    else
        self.add_btn:setVisible(false)
    end

    if self.can_update_list == true then
        self:updateScrollList()
    end
end
function HeroResonateTabResonateStarPanel:setSpData(scdata)
    self.spdata = scdata
    
    self.sp_show_list = self.spdata.res_list
    table_sort(self.sp_show_list, function(a,b) return a.pos < b.pos end)
    self.sp_open_pos_count = #self.sp_show_list
    local item_max_count
    item_max_count = self.sp_item_max_count + model:getSyncSpStarAddPos()
    self.count_sp_label:setString(string_format("%s/%s", self.sp_open_pos_count, self.sp_item_max_count + model:getSyncSpStarAddPos()))
    if self.sp_open_pos_count < item_max_count  then
        self.sp_add_btn:setVisible(true)
    else
        self.sp_add_btn:setVisible(false)
    end

    if self.can_sp_update_list == true then
        self:updateSpScrollList()
    end
end
function HeroResonateTabResonateStarPanel:startTimeTicket()
    if self.timeticket == nil then
        self:countDownEndTime()
        self.timeticket = GlobalTimeTicket:getInstance():add(function()
            self:countDownEndTime()
        end, 1)
    end
end

function HeroResonateTabResonateStarPanel:countDownEndTime()
    if self.scroll_view then
         for i,v in pairs(self.scroll_view.activeCellIdx) do
            if v and self.time_desc_list[i] then
                self:updateTimeByIndex(i, self.time_desc_list[i])
            end
        end
    end
end

function HeroResonateTabResonateStarPanel:updateTimeByIndex(index, time_desc)
    -- body 
    local data = self.show_list[index]
    if data then
        if time_desc then
            local time = data.cool_time - GameNet:getInstance():getTime()
            if time < 0 then
                time = 0
                data.cool_time = 0
                self.scroll_view:resetItemByIndex(index)
                self.time_desc_list[index] = nil
                return
            end
            -- time_desc:setString(string_format("%s%s", TI18N("语言_c_131"), TimeTool.getDayOrHour(time)))
            time_desc:setString(TimeTool.GetTimeFormat(time))
        end
    end
end


function HeroResonateTabResonateStarPanel:updateSpScrollList()
    if self.sp_scroll_view == nil then
        local scroll_view_size = self.sp_lay_scrollview:getContentSize()
        local list_setting = {
            start_x = 5,
            space_x = 10,
            start_y = 0,
            space_y = 0,
            item_width = 120,
            item_height = 120,
            row = 1,
            col = 5,
            need_dynamic = true
        }
        self.sp_scroll_view = CommonScrollViewSingleLayout.new(self.sp_lay_scrollview, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, list_setting, cc.p(0, 0)) 

        self.sp_scroll_view:registerScriptHandlerSingle(handler(self,self.createSpNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.sp_scroll_view:registerScriptHandlerSingle(handler(self,self.numberSpOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.sp_scroll_view:registerScriptHandlerSingle(handler(self,self.updateSpCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.sp_scroll_view:registerScriptHandlerSingle(handler(self,self.onCellSpTouched), ScrollViewFuncType.OnCellTouched) --更新cell
    end
    if self.sp_is_init_scroll_view == nil then
        self.sp_is_init_scroll_view = true
        self.sp_scroll_view:reloadData()
    else

        if self.sp_record_count ~= self:numberSpOfCells() then
            self.sp_scroll_view:reloadData()
        else
            self.sp_scroll_view:resetCurrentItems()    
        end
        
    end
    self.sp_record_count = self:numberSpOfCells()
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroResonateTabResonateStarPanel:createSpNewCell(width, height)
    local cell = HeroExhibitionItem.new(0.9, true, 0, true,true)
    cell:addCallBack(function() self:onCellSpTouched(cell) end)
    cell:setLongTimeTouchEffect(true)
    return cell
end
--获取数据数量
function HeroResonateTabResonateStarPanel:numberSpOfCells()
    if not self.sp_show_list then return self.sp_item_max_count + model:getSyncSpStarAddPos() end
    local count = #self.sp_show_list
    if model:isResonateCystalMaxLev() then
        if count <= (self.sp_item_max_count + model:getSyncSpStarAddPos()) then
            return self.sp_item_max_count + model:getSyncSpStarAddPos()
        else
            return count
        end
    else
        if count <= self.sp_item_max_count + model:getSyncSpStarAddPos() then
            return self.sp_item_max_count + model:getSyncSpStarAddPos()
        else
            return count
        end
    end
    
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--index :数据的索引
function HeroResonateTabResonateStarPanel:updateSpCellByIndex(cell, index)
    cell.index = index
    local data = self.sp_show_list[index]

    cell:showResonateCrystalTime(false)
    self.sp_time_desc_list[index] = nil

    if data and data.id ~= 0 then
        local hero_vo =  model:getHeroById(data.id)
        cell:setData(hero_vo)
        cell:showLockIcon(false)
        cell:showAddIcon(false)
    else
        cell:setData(nil)
        cell:showAddIcon(false)
        if index == (self.sp_open_pos_count + 1) then
            cell:showLockIcon(true, "", {res = PathTool.getResFrame("heroresonate","hero_resonate_9")})    
        elseif index > (self.sp_open_pos_count + 1) then
            cell:showLockIcon(true, "", {res = PathTool.getResFrame("common","common_90009"), is_unenabled_bg = true})
        else
            cell:showLockIcon(false)

            if data and data.cool_time and data.cool_time > 0 then
                local time = data.cool_time - GameNet:getInstance():getTime()
                if time > 0 then
                    --显示时间
                    local time_str = TimeTool.GetTimeFormat(time)
                    self.sp_time_desc_list[index] = cell:showResonateCrystalTime(true, time_str)
                    self:startTimeTicket()
                else
                    cell:showAddIcon(true)    
                end
            else
                cell:showAddIcon(true)
            end
        end
    end
end

--点击cell .需要在 createNewCell 设置点击事件
function HeroResonateTabResonateStarPanel:onCellSpTouched(cell)
    if not cell.index then return end
    local index = cell.index
    local data = self.sp_show_list[index]
    if data and data.id ~= 0 then
        controller:openHeroSpTreeTipPanel(true,model:getHeroById(data.id),index,2)
    else
        if index == (self.sp_open_pos_count + 1) then
            --购买
            self:onSpAddBtn()
        elseif index > (self.sp_open_pos_count + 1) then
            message(TI18N("语言_c_3140"))
        else
            if data and data.cool_time and data.cool_time ~= 0 then
                --显示时间
                local time = data.cool_time - GameNet:getInstance():getTime()
                if time > 0 then
                    self:SprefreshTime(index)
                else
                    self:onClickSpHeroBtn(index)
                end
            else
                self:onClickSpHeroBtn(index)
            end
        end
    end
end

function HeroResonateTabResonateStarPanel:SprefreshTime(index)
    local cell_flush_expend = {3,100}

    local config = Config.ResonateData.data_const.sp_star_cell_flush_expend
    if config then
        cell_flush_expend = config.val
    end
    if cell_flush_expend and next(cell_flush_expend) ~= nil then 
        local bid = cell_flush_expend[1][1] or 0
        local num = cell_flush_expend[1][2] or 0
        local item_config = Config.ItemData.data_get_data(bid)
        if item_config then 
            local fun = function()
                controller:sender26448(index)
            end

            local res = PathTool.getItemRes(item_config.icon)
            local str = string.format(TI18N("语言_c_3141"),res,num)
            CommonAlert.show(str,TI18N("语言_c_63"),fun,TI18N("语言_c_62"),nil,CommonAlert.type.rich,nil,nil,24)
        end
    end
end

function HeroResonateTabResonateStarPanel:onClickSpHeroBtn(pos)
    self.select_pos = pos
    local setting = {}
    setting.select_condition = {}
    setting.select_condition.star_start = 0
    setting.select_condition.camp_type = 0
    setting.select_condition.bid = 0
    setting.select_count = 1
    setting.form_type = HeroConst.SelectHeroType.eResonateSpStar
    setting.dic_selected = {}

    setting.dic_filter_selected = {}
    if self.sp_dic_hero_vo then
        for k,v in pairs(self.sp_dic_hero_vo) do
            setting.dic_filter_selected[v.id] = v
        end
    end
    if self.sp_show_list then
        for k,v in ipairs(self.sp_show_list) do
            if v.id ~= 0 then
                local hero_vo = model:getHeroById(v.id)
                if hero_vo then
                    setting.dic_filter_selected[v.id] = hero_vo
                end
            end
        end
    end
    controller:openHeroStarSelectHeroPanel(true, setting)
end



function HeroResonateTabResonateStarPanel:updateScrollList()
    if self.scroll_view == nil then
        local scroll_view_size = self.lay_scrollview:getContentSize()
        local list_setting = {
            start_x = 5,
            space_x = 10,
            start_y = 0,
            space_y = 0,
            item_width = 120,
            item_height = 120,
            row = 1,
            col = 5,
            need_dynamic = true
        }
        self.scroll_view = CommonScrollViewSingleLayout.new(self.lay_scrollview, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, list_setting, cc.p(0, 0)) 

        self.scroll_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.scroll_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.scroll_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.scroll_view:registerScriptHandlerSingle(handler(self,self.onCellTouched), ScrollViewFuncType.OnCellTouched) --更新cell
    end
    if self.is_init_scroll_view == nil then
        self.is_init_scroll_view = true
        self.scroll_view:reloadData()
    else

        if self.record_count ~= self:numberOfCells() then
            self.scroll_view:reloadData()
        else
            self.scroll_view:resetCurrentItems()    
        end
        
    end
    self.record_count = self:numberOfCells()
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroResonateTabResonateStarPanel:createNewCell(width, height)
    local cell = HeroExhibitionItem.new(0.9, true, 0, true,true)
    cell:addCallBack(function() self:onCellTouched(cell) end)
    cell:setLongTimeTouchEffect(true)
    return cell
end
--获取数据数量
function HeroResonateTabResonateStarPanel:numberOfCells()
    if not self.show_list then return self.item_max_count + model:getSyncStarAddPos() end
    local count = #self.show_list
    if model:isResonateCystalMaxLev() then
        if count <= (self.item_max_count + model:getSyncStarAddPos()) then
            return self.item_max_count + model:getSyncStarAddPos()
        else
            return count
        end
    else
        if count <= self.item_max_count + model:getSyncStarAddPos() then
            return self.item_max_count + model:getSyncStarAddPos()
        else
            return count
        end
    end
    
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--index :数据的索引
function HeroResonateTabResonateStarPanel:updateCellByIndex(cell, index)
    cell.index = index
    local data = self.show_list[index]

    cell:showResonateCrystalTime(false)
    self.time_desc_list[index] = nil

    if data and data.id ~= 0 then
        local hero_vo =  model:getHeroById(data.id)
        cell:setData(hero_vo)
        cell:showLockIcon(false)
        cell:showAddIcon(false)
    else
        cell:setData(nil)
        cell:showAddIcon(false)
        if index == (self.open_pos_count + 1) then
            cell:showLockIcon(true, "", {res = PathTool.getResFrame("heroresonate","hero_resonate_9")})    
        elseif index > (self.open_pos_count + 1) then
            cell:showLockIcon(true, "", {res = PathTool.getResFrame("common","common_90009"), is_unenabled_bg = true})
        else
            cell:showLockIcon(false)

            if data and data.cool_time and data.cool_time > 0 then
                local time = data.cool_time - GameNet:getInstance():getTime()
                if time > 0 then
                    --显示时间
                    local time_str = TimeTool.GetTimeFormat(time)
                    self.time_desc_list[index] = cell:showResonateCrystalTime(true, time_str)
                    self:startTimeTicket()
                else
                    cell:showAddIcon(true)    
                end
            else
                cell:showAddIcon(true)
            end
        end
    end
end

--点击cell .需要在 createNewCell 设置点击事件
function HeroResonateTabResonateStarPanel:onCellTouched(cell)
    if not cell.index then return end
    local index = cell.index
    local data = self.show_list[index]
    if data and data.id ~= 0 then
        local hero_vo =  model:getHeroById(data.id)
        local setting = {}
        setting.left_hero_vo = hero_vo
        setting.pos = index
        controller:openHeroStarPutDownPanel(true, setting)
    else
        if index == (self.open_pos_count + 1) then
            --购买
            self:onAddBtn()
        elseif index > (self.open_pos_count + 1) then
            message(TI18N("语言_c_3140"))
        else
            if data and data.cool_time and data.cool_time ~= 0 then
                --显示时间
                local time = data.cool_time - GameNet:getInstance():getTime()
                if time > 0 then
                    self:refreshTime(index)
                else
                    self:onClickHeroBtn(index)
                end
            else
                self:onClickHeroBtn(index)
            end
        end
    end
end

