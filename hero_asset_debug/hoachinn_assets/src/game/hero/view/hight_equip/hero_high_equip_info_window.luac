HeroHighEquipInfoWindow = HeroHighEquipInfoWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_insert = table.insert
local table_sort = table.sort
local role_vo = RoleController:getInstance():getRoleVo()
local math_floor = math.floor

function HeroHighEquipInfoWindow:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_high_equip_info_window"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("holy_starup","holy_starup"), type = ResourcesType.plist },
    }

    self.win_type = WinType.Tips    
    self.base_list = {}
    self.suit_item_list = {}
    self.random_item_list = {}
    self.skill_item = {}
    -- self.gemstone_list = {}

    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.ohter_list = {}
    self.cloth_type = 1
    self.is_need = true

    --道具配置
    self.item_config = nil
    --套装配置
    self.suit_config = nil
end

function HeroHighEquipInfoWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.container = self.main_panel:getChildByName("container")            -- 背景,需要动态设置尺寸
    self.container_init_size = self.container:getContentSize()

    -- 基础属性,名字,类型和评分等
    self.base_panel = self.container:getChildByName("base_panel")
    self.score_title = self.base_panel:getChildByName("score_title")
    self.score_title:setString(TI18N("语言_c_1742"))
    self.equip_item =  BackPackItem.new(true,true,nil,1,false)
    self.equip_item:setPosition(cc.p(72,68))
    self.base_panel:addChild(self.equip_item)
    self.name = self.base_panel:getChildByName("name")
    setTextMaxWidth(self.name,415,-10)
    self.equip_type = self.base_panel:getChildByName("equip_type")
    self.power_label = CommonNum.new(1, self.base_panel, 1, - 2, cc.p(0, 0))
    self.power_label:setPosition(cc.p(210, 26))
    self.power_label:setNum(0)
    self.power_label:setScale(0.8) 
    setItemXOneByOne({self.score_title,self.power_label})
    self.lv = self.base_panel:getChildByName("lv")
    -- self.lv:setString("Lv.")
    self.base_panel:setVisible(false)

    self.look_btn = self.base_panel:getChildByName("look_btn")
    self.look_btn:setVisible(false)
    self.suit_icon = self.base_panel:getChildByName("suit_icon")
    self.suit_name = self.base_panel:getChildByName("suit_name")

    -- 基础属性
    self.baseattr_panel = self.container:getChildByName("baseattr_panel")
    self.baseattr_panel_height = self.baseattr_panel:getContentSize().height
    self.baseattr_label = self.baseattr_panel:getChildByName("label")
    self.baseattr_label:setString(TI18N("语言_c_1282"))
    self.baseattr_panel:setVisible(false)

    self.full_bg = self.container:getChildByName("full_bg")
    self.full_bg:setVisible(false)

    --镇魂属性
    self.soul_panel = self.container:getChildByName("soul_panel")
    self.soul_panel_height = self.soul_panel:getContentSize().height
    self.soul_attr_name  = self.soul_panel:getChildByName("label")
    self.soul_attr_name:setString(TI18N("语言_c_6799"))
    self.soul_panel:setVisible(false)
    -- self.lock_img =self.soul_panel:getChildByName("lock_img")
    -- self.lock_img:setVisible(false)

    --套装属性
    self.suitattr_panel = self.container:getChildByName("suitattr_panel")
    self.suitattr_panel_height = self.suitattr_panel:getContentSize().height
    self.suitattr_name  = self.suitattr_panel:getChildByName("label")
    self.suitattr_name:setString(TI18N("语言_c_5979"))
    self.suitattr_tips  = self.suitattr_panel:getChildByName("label1")
    self.suitattr_tips:setString(TI18N("语言_c_6806"))
    self.suitattr_tips:setTouchEnabled(true)
    self.suitattr_tips:setString(transformTextToShort(TI18N("语言_c_6806"),40))
    addEvt2showAllTextTips(self.suitattr_tips,TI18N("语言_c_6806"),40,nil,nil,nil,true,true)
    self.suitattr_name:setChangeScaleOffWidth(-1000)
    setTextMaxWidth(self.suitattr_name,400)
    self.suitattr_panel:setVisible(false)
    --技能
    self.skill_panel = self.container:getChildByName("skill_panel")
    self.skill_panel:getChildByName("label"):setString(TI18N("语言_c_6805"))
    self.skill_panel_height = self.skill_panel:getContentSize().height
