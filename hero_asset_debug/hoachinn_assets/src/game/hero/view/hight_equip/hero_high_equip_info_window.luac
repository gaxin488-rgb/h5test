    self.tab_btn_txt_5 = self.tab_btn_5:getChildByName("Text_1")
    self.tab_btn_txt_5:setString(TI18N("语言_c_3456"))
    self.tab_btn_5:setVisible(false)
    self.tab_btn_6 = self.tab_panel:getChildByName("tab_btn_6")
