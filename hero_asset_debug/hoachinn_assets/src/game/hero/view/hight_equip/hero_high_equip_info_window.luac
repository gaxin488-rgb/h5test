    self.tab_btn_4:setVisible(false)
    self.tab_btn_5:setVisible(false)
    self.tab_btn_6:setVisible(false)
end

function HeroHighEquipInfoWindow:register_event()
    --卸下
    self.tab_btn_1:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn1()
        end
    end)
    --强化
    self.tab_btn_2:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn2()
        end
    end)

    --穿戴 和更换
    self.tab_btn_3:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn3()
        end
    end)

    --穿戴
    self.tab_btn_4:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn4(sender)
        end
    end)
    --来源
    self.tab_btn_5:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn5(sender)
        end
    end)
    --分解
    self.tab_btn_6:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self:onTabBtn6(sender)
        end
    end)
    registerButtonEventListener(self.close_btn, function() self:onClickCloseBtn() end ,true, 1) 
    registerButtonEventListener(self.background, function() self:onClickCloseBtn() end ,false, 0) 
    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.PartnerHolyEqmData.data_const.game_rule_1
        if config then
            TipsManager:getInstance():showAdventureBuffTipsScroll(config.desc, sender:getTouchBeganPosition(),24,nil,400,nil,600)
        end
    end ,true, 2, nil, 0.8)

    if not self.updateEquipInfoEvent then
        self.updateEquipInfoEvent = GlobalEvent:getInstance():Bind(BackpackEvent.BACKPACK_GOLDEQUIP_EVENT,function ()
            if self.cloth_type == PartnerConst.EqmTips.backpack or self.cloth_type == PartnerConst.EqmTips.partner then
                local equip_one_id = self.data.id
                local gold_info = BackpackController:getInstance():getModel():getGoldEquipData(equip_one_id)
                if gold_info then
                    self.gold_info = gold_info
                    self:checkUpRedStatus()
                end
                -- else
               
            end
			self:initData()
            -- self:addDataBindEvent()
        end)
    end

end

function HeroHighEquipInfoWindow:addDataBindEvent()
    --注册道具 goodsvo的变化事件..属性变化了才刷新
    if self.partner_id == nil or self.partner_id == 0 then
        if self.data and self.data.Bind and self.item_update_event == nil then
            self.item_update_event = self.data:Bind(GoodsVo.UPDATE_GOODS_ATTR, function(key, value) 
                if key == "holy_eqm_attr" then
                    self:initData()
                end
            end)
        end
    end
end

--关闭
function HeroHighEquipInfoWindow:onClickCloseBtn()
    controller:openHighEquipInfoWindow(false)
end

function HeroHighEquipInfoWindow:onTabBtn2()
    if not self.data then return end
    if not self.item_config then return end
    HeroController:getInstance():openHighEquipMainWindow(true, self.data, self.partner_id)
    controller:openHighEquipInfoWindow(false)
end

--卸下
function HeroHighEquipInfoWindow:onTabBtn1()
    if not self.data or not self.data.id or not self.item_config then return end
    if self.cloth_type ==  PartnerConst.EqmTips.partner then --2是卸下
        --装备唯一id
        controller:sender11011(self.partner_id, self.data.id)
        controller:openHighEquipInfoWindow(false)
    end
end
--穿戴和更换
function HeroHighEquipInfoWindow:onTabBtn3()
    if not self.data then return end
    if not self.item_config then return end
    local partner_id = self.partner_id or 0
    local item_id = self.data.id or 0
    local pos_id = self.item_config.type or 0
    if self.cloth_type ==  PartnerConst.EqmTips.backpack then  --1是穿戴
        if partner_id == 0  then 
            MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.partner,1)
        else
            controller:sender11010(partner_id,item_id)
        end
    elseif self.cloth_type ==  PartnerConst.EqmTips.partner then --2是更换
        if BackPackConst.checkIsHolyEquipment(pos_id) then
            local is_open = HeroController:getInstance():getModel():isOpenHolyEquipMentByHerovo(self.partner)
            if not is_open then
                message(TI18N("语言_c_4385"))
                return
            end
            controller:openHeroHolyEquipClothPanel(true, pos_id, self.partner_id, self.data,nil,nil,self.partner)
        else
            controller:openEquipPanel(true, pos_id, self.partner_id, self.data)
        end
    end
    controller:openHighEquipInfoWindow(false)
end
--来源
function HeroHighEquipInfoWindow:onTabBtn5(sender)
    local cfg = Config.PartnerGoldeqmData.data_get_patch_compose
    local suipian_id
    for k, v in pairs(cfg) do
        if v.gold_eqm_id == self.item_config.id then
            suipian_id = v.id
            break
        end
    end
    if suipian_id then
        local config = Config.ItemData.data_get_data(suipian_id)
        BackpackController:getInstance():openTipsSource(true, config)
        controller:openHighEquipInfoWindow(false)
    end
end
--分解
function HeroHighEquipInfoWindow:onTabBtn6(sender)
    HeroController:getInstance():openHighEquipComposeWindow(true,self.data)
    controller:openHighEquipInfoWindow(false)
end
--穿戴
function HeroHighEquipInfoWindow:onTabBtn4(sender)
    if not self.data then return end
    if not self.item_config then return end
    local partner_id = self.partner_id or 0
    local item_id = self.data.id or 0
    local pos_id = self.item_config.type or 0
    if partner_id == 0 then 
        MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.partner,1)
    else
        controller:sender11010(partner_id,item_id)
    end
    controller:openHighEquipInfoWindow(false)
end

--[[
    @desc: 打开时候附加的参数
    author:{author}s
    time:2019-05-19 19:48:51
    --@object: {data=data, open_type=open_type, partner=partner}
    @return:
]]
function HeroHighEquipInfoWindow:openRootWnd(object)
    self.data = object.data
    self.cloth_type = object.open_type or PartnerConst.EqmTips.normal
    self.partner = object.partner
    self.is_tujian = false

    if self.partner then
        self.partner_id = self.partner.partner_id
    end
    if not self.partner_id then
        self.partner_id = 0
    end
    -- 因为传参不同,这边需要获取不同的配置数据
    local data = object.data
    local item_config = nil
    if type(data) == "number" then
        item_config = Config.ItemData.data_get_data(data)
    else
        if data.config then
            item_config = data.config
        else
            if data.bid then
                item_config = Config.ItemData.data_get_data(data.bid)
            elseif data.id then
                item_config = Config.ItemData.data_get_data(data.id)
            else
                item_config = data
            end
        end
    end
    self.item_config = item_config
    if self.item_config == nil then return end
    if self.cloth_type == PartnerConst.EqmTips.backpack or self.cloth_type == PartnerConst.EqmTips.partner then
        BackpackController:getInstance():sender11446(self.partner_id,self.data.id)
    else
        -- self:initData()
    end

    if self.data.gold_eqm_info and type(self.data.gold_eqm_info) == "table" and next(self.data.gold_eqm_info) then
        local gold_info = self.data.gold_eqm_info[1]
        self.gold_info = gold_info
    else
        local gold_info = {
                enchant_attr = {},
                enchant_exp = 0,
                enchant_level = 1,
                refine_attr = {},
                refine_level = 0,
                soul_exp = 0,
                soul_level = 0,
                star_level = 1,
                start_attr = {},
        }
        local item_id = self.item_config.id
        local cfg = Config.PartnerGoldeqmData.data_get_eqm_star(getNorKey(item_id,1))
        local star_attr = cfg.attr
        local a = {}
        for k, v in pairs(star_attr) do
            local attr_key = v[1]
            local attr_val = v[2]
            local key_id =  Config.AttrData.data_key_to_id[attr_key]
            table.insert(a, {attr_id = key_id,attr_val = attr_val})
        end
        gold_info.start_attr = a
        self.gold_info = gold_info
    end

    self:initData()
    self:addDataBindEvent()
    self:checkUpRedStatus()
end

function HeroHighEquipInfoWindow:initData()
    -- if self.cloth_type == PartnerConst.EqmTips.backpack or self.cloth_type == PartnerConst.EqmTips.partner then
    --     local equip_one_id = self.data.id
    --     local gold_info = BackpackController:getInstance():getModel():getGoldEquipData(equip_one_id)
    --     self.gold_info = gold_info
    -- else
   
    -- end
    --检测一下数据，防止游戏报错
    if not self.gold_info.enchant_attr then
        self.gold_info.enchant_attr = {}
    end
    if not self.gold_info.enchant_exp then
        self.gold_info.enchant_exp = 0
    end
    if not self.gold_info.enchant_level then
        self.gold_info.enchant_level = 1
    end
    if not self.gold_info.refine_attr then
        self.gold_info.refine_attr = {}
    end
    if not self.gold_info.refine_level then
        self.gold_info.refine_level =0
    end
    if not self.gold_info.soul_exp then
        self.gold_info.soul_exp =0
    end
    if not self.gold_info.soul_level then
        self.gold_info.soul_level =0
    end
    if not self.gold_info.star_level then
        self.gold_info.star_level =1
    end
    if not self.gold_info.start_attr then
        self.gold_info.start_attr = {}
    end

     --原本高度
    local target_height  = self.container_init_size.height
    -- 是否显示按钮部分
    self:updateBtnList()
    --基础信息
    self:setBaseInfo()
    --基础属性
    local baseattr_height = self:setBaseAttrInfo()
    
    --铸魂属性
    local soulattr_height = self:setSoulAttrInfo()
    self.soul_panel:setPositionY(self.baseattr_panel:getPositionY() - baseattr_height - 5)

    --是否显示套装属性-----------开始
    local need_show_suitattr = false
    local need_show_skill = nil
    local suitattr_height = 0

    if self.item_config.eqm_set ~= 0 then
        if self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--普通装备 
            self.suit_config = Config.PartnerEqmData.data_eqm_suit[self.item_config.eqm_set]
            self.suit_id = self.item_config.eqm_set
        end
        if self.suit_config then
            need_show_suitattr = true
            table_sort( self.suit_config, function(a, b) return a.num < b.num end)
        end
    end
    if need_show_suitattr then
        suitattr_height, need_show_skill = self:setSuitAttrInfo()
        self.suitattr_panel:setPositionY(self.soul_panel:getPositionY()- soulattr_height)
    end
    self.suitattr_panel:setVisible(true)
    --是否显示套装属性-----------结束
    
    --是否显示技能
    if need_show_skill and next(need_show_skill) then
        self.skill_panel:setPositionY(self.suitattr_panel:getPositionY()-suitattr_height-5)
        self.skill_scroller = createScrollView(self.skill_panel:getContentSize().width, self.skill_panel:getContentSize().height-30, 0, 0, self.skill_panel, ccui.ScrollViewDir.vertical) 
        self.skill_scroller:setTouchEnabled(false)
        table_sort(need_show_skill, function(a, b) return a.act_num < b.act_num end)
        local _all_height = (120+2) * #need_show_skill
        self.skill_scroller:setInnerContainerSize(cc.size(self.skill_panel:getContentSize().width, _all_height))
        for k, v in pairs(need_show_skill) do
            local skill_id = v.skill_id
            local config = Config.SkillData.data_get_skill(skill_id)
            if config then
                target_height = target_height + self.skill_panel_height
                if self.skill_item[k] == nil then
                    self.skill_item[k] = self:createSkillItem(self.skill_scroller)
                end
                self.skill_item[k].skill:showLockIcon(false)
                self.skill_item[k].skill:setData(config)
                local str = "<div fontcolor=%s>%s</div>"
                self.skill_item[k].name:setString(config.name or "")--transformTextToShort(config.des, 60)
                local temp_str = ""
                if self.suit_id == 4018 then
                    temp_str = TI18N("语言_c_6807")
                elseif self.suit_id == 4019 then
                    temp_str = TI18N("语言_c_6818")
                end
                self.skill_item[k].tips:setString(transformTextToShort(string.format(temp_str,v.act_num), 25))
                addEvt2showAllTextTips(self.skill_item[k].tips,string.format(temp_str,v.act_num),25,nil,nil,nil,true,true)
                self.skill_item[k].desc:setString(config.des or "")
                local skill_desc_height = self.skill_item[k].desc:getContentSize().height
                local scroll_height = math.max(skill_desc_height,self.skill_item[k].desc_scroll:getInnerContainerSize().height)
                self.skill_item[k].desc_scroll:setInnerContainerSize(cc.size(self.skill_item[k].desc_scroll:getInnerContainerSize().width, scroll_height))
                self.skill_item[k].desc:setPositionY(scroll_height)
                if skill_desc_height <= self.skill_item[k].desc_scroll:getContentSize().height then
                    self.skill_item[k].desc_scroll:setTouchEnabled(false)
                end
                self.skill_item[k].layer:setPositionX(315)
                self.skill_item[k].layer:setPositionY(_all_height - (k-1)*120 - 60)
                if v.is_suit then
                    setChildUnEnabled(false, self.skill_item[k].layer)
                else
                    setChildUnEnabled(true, self.skill_item[k].layer)
                end
            end
        end
        self.skill_panel:setVisible(true)
    end
end

function HeroHighEquipInfoWindow:updateBtnList()
    if self.cloth_type == PartnerConst.EqmTips.backpack then  --穿戴
        self.tab_btn_1:setVisible(false)
        self.tab_btn_2:setVisible(false)
        self.tab_btn_3:setVisible(false)
        self.tab_btn_4:setVisible(true)
        self.tab_btn_5:setVisible(true)
        self.tab_btn_6:setVisible(true)
    elseif self.cloth_type == PartnerConst.EqmTips.partner then  --卸下
        self.tab_btn_1:setVisible(true)
        self.tab_btn_2:setVisible(true)
        self.tab_btn_3:setVisible(true)
        self.tab_btn_4:setVisible(false)
        self.tab_btn_5:setVisible(false)
        self.tab_btn_6:setVisible(false)
    else --其他地方点击显示来源
        self.tab_btn_1:setVisible(false)
        self.tab_btn_2:setVisible(false)
        self.tab_btn_3:setVisible(false)
        self.tab_btn_4:setVisible(false)
        self.tab_btn_5:setVisible(true)
        self.tab_btn_6:setVisible(false)
    end
    local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
    local featuresId = MainuiConst.FeaturesShield.Gold_equip_strength
    local data_const = Config.PartnerGoldeqmData.data_get_constant
    local role_vo = RoleController:getInstance():getRoleVo()
    if not table.indexof(nohideIds,featuresId) or role_vo.lev < data_const["open_lv"].val then
        self.tab_btn_2:setVisible(false)
    else
        self.tab_btn_2:setVisible(true)
    end

end

--==============================--
--desc:设置基础属性
--time:2018-10-20 09:40:23
--@return 
--==============================--
function HeroHighEquipInfoWindow:setBaseInfo()
    if self.data == nil or self.item_config == nil then return end
    local data = self.data
    
    self.equip_item:setBaseData(self.item_config.id)

    local quality = 0
    if self.item_config.quality and self.item_config.quality >= 0 and self.item_config.quality <= 6 then
        quality = self.item_config.quality
    end
    local background_res = PathTool.getResFrame("common_2", "tips_"..quality)
    if quality == 6 then
        background_res = PathTool.getResFrame("tips", "tips_20")
    end
    -- loadSpriteTexture(self.base_panel, background_res, LOADTEXT_TYPE_PLIST)
    self.base_panel:loadTexture(background_res, LOADTEXT_TYPE_PLIST)
    self.base_panel:setCapInsets(cc.rect(314, 45, 25, 48))
    self.base_panel:setContentSize(cc.size(618, 138))
    local color = BackPackConst.getWhiteQualityColorC4B(quality)
    self.name:setTextColor(color) 

    if self.item_config.type_desc then
        self.equip_type:setString(TI18N("语言_c_1728")..self.item_config.type_desc)
    end

   if self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--普通装备 
        self.score_title:setVisible(true)
        self.power_label:setVisible(true)
        -- local score = data.score or 0
        -- if score <= 0 then 
            local score = self:getBaseScore() or 0
        -- end
        local all_score = data.all_score or 0
        all_score = math.max(all_score,score)
        self.power_label:setNum(all_score)
    end

    local enchant_level = self.gold_info.enchant_level or 1
    local refine_level = self.gold_info.refine_level or 0

    local name = self.item_config.name or ""
    local str = name
    if refine_level > 0 then 
        str = str .. "+" .. refine_level
    end
    self.name:setString(str)

    local key = getNorKey(self.item_config.id,refine_level)
    local info = Config.PartnerGoldeqmData.data_get_eqm_refine(key)
    local max_lv = info.enchant_max_lev
    self.lv:setString(string.format(TI18N("语言_c_6812"), (enchant_level.."/"..max_lv)))
    local soul_level = self.gold_info.soul_level
    local res 
    if soul_level >=5 and soul_level<10 then
        res =  PathTool.getResFrame("common","common_1_215",false,"common_1")
    elseif soul_level >= 10 then
        res =  PathTool.getResFrame("common","common_1_216",false,"common_1")
    end
    self.equip_item:setStarCount(true, self.gold_info.star_level,res)
    self.equip_item:setJieTxt(true, self.gold_info.refine_level)
    self.base_panel:setVisible(true)
end

--==============================--
--desc:设置基础属性
--time:2018-10-20 11:42:16
--@return 
--==============================--
function HeroHighEquipInfoWindow:setBaseAttrInfo()
    if not self.item_config or not self.item_config.ext or not self.item_config.ext[1] then return end
    local base_attr = deepCopy(self.item_config.ext[1][2] or {})
    local attr_info = {}
    if next(self.gold_info.enchant_attr) then
        for k, v in pairs(self.gold_info.enchant_attr) do
            local attr_key = Config.AttrData.data_id_to_key[v.attr_id]
            local attr_val = v.attr_val
            table.insert( attr_info, {attr_key,attr_val} )
        end
    end
    if next(self.gold_info.refine_attr) then
        for k, v in pairs(self.gold_info.refine_attr) do
            local attr_key = Config.AttrData.data_id_to_key[v.attr_id]
            local attr_val = v.attr_val
            table.insert( attr_info, {attr_key,attr_val} )
        end
    end
    if next(self.gold_info.start_attr) then
        for k, v in pairs(self.gold_info.start_attr) do
            local attr_key = Config.AttrData.data_id_to_key[v.attr_id]
            local attr_val = v.attr_val
            table.insert( attr_info, {attr_key,attr_val} )
        end
    end
    local list = {}
    for k, v in pairs(attr_info) do
        local attr_key = v[1]
        local attr_val = v[2]
        if list[attr_key] then
            list[attr_key] = list[attr_key] + attr_val
        else
            list[attr_key] = attr_val
        end
    end
    for k, v in pairs(base_attr) do
        local attr_key = v[1]
        local attr_val = v[2]
        if list[attr_key] then
            list[attr_key] = list[attr_key] + attr_val
        else
            list[attr_key] = attr_val
        end
    end
    local _list = {}
    for k, v in pairs(list) do
        local key_id =  Config.AttrData.data_key_to_id[k]
        local a = {k,v,key_id}
        table.insert(_list, a)
    end
    table_sort(_list, function(a, b) return a[3] < b[3] end)
    -- if next(attr_info) then
    --     local list = {}
    --     for k, v in pairs(attr_info) do
    --         local attr_key = v[1]
    --         local attr_val = v[2]
    --         for key, val in pairs(base_attr) do
    --             local _key = val[1]
    --             local _val = val[2]
    --             if attr_key == _key then
    --                 attr_val = attr_val + _val
    --             end
    --         end
    --         table.insert( list, {attr_key,attr_val} )
    --     end
    --     base_attr = list
    -- end

    local index = 1 
    local _h = math.ceil(#_list/2) * 40 + 55
    self.baseattr_panel:setContentSize(cc.size(630,_h))
    self.baseattr_label:setPositionY(self.baseattr_panel:getContentSize().height - 33)
    local _h = 5
    for i,v in ipairs(_list) do
        local attr_key = v[1]
        local attr_val = v[2]
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if attr_name or attr_key == "activation" then
            if not self.base_list[index] then 
                self.base_list[index] = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 28), nil, nil, 380)
                self.baseattr_panel:addChild(self.base_list[index])
            end
            local label = self.base_list[index]
            local _x = 40 + 300 * ((index-1) % 2)
            local _y = 20 + math.floor((index-1)/2)*40
            label:setPosition(cc.p(_x,_y))
            if attr_name then
                local icon = PathTool.getAttrIconByStr(attr_key)
                local is_per = PartnerCalculate.isShowPerByStr(attr_key)
                if is_per == true then
                    attr_val = (attr_val*0.1).."%"
                end
                local attr_str = string_format("<img src='%s' scale=1 /> <div fontcolor=#c1b7ab> %s：</div><div fontcolor=#ffeedd>%s</div>", PathTool.getResFrame("common", icon), attr_name, attr_val)
                label:setString(attr_str)
                _h = _h + label:getContentSize().height +5
            end
            index = index + 1
        end
    end
    self.baseattr_panel:setVisible(true)
    return self.baseattr_panel:getContentSize().height
end

--设置铸魂属性
function HeroHighEquipInfoWindow:setSoulAttrInfo()
    self.soul_attr_name:setVisible(true)
    local gold_info = self.gold_info
    local soul_level = gold_info.soul_level
    if not self.soul_attr_txt then 
        self.soul_attr_txt = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(40, 28), nil, nil, 580)
        self.soul_panel:addChild(self.soul_attr_txt)
    end
    if soul_level and soul_level > 0 then --铸魂开了
        local cfg = Config.PartnerGoldeqmData.data_get_eqm_soul 
        local equip_bid = self.item_config.id
        local now_key = getNorKey(equip_bid, soul_level)
        local data = cfg(now_key)
        local _attr_val = data.star_attr_ratio
        -- self.soul_attr_txt:setString(TI18N("语言_c_6795")..(_attr_val/1000 * 100).."%")
        self.soul_attr_txt:setString(string.format(TI18N("语言_c_6795"), ((_attr_val/1000 * 100).."%")))
    else
        local a = Config.PartnerGoldeqmData.data_get_constant.forge_limit.val
        local str1 = string.format(TI18N("语言_c_6830"), a)
        local str2 = "<img src=%s visible=true scale=0.80 /><div fontcolor=#c1b7ab>%s</div>"
        self.soul_attr_txt:setString(string.format(str2, PathTool.getResFrame("common","common_90009_1"),str1))
    end
    local _h = self.soul_attr_name:getContentSize().height
    _h = _h + self.soul_attr_txt:getContentSize().height + 25
    self.soul_attr_name:setPositionY(_h - 15)
    self.soul_attr_name:setPositionX(20)
    self.soul_attr_txt:setPositionY(self.soul_attr_txt:getContentSize().height/2 + 10)
    self.soul_panel:setContentSize(cc.size(630,_h))
    self.soul_panel:setVisible(true)
    return _h
end

--装备套装属性
function HeroHighEquipInfoWindow:setSuitAttrInfo()
    if not self.suit_config then return -1 end
    if not self.item_config then return -1 end
    --计算激活数量 (只有穿带才可能激活)
    local act_count, cur_suit_config = self:getEquipActiveCount()
    --套装列表
    local suit_list = {}
    local max_config = self.suit_config[#self.suit_config]
    local max_count = max_config.num
    local name = nil

    for i,v in ipairs(self.suit_config) do
        if name == nil then
            name = v.name
        end
        if (v.attr and next(v.attr) ~= nil) then
            local suit = {}
            suit.count = v.num
            if self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--普通装备 
                if cur_suit_config and cur_suit_config[v.num] then
                    for _,cur_suit in ipairs(cur_suit_config[v.num]) do
                        if cur_suit.num == v.num then
                            suit.attr = cur_suit.attr[#cur_suit.attr] 
                            suit.name =  cur_suit.abb_name
                            suit.is_suit =  true
                        end
                    end
                    if suit.attr == nil then
                        suit.attr = v.attr[#v.attr]
                        suit.name =  v.abb_name
                    end
                else
                    suit.attr = v.attr[#v.attr] 
                    suit.name =  v.abb_name               
                end
            end
            table_insert(suit_list, suit)
        end
    end
    local count = #suit_list

    for i,suit in ipairs(suit_list) do
        if self.suit_item_list[i] == nil then
            self.suit_item_list[i] = self:createattrItem(i, self.suitattr_panel)
            self.suit_item_list[i].icon:setVisible(false)
            self.suit_item_list[i].node:setPosition(0, 26-(i-1)*50)
        end
        
        local type_str = type(suit.attr)
        local attr_color = "c1b7ab"
        local val_color = "ffeedd"
        --是否激活
        if act_count >= suit.count then
            val_color = "8bff8e"
            attr_color  = val_color
        end 

        if type_str == "table" then
            --说明是属性
            local attr_key = suit.attr[1]
            local attr_val = suit.attr[2]
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val*0.1).."%"
            end
            local icon = PathTool.getAttrIconByStr(attr_key)
            local attr_str = string_format("<img src='%s' scale=1 /> <div fontcolor=#%s> %s：</div><div fontcolor=#%s>%s</div>", PathTool.getResFrame("common", icon), attr_color, attr_name, val_color, attr_val)
            self.suit_item_list[i].attr:setString(attr_str)
        end

        if suit.name then
            local act_str = string_format("<div fontcolor=#%s>(%s%s%s)</div>",val_color, suit.name, suit.count,TI18N("语言_c_3054"))
            self.suit_item_list[i].act_info:setString(act_str)
        else
            local act_str = string_format("<div fontcolor=#%s>(%s%s)</div>", val_color, suit.count, TI18N("语言_c_3054"))
            self.suit_item_list[i].act_info:setString(act_str)
        end

    end

    local all_skill_list = {}
    for i, v in ipairs(self.suit_config) do
        local act_num = v.num
        for i, val in ipairs(v.skill) do
            if not all_skill_list[val] then
                all_skill_list[val] = {act_num = act_num}
            end
        end
    end
    local suit_id = self.suit_config[1].id
    local cur_count = 0
    if cur_suit_config then
        for i,v in ipairs(cur_suit_config) do
            if v[1].id == suit_id then
                cur_count = cur_count + 1
            end
        end
    end
    local show_skill_id = {}
    for k, v in pairs(all_skill_list) do
        local id = k
        local suit = {}
        suit.skill_id = id
        suit.is_suit = cur_count>=v.act_num
        suit.act_num = v.act_num
        table.insert(show_skill_id, suit)
    end

    return self.suitattr_panel_height + 50 *(count - 1), show_skill_id
end

--获取装备激活数量
function HeroHighEquipInfoWindow:getEquipActiveCount()
    if not self.partner_id or self.partner_id == 0 then
        return 0
    end
    -- 套装数量
    local count = 0
    local equip_list = {}
    if self.item_config.sub_type == BackPackConst.item_tab_type.EQUIPS then--普通装备 
        if self.partner.eqms ~= nil then
            --说明是网络返回的
            for i,v in ipairs(self.partner.eqms) do
                equip_list[v.type] = GoodsVo.New(v.base_id)
            end
        elseif self.partner.eqm_list ~= nil then
            --说明是本地的 hero_vo
            for k,v in pairs(self.partner.eqm_list) do
                equip_list[k] = v
            end
        end

        local suit_config = {}
        for k, goodvo in pairs(equip_list) do
            if goodvo.config then
                if goodvo.config.eqm_set > 0 then
                    count = count + 1
                    local set_config = Config.PartnerEqmData.data_eqm_suit[goodvo.config.eqm_set]
                    if set_config ~= nil then
                        table_insert(suit_config, set_config)
                    end
                end
            end
        end
        table_sort( suit_config, function(a, b) 
                if a[1] and b[1] and a[1].id and b[1].id then
                    return a[1].id > b[1].id
                else
                    return false
                end
            end)
        return count, suit_config
    end
end

function HeroHighEquipInfoWindow:createattrItem(index, parent)
    if not parent then return end
    local object = {}
    object.node = ccui.Layout:create()
    object.node:setAnchorPoint(cc.p(0, 0.5))
    object.node:setContentSize(cc.size(360, 28))
    object.node:setPosition(0, 26-(index-1)*40)
    parent:addChild(object.node)
    object.node:setTouchEnabled(true)
    object.attr = createRichLabel(20, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(40, 14), -2, nil, 280)
    object.node:addChild(object.attr)
    object.icon = createImage(object.node, PathTool.getResFrame("holy_starup","holy_starup_6"),0, 14, cc.p(0,0.5), true)
    object.icon:setVisible(false)
    object.act_info = createRichLabel(20, cc.c4b(0xff,0xee,0xdd,0xff), cc.p(1, 0.5), cc.p(580, 14), -10, nil, 380)
    object.node:addChild(object.act_info)
    return object
end

--==============================--
--desc:创建技能显示单例
--==============================--
function HeroHighEquipInfoWindow:createSkillItem(parent)
    local item = {}
	local layer = ccui.Layout:create()
    layer:setAnchorPoint(cc.p(0.5, 0.5))
    layer:setContentSize(cc.size(630,120))
    parent:addChild(layer)

	local skill_item = self.item:clone()
    layer:addChild(skill_item)
    skill_item:setPositionX(315)
    skill_item:setPositionY(60)
    local node = skill_item:getChildByName("Node_4")
    local skill = SkillItem.new(true,true,true,0.8)
    node:addChild(skill)
    skill:setPosition(23, 23)
    local name = skill_item:getChildByName("title")-- createLabel(24,cc.c4b(0xfe,0xee,0xba,0xff),nil,140, 96,"",parent,1,cc.p(0,0))
    local tips = skill_item:getChildByName("item_value_1")--createRichLabel(18,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(25, 115),4,nil,260)
    local desc_scroll =  createScrollView(480,60,120,71,skill_item,ccui.ScrollViewDir.vertical)
    desc_scroll:setAnchorPoint(cc.p(0,1))
    local desc = createRichLabel(18,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(0, 71),4,nil,480)
    desc_scroll:addChild(desc)
    

    item.layer = layer
    item.skill = skill
    item.tips = tips
    item.name = name
    item.desc_scroll = desc_scroll
    item.desc = desc
    return item
end

--计算基础评分
function HeroHighEquipInfoWindow:getBaseScore()
    if not self.item_config or not self.item_config.ext or not self.item_config.ext[1] then return 0 end
    local base_attr = self.item_config.ext[1][2] or {}
    local num = PartnerCalculate.calculatePower(base_attr)

    local enchant_score = 0
    local refine_score = 0
    local start_score = 0
    if self.gold_info and next(self.gold_info) then
        local gold_info = self.gold_info
        local enchant_attr = gold_info.enchant_attr
        local enchant_new = {}
        for k, v in pairs(enchant_attr) do
            local attr_id = v.attr_id
            local attr_key = Config.AttrData.data_id_to_key[attr_id]
            local attr = {attr_key,v.attr_val}
            table.insert(enchant_new,attr)
        end

        local refine_attr = gold_info.refine_attr
        local refine_new = {}
        for k, v in pairs(refine_attr) do
            local attr_id = v.attr_id
            local attr_key = Config.AttrData.data_id_to_key[attr_id]
            local attr = {attr_key,v.attr_val}
            table.insert(refine_new,attr)
        end

        local start_attr = gold_info.start_attr
        local star_new = {}
        for k, v in pairs(start_attr) do
            local attr_id = v.attr_id
            local attr_key = Config.AttrData.data_id_to_key[attr_id]
            local attr = {attr_key,v.attr_val}
            table.insert(star_new,attr)
        end
        enchant_score = PartnerCalculate.calculatePower(enchant_new) 
        refine_score = PartnerCalculate.calculatePower(refine_new) 
        start_score = PartnerCalculate.calculatePower(star_new) 
    end
    return enchant_score + refine_score + start_score + num
end

--计算强化相关红点
function HeroHighEquipInfoWindow:checkUpRedStatus()
    if self.cloth_type == PartnerConst.EqmTips.partner then
        --是否有更强力的装备
        addRedPointToNodeByStatus(self.tab_btn_3, false)   
        local equip_type = self.item_config.type
        local equip_score_list = BackpackController:getInstance():getModel():getAllEquipListByType(equip_type)
        local score = self:getBaseScore() or 0
        if equip_score_list then
            --要判断当前装备比背包的装备评分底才显示红点
            for k,equip_item in pairs(equip_score_list) do
                if equip_item.all_score and equip_item.all_score > score then 
                    addRedPointToNodeByStatus(self.tab_btn_3, true,10,5)
                    break
                end
            end
        end 

        local gold_info = self.gold_info
        local vo = {id = self.item_config.id,
            refine_level = gold_info.refine_level,
            enchant_level = gold_info.enchant_level,
            star_level = gold_info.star_level,
            soul_level = gold_info.soul_level,
        }
        local red_1 = HeroController:getInstance():getModel():checkGoldEqmCanUplv(vo)
        if red_1 then
            addRedPointToNodeByStatus(self.tab_btn_2, red_1,10,5)
            return
        end
        local red_2 = HeroController:getInstance():getModel():checkGoldEqmCanUpStar(vo)
        if red_2 then
            addRedPointToNodeByStatus(self.tab_btn_2, red_2,10,5)
            return
        end
        local red_3 = HeroController:getInstance():getModel():checkGoldEqmCanSoul(vo)
        if red_3 then
            addRedPointToNodeByStatus(self.tab_btn_2, red_3,10,5)
            return
        end
    end
end

function HeroHighEquipInfoWindow:close_callback()
    if self.equip_item then 
        self.equip_item:DeleteMe()
        self.equip_item = nil
    end
    if self.power_label then 
        self.power_label:DeleteMe()
        self.power_label = nil
    end

    if self.item_update_event ~= nil then
        self.data:UnBind(self.item_update_event)
        self.item_update_event = nil
    end
    if self.updateEquipInfoEvent then
        GlobalEvent:getInstance():UnBind(self.updateEquipInfoEvent)
        self.updateEquipInfoEvent = nil
    end
    controller:openHighEquipInfoWindow(false)
end
