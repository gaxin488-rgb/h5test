HeroHighEquipSoulPreviewWindow = HeroHighEquipSoulPreviewWindow or BaseClass(BaseView)

local controller = HeroController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_sort = table.sort
local table_insert = table.insert

function HeroHighEquipSoulPreviewWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "hero/hero_high_equip_soul_preview_window"
end

function HeroHighEquipSoulPreviewWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.mainContainer = self.root_wnd:getChildByName("main_panel")
    self.mainContainer:getChildByName("tips"):setString(TI18N("语言_c_6834"))

    self.equip_node1 = self.mainContainer:getChildByName("equip_node1")
    self.equip_node2 = self.mainContainer:getChildByName("equip_node2")
    self.equip_node3 = self.mainContainer:getChildByName("equip_node3")
    self.equip_item1 = BackPackItem.new()
    self.equip_item1:setScale(0.8)
    self.equip_node1:addChild(self.equip_item1)
    self.equip_item2 = BackPackItem.new()
    self.equip_item2:setScale(0.8)
    self.equip_node2:addChild(self.equip_item2)
    self.equip_item3 = BackPackItem.new()
    self.equip_item3:setScale(0.8)
    self.equip_node3:addChild(self.equip_item3)

    self.lv1 = self.mainContainer:getChildByName("lv1")
    self.lv2 = self.mainContainer:getChildByName("lv2")
    self.lv3 = self.mainContainer:getChildByName("lv3")

end

function HeroHighEquipSoulPreviewWindow:register_event()
    registerButtonEventListener(self.background, function() 
        controller:openHighEquipSoulPreviewWindow(false)
    end ,false, 2)
end

function HeroHighEquipSoulPreviewWindow:openRootWnd(equip_data,partner_id)
    if not equip_data then
        return
    end
    self.equip_data = equip_data
    -- self.partner_id = partner_id
    self:updateInfo()
end

function HeroHighEquipSoulPreviewWindow:updateInfo()
    -- self.gold_info = BackpackController:getInstance():getModel():getGoldEquipData(self.equip_data.id)
    -- if not self.gold_info then
    --     return
    -- end
    -- local eqm_jie = self.gold_info.refine_level
    -- local eqm_name = self.equip_data.config.name
    -- -- self.equip_name:setString(eqm_name .. "+" .. eqm_jie)
    -- self.equip_name:setString(string.format("<div outline=2,#3e1200>%s</div><div fontcolor=#13ff13 fontsize=26 outline=2,#3e1200> +%s</div>",eqm_name,eqm_jie))

    local equip_bid = self.equip_data.config.id
    self.equip_item1:setBaseData(equip_bid)
    self.equip_item1:setStarCount(true, 6)
    self.equip_item2:setBaseData(equip_bid)
    self.equip_item2:setStarCount(true, 6,PathTool.getResFrame("common","common_1_215",false,"common_1"))
    self.equip_item3:setBaseData(equip_bid)
    self.equip_item3:setStarCount(true, 6,PathTool.getResFrame("common","common_1_216",false,"common_1"))
    local str = "%s %s-%s %s"
    self.lv1:setString(string.format(str,TI18N("语言_c_453"),1,TI18N("语言_c_453"),4))
    self.lv2:setString(string.format(str,TI18N("语言_c_453"),5,TI18N("语言_c_453"),9))
    self.lv3:setString(string.format("%s %s",TI18N("语言_c_453"),10))
end

function HeroHighEquipSoulPreviewWindow:close_callback()
    if self.equip_item1 then
        self.equip_item1:DeleteMe()
        self.equip_item1 = nil
    end
    if self.equip_item2 then
        self.equip_item2:DeleteMe()
        self.equip_item2 = nil
    end
    if self.equip_item3 then
        self.equip_item3:DeleteMe()
        self.equip_item3 = nil
    end
    controller:openHighEquipSoulPreviewWindow(false)
end