-- --------------------------------------------------------------------
-- 竖版神装装备穿戴
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2020-2-27
-- --------------------------------------------------------------------
HeroStarupCostHelpPanel = HeroStarupCostHelpPanel or BaseClass(BaseView)
    
local controller = HeroController:getInstance()
local model = controller:getModel()
local table_insert =table.insert
local table_sort = table.sort
local math_floor = math.floor
local string_format = string.format

--@holy_data 神装方案数据 结构参考 协议25220
function HeroStarupCostHelpPanel:__init()
    self.is_full_screen = false
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "hero/hero_starup_cost_help_panel"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("hero","hero"), type = ResourcesType.plist },
    }
    self.show_list = {}
end 

function HeroStarupCostHelpPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_panel , 1) 
    self.main_panel:getChildByName("wnd_title"):setString(TI18N("语言_c_4405"))

    self.close_btn = self.main_panel:getChildByName("close_btn")

    self.scroll_container = self.main_panel:getChildByName("scroll_container")
    self.scroll_container:setScrollBarEnabled(false)
end

function HeroStarupCostHelpPanel:register_event()
    registerButtonEventListener(self.close_btn, function()
        controller:openHeroStarupCostHelpPanel(false)
    end, true, 2)
    
    registerButtonEventListener(self.background, function()
        controller:openHeroStarupCostHelpPanel(false)
    end, false, 2)
end

function HeroStarupCostHelpPanel:openRootWnd(hero_vo)
    self:configListData(hero_vo)
    -- self:updateList()
    self:updateScrollView()
end

function HeroStarupCostHelpPanel:updateScrollView()
    self.list_item = {}
    local item_size_height = 0
    for i,v in ipairs(self.show_list) do
        local item = HeroStarupCostItem.new()
        self.scroll_container:addChild(item)
        self.list_item[i] = item
        item:setData(v, i, self.scroll_container)
        item_size_height = item_size_height + item:getSize().height
    end
    local inner_size = self.scroll_container:getInnerContainerSize()
    local total_height = inner_size.height
    if inner_size.height < item_size_height then
        self.scroll_container:setInnerContainerSize(cc.size(inner_size.width, item_size_height))
        total_height = item_size_height
    end
    local p_y = total_height
    for i,v in ipairs(self.list_item) do
        p_y = p_y - v:getSize().height
        v:setPositionY(p_y)
    end
end

function HeroStarupCostHelpPanel:configListData(hero_vo)
    -- 进入后显示该英雄升星所需要的材料
    -- 默认显示至10星所需材料
    
    -- 英雄10星后可查看 10升11,11升12的所需材料
    -- 英雄11星后可查看12升13星所需材料
    local cur_star = hero_vo.star
    local max_star = Config.PartnerData.data_partner_max_star[hero_vo.bid]
    local base_config = Config.PartnerData.data_partner_base[hero_vo.bid]
    local tar_star = max_star < 10 and max_star or 10
    for i=(base_config.init_star + 1),tar_star do
        self.show_list[#self.show_list + 1] = {first_star = (i - 1), next_star = i, hero_vo = hero_vo}
    end
    if hero_vo.star == 10 then
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
    elseif hero_vo.star > 10 then 
        if cur_star == 11 and max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
    end
end

function HeroStarupCostHelpPanel:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.scroll_container:getContentSize()
        local setting = {
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 0,                     -- y方向的间隔
            item_width = 595,                -- 单元的尺寸width
            item_height = 425,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 1,                    -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(self.scroll_container, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    if #self.show_list == 0 then
        self:showEmptyIcon(true)
    else
        self:showEmptyIcon(false)
    end
    self.item_scrollview:reloadData()
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroStarupCostHelpPanel:createNewCell(width, height)
    local cell = HeroStarupCostItem.new(width, height)
    --  cell:addCallBack(function() self:onCellTouched(cell) end)
     return cell
 end
 --获取数据数量
 function HeroStarupCostHelpPanel:numberOfCells()
     if not self.show_list then return 0 end
     return #self.show_list
 end
 --更新cell(拖动的时候.刷新数据时候会执行次方法)
 --cell :createNewCell的返回的对象
 --index :数据的索引
 function HeroStarupCostHelpPanel:updateCellByIndex(cell, index)
     cell.index = index
     local cell_data = self.show_list[index]
     if not cell_data then return end
     cell:setData(cell_data)
 end
 
 --点击cell .需要在 createNewCell 设置点击事件
 function HeroStarupCostHelpPanel:onCellTouched(cell)
 end

 function HeroStarupCostHelpPanel:showEmptyIcon(state)
 end

function HeroStarupCostHelpPanel:close_callback()
    controller:openHeroStarupCostHelpPanel(false)
end

-- --------------------------------------------------------------------
-- 竖版装备穿戴子项
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2020-2-27
-- --------------------------------------------------------------------
HeroStarupCostItem = class("HeroStarupCostItem", function()
    return ccui.Widget:create()
end)

function HeroStarupCostItem:ctor()  
    self:config()
    self:layoutUI()
end

function HeroStarupCostItem:config()
    self.attr_list = {}
    self.star_list = {}
end
function HeroStarupCostItem:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_starup_cost_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self:setAnchorPoint(cc.p(0, 0))

    self.main_panel = self.root_wnd:getChildByName("main_container")

    self.item_nodes = {}
    for i=1,4 do
        local panel = self.main_panel:getChildByName("layout_bg"..i)
        local scrollview = panel:getChildByName("scrollview_"..i)
        scrollview:setScrollBarEnabled(false)
        scrollview:setSwallowTouches(false)
        local item_node = scrollview:getChildByName("item_node_"..i)
        local sp_starup_star = panel:getChildByName("sp_starup_star_"..i)
        panel:getChildByName("star_rank_name"):setString(TI18N("语言_c_1")..i)
        panel:getChildByName("des_label_0"):setString(TI18N("语言_c_4406"))
        item_node.star_rank_name = panel:getChildByName("star_rank_name")
        item_node.des_label_0 = panel:getChildByName("des_label_0")
        item_node.scrollview = scrollview
        item_node.sp_starup_star = sp_starup_star
        self.item_nodes[#self.item_nodes + 1] = item_node 
        item_node.panel = panel
    end
    self.des_label = self.main_panel:getChildByName("des_label")
    self.des_label:setString(TI18N("语言_c_4406"))
    --星星node
    self.left_star_node = self.main_panel:getChildByName("left_star_node")
    self.right_star_node = self.main_panel:getChildByName("right_star_node")
end

function HeroStarupCostItem:setData(data)
    if not data then return end
    self.data = data.hero_vo
    local first_star = data.first_star
    local next_star = data.next_star
    local bid = data.hero_vo.bid

    self.left_star_setting = model:createStar(first_star, self.left_star_node, self.left_star_setting)
    self.right_star_setting = model:createStar(next_star, self.right_star_node, self.right_star_setting)

    if next_star <= 11 then
        --十一星之前
        local next_key = getNorKey(bid, next_star)
        local config = Config.PartnerData.data_partner_star(next_key)
        self:updateItemDataByConfig(config, self.item_nodes[1])
        self.des_label:setVisible(true)
        self.item_nodes[4].panel:setVisible(false)
        self.item_nodes[2].panel:setVisible(false)
        self.item_nodes[3].panel:setVisible(false)
        self.item_nodes[1].sp_starup_star:setVisible(false)
        self.item_nodes[1].star_rank_name:setVisible(false)
        self.item_nodes[1].des_label_0:setVisible(false)
        self.item_nodes[4].sp_starup_star:setVisible(false)
        self.item_nodes[4].star_rank_name:setVisible(false)
        self.item_nodes[4].des_label_0:setVisible(false)
        self.item_nodes[2].sp_starup_star:setVisible(false)
        self.item_nodes[2].star_rank_name:setVisible(false)
        self.item_nodes[2].des_label_0:setVisible(false)
        self.item_nodes[3].sp_starup_star:setVisible(false)
        self.item_nodes[3].star_rank_name:setVisible(false)
        self.item_nodes[3].des_label_0:setVisible(false)
    else
        --十一星之后
        self.des_label:setVisible(false)
        for i=1,4 do
            local next_key = getNorKey(bid, first_star, i)
            local config = Config.PartnerData.data_partner_star_step(next_key)

            -- if not model:checkStarStepCompleteByIndex(data.hero_vo, i) then
                self:updateItemDataByConfig(config, self.item_nodes[i])
                self.item_nodes[i].panel:setVisible(true)
                self.item_nodes[i].sp_starup_star:setVisible(true)
                self.item_nodes[i].star_rank_name:setVisible(true)
                self.item_nodes[i].des_label_0:setVisible(true)
            -- else
            --     self.item_nodes[i].scrollview:setVisible(false)
            --     self.item_nodes[i].sp_starup_star:setVisible(true)
            -- end
        end
    end
    --设置尺寸和位置
    self:dolayouScrollView(data)
end

function HeroStarupCostItem:dolayouScrollView(data)
    local count = 0
    local init_height = 220
    local total_height = 220
    for i,v in ipairs(self.item_nodes) do
        if v.panel:isVisible() then
            count = count + 1
        end
        v.hero_item_list = v.hero_item_list or {}
        v.cost_item_list = v.cost_item_list or {}
        if (#v.hero_item_list + #v.cost_item_list) > 4 then
            local size = v.scrollview:getInnerContainerSize()
            v.scrollview:setInnerContainerSize(cc.size(size.width + size.width/4*((#v.hero_item_list + #v.cost_item_list) - 4), size.height))
        end
    end
    total_height = total_height + 130 * (count - 1)
    self.size.height = total_height
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.main_panel:setContentSize(self.size)
    self.main_panel:setPositionY(0)
    self.main_panel:getChildByName("hero_info_24"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("left_star_node"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("right_star_node"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("left_star_node"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("star_arrow"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("des_label"):setPositionY(total_height - 140)
    self.main_panel:getChildByName("layout_bg1"):setPositionY(total_height - 140)
    self.main_panel:getChildByName("layout_bg2"):setPositionY(total_height - 270)
    self.main_panel:getChildByName("layout_bg3"):setPositionY(total_height - 400)
    self.main_panel:getChildByName("layout_bg4"):setPositionY(total_height - 530)
end

function HeroStarupCostItem:getSize()
    return self.size
end

--升星物品材料
function HeroStarupCostItem:updateItemDataByConfig(star_config, item_node)
    if not star_config then return end
    item_node.hero_item_data_list = item_node.hero_item_data_list or {}
    --红点条件list
    -- local conditions_list = {}
    --记录已选id [partner_id] = hero_vo
    -- self.dic_other_selected = {}
    --过滤自己
    -- if self.hero_vo then
    --     self.dic_other_selected[self.hero_vo.partner_id] = self.hero_vo
    -- end
    -- local expend = star_config.expend1[1]
    -- if expend then --主卡
    --     --指定的 {10402,4,1} : 10402: 表示bid, 4: 表示星级 1:表示数量
    --     self.hero_item_data_list[index] = self:getHeroData(expend[1], expend[2], expend[3]) 
    -- end

    --指定的 {10402,4,1} : 10402: 表示bid, 4: 表示星级 1:表示数量
    local index = 1
    for i,expend in ipairs(star_config.expend2) do
        item_node.hero_item_data_list[index] = self:getHeroData(expend[1], expend[2], expend[3])
        -- conditions_list[index] = {}
        -- conditions_list[index][expend[1]] = {}
        -- conditions_list[index][expend[1]][expend[2]] = expend[3]
        index = index + 1
    end
    --随机的 {1,4,2} : 1 表示阵营  4: 表示星级 2表示数量
    for i,expend in ipairs(star_config.expend3) do
        item_node.hero_item_data_list[index] = self:getHeroData(nil, expend[2], expend[3], expend[1])
        -- conditions_list[index] = {}
        -- conditions_list[index][expend[1]] = {}
        -- conditions_list[index][expend[1]][expend[2]] = expend[3]
        index = index + 1
    end
    item_node.hero_item_list = item_node.hero_item_list or {}
    for i,item in ipairs(item_node.hero_item_list) do
        item:setVisible(false)
    end

    for i,hero_vo in ipairs(item_node.hero_item_data_list) do
        if item_node.hero_item_list[i] == nil then
            item_node.hero_item_list[i] = HeroExhibitionItem.new(0.7, false)
            item_node.hero_item_list[i]:setSwallowTouches(false)
            item_node.hero_item_list[i]:setPosition( (i-1) * (HeroExhibitionItem.Width * 0.7 + 3) , 0)
            item_node:addChild(item_node.hero_item_list[i])
        end
        item_node.hero_item_list[i]:setVisible(true)
        if hero_vo.bid == 0 then
            --随机卡的头像id
            local default_head_id = model:getRandomHeroHeadByQuality(hero_vo.star)
            item_node.hero_item_list[i]:setData(hero_vo)
            item_node.hero_item_list[i]:setDefaultHead(default_head_id)
            item_node.hero_item_list[i]:setHeroName(true, string_format(TI18N("语言_c_3022"), hero_vo.star))
        else
            item_node.hero_item_list[i]:setData(hero_vo)
            item_node.hero_item_list[i]:setHeroName(true, hero_vo.name)
        end
        item_node.hero_item_list[i]:setHeadUnEnabled(false)
    end

    -- 额外材料
    item_node.cost_item_list = item_node.cost_item_list or {}
    for k,item in pairs(item_node.cost_item_list) do
        item:setVisible(false)
    end

    local start_index = #item_node.hero_item_data_list
    if star_config.other_expend then
        for i,v in ipairs(star_config.other_expend) do
            local bid = v[1]
            local need_num = v[2]
            -- if bid ~= model.upgrade_star_cost_id then
                local item = item_node.cost_item_list[i]
                if not item then
                    item = BackPackItem.new(false, true, false, 0.7)
                    item:setSwallowTouches(false)
                    item_node:addChild(item)
                    item_node.cost_item_list[i] = item
                end
                item:setPosition( (start_index+i-1) * (BackPackItem.Width * 0.7 + 3) , 0)
                local have_num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(bid)
                item:setBaseData(bid)
                item:setNeedNum(need_num, nil, 1, true, 2)
                -- if need_num > have_num then
                --     item:setDefaultTip(true, true)
                -- else
                    item:setDefaultTip()
                -- end
                item:setVisible(true)
            -- end
        end
    end
end

--@ bid 英雄bid 特殊判断 如果 == nil 说明是随机卡
--@ star 星级
--@ count 数量
--@ camp_type 阵营  如果是随机卡.此一定需要有值
function HeroStarupCostItem:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s", count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
            data.name = base_config.name
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end

function HeroStarupCostItem:setVisibleStatus(bool)
    self:setVisible(bool)
end

function HeroStarupCostItem:DeleteMe()
    self.data = nil
    self:removeFromParent()
end




