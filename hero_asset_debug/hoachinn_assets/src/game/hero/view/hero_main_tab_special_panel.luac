HeroMainTabSpecialPanel = class("HeroMainTabSpecialPanel", function()
    return ccui.Widget:create()
end)

local controller = HeroController:getInstance()
local model = controller:getModel()
local role_vo = RoleController:getInstance():getRoleVo()

function HeroMainTabSpecialPanel:ctor(parent)  
    self.parent = parent
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function HeroMainTabSpecialPanel:config()
    self.show_model = false
    -- self.size = cc.size(680,372.97)
    -- self:setContentSize(self.size)
    self.item_list = {}
end

function HeroMainTabSpecialPanel:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_main_tab_special_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self.tab_panel = self.root_wnd:getChildByName("tab_panel")
    self.type_bg = self.tab_panel:getChildByName("type_bg")
    self.type_lock = self.tab_panel:getChildByName("type_lock")
    self.type_lock:setVisible(false)
    self.tip_bg = self.tab_panel:getChildByName("tip_bg")
    self.tip_txt = self.tab_panel:getChildByName("tip_txt")
    self.tip_img = self.tab_panel:getChildByName("tip_img")
    self.tip_img:setVisible(false)
    self.open_panel = self.tab_panel:getChildByName("open_panel")
    for i = 1, 5 do
        local node = self.tab_panel:getChildByName("node_"..i)
        local item = SkillItem.new(true,true,true,0.87, true)
        node:addChild(item)
        node.item = item
        self.item_list[i]= node
    end

    self.look_btn = self.tab_panel:getChildByName("look_btn")

    self.ur_panel = self.root_wnd:getChildByName("ur_panel")
    self.ur_panel:setVisible(false)
    self.ur_label_go = self.ur_panel:getChildByName("label_go")
    self.ur_label_go:setString("")
    self.ur_label_lv = self.ur_panel:getChildByName("label_lv")
    self.ur_label_lv:setString(TI18N("语言_c_5455"))
    self.ur_label_lv:setScale(1)
    self.ur_node =  self.root_wnd:getChildByName("ur_node")
    -- local bg_res = PathTool.getPlistImgForDownLoad("bigbg/hero", "hero_reset_bg_1", false)
    -- self.bg_load = loadImageTextureFromCDN(self.image_bg, bg_res, ResourcesType.single, self.bg_load)
end

function HeroMainTabSpecialPanel:updateExclusivePropItem()
    if not Config.PartnerUrAwakenData then return end
    if not self.hero_vo then return end
    self:onClickExclusivePropItem()
end
function HeroMainTabSpecialPanel:onClickExclusivePropItem(is_lock)
    if not self.hero_vo then return end
    local data = {panel_type = HERO_SOUL_TYPE, hero_vo = self.hero_vo}
    controller:openHeroUrAweakenPanel(true, data)
end


--事件
function HeroMainTabSpecialPanel:registerEvents()
    --详情
    registerButtonEventListener(self.look_btn, function(param,sender, event_type) 
        local config = Config.PartnerSpecialData.data_const.help_sp_desc
        if config then
            local pos = sender:getTouchBeganPosition()
            TipsManager:getInstance():showCommonTips(config.desc, pos)
        end
    end ,true, 1)
    registerButtonEventListener(self.ur_panel, function(param,sender, event_type) 
        -- self:updateExclusivePropItem()
        self:onClickChangeBtn()
    end ,true, 1)

    registerButtonEventListener(self.open_panel, function(param,sender, event_type) 
        if not model:getSpecialHeroOpne(self.hero_vo.partner_id) then
            message(string.format(TI18N("语言_c_6739"),Config.PartnerSpecialData.data_const.potential_open.val))
            return
        end
        
        if not self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroSpecialLock) then
            self.tip_img:setVisible(false)
            if not self.lock_spine then
                if self.is_ti then
                    self.lock_spine = createEffectSpine("E56002",cc.p(self.open_panel:getContentSize().width*0.5,self.open_panel:getContentSize().height*0.5),cc.p(0.5,0.5),true,PlayerAction.action)
                else
                    self.lock_spine = createEffectSpine("E56001",cc.p(self.open_panel:getContentSize().width*0.5,self.open_panel:getContentSize().height*0.5),cc.p(0.5,0.5),true,PlayerAction.action)
                end
                self.open_panel:addChild(self.lock_spine)
            end
            self.lock_spine:setAnimation(0, PlayerAction.action, false)
            local function eventFunc(event)
                controller:sender11430(self.hero_vo.partner_id)
                controller:openHeroSpecialPanel(true,self.hero_vo,MainuiConst.special_type.special)
            end
            self.lock_spine:registerSpineEventHandler(eventFunc, sp.EventType.ANIMATION_END)
        else
            controller:openHeroSpecialPanel(true,self.hero_vo,MainuiConst.special_type.special)
        end
    end ,true, 1)
    if self.hero_data_update_event == nil then
        self.hero_data_update_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Data_Update, function(hero_vo)
            if not hero_vo or not self.hero_vo then return end
            if hero_vo.partner_id == self.hero_vo.partner_id then
                self:setData(hero_vo,1,true)
            end
        end)
    end
    if self.hero_special_skill_event == nil then
        self.hero_special_skill_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Special_Skill_Event, function(data)
            if not data or not self.hero_vo then return end
            for k,v in pairs(data.partner_ids) do
                if v.partner_id == self.hero_vo.partner_id then
                    self.sp_data = v
                    self:updateData()
                end
            end
        end)
    end
    if not self.hero_get_talent_event then
        self.hero_get_talent_event = GlobalEvent:getInstance():Bind(HeroEvent.Hero_UR_Awaken_Update_Event, function()
            if not self.hero_vo then return end
            -- self:updateUrAweakInfo()
        end)
    end
end

--@hero_vo 英雄数据
function HeroMainTabSpecialPanel:setData(hero_vo,type,_status)
    self.hero_vo = hero_vo
    local cfg = Config.PartnerData.data_partner_base[hero_vo.bid]
    local status = false
    if cfg.sp_skills and next(cfg.sp_skills) then
        for _, v in ipairs(cfg.sp_skills) do
            if Config.PartnerSpecialData.data_task_list[v] then
                status = true
            end
        end
    end
    if status and not _status then
        controller:sender11431({{partner_id = hero_vo.partner_id}})
    else
        self:updateData()
    end
    self:checkUrStatus()
end
--ur觉醒相关
function HeroMainTabSpecialPanel:onClickChangeBtn()
    self.show_model = not self.show_model
    if self.show_model then -- 切换到UR觉醒
        if not self.ur_window then
            self.ur_window = HeroMainTabAwakePanel.new()
            self.ur_window:setAnchorPoint(cc.p(0.5, 0))
            self.ur_node:addChild(self.ur_window)
        end
        self.ur_window:setData(self.hero_vo)
        self.ur_node:setVisible(true)
        self.tab_panel:setVisible(false)
    else
        self.ur_node:setVisible(false)
        self.tab_panel:setVisible(true)
    end
end

