function HeroMainTabSpecialPanel:checkUrStatus()
    if self.hero_vo.star == 16 then
        local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
        local featuresId = Config.PartnerUrAwakenData.data_constant.open_model.val
        if not table.indexof(nohideIds,featuresId) then
            self.ur_panel:setVisible(false)
            return
        end
        local partner_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
        if partner_cfg and partner_cfg.ur_awaken_id and partner_cfg.ur_awaken_id ~= 0 and partner_cfg.ur_awaken_show ~= 0 then
            self.ur_panel:setVisible(true)
            -- addRedPointToNodeByStatus(self.open_panel,false)
            self:onClickChangeBtn()
        end
    else
        self.ur_panel:setVisible(false)

    end
end

--sp觉醒
function HeroMainTabSpecialPanel:updateData()
    local key = getNorKey(self.hero_vo.bid, self.hero_vo.star)
    local star_config = Config.PartnerData.data_partner_star(key)
    if star_config == nil then return end

    self.skill_data = {}
    for k,v in pairs(star_config.skills) do
        if v[1] ~= 1 then
            self.skill_data[v[1]]={}
            self.skill_data[v[1]].pos = v[1]
            self.skill_data[v[1]].skill_bid = v[2]
            self.skill_data[v[1]].type = 1
        end
    end
    local key = getNorKey(self.hero_vo.type, self.hero_vo.break_id, self.hero_vo.break_lev)
    local break_config = Config.PartnerData.data_partner_brach[key]
    for i,skill in pairs(self.skill_data) do
        local config = Config.SkillData.data_get_skill(skill.skill_bid)
        if config then
            --是否锁住
            self.skill_data[i].is_lock = false
            if skill.pos > break_config.skill_num  then
                self.skill_data[i].is_lock = true
            end
        end
    end
    for k,v in pairs(self.hero_vo.skills) do
        for key,value in pairs(self.skill_data) do
            if value.pos == v.pos then
                self.skill_data[v.pos].skill_bid = v.skill_bid
            end
        end
    end
    local hero_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    for k,v in pairs(hero_cfg.sp_skills) do
        local sp_skill = Config.PartnerSpecialData.data_skill_base[v]
        if sp_skill then
            if Config.PartnerSpecialData.data_task_list[v] and self.sp_data and next(self.sp_data) then
                local cfg = Config.PartnerSpecialData.data_task_list[v]
                local skill_bid = 0
                local cfg_list = {}
                for k,v in pairs(cfg) do
                    table.insert(cfg_list, v)
                end
                table.sort(cfg_list, function(a, b) return a.lev < b.lev end)
                local list = {}
                for k,v in pairs(self.sp_data.pos_list[sp_skill.pos].sp_quest_list) do
                    list[v.id] = v
                end
                for k,v in ipairs(cfg_list) do
                    if v.open == 0 and list[v.lev] and list[v.lev].finish == 2 then
                        skill_bid = v.skill_bid
                    end
                end
                if skill_bid > 0 then
                    self.skill_data[sp_skill.pos].skill_bid = skill_bid
                end
            end
            self.skill_data[sp_skill.pos].type = 2
        end
    end
    for i = 2, 6 do
        local list = self.skill_data[i]
        if list then
            local cfg = Config.SkillData.data_get_skill(list.skill_bid)
            if cfg then
                self.item_list[i-1].item:setData(cfg,{is_sp=true})
                self.item_list[i-1].item:showUnEnabled(list.is_lock)
                self.item_list[i-1].item:showLockIcon(list.type == 1,nil,nil,60,10)
                local lev = cfg.level
                if cfg.client_lev and cfg.client_lev>0 then
                    lev = cfg.client_lev
                end
                if list.type == 1 then
                    self.item_list[i-1].item:showName2(false)
                else
                    self.item_list[i-1].item:showName2(true,string.format(TI18N("+%s"),lev),cc.p(60,-10),22,true,cc.c3b(0xff,0xed,0xb7),PathTool.getResFrame("hero/special_hero","special_hero_004"),cc.size(75,28))
                end
            end
        end
    end
    self.is_ti = hero_cfg.hurt_type == 2
    if self.is_ti then
        loadSpriteTexture(self.type_lock, PathTool.getResFrame("hero/special_hero", "special_hero_tai_003"), LOADTEXT_TYPE_PLIST)
        loadSpriteTexture(self.type_bg, PathTool.getPlistImgForDownLoad("hero", "special_hero_tai_bg",false), LOADTEXT_TYPE)
    else
        loadSpriteTexture(self.type_lock, PathTool.getResFrame("hero/special_hero", "special_hero_nin_003"), LOADTEXT_TYPE_PLIST)
        loadSpriteTexture(self.type_bg, PathTool.getPlistImgForDownLoad("hero", "special_hero_nin_bg",false), LOADTEXT_TYPE)
    end
    addRedPointToNodeByStatus(self.open_panel,false)
    if not self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroSpecialLock) then
        if self.is_ti then
            loadSpriteTexture(self.tip_img, PathTool.getResFrame("hero/special_hero", "special_hero_tai_001"), LOADTEXT_TYPE_PLIST)
        else
            loadSpriteTexture(self.tip_img, PathTool.getResFrame("hero/special_hero", "special_hero_nin_001"), LOADTEXT_TYPE_PLIST)
        end
        self.type_lock:setVisible(false)
        self.tip_txt:setString(TI18N("语言_c_1739"))
        if model:getSpecialHeroOpne(self.hero_vo.partner_id) then
            addRedPointToNodeByStatus(self.open_panel,true,10,10)
        end
    else
        if self.is_ti then
            loadSpriteTexture(self.tip_img, PathTool.getResFrame("hero/special_hero", "special_hero_tai_002"), LOADTEXT_TYPE_PLIST)
        else
            loadSpriteTexture(self.tip_img, PathTool.getResFrame("hero/special_hero", "special_hero_nin_002"), LOADTEXT_TYPE_PLIST)
        end
        self.type_lock:setVisible(true)
        self.tip_txt:setString(TI18N("语言_c_295"))
        if self.lock_spine then
            self.lock_spine:removeFromParent()
            self.lock_spine = nil
        end
    end
    self.tip_img:setVisible(true)
    moveTextBg(self.tip_txt,self.tip_bg,40,130)
end


function HeroMainTabSpecialPanel:setVisibleStatus(bool)
    self:setVisible(bool)
end
--移除
function HeroMainTabSpecialPanel:DeleteMe()
	if self.bg_load then 
        self.bg_load:DeleteMe()
        self.bg_load = nil
    end
    if self.lock_spine then
        self.lock_spine:removeFromParent()
        self.lock_spine = nil
    end
    if self.hero_data_update_event then
        GlobalEvent:getInstance():UnBind(self.hero_data_update_event)
        self.hero_data_update_event = nil
    end
    if self.hero_special_skill_event then
        GlobalEvent:getInstance():UnBind(self.hero_special_skill_event)
        self.hero_special_skill_event = nil
    end
    if self.hero_get_talent_event then
        GlobalEvent:getInstance():UnBind(self.hero_get_talent_event)
        self.hero_get_talent_event = nil
    end
    if self.ur_window then
        self.ur_window:DeleteMe()
        self.ur_window = nil
    end
end
