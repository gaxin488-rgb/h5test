HeroDarkLightWindow = HeroDarkLightWindow or BaseClass(BaseView)

local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroDarkLightWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big   
    self.layout_name = "hero/hero_dark_light_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("new_ninja", "new_ninja_3_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("new_ninja", "new_ninja_3_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("new_ninja", "new_ninja_3_3"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("new_ninja", "new_ninja_3_4"), type = ResourcesType.single},
    }
    self.click_index = 2
end

function HeroDarkLightWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")

    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)
    self.panel_bg = self.main_container:getChildByName("panel_bg")
    self.Image_2 = self.main_container:getChildByName("Image_2")
    self.win_title = self.Image_2:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_par_19_2"))
    local _w = math.max(self.win_title:getContentSize().width+120,self.Image_2:getContentSize().width)
    self.Image_2:setContentSize(cc.size(_w,self.Image_2:getContentSize().height))
    self.win_title:setPositionX(_w*0.5)
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.light_panel = self.main_container:getChildByName("light_panel")
    self.light_bg = self.light_panel:getChildByName("light_bg")
    self.light_btn = self.light_panel:getChildByName("light_btn")
    self.light_scroll = self.light_bg:getChildByName("light_scroll")
    self.light_scroll:setCascadeOpacityEnabled(true)
    self.light_scroll:setScrollBarEnabled(false)
    self.light_video_btn = self.light_bg:getChildByName("btn_video")
    self.light_video_txt = self.light_video_btn:getChildByName("txt")
    setTextSpacing(self.light_video_txt,-10)
    self.light_video_txt:setString(TI18N("语言_c_6457"))
    -- self.light_video_btn:setTouchEnabled(false)
    self.dark_panel = self.main_container:getChildByName("dark_panel")
    self.dark_panel:setOpacity(95)
    self.dark_bg = self.dark_panel:getChildByName("dark_bg")
    self.dark_btn = self.dark_panel:getChildByName("dark_btn")
    self.dark_scroll = self.dark_bg:getChildByName("dark_scroll")
    self.dark_scroll:setCascadeOpacityEnabled(true)
    self.dark_scroll:setScrollBarEnabled(false)
    self.dark_video_btn = self.dark_bg:getChildByName("btn_video")
    self.dark_video_btn:setOpacity(0)
    self.dark_video_txt = self.dark_video_btn:getChildByName("txt")
    setTextSpacing(self.dark_video_txt,-10)
    self.dark_video_txt:setString(TI18N("语言_c_6457"))
    self.dark_video_btn:setTouchEnabled(false)
    self.scroll = self.main_container:getChildByName("scroll")
    self.scroll:setScrollBarEnabled(false)
    self.txt = self.scroll:getChildByName("txt")
    setTextMaxWidth(self.txt,self.scroll:getContentSize().width)
    self.click_img = self.main_container:getChildByName("click_img")
    self.left_btn = self.main_container:getChildByName("left_btn")
    self.right_btn = self.main_container:getChildByName("right_btn")
    self.title_bg = self.main_container:getChildByName("title_bg")
    self.title = self.title_bg:getChildByName("title")
    setTextMaxWidth(self.title,570)
    self.click_panel = self.main_container:getChildByName("click_panel")
end

function HeroDarkLightWindow:register_event()
    registerButtonEventListener(self.background,function()
        self:onClickBtnClose()
    end,false, 1)
    registerButtonEventListener(self.close_btn,function()
        self:onClickBtnClose()
    end,false, 1)
    registerButtonEventListener(self.click_panel,function()
        self:onClickBtnChange(self.click_index)
    end,false, 1)
    registerButtonEventListener(self.light_video_btn,function()
        local id = self:getId(self.hero_bid_1)
        if id then
            local num = 1
            if math.floor(self.hero_bid_1/10000) == 4 then
                num = 4
            else
                num = 5
            end
            _controller:sender16820(id,num)
        end
    end,false, 1)
    registerButtonEventListener(self.dark_video_btn,function()
        local id = self:getId(self.hero_bid_1)
        if id then
            local num = 2
            if math.floor(self.hero_bid_1/10000) == 4 then
                num = 5
            else
                num = 4
            end
            _controller:sender16820(id,num)
        end
    end,false, 1)
end

function HeroDarkLightWindow:getId(bid)
    local cfg = deepCopy(Config.PartnerData.data_partner_transform)
    if cfg then
        for key, value in pairs(cfg) do
            if bid == value.bid then
                return bid
            elseif bid == value.transform_bid_list[1] then
                return value.bid
            end
        end
    end
    return nil
end

--切换
function HeroDarkLightWindow:onClickBtnChange(index)
    if index == 1 then
        self.click_index = 2
    elseif index == 2 then
        self.click_index = 1
    end
    self.click_img:setVisible(false)
    self.click_panel:setTouchEnabled(false)
    local time1 = 0.2
    local time2 = 0.4
    local panel1 = nil
    local panel2 = nil
    local bg1 = nil
    local bg2 = nil
    local scroll1 = nil
    local scroll2 = nil
    local btn1 = nil
    local btn2 = nil
    local video1 = nil
    local video2 = nil
    if index == 1 then
        panel1 = self.light_panel
        panel2 = self.dark_panel
        btn1 = self.light_btn
        btn2 = self.dark_btn
        bg1 = self.light_bg
        bg2 = self.dark_bg
        video1 = self.light_video_btn
        video2 = self.dark_video_btn
        scroll1 = self.light_scroll
        scroll2 = self.dark_scroll
    elseif index == 2 then
        panel1 = self.dark_panel
        panel2 = self.light_panel
        btn1 = self.dark_btn
        btn2 = self.light_btn
        bg1 = self.dark_bg
        bg2 = self.light_bg
        video1 = self.dark_video_btn
        video2 = self.light_video_btn
        scroll1 = self.dark_scroll
        scroll2 = self.light_scroll
    end
    btn1:setTouchEnabled(false)
    btn2:setTouchEnabled(false)
    video1:setTouchEnabled(false)
    video2:setTouchEnabled(false)
    
    doStopAllActions(panel1)
    doStopAllActions(bg1)
    
    local act_1 = cc.MoveBy:create(time1, cc.p(0, -40))
    local act_2 = cc.FadeIn:create(time2)
    local act_3 = cc.MoveBy:create(time2, cc.p(0, 77))
	local spawn = cc.Spawn:create(act_2,act_3)
    panel1:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(function() 
        panel1:setZOrder(20)
    end)))
    panel1:runAction(cc.Sequence:create(cc.DelayTime:create(time1),spawn))

    local act_1 = cc.MoveBy:create(time2, cc.p(-25, 0))
    bg1:runAction(cc.Sequence:create(cc.DelayTime:create(time1),act_1))
    local act_1 = cc.FadeIn:create(time1+time2)
    video1:runAction(cc.Sequence:create(cc.DelayTime:create(time1),act_1))
    local act_1 = cc.ScaleTo:create(time1+time2, 1.2)
    btn1:runAction(cc.Sequence:create(act_1))
    local act_1 = cc.FadeIn:create(time2)
    scroll1:runAction(cc.Sequence:create(act_1))

    doStopAllActions(panel2)
    doStopAllActions(bg2)

    local act_1 = cc.MoveBy:create(time1, cc.p(0, 70))
    local act_2 = cc.FadeTo:create(time2, 95)
    local act_3 = cc.MoveBy:create(time2, cc.p(0, -107))
	local spawn = cc.Spawn:create(act_2,act_3)
    panel2:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(function() 
        panel2:setZOrder(10)
    end)))
    panel2:runAction(cc.Sequence:create(cc.DelayTime:create(time1),spawn))

    local act_1 = cc.MoveBy:create(time2, cc.p(25, 0))
    bg2:runAction(cc.Sequence:create(cc.DelayTime:create(time1),act_1))
    local act_1 = cc.FadeTo:create(time1+time2,1)
    video2:runAction(cc.Sequence:create(cc.DelayTime:create(time1),act_1))
    local act_1 = cc.ScaleTo:create(time1+time2, 0.8)
    btn2:runAction(cc.Sequence:create(act_1))
    local act_1 = cc.FadeTo:create(time2,95)
    scroll2:runAction(cc.Sequence:create(act_1))

    doStopAllActions(self.click_img)
    doStopAllActions(self.left_btn)
    doStopAllActions(self.right_btn)

    local act_1 = cc.MoveBy:create((time1+time2)*0.5, cc.p(-10, 0))
    self.left_btn:runAction(cc.Sequence:create(act_1))
    local act_1 = cc.MoveBy:create((time1+time2)*0.5, cc.p(10, 0))
    self.left_btn:runAction(cc.Sequence:create(cc.DelayTime:create((time1+time2)*0.5),act_1))
    local act_1 = cc.MoveBy:create((time1+time2)*0.5, cc.p(10, 0))
    self.right_btn:runAction(cc.Sequence:create(act_1))
    local act_1 = cc.MoveBy:create((time1+time2)*0.5, cc.p(-10, 0))
    self.right_btn:runAction(cc.Sequence:create(cc.DelayTime:create((time1+time2)*0.5),act_1))


    delayRun(panel2, time1 + time2, function()
        self.click_panel:setTouchEnabled(true)
        video1:setTouchEnabled(true)
        self.click_img:setVisible(true)
    end)
end

--关闭
function HeroDarkLightWindow:onClickBtnClose()
    _controller:openHeroDarkLightWindow(false)
end

function HeroDarkLightWindow:getAnotherBid(hero_bid)
    local cfg = deepCopy(Config.PartnerData.data_partner_transform)
    local txt = TI18N("语言_par_19_4")
    local str = ""
    local id = nil
    local id2 = nil
    for key, value in pairs(cfg) do
        if hero_bid == value.bid then
            str = value.content
            id2 = hero_bid
            id = value.transform_bid_list[1]
        elseif hero_bid == value.transform_bid_list[1] then
            str = value.content
            id2 = value.bid
            id = hero_bid
        end
    end
    self.txt:setString(txt)
    local _h = math.max(self.scroll:getContentSize().height,self.txt:getContentSize().height)
    self.scroll:setInnerContainerSize(cc.size(self.scroll:getContentSize().width,_h))
    
    self.txt:setPositionY(self.scroll:getInnerContainerSize().height)
    self.title:setString(transformTextToShort(str,70))
    addEvt2showAllTextTips(self.title,str,70)
    return {id2,id}
end

function HeroDarkLightWindow:openRootWnd(hero_bid)
    --1光 2暗
    local data = self:getAnotherBid(hero_bid)
    self.hero_bid_1 = data[1]
    self.hero_bid_2 = data[2]
    self:setData()
end
--获取技能列表
function HeroDarkLightWindow:getSkillList(bid)
    local star = Config.PartnerData.data_partner_max_star[bid]
    local key = getNorKey(bid, star)
    local star_config = Config.PartnerData.data_partner_star(key)
    if star_config == nil then return end
    local skill_list = {}
    for i,v in ipairs(star_config.skills) do
        -- 不是普通攻击 1表示普通攻击
        if v[1] ~= 1 then
            table.insert(skill_list, v)
        end
    end
    local cfg = Config.PartnerUltraData.data_ene_skill[bid]
    if cfg then
        table.sort(cfg,function(a,b) return a.lev > b.lev end)
        local list = {
            [1]=7,
            [2]=deepCopy(cfg[1].skill[1]),
        }
        table.insert(skill_list, list)
    end
    return skill_list
end
function HeroDarkLightWindow:setData()
    self.skill_list1 = self:getSkillList(self.hero_bid_1)
    self.skill_list2 = self:getSkillList(self.hero_bid_2)
    self.skill_1 = self:setSkillList(self.hero_bid_1,self.skill_list1,self.light_scroll)
    self.skill_2 = self:setSkillList(self.hero_bid_2,self.skill_list2,self.dark_scroll)
    if math.floor(self.hero_bid_1/10000) == 4 then
        self.light_btn:loadTexture(PathTool.getHeroCampTypeIcon(HeroConst.CampType.eLight), LOADTEXT_TYPE_PLIST)
        self.dark_btn:loadTexture(PathTool.getHeroCampTypeIcon(HeroConst.CampType.eDark), LOADTEXT_TYPE_PLIST)
    else
        self.light_btn:loadTexture(PathTool.getHeroCampTypeIcon(HeroConst.CampType.eDark), LOADTEXT_TYPE_PLIST)
        self.dark_btn:loadTexture(PathTool.getHeroCampTypeIcon(HeroConst.CampType.eLight), LOADTEXT_TYPE_PLIST)
    end
end

function HeroDarkLightWindow:setSkillList(bid,list,panel)
    local skill_container_size = panel:getContentSize()
    local skill_width = 84
    --技能item的宽度
    local item_width = skill_width + 15
    local total_width = item_width * #list
    local max_width = math.max(skill_container_size.width, total_width)
    panel:setInnerContainerSize(cc.size(max_width, skill_container_size.height))
    
    local x = 0
    -- if total_width > skill_container_size.width then
    --     --技能的总宽度大于 显示的宽度 就从左往右显示
    --     x = 0
    -- else
    --     --否则从中从中间显示
    --     x = (skill_container_size.width - total_width) * 0.5
    -- end
    local skill_item_list = {}
    for i,skill in ipairs(list) do
        local config = Config.SkillData.data_get_skill(skill[2])
        if config then
            if skill_item_list[i] == nil then
                skill_item_list[i] = {}
                skill_item_list[i] = SkillItem.new(true,true,true,0.7, true)
                skill_item_list[i]:setCascadeOpacityEnabled(true)
                panel:addChild(skill_item_list[i])
            end
            skill_item_list[i]:setData(config)
            skill_item_list[i]:setSkillSubscript(Config.PartnerData.data_partner_base[bid].hurt_type)
            skill_item_list[i]:setVisible(true)
            skill_item_list[i]:setPosition( x + item_width * (i - 1) + item_width * 0.5, skill_width/2+3)
        else 
            print(string_format("@技能表id: %s 没发现", tostring(skill.skill_bid)))
        end
    end
end
function HeroDarkLightWindow:close_callback()
    doStopAllActions(self.light_panel)
    doStopAllActions(self.light_bg)
    doStopAllActions(self.dark_panel)
    doStopAllActions(self.dark_bg)
    _controller:openHeroDarkLightWindow(false)
end