HeroLineupWindow = class("HeroLineupWindow",function()
    return ccui.Layout:create()
end)
local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroLineupWindow:ctor(hero_vo)
    self.hero_vo = hero_vo
    _model.recommend_bid = hero_vo.bid
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_lineup_window"))
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)
    self:initView()
    self:registerEvent()
    -- printLuaTable(self.hero_vo)
    _controller:sender11052(self.hero_vo.bid)
    -- self:setData()
end

function HeroLineupWindow:initView()

    self.main_container = self.root_wnd:getChildByName("main_container")
    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)

    self.top = self.main_container:getChildByName("top")
    self.bottom = self.main_container:getChildByName("bottom")
    self.ScrollView = self.main_container:getChildByName("ScrollView")
    self.image_tips = self.main_container:getChildByName("image_tips")
    self.tips = self.main_container:getChildByName("tips")
    self.tips:setString(TI18N("语言_c_273"))
end
function HeroLineupWindow:registerEvent()
    -- self.rule_btn:addTouchEventListener(function()
    --     self:onRuleBtn()
    -- end)
    -- registerButtonEventListener(self.rule_btn, function()
    --     self:onRuleBtn()
    -- end,false, 1)
    -- registerButtonEventListener(self.bulletChat_close_btn, function()
    --     self:onBulletChatBtn(1)
    -- end,false, 1)
    -- registerButtonEventListener(self.bulletChat_open_btn, function()
    --     self:onBulletChatBtn(2)
    -- end,false, 1)

    --点击点赞或踩返回
    if not self.Hero_Lineup_Event then 
        self.Hero_Lineup_Event= GlobalEvent:getInstance():Bind(HeroEvent.Hero_Lineup_Event,function(data)
            self:setData(data)
        end)
    end  
end

--关闭
function HeroLineupWindow:onClickBtnClose()
end

function HeroLineupWindow:setData(data)
    if not data then return end
    self.data = data
    
    if self.list_view == nil then
        local scroll_view_size = self.ScrollView:getContentSize()
        local setting = {
            item_class = HeroLineupItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 680,               -- 单元的尺寸width
            item_height = 408,              -- 单元的尺寸height
            -- row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.list_view = CommonScrollViewLayout.new(self.ScrollView, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    local list = data.atk_team_members
    table.sort(list, function (a,b)
        return a.power >b.power
    end)
    if tableLen(list) ~= 0 then
        self.list_view:setData(list)
        self.image_tips:setVisible(false)
        self.tips:setVisible(false)
    end
end

function HeroLineupWindow:initFormationData(formation_config)
    if not formation_config then return end
    -- self.dic_index_pos = {}
    -- self.dic_pos_index = {}
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
    local width = self.cell_width - 10
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        -- self.dic_index_pos[index] = pos
        dic_pos_index[pos] = index
        -- self:updatePosItemByIndex(pos, index)
        --更新位置
        if self.hero_item_list[index] then
            self.hero_item_list[index]:setPosition(self.nine_position[pos])
        end
        if pos <= 3 then
            self.pos_name_list[index] = 1 --位置 前
        elseif pos > 3 and pos <= 6 then
            self.pos_name_list[index] = 2 --位置 中
        else
            self.pos_name_list[index] = 3 --位置 后
        end

        local x = self.nine_position[pos].x
        local y = self.nine_position[pos].y
        local rect = cc.rect( x - width*0.5 ,y - width*0.5 , width, width)
        self.pos_rect_list[index] = rect
    end

    --没使用的要变灰变暗
    local index = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img[index]:setPosition(self.nine_position[pos])
            index = index + 1
            if index > 4 then
                break
            end
        end
    end
end
function HeroLineupWindow:DeleteMe()
    if self.Hero_Lineup_Event then 
        GlobalEvent:getInstance():UnBind(self.Hero_Lineup_Event)
        self.Hero_Lineup_Event = nil
    end
    -- doStopAllActions(self.main_container)

    -- if self.item_scrollview then
    --     self.item_scrollview:DeleteMe()
    -- end
    -- self.item_scrollview = nil
end