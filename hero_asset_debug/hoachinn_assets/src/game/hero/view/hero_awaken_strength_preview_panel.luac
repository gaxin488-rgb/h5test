function HeroAwakenStrengthPreviewPanel:updateBtn()
    local lock_str = ""
    if self.data.panel_type == HERO_SOUL_TYPE then
        local unlock_star = Config.PartnerSoulData.data_const["open_star_condition"].val
        local unlock_tower = Config.PartnerSoulData.data_const["open_tower_layers"].val
        local now_tower = StartowerController:getInstance():getModel():getNowTowerId() or 0
        self.label_lock:setVisible((not self.config) and (not ((self.hero_vo.star >= unlock_star) and (now_tower >= unlock_tower))) )
        lock_str = (Config.PartnerSoulData.data_const["open_star_condition"].desc..','.. Config.PartnerSoulData.data_const["open_tower_layers"].desc)
        self.streng_btn:setVisible((not self.config) and ((self.hero_vo.star >= unlock_star) and (now_tower >= unlock_tower)) )
        self.label_max:setVisible(false)
        local max_lv = controller:getModel():getHorcruxesMaxLev()
        if (self.base_data and self.base_data.lev > 1 and not Config.PartnerSoulData.data_soul_level[self.base_data.id][self.base_data.lev + 1]) or (self.base_data.lev >= max_lv) then
            self.streng_btn:setVisible(false)
            self.label_max:setVisible(true)
        end
        if not self.data.other_view then
            local is_redpoint = HeroCalculate.checkSingleHeroHorcruxStringRedPoint(self.hero_vo)
            addRedPointToNodeByStatus(self.streng_btn, is_redpoint, 5, 5)
        end
        self.back_btn:setVisible((not self.config) and ((self.hero_vo.star >= unlock_star) and (now_tower >= unlock_tower)) and self.base_data and self.base_data.lev >= 1)
    else
        local unlock_lev = Config.PartnerHeartData.data_const["heartskill_unlock"].val
        self.label_lock:setVisible((not self.config) and (not ((self.hero_vo.lev >= unlock_lev))) )
        lock_str = Config.PartnerHeartData.data_const["heartskill_unlock"].desc
        self.streng_btn:setVisible((not self.config) and (self.hero_vo.lev >= unlock_lev)) 
        self.label_max:setVisible(false)
        if self.base_data and self.base_data.lev > 1 and not Config.PartnerHeartData.data_soul_level[self.base_data.id][self.base_data.lev + 1] then
            self.streng_btn:setVisible(false)
            self.label_max:setVisible(true)
        end
        if not self.data.other_view then
            local is_redpoint = HeroCalculate.checkSingleHeroHeartStringRedPoint(self.hero_vo)
            addRedPointToNodeByStatus(self.streng_btn, is_redpoint, 5, 5)
        end
        self.back_btn:setVisible(false)
    end
    if self.label_lock:isVisible() then
        self.label_lock:setString(lock_str)
    end
    self.label_lock:setVisible(self.label_lock:isVisible() and not self.data.other_view)
    self.label_max:setVisible(self.label_max:isVisible() and not self.label_lock:isVisible() and not self.data.other_view)
    self.streng_btn:setVisible(self.streng_btn:isVisible() and not self.data.other_view)
    local status = self.back_btn:isVisible() and not self.data.other_view
    self.back_btn:setVisible(status)
end

function HeroAwakenStrengthPreviewPanel:dolyoutUI()
    local total_height = self.base_panel:getContentSize().height
    total_height = total_height + self.baseattr_panel:getContentSize().height
    if self.strengattr_panel:isVisible() then
        total_height = total_height + self.strengattr_panel:getContentSize().height
    end
    if self.tab_panel:isVisible() then
        total_height = total_height + self.tab_panel:getContentSize().height
    end
    local size = self.back_bg:getContentSize()
    self.back_bg:setContentSize(cc.size(size.width, total_height))
    self.base_panel:setPositionY(total_height)
 --   self.baseattr_panel:setPositionY(total_height - self.base_panel:getContentSize().height)
    if self.strengattr_panel:isVisible() then
    --    self.strengattr_panel:setPositionY(total_height - self.base_panel:getContentSize().height - self.baseattr_panel:getContentSize().height)
        if self.tab_panel:isVisible() then
            self.tab_panel:setPositionY(total_height - self.base_panel:getContentSize().height - self.baseattr_panel:getContentSize().height - self.strengattr_panel:getContentSize().height)
        end
    else
        if self.tab_panel:isVisible() then
            self.tab_panel:setPositionY(total_height - self.base_panel:getContentSize().height - self.baseattr_panel:getContentSize().height)
        end
    end
    self.close_btn:setPositionY(total_height - 10)
    self.img_rule:setPositionY(total_height - 110)
end

--==============================--
--desc:设置基础信息
--time:2018-10-20 09:40:23
--@return 
--==============================--
function HeroAwakenStrengthPreviewPanel:setBaseInfo()
    local data = self.base_data
    local base_cfg = self.base_cfg
    local quality = 0
    if base_cfg.quality >= 0 and base_cfg.quality <= 5 then
        quality = base_cfg.quality
    end
    local background_res = PathTool.getResFrame("tips", "tips_"..quality)
    self.base_panel:loadTexture(background_res, LOADTEXT_TYPE_PLIST)
    local res_id = PathTool.getQualityBg(base_cfg.quality)

    local item_data = {}
    item_data.is_lock = false
    item_data.bg = res_id
    item_data.icon = PathTool.getSoulHorcruxIcon(base_cfg.icon)
    item_data.lev = data.lev
    self.itemIcon:setData(item_data)

    local color = BackPackConst.getEquipTipsColor(quality)
    self.name:setTextColor(color) 
    self.name:setString(base_cfg.name)
    self.equip_type:setString(base_cfg.partner_name or "")
    self.power_label:setNum(data.score_val)
    self.label_story:setTouchEnabled(true)
    self.label_story:setString(transformTextToShort(base_cfg.story,30))
    addEvt2showAllTextTips(self.label_story,base_cfg.story,30)
    local totla_tab_height = 10
    
    if self.label_max:isVisible() then
        totla_tab_height = 40
        self.label_max:setPosition(cc.p(207,70))
    else
        self.label_max:setPosition(cc.p(207,15))
    end
    if self.back_btn:isVisible() then
        self.streng_btn:setPositionX(383)
    else
        self.streng_btn:setPositionX(255)
    end
    if self.streng_btn:isVisible() then
        self.back_btn:setPositionX(127)
    else
        self.back_btn:setPositionX(255)
    end
    if not self.data.other_view then
        totla_tab_height = totla_tab_height + self.label_story:getContentSize().height + 20 + self.streng_btn:getContentSize().height + 10
    else
        totla_tab_height = totla_tab_height + self.label_story:getContentSize().height + 10
    end
    --是否开启第二魂器
    local isOpenTwo = controller:getModel():getProsIsOpen(self.hero_vo)
    local hero_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    local unlock_star = Config.PartnerSoulData.data_const["open_star_condition"].val
    local unlock_tower = Config.PartnerSoulData.data_const["open_tower_layers"].val
    local now_tower = StartowerController:getInstance():getModel():getNowTowerId() or 0
    if controller:getModel():getProsIsShield() and controller:getModel():getOneProsIsShield(self.hero_vo) and not self.data.other_view then 
        self.label_lock_2:setVisible((not isOpenTwo) and self.hero_vo.star >= unlock_star and now_tower >= unlock_tower)
    else
        self.label_lock_2:setVisible(false)
    end
    if self.data.panel_type == HERO_SOUL_TYPE and self.hero_vo.proscription then
        if self.label_lock_2:isVisible() and not self.data.other_view then
            totla_tab_height = totla_tab_height + self.label_lock_2:getContentSize().height
            self.streng_btn:setPositionY(69)
        end
        self.pros_panel:setVisible(isOpenTwo and not self.data.other_view)
        local hero_cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
        local cfg = Config.PartnerProscriptionData.data_lv_info[hero_cfg.proscription_id]
        local base_cfg = Config.PartnerProscriptionData.data_base_info[hero_cfg.proscription_id]

        local status = tableLen(self.hero_vo.proscription) == 3
        local id = Config.PartnerData.data_partner_base[self.hero_vo.bid].proscription_id
        if status then
            local config = Config.PartnerProscriptionData.data_lv_info[id]
            for k, v in pairs(self.hero_vo.proscription) do
                local cfg = config[v.p_type]
                if v.p_lev < tableLen(cfg) then
                    status = false
                end
            end
        end

        if tableLen(self.hero_vo.proscription) <= 3 and not status then
            for i = 1, 3 do
                local status = true
                for k,v in pairs(self.hero_vo.proscription) do
                    if v.p_type == i and v.p_lev >= tableLen(cfg[i]) then
                        status = false
                    end
                end
                if status then
                    self.pros_icon_list[i]:setVisible(false)
                    self.pros_icon_lock_list[i]:setVisible(true)
                else
                    self.pros_icon_list[i]:setVisible(true)
                    loadSpriteTexture(self.pros_icon_list[i], PathTool.getPlistImgForDownLoad("proscription/proscription_skill",base_cfg[i].befor), LOADTEXT_TYPE)
                    self.pros_icon_lock_list[i]:setVisible(false)
                end
            end
            self.pros_icon:setVisible(true)
            self.pros_icon_4:setVisible(false)
        else
            self.pros_icon:setVisible(false)
            self.pros_icon_4:setVisible(true)
            if not self.pros_item then
                self.pros_item = ProsItem.new()
                self.pros_icon_4:addChild(self.pros_item)
                self.pros_item:setScale(0.6)
            end
            self.pros_item:setBaseData(hero_cfg.proscription_id)
            if self.pros_item then
                local back = function()
                    controller:openExclusivePropsPanel(false)
                    controller:openHeroProsMainWindow(true,self.data,4)
                end
                self.pros_item:addCallBack(back)
            end
        end
    else
        self.pros_panel:setVisible(false)
    end
    self.tab_panel:setContentSize(cc.size(510, totla_tab_height))
    ccui.Helper:doLayout(self.tab_panel)
end

--==============================--
--desc:设置基础属性
--time:2018-10-20 11:42:16
--@return 
--==============================--
function HeroAwakenStrengthPreviewPanel:setBaseAttrInfo()
    local data = self.base_data
    local lev_cfg = self.lev_cfg
    local total_base_height = 55
    if self.base_list and next(self.base_list) then
        for k, v in pairs(self.base_list) do
            v:setVisible(false)
            v.bg:setVisible(false)
        end
    end
    self.baseattr_panel.no_label:setVisible(false)
    if self.base_data.lev_zero then
        self.baseattr_panel.no_label:setVisible(true)
        total_base_height = 160
    else
        for i,v in ipairs(lev_cfg.attr) do
            local attr_key = v[1]
            local attr_val = v[2]
            local attr_name = Config.AttrData.data_key_to_name[attr_key]
            if attr_name then
                if not self.base_list[i] then 
                    self.base_list[i] = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(0, 48), nil, nil, 380)
                    self.baseattr_panel:addChild(self.base_list[i],9)
                end
                self.base_list[i]:setVisible(true)
                local label = self.base_list[i]
                local _x = 40 + (i%2 == 0 and 1 or 0) * 303
                label:setPositionX(_x)
                local _y = 80 - (math.ceil(i/2) - 1)*50
                -- local _y = 53 - i*40
                label:setPositionY(_y)
                local icon = PathTool.getAttrIconByStr(attr_key)
                local is_per = PartnerCalculate.isShowPerByStr(attr_key)
                if is_per == true then
                    attr_val = (attr_val/10).."%"
                end
                local attr_str = string_format("<img src='%s' scale=1 />     <div fontcolor=#6d3c2d> %s：</div><div fontcolor=#6d3c2d fontsize=24>%s</div>", PathTool.getResFrame("common", icon), attr_name, attr_val)
                label:setString(attr_str)
                if not label.bg then
                    local res = PathTool.getResFrame("common","common_1037")
                    label.bg = createImage(self.baseattr_panel, res, _x-5, _y-2, cc.p(0, 0.5), true, nil, true,8)
                    label.bg:setContentSize(cc.size(284, 38))
                end
                self.base_list[i].bg:setVisible(true)
            end
        end
        local attr_height = math.ceil(#lev_cfg.attr/2) * 50
        total_base_height = total_base_height + attr_height
    end
    return total_base_height
end

--==============================--
--desc:设置强化信息
--time:2018-10-20 09:40:23
--@return 
--==============================--
function HeroAwakenStrengthPreviewPanel:setStrengInfo()
    local data = self.base_data
    local lev_cfg = self.lev_cfg
    local streng_des_list = {}
    local start_pos_y = self.strengattr_panel.label:getPositionY() + self.strengattr_panel.label:getContentSize().height + 5
    local space_off = 6
    local t_height = 55
    local list = {}
    local size = self.strengattr_panel:getContentSize()
    local skill_s = 0

    if self.strength_list and next(self.strength_list) then
        for k, v in pairs(self.strength_list) do
            v:setVisible(false)
            v:setString("")
            v.bg:setVisible(false)
            v.mark:setVisible(false)
        end
    end

    if self.data.panel_type == HERO_SOUL_TYPE then
        local max_lv = controller:getModel():getHeroAwakenMaxLev(self.base_data.id)
        for i, v in ipairs(Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1]) do
            if v.desc and v.desc ~= "" and v.lv >= 1 and v.lv <= max_lv then
                streng_des_list[#streng_des_list + 1] = v.desc
                if not self.strength_list[i] then
                    local label = createRichLabel(24, cc.c4b(0x7c,0x55,0x36,0xff), cc.p(0, 0.5), cc.p(96, 0), nil, nil, 520)
                    self.strengattr_panel:addChild(label,9)
                    self.strength_list[i] = label
                end
                local str = v.preview_skill_desc
                self.strength_list[i]:setVisible(true)
                -- if (self.base_data.lev >= v.lv and not self.base_data.lev_zero) or self.base_data.is_show then
                --     self.strength_list[i]:setFontColor(cc.c3b(0x0e,0xa8,0x0e,0xff))
                --     str = v.desc.." "
                -- else
                --     self.strength_list[i]:setFontColor(cc.c4b(0x7c,0x55,0x36,0xff))
                -- end

                self.strength_list[i]:setString(str)
                t_height = t_height + self.strength_list[i]:getContentSize().height + 15 + 5
                list[#list +1] = self.strength_list[i]
                if not self.strength_list[i].bg then
                    local res = PathTool.getResFrame("common","common_1037")
                    self.strength_list[i].bg = createImage(self.strengattr_panel, res, size.width/2, 0, cc.p(0.5, 0.5), true, nil, true,7,true)
                    self.strength_list[i].bg:setContentSize(cc.size(598, self.strength_list[i]:getContentSize().height + 15))
                end
                self.strength_list[i].bg:setVisible(true)

                skill_s = self.strength_list[i]:getContentSize().height + 15 + skill_s

                --判断是否激活
                local mark_res = PathTool.getResFrame("common","common_90009_1")
                if self.base_data.lev >= v.lv and not self.base_data.lev_zero then
                    mark_res = PathTool.getResFrame("common","common_90032")
                end
                if self.base_data.is_show then
                    mark_res = PathTool.getResFrame("common","common_90032")
                end
                if not self.strength_list[i].mark then
                    self.strength_list[i].mark = createImage(self.strengattr_panel, mark_res, 70, 0, cc.p(0.5, 0.5), true,8)
                end
                self.strength_list[i].mark:setVisible(true)
                self.strength_list[i].mark:loadTexture(mark_res, LOADTEXT_TYPE_PLIST)
            end
        end 
    else
        local config = Config.SkillData.data_get_skill(lev_cfg.unlock)
        local s_lev_lock = false
        if not config then
            for i, v in ipairs(Config.PartnerHeartData.data_soul_level[self.base_data.id]) do
                config = Config.SkillData.data_get_skill(v.unlock)
                if config then
                    s_lev_lock = true
                    break
                end
            end
        end
        if config then
            --是否锁住
            if self.strengattr_panel.skillItem == nil then
                local skillItem = SkillItem.new(true, true, true, 0.8, false)
                skillItem:setAnchorPoint(cc.p(0, 1))
                self.strengattr_panel:addChild(skillItem)
                self.strengattr_panel.skillItem = skillItem
                self.strengattr_panel.name = createLabel(24,cc.c4b(0xfe,0xee,0xba,0xff),nil,125, 0,"",self.strengattr_panel,1,cc.p(0,1))
                self.strengattr_panel.des = createLabel(24,cc.c4b(0xfe,0xee,0xba,0xff),nil,125, 0,"",self.strengattr_panel,1,cc.p(0,1))
                self.strengattr_panel.name:setDimensions(285, 0)
                self.strengattr_panel.des:setDimensions(285, 0)
            end
            self.strengattr_panel.skillItem:setData(config)
            self.strengattr_panel.name:setString(config.name)
            self.strengattr_panel.des:setString(transformTextToShort(config.des, 34))
            self.strengattr_panel.skillItem:setVisible(true)
            self.strengattr_panel:setVisible(true)
            t_height = t_height + self.strengattr_panel.skillItem:getContentSize().height
            setChildUnEnabled(s_lev_lock, self.strengattr_panel.skillItem)
            if s_lev_lock then
                self.strengattr_panel.name:setTextColor(cc.c4b(0xc1,0xb7,0xab,0xff))
                self.strengattr_panel.des:setTextColor(cc.c4b(0xc1,0xb7,0xab,0xff))
            else
                self.strengattr_panel.name:setTextColor(cc.c4b(0xfe,0xee,0xba,0xff))
                self.strengattr_panel.des:setTextColor(cc.c4b(0xfe,0xee,0xba,0xff))
            end
        else
            print(string_format("@技能表id: %s 没发现", tostring(lev_cfg.unlock)))
            self.strengattr_panel:setVisible(false)
            t_height = t_height
        end
    end

    local size = self.strengattr_panel:getContentSize()
    self.strengattr_panel:setContentSize(cc.size(size.width, t_height))
    self.strengattr_panel.label:setPositionY(t_height - 4)
    self.strengattr_panel.title_bg:setPositionY(t_height - 40)
    local o_y = t_height - 55
    if self.data.panel_type == HERO_SOUL_TYPE then
        for i, v in ipairs(list) do
            o_y = o_y - v:getContentSize().height/2
            v:setPositionY(o_y)
            v.bg:setPositionY(o_y-2)
            v.mark:setPositionY(o_y-1)
            o_y = o_y - v:getContentSize().height/2 - 20
        end
    else
        if self.strengattr_panel:isVisible() then
            self.strengattr_panel.skillItem:setPosition(20, o_y)
            self.strengattr_panel.name:setPositionY(o_y + 10)
            self.strengattr_panel.des:setPositionY(o_y - 20)
        end
    end
    -- self.strengattr_panel.line:setPositionY(t_height - 7)
    return 55+skill_s
end

function HeroAwakenStrengthPreviewPanel:close_callback()
    if self.power_label then
        self.power_label:DeleteMe()
        self.power_label = nil
    end
    for i,v in pairs(self.skill_list) do 
        if v.skill then 
            v.skill:DeleteMe()
        end
    end
    controller:openExclusivePropsPanel(false)
end
