HeroAwakenStrengthPreviewPanel = HeroAwakenStrengthPreviewPanel or BaseClass(BaseView)

local string_format = string.format
local controller = HeroController:getInstance()
function HeroAwakenStrengthPreviewPanel:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "hero/hero_awaken_strength_preview_panel"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }

    self.win_type = WinType.Tips    
    self.view_tag = ViewMgrTag.DIALOGUE_TAG

    self.base_list = {}
    self.strength_list = {}

    self.skill_list = {}
    self.tab_list = {}
    self.top_tab_list = {}
    self.pros_icon_list = {}
    self.pros_icon_lock_list = {}
end

function HeroAwakenStrengthPreviewPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.container = self.main_panel:getChildByName("container")            -- 背景,需要动态设置尺寸
    self.container_init_size = self.container:getContentSize()
    self.container_init_size.height = self.container_init_size.height + 15

	-- 顶部标签页
	local tab_container = self.main_panel:getChildByName("tab_container")
	self.tab_container = tab_container
    local tab_name_list = {
        [1] = TI18N("语言_c_1294"),
        [2] = TI18N("语言_c_6416"),
    }
    for i=1,2 do
        local tab_btn = tab_container:getChildByName("tab_btn_"..i)
        if tab_btn then
            local object = {}
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
            object.unselect_bg:setVisible(true)
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(false)
            object.lable = tab_btn:getChildByName("title")
			setTextMaxWidth(object.lable,150,-10)
            object.lable:setChangeScaleOffWidth(-9999999)
            object.lable:setString(tab_name_list[i])
            object.tab_btn = tab_btn
            object.index = i
            object.tips = tab_btn:getChildByName("tips")
            object.tips:setVisible(false)
            self.top_tab_list[i] = object
        end
    end

    self.image_titlebg = self.container:getChildByName("image_titlebg")
    self.label_title = self.container:getChildByName("label_title")
    self.label_title:setString(TI18N("语言_c_7241"))
    autoSizeTitleBg( self.label_title, self.image_titlebg, 120)

    self.back_bg = self.container:getChildByName("back_bg")

    -- 基础属性,名字,类型和评分等
    self.base_panel = self.container:getChildByName("base_panel")
    self.base_panel:getChildByName("score_title"):setString(TI18N("语言_c_1742"))
    local score_title = self.base_panel:getChildByName("score_title")
    self.base_bg = self.base_panel:getChildByName("icon_bg")
    self.base_icon = self.base_panel:getChildByName("icon")
    self.base_lev = self.base_panel:getChildByName("label_lev")
    self.name = self.base_panel:getChildByName("name")
    setTextMaxWidth(self.name,220,-8)
    self.equip_type = self.base_panel:getChildByName("equip_type")
    self.equip_type:setChangeScaleOffWidth(self.base_panel:getContentSize().width - 250)
    self.power_label = CommonNum.new(1, self.base_panel, 1, - 2, cc.p(0, 0))
    self.power_label:setPosition(cc.p(score_title:getPositionX() + score_title:getContentSize().width + 5 , 32))
    self.power_label:setNum(0)
    self.power_label:setScale(0.8)

    self.node_item = self.base_panel:getChildByName("node_item")
    local item = ExclusiveItem.new()
    self.node_item:addChild(item)
    self.itemIcon = item

    self.scroller = self.container:getChildByName("scroller")
    self.scroller:setScrollBarEnabled(false)
    -- 基础属性
    self.baseattr_panel = self.scroller:getChildByName("baseattr_panel")
    self.baseattr_panel.label = self.baseattr_panel:getChildByName("label")
    self.baseattr_panel.label:setString(TI18N("语言_c_7243"))
    local _width =  self.baseattr_panel.label:getContentSize().width
    self.baseattr_panel.label:getChildByName("label_1"):setString(TI18N("语言_c_4964"))
    self.baseattr_panel.label:getChildByName("label_1"):setPositionX(_width + 5)
    -- ccui.Helper:doLayout(self.baseattr_panel:getChildByName("label"))
    self.baseattr_panel.title_bg =  self.baseattr_panel:getChildByName("image_bg1")
    self.baseattr_panel.no_label =  self.baseattr_panel:getChildByName("no_label")
    self.baseattr_panel.no_label:setString(TI18N("语言_c_7216"))
    self.baseattr_panel.no_label:setVisible(false)

    self.pros_panel = self.baseattr_panel:getChildByName("pros_panel")
    self.txt_bg = self.pros_panel:getChildByName("txt_bg")
    self.txt = self.pros_panel:getChildByName("txt")
    self.txt:setString(TI18N("语言_c_6554"))
    autoSizeTitleBg(self.txt,self.txt_bg,60,100)
    self.pros_icon = self.pros_panel:getChildByName("pros_icon")
    self.pros_icon_4 = self.pros_panel:getChildByName("pros_icon_4")
    for i=1,3 do
        self.pros_icon_list[i] = self.pros_icon:getChildByName("icon_"..i)
        self.pros_icon_lock_list[i] = self.pros_icon:getChildByName("icon_lock_"..i)
        -- setChildUnEnabled(true,self.pros_icon_list[i])
    end
    self.pros_change = self.pros_panel:getChildByName("pros_change")

    --强化效果
    self.strengattr_panel = self.scroller:getChildByName("strengattr_panel")
    self.strengattr_panel.label = self.strengattr_panel:getChildByName("label")
    self.strengattr_panel.label:setString(TI18N("语言_c_7246"))
    self.strengattr_panel.title_bg =  self.strengattr_panel:getChildByName("image_bg2")

    -- 按钮容器
    self.tab_panel = self.container:getChildByName("tab_panel")
    --btn 强化
    self.streng_btn = self.tab_panel:getChildByName("tab_btn_1")
    self.streng_btn:setTitleText(TI18N("语言_c_4967"))

    self.back_btn = self.tab_panel:getChildByName("tab_btn_2")
    self.back_btn:setTitleText(TI18N("语言_c_5330"))

    self.label_lock = self.tab_panel:getChildByName("label_lock")
    self.label_lock:ignoreContentAdaptWithSize(true)
    self.label_lock:setTextAreaSize(cc.size(475, 0))
    setTextSpacing(self.label_lock)
    self.label_lock:setString(TI18N("语言_c_4968"))

    self.label_max = self.tab_panel:getChildByName("label_max")
    self.label_max:ignoreContentAdaptWithSize(true)
    self.label_max:setTextAreaSize(cc.size(475, 0))
    setTextSpacing(self.label_max)
    self.label_max:setString(TI18N("语言_c_4969"))

    self.label_lock_2 = self.tab_panel:getChildByName("label_lock_2")
    self.label_lock_2:ignoreContentAdaptWithSize(true)
    self.label_lock_2:setTextAreaSize(cc.size(475, 0))
    setTextSpacing(self.label_lock_2)
    self.label_lock_2:setString(string.format(TI18N("语言_c_6540"),Config.PartnerProscriptionData.data_constant["open_proscription_condition"].val))
    self.label_lock_2:setVisible(false)

    self.label_story = self.tab_panel:getChildByName("label_story")
    self.label_story:ignoreContentAdaptWithSize(true)
    self.label_story:setTextAreaSize(cc.size(475, 0))

    self.img_rule = self.container:getChildByName("img_rule")
    self.close_btn = self.container:getChildByName("close_btn")
end

function HeroAwakenStrengthPreviewPanel:register_event()
    registerButtonEventListener(self.streng_btn, handler(self, function()
        self:clickStrengBtn(sender)
        controller:openExclusivePropsPanel(false)
    end) ,true, 2)
    registerButtonEventListener(self.back_btn, handler(self, function()
        if self.hero_vo:isLockByLocktype(HeroConst.LockType.eHeroConvertLock) then
            message(TI18N("语言_c_3287"))
            return
        end
        controller:openExclusivePropsPanel(false)
        controller:openExclusiveBackPanel(true,self.data)
    end) ,true, 2)
    registerButtonEventListener(self.background, handler(self, function()
        controller:openHeroUrAweakenPreviewPanel(false)
    end) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, function()
        controller:openHeroUrAweakenPreviewPanel(false)
    end) ,true, 1)
    registerButtonEventListener(self.pros_icon, handler(self, function()
        controller:openExclusivePropsPanel(false)
        controller:openHeroProsMainWindow(true,self.data)
    end) ,false, 1)
    registerButtonEventListener(self.pros_change, handler(self, function()
        controller:openExclusivePropsPanel(false)
        TipsManager:getInstance():showProsTips(self.data,true)
    end) ,false, 1)
    registerButtonEventListener(self.img_rule, function(param, sender, event_type)
        local config
        if self.data.panel_type == HERO_SOUL_TYPE then
            config = Config.PartnerSoulData.data_const["game_rule1"]
        else
            config = Config.PartnerHeartData.data_const["game_rule1"]
        end
        -- TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition())
        TipsManager:getInstance():showAdventureBuffTipsScroll(config.desc, sender:getTouchBeganPosition(),nil,nil,420,false,730)
    end ,true, 2)

    for k, object in pairs(self.top_tab_list) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab(object.index)
				end
			end)
		end
    end

end
-- 切换顶部标签页
function HeroAwakenStrengthPreviewPanel:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end

    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        self.tab_object = nil
    end
    self.tab_object = self.top_tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
    end

    if index == 1 then
        self.base_data = nil
        if self.config then
            local h_cfg = Config.PartnerData.data_partner_base_fun(self.hero_vo.bid)
            local hid = h_cfg.ur_awaken_id
            local max_lev = controller:getModel():getHeroAwakenMaxLev(hid)
            self.base_data = {id = hid, lev = max_lev, score_val = 0}
        else
            local h_cfg = Config.PartnerData.data_partner_base_fun(self.hero_vo.bid)
            local ur_lev = 0
            local socre = 1000
            if self.hero_vo.ur_awaken and self.hero_vo.ur_awaken[1] then
                ur_lev = self.hero_vo.ur_awaken[1].p_lev
                socre = self.hero_vo.ur_awaken[1].p_score
            end

            self.base_data = {id = h_cfg.ur_awaken_id, lev = ur_lev or 1, score_val = socre}
            if self.base_data.lev == 0 then
                self.base_data.lev = 1
                self.base_data.lev_zero = true
            end
        end
        self.base_cfg = Config.PartnerUrAwakenData.data_base_info[self.base_data.id]
        local data_soul_level = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1]
        if data_soul_level then
            self.lev_cfg = data_soul_level[self.base_data.lev]
        end
    elseif index == 2 then
        self.base_data = nil
        local h_cfg = Config.PartnerData.data_partner_base_fun(self.hero_vo.bid)
        local hid = h_cfg.ur_awaken_id
        local max_lev = controller:getModel():getHeroAwakenMaxLev(hid)

        self.base_data = {id = hid, lev = max_lev, is_show = true}

        self.base_cfg = Config.PartnerUrAwakenData.data_base_info[self.base_data.id]
        local data_soul_level = Config.PartnerUrAwakenData.data_lv_info[self.base_data.id][1]
        if data_soul_level then
            self.lev_cfg = data_soul_level[self.base_data.lev]
        end

    end
    local height1 = self:setBaseAttrInfo()
    local height2 = self:setStrengInfo()
    local scroller_height = height1 + height2 + 10
    local final_height = math.max(scroller_height, 735)
    self.scroller:setInnerContainerSize(cc.size(666, final_height))
    self.baseattr_panel:setPositionY(final_height)
    self.strengattr_panel:setPositionY(final_height-height1)

end

function HeroAwakenStrengthPreviewPanel:clickStrengBtn()
    controller:openHeroSuperHeartStrengPanel(true, self.data)
end

function HeroAwakenStrengthPreviewPanel:updateProsIcon()
    local status = HeroCalculate.checkSingleHeroProsRedPoint(self.hero_vo)
    addRedPointToNodeByStatus(self.pros_icon,status)
    addRedPointToNodeByStatus(self.pros_icon_4,status,50,50)
end

