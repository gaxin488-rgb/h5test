-- --------------------------------------------------------------------
HeroStarupCostHelpNewPanel = HeroStarupCostHelpNewPanel or BaseClass(BaseView)
    
local controller = HeroController:getInstance()
local model = controller:getModel()
local table_insert =table.insert
local table_sort = table.sort
local math_floor = math.floor
local string_format = string.format

--@holy_data 神装方案数据 结构参考 协议25220
function HeroStarupCostHelpNewPanel:__init()
    self.is_full_screen = false
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "hero/hero_starup_cost_help_panel"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("hero","hero"), type = ResourcesType.plist },
    }
    self.show_list = {}
    self.btn_list = {}
    self.list_item = {}
    self.tab_index = 0
end 

function HeroStarupCostHelpNewPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_panel , 1) 
    self.main_panel:getChildByName("wnd_title"):setString(TI18N("语言_c_4405"))

    self.close_btn = self.main_panel:getChildByName("close_btn")

    self.scroll_container = self.main_panel:getChildByName("scroll_container")
    self.scroll_container:setScrollBarEnabled(false)
    self.sp_scroll_container = self.main_panel:getChildByName("sp_scroll_container")
    self.sp_scroll_container:setScrollBarEnabled(false)
    self.star_task_preview = self.main_panel:getChildByName("star_task_preview")
    self.star_task_preview:setVisible(false)
    
    self.tab_container = self.main_panel:getChildByName("tab_container")
    local tab_list = {
        [1] = TI18N("语言_c_6754"),
        [2] = TI18N("语言_c_6755"),
    }
    for i = 1, 2 do
        local item = self.tab_container:getChildByName("tab_btn_"..i)
        item.unselect_bg = item:getChildByName("unselect_bg")
        item.select_bg = item:getChildByName("select_bg")
        item.title = item:getChildByName("title")
        item.title:setString(tab_list[i])
        item.index = i
        self.btn_list[i] = item
    end
end

function HeroStarupCostHelpNewPanel:register_event()
    registerButtonEventListener(self.close_btn, function()
        controller:openHeroStarupCostHelpNewPanel(false)
    end, true, 2)
    
    registerButtonEventListener(self.background, function()
        controller:openHeroStarupCostHelpNewPanel(false)
    end, false, 2)

    registerButtonEventListener(self.star_task_preview, function()
        controller:openSpStarTaskListPanel(true,self.hero_vo)
    end, false, 2)

    for i = 1, 2 do
        registerButtonEventListener(self.btn_list[i], function()
            self:ClickBtnIndex(i)
        end, false, 2)
    end
end

function HeroStarupCostHelpNewPanel:ClickBtnIndex(index)
    if self.tab_index == index then return end
    for k, v in pairs(self.btn_list) do
        v.select_bg:setVisible(v.index == index)
        self.tab_index = index
        if k == index then
			v.title:setTextColor(cc.c4b(0xf8,0xef,0x76,0xff))
			v.title:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		else
			v.title:setTextColor(cc.c4b(0xf9,0xee,0xd0,0xff))
			v.title:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff),2)
		end
    end
    if index == 1 then        
        self.sp_scroll_container:setVisible(false)
        self.scroll_container:setVisible(true)
    else
        self.sp_scroll_container:setVisible(true)
        self.scroll_container:setVisible(false)
    end
end

function HeroStarupCostHelpNewPanel:openRootWnd(hero_vo)
    -- self:updateList()
    self.list_setting = {}
    self.hero_vo = hero_vo
    self:ClickBtnIndex(1)
    self:configListData(self.hero_vo)

    self:updateList()
    local cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    if cfg.score == 9 and model:getSpHeroTreeShield() then
        self.tab_container:setVisible(true)
        self.scroll_container:setContentSize(cc.size(self.scroll_container:getContentSize().width,800))
        self.sp_scroll_container:setContentSize(cc.size(self.scroll_container:getContentSize().width,800))
    else
        self.tab_container:setVisible(false)
        self.scroll_container:setContentSize(cc.size(self.scroll_container:getContentSize().width,870))
        self.sp_scroll_container:setContentSize(cc.size(self.scroll_container:getContentSize().width,870))
    end
end

function HeroStarupCostHelpNewPanel:updateScrollView()

    -- --计算位置
    local position_data_list = {}
    local item_width = 595
    local item_height = 220
    local scroll_height = 0

    for i,v in ipairs(self.show_list) do
        if v.next_star <= 11 then
            scroll_height = 220 + scroll_height
        elseif v.next_star <= 16 then
            scroll_height = 610 + scroll_height
        elseif v.next_star <= 17 then
            scroll_height = 950 + scroll_height
        end
    end
    local y = scroll_height
    for i, v in ipairs(self.show_list) do
        local x = item_width * 0.5
        local item_height = 220
        if v.next_star <= 11 then
            item_height = 220
        elseif v.next_star <= 16 then
            item_height = 610
        elseif v.next_star <= 17 then
            item_height = 950
        end
        position_data_list[i] = cc.p(x, y - item_height * 0.5)
        y = y - item_height
    end

    return position_data_list, scroll_height
end

function HeroStarupCostHelpNewPanel:configListData(hero_vo)
    -- 进入后显示该英雄升星所需要的材料
    -- 默认显示至10星所需材料
    
    -- 英雄10星后可查看 10升11,11升12的所需材料
    -- 英雄11星后可查看12升13星所需材料
    self.show_list = {}
    local cur_star = hero_vo.star
    local max_star = Config.PartnerData.data_partner_max_star[hero_vo.bid]
    local base_config = Config.PartnerData.data_partner_base[hero_vo.bid]
    if base_config.score == 9 and cur_star >= 15 then
        self.star_task_preview:setVisible(true)
    end
    local tar_star = max_star < 10 and max_star or 10
    for i=(base_config.init_star + 1),tar_star do
        self.show_list[#self.show_list + 1] = {first_star = (i - 1), next_star = i, hero_vo = hero_vo}
    end
    if hero_vo.star == 10 then
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
    elseif hero_vo.star == 11 then 
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
    elseif hero_vo.star == 12 then 
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
        if max_star >= 14 then
            self.show_list[#self.show_list + 1] = {first_star = 13, next_star = 14, hero_vo = hero_vo}
        end
    elseif hero_vo.star == 13 then 
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
        if max_star >= 14 then
            self.show_list[#self.show_list + 1] = {first_star = 13, next_star = 14, hero_vo = hero_vo}
        end
        if max_star >= 15 then
            self.show_list[#self.show_list + 1] = {first_star = 14, next_star = 15, hero_vo = hero_vo}
        end
    elseif hero_vo.star == 14 then
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
        if max_star >= 14 then
            self.show_list[#self.show_list + 1] = {first_star = 13, next_star = 14, hero_vo = hero_vo}
        end
        if max_star >= 15 then
            self.show_list[#self.show_list + 1] = {first_star = 14, next_star = 15, hero_vo = hero_vo}
        end
        if max_star >= 16 then
            self.show_list[#self.show_list + 1] = {first_star = 15, next_star = 16, hero_vo = hero_vo}
        end
    elseif hero_vo.star >= 15 then
        if max_star >= 11 then
            self.show_list[#self.show_list + 1] = {first_star = 10, next_star = 11, hero_vo = hero_vo}
        end
        if max_star >= 12 then
            self.show_list[#self.show_list + 1] = {first_star = 11, next_star = 12, hero_vo = hero_vo}
        end
        if max_star >= 13 then
            self.show_list[#self.show_list + 1] = {first_star = 12, next_star = 13, hero_vo = hero_vo}
        end
        if max_star >= 14 then
            self.show_list[#self.show_list + 1] = {first_star = 13, next_star = 14, hero_vo = hero_vo}
        end
        if max_star >= 15 then
            self.show_list[#self.show_list + 1] = {first_star = 14, next_star = 15, hero_vo = hero_vo}
        end
