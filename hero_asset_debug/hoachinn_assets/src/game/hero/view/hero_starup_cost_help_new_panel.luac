function HeroStarupCostHelpNewPanel:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.scroll_container:getContentSize()
        local setting = {
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 0,                     -- y方向的间隔
            item_width = 595,                -- 单元的尺寸width
            item_height = 220,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 2,
            -- need_dynamic = false, 
        }
        local position_data_list, container_height = self:updateScrollView()
        setting.position_data_list = position_data_list
        setting.container_height = container_height

        self.item_scrollview = CommonScrollViewSingleLayout.new(self.scroll_container, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    if #self.show_list == 0 then
        self:showEmptyIcon(true)
    else
        self:showEmptyIcon(false)
    end
    self.item_scrollview:reloadData()
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HeroStarupCostHelpNewPanel:createNewCell(width, height)
    local cell = HeroStarupCostNewItem.new(width, height)
    return cell
 end
 --获取数据数量
 function HeroStarupCostHelpNewPanel:numberOfCells()
     if not self.show_list then return 0 end
     return #self.show_list
 end
 --更新cell(拖动的时候.刷新数据时候会执行次方法)
 --cell :createNewCell的返回的对象
 --index :数据的索引
 function HeroStarupCostHelpNewPanel:updateCellByIndex(cell, index)
     cell.index = index
     local cell_data = self.show_list[index]
     if not cell_data then return end
     cell:setData(cell_data)
 end
 
 --点击cell .需要在 createNewCell 设置点击事件
 function HeroStarupCostHelpNewPanel:onCellTouched(cell)
 end

 function HeroStarupCostHelpNewPanel:showEmptyIcon(state)
 end

function HeroStarupCostHelpNewPanel:close_callback()
    -- for i,v in pairs(self.list_item) do
    --     v:removeFromParent()
    --     v=nil
    -- end
    -- for i,v in pairs(self.sp_list_item) do
    --     v:removeFromParent()
    --     v=nil
    -- end
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    controller:openHeroStarupCostHelpNewPanel(false)
end

-- --------------------------------------------------------------------
-- 竖版装备穿戴子项
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2020-2-27
-- --------------------------------------------------------------------
HeroStarupCostNewItem = class("HeroStarupCostNewItem", function()
    return ccui.Widget:create()
end)

function HeroStarupCostNewItem:ctor()  
    self:config()
    self:layoutUI()
end

function HeroStarupCostNewItem:config()
    self.attr_list = {}
    self.star_list = {}
    self.left_star_setting = {}
    self.right_star_setting = {}
end
function HeroStarupCostNewItem:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_starup_cost_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self:setAnchorPoint(cc.p(0, 0))

    self.main_panel = self.root_wnd:getChildByName("main_container")

    self.item_nodes = {}
    for i=1,5 do
        local panel = self.main_panel:getChildByName("layout_bg"..i)
        panel:setVisible(false)
        local scrollview = panel:getChildByName("scrollview_"..i)
        scrollview:setScrollBarEnabled(false)
        scrollview:setSwallowTouches(false)
        local item_node = scrollview:getChildByName("item_node_"..i)
        local sp_starup_star = panel:getChildByName("sp_starup_star_"..i)
        panel:getChildByName("star_rank_name"):setString(TI18N("语言_c_1")..i)
        panel:getChildByName("des_label_0"):setString(TI18N("语言_c_4406"))
        item_node.star_rank_name = panel:getChildByName("star_rank_name")
        item_node.des_label_0 = panel:getChildByName("des_label_0")
        item_node.scrollview = scrollview
        item_node.sp_starup_star = sp_starup_star
        self.item_nodes[#self.item_nodes + 1] = item_node 
        item_node.panel = panel
    end
    self.des_label = self.main_panel:getChildByName("des_label")
    self.des_label:setString(TI18N("语言_c_4406"))
    --星星node
    self.title_bg = self.main_panel:getChildByName("hero_info_24")
    self.left_star_node = self.title_bg:getChildByName("left_star_node")
    self.right_star_node = self.title_bg:getChildByName("right_star_node")
end

function HeroStarupCostNewItem:setData(data,index,node,page_index)
    if not data then return end
    self.data = data.hero_vo
    local first_star = data.first_star
    local next_star = data.next_star
    local bid = data.hero_vo.bid

    self.left_star_setting.mode = 1
    self.left_star_setting = model:createStar(first_star, self.left_star_node, self.left_star_setting, 24,0)
    self.right_star_setting.mode = 1
    self.right_star_setting = model:createStar(next_star, self.right_star_node, self.right_star_setting, 24,0)

    for i=1,4 do
        if self.star_list[i] then
            self.star_list[i]:setVisible(false)
        end
    end

    if next_star <= 11 then
        --十一星之前
        local next_key = getNorKey(bid, next_star)
        local config = Config.PartnerData.data_partner_star(next_key)
        self:updateItemDataByConfig(config, self.item_nodes[1])
        self.des_label:setVisible(true)
        self.item_nodes[1].panel:setVisible(true)
        self.item_nodes[2].panel:setVisible(false)
        self.item_nodes[3].panel:setVisible(false)
        self.item_nodes[4].panel:setVisible(false)
        self.item_nodes[5].panel:setVisible(false)
        self.item_nodes[1].sp_starup_star:setVisible(false)
        self.item_nodes[1].star_rank_name:setVisible(false)
        self.item_nodes[1].des_label_0:setVisible(false)
        self.item_nodes[2].sp_starup_star:setVisible(false)
        self.item_nodes[2].star_rank_name:setVisible(false)
        self.item_nodes[2].des_label_0:setVisible(false)
        self.item_nodes[3].sp_starup_star:setVisible(false)
        self.item_nodes[3].star_rank_name:setVisible(false)
        self.item_nodes[3].des_label_0:setVisible(false)
        self.item_nodes[4].sp_starup_star:setVisible(false)
        self.item_nodes[4].star_rank_name:setVisible(false)
        self.item_nodes[4].des_label_0:setVisible(false)
        self.item_nodes[5].sp_starup_star:setVisible(false)
        self.item_nodes[5].star_rank_name:setVisible(false)
        self.item_nodes[5].des_label_0:setVisible(false)
    else
        --十一星之后
        self.des_label:setVisible(false)
        local cfg = Config.PartnerData.data_partner_base[bid]
        if cfg.score == 9 and page_index == 2 then
            for i=1,4 do
                if i <= 2 then
                    local next_key = getNorKey(bid, first_star, i)
                    local config = Config.PartnerSpecialData.data_partner_star_step(next_key)
                    self:updateItemDataByConfig(config, self.item_nodes[i])
                    self.item_nodes[i].panel:setVisible(true)
                    self.item_nodes[i].sp_starup_star:setVisible(true)
                    self.item_nodes[i].star_rank_name:setVisible(true)
                    self.item_nodes[i].des_label_0:setVisible(true)
                else
                    self.item_nodes[i].panel:setVisible(false)
                    self.item_nodes[i].sp_starup_star:setVisible(false)
                    self.item_nodes[i].star_rank_name:setVisible(false)
                    self.item_nodes[i].des_label_0:setVisible(false)
                end
            end
        else
            for i=1,5 do
                self.item_nodes[i].panel:setVisible(false)
                if self.star_list[i] then
                    self.star_list[i]:setVisible(false)
                end
            end
            for i=1,5 do
                local next_key = getNorKey(bid, first_star, i)
                local config = Config.PartnerData.data_partner_star_step(next_key)
                if config then
                    self:updateItemDataByConfig(config, self.item_nodes[i])
                    self.item_nodes[i].panel:setVisible(true)
                    self.item_nodes[i].sp_starup_star:setVisible(true)
                    self.item_nodes[i].star_rank_name:setVisible(true)
                    self.item_nodes[i].des_label_0:setVisible(true)
                end
            end
            if next_star > 16 then
                self.left_star_setting = model:createStar(first_star, self.left_star_node, self.left_star_setting, 24, 0)
                self.right_star_setting = model:createStar(first_star, self.right_star_node, self.right_star_setting, 24, 1)
                local step = 1
                for i=1,4 do
                    if not self.star_list[i] then
                        self.star_list[i] = self.title_bg:clone()

                        self.main_panel:addChild(self.star_list[i])
                        local left_node = self.star_list[i]:getChildByName("left_star_node")
                        left_node:removeAllChildren()
                        if not self.attr_list[i] then
                            self.attr_list[i] = {}
                        end
                        if not self.attr_list[i].left then
                            self.attr_list[i].left = {}
                            self.attr_list[i].left.mode = 1
                        end
                        self.attr_list[i].left = model:createStar(first_star, left_node, self.attr_list[i].left, 24, step)
                        step = step + 1
                        local right_node = self.star_list[i]:getChildByName("right_star_node")
                        right_node:removeAllChildren()
                        local right_star = first_star
                        if step > 5 then
                            step = 0
                            right_star = next_star
                        end
                        if not self.attr_list[i].right then
                            self.attr_list[i].right = {}
                            self.attr_list[i].right.mode = 1
                        end
                        self.attr_list[i].right = model:createStar(right_star, right_node, self.attr_list[i].right, 24, step)
                    else
                        self.star_list[i]:setVisible(true)

                        if not self.attr_list[i] then
                            self.attr_list[i] = {}
                        end

                        local left_node = self.star_list[i]:getChildByName("left_star_node")
                        if not self.attr_list[i].left then
                            self.attr_list[i].left = {}
                            self.attr_list[i].left.mode = 1
                        end
                        self.attr_list[i].left = model:createStar(first_star, left_node, self.attr_list[i].left, 24, step)
                        step = step + 1
                        local right_node = self.star_list[i]:getChildByName("right_star_node")
                        local right_star = first_star
                        if step > 5 then
                            step = 0
                            right_star = next_star
                        end
                        if not self.attr_list[i].right then
                            self.attr_list[i].right = {}
                            self.attr_list[i].right.mode = 1
                        end
                        self.attr_list[i].right = model:createStar(right_star, right_node, self.attr_list[i].right, 24, step)
                    end
                end
            end

        end
    end
    if next_star <= 16 then
        for i=1,5 do
            local panel = self.main_panel:getChildByName("layout_bg"..i)
            panel:getChildByName("star_rank_name"):setString(TI18N("语言_c_1")..i)
        end
    else
        for i=1,5 do
            local panel = self.main_panel:getChildByName("layout_bg"..i)
            panel:getChildByName("star_rank_name"):setString(string.format( TI18N("语言_c_7581"),i))
        end
    end
    --设置尺寸和位置
    self:dolayouScrollView(data)
end

function HeroStarupCostNewItem:dolayouScrollView(data)
    local count = 0
    local init_height = 220
    local total_height = 220
    for i,v in ipairs(self.item_nodes) do
        if v.panel:isVisible() then
            count = count + 1
        end
        v.hero_item_list = v.hero_item_list or {}
        v.cost_item_list = v.cost_item_list or {}
        if (#v.hero_item_list + #v.cost_item_list) > 4 then
            local size = v.scrollview:getInnerContainerSize()
            v.scrollview:setInnerContainerSize(cc.size(size.width + size.width/4*((#v.hero_item_list + #v.cost_item_list) - 4), size.height))
        end
    end
    total_height = total_height + 130 * (count - 1)
    self.size.height = total_height
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.main_panel:setContentSize(self.size)
    self.main_panel:setPositionY(0)
    self.main_panel:getChildByName("hero_info_24"):setPositionY(total_height - 50)
    self.main_panel:getChildByName("des_label"):setPositionY(total_height - 140)
    self.main_panel:getChildByName("layout_bg1"):setPositionY(total_height - 140)
    self.main_panel:getChildByName("layout_bg2"):setPositionY(total_height - 260)
    self.main_panel:getChildByName("layout_bg3"):setPositionY(total_height - 380)
    self.main_panel:getChildByName("layout_bg4"):setPositionY(total_height - 500)
    self.main_panel:getChildByName("layout_bg5"):setPositionY(total_height - 620)

    if data.next_star > 16 then
        total_height = 950
        self.size.height = total_height
        self.root_wnd:setContentSize(self.size)
        self:setContentSize(self.size)
        self.main_panel:setContentSize(self.size)
        self.main_panel:setPositionY(0)
        self.main_panel:getChildByName("hero_info_24"):setPositionY(total_height - 50)
        self.main_panel:getChildByName("des_label"):setPositionY(total_height - 140)
        self.main_panel:getChildByName("layout_bg1"):setPositionY(total_height - 140)
        self.star_list[1]:setPositionY(total_height - 230)
        self.main_panel:getChildByName("layout_bg2"):setPositionY(total_height - 320)
        self.star_list[2]:setPositionY(total_height - 410)
        self.main_panel:getChildByName("layout_bg3"):setPositionY(total_height - 500)
        self.star_list[3]:setPositionY(total_height - 590)
        self.main_panel:getChildByName("layout_bg4"):setPositionY(total_height - 680)
        self.star_list[4]:setPositionY(total_height - 770)
        self.main_panel:getChildByName("layout_bg5"):setPositionY(total_height - 860)
    end
end

function HeroStarupCostNewItem:getSize()
    return self.size
end

--升星物品材料
function HeroStarupCostNewItem:updateItemDataByConfig(star_config, item_node)
    if not star_config then return end
    item_node.hero_item_data_list = item_node.hero_item_data_list or {}

    --指定的 {10402,4,1} : 10402: 表示bid, 4: 表示星级 1:表示数量
    local index = 1
    for i,expend in ipairs(star_config.expend2) do
        item_node.hero_item_data_list[index] = self:getHeroData(expend[1], expend[2], expend[3])
        index = index + 1
    end
    --随机的 {1,4,2} : 1 表示阵营  4: 表示星级 2表示数量
    for i,expend in ipairs(star_config.expend3) do
        item_node.hero_item_data_list[index] = self:getHeroData(nil, expend[2], expend[3], expend[1])
        index = index + 1
    end
    item_node.hero_item_list = item_node.hero_item_list or {}
    for i,item in ipairs(item_node.hero_item_list) do
        item:setVisible(false)
    end

    for i,hero_vo in ipairs(item_node.hero_item_data_list) do
        if item_node.hero_item_list[i] == nil then
            item_node.hero_item_list[i] = HeroExhibitionItem.new(0.7, false)
            item_node.hero_item_list[i]:setSwallowTouches(false)
            item_node.hero_item_list[i]:setPosition( (i-1) * (HeroExhibitionItem.Width * 0.7 + 3) , 0)
            item_node:addChild(item_node.hero_item_list[i])
        end
        item_node.hero_item_list[i]:setVisible(true)
        if hero_vo.bid == 0 then
            --随机卡的头像id
            local default_head_id = model:getRandomHeroHeadByQuality(hero_vo.star)
            item_node.hero_item_list[i]:setData(hero_vo)
            item_node.hero_item_list[i]:setDefaultHead(default_head_id)
            item_node.hero_item_list[i]:setHeroName(true, string_format(TI18N("语言_c_3022"), hero_vo.star))
        else
            item_node.hero_item_list[i]:setData(hero_vo)
            -- item_node.hero_item_list[i]:setHeroName(true, hero_vo.name)
            item_node.hero_item_list[i]:setHeroName(false)
        end
        item_node.hero_item_list[i]:setHeadUnEnabled(false)
    end

    -- 额外材料
    item_node.cost_item_list = item_node.cost_item_list or {}
    for k,item in pairs(item_node.cost_item_list) do
        item:setVisible(false)
    end

    local start_index = #item_node.hero_item_data_list
    if star_config.other_expend then
        for i,v in ipairs(star_config.other_expend) do
            local bid = v[1]
            local need_num = v[2]
            -- if bid ~= model.upgrade_star_cost_id then
                local item = item_node.cost_item_list[i]
                if not item then
                    item = BackPackItem.new(false, true, false, 0.7)
                    item:setSwallowTouches(false)
                    item_node:addChild(item)
                    item_node.cost_item_list[i] = item
                end
                item:setPosition( (start_index+i-1) * (BackPackItem.Width * 0.7 + 3) , 0)
                local have_num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(bid)
                item:setBaseData(bid)
                item:setNeedNum(need_num, nil, 1, true, 2)
                -- if need_num > have_num then
                --     item:setDefaultTip(true, true)
                -- else
                    item:setDefaultTip()
                -- end
                item:setVisible(true)
            -- end
        end
    end
end

--@ bid 英雄bid 特殊判断 如果 == nil 说明是随机卡
--@ star 星级
--@ count 数量
--@ camp_type 阵营  如果是随机卡.此一定需要有值
function HeroStarupCostNewItem:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s", count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
            data.name = base_config.name
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end

function HeroStarupCostNewItem:setVisibleStatus(bool)
    self:setVisible(bool)
end

function HeroStarupCostNewItem:clearStar()
    if self.left_star_setting then
        for i,v in pairs(self.left_star_setting.star_list or {}) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        for i,v in pairs(self.left_star_setting.star_list2) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        if self.left_star_setting.star10 and not tolua.isnull(self.left_star_setting.star10) then
            self.left_star_setting.star10:removeFromParent()
            self.left_star_setting.star10 = nil
        end
        if self.left_star_setting.moon and not tolua.isnull(self.left_star_setting.moon) then
            self.left_star_setting.moon:removeFromParent()
            self.left_star_setting.moon = nil
        end
    end
    
    if self.right_star_setting then
        for i,v in pairs(self.right_star_setting.star_list or {}) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        for i,v in pairs(self.right_star_setting.star_list2) do
            if v and not tolua.isnull(v) then
                v:removeFromParent()
            end
        end
        if self.right_star_setting.star10 and not tolua.isnull(self.right_star_setting.star10) then
            self.right_star_setting.star10:removeFromParent()
            self.right_star_setting.star10 = nil
        end
        if self.right_star_setting.moon and not tolua.isnull(self.right_star_setting.moon) then
            self.right_star_setting.moon:removeFromParent()
            self.right_star_setting.moon = nil
        end
    end

end

function HeroStarupCostNewItem:DeleteMe()
    self.data = nil
    self:removeFromParent()
end




