-- --------------------------------------------------------------------
-- 献祭卸下失败单个
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
HeroFailTipsItem = class("HeroFailTipsItem", function()
	return ccui.Widget:create()
end)

function HeroFailTipsItem:ctor()
	self:configUI()
	self:registerEvent()
end

function HeroFailTipsItem:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("hero/hero_fail_tips_item"))
	
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(570,124))
	self:setTouchEnabled(true)

	self.main_container = self.root_wnd:getChildByName("main_container")
    self.Panel_1 = self.main_container:getChildByName("Panel_1")
	self.small_title = self.main_container:getChildByName("small_title")
	self.go_btn = self.main_container:getChildByName("go_btn")
    self.label = self.go_btn:getChildByName("label")
    self.label:setString(TI18N("语言_c_4546"))
end
function HeroFailTipsItem:setData(data)
    self.data = data
    self.tips_label = createRichLabel(22, 175, cc.p(0,0), cc.p(10,60), nil, nil, 580)
    local lineup = self:getType(data[2])
    local str = string.format(TI18N("语言_c_4547"),lineup)
    self.tips_label:setString(str)
    self.small_title:setString(TI18N(data[1]))
    self.Panel_1:addChild(self.tips_label)
    self.Panel_1:setPositionX(self.Panel_1:getSize().width/2 - self.tips_label:getSize().width/2)
    print(self.small_title:getPositionX())
end
function HeroFailTipsItem:getType(fun_type)
    local str = ""
    if fun_type == PartnerConst.Fun_Form.Drama then
        str = TI18N("语言_c_4548")
    elseif fun_type == PartnerConst.Fun_Form.Arena then
        str = TI18N("语言_c_4549")
    elseif fun_type == PartnerConst.Fun_Form.EliteMatch then
        str = TI18N("语言_c_4657")
    elseif fun_type == PartnerConst.Fun_Form.EliteKingMatch then
        str = TI18N("语言_c_4658")
    elseif fun_type == PartnerConst.Fun_Form.CrossArenaDef then
        str = TI18N("语言_c_4659")
    elseif fun_type == PartnerConst.Fun_Form.Adventure_Mine_Def then
        str = TI18N("语言_c_4550")
    elseif fun_type == PartnerConst.Fun_Form.ArenaTeam then
        str = TI18N("语言_c_4551")
    elseif fun_type == PartnerConst.Fun_Form.ArenapeakchampionDef then
        str = TI18N("语言_c_4552")
    end
    return str
end
function HeroFailTipsItem:registerEvent()
	registerButtonEventListener(self.go_btn, function (  )
        self:onClickGo()
	end, true)
end
function HeroFailTipsItem:onClickGo()
    HeroSacrificePanel.self_matrix = self.data[2]
    HeroController:getInstance():openFormMainWindow(true,self.data[2])
end
function HeroFailTipsItem:DeleteMe()
	self:removeAllChildren()
	self:removeFromParent()
end