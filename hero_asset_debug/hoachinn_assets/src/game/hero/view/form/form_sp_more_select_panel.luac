--item 类
FormSpMoreSelectItem = class("FormSpMoreSelectItem", function()
    return ccui.Widget:create()
end)

function FormSpMoreSelectItem:ctor()
    self:config()
    self:layoutUI()
    self:registerEvent()
end

function FormSpMoreSelectItem:config()

end

function FormSpMoreSelectItem:layoutUI()
    self.size = cc.size(583, 148)
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)
    local csbPath = PathTool.getTargetCSB("hero/form_sp_skill_select_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.main_container = self.root_wnd:getChildByName("main_container")

    self.item_icon = SkillItem.new(true, true, true, 1, false)
    self.item_icon:setPosition(cc.p(80, 80))
    self.main_container:addChild(self.item_icon)

    self.name_label =  createLabel(24, Config.ColorData.data_color4[184], nil, 154, 117, "", self.main_container, 2, cc.p(0,0.5))

    local word_width = 270

    self.desc_scroll = self.main_container:getChildByName("desc_scroll")
    self.desc_scroll:setScrollBarEnabled(false)
    self.dec_label = createRichLabel(21, cc.c3b(0x68,0x45,0x2a), cc.p(0,1), cc.p(0,0), -4, 0, word_width)
    self.desc_scroll:addChild(self.dec_label)

    self.comfirm_btn = self.main_container:getChildByName("comfirm_btn")
    self.comfirm_label = self.comfirm_btn:getChildByName("label")
    self.comfirm_label:setColor(cc.c3b(0xff,0xff,0xff))
end


function FormSpMoreSelectItem:registerEvent()
    registerButtonEventListener(self.comfirm_btn, handler(self, self.onClickComfirmBtn) ,true, 2)
end

function FormSpMoreSelectItem:onClickComfirmBtn()
    GlobalEvent:getInstance():Fire(HeroEvent.Hero_Sp_Skill_Update_Event, self.data)
end

function FormSpMoreSelectItem:setData(data)
    if not data then return end
    self.data = data
    self.cfg = Config.SkillData.data_get_skill(self.data.show_bid)
    if self.cfg then
        local name_str = string_format("%s (%s)", self.cfg.name, string.format(TI18N("语言_c_540"),self.cfg.level))
        self.name_label:setString(transformTextToShort(name_str, 30))
        addEvt2showAllTextTips(self.name_label,name_str,30)
        self.dec_label:setString(self.cfg.des, 30)
        local _h = math.max(self.desc_scroll:getContentSize().height,self.dec_label:getContentSize().height)
        self.desc_scroll:setInnerContainerSize(cc.size(self.desc_scroll:getContentSize().width,_h))
        self.dec_label:setPositionY(_h)
        self.item_icon:setData(self.cfg)
        self:setBtnStatus(self.data.is_equip)
        self.comfirm_btn:setVisible(true)
    else
        self.comfirm_btn:setVisible(false)
    end
end

--是否装备
function FormSpMoreSelectItem:setBtnStatus(is_equip)
    if is_equip  then
        local btn_res_id = PathTool.getResFrame("common", "common_1018")
        self.comfirm_btn:loadTexture(btn_res_id, LOADTEXT_TYPE_PLIST)
        self.comfirm_label:setString(TI18N("语言_c_3187"))
        self.comfirm_label:enableOutline(Config.ColorData.data_color4[263], 2)
    else
        local btn_res_id = PathTool.getResFrame("common", "common_1017")
        self.comfirm_btn:loadTexture(btn_res_id, LOADTEXT_TYPE_PLIST)
        self.comfirm_label:setString(TI18N("语言_c_3188"))
        self.comfirm_label:enableOutline(Config.ColorData.data_color4[264], 2) 
    end
end

function FormSpMoreSelectItem:DeleteMe()
    if self.item_icon then
        self.item_icon:DeleteMe()
        self.item_icon = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end