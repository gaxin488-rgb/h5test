		end
	else
		for iter_122_8, iter_122_9 in pairs(arg_122_2) do
			if arg_122_0.five_hero_vo[iter_122_8] then
				for iter_122_10, iter_122_11 in pairs(arg_122_0.five_hero_vo[iter_122_8]) do
					if iter_122_11.partner_id == arg_122_1.partner_id and iter_122_11.rid == arg_122_1.rid and iter_122_11.srv_id == arg_122_1.srv_id then
						var_122_0 = iter_122_8
						var_122_1 = iter_122_10

						break
