		end

		if var_122_0 ~= 0 and var_122_3 ~= 0 and var_122_3 ~= var_122_0 then
			arg_122_0:onClickTeamTabBtn(var_122_0 + 1, true)

			if var_122_2 then
				for iter_122_6, iter_122_7 in pairs(arg_122_0.five_hero_vo[arg_122_0.select_team_index]) do
					if iter_122_7.id == var_122_2.id then
