function FormGoFightPanel.checkSameHeroTips(self, hero_vo, dic_team_data, more_team_data, other_arg)
    -- Nếu có nhiều đội hình (more_team_data)
    if more_team_data then
        for _, team in pairs(more_team_data) do
            local pos_info = team.pos_info or {}

            for _, info in pairs(pos_info) do
                local h_vo = var_0_2:getHeroById(info.id)

                -- Kiểm tra trùng bid hoặc trùng bustid
                if h_vo.bid == hero_vo.bid or h_vo.bustid == hero_vo.bustid then
                    if info.order == self.team_select_team_index - 1 then
                        message(TI18N("语言_c_178"))
                        return true
                    elseif not self:checkOtherCondition(h_vo, other_arg, info) then
                        message(TI18N("语言_c_448"))
                        return true
                    end
                end
            end
        end
    else
        -- Duyệt từng đội hình hiện tại
        for team_idx, team_data in pairs(dic_team_data) do
            if self.five_hero_vo[team_idx] then
                for _, h_in_team in pairs(self.five_hero_vo[team_idx]) do
                    if h_in_team.bid == hero_vo.bid or h_in_team.bustid == hero_vo.bustid then
                        if self.fun_form_type == PartnerConst.Fun_Form.CrossArena
                           or self.fun_form_type == PartnerConst.Fun_Form.CrossArenaDef
                           or self.fun_form_type == PartnerConst.Fun_Form.ArenapeakchampionDef then
                            
                            if team_idx == self.select_team_index then
                                message(TI18N("语言_c_178"))
                                return true
                            elseif not self:checkOtherCondition(h_in_team) then
                                message(TI18N("语言_c_448"))
                                return true
                            end
                        else
                            if team_idx == self.select_team_index then
                                message(TI18N("语言_c_178"))
                            else
                                message(TI18N("语言_c_3175"))
                            end
                            return true
                        end
                    end
                end
            end
        end
    end

    -- Nếu không vi phạm điều kiện, trả về false → cho phép xuất trận
    return false
end


