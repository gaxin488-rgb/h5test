            if bag_code ~= BackPackConst.Bag_Code.EQUIPS then 
                self:checkUpdateCurrentInfo(true)
            end
        end)
    end

    --物品道具改变 判断红点
    if not self.modify_goods_event then
        self.modify_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_list)
            if not self.hero_vo then return end
            if bag_code ~= BackPackConst.Bag_Code.EQUIPS then 
                self:checkUpdateCurrentInfo(true)
            end
        end)
    end

    if not self.updateAwaken then
        self.updateAwaken = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Awaken_Update_Event,function ( data )
        	self:updateInfoPanel()
            self:updateSpInfoPanel()
            self:updataCampIcon()
        end)
    end

    if not self.sp_star_task then
        self.sp_star_task = GlobalEvent:getInstance():Bind(HeroEvent.Hero_Sp_Star_Task_Event,function ()
        	local bid = self.hero_vo.bid
            local cfg = Config.PartnerData.data_partner_base[bid]
            if cfg.score == 9 then
                self:setRedPoint(self.hero_vo)
            end
        end)
    end
    
    for i = 1, 4 do
        if self.skill_panel_list[i] then
            self.skill_panel_list[i]:addTouchEventListener(function(sender, event_type)
                customClickAction_2(sender,event_type)
                if event_type == ccui.TouchEventType.began then
                    local config = Config.PartnerAwakenSkillData.data_const
                    if config and self.hero_vo then
                        local awaken_skills = model:getAwakenSkillId(self.hero_vo.id)
                        if config["awaken_position_star_lv" .. i] and config["awaken_position_star_lv" .. i]["val"] then
                            local cfg_lv = config["awaken_position_star_lv" .. i]["val"]
                            local cfg_needstep = cfg_lv[2]
                            local cfg_needstar = cfg_lv[1]
                            local hero_star = self.hero_vo.star
                            local hero_star_step = self.hero_vo.star_step
                            local has_skill = false
                            for k, v in pairs(awaken_skills) do
                                if i == v.pos then
                                    has_skill = true
                                end
                            end
                            if hero_star > cfg_needstar then
                                if has_skill then
                                else
                                    self:onClickOpenAwaker(i)
                                end
                            else
                                if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                                    if has_skill then
                                    else
                                        self:onClickOpenAwaker(i)
                                    end
                                else
                                    if hero_star == 13 then
                                        if i > 2 then
                                            if config["show_condition"] and config["show_condition"].val == 1 then
                                                message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                            else
                                                message(TI18N("语言_c_2050"))
                                            end 
                                        else
                                            message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                        end
                                    else
                                        if config["show_condition"] and config["show_condition"].val == 1 then
                                            message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                        else
                                            message(TI18N("语言_c_2050"))
                                        end 
                                    end
                                    
                                end
                            end
                        end
                    end
                    -- self:setMainPanel(i)
                    -- self:itemClickBtn(tableLen(self.bond_skill_list))
                end
            end)
        end
    end

    for i = 1, 4 do
        if self.tree_skill_panel_list[i] then
            self.tree_skill_panel_list[i]:addTouchEventListener(function(sender, event_type)
                customClickAction_2(sender,event_type)
                if event_type == ccui.TouchEventType.began then
                    local config = Config.PartnerAwakenSkillData.data_const
                    if config and self.hero_vo then
                        local awaken_skills = model:getAwakenSkillId(self.hero_vo.id)
                        if config["awaken_position_star_sp_lv" .. i] and config["awaken_position_star_sp_lv" .. i]["val"] then
                            local cfg_lv = config["awaken_position_star_sp_lv" .. i]["val"]
                            local cfg_needstep = cfg_lv[2]
                            local cfg_needstar = cfg_lv[1]
                            local hero_star = self.hero_vo.star
                            local hero_star_step = self.hero_vo.star_step
                            local has_skill = false
                            for k, v in pairs(awaken_skills) do
                                if i == v.pos then
                                    has_skill = true
                                end
                            end
                            if hero_star > cfg_needstar then
                                if has_skill then
                                else
                                    self:onClickOpenAwaker(i)
                                end
                            else
                                if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                                    if has_skill then
                                    else
                                        self:onClickOpenAwaker(i)
                                    end
                                else
                                    if hero_star == 13 then
                                        if i > 2 then
                                            if config["show_condition"] and config["show_condition"].val == 1 then
                                                message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                            else
                                                message(TI18N("语言_c_2050"))
                                            end 
                                        else
                                            message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                        end
                                    else
                                        if config["show_condition"] and config["show_condition"].val == 1 then
                                            message(string_format(TI18N("语言_c_6279"), cfg_needstar, cfg_needstep))
                                        else
                                            message(TI18N("语言_c_2050"))
                                        end 
                                    end
                                    
                                end
                            end
                        end
                    end
                    -- self:setMainPanel(i)
                    -- self:itemClickBtn(tableLen(self.bond_skill_list))
                end
            end)
        end
    end

