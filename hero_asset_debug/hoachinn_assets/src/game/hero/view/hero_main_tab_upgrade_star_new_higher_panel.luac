    registerButtonEventListener(self.tree_hero_camp, handler(self, self.onClickOpenAwakerByBtn) ,true, 1)
    registerButtonEventListener(self.tree_img_attr_des, handler(self, self.onClickBtnDes) ,true, 1)
    registerButtonEventListener(self.change_btn, handler(self, self.onClickBtnLook) ,true, 1)
