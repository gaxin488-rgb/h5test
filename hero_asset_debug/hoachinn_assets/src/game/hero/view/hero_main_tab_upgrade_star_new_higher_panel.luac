HeroMainTabUpgradeStarNewHigherPanel = class("HeroMainTabUpgradeStarNewHigherPanel", function()
    return ccui.Widget:create()
end)

local string_format = string.format
local controller = HeroController:getInstance()
local model = controller:getModel()
local table_insert = table.insert
local table_sort = table.sort
local role_vo = RoleController:getInstance():getRoleVo()

function HeroMainTabUpgradeStarNewHigherPanel:ctor(parent)  
    self:config()
    self:layoutUI()
    self:registerEvents()
end
function HeroMainTabUpgradeStarNewHigherPanel:config()
    self.bg_line = {}
    self.not_upgraded = {}
    self.line = {}
    self.upgraded = {}
    self.skill_panel_list = {}
    self.skill_bg_list = {}
    self.skill_lock_list = {}
    self.skill_icon_list = {}
    self.skill_add_list = {}
    self.star_txt_list = {}

    self.tree_bg_line = {}
    self.tree_not_upgraded = {}
    self.tree_line = {}
    self.tree_upgraded = {}
    self.tree_skill_panel_list = {}
    self.tree_skill_bg_list = {}
    self.tree_skill_lock_list = {}
    self.tree_skill_icon_list = {}
    self.tree_skill_add_list = {}

    self.page_index = 0
end

function HeroMainTabUpgradeStarNewHigherPanel:layoutUI()
    local csbPath = PathTool.getTargetCSB("hero/hero_main_tab_upgrade_star_new_higher_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    --读取文件的大小
    self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)

    --config ui 
    local tab_panel = self.root_wnd:getChildByName("tab_panel")
    self.tab_panel = tab_panel
    for i=1,4 do
        local bg_line = tab_panel:getChildByName("bg_line_"..i)
        table.insert(self.bg_line, i, bg_line)
        local not_upgraded = tab_panel:getChildByName("not_upgraded_"..i)
        table.insert(self.not_upgraded, i, not_upgraded)
        local line = tab_panel:getChildByName("line_"..i)
        table.insert(self.line, i, line)
        local upgraded = tab_panel:getChildByName("upgraded_"..i)
        table.insert(self.upgraded, i, upgraded)
    end
    for i=1,4 do
        local star_txt = tab_panel:getChildByName("star_txt_"..i)
        if star_txt then
            star_txt:setString(string_format(TI18N("语言_c_3041"), i))
            star_txt.init_y = star_txt:getPositionY()
            self.star_txt_list[i] = star_txt
        end
    end
    self.star_ur_bg = tab_panel:getChildByName("star_ur_bg")
    self.star_ur_bg:setVisible(false)
    self.hero_camp = tab_panel:getChildByName("hero_camp")
    self.hero_camp.camp_txt = self.hero_camp:getChildByName("camp_txt")
    self.hero_camp_light = tab_panel:getChildByName("hero_camp_light")
    self.img_attr_des = tab_panel:getChildByName("img_attr_des")
    self.img_attr_des_txt = self.img_attr_des:getChildByName("label")
    self.img_attr_des_txt:setString(TI18N("语言_c_4892"))
    self.up_btn = tab_panel:getChildByName("up_btn")
    self.up_btn_txt = self.up_btn:getChildByName("label")
    self.up_btn_txt:setString(TI18N("语言_c_5915"))

    self.act_btn = tab_panel:getChildByName("act_btn")
    self.act_btn_txt = self.act_btn:getChildByName("label")
    self.act_btn_txt:setString(TI18N("语言_c_2970"))
    self.info_txt = tab_panel:getChildByName("info_txt")
    self.info_txt:setString("")--TI18N("语言_c_4392"))

    for i = 1, 4 do
        local skill_panel = tab_panel:getChildByName("skill_panel_" .. i)
        if skill_panel then
            self.skill_panel_list[i] = skill_panel
            self.skill_bg_list[i] = skill_panel:getChildByName("skill_bg")
            self.skill_lock_list[i] = skill_panel:getChildByName("skill_lock")
            self.skill_icon_list[i] = skill_panel:getChildByName("skill_icon")
            self.skill_add_list[i] = skill_panel:getChildByName("skill_add")
            self.skill_icon_list[i]:setScale(0.9, 0.9)
        end
    end

    local tab_tree_panel = self.root_wnd:getChildByName("tab_tree_panel")
    self.tab_tree_panel = tab_tree_panel
    for i=1,2 do
        local bg_line = tab_tree_panel:getChildByName("bg_line_"..i)
        table.insert(self.tree_bg_line, i, bg_line)
        local not_upgraded = tab_tree_panel:getChildByName("not_upgraded_"..i)
        table.insert(self.tree_not_upgraded, i, not_upgraded)
        local line = tab_tree_panel:getChildByName("line_"..i)
        table.insert(self.tree_line, i, line)
        local upgraded = tab_tree_panel:getChildByName("upgraded_"..i)
        table.insert(self.tree_upgraded, i, upgraded)
    end
    for i=1,2 do
        local star_txt = tab_tree_panel:getChildByName("star_txt_"..i)
        if star_txt then
            star_txt:setString(string_format(TI18N("语言_c_3041"), i))
        end
    end
    self.tree_hero_camp = tab_tree_panel:getChildByName("hero_camp")
    self.tree_hero_camp.camp_txt = self.tree_hero_camp:getChildByName("camp_txt")
    self.tree_hero_camp_light = tab_tree_panel:getChildByName("hero_camp_light")
    self.tree_img_attr_des = tab_tree_panel:getChildByName("img_attr_des")
    self.tree_img_attr_des_txt = self.tree_img_attr_des:getChildByName("label")
    self.tree_img_attr_des_txt:setString(TI18N("语言_c_4892"))
    self.tree_up_btn = tab_tree_panel:getChildByName("up_btn")
    self.tree_up_btn_txt = self.tree_up_btn:getChildByName("label")
    self.tree_up_btn_txt:setString(TI18N("语言_c_5915"))

    self.tree_act_btn = tab_tree_panel:getChildByName("act_btn")
    self.tree_act_btn_txt = self.tree_act_btn:getChildByName("label")
    self.tree_act_btn_txt:setString(TI18N("语言_c_2970"))    
    self.skill_name = tab_tree_panel:getChildByName("skill_name")
    self.skill_item = SkillItem.new(true,true,true,0.6, true)
    tab_tree_panel:addChild(self.skill_item)
    self.skill_item:setPosition(cc.p(290,131))
    self.skill_lev = createRichLabel(20,cc.c3b(0x0e,0xa8,0x0e),cc.p(0,0.5),cc.p(336,115))
    tab_tree_panel:addChild(self.skill_lev)
    self.skill_name:setVisible(false)
    self.skill_item:setVisible(false)
    self.skill_lev:setVisible(false)
    self.tree_info_txt = tab_tree_panel:getChildByName("info_txt")
    self.tree_info_txt:setString("")--TI18N("语言_c_4392"))
    for i = 1, 4 do
        local skill_panel = tab_tree_panel:getChildByName("skill_panel_" .. i)
        if skill_panel then
            self.tree_skill_panel_list[i] = skill_panel
            self.tree_skill_bg_list[i] = skill_panel:getChildByName("skill_bg")
            self.tree_skill_lock_list[i] = skill_panel:getChildByName("skill_lock")
            self.tree_skill_icon_list[i] = skill_panel:getChildByName("skill_icon")
            self.tree_skill_add_list[i] = skill_panel:getChildByName("skill_add")
            -- self.tree_skill_icon_list[i]:setScale(0.9, 0.9)
        end
    end

    
    self.change_btn = self.root_wnd:getChildByName("change_btn")
    self.change_txt = self.change_btn:getChildByName("label")
    self.change_txt:setString(TI18N("语言_c_567"))
end
function HeroMainTabUpgradeStarNewHigherPanel:setVisibleStatus(bool)
    self:setVisible(bool)
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickBtnChange()
    if self.page_index == 1 then
        self.page_index = 2
    else
        self.page_index = 1
    end
    self.tab_panel:setVisible(self.page_index == 1)
    self.tab_tree_panel:setVisible(self.page_index == 2)
end

function HeroMainTabUpgradeStarNewHigherPanel:setData(hero_vo)
    if not hero_vo then return end
    self.hero_vo = hero_vo
    -- self:updataInfo(self.hero_vo)
    self.cfg = Config.PartnerData.data_partner_base[self.hero_vo.bid]
    if self.cfg.score == 9 and model:getSpHeroTreeShield() then
        self.change_btn:setVisible(true)
    else
        self.change_btn:setVisible(false)
    end
    if self.hero_vo.isUpStarTreeHero and self.hero_vo:isUpStarTreeHero() then
        self.page_index = 1
    else
        self.page_index = 0
    end
    self:onClickBtnChange()

    self:updataStarInfo()
    self:updateInfoPanel()
    self:updateSpInfoPanel()
    self:setRedPoint(self.hero_vo)
    self:updateSpSkill()
    if not self.look_txt then
        self.look_txt = createRichLabel(20,cc.c3b(0x0e,0xa8,0x0e),cc.p(0,1),cc.p(0,373))
        self.root_wnd:addChild(self.look_txt)
        self.look_txt:setString(TI18N("语言_c_6875"))
        self.look_txt:addTouchLinkListener(function()
            if not self.hero_vo then return end
            local pokedex_config = Config.PartnerData.data_partner_pokedex[self.hero_vo.bid]
            if pokedex_config and pokedex_config[1] then
                local star = pokedex_config[1].star or 1
                -- controller:openHeroInfoWindowByBidStar(self.hero_vo.bid, star)
                local key = getNorKey(self.hero_vo.bid, star)
                local hero_list = model:getHeroPokedexByBid(key)
                if hero_list then
                    controller:getHeroMainInfoWindow().cur_tab_index = nil
                    controller:getHeroMainInfoWindow():openRootWnd(hero_list, {hero_list}, {show_model_type = HeroConst.BagTab.eBagPokedex, is_hide_ui = true,show_type = HeroConst.MainInfoTab.eMainTrain})
                end
            end
        end, { "click", "href" })
    end
    self:updataCampIcon()
end

function HeroMainTabUpgradeStarNewHigherPanel:updateSpSkill()
    if self.page_index == 2 then
        local id = 0
        for i,v in pairs(self.hero_vo.skills) do
            if v.pos == 2 then
                id = v.skill_bid
            end
        end
        if id == 0 then return end
        self.skill_name:setVisible(true)
        self.skill_item:setVisible(true)
        self.skill_lev:setVisible(true)
        local skill_cfg = Config.SkillData.data_get_skill(id)
        self.skill_name:setString(skill_cfg.name)
        self.skill_item:setData(skill_cfg)
        local str = ""
        if skill_cfg.next_id ~= 0 then
            str = string.format(TI18N("语言_c_4520"),skill_cfg.level)..string.format("<img src=%s visible=true scale=0.5 />",PathTool.getResFrame("common", "common_90017"))..string.format(TI18N("语言_c_4520"),skill_cfg.level+1)
        else
            str = TI18N("max")
        end
        self.skill_lev:setString(str)
    else
        self.skill_name:setVisible(false)
        self.skill_item:setVisible(false)
        self.skill_lev:setVisible(false)
        return
    end
end
function HeroMainTabUpgradeStarNewHigherPanel:updataStarInfo()
    for key, value in pairs(self.line) do
        value:setVisible(self.hero_vo.star_step >= key)
    end
    for key, value in pairs(self.upgraded) do
        doStopAllActions(value)
        value:setOpacity(255)
        value:setVisible(self.hero_vo.star_step >= key)
    end
    for key, value in pairs(self.not_upgraded) do
        value:setVisible(self.hero_vo.star_step < key)
    end
    for key, value in pairs(self.bg_line) do
        value:setVisible(self.hero_vo.star_step < key)
    end
    self.up_btn:setVisible(self.hero_vo.star_step < 4)
    local max_star = Config.PartnerData.data_partner_max_star[self.hero_vo.bid]
    self.act_btn:setVisible(self.hero_vo.star >= 13 and self.hero_vo.star_step >= 4 and self.hero_vo.star < max_star)
    if self.hero_vo.star_step < 4 then
        self.upgraded[self.hero_vo.star_step + 1]:setVisible(true)
        self.upgraded[self.hero_vo.star_step + 1]:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))
    end


    for key, value in pairs(self.tree_line) do
        value:setVisible(self.hero_vo.star_step >= key)
    end
    for key, value in pairs(self.tree_upgraded) do
        doStopAllActions(value)
        value:setOpacity(255)
        value:setVisible(self.hero_vo.star_step >= key)
    end
    for key, value in pairs(self.tree_not_upgraded) do
        value:setVisible(self.hero_vo.star_step < key)
    end
    for key, value in pairs(self.tree_bg_line) do
        value:setVisible(self.hero_vo.star_step < key)
    end
    self.tree_up_btn:setVisible(self.hero_vo.star_step < 2)
    local max_star = Config.PartnerData.data_partner_max_star[self.hero_vo.bid]
    self.tree_act_btn:setVisible(self.hero_vo.star >= 13 and self.hero_vo.star_step >= 2 and self.hero_vo.star < max_star)
    if self.hero_vo.star_step < 2 then
        self.tree_upgraded[self.hero_vo.star_step + 1]:setVisible(true)
        self.tree_upgraded[self.hero_vo.star_step + 1]:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))
    end
end

function HeroMainTabUpgradeStarNewHigherPanel:updateInfoPanel()
    local config = Config.PartnerAwakenSkillData.data_const
    if config and self.hero_vo then
        local hero_star = self.hero_vo.star
        local hero_star_step = self.hero_vo.star_step
        local awaken_skills = model:getAwakenSkillId(self.hero_vo.id)
        local camp_lv = config["awaken_position_star_lv1"]["val"]
        local camp_needstep = camp_lv[2]
        local camp_needstar = camp_lv[1]
        local hero_camp_rp = false
        if hero_star > camp_needstar then
            setChildUnEnabled(false, self.hero_camp) 
            setChildUnEnabled(false, self.hero_camp_light) 
        else
            if hero_star == camp_needstar and hero_star_step >= camp_needstep then
                setChildUnEnabled(false, self.hero_camp) 
                setChildUnEnabled(false, self.hero_camp_light) 
            else
                setChildUnEnabled(true, self.hero_camp) 
                setChildUnEnabled(true, self.hero_camp_light) 
            end
        end
        for i = 1, 4 do
            if config["awaken_position_star_lv" .. i] and config["awaken_position_star_lv" .. i]["val"] then
                local cfg_lv = config["awaken_position_star_lv" .. i]["val"]
                local cfg_needstep = cfg_lv[2]
                local cfg_needstar = cfg_lv[1]
                local skill_bg = self.skill_bg_list[i]
                skill_bg:setScale(0.72, 0.72)
                local skill_lock = self.skill_lock_list[i]
                local skill_icon = self.skill_icon_list[i]
                local skill_panel = self.skill_panel_list[i]
                local skill_add = self.skill_add_list[i]
                if skill_bg then
                    if hero_star > cfg_needstar then
                        loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                        LOADTEXT_TYPE_PLIST)
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                                LOADTEXT_TYPE_PLIST)
                        else
                            loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                                LOADTEXT_TYPE_PLIST)
                        end
                    end
                end
                if skill_lock then
                    if hero_star > cfg_needstar then
                        skill_lock:setVisible(false)
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            skill_lock:setVisible(false)
                        else
                            skill_lock:setVisible(true)
                        end
                    end
                end
                if skill_icon then
                    local red_status = false
                    if hero_star > cfg_needstar then
                        skill_icon:setVisible(true)
                        skill_bg:setVisible(false)
                        red_status = true
                        for k, v in pairs(awaken_skills) do
                            if i == v.pos and v.skill_id ~= 0 then
                                red_status = false
                                break
                            end
                        end
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            skill_icon:setVisible(true)
                            skill_bg:setVisible(false)
                            red_status = true
                            for k, v in pairs(awaken_skills) do
                                if i == v.pos and v.skill_id ~= 0 then
                                    red_status = false
                                    break
                                end
                            end
                        else
                            skill_bg:setVisible(true)
                            skill_icon:setVisible(false)
                        end
                    end
                    if red_status then
                        hero_camp_rp = true
                    end
                    if skill_panel then
                        addRedPointToNodeByStatus(skill_panel,red_status,5,5)
                    end
                    if skill_add then
                        skill_add:setVisible(red_status)
                    end
                    if not self["skill_item" .. i] then
                        self["skill_item" .. i] = SkillItem.new(true, true, true, 0.8, true)
                        -- self["skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                        skill_icon:addChild(self["skill_item" .. i])
                        self["skill_item" .. i]:setPositionX(50)
                        self["skill_item" .. i]:setPositionY(50)
                    end
                    self["skill_item" .. i]:setData(nil)
                    -- self["skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                    for k, v in pairs(awaken_skills) do
                        if i == v.pos then
                            local skill_cfg = Config.SkillData.data_get_skill(v.skill_id)
                            self["skill_item" .. i]:setData(skill_cfg)
                            -- self["skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                        end
                    end
                end
            end
        end
        addRedPointToNodeByStatus(self.hero_camp,hero_camp_rp,5,5)

        local skill_panel_pos_4 = {[1]=214,[2]=300,[3]=386,[4]=472}
        local skill_panel_pos_2 = {[1]=300,[2]=386}
        for i = 1, 4 do
            local skill_panel = self.skill_panel_list[i]
            if skill_panel then
                skill_panel:setVisible(true)
                skill_panel:setPositionX(skill_panel_pos_4[i])
                if hero_star < 14 then
                    if i > 2 then
                        skill_panel:setVisible(false)
                    else
                        skill_panel:setPositionX(skill_panel_pos_2[i])
                    end
                end
            end
        end
    end
end

function HeroMainTabUpgradeStarNewHigherPanel:updateSpInfoPanel()
    local config = Config.PartnerAwakenSkillData.data_const
    if config and self.hero_vo then
        local hero_star = self.hero_vo.star
        local hero_star_step = self.hero_vo.star_step
        local awaken_skills = model:getAwakenSkillId(self.hero_vo.id)
        local camp_lv = config["awaken_position_star_sp_lv1"]["val"]
        local camp_needstep = camp_lv[2]
        local camp_needstar = camp_lv[1]
        local hero_camp_rp = false
        if hero_star > camp_needstar then
            setChildUnEnabled(false, self.tree_hero_camp) 
            setChildUnEnabled(false, self.tree_hero_camp_light) 
        else
            if hero_star == camp_needstar and hero_star_step >= camp_needstep then
                setChildUnEnabled(false, self.tree_hero_camp) 
                setChildUnEnabled(false, self.tree_hero_camp_light) 
            else
                setChildUnEnabled(true, self.tree_hero_camp) 
                setChildUnEnabled(true, self.tree_hero_camp_light) 
            end
        end
        for i = 1, 4 do
            if config["awaken_position_star_sp_lv" .. i] and config["awaken_position_star_sp_lv" .. i]["val"] then
                local cfg_lv = config["awaken_position_star_sp_lv" .. i]["val"]
                local cfg_needstep = cfg_lv[2]
                local cfg_needstar = cfg_lv[1]
                local skill_bg = self.tree_skill_bg_list[i]
                skill_bg:setScale(0.6, 0.6)
                local skill_lock = self.tree_skill_lock_list[i]
                local skill_icon = self.tree_skill_icon_list[i]
                local skill_panel = self.tree_skill_panel_list[i]
                local skill_add = self.tree_skill_add_list[i]
                if skill_bg then
                    if hero_star > cfg_needstar then
                        loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                        LOADTEXT_TYPE_PLIST)
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                                LOADTEXT_TYPE_PLIST)
                        else
                            loadSpriteTexture(skill_bg, PathTool.getResFrame("common", "common_1005"),
                                LOADTEXT_TYPE_PLIST)
                        end
                    end
                end
                if skill_lock then
                    if hero_star > cfg_needstar then
                        skill_lock:setVisible(false)
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            skill_lock:setVisible(false)
                        else
                            skill_lock:setVisible(true)
                        end
                    end
                end
                if skill_icon then
                    local red_status = false
                    if hero_star > cfg_needstar then
                        skill_icon:setVisible(true)
                        skill_bg:setVisible(false)
                        red_status = true
                        for k, v in pairs(awaken_skills) do
                            if i == v.pos and v.skill_id ~= 0 then
                                red_status = false
                                break
                            end
                        end
                    else
                        if hero_star == cfg_needstar and hero_star_step >= cfg_needstep then
                            skill_icon:setVisible(true)
                            skill_bg:setVisible(false)
                            red_status = true
                            for k, v in pairs(awaken_skills) do
                                if i == v.pos and v.skill_id ~= 0 then
                                    red_status = false
                                    break
                                end
                            end
                        else
                            skill_bg:setVisible(true)
                            skill_icon:setVisible(false)
                        end
                    end
                    if red_status then
                        hero_camp_rp = true
                    end
                    if skill_panel then
                        addRedPointToNodeByStatus(skill_panel,red_status,5,5)
                    end
                    if skill_add then
                        skill_add:setVisible(red_status)
                    end
                    if not self["sp_skill_item" .. i] then
                        self["sp_skill_item" .. i] = SkillItem.new(true, true, true, 0.6, true)
                        -- self["skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                        skill_icon:addChild(self["sp_skill_item" .. i])
                        self["sp_skill_item" .. i]:setPositionX(skill_icon:getContentSize().width*0.5)
                        self["sp_skill_item" .. i]:setPositionY(skill_icon:getContentSize().height*0.5)
                    end
                    self["sp_skill_item" .. i]:setData(nil)
                    -- self["sp_skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                    for k, v in pairs(awaken_skills) do
                        if i == v.pos then
                            local skill_cfg = Config.SkillData.data_get_skill(v.skill_id)
                            self["sp_skill_item" .. i]:setData(skill_cfg)
                            -- self["sp_skill_item" .. i]:setBgImg(PathTool.getResFrame("awaken_skill", "awaken_skill_10"))
                        end
                    end
                end
            end
        end
        addRedPointToNodeByStatus(self.tree_hero_camp,hero_camp_rp,5,5)

        local skill_panel_pos_4 = {[1]=214,[2]=300,[3]=386,[4]=472}
        local skill_panel_pos_2 = {[1]=300,[2]=386}
        for i = 1, 4 do
            local skill_panel = self.tree_skill_panel_list[i]
            if skill_panel then
                skill_panel:setVisible(true)
                skill_panel:setPositionX(skill_panel_pos_4[i])
                if hero_star < 14 then
                    if i > 2 then
                        skill_panel:setVisible(false)
                    else
                        skill_panel:setPositionX(skill_panel_pos_2[i])
                    end
                end
            end
        end
    end
end
