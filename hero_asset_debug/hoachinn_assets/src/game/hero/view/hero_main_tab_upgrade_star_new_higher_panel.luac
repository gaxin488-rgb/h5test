function HeroMainTabUpgradeStarNewHigherPanel:onClickBtnLook()
    controller:openHeroStarupLookCostHelpPanel(true,self.hero_vo,true)
end
function HeroMainTabUpgradeStarNewHigherPanel:checkUpdateCurrentInfo(is_not_check)
        self:updataInfo(self.hero_vo)
end
function HeroMainTabUpgradeStarNewHigherPanel:setRedPoint(hero_vo)
    local star_rank = 0
    for i=1,4 do
        if hero_vo.star_step < i then
            star_rank = star_rank + 1
            -- if not HeroModel:checkStarStepCompleteByIndex(hero_vo, star_rank) then
            if hero_vo.star_step < star_rank then
                if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
                    addRedPointToNodeByStatus(self.up_btn,false)
                else
                    addRedPointToNodeByStatus(self.up_btn,HeroCalculate.getHeroUpRed(hero_vo,star_rank),10,15)
                end
            else
                addRedPointToNodeByStatus(self.up_btn,false)
            end
            break
        else
            star_rank = i
        end
    end
    if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
        addRedPointToNodeByStatus(self.act_btn,false)
    else
        local max_star = Config.PartnerData.data_partner_max_star[self.hero_vo.bid]
        addRedPointToNodeByStatus(self.act_btn,self.hero_vo.star >= 13 and self.hero_vo.star_step >= 4 and self.hero_vo.star < max_star)
    end
    local star_rank = 0
    for i=1,2 do
        if hero_vo.star_step < i then
            star_rank = star_rank + 1
            -- if not HeroModel:checkStarStepCompleteByIndex(hero_vo, star_rank) then
            if hero_vo.star_step < star_rank then
                if self.hero_vo:isUpStarTreeHero() then
                    addRedPointToNodeByStatus(self.tree_up_btn,HeroCalculate.getSpTreeHeroUpRed(hero_vo,star_rank),10,15)
                else
                    addRedPointToNodeByStatus(self.tree_up_btn,false)
                end
            else
                addRedPointToNodeByStatus(self.tree_up_btn,false)
            end
            break
        else
            star_rank = i
        end
    end
    if self.hero_vo:isUpStarTreeHero() then
        local max_star = Config.PartnerData.data_partner_max_star[self.hero_vo.bid]
        addRedPointToNodeByStatus(self.tree_act_btn,self.hero_vo.star >= 13 and self.hero_vo.star_step >= 2 and self.hero_vo.star < max_star)
    else
        addRedPointToNodeByStatus(self.tree_act_btn,false)
    end
end
function HeroMainTabUpgradeStarNewHigherPanel:onClickBtnStar(param, sender, event_type)
    if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
        message(TI18N("语言_c_6039"))
        return
    end
    local data = {
        star_rank = self.hero_vo.star_step+1,
        hero_vo = self.hero_vo,
        page_index = self.page_index,
    }
    -- print("...self.cfg.score",self.cfg.score)
    -- print("self.hero_vo.star",self.hero_vo.star)
    if self.hero_vo.score == 9 and self.hero_vo.star == 15 then
        controller:openSpStar15to17Panel(true, data)
    else
        controller:openHeroUpgradeNewStarHigherPanel(true, data)
    end
end
function HeroMainTabUpgradeStarNewHigherPanel:onClickSpBtnStar(param, sender, event_type)
    local data = {
        star_rank = self.hero_vo.star_step+1,
        hero_vo = self.hero_vo,
        page_index = self.page_index,
    }
    if self.hero_vo.score == 9 and self.hero_vo.star == 15 then
        controller:openSpStar15to17Panel(true, data)
    else
        controller:openHeroUpgradeNewStarHigherPanel(true, data)
    end
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickBtnAct(param, sender, event_type)
    if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
        message(TI18N("语言_c_6280"))
        return
    end
    controller:sender11029(self.hero_vo.id)
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickSpBtnAct(param, sender, event_type)
    if model:getTreeCanUp(self.hero_vo) then
        controller:sender11439(self.hero_vo.id)
    else
        message(TI18N("语言_c_6786"))
        return
    end
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickOpenAwaker(index)
    local select_index = index or 1
   controller:openHeroAwakerSkillPanel(true,{hero_vo = self.hero_vo,choose_index = select_index,show_model_type = HeroConst.BagTab.eBagHero})
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickOpenAwakerByBtn()
    local config = Config.PartnerAwakenSkillData.data_const
    if config and self.hero_vo then
        if self.hero_vo.star >= 15 then
            -- local roller_cfg = Config.ProhibitedScrollData.data_get_constant
            -- local task_list = roller_cfg.scroll_automatic_activation.val
            -- local roller_id = nil
            -- if self.hero_vo.star == 15 then
            --     local task = task_list[1]
            --     roller_id = task[1]
            -- elseif self.hero_vo.star >= 16 then
            --     local task = task_list[1]
            --     roller_id = task[1]
            -- end
            -- if not roller_id then
            --     return
            -- end
            -- local roller_data = RollerController:getInstance():getModel():getRollerDataById(roller_id)
            -- if roller_data then
            --     RollerController:getInstance():openRollerInfoWindow(true,1,roller_id)
            -- else
            --     local setting = {roller_id=roller_id,partner_id=nil,open_type=TRUE}
            --     RollerController:getInstance():openRollerChipTipsWindow(true,setting)
            -- end
        else
            local hero_star = self.hero_vo.star
            local hero_star_step = self.hero_vo.star_step
            local camp_lv = config["awaken_position_star_lv1"]["val"]
            local camp_needstep = camp_lv[2]
            local camp_needstar = camp_lv[1]
            controller:openHeroAwakerSkillPanel(true,{hero_vo = self.hero_vo,choose_index = 1,show_model_type = HeroConst.BagTab.eBagHero})
        end
    end
end

function HeroMainTabUpgradeStarNewHigherPanel:onClickBtnDes()
    controller:openHeroMainTabUpgradeStarHigherAttrtips(true, {hero_vo = self.hero_vo,index = self.page_index})
end

function HeroMainTabUpgradeStarNewHigherPanel:updataCampIcon()
    if self.hero_vo.star >= 15 then
        self.star_ur_bg:setVisible(true)
        for k, v in pairs(self.skill_panel_list) do
            v:setVisible(false)
        end
        self.up_btn:setPositionX(340)
        self.act_btn:setPositionX(340)
        loadSpriteTexture(self.hero_camp_light,PathTool.getResFrame("hero_star", "hero_star_ur"),LOADTEXT_TYPE_PLIST) 
        self.hero_camp:loadTexture(PathTool.getPlistImgForDownLoad("hero", "txt_cn_hero_star_ur"),LOADTEXT_TYPE)--(PathTool.getResFrame("hero", "txt_cn_hero_star_ur"), LOADTEXT_TYPE)
        self.hero_camp:ignoreContentAdaptWithSize(true)
        self.hero_camp.camp_txt:setVisible(false)
        if self.hero_vo.score == 9 then
            self.hero_camp:loadTexture(PathTool.getPlistImgForDownLoad("hero", "txt_cn_hero_star_sp"),LOADTEXT_TYPE)
            self.hero_camp:ignoreContentAdaptWithSize(true)
        end

        for k, v in pairs(self.star_txt_list) do
            local init_y = v.init_y
            v:setPositionY(init_y-5)
            v:setTextColor(cc.c4b(0xf1, 0xe2, 0xc7, 0xff))
            v:setString(string_format(" "..TI18N("语言_c_3041"), k).." ")
        end
        if self.look_txt then
            self.look_txt:setFontColor(cc.c3b(0x08, 0xe9, 0x08))
            self.look_txt:setString(TI18N("语言_c_6875").." ")
        end

        addRedPointToNodeByStatus(self.hero_camp,false)
        self.hero_camp:setTouchEnabled(false)

    else
        loadSpriteTexture(self.hero_camp_light,PathTool.getResFrame("hero_star", "hero_star_14"),LOADTEXT_TYPE_PLIST) 
        self.hero_camp:loadTexture(PathTool.getResFrame("hero_star", "hero_star_12"), LOADTEXT_TYPE_PLIST)
        self.hero_camp:ignoreContentAdaptWithSize(true)
        self.hero_camp.camp_txt:setVisible(true)
        self.up_btn:setPositionX(606)
        self.act_btn:setPositionX(606)

        local hero_star = self.hero_vo.star
        for i = 1, 4 do
            local skill_panel = self.skill_panel_list[i]
            if skill_panel then
                skill_panel:setVisible(true)
                if hero_star < 14 then
                    if i > 2 then
                        skill_panel:setVisible(false)
                    end
                end
            end
        end
        for k, v in pairs(self.star_txt_list) do
            local init_y = v.init_y
            v:setPositionY(init_y)
            v:setColor(cc.c4b(0x7c, 0x55, 0x36, 0xff))
        end
        if self.look_txt then
            self.look_txt:setFontColor(cc.c3b(0x08, 0xe9, 0x08))
            self.look_txt:setString(TI18N("语言_c_6875"))
        end

        self.hero_camp:setTouchEnabled(true)
    end
    -- if self.hero_vo.star > 15 then
