            --     end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
            --     return
            -- end
            if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
                message(TI18N("语言_c_6039"))
                return
            end
            local data = {
                star_rank = key,
                hero_vo = self.hero_vo,
                page_index = self.page_index,
            }
            if self.hero_vo.score == 9 and self.hero_vo.star == 15 then
                controller:openSpStar15to17Panel(true, data)
            else
                controller:openHeroUpgradeNewStarHigherPanel(true, data)
            end
        end) ,false, 1)
    end
    for key, value in pairs(self.upgraded) do
        registerButtonEventListener(value, handler(self, function()
            -- if self.hero_vo:isUpStarTreeHero() then
            --     local str = TI18N("是否前往升星神树下树")
            --     CommonAlert.show( str, TI18N("语言_c_63"), function()
            --         MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.main_scene)
            --         HeroController:getInstance():openHeroResonateWindow(true,HeroConst.ResonateType.eResonateStar)
            --     end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
            --     return
            -- end
            if self.hero_vo.resonate_star and self.hero_vo.resonate_star ~= 0 then
                message(TI18N("语言_c_6039"))
                return
            end
            local data = {
                star_rank = key,
                hero_vo = self.hero_vo,
                page_index = self.page_index,
            }
            if self.hero_vo.score == 9 and self.hero_vo.star == 15 then
                controller:openSpStar15to17Panel(true, data)
            else
                controller:openHeroUpgradeNewStarHigherPanel(true, data)
            end
        end) ,false, 1)
    end
    for key, value in pairs(self.tree_not_upgraded) do
        registerButtonEventListener(value, handler(self, function()
            -- if not self.hero_vo:isUpStarTreeHero() then
            --     local str = TI18N("是否前往升星神树上树")
            --     CommonAlert.show( str, TI18N("语言_c_63"), function()
            --         MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.main_scene)
            --         HeroController:getInstance():openHeroResonateWindow(true,HeroConst.ResonateType.eResonateStar)
            --     end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
