-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      大神推荐页面
-- <br/> 2020-03-18
-- --------------------------------------------------------------------
HeroCollocationWindow = HeroCollocationWindow or BaseClass(BaseView)

local _controller = HeroController:getInstance()
local _model = _controller:getModel()

function HeroCollocationWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big   
    self.layout_name = "hero/hero_collocation_window"
end

function HeroCollocationWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")

    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)
    self.panel_bg = self.main_container:getChildByName("panel_bg")
    self.Image_2 = self.main_container:getChildByName("Image_2")
    self.win_title = self.Image_2:getChildByName("win_title")
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.Panel_1 = self.main_container:getChildByName("Panel_1")
    self.tab_view = self.main_container:getChildByName("tab_view")
    -- self.tab_1 = self.tab_view:getChildByName("tab_1")
    -- self.select_1 = self.tab_1:getChildByName("select")
    -- self.normal_1 = self.tab_1:getChildByName("normal")
    -- self.name_1 = self.tab_1:getChildByName("name")
    -- self.tab_2 = self.tab_view:getChildByName("tab_2")
    -- self.select_2 = self.tab_2:getChildByName("select")
    -- self.normal_2 = self.tab_2:getChildByName("normal")
    -- self.name_2 = self.tab_2:getChildByName("name")
    -- self.tab_3 = self.tab_view:getChildByName("tab_3")
    -- self.select_3 = self.tab_3:getChildByName("select")
    -- self.normal_3 = self.tab_3:getChildByName("normal")
    -- self.name_3 = self.tab_3:getChildByName("name")

    self.win_title:setString(TI18N("语言_c_5223"))
    _w = math.max(self.win_title:getContentSize().width + 100, self.Image_2:getContentSize().width)
    self.Image_2:setContentSize(cc.size(_w,self.Image_2:getContentSize().height))
    self.win_title:setPositionX(self.Image_2:getContentSize().width / 2)
    -- self.name_1:setString(TI18N("顶级玩家"))
    -- self.name_2:setString(TI18N("阵容推荐"))
    -- self.name_3:setString(TI18N("评论"))
    
    self.btn_list = {}
    -- table.insert(self.btn_list,self.tab_1)    
    -- table.insert(self.btn_list,self.tab_2)    
    -- table.insert(self.btn_list,self.tab_3)    

    for i=1,3 do
        local item = {}
        item.tab = self.tab_view:getChildByName("tab_"..i)
        item.tab.select = item.tab:getChildByName("select")
        item.tab.normal = item.tab:getChildByName("normal")
        local panel = item.tab:getChildByName("panel")
        item.tab.name = panel:getChildByName("name")
        setTextSpacing(item.tab.name,-10)
        item.tab.name:setChangeScaleOffWidth(60)
        table.insert(self.btn_list,i,item)    
    end
    self.btn_list[1].tab.name:setString(TI18N("语言_c_5224"))
    self.btn_list[2].tab.name:setString(TI18N("语言_c_5225"))
    self.btn_list[3].tab.name:setString(TI18N("语言_c_1270"))
end

function HeroCollocationWindow:register_event()
    registerButtonEventListener(self.background,function()
        self:onClickBtnClose()
    end,false, 1)
    registerButtonEventListener(self.close_btn,function()
        self:onClickBtnClose()
    end,false, 1)
    for key, value in pairs(self.btn_list) do
        registerButtonEventListener(value.tab,function()
            self:onTabBtn(key)
        end,false, 1)
    end
end
--切换页签
function HeroCollocationWindow:onTabBtn(index)
    self:setData(self.hero_vo,index)
end
--关闭
function HeroCollocationWindow:onClickBtnClose()
    _controller:openHeroCollocationWindow(false)
end


function HeroCollocationWindow:openRootWnd(hero_vo,index)
    self.hero_vo = hero_vo
    self:setData(hero_vo,index)
end

function HeroCollocationWindow:setData(hero_vo,inde)
    local index = inde or 1
    if index == HeroConst.Recommend.topLevel then
        if not self.hero_recommend_window then
            self.hero_recommend_window = HeroRecommendWindow.new(hero_vo)
            self.Panel_1:addChild(self.hero_recommend_window)
        end
        if self.hero_lineup_window then
            self.hero_lineup_window:setVisible(false)
        end
        if self.hero_comment_window then
            self.hero_comment_window:setVisible(false)
        end
        self.hero_recommend_window:setVisible(true)
    elseif index == HeroConst.Recommend.lineup then
        if not self.hero_lineup_window then
            self.hero_lineup_window = HeroLineupWindow.new(hero_vo)
            self.Panel_1:addChild(self.hero_lineup_window)
        end
        if self.hero_recommend_window then
            self.hero_recommend_window:setVisible(false)
        end
        if self.hero_comment_window then
            self.hero_comment_window:setVisible(false)
        end
        self.hero_lineup_window:setVisible(true)
    elseif index == HeroConst.Recommend.comment then
        if not self.hero_comment_window then
            self.hero_comment_window = HeroCommentWindow.new(hero_vo)
            self.Panel_1:addChild(self.hero_comment_window)
        end
        if self.hero_recommend_window then
            self.hero_recommend_window:setVisible(false)
        end
        if self.hero_lineup_window then
            self.hero_lineup_window:setVisible(false)
        end
        self.hero_comment_window:setVisible(true)
        self.hero_comment_window:setPositionY(-40)
    end
    for key, value in pairs(self.btn_list) do
        if key == index then
            value.tab.select:setVisible(false)
            value.tab.normal:setVisible(true)
            value.tab.name:setTextColor(cc.c4b(0xf8,0xef,0x76,0xff))
            value.tab.name:enableOutline(cc.c4b(0x5c,0x27,0x05,0xff))
        else
            value.tab.select:setVisible(true)
            value.tab.normal:setVisible(false)
            value.tab.name:setTextColor(cc.c4b(0x92,0xb1,0xdc,0xff))
            value.tab.name:enableOutline(cc.c4b(0x34,0x4c,0x5f,0xff))
        end
    end
end
function HeroCollocationWindow:close_callback()
    -- doStopAllActions(self.main_container)
    -- self.hero_collocation_window:close()
    -- self.hero_collocation_window = nil
    if self.hero_lineup_window then
        self.hero_lineup_window:DeleteMe()
        self.hero_lineup_window = nil
    end
    if self.hero_recommend_window then
        self.hero_recommend_window:DeleteMe()
        self.hero_lineup_window = nil
    end
    if self.hero_comment_window then
        self.hero_comment_window:DeleteMe()
        self.hero_comment_window = nil
    end
    _controller:openHeroCollocationWindow(false)
end