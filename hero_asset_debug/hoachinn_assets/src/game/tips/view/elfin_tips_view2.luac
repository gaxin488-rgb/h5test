function ElfinTipsView2:close_callback(  )
	if self.power_label then
        self.power_label:DeleteMe()
        self.power_label = nil
	end
	
	if self.elfin_item then
		self.elfin_item:DeleteMe()
		self.elfin_item = nil
	end
	if self.item_scrollview then
		self.item_scrollview:DeleteMe()
		self.item_scrollview = nil
	end
	ElfinController:getInstance():openElfinView2Window(false)
end


ElfinTipsView2Item = class("ElfinTipsView2Item", function() 
	return ccui.Layout:create()
end)

function ElfinTipsView2Item:ctor()
	self.base_list = {}
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("tips/elfin_tips_view_item2"))
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
	self:setContentSize(self.size)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)

	self.main_container = self.root_wnd:getChildByName("main_container")
	self.bg = self.main_container:getChildByName("bg")
	self.bg:setVisible(false)
	self.attr_tltle = self.main_container:getChildByName("attr_tltle")
	self.tag = self.main_container:getChildByName("tag")
	local tag_pos = self.tag:getPositionX()
	self.attr_tltle:setPositionX(tag_pos-4)
	self.tag:setVisible(false)
	self.lv_txt = self.main_container:getChildByName("lv_txt")
end

function ElfinTipsView2Item:setData(data)
	self.data = data
	-- {id = v, socre = _temp.socre, elfin_bid = elfin_bid}
	local elfin_item_cfg = Config.ItemData.data_get_data(data.id)
	local star = elfin_item_cfg.eqm_jie
	self.lv_txt:setString(string.format(TI18N("语言_spr_01_17"), elfin_item_cfg.name, star)) --(elfin_item_cfg.name..star.."星")
	self.attr_tltle:setString(TI18N("语言_spr_01_16")..(data.socre or 0))

	if data.id == data.elfin_bid and data.is_active then
		self.bg:setVisible(true)
		self.tag:setVisible(true)
	else
		self.bg:setVisible(false)
		self.tag:setVisible(false)
	end
end

function ElfinTipsView2Item:DeleteMe()
	self:removeAllChildren()
    self:removeFromParent()
end
