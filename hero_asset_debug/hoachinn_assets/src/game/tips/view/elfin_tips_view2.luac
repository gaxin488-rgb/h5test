ElfinTipsView2 = ElfinTipsView2 or BaseClass(BaseView)

local _string_format = string.format
local _controller = ElfinController:getInstance()
local _table_insert = table.insert

function ElfinTipsView2:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "tips/elfin_tips_view2"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }
	self.show_index = 0
	self.base_list = {}
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end

function ElfinTipsView2:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.container = self.root_wnd:getChildByName("container")
    self.title = self.container:getChildByName("title")
	self.title:setString(TI18N("语言_spr_01_15"))
	self.base_attr = self.container:getChildByName("base_attr")

end

function ElfinTipsView2:createNewCell(width, height)
    local cell = ElfinTipsView2Item.new()
    return cell
end

function ElfinTipsView2:numberOfCells()
    if not self.cell_data_list then
        return 0
    end
    return #self.cell_data_list
end
-- 更新cell(拖动的时候.刷新数据时候会执行次方法)
-- cell :createNewCell的返回的对象
-- index :数据的索引
function ElfinTipsView2:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.cell_data_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data)
end

function ElfinTipsView2:register_event(  )
	registerButtonEventListener(self.background, function (  )
		self:close()
	end, false, 2)
end

function ElfinTipsView2:openRootWnd(elfin_bid)
	if not elfin_bid then return end
	--判断是哪一系列通灵兽
	local elfin_list_cfg = Config.SpriteData.data_sprite_list
	for k, v in pairs(elfin_list_cfg) do
		local list = v.id_list[1]
		for k, v in pairs(list) do
			if elfin_bid == v then
				self.show_list = deepCopy(list) 
				break
			end
		end
	end
	local function sortFunc( objA, objB )
		return objA < objB
	end
	table.sort(self.show_list, sortFunc)
	self.is_active = false
	for k, v in pairs(self.show_list) do
		local id = v
		local status = ElfinController:getInstance():getModel():checkElfinActStatus(id)
		if status then
			self.is_active = true
			break
		end
	end
	local cfg = Config.SpriteData.data_sprite_score
	self.cell_data_list = {}
	for k, v in pairs(self.show_list) do
		local _temp = cfg[v]
		if _temp then
			local a = {id = v, socre = _temp.score, elfin_bid = elfin_bid,is_active = self.is_active}
			table.insert(self.cell_data_list, a)
		end
	end

	local num = #self.cell_data_list
	local total_hight = num*40 + 90 + 40
	self.container:setContentSize(cc.size(590, total_hight))
	self.base_attr:setContentSize(cc.size(590, num*40))
	self.base_attr:setPositionY(num*40 + 40)
	self.title:setPositionY(total_hight-45)

	if self.item_scrollview == nil then
        local scroll_view_size = self.base_attr:getContentSize()
        local setting = {
            start_x = 0, -- 第一个单元的X起点
            space_x = 0, -- x方向的间隔
            start_y = 0, -- 第一个单元的Y起点
            space_y = 0, -- y方向的间隔
            item_width = 580, -- 单元的尺寸width
            item_height = 40, -- 单元的尺寸height
			col = 1,
            once_num = 1 -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(self.base_attr, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.createNewCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.numberOfCells), ScrollViewFuncType.NumberOfCells) -- 获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self, self.updateCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    end
	self.item_scrollview:reloadData()
end

