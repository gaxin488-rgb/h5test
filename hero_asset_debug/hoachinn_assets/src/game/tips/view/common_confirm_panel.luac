CommonConfirmPanel = CommonConfirmPanel or BaseClass(BaseView) 

local string_format = string.format

function CommonConfirmPanel:__init( ... )
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "common/common_confirm_panel"
    self.res_list = {
        --{ path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end 

function CommonConfirmPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.item_panel = self.main_panel:getChildByName("item_panel")          
    self.item_list_panel = self.item_panel:getChildByName("item_list")  
    local size = self.item_list_panel:getContentSize()
    self.item_scroll_view = createScrollView(size.width, size.height, 0, 0, self.item_list_panel, ccui.ScrollViewDir.horizontal) 
    -- self.item_scroll_view:setInnerContainerSize(cc.size(max_width, panel_size.height+over_height))

    self.title_container = self.main_panel:getChildByName("title_container")
    self.Image_1_0 = self.title_container:getChildByName("Image_1_0")
    self.title_label = self.title_container:getChildByName("title_label")

    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.label_des = self.main_panel:getChildByName("label_des")
    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_btn.label = self.ok_btn:getChildByName("label")
    self.ok_btn.label:setString(TI18N("语言_c_63"))
end

function CommonConfirmPanel:register_event(  )
	if self.background then 
        self.background:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                self:close()
            end
        end)
    end
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self:close()
        end
    end)
    self.ok_btn:addTouchEventListener(function(sender, event_type)
        customClickAction_2(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            if self.confirm_callback then
                self:confirm_callback()
            end
            self:close()
        end
    end)
end

function CommonConfirmPanel:setData( data )
    self.confirm_callback = data.confirm_callback
    if self.item_list and next(self.item_list) ~= nil then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list = {}
    self.title_label:setString(data.title_str)
    self.label_des:setString(data.des_str)
    local scale = 1
    local start_x = 2
    local off = 6
    local _x, _y = 0, self.item_scroll_view:getContentSize().height/2
    for i, v in ipairs(data.rewards or {}) do
        if (v[1] and v[2]) or (v.bid and v.num) then
            local bid = v[1] or v.bid
            local num = v[2] or v.num
            local item_conf = Config.ItemData.data_get_data(bid)
            if item_conf then
                local item = BackPackItem.new(false, true, false, scale, false, true)
                _x = start_x + (BackPackItem.Width * scale + off) * (i-1) + BackPackItem.Width*scale*0.5
                item:setBaseData(bid, num)
                item:setDefaultTip(true)
                item:setPosition(_x, _y)
                self.item_scroll_view:addChild(item)
                table.insert(self.item_list, item)
            end
        end
    end 
end

function CommonConfirmPanel:openRootWnd( data )
	self:setData(data)
end

function CommonConfirmPanel:close_callback(  )
    if self.item_list and next(self.item_list) ~= nil then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = {}
    end
end