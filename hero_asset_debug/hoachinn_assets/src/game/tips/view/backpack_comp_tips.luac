-- --------------------------------------------------------------------
--背包物品合成
-- --------------------------------------------------------------------
BackpackCompTips = BackpackCompTips or BaseClass(BaseView)

local partner_data = Config.PartnerData.data_get_compound_info
function BackpackCompTips:__init()
    self.ctrl = BackpackController:getInstance()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "tips/backpack_comp_tips"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }

    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
end

function BackpackCompTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self.main_panel_size = self.main_panel:getContentSize()
    self.text_name = self.main_panel:getChildByName("text_name")
    self.get_path = self.main_panel:getChildByName("get_path")
    self.get_path:setVisible(false)
    self.hero_layout = self.main_panel:getChildByName("hero_layout")
    self.hero_layout:setVisible(false)
    self.station_img = self.hero_layout:getChildByName("station_img")
    self.get_path:getChildByName("Text_2"):setString(TI18N("语言_c_970"))
    self.goto_btn = self.get_path:getChildByName("goto")
    self.text_desc = self.main_panel:getChildByName("text_desc")
    
    self.equip_type = self.main_panel:getChildByName("equip_type")
    self.equip_type:setString("")
    self.score_image = self.equip_type:getChildByName("score_image")

    -- 描述部分
    self.desc_panel = self.main_panel:getChildByName("desc_panel")
    self.desc_panel_size = self.desc_panel:getContentSize()
    self.scroll_view = self.desc_panel:getChildByName("scroll_view")
    self.scroll_view:setScrollBarEnabled(false)
    self.scroll_size = self.scroll_view:getContentSize()
    self.desc_label = createRichLabel(22, cc.c4b(0xa1,0x97,0x8b,0xff), cc.p(0, 1), cc.p(46, self.scroll_size.height), 8, nil, 520) 
    self.scroll_view:addChild(self.desc_label)

    self.goods_item =  BackPackItem.new(true,true,nil,1,false)
    self.goods_item:setPosition(cc.p(113,258))
    self.main_panel:addChild(self.goods_item)

end

function BackpackCompTips:register_event()
    registerButtonEventListener(self.background, function()
        self:close()
        TipsManager:getInstance():showBackPackCompTips(false)
    end,false, 2)

    registerButtonEventListener(self.goto_btn, function()
        if self.item_config then
            BackpackController:getInstance():openTipsSource(true, self.item_config.id)
            TipsManager:getInstance():showBackPackCompTips(false)
        end
    end, true, 1)
end

function BackpackCompTips:openRootWnd(item_bid,isgood,is_hero)
    if not item_bid then return end
    self.isgood = isgood
    local config = Config.ItemData.data_get_data(item_bid)
    
    local btn_num = 1
    if is_hero == true then
        self.is_hero = is_hero
        btn_num = 2
    else
        if partner_data[config.id] then
            local random = partner_data[config.id].is_random
            if random == 1 then
                btn_num = 2
                self.get_path:setVisible(false)
            else
                self.get_path:setVisible(true)
            end
        else
            --符文
            local hallows_data = BackpackController:getModel():getHallowsCompData(config.id)
            if hallows_data then
                self.get_path:setVisible(true)
            end
        end
    end

    self.item_config = config
    self:showBtn(btn_num)
    self:setBaseInfo()

    
    local moveY = 0
    if self.isgood then
        moveY = -60
        if self.btn_1 then
            self.btn_1:setVisible(false)
        end
        if self.btn_2 then
            self.btn_2:setVisible(false)
        end
    end
    if self.item_config.sub_type == BackPackConst.item_tab_type.HERO and self.item_config.type == BackPackConst.item_type.PARTNER_DEBRIS then
        self:showChipIcon(true)
    else
    end

    -- 调整位置
    local pos_desH = self.desc_label:getContentSize().height
    if pos_desH >= self.scroll_size.height then
        self.desc_label:setPositionY(pos_desH)
        self.scroll_view:setInnerContainerSize(cc.size(self.scroll_size.width, pos_desH))
        pos_desH = self.scroll_size.height
    end
    self.main_height = self.main_height + pos_desH + 20

    self.main_height = self.main_height + moveY
    self.main_panel:setContentSize(cc.size(self.main_panel_size.width, self.main_height))
    self.text_name:setPositionY(self.main_height - 44)
    self.get_path:setPositionY(self.main_height - 130)
    self.text_desc:setPositionY(self.main_height - 196)
    self.goods_item:setPositionY(self.main_height - 87)
    self.equip_type:setPositionY(self.main_height - 83)
    self.desc_panel:setPositionY(self.main_height - 205)
    if self.isgood then
        self.hero_layout:setPositionY(190 + moveY)
    else
        self.hero_layout:setPositionY(190 + moveY)
    end  
    if self.hero_chip_icon then
        local equip_type_size = self.equip_type:getContentSize()
        self.hero_chip_icon:setPosition(self.equip_type:getPositionX() + equip_type_size.width+20,self.main_height - 83)
    end
end

function BackpackCompTips:showChipIcon(status)
    if status then
        if self.hero_chip_icon == nil then
            local res = PathTool.getResFrame("common","common_90055")
            self.hero_chip_icon = createSprite(res, HeroExhibitionItem.Width - 20 , HeroExhibitionItem.Height - 20, self.main_panel, cc.p(0.5, 0.5), LOADTEXT_TYPE_PLIST, 1)
        else
            self.hero_chip_icon:setVisible(true)
        end
    else
        if self.hero_chip_icon then
            self.hero_chip_icon:setVisible(false) 
        end
    end
end

--显示按钮个数
function BackpackCompTips:showBtn(num)
    self.main_height = self.main_panel_size.height
    local pos = num == 1 and self.main_panel:getContentSize().width/2 or (self.main_panel:getContentSize().width/2 + 120)
    local btn = createButton(self.main_panel,TI18N("语言_c_976"),pos,60,cc.size(129,64),PathTool.getResFrame("common","common_1017"),24,Config.ColorData.data_color4[1])
    btn:setName("com_btn")
    btn:setRichText(TI18N("语言_c_1726"))
    btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            local item_data = BackpackController:getModel():getBackPackItemNumByBid(self.item_config.id)
            local num = 1
            local status = false
            local product_id 
            if partner_data[self.item_config.id] then
                product_id = self.item_config.id
                local comp_num = partner_data[self.item_config.id].num
                num = math.floor(item_data/comp_num)
                status = true
            else
                local hallows_data = BackpackController:getModel():getHallowsCompData(self.item_config.id)
                product_id = hallows_data.bid
                num = math.floor(item_data/hallows_data.num)
            end

            if num >= 2 then
                if status == true then
                    TipsManager:getInstance():showCompChooseTips(true,self.item_config.id)
                else
                    BackpackController:getInstance():sender10523(product_id, 1)
                end
            else
                if num ~= 0 then
                    if status == true then
                        BackpackController:getInstance():sender11008(self.item_config.id, 1)
                    else
                        BackpackController:getInstance():sender10523(product_id, 1)
                    end
                else
                    message(TI18N("语言_c_280"))
                end 
            end
        end
    end)
    self.btn_1 = btn
    if num == 2 then
        local btn1 = createButton(self.main_panel,TI18N("语言_c_295"),self.main_panel:getContentSize().width/2 - 120,60,cc.size(129,64),PathTool.getResFrame("common","common_1017"),24,Config.ColorData.data_color4[1])
        btn1:setRichText(TI18N("语言_c_1727"))
        btn1:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                if self.item_config.effect and self.item_config.effect[1].val and self.item_config.eqm_jie then
                    TipsManager:getInstance():showBackPackCompTips(false)
                    HeroController:getInstance():openHeroInfoWindowByBidStar(self.item_config.effect[1].val, self.item_config.eqm_jie)
                end
            end
        end)
        if self.item_config.effect and self.item_config.effect[1].val and self.item_config.eqm_jie then
            self:ShowHeroSpine()
            self.main_height = self.main_height + 360
        end
        self.btn_2 = btn1
    end
end

--==============================--
function BackpackCompTips:setBaseInfo()
    if self.item_config == nil then return end

    self.goods_item:setBaseData(self.item_config.id)
    self.text_name:setString(self.item_config.name)
    self.text_desc:setString(self.item_config.use_desc)
    self.equip_type:setString(TI18N("语言_c_1728")..self.item_config.type_desc)
    local score
    if self.item_config.effect[1] then
        if self.item_config.effect[1] and type(self.item_config.effect[1].val) ~= "table" then
            score = HeroModel:heroBidScore(self.item_config.effect[1].val)
        else
            score = HeroModel:heroBidScore(self.item_config.effect[1].val[1])
        end
        local path = string.format("partner_rarity_%s", score)
        local src =  PathTool.getResFrame('partnersummon', path,false)
        self.score_image:loadTexture(src,LOADTEXT_TYPE_PLIST)
    else
        self.score_image:setVisible(false)
    end
    -- 描述
    self.desc_label:setString(self.item_config.desc)
end

function BackpackCompTips:close_callback()
    if self.goods_item then 
        self.goods_item:DeleteMe()
    end
    self.goods_item = nil
    if self.spine then
        doStopAllActions(self.spine)
        self.spine:removeFromParent()
        self.spine = nil
    end

    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    TipsManager:getInstance():showBackPackCompTips(false)
end

function BackpackCompTips:ShowHeroSpine()
    local bid
    if self.is_hero and self.is_hero == true then
        bid = self.item_config.effect[1].val[1]
    else
        bid = self.item_config.effect[1].val
    end
    local star = self.item_config.eqm_jie
    if not bid or not star then return end
    local key = getNorKey(bid,star)
    local hero_vo = HeroController:getInstance().model:getHeroPokedexByBid(key)
    if hero_vo then
        self:updateSpine(hero_vo)
        self.hero_layout:setVisible(true)
            --站台
        local station_res = PathTool.getPlistImgForDownLoad("bigbg/hero","hero_skin_tips", false)
        if self.record_station_res == nil or self.record_station_res ~= station_res then
            self.record_station_res = station_res
            self.item_load = loadSpriteTextureFromCDN(self.station_img, station_res, ResourcesType.single, self.item_load) 
        end
    end
end


--==================碎片显示角色=======================
--更新模型,也是初始化模型
--@is_refresh  是否需要检测
function BackpackCompTips:updateSpine(hero_vo)
    local fun = function()    
        if not self.spine then
            self.spine = BaseRole.new(BaseRole.type.partner, hero_vo, nil, {scale = 0.75, skin_id = hero_vo.use_skin})
            self.spine:setAnimation(0,PlayerAction.show,true) 
            self.spine:setCascade(true)
            self.spine:setPosition(cc.p(24,196))
            self.spine:setAnchorPoint(cc.p(0.5,0.5)) 
            -- self.spine:setScale(1)
            self.hero_layout:addChild(self.spine) 
            self.spine:setCascade(true)
            self.spine:setOpacity(0)
            self.spine:showShadowUI(true)
            local action = cc.FadeIn:create(0.2)
            self.spine:runAction(action)
        end
    end
    if self.spine then
        self.can_click_btn = false
        self.spine:setCascade(true)
        local action = cc.FadeOut:create(0.2)
        self.spine:runAction(cc.Sequence:create(action, cc.CallFunc:create(function()
                doStopAllActions(self.spine)
                self.spine:removeFromParent()
                self.spine = nil
                self.can_click_btn = true
                fun()
        end)))
    else
        fun()
    end
end
