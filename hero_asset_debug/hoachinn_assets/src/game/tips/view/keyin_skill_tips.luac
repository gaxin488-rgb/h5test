-- --------------------------------------------------------------------
-- 技能tips
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------

KeyinSkillTips = KeyinSkillTips or BaseClass(BaseView) 

local string_format = string.format

function KeyinSkillTips:__init( ... )
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "tips/skill_tips"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
    self.is_sp = false
    self.page_index = 1
end

--[[
@功能:构建UI
@参数:
@返回值:
]]
function KeyinSkillTips:open_callback( ... )
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_panel = self.root_wnd:getChildByName("main_panel")

    self.container = self.main_panel:getChildByName("container")            -- 背景,需要动态设置尺寸
    self.container_init_size = self.container:getContentSize()

    self.base_panel = self.container:getChildByName("base_panel")
    self.base_panel_height = self.base_panel:getContentSize().height

    self.Sprite_3 = self.base_panel:getChildByName("Sprite_3")
    self.skill_icon = self.base_panel:getChildByName("skill_icon")
    self.skill_name = self.base_panel:getChildByName("name")
    self.skill_type = self.base_panel:getChildByName("skill_type")
    self.runic_power = createRichLabel(22,cc.c3b(0xff,0xee,0xdd),cc.p(0,1),cc.p(146,60),nil,nil,400)
    self.base_panel:addChild(self.runic_power)
    self.convert_btn = self.base_panel:getChildByName("convert_btn")
    self.convert_btn:setVisible(false)
    self.convert_txt = self.base_panel:getChildByName("convert_txt")
    self.convert_txt:setVisible(false)
    self.convert_txt:setString(TI18N("语言_c_6743"))
    self.convert_btn:setPositionX(self.convert_txt:getPositionX() + self.convert_txt:getContentSize().width+50)

    self.line = self.container:getChildByName("line")
    self.line:setVisible(false)
end

function KeyinSkillTips:register_event()
    if self.background then 
        self.background:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                KeyinController:getInstance():openKeyinSkilltipsWindow(false)
            end
        end)
    end
    if self.convert_btn then 
        self.convert_btn:addTouchEventListener(function(sender, event_type) 
            customClickAction_2(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                local index = 0
                if self.page_index == 1 or self.page_index == 0 then
                    index = 2
                else
                    index = 1
                end
                TipsManager:getInstance():showSkillTips(self.config, self.is_lock, self.not_show_next, self.hide_flag, self.fire_cd, self.hallows_atk_val, self.skill_level,index)
                self:close()
            end
        end)
    end
end

--[[
@功能:设置技能信息
@参数:Config.Skill   ,  Config.RoleCareerSkill
@返回值:
]]
--原版技能tips
function KeyinSkillTips:updateVo( skill_vo )
    self.skill_vo = skill_vo
    local level = skill_vo.level or 1
    local skill_level = skill_level or 0
    if skill_vo.client_lev and skill_vo.client_lev>0 then
        level = skill_vo.client_lev
    end
	-- 技能名字
    if not hide_flag then
        if skill_level == 0 then
            self.skill_name:setString(string.format(TI18N("语言_c_4726"),skill_vo.name,level))
        else
            self.skill_name:setString(string.format(TI18N("语言_c_4726"),skill_vo.name,level)..string.format(TI18N("语言_c_5873"),StringUtil.numToRoman(skill_level)))
        end
    else
        self.skill_name:setString(skill_vo.name)
    end
    self.skill_name:ignoreContentAdaptWithSize(true)
    self.skill_name:setTextAreaSize(cc.size(200,0))  
	-- self.skill_name:setString(skill_vo.name)
    local icon_res = self.keyin_cfg.skill_icon
    if icon_res == "" then
        icon_res = skill_vo.icon
    end
    loadSpriteTexture(self.skill_icon, PathTool.getSkillRes(icon_res), LOADTEXT_TYPE) 
    self.runic_power:setPositionY(self.skill_name:getPositionY() - self.skill_name:getContentSize().height-5)

    self.skill_type:setVisible(true)
    if skill_vo.type == "active_skill" then 
        self.skill_type:setString(TI18N("语言_c_1729"))
    else 
        self.skill_type:setString(TI18N("语言_c_1730")) 
    end

    local scrollmax = 500
    local total_max = 650
    local total_width = 422
    self.skill_scroll = createScrollView(total_width,scrollmax,0,0,self.container,ccui.ScrollViewDir.vertical)
	self.skill_scroll:setTouchEnabled(true)

    -- 统计最大高度
    local total_height = 4 + self.base_panel_height + 20

    local skill_des_height = 0
    local _str = self.keyin_cfg.skill_desc
    if _str == "" then
        if self.skill_vo.des ~= "" then
            if self.skill_desc == nil then
                self.skill_desc = createRichLabel(22,cc.c4b(0xfe,0xee,0xba,0xff),cc.p(0,1),cc.p(22,10),0,nil,370)
                self.skill_scroll:addChild(self.skill_desc)
            end
            if self.skill_vo.hallows_atk and self.skill_vo.hallows_atk > 0 then
                local skill_atk_val = self.skill_vo.hallows_atk
                local total_atk_val = skill_atk_val
                local str = string.format(self.skill_vo.des, total_atk_val)
                self.skill_desc:setString(str)
            else
                self.skill_desc:setString(self.skill_vo.des)
            end
            skill_des_height = self.skill_desc:getContentSize().height 
            total_height  = total_height + skill_des_height + 5
        end
    else
        if self.skill_desc == nil then
            self.skill_desc = createRichLabel(22,cc.c4b(0xfe,0xee,0xba,0xff),cc.p(0,1),cc.p(22,10),0,nil,370)
            self.skill_scroll:addChild(self.skill_desc)
        end
        self.skill_desc:setString(_str)
        skill_des_height = self.skill_desc:getContentSize().height 
        total_height  = total_height + skill_des_height + 5
    end

    local extend_desc_height = 0
    if self.extend_desc == nil then
        self.extend_desc = createRichLabel(22,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(22,10),nil,nil,370)
        self.skill_scroll:addChild(self.extend_desc)
    end

    local extend_str = ""
    if self.skill_vo.cd == 0 then
        extend_str = TI18N("语言_c_1731")
    else
        extend_str = string_format(TI18N("语言_c_4894"), TI18N("语言_c_1732"),self.skill_vo.cd, TI18N("语言_c_1733") )
    end
    local fire_cd = self.skill_vo.fire_cd or 0
    if fire_cd ~= 0 then
        extend_str = extend_str..string_format(TI18N("语言_c_4894"), TI18N("语言_c_1734"), fire_cd, TI18N("语言_c_1735")) 
    end
    self.extend_desc:setString(extend_str)

    extend_desc_height = self.extend_desc:getContentSize().height
    total_height  = total_height + extend_desc_height + 5

    local buff_desc_str = ""
    local buff_desc_height = 0
    local buff_list = self.keyin_cfg.buff_desc
    if not buff_list or not next(buff_list) then
        buff_list = self.skill_vo.buff_des
    end
    if buff_list ~= nil and buff_list[1] and next(buff_list[1]) then
        -- self.line:setVisible(true)
        if self.line_1 == nil then
            self.line_1 = createSprite(PathTool.getResFrame("tips","tips_8"), self.container_init_size.width/2, 0, self.skill_scroll, cc.p(0.5, 1), LOADTEXT_TYPE_PLIST)
            self.line_1:setScaleX(7.6)
        end

        local buff_config = Config.SkillData.data_get_buff
        for i, v in ipairs(buff_list[1]) do
            local config = buff_config[v]
            if config then
                if buff_desc_str ~= "" then
                    buff_desc_str = buff_desc_str.."<div fontcolor=#a1978b>\n</div>"
                end
                local buff_desc = string_format("<div fontcolor=#ffeedd>【%s】</div><div fontcolor=#a1978b>\n%s</div>", config.name, config.desc)
                buff_desc_str = buff_desc_str..buff_desc
            end
        end
    end
    if buff_desc_str ~= "" then
        if self.buff_desc == nil then
            self.buff_desc = createRichLabel(20,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(22,10),0,nil,370)
            self.skill_scroll:addChild(self.buff_desc)
        end
        self.buff_desc:setString(buff_desc_str)
        buff_desc_height = self.buff_desc:getContentSize().height
        total_height  = total_height + buff_desc_height
    end

    total_height = total_height + 10

        -- 下级解锁描述
    if self.next_unlock_desc == nil then
        self.next_unlock_desc = createRichLabel(22,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(22,10),nil,nil,370)
        self.skill_scroll:addChild(self.next_unlock_desc)
        if self.line_2 == nil then
            self.line_2 = createSprite(PathTool.getResFrame("tips","tips_8"), self.container_init_size.width/2, 0, self.skill_scroll, cc.p(0.5, 1), LOADTEXT_TYPE_PLIST)
            self.line_2:setScaleX(7.6)
        end
    end


    --[785004] = {bid=785004, group=78500, next=0, lev=4, desc=TI18N("增加忍道会，巅峰忍道会")}
    -- {id=10511, total_lv=350, unlock={{0,{785001}},{13,{785002}},{14,{785003}},{15,{785004}}}, skill_order={}},
        local star = self.keyin_info.hero_star
        local hero_bid = self.keyin_info.hero_bid
        local keyin_id = self.keyin_info.id
        local keyin_lev = self.keyin_info.lv
        local cfg = Config.PartnerEngravedData.data_get_skill
        local keyin_cfg  --cfg[key]
        for k, v in pairs(cfg) do
            if v.id == hero_bid then
                for i, val in ipairs(v.unlock) do
                    local need_star = val[1]
                    local need_skill_id = val[3][1]
                    if self.config.bid == need_skill_id then
                        keyin_cfg = v
                    end
                end
            end
        end
        local str = ""
        local lock_status = true
        if keyin_cfg.total_lv > keyin_lev then
            lock_status = false
        end
        local index = 1
        for k, v in pairs(keyin_cfg.unlock) do
            local need_star = v[1]
            local need_total_lv = v[2]
            local need_skill_id = v[3][1]
            local skii_cfg = Config.SkillData.data_get_skill(need_skill_id)
            local ski_cfg = Config.PartnerEngravedData.data_skill_desc[need_skill_id]
            if ski_cfg and ski_cfg.desc ~= "" then
                local a = string.format("[%s%s] \n",TI18N("语言_c_4967"),index)
                local b = ski_cfg.desc .."\n"
                if star >= need_star and keyin_lev >= need_total_lv and lock_status then
                    b = string.format("<div fontcolor=#00ff00>%s</div> \n",ski_cfg.desc)-- ski_cfg.desc .."\n"
                end
                local c = " \n"
                if lock_status then --已解锁
                    if need_star <= star and keyin_lev >= need_total_lv then
                    else
                            local last_skill = keyin_cfg.unlock[k-1]
                            if last_skill then
                                local last_lv_star = last_skill[1]
                                local last_lv_total_lv = last_skill[2]
                                if last_lv_star <= star and last_lv_total_lv <= keyin_lev then
                                    local _s = string.format(TI18N("语言_c_7002"), need_star)
                                    if need_total_lv ~= 0 then
                                        _s = _s .. "\n"..string.format(TI18N("语言_c_7022"), need_total_lv)
                                    end
                                    c = string.format("<div fontcolor=#ff0000>%s</div> \n \n", _s)
                                end
                            end
                        
                    end
                else
                    if index == 1 then
                        local _s = string.format(TI18N("语言_c_7002"), need_star)
                        c = string.format("<div fontcolor=#ff0000>%s</div> \n \n", _s)
                    end
                end
                index = 1 + index
                str = str .. a .. b .. c
            end

        end
        self.next_unlock_desc:setString(str)
    
        local next_unlock_desc_height = self.next_unlock_desc:getContentSize().height
        total_height = total_height + next_unlock_desc_height + 10


    local container_heigth = total_height
    if total_height > total_max then
        container_heigth = total_max
    end
    local scrollHeight = container_heigth - self.base_panel_height - 40
    self.skill_scroll:setContentSize(cc.size(total_width, scrollHeight))
    local s_info_height = math.max(scrollHeight, (total_height-self.base_panel_height)) 
	self.skill_scroll:setInnerContainerSize(cc.size(self.skill_scroll:getContentSize().width,s_info_height))

    local moveY = s_info_height
    if self.skill_desc then
        self.skill_desc:setPositionY(s_info_height)
        moveY = moveY - skill_des_height - 5
    end
    if self.extend_desc then
        self.extend_desc:setPositionY(moveY)
        moveY = moveY - extend_desc_height - 5
    end
    if self.line_1 then
        self.line_1:setPositionY(moveY)
    end
    if self.buff_desc then
        self.buff_desc:setPositionY(moveY-8)
        moveY = moveY - 8 - buff_desc_height - extend_desc_height - 5
    end

    if self.line_2 then
        self.line_2:setPositionY(moveY)
    end
    if self.next_unlock_desc then
        self.next_unlock_desc:setPositionY(moveY-8)
    end
    
    self.container:setContentSize(cc.size(self.container_init_size.width, container_heigth))
    self.base_panel:setPositionY(container_heigth-4)
    self.skill_scroll:setPositionY(container_heigth-self.base_panel_height-scrollHeight-29)
end

--[[
@功能:打开技能tips
@参数:
@返回值:
]]
function KeyinSkillTips:openRootWnd( config,keyin_info )
    self.config = config
    self.keyin_info = keyin_info
    self.keyin_cfg = Config.PartnerEngravedData.data_get_skill[getNorKey(self.keyin_info.hero_bid, self.keyin_info.total_lv)]
    self:updateVo(config)

    -- delayRun(self.root_wnd, 114, function()
    --     TipsManager:getInstance():hideTips()
    -- end)
end


function KeyinSkillTips:close_callback()
    KeyinController:getInstance():openKeyinSkilltipsWindow(false)
end
