function ElfinTipsNew:setBaseAttrInfo()
	local elfin_bid = self.show_list[self.show_index]
	local attr_cfg = Config.SpriteData.data_attr_info[elfin_bid]
    if not attr_cfg then 
		self.base_attr:setVisible(false) 
		return 0 
	end
	local attr_list = deepCopy(attr_cfg.attrs)
    local index = 1 
    local _h = math.ceil(#attr_list/2) * 40 + 55
	self.base_attr:setContentSize(cc.size(self.base_attr:getContentSize().width, _h))
	self.base_name:setPositionY(_h - 20)
    for i,v in ipairs(attr_list) do
        local attr_key = v[1]
        local attr_val = v[2]
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if attr_name then
            if not self.base_list[index] then 
                self.base_list[index] = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 28), nil, nil, 380)
                self.base_attr:addChild(self.base_list[index])
            end
            local label = self.base_list[index]
            local _x = 40 + 300 * ((i-1) % 2)
            local _y = _h - 68 - math.floor((i-1)/2)*40
            label:setPosition(cc.p(_x,_y))
            if attr_name then
                local icon = PathTool.getAttrIconByStr(attr_key)
                local is_per = PartnerCalculate.isShowPerByStr(attr_key)
                if is_per == true then
                    attr_val = (attr_val*0.1).."%"
                end
                local attr_str = string_format("<img src='%s' scale=1 /> <div fontcolor=#c1b7ab> %s：</div><div fontcolor=#ffeedd>%s</div>", PathTool.getResFrame("common", icon), attr_name, attr_val)
                label:setString(attr_str)
            end
            index = index + 1
        end
    end
	self.base_attr:setVisible(true)
    return self.base_attr:getContentSize().height
end

function ElfinTipsNew:close_callback(  )
	if self.power_label then
        self.power_label:DeleteMe()
        self.power_label = nil
	end
	
	if self.elfin_item then
		self.elfin_item:DeleteMe()
		self.elfin_item = nil
	end

	ElfinController:getInstance():openElfinOverViewWindow(false)
end