ElfinTipsNew = ElfinTipsNew or BaseClass(BaseView)

local _string_format = string.format
local _controller = ElfinController:getInstance()
local _table_insert = table.insert

function ElfinTipsNew:__init()
    self.is_full_screen = false
    self.title_str= ""
    self.layout_name = "tips/elfin_tips_new"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("tips","tips"), type = ResourcesType.plist },
    }
	self.show_index = 0
	self.base_list = {}
    self.win_type = WinType.Tips   
    self.view_tag = ViewMgrTag.DIALOGUE_TAG 
end

function ElfinTipsNew:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.container = self.root_wnd:getChildByName("container")
	
    self.close_btn = self.container:getChildByName("close_btn")
	
    self.base_panel = self.container:getChildByName("base_panel")
    self.old_con_size = self.base_panel:getContentSize()
	self.old_con_size.height = self.old_con_size.height + 72
    self.elfin_name = self.base_panel:getChildByName("name")
    self.elfin_name = self.base_panel:getChildByName("name")
	self.pre_btn = self.base_panel:getChildByName("pre_btn")
    self.pre_btn:setVisible(false)
    self.pre_btn_txt = self.pre_btn:getChildByName("pre_btn_txt")
    setTextMaxWidth(self.pre_btn_txt, 90, -4)
    self.pre_btn_txt:setChangeScaleOffWidth(-1000)
    self.pre_btn_txt:setString(TI18N("语言_c_2287"))


	self.base_panel:getChildByName("score_title"):setString(TI18N("语言_c_1742"))
	self.power_label = CommonNum.new(1, self.base_panel, 1, - 2, cc.p(0, 0))
    self.power_label:setPosition(cc.p(230, 66))
    self.power_label:setNum(0)
	self.power_label:setScale(0.8)
	local score_title = self.base_panel:getChildByName("score_title")
	setItemXOneByOne({score_title,self.power_label})

	self.base_attr = self.container:getChildByName("base_attr")
	self.base_name = self.base_attr:getChildByName("label")
	self.base_name:setString(TI18N("语言_spr_01_8"))

	self.skill_content =  self.container:getChildByName("skill_content")
    self.skill_content:setScrollBarEnabled(false)
    self.skill_panel = self.skill_content:getChildByName("skill_panel")
    self.skill_panel:getChildByName("label"):setString(TI18N("语言_c_1743"))
    self.skill_icon = self.skill_panel:getChildByName("skill_icon")
    self.skill_name = self.skill_panel:getChildByName("name")
	self.skill_name:ignoreContentAdaptWithSize(true)
	self.skill_name:setTextAreaSize(cc.size(255,0))
 	setTextSpacing(self.skill_name,-8)
    self.skill_type = self.skill_panel:getChildByName("skill_type")
    self.skill_lv = self.skill_panel:getChildByName("skill_lv")
    -- self.skill_line:setVisible(false)
	self.scrollView = createScrollView(480,500,90,-85,self.skill_panel)
	self.scrollView:setAnchorPoint(cc.p(0,1))
	self.skill_line = createSprite(PathTool.getResFrame("common_2","tips_8"), 211,0, self.scrollView, cc.p(0.5, 1))
	self.skill_line:setVisible(false)
	self.skill_line:setScaleX(7.68)

    self.attch_skill_panel = self.skill_content:getChildByName("attch_skill_panel")
    self.attch_skill_panel:getChildByName("label"):setString(TI18N("语言_c_1743"))
    self.attch_skill_icon = self.attch_skill_panel:getChildByName("skill_icon")
    self.attch_skill_name = self.attch_skill_panel:getChildByName("name")
	self.attch_skill_name:ignoreContentAdaptWithSize(true)
	self.attch_skill_name:setTextAreaSize(cc.size(255,0))
 	setTextSpacing(self.attch_skill_name,-8)
    self.attch_skill_type = self.attch_skill_panel:getChildByName("skill_type")
    self.attch_skill_lv = self.attch_skill_panel:getChildByName("skill_lv")
	self.attch_scrollView = createScrollView(480,500,90,-85,self.attch_skill_panel)
	self.attch_scrollView:setAnchorPoint(cc.p(0,1))
	self.attch_skill_line = createSprite(PathTool.getResFrame("common_2","tips_8"), 211,0, self.attch_scrollView, cc.p(0.5, 1))
	self.attch_skill_line:setVisible(false)
	self.attch_skill_line:setScaleX(7.68)
	self.elfin_btn = self.attch_skill_panel:getChildByName("elfin_btn")
    self.elfin_btn_txt = self.elfin_btn:getChildByName("pre_btn_txt")
    setTextMaxWidth(self.elfin_btn_txt, 90, -4)
    self.elfin_btn_txt:setChangeScaleOffWidth(-1000)
    self.elfin_btn_txt:setString(TI18N("语言_c_7534"))


    self.tab_panel = self.container:getChildByName("tab_panel")
	self.tab_btn_1 = self.tab_panel:getChildByName("tab_btn_1")
	local tab_btn_1_label = self.tab_btn_1:getChildByName("label")
    tab_btn_1_label:setString(TI18N("语言_spr_01_9"))
	tab_btn_1_label:setScale(1)
	autoSizeTitleBg(tab_btn_1_label,self.tab_btn_1,30,122)
	tab_btn_1_label:setPositionX(self.tab_btn_1:getContentSize().width/2)
	
	self.tab_btn_3 = self.tab_panel:getChildByName("tab_btn_3")
	local tab_btn_3_label = self.tab_btn_3:getChildByName("label")
    tab_btn_3_label:setString(TI18N("语言_spr_01_10"))
	tab_btn_3_label:setScale(1)
	autoSizeTitleBg(tab_btn_3_label,self.tab_btn_1,30,122)
	tab_btn_3_label:setPositionX(self.tab_btn_3:getContentSize().width/2)

    self.tab_list = {}
    for i=1,3 do
    	local tab_btn = self.tab_panel:getChildByName("tab_btn_" .. i)
    	if tab_btn then
    		-- _table_insert(self.tab_list, tab_btn)
			self.tab_list[i] = tab_btn
    	end
    end
end

function ElfinTipsNew:register_event(  )
	registerButtonEventListener(self.background, function (  )
		self:close()
	end, false, 2)

	registerButtonEventListener(self.close_btn, function (  )
		self:close()
	end, false, 2)

	if self.elfin_btn then 
        self.elfin_btn:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                ElfinController:getInstance():openElfinAttachBookWindow(true)
                self:close()
            end
        end)
    end

	if self.pre_btn then 
        self.pre_btn:addTouchEventListener(function(sender, event_type) 
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                ElfinController:getInstance():openElfinAttachBookWindow(true)
                self:close()
            end
        end)
    end

	for i,tab_btn in pairs(self.tab_list) do
		registerButtonEventListener(tab_btn, function (  )
			self:onClickBtnByIndex(i)
		end, true)
	end
end

function ElfinTipsNew:onClickBtnByIndex( index )
	-- if not self.elfin_bid then return end
	if index == 1 then -- 羽化
		local min = 1 
		local max = #self.show_list
		local next_index = self.show_index - 1
		if next_index < min then
			next_index = min
		elseif next_index > max then
			next_index = max
		end
		self.show_index = next_index
		self:showData()
		self:showBtnStatus()
		-- local goods_vo = BackpackController:getModel():getBackPackItemByBid(self.elfin_bid)
		-- BackpackController:getInstance():openItemSellPanel(true, goods_vo, BackPackConst.Bag_Code.BACKPACK, 3,self.elfin_order)
	elseif index == 2 then -- 灵合
		-- local str = self.elfin_bid.."_"..self.elfin_order + 1
		-- if Config.SpriteData.data_elfin_dan(str) then
		-- 	ElfinController:getInstance():openElfinOrderWindow(true, self.elfin_bid, 0, self.elfin_order)
		-- else
		-- 	ElfinController:getInstance():openElfinCompoundWindow(true, self.elfin_bid,0, self.elfin_order)
		-- end
	elseif index == 3 then -- 附体
		-- MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.partner, HeroConst.BagTab.eElfin, ElfinConst.Tab_Index.Rouse)
		local min = 1 
		local max = #self.show_list
		local next_index = self.show_index + 1
		if next_index < min then
			next_index = min
		elseif next_index > max then
			next_index = max
		end
		self.show_index = next_index
		self:showData()
		self:showBtnStatus()
	end
end

function ElfinTipsNew:openRootWnd( elfin_bid, show_btn ,elfin_order)
	self.elfin_bid = elfin_bid
	self.is_show_btn = true--show_btn or false
	-- self.elfin_order = elfin_order or 0
	self:setData(elfin_bid)
	self:showBtnStatus()
end

function ElfinTipsNew:setData( elfin_bid )
	if not elfin_bid then return end

	-- self.pre_btn:setVisible(true)
	if not _controller:getModel():checkElfinAttachOpen() then
		self.pre_btn:setVisible(false)
	end
	-- 不能被附魂
	if not _controller:getModel():checkCanAttach(elfin_bid) then
		self.pre_btn:setVisible(false)
	end

	--判断是哪一系列通灵兽
	local elfin_list_cfg = Config.SpriteData.data_sprite_list
	for k, v in pairs(elfin_list_cfg) do
		local list = v.id_list[1]
		for k, v in pairs(list) do
			if elfin_bid == v then
				self.show_list = deepCopy(list) 
				break
			end
		end
	end
	local function sortFunc( objA, objB )
		return objA < objB
	end
	table.sort(self.show_list, sortFunc)
	for k, v in pairs(self.show_list) do
		if v == self.elfin_bid then
			self.show_index = k
			break
		end
	end
	self:showData()
end

function ElfinTipsNew:showBtnStatus()
	local max = #self.show_list
	if self.show_index <= 1 then
		self.tab_btn_1:setVisible(false)
		self.tab_btn_3:setVisible(true)
	elseif self.show_index >= max then
		self.tab_btn_1:setVisible(true)
		self.tab_btn_3:setVisible(false)
	else
		self.tab_btn_1:setVisible(true)
		self.tab_btn_3:setVisible(true)
	end
end

function ElfinTipsNew:showData()
	local elfin_bid = self.show_list[self.show_index]
	local elfin_cfg = Config.SpriteData.data_elfin_data(elfin_bid)

	local elfin_item_cfg = Config.ItemData.data_get_data(elfin_bid)
	if not elfin_cfg or not elfin_item_cfg then return end

	self.power_label:setNum(elfin_cfg.power)
	-- 品质
	local quality = 0
    if elfin_item_cfg.quality >= 0 and elfin_item_cfg.quality <= 5 then
        quality = elfin_item_cfg.quality
    end
    local background_res = PathTool.getResFrame("common_2", "tips_"..quality)
	if elfin_item_cfg.quality > 5 then
		background_res = PathTool.getResFrame("tips", "tips_20")
	end
	self.base_panel:loadTexture(background_res, LOADTEXT_TYPE_PLIST)
    -- 名称
    local color = BackPackConst.getEquipTipsColor(quality)
    self.elfin_name:setTextColor(color) 
    self.elfin_name:setString(elfin_item_cfg.name)

    -- 图标
    if not self.elfin_item then
    	self.elfin_item = BackPackItem.new(false, false)
    	self.elfin_item:setPosition(cc.p(70, 69))
    	self.base_panel:addChild(self.elfin_item)
   	end
	-- self.elfin_item:setElfinOrderVis(true)
   	self.elfin_item:setData(elfin_item_cfg)
	self.elfin_item:setElfinOrder(self.elfin_order)

   	local new_height = self.old_con_size.height
	--print(new_height)

	local attr_height = self:setBaseAttrInfo()
	new_height = new_height + attr_height

   	-- 技能
	local skill_height1 = 0
	local skill_height2 = 0
   	if elfin_cfg.skill then
   		local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
   		if skill_cfg then
			self.skill_name:setString(string.format("%s",skill_cfg.name))
			self.skill_lv:setString("Lv."..skill_cfg.level)-- skill_cfg.level
   			if skill_cfg.type == "active_skill" then 
		        self.skill_type:setString(TI18N("语言_c_1729"))
		    else 
		        self.skill_type:setString(TI18N("语言_c_1730")) 
		    end
		    loadSpriteTexture(self.skill_icon, PathTool.getSkillRes(skill_cfg.icon), LOADTEXT_TYPE)

		    -- 技能描述
		   	local skill_start_pos_y = 500
		   	if not self.skill_desc then
		   		self.skill_desc = createRichLabel(22,cc.c4b(0xfe,0xee,0xba,0xff),cc.p(0,1),cc.p(8, skill_start_pos_y),4,nil,458)
		        self.scrollView:addChild(self.skill_desc)
		   	end
		   	self.skill_desc:setString(skill_cfg.des)
		   	local skill_des_height = self.skill_desc:getContentSize().height
		   	-- new_height = new_height + skill_des_height + 10

		   	-- 冷却时间
		    if not self.extend_desc then
		    	self.extend_desc = createRichLabel(22,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(8,skill_start_pos_y-skill_des_height-10),nil,nil,458)
        		self.scrollView:addChild(self.extend_desc)
		 	end
		 	local extend_str = ""
	        if skill_cfg.cd == 0 then
	            extend_str = TI18N("语言_c_1731")
	        else
	            extend_str = _string_format(TI18N("语言_c_4894"), TI18N("语言_c_1732"),skill_cfg.cd, TI18N("语言_c_1733") )
	        end
	        if skill_cfg.fire_cd ~= 0 then
	            extend_str = extend_str.._string_format(TI18N("语言_c_4894"), TI18N("语言_c_1734"), skill_cfg.fire_cd, TI18N("语言_c_1735")) 
	        end
	        self.extend_desc:setString(extend_str)
	        local extend_desc_height = self.extend_desc:getContentSize().height
	        -- new_height = new_height + extend_desc_height + 10

	        -- buff描述
	        local buff_desc_str = ""
		    if skill_cfg.buff_des ~= nil and skill_cfg.buff_des[1] and next(skill_cfg.buff_des[1]) then
		        local buff_config = Config.SkillData.data_get_buff 
		        for i, v in ipairs(skill_cfg.buff_des[1]) do
		            local config = buff_config[v]
		            if config then
		                if buff_desc_str ~= "" then
		                    buff_desc_str = buff_desc_str.."<div fontcolor=#a1978b>\n</div>"
		                end
		                local buff_desc = _string_format("<div fontcolor=#ffeedd>【%s】</div><div fontcolor=#a1978b>\n%s</div>", config.name, config.desc)
		                buff_desc_str = buff_desc_str..buff_desc
		            end
		        end
		    end
			local  buff_desc_height = 0
			self.skill_line:setVisible(buff_desc_str ~= "")
		    if buff_desc_str ~= "" then
		    	if self.buff_desc == nil then
		            self.buff_desc = createRichLabel(20,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(8,skill_start_pos_y-skill_des_height-extend_desc_height-20),4,nil,458)
		            self.scrollView:addChild(self.buff_desc)
		        end
				self.buff_desc:setString(buff_desc_str)
		        buff_desc_height = self.buff_desc:getContentSize().height
		        -- new_height = new_height + buff_desc_height + 10
			else
				if self.buff_desc then
					self.buff_desc:setString("")
				end
		    end
			local _h = skill_des_height + extend_desc_height + buff_desc_height + 30

			skill_height1 = _h + 180

			-- new_height = new_height + _h
			self.scrollView:setContentSize(cc.size(480,_h))
			self.scrollView:setTouchEnabled(false)
			
			self.scrollView:setInnerContainerSize(cc.size(480,_h))
			self.skill_desc:setPositionY(_h)
			self.extend_desc:setPositionY(_h - skill_des_height - 10)
			if self.buff_desc then
				self.buff_desc:setPositionY(_h - skill_des_height - extend_desc_height - 20)
			end
			self.skill_line:setPositionY(buff_desc_height + 10)
   		else
			
		end
   	end

	self.attch_skill_panel:setVisible(true)
	if not _controller:getModel():checkElfinAttachOpen() then
		self.attch_skill_panel:setVisible(false)
	end
	-- 不能被附魂
	if not _controller:getModel():checkCanAttach(elfin_bid) then
		self.attch_skill_panel:setVisible(false)
	end
	if self.attch_skill_panel:isVisible() then --25141
		local skill_cfg = Config.SkillData.data_get_skill(25141)
   		if skill_cfg then
			self.attch_skill_name:setString(string.format("%s",skill_cfg.name))
			self.attch_skill_lv:setString("Lv."..skill_cfg.level)-- skill_cfg.level
   			if skill_cfg.type == "active_skill" then 
		        self.attch_skill_type:setString(TI18N("语言_c_1729"))
		    else 
		        self.attch_skill_type:setString(TI18N("语言_c_1730")) 
		    end
		    loadSpriteTexture(self.attch_skill_icon, PathTool.getSkillRes(skill_cfg.icon), LOADTEXT_TYPE)

		    -- 技能描述
		   	local skill_start_pos_y = 500
		   	if not self.attch_skill_desc then
		   		self.attch_skill_desc = createRichLabel(22,cc.c4b(0xfe,0xee,0xba,0xff),cc.p(0,1),cc.p(8, skill_start_pos_y),4,nil,458)
		        self.attch_scrollView:addChild(self.attch_skill_desc)
		   	end
		   	self.attch_skill_desc:setString(skill_cfg.des)
		   	local skill_des_height = self.attch_skill_desc:getContentSize().height

		   	-- 冷却时间
		    if not self.attch_extend_desc then
		    	self.attch_extend_desc = createRichLabel(22,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(8,skill_start_pos_y-skill_des_height-10),nil,nil,458)
        		self.attch_scrollView:addChild(self.attch_extend_desc)
		 	end
		 	local extend_str = ""
	        if skill_cfg.cd == 0 then
	            extend_str = TI18N("语言_c_1731")
	        else
	            extend_str = _string_format(TI18N("语言_c_4894"), TI18N("语言_c_1732"),skill_cfg.cd, TI18N("语言_c_1733") )
	        end
	        if skill_cfg.fire_cd ~= 0 then
	            extend_str = extend_str.._string_format(TI18N("语言_c_4894"), TI18N("语言_c_1734"), skill_cfg.fire_cd, TI18N("语言_c_1735")) 
	        end
	        self.attch_extend_desc:setString(extend_str)
	        local extend_desc_height = self.attch_extend_desc:getContentSize().height

	        -- buff描述
	        local buff_desc_str = ""
		    if skill_cfg.buff_des ~= nil and skill_cfg.buff_des[1] and next(skill_cfg.buff_des[1]) then
		        local buff_config = Config.SkillData.data_get_buff 
		        for i, v in ipairs(skill_cfg.buff_des[1]) do
		            local config = buff_config[v]
		            if config then
		                if buff_desc_str ~= "" then
		                    buff_desc_str = buff_desc_str.."<div fontcolor=#a1978b>\n</div>"
		                end
		                local buff_desc = _string_format("<div fontcolor=#ffeedd>【%s】</div><div fontcolor=#a1978b>\n%s</div>", config.name, config.desc)
		                buff_desc_str = buff_desc_str..buff_desc
		            end
		        end
		    end
			local  buff_desc_height = 0
			self.attch_skill_line:setVisible(buff_desc_str ~= "")
		    if buff_desc_str ~= "" then
		    	if self.attch_buff_desc == nil then
		            self.attch_buff_desc = createRichLabel(20,cc.c4b(0xff,0xee,0xdd,0xff),cc.p(0,1),cc.p(8,skill_start_pos_y-skill_des_height-extend_desc_height-20),4,nil,458)
		            self.attch_scrollView:addChild(self.attch_buff_desc)
		        end
				self.attch_buff_desc:setString(buff_desc_str)
		        buff_desc_height = self.attch_buff_desc:getContentSize().height
		        -- new_height = new_height + buff_desc_height + 10
			else
				if self.attch_buff_desc then
					self.attch_buff_desc:setString("")
				end
		    end
			local _h = skill_des_height + extend_desc_height + buff_desc_height + 30
			skill_height2 = _h + 180

			self.attch_scrollView:setContentSize(cc.size(480,_h))
			self.attch_scrollView:setTouchEnabled(true)
			self.attch_scrollView:setInnerContainerSize(cc.size(480,_h))
			self.attch_skill_desc:setPositionY(_h)
			self.attch_extend_desc:setPositionY(_h - skill_des_height - 10)
			if self.attch_buff_desc then
				self.attch_buff_desc:setPositionY(_h - skill_des_height - extend_desc_height - 20)
			end
			self.attch_skill_line:setPositionY(buff_desc_height + 10)
   		else
			
		end

	end

	if (skill_height1 + skill_height2) < 800 then
		self.skill_content:setContentSize(cc.size(590,(skill_height1 + skill_height2)))
		self.skill_content:setTouchEnabled(false)
		new_height = new_height + (skill_height1 + skill_height2)
	else
		self.skill_content:setContentSize(cc.size(590,800))
		self.skill_content:setTouchEnabled(true)
		new_height = new_height + 800
	end
	self.skill_content:setInnerContainerSize(cc.size(590,(skill_height1 + skill_height2)))
	self.skill_panel:setPositionY((skill_height1 + skill_height2))
	self.attch_skill_panel:setPositionY(skill_height2)

   	self.tab_panel:setVisible(self.is_show_btn)
   	if not self.is_show_btn then
   		new_height = new_height - 72
   	end

   	self.container:setContentSize(cc.size(590, new_height))
    self.base_panel:setPositionY(new_height-4)
    self.base_attr :setPositionY(new_height-144)
    self.skill_content:setPositionY(new_height-144 - attr_height)
    self.tab_panel:setPositionY(0)
    self.close_btn:setPositionY(new_height-15)

	-- local isOpen = false
	-- local cfg = Config.SpriteData.data_elfin_dan_table
