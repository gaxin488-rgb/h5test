    self.right_panel:addChild(title_name)
    title_name:setString(TI18N("形象属性"))

    bg = createImage(self.right_panel, PathTool.getResFrame("common","common_90003"), 48, 88, cc.p(0,0), true)
    bg:setScale9Enabled(true)
    bg:setContentSize(120,28)
    --解锁条件
    title_name = createRichLabel(20,106,cc.p(0.5,0.5),cc.p(109,101))
    self.right_panel:addChild(title_name)
    title_name:setString(TI18N("解锁条件"))

    self.attr_label_list = {}
    local pos = {
        [1] = cc.p(-34, 151),
