-- 头像框
-- 
-- @author: cloud@syg.com(必填, 创建模块的人员)
-- @editor: xxx@syg.com(必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-xx-xx
-- --------------------------------------------------------------------
RoleBodyPanel = class("RoleBodyPanel", function()
    return ccui.Widget:create()
end)

string_format = string.format

function RoleBodyPanel:ctor(setting)
    self.ctrl = RoleController:getInstance()
    if setting then
        --配置的是物品id
        self.show_item_id = setting.id
    end
    self:config()
    self:layoutUI()
    
end
function RoleBodyPanel:config()
    
    self.size = cc.size(567,510)
    self:setContentSize(self.size)
    self.item_list = {}
    self.show_list = {}
    self.terms_list = {}
    self.status_list = {}
    self.fashion_id = 0
    self.role_vo = self.ctrl:getRoleVo()
    
end

function RoleBodyPanel:layoutUI()
    self.main_panel = ccui.Widget:create()
    self.main_panel:setContentSize(self.size)
    self.main_panel:setAnchorPoint(cc.p(0.5,0.5))
    self.main_panel:setPosition(cc.p(self.size.width/2,self.size.height/2))
    self:addChild(self.main_panel)
    
    local bg = createImage(self.main_panel, PathTool.getResFrame("common","common_90024"), -35, 
                -50, cc.p(0,0), true, -1)
    bg:setScale9Enabled(true)
    bg:setContentSize(613,496)

    self:createBaseMessage()
    --模型
    self:createMiddle()

    self:registerEvents()
    self.ctrl:requestRoleModelInfo()  
end

function RoleBodyPanel:setData(data)
    if not data then return end
    self.data = data
end

--事件
function RoleBodyPanel:registerEvents()
    self.use_btn:addTouchEventListener(function(sender, event_type)
        -- customClickAction(sender, event_type, scale)
        if event_type == ccui.TouchEventType.ended then
            self:_onClickUseBtn()
        end
    end)

    if not self.updateModelList then
        self.updateModelList = GlobalEvent:getInstance():Bind(RoleEvent.GetModelList,function ( data )
            if data ~= nil then
                self.info = data
                self.use_id = data.use_id
                if data.list then
                    for k,v in pairs(data.list) do
                        self.show_list[v.id] = true
                    end
                end

                self:createItemList()
            end

        end)
    end
    --更换
    if not self.updateModelEvent then
        self.updateModelEvent = GlobalEvent:getInstance():Bind(RoleEvent.UpdateModel,function ( id )
            if not id then return end
            if not self.dic_datas then return end
            if self.dic_datas[id] == nil then return end
            
            self.dic_datas[self.use_id].used = 0
            self.dic_datas[id].used = 1
            local cell_list = self.list_view:getActiveCellList()
            for i,cell in ipairs(cell_list) do
                local vo = cell:getData()
                if vo then
                    if vo.id == self.use_id then
                        self:updateCellByIndex(cell, cell.index)
                    elseif vo.id == id then
                        self:updateCellByIndex(cell, cell.index)
                    end
                end
            end
            self.use_id = id
        end)
    end
    --激活
    if not self.activeModelEvent then
        self.activeModelEvent = GlobalEvent:getInstance():Bind(RoleEvent.ActiveModel,function ( id )
            if not id or self.dic_datas[id] == nil then return end
            self.show_list[id] = true
            self.dic_datas[id].show = 2
            local cell_list = self.list_view:getActiveCellList()
            for i,cell in ipairs(cell_list) do
                local vo = cell:getData()
                if vo then
                    if vo.id == id then
                        self:updateCellByIndex(cell, cell.index)
                    end
                end
            end
            self.use_btn:setBtnLabel(TI18N("更 换"))
        end)
    end
end

function RoleBodyPanel:_onClickUseBtn()
    if self.select_item then
        local vo = self.select_item:getData()

        if self.show_list[self.select_item.vo.id] or next(vo.attr) == nil  then
            if vo and vo.id == self.use_id then
                message(TI18N("该形象已在使用中"))
                return 
            end
            self.ctrl:changeRoleModel( self.select_item:getData().id)
        else
            --未激活 
            local hero_star = HeroController:getModel():getHadHeroStarBybid(vo.bid)
            local role_vo = RoleController:getInstance():getRoleVo()
            local lev = role_vo and role_vo.lev or 0
            --玩家等级
            if lev < vo.lev then
                message(TI18N("等级不足"))
                return
            end

            -- 星数
            if hero_star < vo.star then
                message(string_format(TI18N("%s未达到%s星"), vo.name, vo.star))
                return
            end
            
            if next(vo.expend) then
                local item_data = Config.ItemData.data_get_data(vo.expend[1][1])
                if item_data then
                    local count = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_data.id)
                    if count < vo.expend[1][2] then
                        BackpackController:getInstance():openTipsSource(true, item_data)
                        return
                    end
                else
                    return
                end
            end
            --可激活了
            self.ctrl:activeRoleModel( self.select_item:getData().id)
        end
    end
end

--创建中间的模型部分
function RoleBodyPanel:createMiddle( bid )
    local size = cc.size(320,325)
    self.middle_panel = ccui.Widget:create()
    self.middle_panel:setContentSize(size)
    self.main_panel:addChild(self.middle_panel)
    self.middle_panel:setAnchorPoint(cc.p(0,0))
    self.middle_panel:setPosition(-35,120)

    local res = PathTool.getResFrame("face","face_model_bg")
    local model_bg = createImage(self.middle_panel,res,size.width/2,size.height/2,cc.p(0.5,0.5),true,0,true)

    self.tips = createLabel(20,Config.ColorData.data_color4[186],nil,305,-200,TI18N("该形象可在部分玩法中展示"),self.middle_panel,0, cc.p(0.5,0))
end

function RoleBodyPanel:createItemList()
    local config = Config.LooksData.data_data
    if not config then return end 

    local table_insert = table.insert
    local table_sort = table.sort

    self.dic_datas = {}
    local data_list = {}
    for i,v in pairs(config) do 
        local data = {}
        data.vo = v
        data.id = v.id
        if self.use_id == v.id then
            data.used = 1
        else
            data.used = 0
        end
        if self.show_list[v.id] then
            data.show = 2 --已激活
        else
            local is_active = self:getIsActiveByConfig(v)
            if is_active then
                data.show = 1 --可激活(这个 1 下面有判断..要一起改)
            else
                data.show = 3 -- 未激活
            end
        end
        
        table_insert(data_list, data)
        self.dic_datas[v.id] = data
    end
    local sort_func = SortTools.tableCommonSorter({{"used", true}, {"show", false}, {"id", false}})
    table_sort(data_list, sort_func)

    self.data_list = data_list
    if self.list_view == nil then
        local scroll_view_size = cc.size(250,490)
        local list_setting = {
            start_x = 0,
            space_x = 0,
            start_y = 0,
            space_y = 0,
            item_width = 125,
            item_height = 130,
            row = 0,
            col = 2,
            need_dynamic = true
        }
        self.list_view = CommonScrollViewSingleLayout.new(self.main_panel, cc.p(310, -48), ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, list_setting, cc.p(0, 0)) 

        self.list_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.list_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.onCellTouched), ScrollViewFuncType.OnCellTouched) --更新cell
    end
    if self.show_item_id ~= nil then
        local is_have = false
        for i,data in ipairs(self.data_list) do
            if next(data.vo.expend) and v.expend[1][1] == self.show_item_id then
                is_have = true
                self.list_view:reloadData(i)        
            end
        end
        if not is_have then
            self.list_view:reloadData(1)    
        end
    else
        self.list_view:reloadData(1)
    end
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function RoleBodyPanel:createNewCell(width, height)
    local cell = RoleBodyItem.new()
    cell:setTouchFunc(function() self:onCellTouched(cell) end)
    return cell
end
--获取数据数量
function RoleBodyPanel:numberOfCells()
    return #self.data_list
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function RoleBodyPanel:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.data_list[index]
    cell:setData(cell_data.vo, index)

    --设置解锁
    if self.show_list[cell_data.id] then
        cell:showLock(false)
    else
        cell:showLock(true)
    end

    --是否能激活
    if cell_data.show == 1 then
        cell:showActiveIcon(true)
    else
        cell:showActiveIcon(false)
    end

    --使用中
    if cell_data.used == 1 then
        cell:showUseIcon(true)
    else
        cell:showUseIcon(false)
    end

    if self.select_id and self.select_id == cell_data.id then
        cell:setSelected(true)
    else
        cell:setSelected(false)
    end
end

--点击cell .需要在 createNewCell 设置点击事件
function RoleBodyPanel:onCellTouched(cell)
    local index = cell.index
    local cell_data = self.data_list[index]

    if self.select_item ~= nil then
        self.select_item:setSelected(false)
    end
    self.select_id = cell_data.id
    self.select_item = cell
    self.select_item:setSelected(true)
    self:updateMessage(cell_data.vo)
end

