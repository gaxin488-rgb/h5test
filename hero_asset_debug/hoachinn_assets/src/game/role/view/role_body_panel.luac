    self.right_panel:setAnchorPoint(cc.p(0.5,0))
    self.right_panel:setPosition(cc.p(156,-50))

    local arrow = createSprite(PathTool.getResFrame("common","common_30004"), 253, 271, self.right_panel, cc.p(0,0), LOADTEXT_TYPE_PLIST)
    arrow:setRotation(90)

    --已解锁
    self.unlock = createRichLabel(20,178,cc.p(0.5,0.5),cc.p(112,50))
