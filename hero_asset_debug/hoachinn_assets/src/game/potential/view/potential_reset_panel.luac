PotentialResetPanel = PotentialResetPanel or BaseClass(BaseView)

local controller = PotentialController:getInstance()
local model =  controller:getModel()


function PotentialResetPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "potential/potential_reset_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("quenching", "quenching"), type = ResourcesType.plist},
	}
	self.attr_item_list = {}
    --材料列表
    self.hero_item_list = {}
    self.cost_item_list = {} -- 升星额外消耗的材料
end

function PotentialResetPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	self.container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(self.main_container , 1) 

	self.Image_2 = self.container:getChildByName("Image_2")
	self.confirm_btn = self.container:getChildByName("confirm_btn")
    self.cost_val = createRichLabel(24, cc.c4b(0xf8, 0xef, 0x76, 0xff), cc.p(0.5,0.5), cc.p(80,32),FONT_COMMON_LINE_SPACE)
    self.confirm_btn:addChild(self.cost_val)
	self.win_title = self.container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_5014"))
	autoSizeTitleBg(self.win_title,self.Image_2,60,332)
	self.close_btn = self.container:getChildByName("close_btn")
	self.scroll_view = self.container:getChildByName("scroll_view")
	self.dec_val = createRichLabel(24, cc.c4b(0x68, 0x45, 0x2a, 0xff), cc.p(0,1), cc.p(0,40),FONT_COMMON_LINE_SPACE,nil,610)
    self.scroll_view:addChild(self.dec_val)
    self.dec_val:setString(TI18N("语言_c_7067"))
	local label_siez = self.dec_val:getContentSize()
    local max_height = math.max(label_siez.height,104)
    self.scroll_view:setInnerContainerSize(cc.size(622, max_height))
    if label_siez.height <= 65 then
        self.scroll_view:setTouchEnabled(false)
    end
    self.dec_val:setPositionY(max_height)
	self.list_view = self.container:getChildByName("list_view")
	self.right_tips_icon = self.container:getChildByName("right_tips_icon")
	self.tips = self.container:getChildByName("tips")
	self.left_tips_icon = self.container:getChildByName("left_tips_icon")
	self.tips:setString(TI18N("语言_c_6746"))
	setLeftRightImg(self.left_tips_icon,self.tips,self.right_tips_icon,30)
	local size = self.list_view:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 16,                  -- 第一个单元的X起点
        space_x = 32,                    -- x方向的间隔
        start_y = 6,                    -- 第一个单元的Y起点
        space_y = 10,                   -- y方向的间隔
        item_width = 119,               -- 单元的尺寸width
        item_height = 119,              -- 单元的尺寸height
        row = 4,                        -- 行数，作用于水平滚动类型
        col = 4,                         -- 列数，作用于垂直滚动类型
        once_num = 4,
        need_dynamic = true,
		is_backpack_item = true,
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.list_view, cc.p(0, 0), ScrollViewDir.vertical, ScrollViewStartPos.top, size, setting)
end

function PotentialResetPanel:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openPotentialResetPanel(false)
    end)

    registerButtonEventListener(self.confirm_btn, function() self:onConfirmButton() end ,true, 2)
end

function PotentialResetPanel:onConfirmButton()
	controller:sender11609(self.page_type)
    controller:openPotentialResetPanel(false)
end

function PotentialResetPanel:openRootWnd(page_type)
	if not page_type then return end
	self.page_type = page_type
	self.cfg = Config.PotentialData.data_get_potential_base[self.page_type]
	if not self.cfg then return end
	self.item_data = {}
	local list = {}
	self.potential_lv = 0
	for key, value in pairs(self.cfg) do
		for k, v in pairs(value) do
			local cfg = deepCopy(Config.PotentialData.data_get_potential_detail[v.potential_id])
			local data = model:getPotentialForId(v.potential_id)
			if data and next(data) and cfg[data.potential_level] then
				for _, v1 in pairs(cfg[data.potential_level].reset_gain) do
					local id = v1[1]
					local num = v1[2]
					if list[id] then
						list[id][2] = list[id][2] + num
					else
						list[id] = v1
					end
				end
			end
			local _list = model:getPotentialForId(v.potential_id)
			if _list and next(_list) then
				self.potential_lv = self.potential_lv + _list.potential_level - 1
			end
		end
	end
	for key, value in pairs(list) do
		table.insert(self.item_data, value)
	end
	self.reset_cfg = Config.PotentialData.data_get_potential_reset[self.potential_lv]
	if not self.reset_cfg then return end
	
	self.item_scrollview:setData(self.item_data, nil, nil, {is_show_tips = true, is_other = true})
	local cost = self.reset_cfg.cost[1]
	self.cost_val:setString(string.format(TI18N("语言_c_4039"),PathTool.getItemRes(Config.ItemData.data_get_data(cost[1]).icon),cost[2]))
	local _w = math.max(self.confirm_btn:getContentSize().width, self.cost_val:getContentSize().width + 20)
	self.confirm_btn:setContentSize(cc.size(_w,self.confirm_btn:getContentSize().height))
	self.cost_val:setPositionX(_w/2)
end

function PotentialResetPanel:close_callback(  )
	controller:openPotentialResetPanel(false)
end