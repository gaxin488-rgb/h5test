	end
	playEffectOnce(PathTool.getEffectRes(269), 326, 126, self.top_panel,func, nil, nil, nil, PlayerAction.action, 1,nil,2)
end

function PotentialUpLvPanel:close_callback(  )
	for key,value in ipairs(self.attr_item_list) do
		for k, v in pairs(value) do
			v:removeFromParent()
			v=nil
		end
	end
	self.attr_item_list = {}
    if self.hero_item_list then
        for i,v in ipairs(self.hero_item_list) do
             v:DeleteMe()
        end
        self.hero_item_list = nil
    end
    if self.cost_item_list then
        for i,v in ipairs(self.cost_item_list) do
            v:DeleteMe()
        end
        self.cost_item_list = nil
    end
    if self.upgrade_star_select_event then
        GlobalEvent:getInstance():UnBind(self.upgrade_star_select_event)
        self.upgrade_star_select_event = nil
    end
	controller:openPotentialUpLvPanel(false)
end