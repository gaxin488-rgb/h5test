PotentialUpLvPanel = PotentialUpLvPanel or BaseClass(BaseView)

local controller = PotentialController:getInstance()
local model =  controller:getModel()

local hero_ctr = HeroController:getInstance()
local hero_model = hero_ctr:getModel()

function PotentialUpLvPanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "potential/potential_upLv_panel"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("quenching", "quenching"), type = ResourcesType.plist},
	}
	self.attr_item_list = {}
    --材料列表
    self.hero_item_list = {}
    self.cost_item_list = {} -- 升星额外消耗的材料
end

function PotentialUpLvPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 

	self.container = self.main_container:getChildByName("container")
	self.top_panel = self.container:getChildByName("top_panel")
	self.top_bg = self.top_panel:getChildByName("top_bg")
	self.top_tip = self.top_panel:getChildByName("top_tip")
	self.top_left_panel = self.top_panel:getChildByName("top_left_panel")
	self.left_name_bg = self.top_left_panel:getChildByName("left_name_bg")
	self.left_name = self.top_left_panel:getChildByName("left_name")
	setTextMaxWidth(self.left_name,190,-10)
	self.left_icon = self.top_left_panel:getChildByName("left_icon")
	self.left_lev_bg = self.top_left_panel:getChildByName("left_lev_bg")
	self.left_lev_txt = self.top_left_panel:getChildByName("left_lev_txt")
	self.top_right_panel = self.top_panel:getChildByName("top_right_panel")
	self.right_name_bg = self.top_right_panel:getChildByName("right_name_bg")
	self.right_name = self.top_right_panel:getChildByName("right_name")
	setTextMaxWidth(self.right_name,190,-10)
	self.right_icon = self.top_right_panel:getChildByName("right_icon")
	self.right_lev_bg = self.top_right_panel:getChildByName("right_lev_bg")
	self.right_lev_txt = self.top_right_panel:getChildByName("right_lev_txt")
	self.change_panel = self.container:getChildByName("change_panel")
	self.line_1 = self.change_panel:getChildByName("line_1")
	self.type_tips = self.change_panel:getChildByName("type_tips")
	self.line_2 = self.change_panel:getChildByName("line_2")
	self.attr_scroll = self.change_panel:getChildByName("attr_scroll")
	self.attr_scroll:setScrollBarEnabled(false)
	self.attr_scroll_size = self.attr_scroll:getContentSize()
	self.skill_panel = self.change_panel:getChildByName("skill_panel")
	self.left_skill_panel = self.skill_panel:getChildByName("left_skill_panel")
	self.left_skill_node = self.left_skill_panel:getChildByName("left_skill_node")
	self.left_skill_scr = self.left_skill_panel:getChildByName("left_skill_scr")
	self.left_skill_scr:setScrollBarEnabled(false)
	self.left_skill_des = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(0,0),-4,nil,240)
	self.left_skill_scr:addChild(self.left_skill_des)
	self.arrow = self.skill_panel:getChildByName("arrow")
	self.right_skill_panel = self.skill_panel:getChildByName("right_skill_panel")
	self.right_skill_node = self.right_skill_panel:getChildByName("right_skill_node")
	self.right_skill_scr = self.right_skill_panel:getChildByName("right_skill_scr")
	self.right_skill_scr:setScrollBarEnabled(false)
	self.right_skill_des = createRichLabel(22,cc.c3b(0x5c,0x27,0x05),cc.p(0,1),cc.p(0,0),-4,nil,240)
	self.right_skill_scr:addChild(self.right_skill_des)
	self.cost_panel = self.container:getChildByName("cost_panel")
	self.cost_tips = self.cost_panel:getChildByName("cost_tips")
	self.item_node = self.cost_panel:getChildByName("item_node")
	self.condition_panel = self.container:getChildByName("condition_panel")
	self.condition_tips = self.condition_panel:getChildByName("condition_tips")
	self.condition_tips:setString(TI18N("语言_c_6198"))
	setTextMaxWidth(self.condition_tips,150,-10)
	self.condition_txt = createRichLabel(20,cc.c3b(0xff,0xff,0xff),cc.p(0,0.5),cc.p(200,59),-4,nil,400)
	self.condition_panel:addChild(self.condition_txt)

	self.Image_2 = self.main_container:getChildByName("Image_2")
	self.win_title = self.main_container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_7045"))
	autoSizeTitleBg(self.win_title,self.Image_2,100,300)
	self.up_tips = self.main_container:getChildByName("up_tips")
	setTextMaxWidth(self.up_tips,600,-6)
	self.up_tips:setVisible(false)
	self.more_up_btn = self.main_container:getChildByName("more_up_btn")
	self.more_up_txt = self.more_up_btn:getChildByName("label")
	-- self.more_up_txt:setString(TI18N("语言_c_6535"))
	self.up_btn = self.main_container:getChildByName("up_btn")
	self.up_txt = self.up_btn:getChildByName("label")
	self.up_txt:setString(TI18N("语言_c_6535"))
	self.max_tip = self.main_container:getChildByName("max_tip")
	self.max_tip:setString(TI18N("语言_c_6533"))
	setTextMaxWidth(self.max_tip,500)	
	self.up_btn:setVisible(false)
	self.more_up_btn:setVisible(false)
	self.max_tip:setVisible(false)
	self.close_btn = self.main_container:getChildByName("close_btn")
end

function PotentialUpLvPanel:register_event(  )
    registerButtonEventListener(self.close_btn, function ( )
		controller:openPotentialUpLvPanel(false)
    end,true)
    
	registerButtonEventListener(self.background, function ( )
		controller:openPotentialUpLvPanel(false)
	end)

	registerButtonEventListener(self.up_btn, function ( )
		self:clickUpBtn()
	end,true,nil,nil,nil,0.1)
	registerButtonEventListener(self.more_up_btn, function ( )
		self:clickMoreUpBtn()
	end,true,nil,nil,nil,0.1)

	--添加英雄选择返回事件
    if self.upgrade_star_select_event == nil then
        self.upgrade_star_select_event = GlobalEvent:getInstance():Bind(HeroEvent.Upgrade_Star_Select_Event, function()
            self:updateHeroItemInfo()
        end)
    end

    --刷新单个潜能
    self:addGlobalEvent(PotentialEvent.Update_Potential_Info_Event, function(data)
		if data.potential_id == self.potential_id then
			self:updateData()
		end
    end)
end
function PotentialUpLvPanel:openRootWnd(potential_id)
	if not potential_id then return end
	self.potential_id = potential_id
	self:updateData()
end
function PotentialUpLvPanel:updateData()
	self.data = model:getPotentialForId(self.potential_id)
	if not self.data then
		self.data = {
			potential_id=self.potential_id,
			potential_level=1,
			is_effect=1
		}
	end
	if not self.data then return end
	self.ex_cfg = Config.PotentialData.data_get_potential_base_ex[self.potential_id]
	self.lev_cfg = Config.PotentialData.data_get_potential_detail[self.potential_id]
	self.round_cfg = Config.PotentialData.data_get_round[self.ex_cfg.round_id]
	self.now_cfg = self.lev_cfg[self.data.potential_level]
	self.next_cfg = self.lev_cfg[self.data.potential_level + 1]
	
	if self.data.potential_level >= tableLen(self.lev_cfg) then
		self.lv_type = 1 --已满级
	else
		self.lv_type = 2 --未满级
	end
	self.is_effect = self.data.is_effect -- 0未生效 1生效
	self:updateTopPanel()
	self:updateChangePanel()
	self:updateBottomPanel()
	self:updateBtnPanel()
	self:updateUpLimit()
end
--设置顶部icon显示
function PotentialUpLvPanel:updateTopPanel()
	if self.lv_type == 1 then
		self.top_tip:setVisible(false)
		loadSpriteTexture(self.top_bg,PathTool.getResFrame("quenching", "quenching_13"),LOADTEXT_TYPE_PLIST)
		self.top_right_panel:setVisible(false)
		self.top_left_panel:setPositionX(326)
	elseif self.lv_type == 2 then
		self.top_tip:setVisible(true)
		loadSpriteTexture(self.top_bg,PathTool.getResFrame("quenching", "quenching_5"),LOADTEXT_TYPE_PLIST)
		self.top_right_panel:setVisible(true)
		self.top_left_panel:setPositionX(138)
		self.right_name:setString(self.ex_cfg.potential_name)
		autoSizeTitleBg(self.right_name,self.right_name_bg,100,175)
		loadSpriteTexture(self.right_icon, PathTool.getPotentialIcon(self.ex_cfg.icon), LOADTEXT_TYPE)
		self.right_lev_txt:setString(self.data.potential_level + 1)
	end
	self.left_name:setString(self.ex_cfg.potential_name)
	autoSizeTitleBg(self.left_name,self.left_name_bg,100,175)
	loadSpriteTexture(self.left_icon, PathTool.getPotentialIcon(self.ex_cfg.icon), LOADTEXT_TYPE)
	self.left_lev_txt:setString(self.data.potential_level)
	if self.potential_id == self.round_cfg.key then
		self.left_icon:setScale(0.8)
        self.right_icon:setScale(0.8)
    else
		self.left_icon:setScale(1)
        self.right_icon:setScale(1)
    end
end
--设置中部属性变化显示
function PotentialUpLvPanel:updateChangePanel()
	if self.now_cfg.effect_type == 1 or self.now_cfg.effect_type == 4 or self.now_cfg.effect_type == 5 or self.now_cfg.effect_type == 6 then --属性
		self.type_tips:setString(TI18N("语言_c_7046"))
		self.attr_scroll:setVisible(true)
		self.skill_panel:setVisible(false)
		self:updateAttrPanel()
	elseif self.now_cfg.effect_type == 2 then --光环
		self.type_tips:setString(TI18N("语言_c_7047"))
		self.attr_scroll:setVisible(false)
		self.skill_panel:setVisible(true)
		self:updateSkillPanel()
	elseif self.now_cfg.effect_type == 3 then --技能
		self.type_tips:setString(TI18N("语言_c_7048"))
		self.attr_scroll:setVisible(false)
		self.skill_panel:setVisible(true)
		self:updateSkillPanel()
	end
	setLeftRightImg(self.line_1,self.type_tips,self.line_2,30)
end
--属性
function PotentialUpLvPanel:updateAttrPanel()
	for key,value in ipairs(self.attr_item_list) do
		for k, v in pairs(value) do
			v:removeFromParent()
			v=nil
		end
	end
	self.attr_item_list = {}
	if (self.now_cfg.effect_type == 4 or self.now_cfg.effect_type == 1 or self.now_cfg.effect_type == 5 or self.now_cfg.effect_type == 6) and self.now_cfg.effect_limit_text and self.now_cfg.effect_limit_text[2] then
		if not self.attr_tip then
			self.attr_tip = createRichLabel(22, cc.c3b(0x0e,0xa8,0x0e), cc.p(0.5, 1), cc.p(326, 228), -4, nil, 600)
			self.change_panel:addChild(self.attr_tip)
			self.attr_tip:setHorizontalLayoutType(2)
		end
		self.attr_tip:setString(self.now_cfg.effect_limit_text[2])
    end
	if self.attr_tip then
		self.attr_scroll:setContentSize(cc.size(self.attr_scroll_size.width,self.attr_scroll_size.height-self.attr_tip:getContentSize().height))
	end
	local _h = math.max(self.attr_scroll:getContentSize().height,tableLen(self.now_cfg.effect)*35 + 20)
	self.attr_scroll:setInnerContainerSize(cc.size(self.attr_scroll:getContentSize().width,_h))
	for k, v in pairs(self.now_cfg.effect) do
		local _y = _h-20-(k-1)*35
		local list = {}
		if k%2 == 1 then
			local bg = createImage(self.attr_scroll,PathTool.getResFrame("common", "common_2007"),307,_y,cc.p(0.5,0.5),true,nil,true)
			bg:setContentSize(cc.size(614,34))
			list.bg = bg
		end
		local attr_key = v[1]
        local attr_val = v[2] or 0
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if not attr_name then
            attr_name = Config.AttrExtraData.data_key_to_name[attr_key]
        end
        if attr_name then
			local is_per = PartnerCalculate.isShowPerByStr(attr_key)
            if is_per == true then
                attr_val = (attr_val/10) .."%"
            end
			if attr_key == "atk_per" or attr_key == "hp_max_per" or attr_key == "def_per" then
				attr_name = TI18N("语言_c_7075")..attr_name
			end
			local icon_res = PathTool.getAttrIconByStr(attr_key)
			local icon = createSprite(PathTool.getResFrame("common", icon_res),33,_y,self.attr_scroll,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
			local num = 15
			if judgingLanguage() then
				num = 6
			end
			local name = createLabel(24,cc.c3b(0x7c,0x55,0x36),nil,53,_y+1,transformTextToShort(attr_name,num)..":",self.attr_scroll,nil,cc.p(0,0.5))
			addEvt2showAllTextTips(name,attr_name,num,nil,nil,nil,nil,true)
			local now_num = createLabel(24,cc.c3b(0x7c,0x55,0x36),nil,240,_y+1,attr_val,self.attr_scroll,nil,cc.p(0,0.5))
			local next_num = createLabel(24,cc.c3b(0x0e,0xa8,0x0e),nil,400,_y+1,"",self.attr_scroll,nil,cc.p(0,0.5))
			if self.lv_type == 1 then --满级
				next_num:setString(TI18N("语言_c_7054"))
				next_num:setTextColor(cc.c3b(0xff,0x2a,0x2a))
			elseif self.lv_type == 2 then--未满级
				local next_val = 0
				for key, value in pairs(self.next_cfg.effect) do
					if attr_key == value[1] then
						next_val = value[2]
						break
					end
				end
				local is_per = PartnerCalculate.isShowPerByStr(attr_key)
				if is_per == true then
					next_val = (next_val/10) .."%"
				end
				next_num:setString(next_val)
				next_num:setTextColor(cc.c3b(0x0e,0xa8,0x0e))
				local next_tip = createSprite(PathTool.getResFrame("common", "common_90020"),350,_y,self.attr_scroll,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
				next_tip:setScale(0.8)
				next_tip:setRotation(90)
				list.next_tip = next_tip
			end

			list.icon = icon
			list.name = name
			list.now_num = now_num
			list.next_num = next_num
			table.insert(self.attr_item_list,list)
		end
	end
end
--光环 技能
function PotentialUpLvPanel:updateSkillPanel()
	self.now_skill_id = 0
	self.next_skill_id = 0
	if self.now_cfg.effect_type == 2 then --光环
		self.now_skill_id = self.now_cfg.effect[1][tableLen(self.now_cfg.effect[1])]
		if self.next_cfg then
			self.next_skill_id = self.next_cfg.effect[1][tableLen(self.now_cfg.effect[1])]
		end
	elseif self.now_cfg.effect_type == 3 then --技能
		self.now_skill_id = self.now_cfg.effect[1]
		if self.next_cfg then
			self.next_skill_id = self.next_cfg.effect[1]
		end
	end
	if self.lv_type == 1 then --满级
		self.right_skill_panel:setVisible(false)
		self.arrow:setVisible(false)
		self.left_skill_panel:setPositionX(308)
		self.left_skill_panel:setContentSize(cc.size(616,217))
		self.left_skill_node:setPositionX(308)
		self.left_skill_scr:setPositionX(308)
		self.left_skill_scr:setContentSize(cc.size(616,110))
		self.left_skill_des:setMaxWidth(616)
	else
		self.right_skill_panel:setVisible(true)
		self.arrow:setVisible(true)
		self.left_skill_panel:setPositionX(139)
		self.left_skill_panel:setContentSize(cc.size(278,217))
		self.left_skill_node:setPositionX(139)
		self.left_skill_scr:setPositionX(139)
		self.left_skill_scr:setContentSize(cc.size(240,110))
		self.left_skill_des:setMaxWidth(240)
		
		if not self.right_skill_item then
			self.right_skill_item = SkillItem.new(true, true, true, 0.8, true)
			self.right_skill_node:addChild(self.right_skill_item)
		end
		local cfg = Config.SkillData.data_get_skill(self.next_skill_id)
		if cfg then
			self.right_skill_item:setData(cfg)
			self.right_skill_des:setString(cfg.des)
			local _h = math.max(self.right_skill_des:getContentSize().height,self.right_skill_scr:getContentSize().height)
			self.right_skill_scr:setContentSize(cc.size(self.right_skill_scr:getContentSize().width,_h))
			self.right_skill_des:setPositionY(_h)
		end
	end
	if not self.left_skill_item then
		self.left_skill_item = SkillItem.new(true, true, true, 0.8, true)
		self.left_skill_node:addChild(self.left_skill_item)
	end
	local cfg = Config.SkillData.data_get_skill(self.now_skill_id)
	if cfg then
		self.left_skill_item:setData(cfg)
		self.left_skill_des:setString(cfg.des)
		local _h = math.max(self.left_skill_des:getContentSize().height,self.left_skill_scr:getContentSize().height)
		self.left_skill_scr:setInnerContainerSize(cc.size(self.left_skill_scr:getContentSize().width,_h))
		self.left_skill_des:setPositionY(_h)
	end
end
--刷新底部容器
function PotentialUpLvPanel:updateBottomPanel()
	if self.is_effect == 0 then --未生效
		self:updateConditionPanel()
		self.cost_panel:setVisible(false)
		self.condition_panel:setVisible(true)
	elseif self.is_effect == 1 then --生效
		self:updateCostPanel()
		self.cost_panel:setVisible(true)
		self.condition_panel:setVisible(false)
	end
end
--升级条件
function PotentialUpLvPanel:updateUpLimit()
	local cfg = self.now_cfg.upgrade_cond
	if cfg and next(cfg) then
		local lev = 0
		for k, v in pairs(cfg) do
			if v[1] == 'sheet_lev' then
				lev = v[2]
			end
		end
		local status = model:getPotentialCanUpCon(self.now_cfg.potential_id)
		self.up_tips:setString(string.format(TI18N("语言_c_7072"),lev)..string.format("(%s/%s)",model:getPotentialNowLevel(self.ex_cfg.round_id),lev))
		if status then
			self.up_tips:setTextColor(cc.c4b(0x0e,0xa8,0x0e,0xff))
		else
			self.up_tips:setTextColor(cc.c4b(0xff,0x15,0x15,0xff))
		end
		self.up_tips:setVisible(true)
		self.up_btn:setPositionY(90)
		self.more_up_btn:setPositionY(90)
	else
		self.up_tips:setVisible(false)
		self.up_btn:setPositionY(70)
		self.more_up_btn:setPositionY(70)
	end
end
--消耗
function PotentialUpLvPanel:updateCostPanel()
	self.up_btn:setTouchEnabled(true)
	setChildUnEnabled(false,self.up_btn)
	if self.lv_type == 1 then --已满级
		addRedPointToNodeByStatus(self.up_btn,false)
		self.item_node:setVisible(false)
		self.cost_tips:setAnchorPoint(cc.p(0.5,0.5))
		self.cost_tips:setPositionX(307)
		setTextMaxWidth(self.cost_tips,500)
		self.cost_tips:setString(TI18N("语言_c_6102"))
	elseif self.lv_type == 2 then --未满级
		addRedPointToNodeByStatus(self.up_btn,model:getPotentialCanUp(self.potential_id),10,10)
		self.item_node:setVisible(true)
		self.cost_tips:setAnchorPoint(cc.p(0,0.5))
		self.cost_tips:setPositionX(20)
		setTextMaxWidth(self.cost_tips,150)
		self.cost_tips:setString(TI18N("语言_c_7049"))
		self:updateItemDataPanel()
	end
end
--刷新升级材料消耗
function PotentialUpLvPanel:updateItemDataPanel()
	if not self.now_cfg then return end
	
	self.hero_item_data_list = {}
	--红点条件list
	local conditions_list = {}

	self.dic_other_selected = {}

	local index = 1
	--随机的 {1,4,2} : 1 表示阵营  4: 表示星级 2表示数量
	for i,expend in ipairs(self.now_cfg.cost2) do
		self.hero_item_data_list[index] = self:getHeroData(nil, expend[2], expend[3], expend[1])
		conditions_list[index] = {}
		conditions_list[index][expend[1]] = {}
		conditions_list[index][expend[1]][expend[2]] = expend[3]
		index = index + 1
	end

	for i,item in ipairs(self.hero_item_list) do
		item:setVisible(false)
	end

	for i,hero_vo in ipairs(self.hero_item_data_list) do
		if self.hero_item_list[i] == nil then
			self.hero_item_list[i] = HeroExhibitionItem.new(0.8, true)
			self.hero_item_list[i]:setPosition( (i-1) * (HeroExhibitionItem.Width * 1 + 10) , 0)
			self.hero_item_list[i]:addCallBack(function() self:_onClickItemData(i) end)
			self.item_node:addChild(self.hero_item_list[i])
		end
		self.hero_item_list[i]:setVisible(true)
		if hero_vo.bid == 0 then
			--随机卡的头像id
			local default_head_id = hero_model:getRandomHeroHeadByQuality(hero_vo.star)
			self.hero_item_list[i]:setData(hero_vo)
			self.hero_item_list[i]:setDefaultHead(default_head_id)
		else
			self.hero_item_list[i]:setData(hero_vo)
		end
		
		self.hero_item_list[i]:setHeadUnEnabled(true)
	end

	-- 额外材料
	for k,item in pairs(self.cost_item_list) do
		item:setVisible(false)
	end
	local upgrade_star_cost = {} --消耗材料
	local start_index = #self.hero_item_data_list
	if self.now_cfg.cost then
		for i,v in ipairs(self.now_cfg.cost) do
			local bid = v[1]
			local need_num = v[2]
			local item = self.cost_item_list[i]
			if not item then
				item = BackPackItem.new(false, true, false, 0.8)
				item:setNumLabel(false)
				self.item_node:addChild(item)
				self.cost_item_list[i] = item
				item.num_txt = createLabel(24,cc.c3b(0xff,0xff,0xff),Config.ColorData.data_color4[9],item:getContentSize().width*0.5,0,"",item,2,cc.p(0.5,1))
			end
			item:setPosition( (start_index+i-1) * (BackPackItem.Width * 1 + 10) , 0)
			local have_num = BackpackController:getInstance():getModel():getItemNumByBid(bid)
			item:setBaseData(bid)
			item.num_txt:setString(string.format("%s/%s",MoneyTool.GetMoneyString(have_num,false),MoneyTool.GetMoneyString(need_num,false)))
			if need_num > have_num then
				item:setDefaultTip(true, true)
				item.num_txt:setTextColor(cc.c3b(0xff,0x15,0x15))
			else
				item:setDefaultTip()
				item.num_txt:setTextColor(cc.c3b(0x0e,0xa8,0x0e))
			end
			item:setVisible(true)
		end
	end
    self:updateCentreHeroItemRedPoint()
end

--计算中间item红点显示
function PotentialUpLvPanel:updateCentreHeroItemRedPoint()
    if not self.conditions_hero_list then return end
    if not self.dic_other_selected then return end
    for i,item in ipairs(self.hero_item_list) do
        --模拟的hero_vo数据
        local hero_vo = self.hero_item_data_list[i]
        local conditions_list =  self.conditions_hero_list[i] or {}
        if hero_vo then
            local count = 0
            for k,v in pairs(hero_vo.dic_select_list) do
                count = count + 1
            end
            --已经填满了就不显示红点了
            if count < hero_vo.count then
                --随机卡的 --指定卡 逻辑一样的
                local num = hero_vo.count
                for i,each_hero in ipairs(conditions_list) do
                    --自已选的.和 别人没选的 都算数 
                    if hero_vo.dic_select_list[each_hero.id] or self.dic_other_selected[each_hero.id] == nil then 
                        num = num -1
                        if num == 0 then
                            break
                        end
                    end
                end
                --说明数量够 显示红点
                local status = (num <= 0) 
                item:showRedPoint(status, 8, 8)

            else
                item:showRedPoint(false)
            end
        end
    end
end
--点击材料数据
function PotentialUpLvPanel:_onClickItemData(index)
    if not self.hero_item_data_list[index] then return end
    --标志点击了那个
    self.hero_item_data_list[index].is_select = true
    --被其他人选择的列表 [id] = hero_vo 模式
    local dic_other_selected = {}
    --把自己也过滤
    for i,item in ipairs(self.hero_item_data_list) do
        if i ~= index then
            for k,v in pairs(item.dic_select_list) do
                dic_other_selected[k] = v
            end
        end
    end

    local setting = {}

    hero_ctr:openHeroUpgradeStarSelectPanel(true, self.hero_item_data_list[index], dic_other_selected, HeroConst.SelectHeroType.ePotentialUpLv, setting)
end

--@ bid 英雄bid 特殊判断 如果 == nil 说明是随机卡
--@ star 星级
--@ count 数量
--@ camp_type 阵营  如果是随机卡.此一定需要有值
function PotentialUpLvPanel:getHeroData(bid, star, count, camp_type)
    --模拟 hero_vo 需要的数据
    local data = {}
    data.star = star or 0
    data.count = count or 0
    data.lev = string_format("%s/%s", 0, count)
    
    if bid == nil then
        data.bid = 0 --表示随机卡
        data.camp_type = camp_type
    else
        local base_config = Config.PartnerData.data_partner_base[bid]
        if base_config then
            data.bid = bid
            data.camp_type = base_config.camp_type
            data.name = base_config.name
        else
            return nil
        end
    end
    --当前选中的英雄列表 [id] == hero_vo 模式
    data.dic_select_list = {}
    return data
end


--更新选中英雄信息
function PotentialUpLvPanel:updateHeroItemInfo()
    if not self.hero_item_data_list then return end
    self.dic_other_selected = {}

    for i,v in ipairs(self.hero_item_data_list) do
        if v.is_select then
            v.is_select = false
            local count = 0
            for k,vo in pairs(v.dic_select_list) do
                count = count + 1
                self.dic_other_selected[k] = vo
            end
            v.lev = string_format("%s/%s", count, v.count)
            if self.hero_item_list[i] then
                self.hero_item_list[i].num_label:setString(v.lev)
                if count > 0 then
                    self.hero_item_list[i]:setHeadUnEnabled(false)
                else
                    self.hero_item_list[i]:setHeadUnEnabled(true)
                end
            end
        else
            for k,vo in pairs(v.dic_select_list) do
                self.dic_other_selected[k] = vo
            end
        end
    end
    self:updateCentreHeroItemRedPoint()
end

--条件
function PotentialUpLvPanel:updateConditionPanel()
	local str = ""
	local status = 0 --前置潜能生效
	local pre_status = false
	for i, v in pairs(self.ex_cfg.pre_potential_id) do
		if model:getPotentialOneStatus(v) == PotentialConst.One_Status.haveEff then
			pre_status = true
		end
		-- if model:getPotentialOneStatus(v) ~= PotentialConst.One_Status.haveEff then
		-- 	status = 1 --前置潜能不生效
		-- end
	end
	if not pre_status and next(self.ex_cfg.pre_potential_id) then
		status = 1 --前置潜能不生效
	end
	if status == 1 then
		local _str = ""
		for i, v in pairs(self.ex_cfg.pre_potential_id) do
			local cfg = Config.PotentialData.data_get_potential_base_ex[v]
			if _str == "" then
				if cfg and cfg.potential_name then
					_str = cfg.potential_name
				end
			else
				_str = _str .. TI18N("语言_c_7056") .. cfg.potential_name
			end
		end
		self.condition_txt:setFontColor(cc.c3b(0xff,0x15,0x15))
		str = string.format(TI18N("语言_c_7033"),_str)
	else
		for i, v in pairs(self.ex_cfg.unlock_cond) do
			local _txt = ""
			if v[1] == "partner_unlock" then
				local list = {v[2],v[3],v[4]}
				local _list = hero_model:getHeroReachCon(list)
				local str_txt = LangStringFormat(TI18N("语言_c_7034"),v[4],HeroConst.ScoreList[v[2]],v[3]) .. string.format("(%s/%s)",_list[2],_list[3])
				if _list[1] then
					_txt = string.format("<div fontcolor=#1bca0d>%s</div>",str_txt)
				else
					_txt = string.format("<div fontcolor=#ff1515>%s</div>",str_txt)
				end
			elseif v[1] == "cystal_lev" then
				local str_txt = string.format(TI18N("语言_c_6222"),v[2])..string.format("(%s/%s)",v[2],HeroController:getInstance():getModel().resonate_cystal_lev)
				if HeroController:getInstance():getModel():checkEnoughResLev(v[2]) then
					_txt = string.format("<div fontcolor=#1bca0d>%s</div>",str_txt)
				else
					_txt = string.format("<div fontcolor=#ff1515>%s</div>",str_txt)
				end
			end
			if str == "" then
				str = _txt
			else
				str = str .. "\n" .. _txt
			end
		end
	end
	self.condition_txt:setString(string.format("<div>%s</div>",str))
	setChildUnEnabled(true,self.up_btn)
	self.up_btn:setTouchEnabled(false)
	addRedPointToNodeByStatus(self.up_btn,false)
	setChildUnEnabled(true,self.more_up_btn)
	self.more_up_btn:setTouchEnabled(false)
	addRedPointToNodeByStatus(self.more_up_btn,false)
end

function PotentialUpLvPanel:updateBtnPanel()
	if self.lv_type == 1 then --满级
		self.up_btn:setVisible(false)
		self.more_up_btn:setVisible(false)
		self.max_tip:setVisible(true)
	elseif self.lv_type == 2 then--未满级
		self.up_btn:setVisible(true)
		self.max_tip:setVisible(false)
		local lev = 0
		local list = {}
		for k,v in ipairs(self.lev_cfg) do
			if v.potential_level >= self.data.potential_level then
				if next(v.upgrade_cond) or next(v.cost2) then break end
				if tableLen(list) > 0 then
					local status = true
					for key,value in pairs(v.cost) do
						if not list[value[1]] then
							status = false
							break
						else
							local have_num = BackpackController:getInstance():getModel():getItemNumByBid(value[1])
							local need_num = list[value[1]] + value[2]
							if have_num < need_num then
								status = false
								break
							else
								list[value[1]] = need_num
							end
						end
					end
					if status then
						lev = lev + 1
					end
				else
					for key,value in pairs(v.cost) do
						list[value[1]] = value[2]
					end
					lev = lev + 1
				end
			end
		end
		if lev > Config.PotentialData.data_const.lvup_num.val then
			lev = Config.PotentialData.data_const.lvup_num.val
		end
		if lev > 1 then
			self.more_up_btn:setVisible(true)
			self.more_up_txt:setString(string.format(TI18N("语言_c_3194"),lev))
			self.up_btn:setPositionX(200)
		else
			self.more_up_btn:setVisible(false)
			self.up_btn:setPositionX(334)
		end
		self.now_cfg = self.lev_cfg[self.data.potential_level]
	end

end

function PotentialUpLvPanel:clickMoreUpBtn()
	if not model:getPotentialCanUpCon(self.now_cfg.potential_id) then
		message(TI18N("语言_c_7073"))
		return
	end
    local function func()
		local hero_list = {}
		local random_list = {}
		local dic_item_expend = {}
		if self.hero_item_data_list and next(self.hero_item_data_list) ~= nil then
			for i,item in ipairs(self.hero_item_data_list) do
				local count = 0
				for k,v in pairs(item.dic_select_list) do
					count = count + 1
				end
				if count < item.count then
					message(TI18N("语言_c_3021"))
					return
				end
				for k,v in pairs(item.dic_select_list) do
					if v.is_hero_hun then --是否英魂 参考 HeroUpgradeStarSelectPanel:initHeroList(dic_other_selected) 里面的定义
						if v.good_vo then
							if dic_item_expend[v.good_vo.base_id] == nil then
								dic_item_expend[v.good_vo.base_id] = 1
							else
								dic_item_expend[v.good_vo.base_id] = dic_item_expend[v.good_vo.base_id] + 1
							end
						end
					else
						local data = {}
						data.id = k
						if item.bid == 0 then
							--随机卡
							table.insert(random_list, data)
						else
							--指定卡
							table.insert(hero_list, data)
						end
					end
				end
			end 
		end
	
		local item_list = {}
		for item_id, num in pairs(dic_item_expend) do
			local data = {}
			data.item_id = item_id
			data.num = num
			table.insert(item_list, data)
		end
		for key,value in pairs(self.now_cfg.cost) do
			local have_num = BackpackController:getInstance():getModel():getItemNumByBid(value[1])
			if have_num < value[2] then
				local config=Config.ItemData.data_get_data(value[1])
        		BackpackController:getInstance():openTipsSource(true, config)
				return
			end
		end
		controller:sender11611(self.now_cfg.potential_id)
	end
	playEffectOnce(PathTool.getEffectRes(269), 326, 126, self.top_panel,func, nil, nil, nil, PlayerAction.action, 1,nil,2)
end
