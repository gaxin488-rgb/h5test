PotentialMainWindow = PotentialMainWindow or BaseClass(BaseView)
local controller = PotentialController:getInstance()
local model = controller:getModel()


function PotentialMainWindow:__init()
    self.is_full_screen = true
	self.win_type = WinType.Full
    self.layout_name = "potential/potential_main_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("common", "common"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("potential", "potential"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("potential", "potential_bg"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("potential", "txt_cn_potential_1"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("hallows", "hallows"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("dungeon_abyss_circle", "dungeon_abyss_circle"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("engraved", "engraved"), type = ResourcesType.plist},
        -- {path = PathTool.getPlistImgForDownLoad("ninja_treasure", "ninja_treasure_30"), type = ResourcesType.single},
    }
    self.tab_btn_index = 0
    self.potential_id = 0
    self.attr_list = {}
    self.item_list = {} --道具数量显示
    self.stage_list = {} --阶段名称显示
    self.preview_type = 0 --满级预览
    self.is_first = true
    model:setReturnLoginRed(false)
end

function PotentialMainWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.container_size = self.main_container:getContentSize()
    self:playEnterAnimatianByObj(self.main_container , 1)
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.title_bg = self.top_panel:getChildByName("title_bg")
    self.wnd_title = self.top_panel:getChildByName("wnd_title")
    self.wnd_title:setChangeScaleOffWidth(520)
    setTextSpacing(self.wnd_title, 10)
    self.wnd_title:setString(TI18N("语言_c_7036"))
    self.paging_panel = self.top_panel:getChildByName("paging_panel")
    self.paging_panel:setScrollBarEnabled(false)
    self.click_btn = self.paging_panel:getChildByName("click_btn")
    self.item_panel = self.top_panel:getChildByName("item_panel")
    self.act_tips = self.item_panel:getChildByName("act_tips")
    setTextSpacing(self.act_tips,-6)
    self.act_tips:setString(TI18N("语言_c_7037"))
    self.act_tips:setVisible(false)
    self.explain_btn = self.top_panel:getChildByName("explain_btn")
    self.main_panel = self.main_container:getChildByName("main_panel")
    self.main_panel:setScrollBarEnabled(false)
    self.main_bot_bg = self.main_container:getChildByName("main_bot_bg")
    self.close_btn = self.main_container:getChildByName("close_btn")
    self.btn_panel = self.main_container:getChildByName("btn_panel")
    self.preview_panel = self.btn_panel:getChildByName("preview_panel")
    self.preview_btn = self.preview_panel:getChildByName("preview_btn")
    self.preview_btn:setVisible(false)
    self.preview_txt = self.preview_btn:getChildByName("preview_txt")
    setTextMaxWidth(self.preview_txt,100,-8)
    self.preview_txt:setString(TI18N("语言_c_6416"))
    self.back_btn = self.preview_panel:getChildByName("back_btn")
    self.back_btn:setVisible(false)
    self.back_txt = self.back_btn:getChildByName("back_txt")
    setTextMaxWidth(self.back_txt,100,-8)
    self.back_txt:setString(TI18N("语言_c_262"))
    self.play_panel = self.btn_panel:getChildByName("play_panel")
    self.task_btn = self.play_panel:getChildByName("task_btn")
    self.task_txt = self.task_btn:getChildByName("task_txt")
    setTextMaxWidth(self.task_txt,100,-8)
    self.task_txt:setString(TI18N("语言_c_7038"))
    self.details_btn = self.play_panel:getChildByName("details_btn")
    self.details_txt = self.details_btn:getChildByName("details_txt")
    setTextMaxWidth(self.details_txt,100,-8)
    self.details_txt:setString(TI18N("语言_c_7039"))
    self.reset_btn = self.play_panel:getChildByName("reset_btn")
    self.reset_txt = self.reset_btn:getChildByName("reset_txt")
    setTextMaxWidth(self.reset_txt,100,-8)
    self.reset_txt:setString(TI18N("语言_c_6550"))

    self:adaptationScreen()
end
--设置适配屏幕
function PotentialMainWindow:adaptationScreen()
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)
    local left_x = display.getLeft(self.main_container)
    local right_x = display.getRight(self.main_container)
    
    local panel_height = top_y - bottom_y

    local tab_y = self.top_panel:getPositionY()
    self.top_panel:setPositionY(top_y - (self.container_size.height - tab_y))
    
    local main_panel_y = self.main_panel:getPositionY()
    self.main_panel:setPositionY(bottom_y + main_panel_y)
    local main_panel_y = self.main_bot_bg:getPositionY()
    self.main_bot_bg:setPositionY(bottom_y + main_panel_y)
    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)

    self.main_panel_size = self.main_panel:getContentSize()
    self.main_panel_size.height = panel_height - (CC_DESIGN_RESOLUTION.height-self.main_panel_size.height)
    self.main_panel:setContentSize(self.main_panel_size)

end
function PotentialMainWindow:register_event()
    registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose) ,true, 2)
    registerButtonEventListener(self.task_btn, function()
        controller:openPotentialRankWindow(true)
    end ,true, 2)
    registerButtonEventListener(self.explain_btn, function()
        local desc= Config.PotentialData.data_get_potential_rule
        if desc then
            MainuiController:getInstance():openCommonExplainView(true, Config.PotentialData.data_get_potential_rule)
        end
    end ,true, 2)
    registerButtonEventListener(self.details_btn, function()
        controller:openPotentialDetailsPanel(true)
    end ,true, 2)
    registerButtonEventListener(self.preview_btn, function()
        self:updatePreviewBtn(true)
    end ,true, 2)
    registerButtonEventListener(self.back_btn, function()
        self:updatePreviewBtn(false)
    end ,true, 2)
    registerButtonEventListener(self.reset_btn, function()
        self:clickResetBtn()
    end ,true, 2)
    --基本信息
    self:addGlobalEvent(PotentialEvent.Potential_Base_Info_Event, function()
        self.potential_id = 0
        self:setData()
    end)
    --刷新单个潜能
    self:addGlobalEvent(PotentialEvent.Update_Potential_Info_Event, function(data)
        self:updateOnePotential(data)
    end)
    --点击页签
    self:addGlobalEvent(PotentialEvent.Potential_Click_Tab_Event, function(round_id)
        self:_onClickTabBtn(round_id)
    end)
    --点击单个潜能
    self:addGlobalEvent(PotentialEvent.Potential_Click_One_Event, function(data)
        self:onClickPotentialOne(data)
    end)
    --红点刷新
    self:addGlobalEvent(PotentialEvent.Potential_Update_Red_Event, function(data)
        self:updateTabRed()
        self:updateOneRed()
    end)
    --刷新页签首次点击红点
    self:addGlobalEvent(PotentialEvent.Potential_Update_Tab_Red_Event, function(data)
        self:updateTabRed()
    end)
    --物品道具增加 判断红点
    if not self.add_goods_event then
        self.add_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.ADD_GOODS, function(bag_code,temp_add)
            -- if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                local list = Config.PotentialData.data_const.show_item.val
                for i,item in pairs(temp_add) do
                    if item.config and item.config.id and table.indexof(list,item.config.id) then
                        self:updateItemPanel()
                    end
                end
            -- end
        end)
    end
    --物品道具删除 判断红点
    if not self.del_goods_event then
        self.del_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.DELETE_GOODS, function(bag_code,temp_del)
            -- if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                local list = Config.PotentialData.data_const.show_item.val
                for i,item in pairs(temp_del) do
                    if item.config and item.config.id and table.indexof(list,item.config.id) then
                        self:updateItemPanel()
                    end
                end
            -- end
        end)
    end

    --物品道具改变 判断红点
    if not self.modify_goods_event then
        self.modify_goods_event = GlobalEvent:getInstance():Bind(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_list)
            -- if bag_code == BackPackConst.Bag_Code.BACKPACK then 
                local list = Config.PotentialData.data_const.show_item.val
                for i,item in pairs(temp_list) do
                    if item.config and item.config.id and table.indexof(list,item.config.id) then
                        self:updateItemPanel()
                    end
                end
            -- end
        end)
    end
    if self.potential_task_event == nil then
    	self.potential_task_event = GlobalEvent:getInstance():Bind(PotentialEvent.Potential_Task_Event, function ()
            self:updateTaskRed()
        end)
    end
end
--重置
function PotentialMainWindow:clickResetBtn()
    local cfg = Config.PotentialData.data_get_potential_base[self.tab_btn_index]
    if not cfg then return end
    for key, value in pairs(cfg) do
        for k, v in pairs(value) do
            local list = model:getPotentialForId(v.potential_id)
            if list and next(list) then
                if list.potential_level > 1 then
                    controller:openPotentialResetPanel(true,self.tab_btn_index)
                    return
                end
            end
        end
    end
    message(TI18N("语言_c_7040"))
end
function PotentialMainWindow:updateTaskRed()
    local status = model:getTaskRed()
    addRedPointToNodeByStatus(self.task_btn,status,10,10)
end
function PotentialMainWindow:_onClickBtnClose()
    controller:openPotentialMainWindow(false)
end
function PotentialMainWindow:openRootWnd()
    controller:sender11600()
    controller:sender11605()
    local list = {}
    local cfg = Config.PotentialData.data_get_round
    for i = 1, tableLen(cfg) do
        if model:getTabStatus(i) ~= 0 then
            table.insert(list, i+3000)
        end
    end
    ActionController:getInstance():sender16808(list)
end

function PotentialMainWindow:setData()
    if not self.btn_list then
        local index = 1 --默认显示的页签
        local cfg = Config.PotentialData.data_get_round
        for i = 1, tableLen(cfg) do
            if model:getTabStatus(i) == 1 then
                index = i
            end
        end
        self:_onClickTabBtn(index)
    end
    if self.is_first then
        self.is_first = false
        self.is_click = false
    else
        self.is_click = true
    end
    self:updatePagingPanel()
    -- self:updateAttrPanel()
    -- self:updatePreviewBtn(false)
end
--设置页签列表
function PotentialMainWindow:updatePagingPanel()
    if not self.btn_data_list then
        self.btn_data_list = {}--页签数据列表
        self.btn_list = {}--页签按钮列表
        self.round_cfg = deepCopy(Config.PotentialData.data_get_round)
        self.tab_cfg = {}
        for k, v in pairs(self.round_cfg) do
            local status = model:getTabStatus(v.round_id)
            if status ~= 0 then
                v.status = status
                table.insert(self.tab_cfg,v)
            end
        end
        if next(self.tab_cfg) then
            table.sort(self.tab_cfg,function(a,b) return a.round_id < b.round_id end)
        end
        local _x = tableLen(self.tab_cfg)*106
        local move_x = 0
        if tableLen(self.tab_cfg) < 5 then
            move_x = (((5 - tableLen(self.tab_cfg))*106)-44)*0.5
            self.paging_panel:setTouchEnabled(false)
        else
            self.paging_panel:setTouchEnabled(true)
        end
        doStopAllActions(self.paging_panel)
        for i=1,tableLen(self.tab_cfg) do
            delayRun(self.paging_panel,0.1*i,function ()
                local v = self.tab_cfg[i]
                if v.status ~= 0 then
                    self.btn_data_list[v.round_id] = v
                    local item = PotentialTabBtn.new()
                    item.list = v
                    item:setPositionY(self.paging_panel:getContentSize().height*0.5)
                    item:setPositionX((i-1)*106 + 44 + move_x)
                    self.paging_panel:addChild(item)
                    self.btn_list[v.round_id] = item
                end
                self.btn_list[v.round_id]:setData(v)
            end)
        end
        local _w = math.max(self.paging_panel:getContentSize().width, _x)
        self.paging_panel:setInnerContainerSize(cc.size(_w, self.paging_panel:getContentSize().height))
    end
    doStopAllActions(self.title_bg)
    local num = 0
    if tableLen(self.btn_list) == tableLen(self.tab_cfg) then
        num = 0
    else
        num = 0.1*tableLen(self.tab_cfg)+0.1
    end
    delayRun(self.title_bg,num,function ()
        self:updateTabRed()
        if self.is_click then
            if self.tab_btn_index == 0 then
                local index = 1 --默认显示的页签
                local cfg = Config.PotentialData.data_get_round
                for i = 1, tableLen(cfg) do
                    if model:getTabStatus(i) == 1 then
                        index = i
                    end
                end
                self:_onClickTabBtn(index)
            else
                local index = deepCopy(self.tab_btn_index)
                self.tab_btn_index = 0
                self:_onClickTabBtn(index)
            end
        end
    end)
end
function PotentialMainWindow:updateTabRed()
    for i=1,tableLen(self.btn_list) do
        local item = self.btn_list[i]
        if item then
            local status = model:getOneTabRed(item.list.round_id)
            addRedPointToNodeByStatus(item.root_wnd,status,10,10)
        end
    end
end
--页签点击事件
function PotentialMainWindow:_onClickTabBtn(index)
    if self.tab_btn_index == index then return end
    local cfg = Config.PotentialData.data_get_round[index]
    self.background:loadTexture(PathTool.getTargetRes("potential", cfg.bg_res,false,false),LOADTEXT_TYPE)
    local list = model:getBtnFirstRedList()
    if list and next(list) then
        if model:getBtnFirstRed(index) then
            ActionController:getInstance():sender16809(index+3000,1,"")
        end
    else
        ActionController:getInstance():sender16809(index+3000,1,"")
    end
    self.tab_btn_index = index
    if self.btn_list and self.btn_list[index] then
        self.click_btn:setPositionX(self.btn_list[index]:getPositionX())
    end
    self:updatePreviewBtn(false)
    self.potential_index = 0
    local config = Config.PotentialData.data_get_potential_base[self.tab_btn_index]
    for i=1,tableLen(config) do
        for k, v in pairs(config[i]) do
            if self.potential_index == 0 then
                self.potential_index = v.potential_id
            end
            local data = model:getPotentialForId(v.potential_id)
            if data and data.is_effect == 1 then
                self.potential_index = v.potential_id
            end
        end
    end

    self:updateItemPanel()
end
--设置潜能页面
function PotentialMainWindow:updateMainPanel()
    self.main_panel:setOpacity(0)
    doStopAllActions(self.main_panel)
    self.main_panel:runAction(cc.FadeIn:create(0.5))
    self.potential_data_list = {}--潜能按钮数据
    if not self.potential_list then
        self.potential_list = {}
    else
        for key, value in pairs(self.potential_list or {}) do
            for k, v in pairs(value or {}) do
                v:DeleteMe()
                v=nil
            end
        end
        self.potential_list = {}
    end
    if not self.potential_line_list then
        self.potential_line_list = {}
    else
        for key, value in pairs(self.potential_line_list or {}) do
            for k, v in pairs(value or {}) do
                v:removeFromParent()
                v=nil
            end
        end
        self.potential_line_list = {}
    end
    local cfg = Config.PotentialData.data_get_potential_base[self.tab_btn_index]
    local lev_cfg = Config.PotentialData.data_get_potential_detail
    if not cfg then return end
    local _cfg = {}
    for i=1, tableLen(cfg) do
        local _list = {}
        for k, v in pairs(cfg[i]) do
            local id_list = v.pre_potential_id
            local status = true
            for i, v in pairs(id_list) do
                local cfg = Config.PotentialData.data_get_potential_base_ex[v]
                if not cfg then
                    status = false
                end
            end
            if status then
                _list[v.potential_id] = v
            end
        end
        if _list and next(_list) then
            table.insert(_cfg,_list)
        end
    end
    local _h = math.max(tableLen(cfg)*170,self.main_panel:getContentSize().height)
    self.main_panel:setInnerContainerSize(cc.size(self.main_panel:getContentSize().width, _h+20))
    for k, v in pairs(self.stage_list) do
        v:setVisible(false)
        v.txt:setVisible(false)
    end
    doStopAllActions(self.main_bot_bg)
    for i=1, tableLen(_cfg) do
        delayRun(self.main_bot_bg,0.1*i,function ()
            local value = _cfg[i]
            local index = 1
            local stage = 1
            local list = {}
            for k, v in pairs(value) do
                table.insert(list, v)
            end
            table.sort(list, function(a,b) return a.potential_id < b.potential_id end)
            for k, v in ipairs(list) do
                local list = deepCopy(v)
                stage = list.stage
                if self.preview_type == 1 then
                    list.data = {
                        potential_id = list.potential_id,
                        potential_level = tableLen(lev_cfg[list.potential_id]),
                        is_effect = 1,
                    }
                    list.status = PotentialConst.One_Status.haveEff
                else
                    list.data = model:getPotentialForId(list.potential_id)
                    list.status = model:getPotentialOneStatus(list.potential_id)
                end
    
                if not self.potential_data_list[list.stage] then
                    self.potential_data_list[list.stage] = {}
                end
                self.potential_data_list[list.stage][list.potential_id] = list
                if not self.potential_list[list.stage] or not self.potential_list[list.stage][list.potential_id] then
                    if not self.potential_list[list.stage] then
                        self.potential_list[list.stage] = {}
                    end
                    if not self.potential_list[list.stage][list.potential_id] then
                        local item = PotentialOneBtn.new()
                        self.main_panel:addChild(item,10)
                        self.potential_list[list.stage][list.potential_id] = item
                    end
                end
                local item = self.potential_list[list.stage][list.potential_id]
                item:setData(list)
                item.data = list
                item:setPositionY(self.main_panel:getInnerContainerSize().height-70-(list.stage-1)*170)
                if tableLen(value) == 1 then
                    item:setPositionX(356)
                elseif tableLen(value) == 2 then
                    item:setPositionX(235+(index-1)*248)
                end
                
                if _cfg[i-1] then
                    local last_cfg = _cfg[i-1]
                    local line_pos_list = {} --距离，角度
                    if tableLen(last_cfg) == 1 and tableLen(value) == 1 then
                        line_pos_list = {{170,0}}
                    elseif tableLen(last_cfg) == 1 and tableLen(value) == 2 then
                        if index == 1 then
                            line_pos_list = {{188,37}}
                        else
                            line_pos_list = {{188,-37}}
                        end
                    elseif tableLen(last_cfg) == 2 and tableLen(value) == 1 then
                        line_pos_list = {{188,-37},{188,37}}
                    elseif tableLen(last_cfg) == 2 and tableLen(value) == 2 then
                        line_pos_list = {{170,0}}
                    end
                    local new_cfg = {}
                    for _k, _v in pairs(last_cfg) do
                        table.insert(new_cfg,_v)
                    end
                    table.sort(new_cfg,function(a,b) return a.potential_id < b.potential_id end)
                    for i=1,tableLen(line_pos_list) do
                        local posx = item:getPositionX()
                        local posy = item:getPositionY()
                        local line_bg = createImage(self.main_panel,PathTool.getResFrame("potential", "potential_2"),posx,posy,cc.p(0.5,0),true,1,true)
                        local line = createImage(self.main_panel,PathTool.getResFrame("potential", "potential_3"),posx,posy,cc.p(0.5,0),true,2,true)
                        line_bg:setContentSize(cc.size(20,line_pos_list[i][1]))
                        line:setContentSize(cc.size(20,line_pos_list[i][1]))
                        line_bg:setRotation(line_pos_list[i][2])
                        line:setRotation(line_pos_list[i][2])
                        item.line_bg = line_bg
                        if not item.line then
                            item.line = {}
                        end
                        table.insert(item.line,line)
                        local last_status = model:getPotentialOneStatus(new_cfg[i].potential_id)
                        line:setVisible(list.status == 3 and (last_status == 3 or self.preview_type == 1))
                        local _list = {
                            line_bg = line_bg,
                            line = line
                        }
                        table.insert(self.potential_line_list,_list)
                    end
                end
                index = index + 1
            end
            if not self.stage_list[stage] then
                local img = createImage(self.main_panel,PathTool.getResFrame("potential", "potential_1"),-5,self.main_panel:getInnerContainerSize().height-70-(stage-1)*170,cc.p(0,0.5),true,nil,true)
                local stage_txt = createLabel(24,cc.c3b(0xff, 0xff, 0xff),cc.c3b(0x00, 0x00, 0x00),18,self.main_panel:getInnerContainerSize().height-69-(stage-1)*170,"",self.main_panel,2,cc.p(0,0.5))
                stage_txt:setLineSpacing(-6)
                stage_txt:setChangeScaleOffWidth(580)
                self.stage_list[stage] = img
                img.txt = stage_txt
            end
            local item = self.stage_list[stage]
            item:setVisible(true)
            item:setPositionY(self.main_panel:getInnerContainerSize().height-70-(stage-1)*170)
            local stage_txt = item.txt
            stage_txt:setVisible(true)
            stage_txt:setPositionY(self.main_panel:getInnerContainerSize().height-69-(stage-1)*170)
            local _txt = ""
            local round_cfg = Config.PotentialData.data_get_round[self.tab_btn_index]
            if round_cfg then
                local ex_cfg = Config.PotentialData.data_get_potential_base_ex[round_cfg.key]
                if stage > ex_cfg.stage then
                    _txt = TI18N("语言_c_7058")..stage-ex_cfg.stage
                elseif stage == ex_cfg.stage then
                    _txt = TI18N("语言_c_7042")
                elseif stage < ex_cfg.stage then
                    _txt = string.format(TI18N("语言_c_7043"),StringUtil.numToChinese(stage))
                end
            end
            stage_txt:setString(_txt)
            local _w = math.max(109,stage_txt:getContentSize().width * stage_txt:getScale() + 46)
            local _h = math.max(26,stage_txt:getContentSize().height * stage_txt:getScale() + 5)
            item:setContentSize(cc.size(_w,_h))
        end)
    end
end
function PotentialMainWindow:updateOneRed()
    if self.potential_list and next(self.potential_list) then
        for i=1,tableLen(self.potential_list) do
            for k, v in pairs(self.potential_list[i]) do
                local status = model:getOneRed(v.data.potential_id) and self.preview_type ~= 1
                if Config.PotentialData.data_get_round[v.data.round_id].key ~= v.data.potential_id then
                    addRedPointToNodeByStatus(v,status,58,65)
                else
                    addRedPointToNodeByStatus(v,status,68,83)
                end
            end
        end
    else
        local cfg = Config.PotentialData.data_get_potential_base[self.tab_btn_index]
        doStopAllActions(self.play_panel)
        delayRun(self.play_panel,0.1*tableLen(cfg),function ()
            self:updateOneRed()
        end)
    end
end
--刷新单个潜能数据
function PotentialMainWindow:updateOnePotential(data)
    local cfg = Config.PotentialData.data_get_potential_base_ex[data.potential_id]
    if not cfg then return end
    local list = deepCopy(cfg)
    list.data = model:getPotentialForId(cfg.potential_id)
    list.status = model:getPotentialOneStatus(cfg.potential_id)
    if self.potential_list and self.potential_list[cfg.stage] and self.potential_list[cfg.stage][cfg.potential_id] then
        local item = self.potential_list[cfg.stage][cfg.potential_id]
        item:setData(list)
        item.list = list
        if item.line then
            for k, v in pairs(item.line) do
                local last_status = model:getPotentialOneStatus(cfg.pre_potential_id[k])
                v:setVisible(list.status == 3 and (last_status == 3 or self.preview_type == 1))
            end
        end
        if self.potential_list[cfg.stage + 1] then
            for key, value in pairs(self.potential_list[cfg.stage + 1]) do
                local item = value
                if item:getData() and next(item:getData()) then
                    if item.line then
                        for k, v in pairs(item.line) do
                            local last_status = model:getPotentialOneStatus(item:getData().pre_potential_id[k])
                            v:setVisible(item:getData().status == 3 and (last_status == 3 or self.preview_type == 1))
                        end
                    end
                end
            end
        end
    end
    self.potential_data_list[cfg.stage][cfg.potential_id] = list

    local list = {}
    for k, v in pairs(self.round_cfg) do
        if v.round_id == cfg.round_id+1 then
            local status = model:getTabStatus(v.round_id)
            if status ~= 0 then
                v.status = status
                list = v
            end
        end
    end
    if self.btn_list and self.btn_list[cfg.round_id+1] and next(list) then
        self.btn_list[cfg.round_id+1]:setData(list)
    end
end
--潜能点击事件
function PotentialMainWindow:onClickPotentialOne(data)
    if not data then return end
    if not self.circle_img then
        self.circle_img = createImage(self.main_panel,PathTool.getResFrame("common", "common_90018"),0,0,cc.p(0.5,0.5),true,12)
    end
    if self.potential_list and self.potential_list[data.stage] and self.potential_list[data.stage][data.potential_id] then
        local posX = self.potential_list[data.stage][data.potential_id]:getPositionX()
        local posY = self.potential_list[data.stage][data.potential_id]:getPositionY()
        self.circle_img:setPosition(cc.p(posX,posY))
    end
    self.circle_img:setVisible(false)
    self.potential_id = data.potential_id
    if self.preview_type == 1 then
        controller:openPotentialActivationTips(true,self.potential_id,2)
    else
        local status = model:getPotentialOneStatus(self.potential_id)
        if status == PotentialConst.One_Status.noAct or status == PotentialConst.One_Status.canAct then
            controller:openPotentialActivationTips(true,self.potential_id,1)
        else
            controller:openPotentialUpLvPanel(true,self.potential_id)
        end
    end
    -- self:updateBottomPanel(data)
end
--刷新物品数量或者条件显示
function PotentialMainWindow:updateItemPanel()
    local status = model:getTabStatus(self.tab_btn_index)
    if status == 3 then
        self.act_tips:setVisible(true)
        if next(self.item_list) then
            for k, v in pairs(self.item_list) do
                v:setVisible(false)
            end
        end
    else
        self.act_tips:setVisible(false)
        local list = Config.PotentialData.data_const.show_item.val
        for i=1, tableLen(list) do
            local item_cfg = Config.ItemData.data_get_data(list[i])
            if item_cfg then
                if not self.item_list[i] then
                    if i == 1 then
                        self.item_list[i] = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(1,0.5),cc.p(334,-131),nil,nil,600)
                    else
                        self.item_list[i] = createRichLabel(22,cc.c3b(0xff,0xff,0xff),cc.p(0,0.5),cc.p(394,-131),nil,nil,600)
                    end
                    self.top_panel:addChild(self.item_list[i])
                end
                local _str = "%s: <div fontcolor=#00ff00>%s</div><img src=resource/item/%s.png scale=0.3 />"
                local count = BackpackController:getInstance():getModel():getItemNumByBid(list[i])
                self.item_list[i]:setString(string.format(_str, item_cfg.name, count,item_cfg.icon))
            end
        end
        for k, v in pairs(self.item_list) do
            v:setVisible(true)
        end
    end
end

--刷新预览按钮 true预览 false返回
function PotentialMainWindow:updatePreviewBtn(status)
    if status and self.preview_type ~= 1 then
        self.preview_type = 1
        self.play_panel:setVisible(false)
        self.back_btn:setVisible(true)
        self.preview_btn:setVisible(false)
    elseif not status and self.preview_type ~= 2 then
        self.preview_type = 2
        self.play_panel:setVisible(true)
        self.back_btn:setVisible(false)
        self.preview_btn:setVisible(true)
    end
    self:updateMainPanel()
    self:updateOneRed()
end

function PotentialMainWindow:close_callback()
    if self.add_goods_event then
        GlobalEvent:getInstance():UnBind(self.add_goods_event)
        self.add_goods_event = nil
    end
    if self.del_goods_event then
        GlobalEvent:getInstance():UnBind(self.del_goods_event)
        self.del_goods_event = nil
    end
    if self.modify_goods_event then
        GlobalEvent:getInstance():UnBind(self.modify_goods_event)
        self.modify_goods_event = nil
    end
    if self.potential_task_event then
        GlobalEvent:getInstance():UnBind(self.potential_task_event)
        self.potential_task_event = nil
    end
    doStopAllActions(self.play_panel)
    doStopAllActions(self.paging_panel)
    doStopAllActions(self.title_bg)
    doStopAllActions(self.main_bot_bg)
    doStopAllActions(self.main_panel)
    controller:openPotentialMainWindow(false)
end


