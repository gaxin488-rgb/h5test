PotentialTabBtn = class("PotentialTabBtn", function()
    return ccui.Widget:create()
end)

function PotentialTabBtn:ctor()
    self:configUI()
    self:register_event()
end

function PotentialTabBtn:configUI()
    self.size = cc.size(72,72)
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setContentSize(self.size)
    self:addChild(self.root_wnd)
    --底图
    self.icon = createImage(self.root_wnd,"",self.size.width*0.5,self.size.height*0.5,cc.p(0.5,0.5),true)
    self.icon:setScale(0.5)
    self.icon:setTouchEnabled(true)
    --灰色连接线
    self.grey_line = createSprite(PathTool.getResFrame("potential", "potential_7"),62,34,self.root_wnd,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
    self.grey_line:setVisible(false)
    --高亮连接线
    self.line = createSprite(PathTool.getResFrame("potential", "potential_8"),62,34,self.root_wnd,cc.p(0,0.5),LOADTEXT_TYPE_PLIST)
    self.line:setVisible(false)
    --黑圈
    self.bot_cir = createSprite(PathTool.getResFrame("potential", "potential_17"),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.bot_cir:setScale(0.7)
    --黄圈
    self.top_cir = createSprite(PathTool.getResFrame("potential", "potential_14"),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.top_cir:setVisible(false)
    self.top_cir:setScale(0.7)
