-- 单个潜能
PotentialOneBtn = class("PotentialOneBtn", function()
    return ccui.Widget:create()
end)

function PotentialOneBtn:ctor()
    self.size = cc.size(154, 154)
    self:setCascadeOpacityEnabled(true)
    self:configUI()
    self:register_event()
end

function PotentialOneBtn:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setCascadeOpacityEnabled(true)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setContentSize(self.size)
    self:addChild(self.root_wnd)
    --底图
    self.icon = createImage(self.root_wnd,"",self.size.width*0.5,self.size.height*0.5,cc.p(0.5,0.5),true)
    self.icon:setTouchEnabled(true)
    --黑圈
    self.bot_cir = createSprite(PathTool.getResFrame("potential", "potential_15"),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.bot_cir:setVisible(false)
    --亮圈
    self.top_cir = createSprite(PathTool.getResFrame("potential", "potential_16"),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.top_cir:setVisible(false)
    --终极圈
    self.big_cir = createSprite(PathTool.getResFrame("potential", "potential_18"),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.big_cir:setVisible(false)
    --锁
    self.lock = createSprite(PathTool.getResFrame("common", "common_lock"),self.size.width*0.5,9,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    self.lock:setVisible(false)
    --失效
    self.grey_img = createSprite(PathTool.getTargetRes("potential", "txt_cn_potential_1",false,false),self.size.width*0.5,self.size.height*0.5,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE)

    self.grey_img:setVisible(false)
    --加成图
    self.add_bg = createImage(self.root_wnd,"",10,self.size.height,cc.p(0,0.5),true,nil,true)
    --加成文本
    self.add_txt = createLabel(20,cc.c3b(0xff, 0xff, 0xff),cc.c3b(0x00, 0x00, 0x00),0,self.size.height,"",self.root_wnd,2,cc.p(0,0.5))
    --等级文本
    self.lev_txt = createLabel(20,cc.c3b(0xff, 0xff, 0xff),cc.c3b(0x00, 0x00, 0x00),0,self.size.height,"",self.root_wnd,2,cc.p(0.5,0.5))
    self.lev_txt:setLineSpacing(-6)
    self.lev_txt:setHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    --满级文本
    self.lev_max_txt = createLabel(20,cc.c3b(0xff, 0x2a, 0x2a),cc.c3b(0x00, 0x00, 0x00),0,self.size.height,"",self.root_wnd,2,cc.p(0.5,0.5))
    self.lev_max_txt:setLineSpacing(-6)
    self.lev_max_txt:setHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self.lev_max_txt:setString("("..TI18N("语言_c_7054")..")")
    self.lev_max_txt:setVisible(false)
end

function PotentialOneBtn:register_event()
    registerButtonEventListener(self.icon, handler(self, self._onClickself) ,false, 2)
end
function PotentialOneBtn:_onClickself()
    if self.data then
        GlobalEvent:getInstance():Fire(PotentialEvent.Potential_Click_One_Event,self.data)
    end
end
-- 不可激活  暗 锁
-- 可激活 暗 锁 红点
-- 激活 不生效 暗
-- 激活 生效 亮
function PotentialOneBtn:setData(data)
    if not data then
        return
    end
    self.data = data
    
    self.icon:loadTexture(PathTool.getPotentialIcon(data.icon), LOADTEXT_TYPE)
    self.round_cfg = Config.PotentialData.data_get_round[data.round_id]
    -- self.status = model:getPotentialOneStatus(data.potential_id)
    self.status = data.status
    self.lev_txt:setString(string.format(TI18N("语言_c_4520"),0))
    local cfg = Config.PotentialData.data_get_potential_detail[data.potential_id]
    if cfg then
        if data.data and data.data.potential_level ~= 0 then
            self.lev_cfg = cfg[data.data.potential_level]
            if data.data.potential_level >= tableLen(cfg) then
                self.lev_max_txt:setVisible(true)
            else
                self.lev_max_txt:setVisible(false)
            end
            self.lev_txt:setString(string.format(TI18N("语言_c_4520"),data.data.potential_level))
        else
            self.lev_cfg = cfg[1]
        end
        local add_res = ""
        local add_txt = ""
        if self.lev_cfg.effect_type == 1 or self.lev_cfg.effect_type == 4 or self.lev_cfg.effect_type == 5 or self.lev_cfg.effect_type == 6 then --加属性
            add_res = PathTool.getResFrame("potential", "potential_5")
            if self.lev_cfg.text == "" then
                add_txt = TI18N("语言_c_6180")
            else
                add_txt = self.lev_cfg.text
            end
        elseif self.lev_cfg.effect_type == 2 then --加光环
            add_res = PathTool.getResFrame("potential", "potential_6")
            if self.lev_cfg.text == "" then
                add_txt = TI18N("语言_c_7044")
            else
                add_txt = self.lev_cfg.text
            end
        elseif self.lev_cfg.effect_type == 3 then -- 技能
            add_res = PathTool.getResFrame("potential", "potential_4")
            if self.lev_cfg.text == "" then
                add_txt = TI18N("语言_c_3204")
            else
                add_txt = self.lev_cfg.text
            end
        end
        self.add_bg:loadTexture(add_res, LOADTEXT_TYPE_PLIST)
        self.add_txt:setString(add_txt)
    end
    if self.data.potential_id == self.round_cfg.key then--终阶大图标
        self.add_bg:setPosition(cc.p(3,130))
        self.add_txt:setPosition(cc.p(12,132))
        self.lev_txt:setPosition(cc.p(77,25))
        self.lev_max_txt:setPosition(cc.p(77,5))
        self.lock:setPosition(cc.p(77,25))
        self.lock:setScale(1.5)
        self.bot_cir:setVisible(false)
        self.top_cir:setVisible(false)
        self.big_cir:setVisible(true)
        setChildUnEnabled(self.status ~= 3,self.big_cir)
        self.grey_img:setScale(1)
    else--普通小图标
        self.add_bg:setPosition(cc.p(14,113))
        self.add_txt:setPosition(cc.p(23,115))
        self.lev_txt:setPosition(cc.p(77,35))
        self.lev_max_txt:setPosition(cc.p(77,15))
        self.lock:setPosition(cc.p(77,35))
        self.bot_cir:setVisible(true)
        self.top_cir:setVisible(self.status==3)
        self.big_cir:setVisible(false)
        self.lock:setScale(1)
        self.grey_img:setScale(0.7)
    end
    autoSizeTitleBg(self.add_txt,self.add_bg,23,66)
    if self.status == PotentialConst.One_Status.noAct or self.status == PotentialConst.One_Status.canAct then-- 0未激活
        setChildUnEnabled(true,self.icon)
        self.grey_img:setVisible(false)
        self.lev_txt:setVisible(false)
        self.lev_max_txt:setVisible(false)
        self.lock:setVisible(true)
    elseif self.status == PotentialConst.One_Status.loseEff then-- 2激活失效
        setChildUnEnabled(true,self.icon)
        self.grey_img:setVisible(true)
        self.lev_txt:setVisible(true)
        self.lock:setVisible(false)
    elseif self.status == PotentialConst.One_Status.haveEff then-- 3激活生效
        setChildUnEnabled(false,self.icon)
        self.grey_img:setVisible(false)
        self.lev_txt:setVisible(true)
        self.lock:setVisible(false)
    end
end
function PotentialOneBtn:getData()
    return self.data or {}
end
function PotentialOneBtn:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end

