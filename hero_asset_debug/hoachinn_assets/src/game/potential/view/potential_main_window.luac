    self.lock:setScale(0.8)
end

function PotentialTabBtn:register_event()
    registerButtonEventListener(self.icon, handler(self, self._onClickself) ,false, 2)
end
function PotentialTabBtn:_onClickself()
    if self.data then
        GlobalEvent:getInstance():Fire(PotentialEvent.Potential_Click_Tab_Event,self.data.round_id)
    end
end
-- 已经解锁 黄圈 1
-- 未解锁 黑圈 置灰 上锁 3
-- 失效 黑圈 置灰 2
function PotentialTabBtn:setData(data)
    if not data then
        return
    end
    self.data = data
    self.grey_line:setVisible(model:getTabStatus(data.round_id+1) ~= 0)
    self.icon:loadTexture(PathTool.getPotentialIcon(data.icon), LOADTEXT_TYPE)
    if self.data.status == 1 then
        self.lock:setVisible(false)
        setChildUnEnabled(false,self.icon)
        self.line:setVisible(true)
        self.top_cir:setVisible(true)
    elseif self.data.status == 2 then
        self.line:setVisible(false)
        self.top_cir:setVisible(false)
        self.lock:setVisible(false)
        setChildUnEnabled(false,self.icon)
    elseif self.data.status == 3 then
        self.line:setVisible(false)
        self.top_cir:setVisible(false)
        self.lock:setVisible(true)
        setChildUnEnabled(true,self.icon)
    end
    if model:getTabStatus(data.round_id+1) == 0 then
        self.line:setVisible(false)
    end
end
function PotentialTabBtn:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end