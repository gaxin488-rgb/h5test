-- 潜能重置
function PotentialController:openPotentialResetPanel(status,page_type)
	if status == true then
		if not self.potential_reset_panel then
			self.potential_reset_panel = PotentialResetPanel.New()
		end
		if self.potential_reset_panel:isOpen() == false then
			self.potential_reset_panel:open(page_type)
		end
	else
		if self.potential_reset_panel then
			self.potential_reset_panel:close()
			self.potential_reset_panel = nil
		end
	end
end

function PotentialController:__delete()
    if self.model ~= nil then
        self.model:DeleteMe()
        self.model = nil
    end
end