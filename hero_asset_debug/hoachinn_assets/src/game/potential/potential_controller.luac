-- 潜能加成详情
function PotentialController:openPotentialDetailsPanel(status)
	if status == true then
		if not self.potential_details_panel then
			self.potential_details_panel = PotentialDetailsPanel.New()
		end
		if self.potential_details_panel:isOpen() == false then
			self.potential_details_panel:open()
