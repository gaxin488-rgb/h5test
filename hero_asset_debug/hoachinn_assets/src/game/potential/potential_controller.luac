-- --------------------------------------------------------------------
-- 这里填写简要说明(必填),
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      潜能
-- <br/>Create: 2020-02-05
-- --------------------------------------------------------------------
PotentialController = PotentialController or BaseClass(BaseController)

function PotentialController:config()
    self.model = PotentialModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function PotentialController:getModel()
    return self.model
end

function PotentialController:registerEvents()
    
end

function PotentialController:registerProtocals()
	self:RegisterProtocal(11600, "handle11600")     -- 潜能基础信息
    self:RegisterProtocal(11601, "handle11601")     -- 单个潜能更新
    self:RegisterProtocal(11602, "handle11602")     -- 激活潜能
    self:RegisterProtocal(11603, "handle11603")     -- 升级潜能
    self:RegisterProtocal(11604, "handle11604")     -- 刷新多个潜能信息
    self:RegisterProtocal(11605, "handle11605")     -- 潜能任务信息
    self:RegisterProtocal(11606, "handle11606")     -- 推送任务变化
    self:RegisterProtocal(11607, "handle11607")     -- 任务奖励领取
    self:RegisterProtocal(11608, "handle11608")     -- 登录红点
	self:RegisterProtocal(11609, "handle11609")     -- 重置
	self:RegisterProtocal(11610, "handle11610")     -- 任务提交道具
	self:RegisterProtocal(11611, "handle11611")     -- 一键升级
end
--协议管理
-- 潜能基础信息
function PotentialController:sender11600(  )
    self:SendProtocal(11600, {})
end
function PotentialController:handle11600( data )
    self.model:setPotentialBaseInfo(data)
end
-- 单个潜能更新
function PotentialController:sender11601(potential_id)
    local protocal = {}
    protocal.potential_id = potential_id
    self:SendProtocal(11601, protocal)
end
function PotentialController:handle11601( data )
	self.model:updatePotentialList(data)
end
-- 激活潜能
function PotentialController:sender11602(potential_id)
    local protocal = {}
    protocal.potential_id = potential_id
	self.potential_act_id = potential_id
    self:SendProtocal(11602, protocal)
end
function PotentialController:handle11602( data )
	message(data.msg)
	if data.code == 1 then
		self:openPotentialActivationTips(false)
		self:openPotentialActivationPanel(true,self.potential_act_id)
	end
end
-- 升级潜能
function PotentialController:sender11603(potential_id,list,item_expend)
    local protocal = {}
    protocal.potential_id = potential_id
	protocal.list = list
	protocal.item_expend = item_expend
    self:SendProtocal(11603, protocal)
end
function PotentialController:handle11603( data )
	if data.code == 1 then
		message(TI18N("语言_s_1785"))
	else
		message(data.msg)
	end
end
-- 刷新多个潜能信息
function PotentialController:sender11604()
    local protocal = {}
    self:SendProtocal(11604, protocal)
end
function PotentialController:handle11604( data )
	self.model:updatePotentialMoreInfo(data)
end
-- 潜能任务信息
function PotentialController:sender11605()
    local protocal = {}
    self:SendProtocal(11605, protocal)
end
function PotentialController:handle11605( data )
	self.model:setPotentialTaskInfo(data)
end
-- 推送任务变化
function PotentialController:sender11606()
    local protocal = {}
    self:SendProtocal(11606, protocal)
end
function PotentialController:handle11606( data )
	self.model:updatePotentialTaskInfo(data)
end
-- 任务奖励领取
function PotentialController:sender11607(id)
    local protocal = {}
    protocal.id = id
    self:SendProtocal(11607, protocal)
end
function PotentialController:handle11607( data )
	message(data.msg)
end
-- 任务奖励领取
function PotentialController:sender11608()
    local protocal = {}
    self:SendProtocal(11608, protocal)
end
function PotentialController:handle11608(data)
	local status = false
	for k, v in pairs(data.red_point_list or {}) do
		if v.code == 1 then
			status = true
			break
		end
    end
	self.model:setReturnLoginRed(status)
end

-- 重置潜能
function PotentialController:sender11609(round)
    local protocal = {}
	protocal.round = round
    self:SendProtocal(11609, protocal)
end
function PotentialController:handle11609(data)
	message(data.msg)
end
-- 重置潜能
function PotentialController:sender11610(id,expend1,item_expend)
    local protocal = {}
	protocal.id = id
	protocal.expend1 = expend1
	protocal.item_expend = item_expend
    self:SendProtocal(11610, protocal)
end
function PotentialController:handle11610(data)
	message(data.msg)
end
-- 一键升级
function PotentialController:sender11611(id)
    local protocal = {}
	protocal.id = id
    self:SendProtocal(11611, protocal)
end
function PotentialController:handle11611(data)
	if data.code == 1 then
		message(TI18N("语言_s_1785"))
	else
		message(data.msg)
	end
end

--界面管理
-- 打开潜能主界面
-- PotentialController:openPotentialMainWindow(true)
function PotentialController:openPotentialMainWindow(status)
	if status == true then
		if not self.potential_main_window then
			self.potential_main_window = PotentialMainWindow.New()
		end
		if self.potential_main_window:isOpen() == false then
			self.potential_main_window:open()
		end
	else
		if self.potential_main_window then
			self.potential_main_window:close()
			self.potential_main_window = nil
		end
	end
end
-- 潜能任务
function PotentialController:openPotentialRankWindow(status)
	if status == true then
		if not self.potential_rank_window then
			self.potential_rank_window = PotentialRankWindow.New()
		end
		if self.potential_rank_window:isOpen() == false then
			self.potential_rank_window:open()
		end
	else
		if self.potential_rank_window then
			self.potential_rank_window:close()
			self.potential_rank_window = nil
		end
	end
end
-- type 1潜能激活弹窗  2满级预览弹窗
function PotentialController:openPotentialActivationTips(status,data,type)
	if status == true then
		if not self.potential_activation_tips then
			self.potential_activation_tips = PotentialActivationTips.New(type)
		end
		if self.potential_activation_tips:isOpen() == false then
			self.potential_activation_tips:open(data)
		end
	else
		if self.potential_activation_tips then
			self.potential_activation_tips:close()
			self.potential_activation_tips = nil
		end
	end
end
-- 潜能激活成功弹窗
function PotentialController:openPotentialActivationPanel(status,potential_id)
	if status == true then
		if not self.potential_activation_panel then
			self.potential_activation_panel = PotentialActivationPanel.New()
		end
		if self.potential_activation_panel:isOpen() == false then
			self.potential_activation_panel:open(potential_id)
		end
	else
		if self.potential_activation_panel then
			self.potential_activation_panel:close()
			self.potential_activation_panel = nil
		end
	end
end
