-- @description: 跨服传奇忍者主题展示文字
-- @DateTime:    2020-12-9
-- *******************************
EserciseShowThemeWindow = EserciseShowThemeWindow or BaseClass(BaseView)

local string_format = string.format
function EserciseShowThemeWindow:__init()
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "esercise/esercise_show_theme_window"
end

function EserciseShowThemeWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())
	self.main_container = self.root_wnd:getChildByName("main_container")
	self.reward_bg = self.main_container:getChildByName("reward_bg")
    self.txt_panel = self.reward_bg:getChildByName("txt_panel")
    self.top_title = createLabel(20, cc.c4b(0xeb,0xdd,0xae,0xff), nil, 0, 0, TI18N("语言_c_5423"), self.txt_panel, nil, cc.p(0,1))
    self.bottom_title = createLabel(20, cc.c4b(0xeb,0xdd,0xae,0xff), nil, 0, 0, TI18N("语言_c_5424"), self.txt_panel, nil, cc.p(0,1))
    self.top_name = createLabel(24, cc.c4b(0xd1,0x4d,0x13,0xff), nil, 0, 0, TI18N("---"), self.txt_panel, nil, cc.p(0.5,1))
    self.bottom_name = createLabel(24, cc.c4b(0xd1,0x4d,0x13,0xff), nil, 0, 0, TI18N("---"), self.txt_panel, nil, cc.p(0.5,1))
    self.top_time_txt = createLabel(20, cc.c4b(0xeb,0xdd,0xae,0xff), nil, 0, 0, TI18N("语言_c_5425"), self.txt_panel, nil, cc.p(1,1))
    self.top_time_value = createLabel(18, cc.c4b(0x00,0xff,0x00,0xff), nil, 0, 0, TI18N("12:12:12"), self.txt_panel, nil, cc.p(1,1))
end
function EserciseShowThemeWindow:setData()
    local _w = 40
    local _h = 70
    _w = _w + self.top_title:getContentSize().width + self.top_time_txt:getContentSize().width + self.top_time_value:getContentSize().width
    _h = _h + self.top_title:getContentSize().height + self.bottom_title:getContentSize().height + self.top_name:getContentSize().height + self.bottom_name:getContentSize().height + self.top_time_txt:getContentSize().height + self.top_time_value:getContentSize().height
    self.txt_panel:setContentSize(cc.size(_w,_h))
    self.reward_bg:setContentSize(cc.size(_w,_h))
    self.top_title:setPosition(cc.p(20,_h - 10))
    self.top_name:setPosition(cc.p(_w/2, _h - 10 - self.top_title:getContentSize().height - 20))
    self.top_time_value:setPosition(cc.p(_w - 20, self.top_name:getPositionY() - self.top_name:getContentSize().height - 20))
    self.top_time_txt:setPosition(cc.p(self.top_time_value:getPositionX() - self.top_time_value:getContentSize().width - 5, self.top_time_value:getPositionY()+2))
    self.bottom_title:setPosition(cc.p(20,self.top_time_value:getPositionY() - 30))
    self.bottom_name:setPosition(cc.p(_w/2, self.bottom_title:getPositionY() - self.bottom_title:getContentSize().height - 20))
end
function EserciseShowThemeWindow:openRootWnd(pos,index,endTime)
	if self.reward_bg then
		self.reward_bg:setPosition(cc.p(pos.x,pos.y))
	end
    self.theme_list = {}
    local theme_list = deepCopy(Config.PrimusElementData.data_constant["season_rotation"].val)
    for key, value in pairs(theme_list) do
        table.insert(self.theme_list, value[1], value[2])
    end
    local theme_num = self.theme_list[index]
    local theme_next_num = self.theme_list[index+1]
    if not theme_next_num then
        theme_next_num = self.theme_list[1]
    end
    self.cfg = deepCopy(Config.PrimusElementData.data_primus_desc[theme_num])
    self.nextcfg = deepCopy(Config.PrimusElementData.data_primus_desc[theme_next_num])
    self.top_name:setString(TI18N(self.cfg.imp_desc))
    self.bottom_name:setString(TI18N(self.nextcfg.imp_desc))
    local endtime = endTime - GameNet:getInstance():getTime()
    ActionController:getInstance():getModel():setCountDownTime(self.top_time_value,endtime or 0)
    self:setData()
end

function EserciseShowThemeWindow:register_event()
	registerButtonEventListener(self.background, function()	
		EsecsiceController:getInstance():openEserciseShowThemeWindow(false)
	end, false, 2)
end

function EserciseShowThemeWindow:close_callback()
    EsecsiceController:getInstance():openEserciseShowThemeWindow(false)
end 