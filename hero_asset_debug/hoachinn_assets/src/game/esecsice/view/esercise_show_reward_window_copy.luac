--******** 文件说明 ********
-- *******************************
EserciseShowRewardWindowCopy = EserciseShowRewardWindowCopy or BaseClass(BaseView)

local string_format = string.format
function EserciseShowRewardWindowCopy:__init()
	self.win_type = WinType.Mini
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "esercise/esercise_show_reward_window"
end

function EserciseShowRewardWindowCopy:open_callback()
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())
    self.background:setBackGroundColorOpacity(0)
	self.main_container = self.root_wnd:getChildByName("main_container")
	self.reward_layer = self.main_container:getChildByName("reward_layer")
    self.reward_bg = self.reward_layer:getChildByName("reward_bg")
	self.item_container = self.reward_layer:getChildByName("item_container")
end

function EserciseShowRewardWindowCopy:openRootWnd(rewardArr,pos,offsetY,offsetX)--offsetY异形屏导致的偏移
    offsetY = offsetY or 0
    offsetX = offsetX or 0
    scale = scale or 1
    self.reward_layer:setScale(scale)
	local list = {}
    local reward = rewardArr
    for i = 1, tableLen(reward) do
        local vo = {}
        if type(reward[i]) == "table" then
            vo = deepCopy(Config.ItemData.data_get_data(reward[i][1] or reward[i].bid))
            vo.quantity = reward[i][2] or reward[i].num
        else
            vo = deepCopy(Config.ItemData.data_get_data(reward[i]))
            vo.quantity = 1
        end
        table.insert(list, vo)
    end
    if #list == 1 then
        self.reward_layer:setContentSize(cc.size(102, 102))
        self.item_container:setContentSize(cc.size(116,116))
        self.item_container:setPosition(51, 51)
        self.reward_bg:setContentSize(cc.size(102, 102))
        self.reward_bg:setPosition(51, 51)
    elseif #list == 2 then
        self.reward_layer:setContentSize(cc.size(186, 102))
        self.item_container:setPosition(93, 51)
        self.item_container:setContentSize(cc.size(220,116))
        self.reward_bg:setContentSize(cc.size(186, 102))
        self.reward_bg:setPosition(93, 51)
    else
        self.item_container:setContentSize(cc.size(312,95))
        self.reward_bg:setContentSize(cc.size(332, 125))
    end

    local scroll_view_size = self.item_container:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 10,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 10,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width * 0.8,               -- 单元的尺寸width
        item_height = BackPackItem.Height * 0.8,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.item_container, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    -- self.item_scrollview:setSwallowTouches(false)
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function()
        local list = self.item_scrollview:getItemList()
        for k,v in pairs(list) do
            v:setDefaultTip()
        end
    end)
    if #list == 1 then
        if self.reward_layer then
            self.reward_layer:setPosition(cc.p(pos.x+offsetX ,pos.y + 100 + offsetY))
        end
    elseif #list == 2 then
        self.reward_layer:setPosition(cc.p(pos.x + offsetX + 41 ,pos.y + 100 + offsetY))
        --判断是否超出屏幕之外--一般都是右边超出，如果有左边的就再说
        local right_posx =pos.x + offsetX + 93
        if right_posx > 720 then
            -- self.reward_bg:setPositionX(720-93)
            self.reward_layer:setPositionX(720)
        end
    else
        self.reward_layer:setPosition(cc.p(pos.x + 56,pos.y + 100 + offsetY))
        --判断是否超出屏幕之外--一般都是右边超出，如果有左边的就再说
        local right_posx = pos.x + 56 + 114 + 114
        if right_posx > 720 then
            self.reward_bg:setScaleX(-1)
            self.reward_layer:setPositionX(pos.x - 70)
        end
    end
end

function EserciseShowRewardWindowCopy:register_event()
	registerButtonEventListener(self.background, function()	
		EsecsiceController:getInstance():openEserciseShowRewardWindowCopy(false)
	end, false, 2)
end

function EserciseShowRewardWindowCopy:close_callback()
	if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    EsecsiceController:getInstance():openEserciseShowRewardWindowCopy(false)
end 