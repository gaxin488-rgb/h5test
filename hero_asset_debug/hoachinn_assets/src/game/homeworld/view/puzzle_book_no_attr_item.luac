local _controller = HomeworldController:getInstance()
local _model = _controller:getModel()
local _string_format = string.format

PuzzleBookNoAttrItem = class("PuzzleBookNoAttrItem", function()
    return ccui.Widget:create()
end)

function PuzzleBookNoAttrItem:ctor()
	self:configUI()
	self:registerEvent()
end

function PuzzleBookNoAttrItem:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_no_attr_item"))
	if not self.root_wnd then return end
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function PuzzleBookNoAttrItem:registerEvent(  )
end

-- shop_type:1家具商城 2:出行商城 3:随机商城
function PuzzleBookNoAttrItem:setData(_str)
	self._ui._no_tip:setString(_str)
	local _w = math.max(self._ui._no_tip_bg:getContentSize().width,self._ui._no_tip:getContentSize().width+50)
    local _h = math.max(self._ui._no_tip_bg:getContentSize().height,self._ui._no_tip:getContentSize().height+30)
    self._ui._no_tip_bg:setContentSize(cc.size(_w,_h))
    self._ui._no_tip:setPosition(cc.p(_w/2+10,_h/2))
end


function PuzzleBookNoAttrItem:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end