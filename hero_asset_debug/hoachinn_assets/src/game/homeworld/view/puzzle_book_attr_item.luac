local _controller = HomeworldController:getInstance()
local _model = _controller:getModel()

PuzzleBookAttrItem = class("PuzzleBookAttrItem", function()
    return ccui.Widget:create()
end)

function PuzzleBookAttrItem:ctor(_type)
	self.attr_type = _type or HomeworldConst.Attr_Type.lev_short
	self:configUI()
	self:registerEvent()
end

function PuzzleBookAttrItem:configUI(  )
	if self.attr_type == HomeworldConst.Attr_Type.lev_short then
		self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_attr_item"))
	elseif self.attr_type == HomeworldConst.Attr_Type.lev_lang then
		self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_attr_item2"))
	elseif self.attr_type == HomeworldConst.Attr_Type.lev_sp_lang then
		self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_attr_item3"))
	elseif self.attr_type == HomeworldConst.Attr_Type.lev_sp_short then
		self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_attr_item6"))
	end
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
end

function PuzzleBookAttrItem:registerEvent(  )
end

function PuzzleBookAttrItem:setData(data)
	if self.attr_type == HomeworldConst.Attr_Type.lev_sp_lang then
		local _txt = string.format(data[3],data[2])
		local num = 30
		if judgingLanguage() then
			num = 20
		end
		self._ui._attr_name:setString(transformTextToShort(_txt,num))
		addEvt2showAllTextTips(self._ui._attr_name,_txt,num,nil,nil,nil,nil,true)
	else
		local icon = PathTool.getAttrIconByStr(data[1])
		local res = PathTool.getResFrame("common", icon)
		loadSpriteTexture(self._ui._attr_icon, res, LOADTEXT_TYPE_PLIST)
		local _txt = Config.AttrData.data_key_to_name[data[1]]
		if not _txt then
			_txt = Config.AttrExtraData.data_key_to_name[data[1]]
		end
		local num = 10
		if judgingLanguage() then
			num = 5
		end
		self._ui._attr_name:setString(transformTextToShort(_txt,num))
		addEvt2showAllTextTips(self._ui._attr_name,_txt,num,nil,nil,nil,nil,true)
		local attr_val = data[2]
		local is_per = PartnerCalculate.isShowPerByStr(data[1])
		if is_per == true then
			attr_val = (attr_val/10).."%"
		end
		self._ui._attr_value:setString(attr_val)
	end
end

function PuzzleBookAttrItem:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end