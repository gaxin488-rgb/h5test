local _controller = HomeworldController:getInstance()
local _model = _controller:getModel()
local _string_format = string.format

PuzzlePageItem = class("PuzzlePageItem", function()
    return ccui.Widget:create()
end)

function PuzzlePageItem:ctor()
	self:configUI()
	self:registerEvent()
end

function PuzzlePageItem:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_page_item"))
	if not self.root_wnd then return end
    self.size = self.root_wnd:getContentSize()
    self:setAnchorPoint(cc.p(0.5, 0.5))
	self:setContentSize(self.size)
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
	self._ui._main_container:setSwallowTouches(false)
end

function PuzzlePageItem:registerEvent(  )
	registerButtonEventListener(self._ui._main_container,function()
        if self.back_fun then
			self:back_fun()
		end
    end,true,2,nil,nil,nil,true)
end

function PuzzlePageItem:addCallBack(back_fun)
	self.back_fun = back_fun
end
function PuzzlePageItem:setData(book_id,index)
	self.book_id = book_id
	self.index = index
	self._ui._page_name:setString(self.index)
end

function PuzzlePageItem:setSelect(status)
	self._ui._select_bg:setVisible(status)
	self._ui._normal_bg:setVisible(not status)
	if status then
		self._ui._page_name:enableOutline(cc.c4b(0xf0,0xee,0xe2,0xff), 2)
		self._ui._page_name:setPositionY(26)
	else
		self._ui._page_name:enableOutline(cc.c4b(0xd7,0xd4,0xc8,0xff), 2)
		self._ui._page_name:setPositionY(30)
	end
end

function PuzzlePageItem:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end