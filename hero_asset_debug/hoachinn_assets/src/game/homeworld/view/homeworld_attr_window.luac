        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 5,                   -- y方向的间隔
        item_width = 602,               -- 单元的尺寸width
        item_height = 30,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.suit_scrollview = CommonScrollViewLayout.new(suit_list_panel, cc.p(0, 0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size_2, setting)
    self.suit_scrollview:setSwallowTouches(false)

	local soft_list_panel = main_container:getChildByName("soft_list_panel")
	local scroll_view_size_3 = soft_list_panel:getContentSize()
    local setting = {
        item_class = HomeworldSoftItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 5,                   -- y方向的间隔
        item_width = 602,               -- 单元的尺寸width
        item_height = 30,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.soft_scrollview = CommonScrollViewLayout.new(soft_list_panel, cc.p(0, 0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size_3, setting)
    self.soft_scrollview:setSwallowTouches(false)
end

function HomeworldAttrwindow:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openHomeAttrWindow(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openHomeAttrWindow(false)
	end, false, 2)

	registerButtonEventListener(self.btn_rule, function ( param,sender, event_type )
		local rule_cfg = Config.HomeData.data_const["home_skill_rule"]
    	if rule_cfg then
    		TipsManager:getInstance():showAdventureBuffTipsScroll(rule_cfg.desc, sender:getTouchBeganPosition(), nil, nil, 550,nil)
    	end
	end, true, 1)

	-- 楼层数据
	self:addGlobalEvent(HomeworldEvent.Update_Storey_Info_Event, function ( data )
		self.story_data = data or {}
		self:setData()
	end)
end

function HomeworldAttrwindow:openRootWnd()
	local rolvo=RoleController:getInstance():getRoleVo()
	local rid =rolvo:getRoleRid()
	local srv_id =rolvo.srv_id
	_controller:sender26022(rid,srv_id) -- 请求家园数据
end

function HomeworldAttrwindow:setData(  )
	local data=self.story_data
	if not data then return end
	-- 攻击力
	self.attr_txt_1:setString(_string_format(TI18N("语言_c_5156"), data.atk))
	-- 血量
	self.attr_txt_2:setString(_string_format(TI18N("语言_c_5157"), data.hp_max))

	self.base_scrollview:setData(data.unit_list)
	self.suit_scrollview:setData(data.suit_list)
	local sort_func = SortTools.tableLowerSorter({"floor"})
    table.sort(data.soft_list,sort_func)
	self.soft_scrollview:setData(data.soft_list)
end

function HomeworldAttrwindow:close_callback( )
	if self.base_scrollview then
		self.base_scrollview:DeleteMe()
		self.base_scrollview = nil
	end
	if self.suit_scrollview then
		self.suit_scrollview:DeleteMe()
		self.suit_scrollview = nil
	end
	if self.soft_scrollview then
		self.soft_scrollview:DeleteMe()
		self.soft_scrollview = nil
	end
	_controller:openHomeAttrWindow(false)
end

--------------------------
HomeworldAttrItem = class("HomeworldAttrItem", function()
    return ccui.Widget:create()
end)

function HomeworldAttrItem:ctor()
	self:configUI()
	self:register_event()
end

function HomeworldAttrItem:configUI( )
	self.root_wnd = ccui.Layout:create()
    self.size = cc.size(602, 30)
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.root_wnd:setTouchEnabled(false)
    self:addChild(self.root_wnd)
end

function HomeworldAttrItem:register_event( )
	
end

function HomeworldAttrItem:setData( data )
	if not data then return end
    local item_cfg
	local limit_count
	if data.bid then 
		item_cfg=Config.ItemData.data_get_data(data.bid)
		limit_count= data.limit
	else
		item_cfg= Config.HomeData.data_suit_fun(data.id)
		limit_count= data.limit
	end

	if not item_cfg then return end

	if not self.name_txt then
		self.name_txt = createLabel(24, 274, nil, 20, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	if item_cfg.quality then
		self.name_txt:setTextColor(BackPackConst.getFUnitQualityColorC4B(item_cfg.quality))
	end
	self.name_txt:setString(transformTextToShort(item_cfg.name, 12))
    addEvt2showAllTextTips(self.name_txt, item_cfg.name, 12, nil, nil, nil, true, true)
	-- self.name_txt:setString(item_cfg.name)

	if not self.num_txt then
		self.num_txt = createLabel(24, 274, nil, 245, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.num_txt:setString(data.count .. "/" .. limit_count)

	if not self.atk_txt then
		self.atk_txt = createLabel(24, 274, nil, 410, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.atk_txt:setString(data.atk)

	if not self.hp_txt then
		self.hp_txt = createLabel(24, 274, nil, 520, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.hp_txt:setString(data.hp_max)

	if not self.atk_img then
		self.atk_img = createImage(self.root_wnd, PathTool.getResFrame("common", "common_90001"),390, self.size.height*0.5, cc.p(0.5, 0.5), true)
	end
	
	if not self.hp_img then
		self.hp_img = createImage(self.root_wnd, PathTool.getResFrame("homeworld", "homeworld_1075"),500, self.size.height*0.5, cc.p(0.5, 0.5), true)
	end
end

function HomeworldAttrItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end

--------------------------
HomeworldSoftItem = class("HomeHomeworldSoftItem", function()
    return ccui.Widget:create()
end)

function HomeworldSoftItem:ctor()
	self:configUI()
	self:register_event()
end

function HomeworldSoftItem:configUI(  )
	self.root_wnd = ccui.Layout:create()
    self.size = cc.size(602, 30)
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.root_wnd:setTouchEnabled(false)
    self:addChild(self.root_wnd)
end

function HomeworldSoftItem:register_event(  )
	
end

function HomeworldSoftItem:setData( data )
	if not data then return end

	if not self.index_txt then
		self.index_txt = createLabel(24, 274, nil, 20, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.index_txt:setString(string.format(TI18N("语言_c_5166"),data.floor))

	if not self.soft_txt then
		self.soft_txt = createLabel(24, 274, nil, 245, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.soft_txt:setString(data.soft)

	if not self.per_txt then
		self.per_txt = createLabel(24, 274, nil, 450, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.per_txt:setVisible(false)
	self.per_txt:setString((data.per/10).."%")

	if not self.attr_add_txt then
		self.attr_add_txt = createRichLabel(22,cc.c3b(0x0e,0xa8,0x0e),cc.p(0.5,0.5),cc.p(470,self.size.height*0.5))
		self.root_wnd:addChild(self.attr_add_txt)
	end
	self.attr_add_txt:setVisible(false)
	local txt = "<img src=%s />%s"
	local str = ""
	for k,v in ipairs(data.attr_list or {}) do
		local key = Config.AttrData.data_id_to_key[v.attr_id]
		local res = ""
		if key == "atk" then
			res = PathTool.getResFrame("common", "common_90001")
		else
			res = PathTool.getResFrame("homeworld", "homeworld_1075")
		end
		str = str .."  ".. string.format(txt,res,v.attr_num)
	end
	self.attr_add_txt:setString(str)

	local cfg = Config.HomeData.data_home_storey[data.floor]
	if cfg.type == 0 then
		self.per_txt:setVisible(true)
		self.attr_add_txt:setVisible(false)
	else
		self.per_txt:setVisible(false)
		self.attr_add_txt:setVisible(true)
	end
end

function HomeworldSoftItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end