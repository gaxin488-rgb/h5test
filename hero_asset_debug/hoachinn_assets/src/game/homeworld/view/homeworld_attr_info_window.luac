		for _, suit_info in pairs(suit_list) do
			-- 处理基础属性加成
			local suit_id_list = Config.HomeData.data_suit_unit[suit_info.set_id]
			if suit_id_list then
				for k, id in pairs(suit_id_list) do
					local is_had = _model:isHadFurnitureByBid(id)
					if is_had then
						local unit_cfg = Config.HomeData.data_home_unit(id)
						_table_insert(self.base_data_list, unit_cfg)
					end
				end
			end
			-- 处理套装属性加成
			local suit_cfg, suit_count = _model:getSuitAttr(suit_info.set_id)
			if next(suit_cfg) and suit_count and suit_count ~= 0 then
				local temp_data = {}
				temp_data.attr = suit_cfg.attr
				temp_data.attr_num = suit_cfg.attr_num
				temp_data.name = suit_info.name
				temp_data.have_num = suit_count
				_table_insert(self.suit_data_list, temp_data)
			end
		end
		-- self:setBaseTotalTxt()
	end
	self.base_scrollview:reloadData()
	self.suit_scrollview:reloadData()
end

function HomeworldAttrInfoWindow:updateSoftList(data)
	if data and data.soft_list then
		self.soft_data_list = data.soft_list
		_table_sort(self.soft_data_list, SortTools.KeyLowerSorter("floor"))
		self.soft_scrollview:reloadData()
	end
end

