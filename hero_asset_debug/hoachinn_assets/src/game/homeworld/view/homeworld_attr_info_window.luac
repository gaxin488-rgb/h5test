function HomeworldAttrInfoWindow:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openHomeBonusOverviewPanel(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openHomeBonusOverviewPanel(false)
	end, false, 2)

	registerButtonEventListener(self.btn_rule, function ( param,sender, event_type )
		local rule_cfg = Config.HomeData.data_const["home_attr_rule"]
    	if rule_cfg then
    		TipsManager:getInstance():showCommonTips(rule_cfg.desc, sender:getTouchBeganPosition(), nil, nil, 550)
    	end
	end, true, 1)

	-- 更新所有楼层舒适度
	self:addGlobalEvent(HomeworldEvent.Update_All_floor_Soft, function ( data )
		-- 属性
		local total_attr = _model:getAllTotalAttr()
		local soft_additoin_list = _model:getAllSoftAddition(data)
		for i, v in pairs(total_attr) do
			if self.attr_bg_list[i] and self.attr_icon_list[i] and self.attr_label_list[i] then
				self.attr_bg_list[i]:setVisible(true)
				self.attr_icon_list[i]:setVisible(true)
				self.attr_label_list[i]:setVisible(true)
				local icon_path, attr_name = _model:getAttrIconPathAndName(v[1])
				loadSpriteTexture(self.attr_icon_list[i], icon_path, LOADTEXT_TYPE_PLIST)
				local soft_add_per = 0
				if soft_additoin_list then
					for _, attr_per in pairs(soft_additoin_list) do
						if v[1] .. "_per" == attr_per[1] then
							soft_add_per = attr_per[2] / 1000
							break
						end
					end
				end
				self.attr_label_list[i]:setString(attr_name .. (v[2] + math.floor((v[2] * soft_add_per) + 0.5)))
			end
		end
        self:updateSoftList(data)
    end)
end

function HomeworldAttrInfoWindow:openRootWnd(  )
	_controller:sender26025()
	self:setData()
end

