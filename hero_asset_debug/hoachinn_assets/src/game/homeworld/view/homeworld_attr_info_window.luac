local _controller = HomeworldController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local _string_format = string.format
local _table_sort = table.sort

HomeworldAttrInfoWindow = HomeworldAttrInfoWindow or BaseClass(BaseView)

function HomeworldAttrInfoWindow:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "homeworld/homeworld_attr_info_window"
	self.base_data_list = {}
	self.suit_data_list = {}
	self.soft_data_list = {}
	self.attr_bg_list = {}
	self.attr_icon_list = {}
	self.attr_label_list = {}
	--[[self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("homeworld", "homeworld"), type = ResourcesType.plist},
	}--]]
end

function HomeworldAttrInfoWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container
    self:playEnterAnimatianByObj(self.main_container , 1) 

	local cur_storey_index = _model:getMyHomeCurStoreyIndex()
	main_container:getChildByName("win_title"):setString(TI18N("属性加成总览"))
	main_container:getChildByName("title_label_1"):setString(TI18N("概况总览"))
	main_container:getChildByName("title_label_2"):setString(TI18N("家具属性基础加成"))
	main_container:getChildByName("title_label_3"):setString(TI18N("家具套装加成"))
	main_container:getChildByName("title_label_4"):setString(TI18N("舒适度加成"))
	main_container:getChildByName("title_txt_1"):setString(TI18N("家具名"))
	main_container:getChildByName("title_txt_2"):setString(TI18N("家具属性基础加成"))
	main_container:getChildByName('title_txt_3'):setString(TI18N("套装名"))
	main_container:getChildByName("title_txt_4"):setString(TI18N("套件数量"))
	main_container:getChildByName("title_txt_5"):setString(TI18N("家具套装加成"))
	main_container:getChildByName("title_txt_6"):setString(TI18N("数量"))
	main_container:getChildByName("title_txt_7"):setString(TI18N("楼层"))
	main_container:getChildByName("title_txt_8"):setString(TI18N("楼层舒适度"))
	main_container:getChildByName("title_txt_9"):setString(TI18N("舒适度加成"))
	main_container:getChildByName("tips_label"):setVisible(false)--setString(TI18N("解锁家具、增加收集进度、提升每层舒适度均可加成英雄属性！"))
	local tips_label =  createRichLabel(18, cc.c4b(0x95,0x53,0x22,0xff), cc.p(0.5,0.5), cc.p(340, 44), 4, nil, 600)
    main_container:addChild(tips_label)
    tips_label:setString(TI18N("解锁家具、增加收集进度、提升每层舒适度均可加成英雄属性！"))

	self.close_btn = main_container:getChildByName("close_btn")
	self.btn_rule = main_container:getChildByName("btn_rule")
	self.base_total_txt = main_container:getChildByName("base_total_txt")
	self.base_total_txt:setVisible(false)
	self.suit_total_txt = main_container:getChildByName("suit_total_txt")
	self.soft_total_txt = main_container:getChildByName("soft_total_txt")
	self.soft_txt_floor = main_container:getChildByName("soft_txt_floor")
	self.soft_txt_num = main_container:getChildByName("soft_txt_num")
	self.soft_txt_add = main_container:getChildByName("soft_txt_add")

	for i = 1, 2 do
		local attr_bg = main_container:getChildByName("attr_bg_" .. i)
		local attr_icon = main_container:getChildByName("attr_icon_" .. i)
		local attr_label = main_container:getChildByName("attr_label_" .. i)
		self.attr_bg_list[i] = attr_bg
		self.attr_icon_list[i] = attr_icon
		self.attr_label_list[i] = attr_label
	end

	local base_list_panel = main_container:getChildByName("base_list_panel")
	if self.base_scrollview == nil then
        local scroll_view_size = base_list_panel:getContentSize()
        local setting = {
            start_x = 0,                  -- 第一个单元的X起点
			space_x = 0,                    -- x方向的间隔
			start_y = 0,                    -- 第一个单元的Y起点
			space_y = 5,                   -- y方向的间隔
			item_width = 602,               -- 单元的尺寸width
			item_height = 30,              -- 单元的尺寸height
			row = 0,                        -- 行数，作用于水平滚动类型
			col = 1,                         -- 列数，作用于垂直滚动类型
            delay = 4,                       -- 创建延迟时间
            once_num = 1,                    -- 每次创建的数量
			need_dynamic = true
        }
        self.base_scrollview = CommonScrollViewSingleLayout.new(base_list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.base_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.base_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.base_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
    self.base_scrollview:setSwallowTouches(false)

	local suit_list_panel = main_container:getChildByName("suit_list_panel")
	if self.suit_scrollview == nil then
        local scroll_view_size = suit_list_panel:getContentSize()
        local setting = {
            start_x = 0,                  -- 第一个单元的X起点
			space_x = 0,                    -- x方向的间隔
			start_y = 0,                    -- 第一个单元的Y起点
			space_y = 5,                   -- y方向的间隔
			item_width = 602,               -- 单元的尺寸width
			item_height = 30,              -- 单元的尺寸height
			row = 0,                        -- 行数，作用于水平滚动类型
			col = 1,                         -- 列数，作用于垂直滚动类型
            delay = 4,                       -- 创建延迟时间
            once_num = 1,                    -- 每次创建的数量
			need_dynamic = true
        }
        self.suit_scrollview = CommonScrollViewSingleLayout.new(suit_list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.suit_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell1), ScrollViewFuncType.CreateNewCell) --创建cell
        self.suit_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells1), ScrollViewFuncType.NumberOfCells) --获取数量
        self.suit_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex1), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
	self.suit_scrollview:setSwallowTouches(false)
	
	local soft_add_list = main_container:getChildByName("soft_add_list")
	if self.soft_scrollview == nil then
        local scroll_view_size = soft_add_list:getContentSize()
        local setting = {
            start_x = 0,                  -- 第一个单元的X起点
			space_x = 0,                    -- x方向的间隔
			start_y = 0,                    -- 第一个单元的Y起点
			space_y = 5,                   -- y方向的间隔
			item_width = 602,               -- 单元的尺寸width
			item_height = 30,              -- 单元的尺寸height
			row = 0,                        -- 行数，作用于水平滚动类型
			col = 1,                         -- 列数，作用于垂直滚动类型
            delay = 4,                       -- 创建延迟时间
            once_num = 1,                    -- 每次创建的数量
			need_dynamic = true
        }
        self.soft_scrollview = CommonScrollViewSingleLayout.new(soft_add_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.soft_scrollview:registerScriptHandlerSingle(handler(self,self.createNewCell2), ScrollViewFuncType.CreateNewCell) --创建cell
        self.soft_scrollview:registerScriptHandlerSingle(handler(self,self.numberOfCells2), ScrollViewFuncType.NumberOfCells) --获取数量
        self.soft_scrollview:registerScriptHandlerSingle(handler(self,self.updateCellByIndex2), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
	self.soft_scrollview:setSwallowTouches(false)
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HomeworldAttrInfoWindow:createNewCell(width, height)
    local cell = HomeworldAttrInfoBaseItem.new()
	return cell
end

--获取数据数量
function HomeworldAttrInfoWindow:numberOfCells()
    if not self.base_data_list then return 0 end
    return #self.base_data_list
end

--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function HomeworldAttrInfoWindow:updateCellByIndex(cell, index)
    if not self.base_data_list then return end
    cell.index = index
    if self.tab ~= nil and cell.setExtendData ~= nil then
        cell:setExtendData(self.tab)
    end
    local cell_data = self.base_data_list[index]
    if not cell_data then return end
    cell:setData(cell_data)
end

--创建cell 
--@width 是setting.item_width
--@height 是setting.item_height
function HomeworldAttrInfoWindow:createNewCell1(width, height)
    local cell = HomeworldAttrInfoSuitItem.new()
	return cell
end

--获取数据数量
