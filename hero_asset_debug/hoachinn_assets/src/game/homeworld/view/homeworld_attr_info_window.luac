HomeworldAttrInfoSuitItem = class("HomeworldAttrInfoSuitItem", function()
    return ccui.Widget:create()
end)

function HomeworldAttrInfoSuitItem:ctor()
	self:configUI()
	self:register_event()
end

function HomeworldAttrInfoSuitItem:configUI(  )
	self.root_wnd = ccui.Layout:create()
    self.size = cc.size(602, 30)
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.root_wnd:setTouchEnabled(false)
    self:addChild(self.root_wnd)
end

function HomeworldAttrInfoSuitItem:register_event(  )
	
end

function HomeworldAttrInfoSuitItem:setData( data )
	if not data then return end

	if not self.name_txt then
		self.name_txt = createLabel(24, 274, nil, 20, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.name_txt:setString(data.name)

	if not self.num_txt then
		self.num_txt = createLabel(24, 274, nil, 258, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
	end
	self.num_txt:setString(data.have_num .. "/" .. data.attr_num)

	if not self.suit_txt then
		-- self.suit_txt = createLabel(24, 274, nil, 463, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
		self.suit_txt = createRichLabel(24, 274, cc.p(0, 0.5), cc.p(360, self.size.height*0.5), nil, nil, 300)
		self.root_wnd:addChild(self.suit_txt)
	end
	local attr_str = ""
	for i, v in ipairs(data.attr) do
		local attr_key = v[1]
		local attr_val = v[2]
		local icon_path = _model:getAttrIconPathAndName(attr_key)
		local attr_name = Config.AttrData.data_key_to_name[attr_key]
		local is_per = PartnerCalculate.isShowPerByStr(attr_key)
		if is_per == true then
			attr_val = (attr_val*0.1).."%"
		end
		local cur_attr_str = _string_format("<img src='%s' scale=1 />%s", icon_path, attr_val)
		if attr_val > 999 then
			cur_attr_str = cur_attr_str .. "   "
		elseif attr_val > 99 then
			cur_attr_str = cur_attr_str .. "      "
		elseif attr_val > 9 then
			cur_attr_str = cur_attr_str .. "         "
		end
		attr_str = _string_format("%s%s ", attr_str , cur_attr_str)
	end
	self.suit_txt:setString(attr_str)
end

function HomeworldAttrInfoSuitItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end

