function HomeworldAttrInfoWindow:close_callback(  )
	if self.base_scrollview then
		self.base_scrollview:DeleteMe()
		self.base_scrollview = nil
	end
	if self.suit_scrollview then
		self.suit_scrollview:DeleteMe()
		self.suit_scrollview = nil
	end
	if self.soft_scrollview then
		self.soft_scrollview:DeleteMe()
		self.soft_scrollview = nil
	end
	_controller:openHomeBonusOverviewPanel(false)
end

--------------------------
HomeworldAttrInfoBaseItem = class("HomeworldAttrInfoBaseItem", function()
    return ccui.Widget:create()
end)

function HomeworldAttrInfoBaseItem:ctor()
	self:configUI()
	self:register_event()
end

function HomeworldAttrInfoBaseItem:configUI(  )
	self.root_wnd = ccui.Layout:create()
    self.size = cc.size(602, 30)
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.root_wnd:setTouchEnabled(false)
    self:addChild(self.root_wnd)
end

function HomeworldAttrInfoBaseItem:register_event(  )
	
end

function HomeworldAttrInfoBaseItem:setData( data )
	if not data then return end

	local item_cfg = Config.ItemData.data_get_data(data.bid)
	local unit_cfg = data
	if not item_cfg or not unit_cfg then return end

	if not self.name_txt then
		self.name_txt = createLabel(24, 1, nil, 20, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.name_txt:setTextColor(BackPackConst.getWhiteQualityColorC4B(item_cfg.quality))
	self.name_txt:setString(unit_cfg.name)

	if not self.num_txt then
		self.num_txt = createLabel(24, 274, nil, 286, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
	end
	self.num_txt:setString("1/1")

	if not self.attr_txt then
		-- self.attr_txt = createLabel(24, 274, nil, 485, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
		self.attr_txt = createRichLabel(24, 274, cc.p(0, 0.5), cc.p(380, self.size.height*0.5), nil, nil, 300)
		self.root_wnd:addChild(self.attr_txt)
	end
	local attr_str = ""
	for i, v in ipairs(unit_cfg.attr) do
		local attr_key = v[1]
		local attr_val = v[2]
		local icon_path = _model:getAttrIconPathAndName(attr_key)
		local is_per = PartnerCalculate.isShowPerByStr(attr_key)
		if is_per == true then
			attr_val = (attr_val*0.1).."%"
		end
		local cur_attr_str = _string_format("<img src='%s' scale=1 />%s", icon_path, attr_val)
		if attr_val > 99 then
			cur_attr_str = cur_attr_str .. "   "
		elseif attr_val > 9 then
			cur_attr_str = cur_attr_str .. "      "
		end
		attr_str = _string_format("%s%s ", attr_str , cur_attr_str)
	end
	self.attr_txt:setString(attr_str)
end

function HomeworldAttrInfoBaseItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end

