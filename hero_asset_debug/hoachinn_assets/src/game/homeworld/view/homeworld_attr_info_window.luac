HomeworldAttrInfoSoftItem = class("HomeworldAttrInfoSoftItem", function()
    return ccui.Widget:create()
end)

function HomeworldAttrInfoSoftItem:ctor()
	self:configUI()
	self:register_event()
end

function HomeworldAttrInfoSoftItem:configUI(  )
	self.root_wnd = ccui.Layout:create()
    self.size = cc.size(602, 30)
    self.root_wnd:setContentSize(self.size)
    self:setContentSize(self.size)
    self.root_wnd:setTouchEnabled(false)
    self:addChild(self.root_wnd)
end

function HomeworldAttrInfoSoftItem:register_event(  )
	
end

function HomeworldAttrInfoSoftItem:setData( data )
	if not data then return end

	if not self.name_txt then
		self.name_txt = createLabel(24, 274, nil, 20, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0, 0.5))
	end
	self.name_txt:setString(_string_format(TI18N("第%s层"), StringUtil.numToChinese(data.floor)))

	if not self.num_txt then
		self.num_txt = createLabel(24, 274, nil, 300, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
	end
	self.num_txt:setString(data.soft)

	if not self.soft_txt then
		self.soft_txt = createLabel(24, 274, nil, 507, self.size.height*0.5, nil, self.root_wnd, nil, cc.p(0.5, 0.5))
	end
	local soft_add_cfg = _model:getSoftAdditionCfg(data.floor, data.soft)
	if soft_add_cfg then
		self.soft_txt:setString(soft_add_cfg.show_per)
	else
        self.soft_txt:setString("0%")
	end
end

function HomeworldAttrInfoSoftItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end