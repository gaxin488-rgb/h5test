function PuzzleBookMainWindow:openRootWnd()
    if not model.puzzle_book_list then
        controller:sender26024()
    end
    self:setData()
    self:changeTabFun(2)
end
function PuzzleBookMainWindow:updateLevel()
    self.book_level = model:getPuzzleBookLev()
    self._book_level:setNum(self.book_level)
    self.lev_cfg = Config.PuzzleBookData.data_level[self.book_level+1]
    if not self.lev_cfg then
        self.lev_cfg = Config.PuzzleBookData.data_level[#Config.PuzzleBookData.data_level]
    end
    self._ui._bar:setPercent(model:getPuzzleBookExp()/self.lev_cfg.need_exp*100)
    self._ui._bar_txt:setString(string.format("%s/%s",model:getPuzzleBookExp(),self.lev_cfg.need_exp))
end
function PuzzleBookMainWindow:setData()
    self:updateLevel()
    local list = model:getPuzzleBookListData()
    self.show_list = {}
    for k, v in pairs(list) do
        local is_act = model:getOnePuzzleIsInAct(v)
        table.insert(self.show_list, {is_act = is_act and 1 or 2,id=v})
    end
    
    local sort_func = SortTools.tableCommonSorter({{"is_act", false}, {"id", true}})
    table.sort(self.show_list, sort_func)
    self.list_view:reloadData()
end
function PuzzleBookMainWindow:close_callback()
    if self._book_level then
        self._book_level:DeleteMe()
    end
    self._book_level = nil
    if self.list_view then
        self.list_view:DeleteMe()
        self.list_view = nil
    end
    controller:openPuzzleBookMainWindow(false)
end