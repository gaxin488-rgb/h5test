		-- 拼图图鉴属性条组件
---------------------------------
local _controller = HomeworldController:getInstance()
local _model = _controller:getModel()

PuzzleBookAttrItem5 = class("PuzzleBookAttrItem5", function()
    return ccui.Widget:create()
end)

function PuzzleBookAttrItem5:ctor(_type)
	self.attr_type = _type or HomeworldConst.Attr_Type.lev_short
	self:configUI()
	self:registerEvent()
end

function PuzzleBookAttrItem5:configUI(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("homeworld/puzzle_book_attr_item5"))
	if not self.root_wnd then return end
	self:setCascadeOpacityEnabled(true)

	self.root_wnd:setAnchorPoint(0.5, 0.5)
	self:addChild(self.root_wnd)
	self._ui = getAllCsbExportChildren(self.root_wnd)
	self._attr_txt = createRichLabel(22,cc.c3b(0x62,0x35,0x11),cc.p(0.5,0.5),cc.p(283,17),-8,nil,540)
    self._attr_txt:setHorizontalLayoutType(2)
    self._ui._main_container:addChild(self._attr_txt)
end

function PuzzleBookAttrItem5:registerEvent(  )
end

function PuzzleBookAttrItem5:setData(book_id,num)
	self.book_id = book_id
	self.puzzle_num = num
	self.data = _model:getOnePuzzleData(book_id)
	self.puzzle_cfg = Config.PuzzleBookData.data_puzzle_attr[self.book_id]
	if not self.puzzle_cfg then return end
	self.cfg = self.puzzle_cfg[self.puzzle_num]
	if not self.cfg then return end
	if next(self.cfg.attr1) or next(self.cfg.attr2) then
		local txt = ""
		for k, v in ipairs(self.cfg.show_attr) do
			local _txt = Config.AttrData.data_key_to_name[v[1]]
			if not _txt then
				_txt = Config.AttrExtraData.data_key_to_name[v[1]]
			end
			local attr_val = v[2]
			local is_per = PartnerCalculate.isShowPerByStr(v[1])
			if is_per == true then
				attr_val = (attr_val/10).."%"
			end
			if txt == "" then
				txt = string.format("%s+%s",_txt,attr_val)
			else
				txt = txt .. "," ..string.format("%s+%s",_txt,attr_val)
			end
		end
		self._attr_txt:setString(string.format(self.cfg.up_page_str, txt))
	else
		if self.cfg.special_buff then
			local attr_val = self.cfg.special_buff[1][2]
			local _txt = string.format(self.cfg.attr_str,attr_val)
			self._attr_txt:setString(string.format(self.cfg.up_page_str,self.puzzle_num, _txt))
		end
	end
	local _w = self.root_wnd:getContentSize().width
	local _h = math.max(self.root_wnd:getContentSize().height,self._attr_txt:getContentSize().height+4)
	self.size = cc.size(_w,_h)
	self.root_wnd:setContentSize(self.size)
    self:setAnchorPoint(cc.p(0, 1))
	self:setContentSize(self.size)
	self.root_wnd:setPosition(self.size.width/2, self.size.height/2)
	self._ui._main_container:setContentSize(self.size)
	self._ui._main_container:setPositionY(self.size.height*0.5)
	self._attr_txt:setPositionY(self.size.height*0.5)
end

function PuzzleBookAttrItem5:DeleteMe(  )

	self:removeAllChildren()
	self:removeFromParent()
end