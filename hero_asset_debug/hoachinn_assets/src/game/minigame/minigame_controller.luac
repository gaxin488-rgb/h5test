function MinigameController:requestMinigameBegin()
    local protocal = {}
    self:SendProtocal(29501, protocal)
end

function MinigameController:handle29501(data)
    -- print("-------------->>>>>handle29501 ", vardump(data))
    self.model:beginRun(data)
    if self.model:checkEnterData() then
        if self.minigame_window then
            self.minigame_window:loadBattleRes(function()
                MinigameController:getInstance():openMinigameView(true)
            end)
        end
    end
end

