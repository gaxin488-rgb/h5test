MinigameController = MinigameController or BaseClass(BaseController)

function MinigameController:config()
    self.model = MinigameModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function MinigameController:getModel()
    return self.model
end

function MinigameController:getChampionModel()

end

function MinigameController:registerEvents()
end

--==============================--
--desc:请求一些相关数据
--time:
--@return 
--==============================--
function MinigameController:requestInitProtocal()
end

function MinigameController:registerProtocals()
    self:RegisterProtocal(29500, "handle29500")  --红蓝对冲基础信息
    self:RegisterProtocal(29501, "handle29501")
    self:RegisterProtocal(29502, "handle29502")
    self:RegisterProtocal(29503, "handle29503")
end

