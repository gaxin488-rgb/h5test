    --         ,{uint32, total_count, "当前等级的总战斗次数"}
    --     ]
    -- }
]]
function MinigameController:requestMinigameResult(result)
    local protocal = {}
    protocal.is_win = result
    self:SendProtocal(29502, protocal)
end

function MinigameController:handle29502(data)
    -- print("-------------->>>>>handle29502 ", vardump(data))
    local base_data = self.model:getBaseData()
    data.old_level = base_data.level
    data.result = (data.flag == 1 and data.is_win == 1) and 1 or 2
    if data.result == 2 then
        message(data.msg)
    end
    self.model:settlementResult(data)
    self:openMinigameBattleResult(true, data)
    MainuiController:getInstance():setFunctionTipsStatus(MainuiConst.icon.redblue, self.model:checkTimesEnought())
end


--排行榜
function MinigameController:send_29503( rank_type,start,num ,is_cluster)
    --请求排行榜
    local cluster = 0
    if is_cluster == true then
        cluster = 1
    end
    local protocal = {}
    protocal.type = rank_type
    protocal.start = start or 1
    protocal.num = num or 100
    protocal.is_cluster = cluster
    self:SendProtocal(29503,protocal)
end
function MinigameController:handle29503( data )
    if data then
        GlobalEvent:getInstance():Fire(MinigameEvent.MinigameRankEvent_Get_Rank_data,data)
    end
end


function MinigameController:openMinigameView(status, data)
    if not status then
        if self.minigame_view ~= nil then
            self.minigame_view:close()
            self.minigame_view = nil
        end
    else
        if self.minigame_view == nil then
            self.minigame_view = Minigameview.New(data)
        end
        self.minigame_view:open()
    end
end

function MinigameController:getMinigameView()
    return self.minigame_view
end

function MinigameController:openMinigameWindow(status, setting)
    if not status then
        if self.minigame_window ~= nil then
            self.minigame_window:close()
            self.minigame_window = nil
            -- print("fire----------------------------------------------------")
            GlobalEvent:getInstance():Fire(GuideEvent.Check_Guide_Open_Event) --检测是否触发剧情
        end
    else
        if self.minigame_window == nil then
            self.minigame_window = MinigameWindow.New()
        end
        self.minigame_window:open(setting)
    end
end

function MinigameController:getMinigameWindowsRoot()
    return self.minigame_window.root_wnd
end

function MinigameController:openMinigameBattleResult(status, setting)
    if not status then
        if self.minigame_battle_result ~= nil then
            self.minigame_battle_result:close()
            self.minigame_battle_result = nil
        end
    else
        if self.minigame_battle_result == nil then
            self.minigame_battle_result = MinigameBattleResult.new()
        end
        if self.minigame_battle_result.open then
            self.minigame_battle_result:open(setting)
        end
    end
end

