end

function MinigameController:handle29500(data)
    -- print("-------------->>>>>handle29500 ", vardump(data))
    self.model:setBaseData(data)
    MainuiController:getInstance():setFunctionTipsStatus(MainuiConst.icon.redblue, self.model:checkTimesEnought())
    GlobalEvent:getInstance():Fire(MinigameEvent.Enter_basedata_back)
    -- self:requestMinigameBegin()
end

