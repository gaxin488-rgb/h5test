MinigameModel = MinigameModel or BaseClass()


function MinigameModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function MinigameModel:config()

end

function MinigameModel:setBaseData(data)
    -- {
    --     count = 0,
    --     level = 1,
    --     total_count = 0,
    --     win_count = 0,
    -- }
    self.base_data = data
end

function MinigameModel:getBaseData()
    return self.base_data
end
--次数
function MinigameModel:checkTimesEnought()
    if Config.MinigameMobcontrolData then
        return (Config.MinigameMobcontrolData.data_const["limit_times"].val - self.base_data.count > 0)
    else
        return 0
    end
end

function MinigameModel:beginRun(data)
    -- {
    --     flag = 0,
    --     level_id = 101,
    -- }
    self.level_data = data
end

function MinigameModel:getLevelId()
    return self.level_data.level_id
end

function MinigameModel:checkEnterData()
    if self.level_data then
        if self.level_data.flag == 1 then -- 成功
            return true
        end
    end
    message(self.level_data.msg)
    return false
end

function MinigameModel:settlementResult(data)
    -- {
    --     count = 1,
    --     flag = 0,
    --     level = 1,
    --     total_count = 1,
    --     win_count = 1,
    -- }
    self.base_data.count = data.count
    self.base_data.level = data.level
    self.base_data.total_count = data.total_count
    self.base_data.win_count = data.win_count
end

----tool
function MinigameModel:getImageType(res)
    local str = string.split(res, ",")
    local image_name, image_type, image_plist = str[1], str[2], str[3]
    return image_name or "", tonumber(image_type or 0), image_plist or ""
end

function MinigameModel:__delete()
end
