MinigameBattleResult = class("MinigameBattleResult", function()
    return ccui.Widget:create()
end)
local controller = MinigameController:getInstance()

function MinigameBattleResult:ctor()
    local scene = cc.Director:getInstance():getRunningScene()
    scene:addChild(self)
    self:setPosition(cc.p(display.width/2, display.height/2))
    self.confirm_callback = confirm_callback or {}
    self.effect_cache_list = {}
    self.item_list = {}
    self:configUI()
    self:register_event()
end

function MinigameBattleResult:configUI()
    local csbPath = PathTool.getTargetCSB("minigame/minigame_battle_result")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setAnchorPoint(cc.p(0.5, 0.5))

    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")

    self.fail_bg = container:getChildByName("fail_bg")
    self.fail_bg.text_des = self.fail_bg:getChildByName("text_des")
    self.fail_bg.text_des:setTextAreaSize(cc.size(700,0))
    self.fail_bg.text_des:setString(TI18N("语言_c_g_94"))

    self.success_bg = container:getChildByName("success_bg")
    local Sprite_7 = self.success_bg:getChildByName("Sprite_7")
    self.wins_label = self.success_bg:getChildByName("wins_label")

    self.text_level = self.success_bg:getChildByName("text_level")
    self.sp_up = self.success_bg:getChildByName("sp_up")
    
    self.text_reward_des = self.success_bg:getChildByName("text_reward_des")
    self.text_reward_des:setString(TI18N("语言_c_g_79"))
    local image_mark_1 = self.success_bg:getChildByName("image_mark_1")
    if image_mark_1 then
        image_mark_1:setPositionX(self.text_reward_des:getPositionX() - self.text_reward_des:getContentSize().width/2 - 50)
    end
    local image_mark_2 = self.success_bg:getChildByName("image_mark_2")
    if image_mark_2 then
        image_mark_2:setPositionX(self.text_reward_des:getPositionX() + self.text_reward_des:getContentSize().width/2 + 50)
    end
    self.layout_item = self.success_bg:getChildByName("layout_item")

    self.title_container = self.root_wnd:getChildByName("title_container")
    self.title_width = self.title_container:getContentSize().width
    self.title_height = self.title_container:getContentSize().height

    self.container = container

    self.Sprite_1 = self.success_bg:getChildByName("Sprite_1")
    if self.sprite_1_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_97")
        self.sprite_1_load = loadSpriteTextureFromCDN(self.Sprite_1, res, ResourcesType.single, self.sprite_1_load)
    end
    
    self.Sprite_2 = self.success_bg:getChildByName("Sprite_2")
    if self.sprite_2_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_98")
        self.sprite_2_load = loadSpriteTextureFromCDN(self.Sprite_2, res, ResourcesType.single, self.sprite_2_load)
    end
end

