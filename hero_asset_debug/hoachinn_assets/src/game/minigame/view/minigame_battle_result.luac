function MinigameBattleResult:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            local data = clone(self.data)
            local is_up = self.data.level > self.data.old_level
            playCloseSound()
            controller:openMinigameBattleResult(false)
            MinigameController:getInstance():openMinigameView(false)
            GlobalEvent:getInstance():Fire(MinigameEvent.Enter_basedata_back)
            if is_up then
                controller:openMinigameLevelUpView(true, data)
            end
        end
    end)
end


function MinigameBattleResult:handleEffect(status)
    if status == false then
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
        if self.play_effect2 then
            self.play_effect2:clearTracks()
            self.play_effect2:removeFromParent()
            self.play_effect2 = nil
        end
    else
        local effect_id = 103
        local action = PlayerAction.action_2
        local effect_partner = self.title_container
        if self.data.result == 2 then
            effect_id = 104
            action = PlayerAction.action
            effect_partner = self.fail_bg
        end
        if not tolua.isnull(effect_partner) and self.play_effect == nil then
            self.play_effect = createEffectSpine(PathTool.getEffectRes(effect_id), cc.p(effect_partner:getContentSize().width*0.5,effect_partner:getContentSize().height*0.5), cc.p(0.5, 0.5), false, action)
            effect_partner:addChild(self.play_effect, 1)
        end
        if not tolua.isnull(self.title_container) and self.play_effect2 == nil then
			if self.data.result == 1 then
				self.play_effect2 = createEffectSpine("E51022", cc.p(self.title_width * 0.5, self.title_height * 0.5), cc.p(0.5, 0.5), true, PlayerAction.action)
				self.title_container:addChild(self.play_effect2, 1)
			end
		end
        
    end
end

function MinigameBattleResult:open(data)
    if data ~= nil then
        self.data = data
        self:setBaseInfo()
        self:setRewardsList()
        self.success_bg:setVisible(data.result == 1)
        self.fail_bg:setVisible(data.result == 2)
        self:handleEffect(true)
        -- if data.result == 2 then
        --     playOtherSound("b_win", AudioManager.AUDIO_TYPE.BATTLE)
        -- end
    end
end

function MinigameBattleResult:setBaseInfo()
    if self.data == nil then return end
    local config = Config.MinigameMobcontrolData.data_level_dif_info[self.data.level]
    self.text_level:setString(TI18N("语言_c_505")..config.level_title)
    local next_config = Config.MinigameMobcontrolData.data_level_dif_info[self.data.level + 1]
    if not next_config then
        self.wins_label:setString(string.format(TI18N("语言_c_g_81")))
    else
        self.wins_label:setString(string.format(TI18N("语言_c_g_78"), self.data.win_count, config.up_condition))
    end
    local is_up = self.data.level > self.data.old_level
    self.sp_up:setVisible(is_up)
    self.sp_up:setPosition(cc.p(self.text_level:getPositionX() + self.text_level:getContentSize().width/2 + 40, self.sp_up:getPositionY()))
end 

function MinigameBattleResult:setRewardsList()
    -- if self.data == nil or self.data.items == nil or next(self.data.items) == nil then return end
    local config = Config.MinigameMobcontrolData.data_level_dif_info[self.data.level]
    local items = self.data.item_rewards or {} -- config.up_award
    local scale = 0.8
    local off = 40
    local _x, _y = 0, 35
    local item_conf = nil
    local index = 1
    local item = nil
    local total_width = #items*BackPackItem.Width * scale + off*(#items-1)
    local start_x = (self.layout_item:getContentSize().width - total_width)/2
    for i, v in ipairs(items) do
        item_conf = Config.ItemData.data_get_data(v.bid)
        if item_conf then
            if self.item_list[index] == nil then
                item = BackPackItem.new(false, false, false, scale, false, true)
                self.layout_item:addChild(item)
                table.insert(self.item_list, item)
            end
            item = self.item_list[index]
            
            _x = start_x + (BackPackItem.Width * scale + off) * (index-1) + BackPackItem.Width*scale*0.5
            item:setPosition(_x, _y)
            item:setBaseData(v.bid, v.num)
            -- item:setExtendDesc(true, item_conf.name, 1)
            index = index + 1
        end
    end 
end

function MinigameBattleResult:DeleteMe()
end

function MinigameBattleResult:close()
    if self.sprite_1_load then
        self.sprite_1_load:DeleteMe()
        self.sprite_1_load = nil
    end

    if self.sprite_2_load then
        self.sprite_2_load:DeleteMe()
        self.sprite_2_load = nil
    end

    for k,v in pairs(self.item_list) do
        v:DeleteMe()
    end
    self.item_list = nil
    doStopAllActions(self.container)
    self:handleEffect(false)
end