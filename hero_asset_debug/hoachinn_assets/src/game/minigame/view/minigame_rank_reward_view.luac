MinigameRankRewardView = class("MinigameRankRewardView", function()
    return ccui.Widget:create()
end)
local controller = MinigameController:getInstance()


function MinigameRankRewardView:ctor()
    self:configUI()
    self:register_event()
end


function MinigameRankRewardView:configUI()
	local csbPath = PathTool.getTargetCSB("minigame/minigame_rank_reward_view")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setAnchorPoint(cc.p(0.5, 0.5))

    local win_title = self.root_wnd:getChildByName("win_title")
    

    self.root_wnd:getChildByName("reward_label"):setString(TI18N("语言_c_g_72"))

    self.root_wnd:getChildByName("rank_label"):setString(TI18N("语言_c_g_66"))

    local item_list = self.root_wnd:getChildByName("item_list")

    local bgSize = item_list:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height-8)
    local setting = {
        item_class = MinigameRankRewardItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 612,               -- 单元的尺寸width
        item_height = 112,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.reward_scrollview = CommonScrollViewLayout.new(item_list, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_scrollview:setSwallowTouches(false)

    self.my_rank = self.root_wnd:getChildByName("my_rank")
    local rank_title = self.my_rank:getChildByName("rank_title")
    self.my_rank:getChildByName("rank_title"):setString(TI18N("语言_c_g_75"))
    self.my_rank.award_title = self.my_rank:getChildByName("award_title")
    self.my_rank.award_title:setTextAreaSize(cc.size(260,0))
    self.my_rank.award_title:ignoreContentAdaptWithSize(true)
    self.my_rank.award_title:getVirtualRenderer():setLineSpacing(-8)
    self.my_rank.award_title:setString(TI18N("语言_c_g_76"))
    self.my_rank.rank_label = self.my_rank:getChildByName("rank_label")
    self.my_rank.rank_label:setPosition(cc.p(rank_title:getPositionX() + rank_title:getContentSize().width + 10, rank_title:getPositionY()))
    self.my_rank.good_con = self.my_rank:getChildByName("good_con")
    self.my_rank:getChildByName("tips_label"):setString(TI18N("语言_c_g_77"))
    local scroll_view_size = self.my_rank.good_con:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 5,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.7,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.7,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.7
    }

    self.item_scrollview = CommonScrollViewLayout.new(self.my_rank.good_con, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
end

function MinigameRankRewardView:register_event()

end

function MinigameRankRewardView:open(data)
    local configs = Config.MinigameMobcontrolData.data_rank_info
    local list = {}
    local my_reward = {}
    for k, v in pairs(configs) do
        local model = {}
        model.start_index = k
        model.end_index = k
        for p, q in pairs(v) do
            model.end_index = p
            model.reward = q
            break
        end
        list[#list + 1] = model
        if data.my_idx >= model.start_index and data.my_idx <= model.end_index then
            my_reward = model.reward
        end
    end
    table.sort(list, function(a, b)
        return a.end_index < b.end_index
    end)
    self.reward_scrollview:setData(list)

    --我的排行
    if data.my_idx == 0 then
        self.my_rank.rank_label:setString(TI18N("语言_c_1110"))
        self.my_rank.good_con:setVisible(false)
    else
        self.my_rank.rank_label:setString(data.my_idx)
        self.my_rank.good_con:setVisible(true)

        self.item_scrollview:setData(my_reward, nil, nil, {is_show_tips = true})
    end
end

function MinigameRankRewardView:DeleteMe()
    if self.reward_scrollview then
		self.reward_scrollview:DeleteMe()
		self.reward_scrollview = nil
	end
end

-----------------------------------@ des item
MinigameRankRewardItem = class("MinigameRankRewardItem", function()
    return ccui.Widget:create()
end)

function MinigameRankRewardItem:ctor()
	self:configUI()
	self:register_event()
end

function MinigameRankRewardItem:configUI(  )
	self.size = cc.size(612,112)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("minigame/minigame_rank_reward_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.rank_label = main_container:getChildByName("rank_label")
    self.image = main_container:getChildByName("image")
    self.image:ignoreContentAdaptWithSize(true)
    self.good_con = main_container:getChildByName("good_con")

    local scroll_view_size = self.good_con:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 5,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.7,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.7,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.7
    }

    self.item_scrollview = CommonScrollViewLayout.new(self.good_con, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
end

function MinigameRankRewardItem:register_event(  )
	
end

function MinigameRankRewardItem:setData( data )
    if data.start_index <= 3 then
        self.rank_label:setVisible(false)
        self.image:setVisible(true)
        self.image:loadTexture(PathTool.getResFrame("common","common_200"..data.start_index), LOADTEXT_TYPE_PLIST)
    else
        self.rank_label:setString(string.format(TI18N("%s~%s"), data.start_index, data.end_index))
        self.rank_label:setVisible(true)
        self.image:setVisible(false)
    end
    self.item_scrollview:setData(data.reward, nil, nil, {is_show_tips = true})
end

function MinigameRankRewardItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end