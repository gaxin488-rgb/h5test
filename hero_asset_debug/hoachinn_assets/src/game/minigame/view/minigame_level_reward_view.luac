MinigameLevelRewardView = class("MinigameLevelRewardView", function()
    return ccui.Widget:create()
end)
local controller = MinigameController:getInstance()

function MinigameLevelRewardView:ctor()
    self:configUI()
    self:register_event()
end

function MinigameLevelRewardView:configUI()
	local csbPath = PathTool.getTargetCSB("minigame/minigame_level_reward_view")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self.root_wnd:setAnchorPoint(cc.p(0.5, 0.5))

    self.root_wnd:getChildByName("reward_label"):setString(TI18N("语言_c_g_73"))

    self.root_wnd:getChildByName("level_label"):setString(TI18N("语言_c_g_68"))

    local item_list = self.root_wnd:getChildByName("item_list")

    local bgSize = item_list:getContentSize()
	local scroll_view_size = cc.size(bgSize.width, bgSize.height-8)
    local setting = {
        item_class = MinigameLevelRewardItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 612,               -- 单元的尺寸width
        item_height = 112,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }

    self.reward_scrollview = CommonScrollViewLayout.new(item_list, cc.p(0,5) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_scrollview:setSwallowTouches(false)

end

function MinigameLevelRewardView:register_event()

end



function MinigameLevelRewardView:open(data)
    local data = controller:getModel():getBaseData()
    local list = Config.MinigameMobcontrolData.data_level_dif_info
    self.reward_scrollview:setData(list)
end

function MinigameLevelRewardView:DeleteMe()
    if self.reward_scrollview then
		self.reward_scrollview:DeleteMe()
		self.reward_scrollview = nil
	end
end

-----------------------------------@ des item
MinigameLevelRewardItem = class("MinigameLevelRewardItem", function()
    return ccui.Widget:create()
end)

function MinigameLevelRewardItem:ctor()
	self:configUI()
	self:register_event()
end

function MinigameLevelRewardItem:configUI(  )
	self.size = cc.size(612,112)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("minigame/minigame_level_reward_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.rank_label = main_container:getChildByName("rank_label")
    self.good_con = main_container:getChildByName("good_con")

    local scroll_view_size = self.good_con:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 5,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.7,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.7,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.7
    }

    self.item_scrollview = CommonScrollViewLayout.new(self.good_con, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
end

function MinigameLevelRewardItem:register_event(  )
	
end

function MinigameLevelRewardItem:setData( data )
    self.rank_label:setString(data.level_title)
    self.item_scrollview:setData(data.up_award, nil, nil, {is_show_tips = true})
end

function MinigameLevelRewardItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end