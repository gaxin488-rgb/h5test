

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- @description:
--      
-- <br/>Create: new Date().toISOString()
--
-- --------------------------------------------------------------------
MinigameLevelUpView = MinigameLevelUpView or BaseClass(BaseView)
local controller = MinigameController:getInstance()

function MinigameLevelUpView:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Tips
    self.layout_name = "minigame/minigame_level_up_view"
    self.effect_cache_list = {}

    self.item_list = {}
end

function MinigameLevelUpView:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")


    self.up_bg = container:getChildByName("up_bg")

    self.image_level_before = self.up_bg:getChildByName("image_level_before")
    self.image_level_after = self.up_bg:getChildByName("image_level_after")

    self.sp_level_text_bg_before = self.up_bg:getChildByName("sp_level_text_bg_before")
    self.sp_level_text_bg_after = self.up_bg:getChildByName("sp_level_text_bg_after")
    self.text_level_before = self.sp_level_text_bg_before:getChildByName("text_level")
    self.text_level_after = self.sp_level_text_bg_after:getChildByName("text_level")

    self.title_container = self.root_wnd:getChildByName("title_container")

    self.Sprite_1 = self.up_bg:getChildByName("Sprite_1")
    if self.sprite_1_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_97")
        self.sprite_1_load = loadSpriteTextureFromCDN(self.Sprite_1, res, ResourcesType.single, self.sprite_1_load)
    end
    
    self.Sprite_2 = self.up_bg:getChildByName("Sprite_2")
    if self.sprite_2_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_98")
        self.sprite_2_load = loadSpriteTextureFromCDN(self.Sprite_2, res, ResourcesType.single, self.sprite_2_load)
    end
end

function MinigameLevelUpView:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            controller:openMinigameLevelUpView(false)
        end
    end)
end


function MinigameLevelUpView:handleEffect(status)
    if status == false then
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
        if self.play_effect2 then
            self.play_effect2:clearTracks()
            self.play_effect2:removeFromParent()
            self.play_effect2 = nil
        end
    else
        local effect_id = 103
        local action = PlayerAction.action_4
        local effect_partner = self.title_container
        if not tolua.isnull(effect_partner) and self.play_effect == nil then
            self.play_effect = createEffectSpine(PathTool.getEffectRes(effect_id), cc.p(effect_partner:getContentSize().width*0.5,effect_partner:getContentSize().height*0.5), cc.p(0.5, 0.5), false, action)
            effect_partner:addChild(self.play_effect, 1)
        end
        if not tolua.isnull(self.title_container) and self.play_effect2 == nil then
            self.play_effect2 = createEffectSpine("E51022", cc.p(effect_partner:getContentSize().width * 0.5, effect_partner:getContentSize().height * 0.5), cc.p(0.5, 0.5), true, PlayerAction.action)
            self.title_container:addChild(self.play_effect2, 1)
		end
        
    end
end

function MinigameLevelUpView:openRootWnd(data)
    if data ~= nil then
        self.data = data
        self:setBaseInfo()
        self:handleEffect(true)
    end
end

function MinigameLevelUpView:setBaseInfo()
    if self.data == nil then return end

    local old_config = Config.MinigameMobcontrolData.data_level_dif_info[self.data.old_level]
    local image_name, image_type, image_plist = controller:getModel():getImageType(old_config.cup_icon)
    loadSpriteTexture(self.image_level_before, PathTool.getMinigameRes(image_name, image_type, image_plist), image_type)

    local config = Config.MinigameMobcontrolData.data_level_dif_info[self.data.level]
    local image_name, image_type, image_plist = controller:getModel():getImageType(config.cup_icon)
    loadSpriteTexture(self.image_level_after, PathTool.getMinigameRes(image_name, image_type, image_plist), image_type)

    self.text_level_before:setString(old_config.level_title) 
    self.text_level_after:setString(config.level_title)
end

function MinigameLevelUpView:close_callback()
    if self.sprite_1_load then
        self.sprite_1_load:DeleteMe()
        self.sprite_1_load = nil
    end

    if self.sprite_2_load then
        self.sprite_2_load:DeleteMe()
        self.sprite_2_load = nil
    end
    self:handleEffect(false)
    controller:openMinigameLevelUpView(false)
end