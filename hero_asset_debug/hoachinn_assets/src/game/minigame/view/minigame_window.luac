MinigameWindow = MinigameWindow or BaseClass(BaseView)
local controller = MinigameController:getInstance()
local mainui_ctrl = MainuiController:getInstance()
function MinigameWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Full
    self.item_list = {}
    self.layout_name = "minigame/minigame_window"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","minigame_mobcontrol"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","minigame_mobcontrol_level"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("common","common_1"), type = ResourcesType.plist},
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","mingame_mobcontrol_bg1_1"), type = ResourcesType.single },
    }
end

function MinigameWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.image_bg = self.root_wnd:getChildByName("image_bg")
    self.image_bg:setScale(display.getMaxScale())
    self.node_bg = self.root_wnd:getChildByName("node_bg")

    self.sp_bg2 = self.root_wnd:getChildByName("sp_bg2")
    self.sp_bg2:setPositionY(display.getBottom(self.root_wnd))

    self.sp_logo = self.root_wnd:getChildByName("sp_logo")
    local pos = cc.p(self.sp_logo:getPosition())
    pos.y = pos.y + display:getTop() - CC_DESIGN_RESOLUTION.height
    self.sp_logo:setPosition(pos)
    self.close_btn = self.root_wnd:getChildByName("close_btn")
    local pos = cc.p(self.close_btn:getPosition())
    pos.y = pos.y + display:getTop() - CC_DESIGN_RESOLUTION.height
    self.close_btn:setPosition(pos)

    self.sp_level_bg = self.root_wnd:getChildByName("sp_level_bg")
    self.sp_level_bg:setPositionY(self.sp_level_bg:getPositionY() + display.getBottom(self.root_wnd))
    self.sp_level_bg.text_level_title = self.sp_level_bg:getChildByName("text_level_title")
    self.sp_level_bg.text_level_title:setVisible(false)
    local pos = cc.p(self.sp_level_bg.text_level_title:getPosition())
    self.rich_level_title = createRichLabel(22, 1, cc.p(0.5, 0.5), pos, -8, nil, 500)
    self.sp_level_bg:addChild(self.rich_level_title)


    self.sp_level_bg.sp_level_icon = self.sp_level_bg:getChildByName("sp_level_icon")
    local sp_level_text_bg = self.sp_level_bg:getChildByName("sp_level_text_bg")
    self.sp_level_bg.text_level = sp_level_text_bg:getChildByName("text_level")
    local battle_btn = self.sp_level_bg:getChildByName("battle_btn")
    battle_btn.label_name = battle_btn:getChildByName("label_name")
    battle_btn.label_name:setString(TI18N("语言_c_g_57"))

    battle_btn.label_cost = battle_btn:getChildByName("label_cost")
    self.sp_level_bg.battle_btn = battle_btn
    self.sp_level_bg.text_award_title = self.sp_level_bg:getChildByName("text_award_title")
    self.sp_level_bg.text_award_title:setString(TI18N("语言_c_g_56"))
    self.sp_level_bg.reward_panel = self.sp_level_bg:getChildByName("reward_panel")

    self.sp_time_bg = self.root_wnd:getChildByName("sp_time_bg")
    self.sp_time_bg.text_time = self.sp_time_bg:getChildByName("text_time")
    self.sp_time_bg.add_btn = self.sp_time_bg:getChildByName("add_btn")

    self.text_down = self.root_wnd:getChildByName("text_down")
    self.text_down:setTextAreaSize(cc.size(600,0))
    self.text_down:getVirtualRenderer():setLineSpacing(-8)
    self.text_down:setString(TI18N("语言_c_g_59"))
    self.text_down:setPositionY(self.text_down:getPositionY() + display.getBottom(self.root_wnd))

    self.btn_rank = self.root_wnd:getChildByName("btn_rank")
    self.btn_rank:getChildByName("text_name"):setTextAreaSize(cc.size(100,0))
    self.btn_rank:getChildByName("text_name"):getVirtualRenderer():setLineSpacing(-8)
    self.btn_rank:getChildByName("text_name"):setString(TI18N("语言_c_g_71"))

    self.btn_help = self.root_wnd:getChildByName("btn_help")
    self.btn_help:getChildByName("text_name"):setTextAreaSize(cc.size(100,0))
    self.btn_help:getChildByName("text_name"):getVirtualRenderer():setLineSpacing(-8)
    self.btn_help:getChildByName("text_name"):setString(TI18N("语言_c_g_60"))

    self.root_wnd:getChildByName("image_skill_bg"):setPositionY(display.getBottom(self.root_wnd))
    self.skillIcons = {}
    for i = 1, 5, 1 do
        local skill_icon = self.root_wnd:getChildByName("image_skill_icon"..i) 
        self.skillIcons[#self.skillIcons + 1] = skill_icon
        skill_icon.index = i
        skill_icon:setPositionY(skill_icon:getPositionY() + display.getBottom(self.root_wnd))
    end
    self:createShowGirl()
end

function MinigameWindow:openRootWnd()
    MinigameController:getInstance():requestMinigameBase()
    --播放音效
    delayOnce(function()
        AudioManager:getInstance():playMusic(AudioManager.AUDIO_TYPE.SCENE, "s_012", true)
    end,0.1)
end

function MinigameWindow:register_event()
    if self.base_update_event == nil then
        self.base_update_event = GlobalEvent:getInstance():Bind(MinigameEvent.Enter_basedata_back, function(data)
            self.data = controller:getModel():getBaseData()
            self:updateUI()
        end)
    end
    registerButtonEventListener(self.close_btn, function()
        controller:openMinigameWindow(false) 
    end,true, 1)

    registerButtonEventListener(self.sp_level_bg.battle_btn, function()
        controller:requestMinigameBegin()
    end,true, 1)

    registerButtonEventListener(self.btn_rank, function()
        controller:openMinigameRankHall(true)
    end,true, 1)

    registerButtonEventListener(self.btn_help, function(_, sender)
        -- TipsManager:getInstance():showCommonTips(TI18N("语言_min_1_1"), sender:getTouchBeganPosition(),nil,nil,500)
        MainuiController:getInstance():openCommonExplainView(true, Config.MinigameMobcontrolData.data_explain)
    end,true, 1)

    registerButtonEventListener(self.sp_time_bg.add_btn, function() 
    end,true, 1)

    for i, v in ipairs(self.skillIcons) do
        registerButtonEventListener(v, function(_, sender) 
            controller:openMinigameCardDesView(true, sender.index)
        end,true, 1)
    end
end

function MinigameWindow:updateUI()
    --level--
    local level = self.data.level
    local config = Config.MinigameMobcontrolData.data_level_dif_info[level]
    local image_name, image_type, image_plist = controller:getModel():getImageType(config.cup_icon)
    loadSpriteTexture(self.sp_level_bg.sp_level_icon, PathTool.getMinigameRes(image_name, image_type, image_plist), image_type)

    local image_name, image_type, image_plist = controller:getModel():getImageType(config.bk_map_res)
    local res_id = PathTool.getPlistImgForDownLoad("minigame_mobcontrol", image_name,false)
    if self.bg_load then 
        self.bg_load:DeleteMe()
        self.bg_load = nil
    end
    if not self.bg_load then
        self.bg_load = createResourcesLoad(res_id, ResourcesType.single, function()
            if not tolua.isnull(self.sp_bg2) then
                loadSpriteTexture(self.sp_bg2, res_id,LOADTEXT_TYPE)
            end
        end, self.bg_load)
    end

    local dis_count = config.up_condition - self.data.win_count
    local str = ""
    local config_next = Config.MinigameMobcontrolData.data_level_dif_info[level + 1]
    if not config_next then
        str = string.format(TI18N("语言_c_g_81"))
    else
        str = string.format(TI18N("语言_c_g_55"),dis_count, config_next.level_title)
    end
    self.rich_level_title:setString(str)

    self.sp_level_bg.text_level:setString(config.level_title)

    self.sp_time_bg.text_time:setString(math.max(0, Config.MinigameMobcontrolData.data_const["limit_times"].val - self.data.count))

    self.sp_level_bg.battle_btn.label_cost:setString(1)
    local up_award = config.up_award 
    self:createItemList(config.up_award)
end

function MinigameWindow:createShowGirl()
    local function animationEventFunc(event)
        if event.animation ~= PlayerAction.show then
            self.spine:setAnimation(0, PlayerAction.show, true)
        end
    end
    local fun = function()
        if not self.spine then
            local show_girl_info = mainui_ctrl:getModel():getShowGirlData()
            local skin_id = show_girl_info.skin_id
            local hero_id = show_girl_info.hero_id
            local type = BaseRole.type.partner
            local show_id = hero_id
            if skin_id and skin_id ~= 0 then
                type = BaseRole.type.skin
                show_id = skin_id
            end
            if (skin_id == nil and hero_id == nil) or (skin_id == 0 and hero_id == 0) then
                show_id = Config.CityData.data_const.Character_position_character.val
                type = BaseRole.type.partner
            end
            self.spine = BaseRole.new(type, show_id, nil, {scale = 1})
            self.spine:setAnimation(0,PlayerAction.show,true) 
            self.spine:setCascade(true)
            self.spine:setPosition(cc.p(0, -260))
            self.spine:setAnchorPoint(cc.p(0.5,1)) 
            self.spine:setScale(1)
            self.node_bg:addChild(self.spine)
            self.spine:showShadowUI(false)
            self.spine:setOpacity(0)
            self.spine:registerSpineEventHandler(animationEventFunc, sp.EventType.ANIMATION_COMPLETE)
            local action = cc.FadeIn:create(0.2)
            self.spine:runAction(action)
        end
    end
    fun()
end

function MinigameWindow:createItemList(list)
    if list == nil or next(list) == nil then return end
    self.item_list  = self.item_list or {}
    if self.item_list then
        for i, item in ipairs(self.item_list) do
            item:suspendAllActions()
            item:setVisible(false)
        end
    end
    
    local item = nil
    local scale = 0.7
    local off = 6
    local _x, _y = 0, 4
    local sum = #list
    local item_conf = nil
    local total_width = sum * BackPackItem.Width * scale + (sum - 1) * off
    local start_x = 0
    local index = 1

    local max_width = math.max(self.sp_level_bg.reward_panel:getContentSize().width)
    -- local max_width = math.max(self.item_view:getContentSize().width, total_width)
    -- self.item_view:setInnerContainerSize(cc.size(max_width, self.item_view:getContentSize().height))
    for i, v in ipairs(list) do
        local bid = v[1]
        local num = v[2]
        item_conf = Config.ItemData.data_get_data(bid)
        if item_conf then
            item = self.item_list[index]
            if item == nil then
                item = BackPackItem.new(false, true, false, scale, false, true)
                table.insert(self.item_list, item)
                self.sp_level_bg.reward_panel:addChild(item)
            end
            _x = start_x + (BackPackItem.Width * scale + off) * (index-1) + BackPackItem.Width*scale*0.5
            item:setBaseData(bid, num)
            item:setDefaultTip(true,false)
            item:setAnchorPoint(cc.p(0.5, 0))
            item:setPosition(_x, _y)
            item:setVisible(true)
            index = index + 1
        end
    end 
end

function MinigameWindow:loadBattleRes(callback)
    if self.b_resources_load then 
        self.b_resources_load:DeleteMe()
        self.b_resources_load = nil
    end
    local level_id = MinigameController:getInstance():getModel():getLevelId()
    local config = Config.MinigameMobcontrolData.data_level_info[level_id]
    local battle_res_list = {
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","txt_cn_minigame_mobcontrol_1"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","txt_cn_minigame_mobcontrol_2"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol","txt_cn_minigame_mobcontrol_3"), type = ResourcesType.single },
    } 
    if config then
        local image_bg = { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol",config.res), type = ResourcesType.single }
        table.insert(battle_res_list, image_bg)
        local map_list = Config.MinigameMobcontrolData.data_level_map_info[config.map_id]
        for k, v in pairs(map_list) do
            local image_name, image_type, image_plist = MinigameController:getInstance():getModel():getImageType(v.res)
            if image_name ~= "" and image_type == 0 then
                local temp = { path = PathTool.getPlistImgForDownLoad("minigame_mobcontrol",image_name), type = ResourcesType.single }
                table.insert(battle_res_list, temp)
            end
        end
    end
    self.b_resources_load = ResourcesLoad.New(true) 
    self.b_resources_load:addAllList(battle_res_list, function()
        callback()
    end)
end

function MinigameWindow:close_callback()
    if self.item_list then
        for i, item in ipairs(self.item_list) do
            item:DeleteMe()
        end
    end
    if self.base_update_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.base_update_event)
        self.base_update_event = nil
    end
    doStopAllActions(self.spine)
    if self.spine then
        self.spine:DeleteMe()
        self.spine = nil
    end
    self.item_list = nil
    -- AudioManager:getInstance():playMusic(AudioManager.AUDIO_TYPE.SCENE, "s_002", true) -- 恢复主城背景音乐播放

    if self.bg_load then 
        self.bg_load:DeleteMe()
        self.bg_load = nil
    end
    if self.b_resources_load then 
        self.b_resources_load:DeleteMe()
        self.b_resources_load = nil
    end
end
