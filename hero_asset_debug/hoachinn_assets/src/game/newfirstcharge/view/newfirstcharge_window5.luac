NewFirstChargeWindow5 = NewFirstChargeWindow5 or BaseClass(BaseView)

local controller = NewFirstChargeController:getInstance()
local model = controller:getModel()
local string_format = string.format
function NewFirstChargeWindow5:__init()
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "newfirstcharge/newfirstcharge_window5"
	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("newfirstcharge2", "newfirstcharge2"), type = ResourcesType.plist},
		{path = PathTool.getPlistImgForDownLoad("newfirstcharge2", "newfirstcharge2_bigbg"), type = ResourcesType.single},
		{path = PathTool.getPlistImgForDownLoad("bigbg/action","txt_cn_action_bigbg_6"), type = ResourcesType.single},
	}

	self.imgList1 = {"Cerberus","Cerberus4"}
	self.imgList2 = {"Cerberus2","Cerberus3"}
	-- self.roleList1 = {}
	-- self.roleList2 = {}
	self.imgListpos1 = {"240","240"}
	self.imgListpos2 = {"550","550"}
	self.roleListpos1 = {"360","360"}
	self.roleListpos2 = {"300","300"}
	self.item_list = {}
	
	self.leftImgIndex = 1--当前左边图片的编号
	self.rightImgIndeX = 1--当前右边图片的编号
	self.item_reward_list = {}
	self.item_reward_list[1] = {}
	for i=1,4 do
		self.item_reward_list[1][i] = {}
	end
end

function NewFirstChargeWindow5:open_callback()
	model:setFirstRechargeData5()
	controller:sender21019(0,MainuiConst.icon.first_charge_new5)
	controller:sender21026(1)
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())
	self.main_container = self.root_wnd:getChildByName("main_container")
	local container = self.main_container:getChildByName("container")
	-- container:setPositionY(display.getTop())
	self.bgImg = container:getChildByName("bgImg")--背景图片
	self.bg1 = container:getChildByName("bg1")--左边进入的图片
	self.bg2 = container:getChildByName("bg2")--右边进入的图片
	self.bg_node1 = container:getChildByName("bg_node1")--左边进入的图片
	self.bg_node2 = container:getChildByName("bg_node2")--右边进入的图片
	self.battle_preview_btn = container:getChildByName("battle_preview_btn")-- 帮助说明按钮
	self.btn_recharge = container:getChildByName("btn")--充值按钮
	
	self.close_btn = container:getChildByName("close_btn")
	self.remain_charge = container:getChildByName("remain_charge")
	local str = string_format(string.format(TI18N("语言_c_4442"),GetMoneyNum(Config.ChargeData.data_super_gifts[1],"old_val")))
	self.remain_charge:setString(str)
	
	self.title_tip = container:getChildByName("title_tip")
	self.title_tip:setChangeScaleOffWidth(140)
	setTextSpacing(self.title_tip)
	local charge_id = Config.ChargeData.data_super_gifts[1].charge_id
	local cdata = Config.ChargeData.data_charge_data[charge_id]
	local str = string.format(TI18N("语言_c_6724"),string.format(TI18N("语言_c_4440"),cdata.val))
	self.title_tip:setString(str)
	
	self.vip_txt = container:getChildByName("vip_txt")
	self.vip_txt:setString("")
	local need_vip = Config.ChargeData.data_super_gifts[1].vip
	if need_vip > 0 then
		self.vip_txt:setString(string.format(TI18N("语言_c_3870"),need_vip))
	end
	
	self.btn_label = self.btn_recharge:getChildByName("label")
	-- self.btn_label:setString(TI18N("语言_c_824"))
	-- self:playEnterAnimatianByObj(self.main_container , 2) 

	self.desc2 = container:getChildByName("title2_txt")
	self.desc2:setString(TI18N("语言_c_6727"))
	self.desc3 = container:getChildByName("title3_txt")
	self.desc3:setString(TI18N("语言_c_6728"))
	
	self.item_4 = container:getChildByName("item_4")
	self.item_icon = self.item_4:getChildByName("item_icon")

	for i=1,4 do
		local item = container:getChildByName("item_"..i)
		if item then
			local object = {}
			object.scroll = item:getChildByName("scroll")
			if object.scroll.setScrollBarEnabled then
				object.scroll:setScrollBarEnabled(false)
			end
			object.list = {}
			self.item_list[i] = object
		end
	end
	self:fillItemList()
	local tData = model:getFirstRechargeData5()
	-- self.roleList1 = {}
	-- self.roleList2 = {}
	-- for key, value in pairs(tData[1].draw1[1]) do
	-- 	self.roleList1[key] = value
	-- end
	-- for key, value in pairs(tData[1].draw2[1]) do
	-- 	self.roleList2[key] = value
	-- end

	-- self.bg_node1:removeAllChildren()
	-- self.bg_node2:removeAllChildren()

	-- self.role1 = BaseRole.new(BaseRole.type.partner, self.roleList1[self.leftImgIndex],nil, {scale = 0.7})
    -- self.role1:setAnimation(0, PlayerAction.show, true)
    -- self.role1:setCascade(true)
    -- self.role1:setAnchorPoint(cc.p(0.5, 0.5))
    -- self.bg_node1:addChild(self.role1)
	-- commonOpenActionLeftMove(self.bg_node1,self.roleListpos1[self.leftImgIndex])
	-- self.leftImgIndex = self.leftImgIndex + 1
	-- if self.leftImgIndex>2 then
	-- 	self.leftImgIndex = 1
	-- end

	-- self.role2 = BaseRole.new(BaseRole.type.partner, self.roleList2[self.rightImgIndeX],nil, {scale = 0.7})
    -- self.role2:setAnimation(0, PlayerAction.show, true)
    -- self.role2:setCascade(true)
    -- self.role2:setAnchorPoint(cc.p(0.5, 0.5))
    -- self.bg_node2:addChild(self.role2)
	-- commonOpenActionRightMove(self.role2,self.roleListpos2[self.leftImgIndex])
	-- self.rightImgIndeX = self.rightImgIndeX + 1
	-- if self.rightImgIndeX>2 then
	-- 	self.rightImgIndeX = 1
	-- end
	self.imgList1 = {}
	self.imgList2 = {}
	for key, value in pairs(tData[1].draw1[1]) do
		self.imgList1[key] = value
	end
	for key, value in pairs(tData[1].draw2[1]) do
		self.imgList2[key] = value
	end
	local res_id = PathTool.getPlistImgForDownLoad("newfirstcharge2", self.imgList1[self.leftImgIndex])
	self.load1 = createResourcesLoad(res_id, ResourcesType.single, function()
        if not tolua.isnull(self.bg1) then
			loadSpriteTexture(self.bg1, res_id, LOADTEXT_TYPE)
			self.bg1:setVisible(true)
			commonOpenActionLeftMove(self.bg1,self.imgListpos1[self.leftImgIndex])
			self.leftImgIndex = self.leftImgIndex + 1
			-- if self.leftImgIndex>2 then
			-- 	self.leftImgIndex = 1
			-- end
        end
	end, self.load1)
	local res_id2 = PathTool.getPlistImgForDownLoad("newfirstcharge2", self.imgList2[self.rightImgIndeX])
	self.load2 = createResourcesLoad(res_id2, ResourcesType.single, function()
        if not tolua.isnull(self.bg2) then
			loadSpriteTexture(self.bg2, res_id2, LOADTEXT_TYPE)
			self.bg2:setVisible(true)
			commonOpenActionRightMove(self.bg2,self.imgListpos2[self.leftImgIndex])
			self.rightImgIndeX = self.rightImgIndeX + 1
			-- if self.rightImgIndeX>2 then
			-- 	self.rightImgIndeX = 1
			-- end
        end
    end, self.load2)

	if self.board_move_timer then
		GlobalTimeTicket:getInstance():remove(self.board_move_timer)
	end
	self.board_move_timer = GlobalTimeTicket:getInstance():add(function()
		self:PlayAnimatian()
	end, 5)
end
