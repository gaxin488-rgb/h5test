function NewFirstChargeWindow5:fillItemList()
	local list = model:getFirstRechargeData5()
	local scale = 0.7
	local size = 119 * scale
	local create_index = 1
	for i = 1, tableLen(list) do
		local show_pic = list[i].show_pic
		local itemInfo1 = list[i].items
		local itemInfo2 = list[i].rewards
		local dailyGift2 = list[i].day2_gift
		local dailyGift3 = list[i].day3_gift
		if self.spine_model then
			self.spine_model:setVisible(false)
			self.spine_model:removeFromParent()
			self.spine_model = nil
		end
		if show_pic == "" then 
			self.item_icon:setVisible(false)
		else
			self.item_icon:setVisible(true)
			local res = PathTool.getResFrame("newfirstcharge2", show_pic)
			loadSpriteTexture(self.item_icon, res, LOADTEXT_TYPE_PLIST)
			if not self.spine_model then
				self.spine_model = createEffectSpine("E50104",cc.p(58,65),cc.p(0.5,0.5),true,PlayerAction.action_1)
				self.item_icon:addChild(self.spine_model)
			end
		end
		for k=1,tableLen(itemInfo1) do
			local _x = size * k - size * 0.5
			local _y = size * 0.5 + 10
			local obj1 = self.item_list[4]
			if not self.item_reward_list[i][4][k] then
				self.item_reward_list[i][4][k] = BackPackItem.new(false, true, false, scale, false, true)
				obj1.scroll:addChild(self.item_reward_list[i][4][k])
				if self.item_reward_list[i][4][k] then
					self.item_reward_list[i][4][k]:setPosition(_x, _y)
					-- print(itemInfo1[k][1],itemInfo1[k][2])
					self.item_reward_list[i][4][k]:setBaseData(itemInfo1[k][1],itemInfo1[k][2])
					-- self.item_reward_list[i][4][k]:setBg(false)
					-- self.item_reward_list[i][1][k]:setScale(1.5)
					-- self.item_reward_list[i][4][k]:showFlagByRes(true, PathTool.getResFrame("newfirstcharge2", "newfirstcharge1_005",false))
				end			
			end	
		end
		for j=1,tableLen(itemInfo2) do
			local obj2 = self.item_list[1]
			local _x = size * j - size * 0.5
			local _y = size * 0.5 + 10
			if not self.item_reward_list[i][1][j] then
				self.item_reward_list[i][1][j] = BackPackItem.new(false, true, false, scale, false, true)
				obj2.scroll:addChild(self.item_reward_list[i][1][j])
				if self.item_reward_list[i][1][j] then
					self.item_reward_list[i][1][j]:setPosition(_x, _y)
					self.item_reward_list[i][1][j]:setBaseData(itemInfo2[j][1],itemInfo2[j][2])
				end			
			end	
		end
		for p = 1,tableLen(dailyGift2) do
			local obj3 = self.item_list[2]
			local _x = size * p - size * 0.5+10
			local _y = size * 0.5 + 10
			if not self.item_reward_list[i][2][p] then
				self.item_reward_list[i][2][p] = BackPackItem.new(false, true, false, scale, false, true)
				obj3.scroll:addChild(self.item_reward_list[i][2][p])
				if self.item_reward_list[i][2][p] then
					self.item_reward_list[i][2][p]:setPosition(_x, _y)
					self.item_reward_list[i][2][p]:setBaseData(dailyGift2[p][1],dailyGift2[p][2])
				end			
			end	
		end
		for q = 1,tableLen(dailyGift3) do
			local obj4 = self.item_list[3]
			local _x = size * q - size * 0.5+10
			local _y = size * 0.5 + 10
			if not self.item_reward_list[i][3][q] then
				self.item_reward_list[i][3][q] = BackPackItem.new(false, true, false, scale, false, true)
				obj4.scroll:addChild(self.item_reward_list[i][3][q])
				if self.item_reward_list[i][3][q] then
					self.item_reward_list[i][3][q]:setPosition(_x, _y)
					self.item_reward_list[i][3][q]:setBaseData(dailyGift3[q][1],dailyGift3[q][2])
				end			
			end	
		end
	end
end

function NewFirstChargeWindow5:register_event()
	registerButtonEventListener(self.close_btn, function()
		controller:openNewFirstChargeView2(false)
	end, false, 2)
	registerButtonEventListener(self.background, function()	
		controller:openNewFirstChargeView2(false)
	end, false, 2)

	registerButtonEventListener(self.btn_recharge, function()
		self:sendtoBuy()
	end, true, 1)

	registerButtonEventListener(self.battle_preview_btn, function(param,sender, event_type) 
		-- local config = Config.PartnerData.data_partner_const.game_rule2
		local list = model:getFirstRechargeData5()
		if list and list[1] then
			TipsManager:getInstance():showCommonTips(list[1].desc, sender:getTouchBeganPosition())
		end
	end ,true, 2, nil, 0.8)

	self:addGlobalEvent(NewFirstChargeEvent.New_First_Charge_Event, function(data)
		self:updateData(data)
	end)
end

function NewFirstChargeWindow5:sendtoBuy()
	local giftData = model:getFirstBtnNewStatus5()
	if giftData then
		if giftData.status == 0 then
			local need_vip = Config.ChargeData.data_super_gifts[1].vip
			local role_vo = RoleController:getInstance():getRoleVo()
			if role_vo.vip_lev >= need_vip then
				local charge_id = Config.ChargeData.data_super_gifts[1].charge_id
				local cdata = Config.ChargeData.data_charge_data[charge_id]
				if cdata then
					sdkOnPay(cdata.val, 1, charge_id)
				end
			else
				message(string.format(TI18N("语言_c_3870"),need_vip))	
			end
			-- VipController:getInstance():openVipMainWindow(true, VIPTABCONST.CHARGE)
		elseif giftData.status == 1 then
			controller:sender21019(1,1)
		elseif giftData.status == 2 then
			message(TI18N("语言_c_15"))
		end
	end
	-- if giftData.time ~= 0 and giftData.days ~= 0 then
	-- 	message(TI18N("语言_c_4341"))
	-- else
	-- 	local cfg = Config.ChargeData.data_light_dark_charge_6[1]
	-- 	if cfg then
	-- 		local cdata = Config.ChargeData.data_charge_data[cfg.charge_id]
	-- 		if cdata then
	-- 			sdkOnPay(cdata.val, 1, cfg.charge_id)
	-- 			controller:sender21017()
	-- 		else
	-- 			controller:openNewFirstChargeView2(false)
	-- 		end
	-- 	end
	-- end

end

function NewFirstChargeWindow5:updateData(data)
	-- if data == nil then return end
	if self.btn_recharge then
		self.btn_recharge:setVisible(true)
		local giftData = model:getFirstBtnNewStatus5()
		if giftData then
			if self.btn_label then
				if giftData.status == 0 then
					local charge_id = Config.ChargeData.data_super_gifts[1].charge_id
					local cdata = Config.ChargeData.data_charge_data[charge_id]
					if cdata then
						local str = string.format(TI18N("语言_c_4440"),cdata.val)
						self.btn_label:setString(str)
					end
				elseif giftData.status == 1 then
					self.btn_label:setString(TI18N("语言_c_8"))
					addRedPointToNodeByStatus(self.btn_recharge,true,10,8)
				elseif giftData.status == 2 then
					self.btn_label:setString(TI18N("语言_c_15"))
					addRedPointToNodeByStatus(self.btn_recharge,false)
				end
			end
		end
	end
end

function NewFirstChargeWindow5:close_callback()
	doStopAllActions(self.main_container)
	if self.board_move_timer then
		GlobalTimeTicket:getInstance():remove(self.board_move_timer)
	end
	for i=1,4 do
		if(self.item_reward_list[1][i]) then
			for j,item in pairs(self.item_reward_list[1][i]) do
				if item then
					item:DeleteMe()
				end
			end
			self.item_reward_list[1][i] = nil
		end
	end
	self.item_reward_list = {}
	if self.item_load then
        self.item_load:DeleteMe()
		self.item_load = nil
    end
	if self.item_load2 then
        self.item_load2:DeleteMe()
		self.item_load2 = nil
    end
	if self.role1 then
		self.role1:DeleteMe()
	end
	if self.role2 then
		self.role2:DeleteMe()
	end
	controller:openNewFirstChargeView2(false)
end 