BraveRoadController = BraveRoadController or BaseClass(BaseController)

function BraveRoadController:config()
    self.model = BraveRoadModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function BraveRoadController:getModel()
    return self.model
end

function BraveRoadController:registerEvents()

end

function BraveRoadController:registerProtocals()
	--主界面协议
	self:RegisterProtocal(13100, "handle13100")  --"通关信息"
	self:RegisterProtocal(13101, "handle13101")  --"推送章节副本信息"
	self:RegisterProtocal(13102, "handle13102")  --"请求功能阵法"
	self:RegisterProtocal(13103, "handle13103")  --"设置阵法"
	self:RegisterProtocal(13104, "handle13104")  --"请求魂器选择池"
	self:RegisterProtocal(13105, "handle13105")  --"选择魂器"
	self:RegisterProtocal(13106, "handle13106")  --"魂器背包"
	self:RegisterProtocal(13107, "handle13107")  --"挑战副本"
	self:RegisterProtocal(13108, "handle13108")  --"推送战斗结算"
	self:RegisterProtocal(13109, "handle13109")  --"挑战boss"
	self:RegisterProtocal(13110, "handle13110")  --"推送boss战斗结算"
	self:RegisterProtocal(13111, "handle13111")  --"请求挑战boss额外信息"
	self:RegisterProtocal(13112, "handle13112")  --"普通关通关录像"
	self:RegisterProtocal(13113, "handle13113")  --"boss关通关录像"	
	self:RegisterProtocal(13114, "handle13114")  --"家园形象"	
	self:RegisterProtocal(13115, "handle13115")  --"难度选择"
	
	self:RegisterProtocal(13116, "handle13116")  --极限特训登录红点
end

-----------------------@ 界面相关
-- 打开勇者之路主界面
function BraveRoadController:openBraveRoadChapterWindow(status, cid)
	if status == true then
		local is_open = AdventureActivityController:getInstance():isOpenActivity(5)
		if not is_open then
			message(TI18N("语言_c_5411"))
			return
		end
		if not self.brave_road_chapter_wnd then
			self.brave_road_chapter_wnd = BraveRoadChapterWindow.New(cid)
		end
		if self.brave_road_chapter_wnd:isOpen() == false then
			self.brave_road_chapter_wnd:open()
		end
	else
		if self.brave_road_chapter_wnd then
			self.brave_road_chapter_wnd:close()
			self.brave_road_chapter_wnd = nil
		end
	end
end

