------------------------------------------------?协议
-- 打印
function BraveRoadController:printLogCall(id, msg)
	-- print(">>>>>>>>>>>>>>>>>>>>>>>>>>?BraveRoadController printLogCall ", id, msg)
end
---------------------------------------请求章节信息
function BraveRoadController:sender13100()
	local protocal = {}
	self:SendProtocal(13100, protocal)
end

function BraveRoadController:handle13100(data)
	self:printLogCall(13100, vardump(data))
	self.model:initData(data)
	self:sender13106()
	if data.diff == 999 then
		self:openBraveRoadChooseDifficulty(true)
	else
		self:openBraveRoadChooseDifficulty(false)
		self:openBraveRoadChapterWindow(true)
		GlobalEvent:getInstance():Fire(BraveRoadEvent.Update_Brave_Road_Chapter, true)
	end
end
---------------------------------------推送章节信息
function BraveRoadController:handle13101(data) 
	self:printLogCall(13101, vardump(data))
	local chapter_info = clone(data)
	self.model:updateChapterData(chapter_info)
	--收到章节信息刷新界面
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Update_Brave_Road_Chapter)
end
---------------------------------------请求阵法
--[[
	type 类型(0:普通关 1-5:属性关)
]]
function BraveRoadController:sender13102(_type)
--	print("BraveRoadController_type",_type)
	local protocal = {}
	protocal.type = _type
    self:SendProtocal(13102, protocal)
end
function BraveRoadController:handle13102(data)
	self:printLogCall(13102, vardump(data))
	data.formation_type = data.formation_type == 0 and 1 or data.formation_type
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Update_Brave_Road_Fun_Form, data)
end
---------------------------------------设置阵法
--[[
	dun_id  副本id(BOSS战传0)
	type, "类型(0:普通关 1-5:属性关)"
	formation_type, "阵法类型"
	pos_info  {pos, id} 站位信息
	hallows_id 使用的圣器id(没有传0)
]]
function BraveRoadController:sender13103(_dun_id, _type, _formation_type, _pos_info, _hallows_id)
	local protocal = {}
	protocal.dun_id = _dun_id
	protocal.type = _type
	protocal.formation_type = _formation_type
	protocal.pos_info = _pos_info
	protocal.hallows_id = _hallows_id
	-- print("BraveRoadController  sender13103", vardump(protocal))
    self:SendProtocal(13103, protocal)
end

function BraveRoadController:handle13103(data)
	self:printLogCall(13103, vardump(data))
	message(data.msg)
	if data.code == TRUE then
		GlobalEvent:getInstance():Fire(BraveRoadEvent.Save_Brave_Road_Fun_Form)
    end
end
---------------------------------------魂器选择池
--[[ id 层数  way 路径(0:左 1:中 2:右)]]
function BraveRoadController:sender13104(id, way)
	local protocal = {}
	protocal.id = id
	protocal.way = way
	-- print("BraveRoadController  sender13104", vardump(protocal))
	self.way = way
    self:SendProtocal(13104, protocal)
end
function BraveRoadController:handle13104(data) 
	self:printLogCall(13104, vardump(data))
	-- data.horcruxes_list
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Push_Brave_Road_Horcrux_Pool,  data.horcruxes_list, self.way or 1)
	self.way = nil
end
---------------------------------------选择魂器
--[[ id 层数 hid 魂器id]]
function BraveRoadController:sender13105(id, hid, way)
	local protocal = {}
	protocal.id = id
	protocal.hid = hid
	protocal.way = way
    self:SendProtocal(13105, protocal)
end
function BraveRoadController:handle13105(data) 
	self:printLogCall(13105, vardump(data))
	message(data.msg)
	if data.code == TRUE then
		--选择之后刷新界面
		self:sender13106()
    end
end
---------------------------------------魂器背包
function BraveRoadController:sender13106()
	local protocal = {}
    self:SendProtocal(13106, protocal)
end
function BraveRoadController:handle13106(data) 
	self:printLogCall(13106, vardump(data))
	self.model:setHorcruxBag(data.horcruxes_bag)
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Update_Brave_Road_Horcruxes)
end
---------------------------------------挑战副本  --[[id 层数  dun_id 关卡序列]]
function BraveRoadController:sender13107(id, dun_id)
	local protocal = {}
	protocal.id = id 
	protocal.dun_id = dun_id
	-- print("BraveRoadController  sender13107", vardump(protocal))
    self:SendProtocal(13107, protocal)
end
function BraveRoadController:handle13107(data) 
	message(data.msg)
	self:printLogCall(13107, vardump(data))
end
---------------------------------------推送战斗结算
function BraveRoadController:handle13108(data) 
	self:printLogCall(13108, vardump(data))
	if data then
		data.item_rewards = data.award
		for i,v in ipairs(data.item_rewards) do
			v.bid = v.item_id
		end
		BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.Brave_road, data)
	end
end
---------------------------------------挑战boss --[[id 层数  tips 词条{id, tips_id}]]
function BraveRoadController:sender13109(id)
	self.model:cleanBattleInfo()
	local protocal = {}
	protocal.id = id 
	if self.model:getBossIsViolent(id) then
		protocal.tips = self.model:getCurCidTips(id)
	else
		protocal.tips ={}
	end
    self:SendProtocal(13109, protocal)
end
function BraveRoadController:handle13109(data) 
	self:printLogCall(13109, vardump(data))
end
---------------------------------------推送挑战boss 结算
function BraveRoadController:handle13110(data) 
	self:printLogCall(13110, vardump(data))
	if data then
		data.item_rewards = data.award
		for i,v in ipairs(data.item_rewards) do
			v.bid = v.item_id
		end
		BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.Brave_road, data)
	end
end
---------------------------------------请求挑战boss战额外数据
function BraveRoadController:sender13111()
	if not self.model:getBattleInfo() then
		local protocal = {}
		self:SendProtocal(13111, protocal)
	end
end
function BraveRoadController:handle13111(data) 
	self:printLogCall(13111, vardump(data))
	self.model:saveBattleInfo(data)
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Boss_Info_Update_Battle, data)
end
---------------------------------------普通关通关录像
function BraveRoadController:sender13112(cid, dun_id)
	local protocal = {}
	protocal.id = cid
	protocal.dun_id = dun_id
	self:SendProtocal(13112, protocal)
end
function BraveRoadController:handle13112(data) 
	self:printLogCall(13112, vardump(data))
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Pass_Video_Update, data.horcruxes_dungeon_replay_data or {})
end
---------------------------------------boss关通关录像
function BraveRoadController:sender13113(cid)
	local protocal = {}
	protocal.id = cid
	self:SendProtocal(13113, protocal)
end
function BraveRoadController:handle13113(data) 
	self:printLogCall(13113, vardump(data))
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Pass_Boss_Video_Update, data.horcruxes_dungeon_boss_replay_data or {})
end
---------------------------------------家园形象
function BraveRoadController:sender13114()
	local protocal = {}
    self:SendProtocal(13114, protocal)
end

function BraveRoadController:handle13114(data)
	self:printLogCall(13114, vardump(data))
	self.model:setPlanesRoleLookId(data.look_id)
    HomeworldController:getInstance():getModel():setMyCurHomeFigureId(data.look_id)
	HomeworldController:getInstance():getModel():setActivateFigureList(data.list, true)
	GlobalEvent:getInstance():Fire(HomeworldEvent.Update_My_Home_Figure_Event)
end
---------------------------------------难度选择
function BraveRoadController:sender13115(diff)
	local protocal = {}
	protocal.diff = diff
    self:SendProtocal(13115, protocal)
end

function BraveRoadController:handle13115(data)
	message(data.msg)
end
---------------------------------------难度选择
function BraveRoadController:sender13116()
	local protocal = {}
    self:SendProtocal(13116, protocal)
end

function BraveRoadController:handle13116(data)
	local status = false
    for k, v in pairs(data.red_point_list) do
        status = status or v.code == 1
        if status then
            break
        end
    end

    self.model:setBraveRoadLoginRed(status)
end
------------------------------------------------?协议end

function BraveRoadController:__delete()
    if self.model ~= nil then
        self.model:DeleteMe()
        self.model = nil
    end
end