local _table_insert = table.insert

BraveRoadModel = BraveRoadModel or BaseClass()

function BraveRoadModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
    self.braveroad_data = {
        count = 0 --"剩余挑战次数
        ,diff = 0 --"本月难度"
        ,star = 0 --"本月星数"
        ,first_month = 0 --"是否首月 1是 0 否" --首月关卡和boss配置读取不同
        ,chapter_info = {}
    }
    self.boss_is_violent_list = {}
    self.braveRoad_login_red = false
end

function BraveRoadModel:config()
    --解析配置  LimitTrainingData
    --关卡配置
    self.ChapterConfig = self.ChapterConfig or {}
    for k, v in ipairs(Config.LimitTrainingData.data_dungeon) do
        if not self.ChapterConfig[v.cid] then
            self.ChapterConfig[v.cid] = {}
        end
        if not self.ChapterConfig[v.cid][v.pos] then
            self.ChapterConfig[v.cid][v.pos] = {}
        end
        table.insert(self.ChapterConfig[v.cid][v.pos], v)
    end
end

function BraveRoadModel:getDungeonConfigByCid(cid)
    return self.ChapterConfig[cid] or {}
end

function BraveRoadModel:getTipsConfigByBid(bid)
    if not self.tipsConfig then
        self.tipsConfig = {} -- bid --- config
        for k, v in pairs(Config.LimitTrainingData.data_tips) do
            for p, q in pairs(v) do
                self.tipsConfig[q.bid] = q
            end
        end
    end
    return self.tipsConfig[bid]
end
--获取词条对应的页签类型
function BraveRoadModel:getTipsTabTypeByBid(boss_id, bid)
    local config= self:getTipsConfigByBid(bid)
    local tip_id = config.tip_id
    local boss_cfg = Config.LimitTrainingData.data_dungeon_boss[boss_id]
    for i, v in ipairs(boss_cfg.tips_lib) do
        for p, q in ipairs(v) do
            if q == tip_id then
                return i
            end
        end
    end
    return 1
end

