local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

local TITLE_STR = {
    [BraveRoadConst.Video_Type.Power_sim] = TI18N("语言_c_5085"),
    [BraveRoadConst.Video_Type.Time_least] = TI18N("语言_c_5086"),
    [BraveRoadConst.Video_Type.Power_least] = TI18N("语言_c_5087"),
    [BraveRoadConst.Video_Type.Star_High_Power_least] = TI18N("语言_c_5088"),
}

BraveRoadVideoItem = class('BraveRoadVideoItem',function()
    return ccui.Widget:create()
end)

function BraveRoadVideoItem:ctor(callback)
    self.callback = callback
    self:configUI()
    self:registerEvent()
end

function BraveRoadVideoItem:configUI()
    self:setAnchorPoint(cc.p(0, 0))
	self:setTouchEnabled(false)

	local csbPath = PathTool.getTargetCSB("braveroad/brave_road_video_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    
    self.label_title = self.root_wnd:getChildByName("label_title")
    self.label_title:setTouchEnabled(true)
    self.node_head = self.root_wnd:getChildByName("node_head")
    self.label_name = self.root_wnd:getChildByName("label_name")
    self.label_power = self.root_wnd:getChildByName("label_power")

    self.my_head = PlayerHead.new(PlayerHead.type.circle)
    self.my_head:setTouchEnabled(true)
    self.my_head:setPosition(cc.p(0,0))
    self.my_head:setAnchorPoint(cc.p(0.5,0.5))
    self.node_head:addChild(self.my_head)

    self.btn_look = self.root_wnd:getChildByName("btn_look")
    self.btn_look:getChildByName("label"):setString(TI18N("语言_c_3945"))
    self.btn_tips = self.root_wnd:getChildByName("btn_tips")
    self.btn_tips:setVisible(false)
end

function BraveRoadVideoItem:registerEvent()
    registerButtonEventListener(self.btn_look, handler(self, self.onClickItem), true, 2)
    registerButtonEventListener(self.btn_tips, handler(self, self.onClickTips), true, 2)
end

function BraveRoadVideoItem:onClickItem()
    BattleController:getInstance():csRecordBattle(self.data.replay_id)
end

function BraveRoadVideoItem:onClickTips()
    local tips = self.data.tips
    local entry_data = {}
    for i, v in ipairs(tips) do
        entry_data[#entry_data + 1] = {cid = self.data.cid, tips_id = v.tips_id}
    end 
    _controller:openBraveRoadBossEntryView(true, {entry_data = entry_data})
end

function BraveRoadVideoItem:setData(data)
    self.data = data
    --head
    self.my_head:setHeadRes(data.face_id, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    --title
    self.label_title:setString(transformTextToShort(TITLE_STR[data.type],60))
    addEvt2showAllTextTips(self.label_title,TITLE_STR[data.type],60)
    --name
    self.label_name:setString(data.name)
    --power
    self.label_power:setString(TI18N("语言_c_1603")..MoneyTool.moneyFormat(data.power))
    --boss 词条
    self.btn_tips:setVisible(data.tips ~= nil)
end

function BraveRoadVideoItem:DeleteMe()
    self:removeAllChildren()
	self:removeFromParent()
end
