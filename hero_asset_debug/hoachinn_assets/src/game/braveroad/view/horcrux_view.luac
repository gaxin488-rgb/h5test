local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

HorcruxView = class("HorcruxView", function()
    return ccui.Widget:create()
end)

function HorcruxView:ctor()
	self:configUI()
	self:register_event()
end

function HorcruxView:configUI( )
	self.size = cc.size(120, 180)
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("braveroad/horcrux_view")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    self.container = container
end

function HorcruxView:register_event(  )
	registerButtonEventListener(self.container, function (  )
	end, true, 1)
end

function HorcruxView:setData( customs_vo, cfg_data, level_id)
	self:updateCustomsItem()
end

function HorcruxView:updateCustomsItem(  )
	if not self.cfg_data then return end
	
	-- 关卡图标
	-- 关卡章节
	-- 星数
	self:updateStarInfo()
end

function HorcruxView:updateStarInfo( )
end

function HorcruxView:DeleteMe(  )
	self:removeAllChildren()
    self:removeFromParent()
end