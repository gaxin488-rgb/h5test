-- @date 2021/5
-- @description: 勇者之路 魂器选择
---------------------------------
local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()

HorcruxChoosePanel = HorcruxChoosePanel or BaseClass(BaseView)

function HorcruxChoosePanel:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "braveroad/horcrux_choose_panel"

    self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("planes", "planes_buff"), type = ResourcesType.plist},
	}

	self.horcruxes_item_list = {}
end

function HorcruxChoosePanel:open_callback( )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container

	local txt_list = {
        {"tips_txt", TI18N("语言_c_5341")},
	}
	setTextContentList(main_container, txt_list)

	self.btn_chose = main_container:getChildByName("btn_chose")
	self.btn_chose:getChildByName("label"):setString(TI18N("语言_c_367"))
	self.btn_chose:setVisible(false)

    self.desc_bg = main_container:getChildByName("desc_bg")
	self.desc_title_txt = main_container:getChildByName("desc_title_txt")
	setTextMaxWidth(self.desc_title_txt,500);
	self.desc_title_txt:setString(TI18N("语言_c_3075"))
	self.desc_txt = main_container:getChildByName("desc_txt")
	setTextMaxWidth(self.desc_txt,500)
    self.desc_bg:setVisible(false)
    self.desc_title_txt:setVisible(false)
    self.desc_txt:setVisible(false)
end

function HorcruxChoosePanel:register_event( )
	registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn), false, 2)
	registerButtonEventListener(self.btn_chose, handler(self, self.onClickChoseBtn), true)
end

function HorcruxChoosePanel:onClickCloseBtn(  )
	_controller:openHorcruxChoosePanel(false)
end

function HorcruxChoosePanel:onClickChoseBtn(  )
	if self.cur_horcruxes_item and self.cid then
		local horcruxes_id = self.cur_horcruxes_item:getBuffId()
		_controller:sender13105( self.cid, horcruxes_id, self.way)
		self:onClickCloseBtn(  )
	end
end
--data {horcruxes_list, cid}
function HorcruxChoosePanel:openRootWnd(data)
	self.cid = data.cid
	self.way = data.pos
	self:setData(data.horcruxes_list)
end

function HorcruxChoosePanel:setData( horcruxes_list )
	if not horcruxes_list or next(horcruxes_list) == nil then return end

	local main_con_size = self.main_container:getContentSize()
	local space_x = 20
	local item_width = 200
	local start_x = main_con_size.width*0.5 - (item_width+space_x)
	for i,horcruxes_vo in ipairs(horcruxes_list) do
		local buff_cfg = Config.PartnerSoulData.data_base_info[horcruxes_vo.hid]
		if buff_cfg then
			local buff_item = self.horcruxes_item_list[i]
			if not buff_item then
				buff_item = HorcruxChooseItem.new(handler(self, self.onClickCallBack))
				self.main_container:addChild(buff_item)
				self.horcruxes_item_list[i] = buff_item
			end
			buff_item:setData(buff_cfg, horcruxes_vo)
			buff_item:setPosition(start_x+(i-1)*(item_width+space_x), 290)
		end
	end
end

-- 点击了某一buff
function HorcruxChoosePanel:onClickCallBack( item )
	self.desc_bg:setVisible(true)
    self.desc_title_txt:setVisible(true)
    self.desc_txt:setVisible(true)
	if self.cur_horcruxes_item then
		self.cur_horcruxes_item:setIsSelect(false)
	end
	item:setIsSelect(true)
	self.cur_horcruxes_item = item

	self.desc_txt:setString(self.cur_horcruxes_item.horcruxes_cfg.story)
    local desc_title_height = self.desc_title_txt:getContentSize().height;
    local desc_height = self.desc_txt:getContentSize().height;
    local descbg_width = self.desc_bg:getContentSize().width;
    self.desc_bg:setContentSize(descbg_width,desc_title_height + desc_height + 50)
	local pos_x = item:getPositionX()
	self.btn_chose:setPositionX(pos_x)
	self.btn_chose:setVisible(true)
end

function HorcruxChoosePanel:close_callback( )
	for k,item in pairs(self.horcruxes_item_list) do
		item:DeleteMe()
		item = nil
	end
	_controller:openHorcruxChoosePanel(false)
end