local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local _string_format = string.format
local _table_sort = table.sort
local off_width = 30
BraveRoadChapterWindow = BraveRoadChapterWindow or BaseClass(BaseView)

function BraveRoadChapterWindow:__init(cid)
    self.is_full_screen = true
    self.layout_name = "braveroad/brave_road_chapter_window"
    self.win_type = WinType.Full  
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("limit_training","limit_training"), type = ResourcesType.plist },
        -- { path = PathTool.getPlistImgForDownLoad("bigbg/limit_training_bg","bigbg_84", true), type = ResourcesType.single },
    }
    self.cid = cid
    self.isLeadMove = false
    self.holiday_bid = Config.LimitTrainingData.data_const.event_bid.val or 993071

    _model:setBraveRoadLoginRed(false)
end

function BraveRoadChapterWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    --self.background:loadTexture(PathTool.getPlistImgForDownLoad("bigbg","bigbg_84",true), LOADTEXT_TYPE)
    self.background:setScale(display.getMaxScale())

    self.panel_change_effect = self.root_wnd:getChildByName("panel_change_effect")
    self.panel_change_effect:setVisible(false)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self.container_size = self.main_container:getContentSize()
    self:playEnterAnimatianByObj(self.main_container, 1)

    self.image_bg_1 = self.main_container:getChildByName("image_bg_1")
    self.image_bg_2 = self.main_container:getChildByName("image_bg_2")
    self.image_bg_3 = self.main_container:getChildByName("image_bg_3")
    self.node_effect_1 = self.main_container:getChildByName("node_effect_1")
    self.node_effect_2 = self.main_container:getChildByName("node_effect_2")
    self.node_effect_3 = self.main_container:getChildByName("node_effect_3")
    self.image_bg_1:ignoreContentAdaptWithSize(true)
    self.image_bg_2:ignoreContentAdaptWithSize(true)
    self.image_bg_3:ignoreContentAdaptWithSize(true)

    self.top_panel = self.main_container:getChildByName("top_panel")
	local wnd_title = self.top_panel:getChildByName("wnd_title")
    wnd_title:setString(TI18N("语言_c_5071"))

    self.wnd_title_lv = self.top_panel:getChildByName("wnd_title_lv")
    self.wnd_title_lv:setPositionY(self.wnd_title_lv:getPositionY() - 6)

    self.btn_rule = self.top_panel:getChildByName("btn_rule")
    
    self.jump_right = self.top_panel:getChildByName("jump_right")
    self.jump_right:getChildByName("label"):setString(TI18N("语言_c_5072"))
    self.jump_left = self.top_panel:getChildByName("jump_left")
    self.jump_left:getChildByName("label"):setString(TI18N("语言_c_5073"))

    self.activity_panel = self.top_panel:getChildByName("activity_panel")
	self.activity_panel:getChildByName("tips"):setString(TI18N("语言_c_6302"))
	self.jump_activity_btn = self.activity_panel:getChildByName("jump_activity_btn")
	self.jump_activity_btn:getChildByName("txt"):setString(TI18N("语言_adv_05_74"))
	self.activity_panel:setVisible(false)

    local spine_model = createSpineByName("E24757", PlayerAction.action)
    self.jump_right:addChild(spine_model)
    spine_model:setScale(0.5)
    spine_model:setPosition(cc.p(self.jump_right:getContentSize().width/2, self.jump_right:getContentSize().height/2))
    spine_model:setAnimation(0, PlayerAction.action_1, true)

    local spine_model = createSpineByName("E24758", PlayerAction.action)
    self.jump_left:addChild(spine_model)
    spine_model:setPosition(cc.p(self.jump_left:getContentSize().width/2, self.jump_left:getContentSize().height/2))
    spine_model:setScale(0.5)
    spine_model:setAnimation(0, PlayerAction.action_1, true)

    self.middle_panel = self.main_container:getChildByName("middle_panel")

    self.close_btn = self.main_container:getChildByName("close_btn")
    MainuiController:getInstance():setIsShowMainUIBottom(false) -- 隐藏底部UI

    self.bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.shop_btn = self.bottom_panel:getChildByName("shop_btn")
    self.horcrux_btn = self.bottom_panel:getChildByName("horcrux_btn")
    self.reward_btn = self.bottom_panel:getChildByName("reward_btn")
    self.clearance_btn = self.bottom_panel:getChildByName("clearance_btn")

    self.image_tip = self.bottom_panel:getChildByName("image_tip")  --bg
    self.tip_key = self.bottom_panel:getChildByName("tip_key")
    self.tip_key_value = self.tip_key:getChildByName("tip_key_value")
    self.tip_key:setString(TI18N("语言_c_4091"))
    ccui.Helper:doLayout(self.tip_key)
    self.figure_btn = self.bottom_panel:getChildByName("figure_btn")
    self.figure_btn:getChildByName("label"):setString(TI18N("语言_c_2342"))
    self.tip_diff = self.top_panel:getChildByName("tip_diff")
    self.last_time = self.top_panel:getChildByName("last_time")
    self.last_time_value = self.last_time:getChildByName("last_time_value")
    self.last_time:setString(TI18N("语言_c_2681"))
    ccui.Helper:doLayout(self.last_time)

    self.Image_3 = self.top_panel:getChildByName("Image_3")
    self.Image_3.size = self.Image_3:getContentSize()
    self.Image_2 = self.top_panel:getChildByName("Image_2")
    self.Image_2.size = self.Image_2:getContentSize()

    self:adaptationScreen()
end

--设置适配屏幕
function BraveRoadChapterWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)

    self.node_effect_1:setPositionY(bottom_y)
    self.node_effect_2:setPositionY(bottom_y)
    self.node_effect_3:setPositionY(bottom_y)
    self.middle_panel:setPositionY(bottom_y)

    local tab_y = self.image_bg_2:getPositionY()
    self.image_bg_2:setPositionY(top_y - (self.container_size.height - tab_y))

    local image_bg_3_y = self.image_bg_3:getPositionY()
    self.image_bg_3:setPositionY(bottom_y + image_bg_3_y)

    local image_bg_1_y = self.image_bg_1:getPositionY()
    self.image_bg_1:setPositionY(bottom_y + image_bg_1_y)
    --头部
    local tab_y = self.top_panel:getPositionY()
    self.top_panel:setPositionY(top_y - (self.container_size.height - tab_y))

    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)

    --底部
    local bottom_panel_y = self.bottom_panel:getPositionY()
    self.bottom_panel:setPositionY(bottom_y + bottom_panel_y)

    --多出的高度
    local height = (top_y - self.container_size.height) - bottom_y
    self.ext_height = height
end


function BraveRoadChapterWindow:showRoleShowEffect(status, action, pos_x, pos_y)
    if status then
        local pos_y = pos_y or self.lead_model:getPositionY()
        local pos_x = pos_x or self.lead_model:getPositionX()
        self.role_show_action = action or PlayerAction.action_1
        if self.role_show_effect == nil then
            self.role_show_effect = createEffectSpine("E27533", cc.p(pos_x, pos_y), cc.p(0.5, 0.5), true, self.role_show_action , function()
                if tolua.isnull(self.role_show_effect) then return end
                if self.role_show_action == PlayerAction.action_1 then
                    local new_x, new_y = 0, 0
                    if self.lead_config then
                        new_x, new_y = self.lead_config.coordinate[1][1], self.lead_config.coordinate[1][2]
                    else
                        new_x, new_y = self.middle_panel:getContentSize().width/2, 150
                    end
                    self.lead_model:runAction(cc.FadeIn:create(0.2))
                    self.lead_model:setPosition(new_x, new_y)
                    self:showRoleShowEffect(true, PlayerAction.action_2, new_x, new_y)
                    self.lead_model.is_play_dun = self.lead_id
                    self.isLeadMove = false
                else
                    self.role_show_effect:setVisible(false)
                end
            end)
            self.middle_panel:addChild(self.role_show_effect, 1000)
        else
            self.role_show_effect:setPosition(pos_x, pos_y)
            self.role_show_effect:setVisible(true)
            self.role_show_effect:setAnimation(0, self.role_show_action, false)
        end
    else
        if self.role_show_effect then
            self.role_show_effect:clearTracks()
            self.role_show_effect:removeFromParent()
            self.role_show_effect = nil
        end
    end
end

function BraveRoadChapterWindow:updateLead()
    if self.isLeadMove == true then
        return 
    end
    if not self.cid then
        return
    end
    local look_id = HomeworldController:getInstance():getModel():getMyCurHomeFigureId()
    -- if not look_id or look_id == 0 then
    --     return 
    -- end
    local figure_cfg = Config.HomeData.data_figure[look_id or 0]
    local effect_id = "H60001"
    if figure_cfg then
        effect_id = figure_cfg.look_id
    end
    if self.lead_model and self.lead_model.effect_id and self.lead_model.effect_id ~= effect_id then
        self.lead_model:removeFromParent()
        self.lead_model = nil
    end
    if not self.lead_model then
        self.lead_model = createSpineByName(effect_id, PlayerAction.action)
        self.middle_panel:addChild(self.lead_model, 10)
        self.lead_model:setScale(0.6)
        self.lead_model:setAnimation(0, PlayerAction.idle, true)
        self.lead_model.effect_id = effect_id
    end
    self.lead_id = _model:getLeadDun(self.cid, true)
    self.lead_config = Config.LimitTrainingData.data_dungeon[self.lead_id]
    if self.lead_model.is_play_dun and self.lead_model.is_play_dun ~= self.lead_id then
        --刷新坑位
        self.isLeadMove = true
        self.lead_model:runAction(cc.FadeOut:create(0.2))
        self:showRoleShowEffect(true, PlayerAction.action_1)
    else
        self.lead_model:setAnimation(0, PlayerAction.idle, true)
        self.lead_model.is_play_dun = self.lead_id
        if self.lead_config then
            self.lead_model:setPosition(self.lead_config.coordinate[1][1], self.lead_config.coordinate[1][2])
        else
            self.lead_model:setPosition(self.middle_panel:getContentSize().width/2, 150)
        end
    end
end

function BraveRoadChapterWindow:createDungeons()
    local list = _model:getDungeonConfigByCid(self.cid)
    self.dungeonList = self.dungeonList or {}
    for k, v in pairs(list) do
        for p, q in pairs(v) do
            if not self.dungeonList[k] then
                self.dungeonList[k] = {}
            end
            if not self.dungeonList[k][p] then
                local dungeonItem = BraveRoadChapterItem.new()
                self.middle_panel:addChild(dungeonItem, 9)
                self.dungeonList[k][p] = dungeonItem
            end
            self.dungeonList[k][p]:setData({cid = self.cid, dun_id = q.dun_id, dun_type = BraveRoadConst.Dun_Type.Mobs})
        end 
    end
end
--boss
function BraveRoadChapterWindow:createBoss()
    if not self.bossItem then
        local boss_cfg = Config.LimitTrainingData.data_dungeon_boss[self.cid]
        local bossItem = BraveRoadChapterItem.new()
        self.middle_panel:addChild(bossItem, 8)
        self.bossItem = bossItem
    end
    self.bossItem:setData({cid = self.cid, dun_type = BraveRoadConst.Dun_Type.Boss})
end
--水晶
function BraveRoadChapterWindow:createCrystal()
    --判断那些路能够激活水晶
    if not _model:getHorcruxBag() then return end
    local status, list = _model:checkDunActivity(self.cid, nil, BraveRoadConst.Dun_Type.Crystal)
    self.crystalList = self.crystalList or {}
    for k, v in pairs(self.crystalList) do
        v:setVisible(false)
    end
    for i, v in ipairs(list) do
        if not self.crystalList[v] then
            local boss_cfg = Config.LimitTrainingData.data_dungeon_boss[self.cid]
            local crystalItem = BraveRoadChapterItem.new()
            self.middle_panel:addChild(crystalItem, 9)
            self.crystalList[v] = crystalItem
        end
        self.crystalList[v]:setData({cid = self.cid, dun_type = BraveRoadConst.Dun_Type.Crystal, pos = v})
        self.crystalList[v]:setVisible(true)
    end
end

function BraveRoadChapterWindow:onClickFigureBtn()
    if not self.cid then return end
    local look_id = _model:getPlanesRoleLookId()
    if not look_id or look_id == 0 then
        local limit_cfg = Config.HomeData.data_const["open_lev"]
        local open_lv = 70
        if limit_cfg then
            open_lv = limit_cfg.val or 70
        end
        message(string_format(TI18N("语言_c_4370"), open_lv))
    else
        HomeworldController:getInstance():openHomeworldFigureWindow(true)
    end
end

function BraveRoadChapterWindow:register_event(  )
    registerButtonEventListener(self.jump_btn, function ( param, sender, event_type )
		JumpController:getInstance():jumpViewByEvtData({700, 993071})
    end, true, 2)
    
    registerButtonEventListener(self.close_btn, function (  )
        _controller:openBraveRoadChapterWindow(false)
    end, true, 2)

    registerButtonEventListener(self.shop_btn, function ( param, sender, event_type )
        _controller:openBraveRoadShopWindow(true)
    end, true, 2)

    registerButtonEventListener(self.horcrux_btn, function ( param, sender, event_type )
        -- if not _model:getHorcruxBag() then return end
        _controller:openBraveRoadBagWindow(true, self.cid)
    end, true, 2)

    registerButtonEventListener(self.reward_btn, function ( param, sender, event_type )
        _controller:openBraveRoadRewardWindow(true)
    end, true, 2)

    registerButtonEventListener(self.clearance_btn, function ( param, sender, event_type )
        _controller:openBraveRoadClearanceViewWindow(true)
    end, true, 2)

    registerButtonEventListener(self.jump_activity_btn, function ( param, sender, event_type )
        JumpController:getInstance():jumpViewByEvtData({700, self.holiday_bid})
    end, true, 2)

    registerButtonEventListener(self.figure_btn, handler(self, self.onClickFigureBtn), true, 2)

    registerButtonEventListener(self.jump_right, function ( param, sender, event_type )
        if self.isLeadMove then return end
        -- self:setData(self.cid + 1)
        --下一层判断是否解锁
        if self.cid then
            local cfg = Config.LimitTrainingData.data_const["unlock_lev"]
            if cfg and self.cid >= cfg.val then
                message(TI18N("语言_c_4939"))
                return 
            end
            self:showChangeCidEffect(self.cid + 1)
        end
    end, true, 2)

    registerButtonEventListener(self.jump_left, function ( param, sender, event_type )
        if self.isLeadMove then return end
        -- self:setData(self.cid - 1)
        if self.cid then
            self:showChangeCidEffect(self.cid - 1)
        end
    end, true, 2)

    -- 规则说明
    registerButtonEventListener(self.btn_rule, function ( param, sender, event_type )
        MainuiController:getInstance():openCommonExplainView(true, Config.LimitTrainingData.data_explain or Config.AdventureData.data_explain, TI18N("语言_c_76"))
    end, true, 2)

    -- --天界副本魂器选择池
    self:addGlobalEvent(BraveRoadEvent.Push_Brave_Road_Horcrux_Pool, function (horcruxes_list, way)
        if horcruxes_list == nil then return end
        _controller:openHorcruxChoosePanel(true, {horcruxes_list = horcruxes_list, cid = self.cid, pos = way})
    end)

    self:addGlobalEvent(BraveRoadEvent.Update_Brave_Road_Chapter, function (noChangeLead)
        local cid = self.cid or _model:getTargetCid()
        cid = _model:checkCidLimit(cid)
        self:setData((cid), noChangeLead)
    end)
    
    self:addGlobalEvent(BraveRoadEvent.Update_Brave_Road_Horcruxes, function ()
        self:createCrystal()
        self:updateLead()
    end)

    self:addGlobalEvent(BraveRoadEvent.Jump_Brave_Road_Cid, function (cid)
        self:setData(cid)
    end)
    
    -- 更换形象
    self:addGlobalEvent(HomeworldEvent.Update_My_Home_Figure_Event, function (  )
        local look_id = HomeworldController:getInstance():getModel():getMyCurHomeFigureId()
        _model:setPlanesRoleLookId(look_id)
        self:updateLead()
    end)
end

function BraveRoadChapterWindow:updateBg(cid)
    if self.cid and self.cid == cid then
        return 
    end
    self.node_effect_1:removeAllChildren()
    self.node_effect_2:removeAllChildren()
    self.node_effect_3:removeAllChildren()
    self.cid = cid
    _model:setTargetCid(cid)
    local boss_cfg = Config.LimitTrainingData.data_dungeon_boss[self.cid]
    if not boss_cfg then return end
    local resource = boss_cfg.resource or 1 
    local res = PathTool.getPlistImgForDownLoad("bigbg/limit_training_bg/"..resource, "limit_training_bg_1")
    self.bg_load_1 = loadImageTextureFromCDN(self.image_bg_1, res, ResourcesType.single, self.bg_load_1)
    local res = PathTool.getPlistImgForDownLoad("bigbg/limit_training_bg/"..resource, "limit_training_bg_2", true)
    self.bg_load_2 = loadImageTextureFromCDN(self.image_bg_2, res, ResourcesType.single, self.bg_load_2)
    local res = PathTool.getPlistImgForDownLoad("bigbg/limit_training_bg/"..resource, "limit_training_bg_3", true)
    self.bg_load_3 = loadImageTextureFromCDN(self.image_bg_3, res, ResourcesType.single, self.bg_load_3)

    self.wnd_title_lv:setString(string.format(TI18N("语言_c_34"), self.cid))
    --effect
    local animation_cfg = Config.LimitTrainingData.data_animation[resource]
    local node_list = {self.node_effect_1, self.node_effect_2, self.node_effect_3}
    for i, v in ipairs(animation_cfg.action) do
        delayRun(self.root_wnd, i/display.DEFAULT_FPS, function ()
            local spine_png = string_format("spine/%s/%s.png", v[1], "action")
            display.loadImage(spine_png, function(texture)
                local effect_pos = v[2]
                if tolua.isnull(node_list[effect_pos]) then return end
                local off_pos = animation_cfg.coordinate[i] or {0, 0}
                local play_effect = createEffectSpine(v[1], cc.p(off_pos[1],off_pos[2]), cc.p(0.5, 0.5), true, PlayerAction.action)
                node_list[effect_pos]:addChild(play_effect)
            end)
        end)
    end
end

function BraveRoadChapterWindow:showChangeCidEffect(cid)
    local spine_id = "E24215"
    local cid = cid
    local function finish_callback(event)
        self.panel_change_effect:setVisible(false)
        -- self:setData(cid)
    end
    self.panel_change_effect:setVisible(true)
    delayRun(self.root_wnd, 1/display.DEFAULT_FPS, function ()
        local spine_png = string_format("spine/%s/%s.png", spine_id, "action")
        display.loadImage(spine_png, function(texture)
            if tolua.isnull(self.panel_change_effect) then return end
            local play_effect = createEffectSpine(spine_id, cc.p(0,0), cc.p(0.5, 0.5), false, PlayerAction.action, finish_callback)
            self.panel_change_effect:addChild(play_effect)
            play_effect:setPosition(cc.p(360, 640))
            delayOnce(function()
                if tolua.isnull(self.panel_change_effect) then return end
                self:setData(cid)
            end, 0.6)
        end)
    end)
end

function BraveRoadChapterWindow:openRootWnd()
    local ac_controller = ActionController:getInstance()
	local tab_vo = ac_controller:getActionSubTabVo(self.holiday_bid)
	if tab_vo then
		self.activity_panel:setVisible(true)
	else
		self.activity_panel:setVisible(false)
	end

    if not _model:checkIsResertTime() then
        self:setData(1, true)
    else
        _controller:sender13100()
    end
    local look_id = HomeworldController:getInstance():getModel():getMyCurHomeFigureId()
	if not look_id or look_id == 0 then
		_controller:sender13114()
	else
		_model:setPlanesRoleLookId(look_id)
	end
end

function BraveRoadChapterWindow:setData(cid, noChangeLead)
    self:updateBg(cid)
    if not noChangeLead then
        self:updateLead()
    end
    self:createDungeons()
    self:createBoss()
    self:createCrystal()
    self:updateJumpBtn()
    self:updateTips()
end

function BraveRoadChapterWindow:updateJumpBtn()
    self.jump_right:setVisible(self.cid < _model:getCurCid() and _model:getCurCid() > 1)
    self.jump_left:setVisible(self.cid <= _model:getCurCid() and self.cid > 1)
end

function BraveRoadChapterWindow:updateTips()
    self:updateChallengeTime()
    local lv = _model:getMonthDiff()
    if not _model:checkOpenFirstMonth() then
        local fake_lev = Config.LimitTrainingData.data_const["fake_lev"]
        if fake_lev then
            lv = lv + fake_lev.val
        else
            lv = lv + 10
        end
    end
    local cfg = Config.LimitTrainingData.data_choose_diff[_model:getMonthDiff()+1]
    self.tip_diff:setString(TI18N("语言_c_5074")..cfg.name)
    self.tip_diff:setColor(Config.ColorData.data_color4[cfg.color_a])
    if self.tip_diff:getContentSize().width + off_width > self.Image_2.size.width then
        self.Image_2:setContentSize(cc.size(self.tip_diff:getContentSize().width + off_width, self.Image_2.size.height))
    end
    self:setLessTime()
end

function BraveRoadChapterWindow:updateChallengeTime()
    local less_time = TimeTool.getOneMonthLessTime()
    local day_num = math.floor(less_time/TimeTool.day2s())
    if tonumber(day_num) < Config.LimitTrainingData.data_const["daily_challenge_limit"].val then
        self.tip_key_value:setString(TI18N("语言_c_5136"))
    else
        self.tip_key_value:setString(_model:getLastCount())
    end
    local width = self.tip_key:getContentSize().width + self.tip_key_value:getContentSize().width
    self.image_tip:setContentSize(cc.size(width + 70, 36))
end

--设置倒计时
function BraveRoadChapterWindow:setLessTime()
    if tolua.isnull(self.last_time_value) then return end
    self.last_time_value:stopAllActions()
    local less_time = TimeTool.getOneMonthLessTime()
    if less_time > 0 then
        self:setLastTimeValue(TimeTool.getDHMS(less_time))
        self.last_time_value:runAction(cc.RepeatForever:create(cc.Sequence:create(
            cc.DelayTime:create(1), cc.CallFunc:create(function()
            less_time = less_time - 1
            if less_time < 0 then
                self.last_time_value:stopAllActions()
            else
                self:setLastTimeValue(TimeTool.getDHMS(less_time))
                self:updateChallengeTime()
            end
        end)
        )))
    else
        self:setLastTimeValue(0)
    end
end

function BraveRoadChapterWindow:setLastTimeValue(time)
    self.last_time_value:setString(time)
    if self.last_time.fix_pos then
        return
    end
    local c_w = self.last_time:getContentSize().width + self.last_time_value:getContentSize().width
    local t_w = self.top_panel:getContentSize().width
    self.last_time:setPositionX((t_w - c_w)/2)
    self.last_time.fix_pos = true
    if c_w + off_width > self.Image_3.size.width then
        self.Image_3:setContentSize(cc.size(c_w + off_width, self.Image_3.size.height))
    end
end

function BraveRoadChapterWindow:setVisible( bool )
	self.is_visible = bool
	if self.root_wnd == nil or tolua.isnull(self.root_wnd) then return end
	self.root_wnd:setVisible(bool)
	if bool == true then
		MainuiController:getInstance():setIsShowMainUIBottom(false) -- 隐藏底部UI
	else
		MainuiController:getInstance():setIsShowMainUIBottom(true) -- 隐藏底部UI
	end
end

function BraveRoadChapterWindow:close_callback(  ) 
	if self.bg_load_1 then 
        self.bg_load_1:DeleteMe()
        self.bg_load_1 = nil
    end
    if self.bg_load_2 then 
        self.bg_load_2:DeleteMe()
        self.bg_load_2 = nil
    end
    if self.bg_load_3 then 
        self.bg_load_3:DeleteMe()
        self.bg_load_3 = nil
    end
    MainuiController:getInstance():setIsShowMainUIBottom(true) -- 隐藏底部UI
    _controller:openBraveRoadChapterWindow(false)
end