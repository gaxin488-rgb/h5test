local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadVideo = BraveRoadVideo or BaseClass(BaseView)

function BraveRoadVideo:__init()
	self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "braveroad/brave_road_video"

    self.role_vo = RoleController:getInstance():getRoleVo()
    self.show_list = {}
end

function BraveRoadVideo:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("main_container")
	self.container = container
    self:playEnterAnimatianByObj(container, 2)
    local Image_17 = container:getChildByName("Image_17")
	local title_label = container:getChildByName("title_label")
	title_label:setString(TI18N("语言_c_1605"))
    moveTextBg(title_label,Image_17,60,Image_17:getContentSize().width)
    self.close_btn = container:getChildByName("close_btn")
    

	self.panel_list = container:getChildByName("panel_list")
	self.res_label = container:getChildByName("res_label")

	local scroll_view_size = self.panel_list:getContentSize()
    local setting = {
        item_class = BraveRoadVideoItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 4,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 610,               -- 单元的尺寸width
        item_height = 160,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.panel_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
end

function BraveRoadVideo:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openBraveRoadVideo(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openBraveRoadVideo(false)
	end, false, 2)

    self:addGlobalEvent(BraveRoadEvent.Pass_Video_Update, function ( data )
        self:setData(data)
    end)
    
    self:addGlobalEvent(BraveRoadEvent.Pass_Boss_Video_Update, function ( data )
        self:setData(data)
	end)
end

function BraveRoadVideo:openRootWnd(data)
    self.data = data
    if data.dun_id then
        _controller:sender13112(data.cid, data.dun_id)
    else
        _controller:sender13113(data.cid)
    end
end

function BraveRoadVideo:setData(data)
    local data = data
    for i, v in ipairs(data) do
        v.cid = self.data.cid
    end
    self.item_scrollview:setData(data)
    if #data == 0 then
        commonShowEmptyIcon(self.panel_list, true, {text = TI18N("语言_c_5089")})
    else
        commonShowEmptyIcon(self.panel_list, false)
    end
end

function BraveRoadVideo:close_callback(  )
	_controller:openBraveRoadVideo(false)
end