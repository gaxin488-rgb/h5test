local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadBossSelectEntryPanel = BraveRoadBossSelectEntryPanel or BaseClass(BaseView)

function BraveRoadBossSelectEntryPanel:__init()
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "braveroad/brave_road_boss_select_entry_panel"
end

function BraveRoadBossSelectEntryPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

	local container = self.root_wnd:getChildByName("container")
	self:playEnterAnimatianByObj(container, 2)

	local title_bg = container:getChildByName("image_2")
	local wnd_title = container:getChildByName("win_title")
	wnd_title:setString(TI18N("语言_c_5092"))
	moveTextBg(wnd_title,title_bg,60,159)
	local panel_top = container:getChildByName("panel_top")
	self.btn_list = {}
	local boss_cfg = Config.LimitTrainingData.data_dungeon_boss[1] --取文本
	local tab_titles = {TI18N("语言_c_5336"), TI18N("语言_c_5337"), TI18N("语言_c_5338"), TI18N("语言_c_5339")}
	for i = 1, 4, 1 do
		local btn = panel_top:getChildByName("btn_tab_"..i)
		btn.image_click = btn:getChildByName("image_click")
		btn.sp_select_mark = btn:getChildByName("sp_select_mark")
		btn.label = btn:getChildByName("label")
		setTextSpacing(btn.label,-14)
		btn.label:setString(tab_titles[i])
		btn.index = i
		self.btn_list[#self.btn_list + 1] = btn
	end
	--词条列表
	self.panel_middle = container:getChildByName("panel_middle")
	self.scroll_view = self.panel_middle:getChildByName("scroll_view")
	self.scroll_view:setScrollBarEnabled(false)
	self.scroll_view.size = self.scroll_view:getContentSize()

	self.label_last = self.panel_middle:getChildByName("label_last")
	self.label_des = self.panel_middle:getChildByName("label_des")
	self.label_star = self.panel_middle:getChildByName("label_star")
	self.label_diff = self.label_star:getChildByName("label_diff")
	self.image_star = self.label_star:getChildByName("image_star")

	self.confirmBtn = container:getChildByName("challenge_btn")
	self.confirmBtn.label = self.confirmBtn:getChildByName("label")
	self.confirmBtn.label:setString(TI18N("语言_c_3"))

	self.close_btn = container:getChildByName("close_btn")
end

function BraveRoadBossSelectEntryPanel:register_event(  )
	registerButtonEventListener(self.container, function (  )
		_controller:openBraveRoadBossSelectEntryPanel(false)
	end, false, 1)
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openBraveRoadBossSelectEntryPanel(false)
	end, true, 1)

	registerButtonEventListener(self.confirmBtn, function (  )
		local tips = {}
		local config = Config.LimitTrainingData.data_dungeon_boss[self.cid]
		for k, v in pairs(self.selectEntryData) do
			for p, q in pairs(v) do
				local data_tips_id = config.tips_lib[k][p]
				local data_tips_cfg = Config.LimitTrainingData.data_tips[data_tips_id]
				if data_tips_cfg then
					tips[#tips +1] = {tips_id = data_tips_cfg[q].bid}
				end
			end
		end
		_model:setCurCidTips(self.cid, tips)
		_controller:openBraveRoadBossSelectEntryPanel(false)
	end, true, 2)

	for i, v in ipairs(self.btn_list) do
		registerButtonEventListener(v, function (_, sender)
			self:selectTab(sender.index)
		end, true, 2)
	end
end

function BraveRoadBossSelectEntryPanel:getTabData(index)
	local config = Config.LimitTrainingData.data_dungeon_boss[self.cid or 1]
	return config.tips_lib[index] or {}
end

function BraveRoadBossSelectEntryPanel:selectTab(index)
	if self.cur_tab_index == index then return end
	self.cur_tab_index = index
	self:updateLabeInfo()
	for i, v in ipairs(self.btn_list) do
		v.image_click:setVisible(index == i)
	end
	self.entryItems = self.entryItems or {}
	local data = self:getTabData(index)
	local count = math.max(#data, #self.entryItems)
	for i = 1, count, 1 do
		local temp_data = data[i]
		local temp_item = self.entryItems[i]
		if temp_data then
			if not temp_item then
				temp_item = BraveRoadBossSelectEntryItem.new()
				self.scroll_view:addChild(temp_item)
				self.entryItems[#self.entryItems + 1] = temp_item
				temp_item:setPositionY(self.scroll_view.size.height - temp_item.size.height*i)
			end
			local getCurSelectBox = function(tab_index, cell_index)
				if self.selectEntryData[index] and self.selectEntryData[index][cell_index] then
					return self.selectEntryData[index][cell_index]
				end
				return 0
			end
			local n_data = {
				lib_id = temp_data,
				callback = function(sender,event_type, tab_index, cell_index, box_index)
					self:selctEntryBack(sender,event_type, tab_index, cell_index, box_index)
				end,
				tab_index = index,
				cell_index = i,
				select_box = getCurSelectBox(index, i),
			}
			temp_item:setData(n_data)
			temp_item:setVisible(true)
		else
			if temp_item then
				temp_item:setVisible(false)
			end
		end
	end
end


function BraveRoadBossSelectEntryPanel:checkCanSelect(tab_index, cell_index, box_index)
	local count = 0
	for k, v in pairs(self.selectEntryData) do
		count = count + 1
	end
	if count >= self.tips_num and not (self.selectEntryData[tab_index]) then --选择词条已满
		message(TI18N("语言_c_5066"))
		return false
	end
	local temp_tab_index = {}
	if self.selectEntryData[tab_index] and not self.selectEntryData[tab_index][cell_index] then
		-- message(TI18N("每页只能选择一个词条"))
		temp_tab_index = self.selectEntryData[tab_index]
		-- return false
	end
	self.selectEntryData[tab_index] = {}
	self.selectEntryData[tab_index][cell_index] = box_index
	return true, temp_tab_index
end

function BraveRoadBossSelectEntryPanel:selctEntryBack(sender,event_type, tab_index, cell_index, box_index)
	if event_type == ccui.CheckBoxEventType.selected then
		local statue,temp_tab_index  = self:checkCanSelect(tab_index, cell_index, box_index)
		sender:setSelected(statue)
		if statue then
			sender.parent:updateBaseInfo(box_index)
		end
		if temp_tab_index ~= {} then
			self:clearEntry(temp_tab_index)
		end
	elseif event_type == ccui.CheckBoxEventType.unselected then 
		self.selectEntryData[tab_index] = nil
	end
	self:updateLabeInfo()
	self:updateTabSelectMark(tab_index)
end

function BraveRoadBossSelectEntryPanel:clearEntry(temp_tab_index)
	if not temp_tab_index then return end
	for cell_index, box_index in pairs(temp_tab_index) do
		for i, v in ipairs(self.entryItems) do
			if v:isVisible() then
				local data = v:getData()
				if data.cell_index == cell_index then
					v:clearnAllBox()
					v:updateBaseInfo(0)
					break
				end
			end
		end
	end
end

function BraveRoadBossSelectEntryPanel:openRootWnd(data)
	self.data = data
	self.cid = data.cid
	local config = Config.LimitTrainingData.data_dungeon_boss[self.cid or 1]
	self.tips_num = config.tips_num
	self.selectEntryData = {}
	local tips = _model:getCurCidTips(self.cid)
	for i, v in ipairs(tips) do  --4
		for m, n in ipairs(config.tips_lib) do --4 tab
			for p, q in ipairs(n) do --3   cell
				local have = false
				local data_tips_cfg = Config.LimitTrainingData.data_tips[q] 
				for a, b in ipairs(data_tips_cfg or {}) do --3  --star
					if b.bid == v.tips_id then
						self.selectEntryData[m] = {}
						self.selectEntryData[m][p] = a
						have = true
					end
				end
				if have then
					break
				end
			end
		end
	end
	self.cur_tab_index = 0
	self:selectTab(1)
	self:setData()
end

function BraveRoadBossSelectEntryPanel:setData()
	self:updateTabSelectMark()
	self.label_des:setString(TI18N("语言_c_5067"))
	self:updateLabeInfo()
end	
--获取当前 剩余可选词条 当前列表难度
function BraveRoadBossSelectEntryPanel:getCurSelectEntryCount()
	local count = 0
	for k, v in pairs(self.selectEntryData) do
		count = count + 1
	end
	return count
end

function BraveRoadBossSelectEntryPanel:getCurSelectEntryInfo()
	local count = self:getCurSelectEntryCount()
	local last_num = self.tips_num - count
	local diff_num = 0
	if self.selectEntryData[self.cur_tab_index] then
		for k, v in pairs(self.selectEntryData) do
			for p, q in pairs(v) do
				diff_num = diff_num + q
			end
		end
	end
	return last_num, diff_num
end

function BraveRoadBossSelectEntryPanel:updateLabeInfo()
	local last_num, diff_num = self:getCurSelectEntryInfo()
	self.label_last:setString(TI18N("语言_c_5068")..last_num)
	self.label_diff:setString(TI18N("语言_c_505"))
	self.label_star:setString(diff_num)
	ccui.Helper:doLayout(self.label_star)
end

function BraveRoadBossSelectEntryPanel:updateTabSelectMark(index)
	if index then
		self.btn_list[index].sp_select_mark:setVisible(self.selectEntryData[index] ~= nil)
	else
		for i, v in ipairs(self.btn_list) do
			v.sp_select_mark:setVisible(self.selectEntryData[i] ~= nil)
		end
	end
end

function BraveRoadBossSelectEntryPanel:close_callback(  )
	GlobalEvent:getInstance():Fire(BraveRoadEvent.Select_Tips_Brave_Road_Update)
	_controller:openBraveRoadBossSelectEntryPanel(false)
end

--- 词条item
BraveRoadBossSelectEntryItem = class("BraveRoadBossSelectEntryItem", function()
    return ccui.Widget:create()
end)

function BraveRoadBossSelectEntryItem:ctor()
	self:configUI()
	self:register_event()
end

function BraveRoadBossSelectEntryItem:configUI( )
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0, 0))

	local csbPath = PathTool.getTargetCSB("braveroad/brave_road_boss_select_entry_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
	self:setContentSize(self.size)

    local container = self.root_wnd:getChildByName("container")
	self.container = container
	
	self.image_icon = container:getChildByName("image_icon")
	self.image_icon:ignoreContentAdaptWithSize(true)
	self.label_name = container:getChildByName("label_name")

	self.img_select_mark = container:getChildByName("img_select_mark")

	local Image_box_bg = container:getChildByName("Image_box_bg")
	self.boxList = {}
	for i = 1, 3 do
		local checkbox = Image_box_bg:getChildByName("btn_star_"..i)
		self.boxList[#self.boxList + 1] = checkbox
		checkbox.index = i
		checkbox:setSelected(false)
		checkbox.parent = self
	end
	
	self.scrollview_des = container:getChildByName("scrollview_des")
	self.scrollview_des:setScrollBarEnabled(false)
	self.scrollview_des.size = self.scrollview_des:getContentSize()
	self.label_des = self.scrollview_des:getChildByName("label_des")
	self.label_des:ignoreContentAdaptWithSize(true)
	self.label_des:setTextAreaSize(cc.size(490, 0))
	setTextSpacing(self.label_des)
end

function BraveRoadBossSelectEntryItem:clearnAllBox()
	for i, v in ipairs(self.boxList) do
		v:setSelected(false)
	end
end

function BraveRoadBossSelectEntryItem:register_event(  )
	for i, v in ipairs(self.boxList) do
		v:addEventListener(function ( sender,event_type )
			if event_type == ccui.CheckBoxEventType.selected then
				playButtonSound2()
				self:clearnAllBox()
			elseif event_type == ccui.CheckBoxEventType.unselected then 
				playButtonSound2()
				self:updateBaseInfo(0)
			end
			if self.callback then
				self.callback(sender,event_type, self.data.tab_index, self.data.cell_index, sender.index)
			end
		end)
	end
end

function BraveRoadBossSelectEntryItem:setData(data)
	self.data = data
	self.callback = data.callback
	self:updateBox()
	self:updateBaseInfo()
end

function BraveRoadBossSelectEntryItem:getData()
	return self.data
end

function BraveRoadBossSelectEntryItem:updateBaseInfo(box_index)
	if box_index then
		self.data.select_box = box_index
	end
	local tip_cfg = Config.LimitTrainingData.data_tips_lib[self.data.lib_id]
	if self.data.select_box ~= 0 and Config.LimitTrainingData.data_tips[self.data.lib_id] then
		tip_cfg  = Config.LimitTrainingData.data_tips[self.data.lib_id][self.data.select_box]
	end
	-- self.label_name:setString(tip_cfg.tip)
	self.label_name:setString(transformTextToShort(tip_cfg.tip, 6))
	self.label_name:setTouchEnabled(true)
	addEvt2showAllTextTips(self.label_name,tip_cfg.tip,6, nil, -100)

	self.label_des:setString(tip_cfg.desc)

	local height = self.label_des:getContentSize().height

	if height > self.scrollview_des.size.height then
		self.scrollview_des:setInnerContainerSize(cc.size(self.scrollview_des.size.width, height))
	else
		height = self.scrollview_des.size.height
	end
	self.label_des:setPositionY(height)

	local res = PathTool.getBraveRoadEntryIcon(self.data.tab_index)
	self.image_icon:loadTexture(PathTool.getResFrame("limit_training",res), LOADTEXT_TYPE_PLIST)

	self.img_select_mark:setVisible(self.data.select_box and self.data.select_box ~= 0)
end

function BraveRoadBossSelectEntryItem:updateBox()
	for i, v in ipairs(self.boxList) do
		v:setSelected(self.data.select_box == i)
	end
end

function BraveRoadBossSelectEntryItem:updateStarInfo( )
end

function BraveRoadBossSelectEntryItem:DeleteMe(  )
end