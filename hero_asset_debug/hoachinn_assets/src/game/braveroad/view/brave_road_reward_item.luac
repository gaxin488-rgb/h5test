		-- 勇者之路 奖励预览 item
--------------------------------- 
local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadRewardItem = class('BraveRoadRewardItem',function()
    return ccui.Widget:create()
end)

function BraveRoadRewardItem:ctor(callback)
    self.callback = callback
    self:configUI()
    self:registerEvent()
end

function BraveRoadRewardItem:configUI()
    self:setAnchorPoint(cc.p(0, 0))
	self:setTouchEnabled(false)

	local csbPath = PathTool.getTargetCSB("braveroad/brave_road_reward_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
	self:setContentSize(self.size)

    local container = self.root_wnd:getChildByName("container")
    container:setSwallowTouches(false)
    self.container = container

    self.list_panel = container:getChildByName("list_panel")
	self.label_name = container:getChildByName("label_name")
    self.label_title = container:getChildByName("label_title")
    
    local scroll_view_size = self.list_panel:getContentSize()
    local scale = 0.9
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 4,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*scale,               -- 单元的尺寸width
        item_height = BackPackItem.Height*scale,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
        scale = scale
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.list_panel, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
    self.item_scrollview:setBounceEnabled(false)
end

function BraveRoadRewardItem:registerEvent()
    registerButtonEventListener(self.container, handler(self, self.onClickItem), true)
end

function BraveRoadRewardItem:onClickItem()

end

function BraveRoadRewardItem:setData(data)
    self.data = data

    self.label_name:setString(data.name)
    self.label_title:setString(data.title)
    local rewards = data.awards
    local list = {}
    for i, v in ipairs(rewards) do
        list[#list + 1] = {bid = v[1], num = v[2]}
    end
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function()
        local item_list = self.item_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
        end
    end)
end

function BraveRoadRewardItem:DeleteMe()
    self:removeAllChildren()
	self:removeFromParent()
end
