local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadBagWindow = BraveRoadBagWindow or BaseClass(BaseView)

function BraveRoadBagWindow:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "braveroad/brave_road_bag_window"

    self.role_vo = RoleController:getInstance():getRoleVo()
    self.show_list = {}
end

function BraveRoadBagWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
	self.container = container
    self:playEnterAnimatianByObj(container, 2)
    local image_2 = container:getChildByName("image_2")
	local win_title = container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_5055"))
    moveTextBg(win_title,image_2,60,image_2:getContentSize().width)
    self.close_btn = container:getChildByName("close_btn")
    
    self.label_name = container:getChildByName("label_name")

	self.list_panel = container:getChildByName("list_panel")
	self.res_label = container:getChildByName("res_label")
    self.res_label:setString(TI18N("语言_c_5056"))
    self.jump_right = container:getChildByName("jump_right")
    self.jump_left = container:getChildByName("jump_left")
end

function BraveRoadBagWindow:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openBraveRoadBagWindow(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openBraveRoadBagWindow(false)
    end, false, 2)
    
    registerButtonEventListener(self.jump_right, function ( param, sender, event_type )
        self.cid = self.cid + 1
        self:setData()
    end, true, 2)

    registerButtonEventListener(self.jump_left, function ( param, sender, event_type )
        self.cid = self.cid - 1
        self:setData()
    end, true, 2)
end

function BraveRoadBagWindow:openRootWnd(cid)
    self.cid = cid or _model:getCurCid()
    self.cid = _model:checkCidLimit(self.cid)
    self:setData()
end

function BraveRoadBagWindow:setData()
    self:updateJumpBtn()
    self.label_name:setString(string.format(TI18N("语言_c_5057"), self.cid))
    self.h_list = self.h_list or {}
    for i, v in ipairs(self.h_list) do
        v:setVisible(false)
    end
    local h_data = _model:getRoadHorcrux(self.cid)
    if not h_data or not h_data.horcruxes_list then
        commonShowEmptyIcon(self.list_panel, true, {text = TI18N("语言_c_5091")})
        return
    else
        commonShowEmptyIcon(self.list_panel, false)
    end
    for i=1,3 do
        local data = h_data.horcruxes_list[i]
        local item = self.h_list[i]
        if data then
            if not item then
                item = BraveRoadBagItem.new()
                self.list_panel:addChild(item)
                self.h_list[i] = item
            end
            local buff_cfg = Config.PartnerSoulData.data_base_info[data.hid]
            item:setData(buff_cfg, data)
            item:setPosition(cc.p(110 + (i-1)*210, self.list_panel:getContentSize().height/2))
            item:setVisible(true)
        else
            if item then
                item:setVisible(false)
            end
        end
    end
end

function BraveRoadBagWindow:updateJumpBtn()
    self.jump_right:setVisible(self.cid < _model:checkCidLimit(_model:getCurCid()) and _model:getCurCid() > 1)
    self.jump_left:setVisible(self.cid <= _model:checkCidLimit(_model:getCurCid()) and self.cid > 1)
end

function BraveRoadBagWindow:close_callback(  )
	_controller:openBraveRoadBagWindow(false)
end