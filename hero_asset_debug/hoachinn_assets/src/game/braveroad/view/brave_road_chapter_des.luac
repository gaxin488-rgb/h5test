local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadChapterDes = BraveRoadChapterDes or BaseClass(BaseView)

function BraveRoadChapterDes:__init()
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "braveroad/brave_road_chapter_des"
end

function BraveRoadChapterDes:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

	local container = self.root_wnd:getChildByName("container")
	self:playEnterAnimatianByObj(container, 2)  

	self.title_bg = container:getChildByName("image_2")
	self.win_title = container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_219"))
	moveTextBg(self.win_title,self.title_bg,60,159)
	self.panel_top = container:getChildByName("panel_top")
	self.panel_top.label_name = self.panel_top:getChildByName("label_name")
	self.panel_top.label_limit = self.panel_top:getChildByName("label_limit")
	self.panel_top.label_limit:ignoreContentAdaptWithSize(true)
	self.panel_top.label_limit:setTextAreaSize(cc.size(600, 0))
	self.panel_top.label_power_title = self.panel_top:getChildByName("label_power_title")
	self.panel_top.label_power_title:setString(TI18N("语言_c_667"))
	self.panel_top.image_power_value = self.panel_top.label_power_title:getChildByName("image_power_value")
	self.panel_top.label_power_value = self.panel_top.image_power_value:getChildByName("label_power_value")
	ccui.Helper:doLayout(self.panel_top.label_power_title)


	self.btn_video = self.panel_top:getChildByName("btn_video")

	self.image_middle = container:getChildByName("image_middle")
	self.label_form = self.image_middle:getChildByName("label_form")
	self.label_form:setString(TI18N("语言_c_2054"))
	--整容列表
	local form_list = self.image_middle:getChildByName("image_1")
	local scroll_view_size = form_list:getContentSize()
    local setting = {
        item_class = HeroExhibitionItem,      -- 单元类
        start_x = 25,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 10,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 119,               -- 单元的尺寸width
        item_height = 119,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
    }
	self.form_scrollview = CommonScrollViewLayout.new(form_list, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
	self.form_scrollview:setBounceEnabled(false)
	self.form_scrollview:setSwallowTouches(false)
	
	--首通奖励
	local image_2 = self.image_middle:getChildByName("image_2")
	local label_reward = image_2:getChildByName("label_reward")
	label_reward:setString(TI18N("语言_c_2878"))
	local reward_list = self.image_middle:getChildByName("layout_list")
	local scroll_view_size = reward_list:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 3,                  -- 第一个单元的X起点
        space_x = 15,                    -- x方向的间隔
        start_y = 11,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width,               -- 单元的尺寸width
        item_height = BackPackItem.Height,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 1
    }
	self.reward_scrollview = CommonScrollViewLayout.new(reward_list, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
	self.reward_scrollview:setBounceEnabled(false)
	self.reward_scrollview:setSwallowTouches(false)

	self.close_btn = container:getChildByName("close_btn")
	self.challenge_btn = container:getChildByName("challenge_btn")
	self.challenge_btn:getChildByName("label"):setString(TI18N("语言_c_457"))
end

function BraveRoadChapterDes:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), true, 1)
	registerButtonEventListener(self.background, handler(self, self._onClickCloseBtn), nil, 1)
	registerButtonEventListener(self.btn_video, handler(self, self._onClickVideo), true, 2)

	registerButtonEventListener(self.challenge_btn, handler(self, self._onClickEmbattleBtn), true, 2)
end

function BraveRoadChapterDes:_onClickCloseBtn(  )
	_controller:openBraveRoadChapterDes(false)
end

function BraveRoadChapterDes:_onClickVideo(  )
	_controller:openBraveRoadVideo(true, {cid = self.config.cid, dun_id = self.dun_id})
end

function BraveRoadChapterDes:_onClickEmbattleBtn(  )
	if _model:getLastCount() <= 0 then
		message(TI18N("语言_c_1678"))
		return
	end
	local setting = {dun_id = self.dun_id, dun_type = self.config.formation, cid = self.config.cid}
	-- if self.config.formation == 0 then
		setting.level_id = self.config.cond_info
	-- end
	HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.Brave_Road, setting)
end

function BraveRoadChapterDes:openRootWnd(data)
	self:generateFormData(data.dun_id)
	self:setData()
end

function BraveRoadChapterDes:generateFormData(dun_id)
	self.dun_id = dun_id
	self.config = Config.LimitTrainingData.data_dungeon[self.dun_id]
	local data = self.data
	local unit_cfg = {}
	if _model:checkOpenFirstMonth() then
		unit_cfg = Config.UnitData.data_unit(self.config.unit_id2)
	else
		unit_cfg = Config.UnitData.data_unit(self.config.unit_id)
	end
	local monsters = {unit_cfg.monster1, unit_cfg.monster2, unit_cfg.monster3, unit_cfg.monster4, unit_cfg.monster5}
	local hero_list = {}
    for i,v in ipairs(monsters) do
        local monster_id = v
        local monster_cfg = Config.UnitData.data_unit(monster_id)
        if monster_cfg then
            local hero_vo = HeroVo.New()
            hero_vo.bid = tonumber(monster_cfg.head_icon)
            hero_vo.master_head_id = tonumber(monster_cfg.head_icon)
            hero_vo.lev = monster_cfg.lev
            hero_vo.star = monster_cfg.star
            hero_vo.camp_type = monster_cfg.camp_type
			hero_list[#hero_list +1] = hero_vo
        end
	end
	self.hero_list = hero_list
end

function BraveRoadChapterDes:generateRewardData()
	local award = self.config.award
	local item_data = {}
	for k, v in pairs(award) do
        local vo = deepCopy(Config.ItemData.data_get_data(v[1]))
        vo.quantity = v[2]
        table.insert(item_data, vo)
	end
	return item_data
end

function BraveRoadChapterDes:setData()
	self.panel_top.label_name:setString(self.config.dun_name..self.config.cid.."-"..self.config.stage)
	self.panel_top.label_limit:setString(self.config.cond_desc)
	if _model:checkOpenFirstMonth() then
		self.panel_top.label_power_value:setString(MoneyTool.moneyFormat(self.config.power2))
	else
		self.panel_top.label_power_value:setString(MoneyTool.moneyFormat(self.config.power))
	end

	self.form_scrollview:setData(self.hero_list)
	self.form_scrollview:addEndCallBack(function()
        local item_list = self.form_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultClick(false)
        end
    end)
	self.reward_scrollview:setData(self:generateRewardData())
	self.reward_scrollview:addEndCallBack(function()
        local item_list = self.reward_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
        end
    end)
end

function BraveRoadChapterDes:close_callback(  )
	self.form_scrollview:removeFromParent()
	self.form_scrollview = nil
	self.reward_scrollview:removeFromParent()
	self.reward_scrollview = nil
	_controller:openBraveRoadChapterDes(false)
end