local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local off_width = 30
BraveRoadBossDes = BraveRoadBossDes or BaseClass(BaseView)

function BraveRoadBossDes:__init()
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "braveroad/brave_road_boss_des"
end

function BraveRoadBossDes:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

	local container = self.root_wnd:getChildByName("container")
	self:playEnterAnimatianByObj(container, 2)  
	self.title_bg = container:getChildByName("image_2")
	self.win_title = container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_1884"))
	moveTextBg(self.win_title,self.title_bg,60,159)

	self.panel_top = container:getChildByName("panel_top")
	self.node_effect = self.panel_top:getChildByName("node_effect") -- boss 形象

	self.Image_diff = self.panel_top:getChildByName("Image_diff")
	self.Image_diff.size = self.Image_diff:getContentSize()
	self.tip_diff = self.panel_top:getChildByName("tip_diff")
	self.btn_switch = self.panel_top:getChildByName("btn_switch")
	self.btn_switch_txt = self.btn_switch:getChildByName("label")
	self.btn_switch_txt:setChangeScaleOffWidth(-1000)
	self.btn_switch_txt:setString(TI18N("语言_c_5455"))
	local _w = math.max(self.btn_switch_txt:getContentSize().width+10, 110)
	self.btn_switch:setContentSize(cc.size(_w,53))
	self.btn_switch_txt:setPositionX(_w /2)

	self.sp_camp = self.panel_top:getChildByName("sp_camp") 
	self.label_name = self.panel_top:getChildByName("label_name") 
	self.label_lv = self.panel_top:getChildByName("label_lv") 
	self.label_limit = self.panel_top:getChildByName("label_limit") 
	self.image_star = self.label_limit:getChildByName("image_star")
	self.label_star = self.label_limit:getChildByName("label_star")

	self.label_power_title = self.panel_top:getChildByName("label_power_title")
	self.label_power_title:setString(TI18N("语言_c_4568"))
	local image_power_value = self.panel_top:getChildByName("image_power_value")
	self.label_power_value = image_power_value:getChildByName("label_power_value")
	self.btn_video = self.panel_top:getChildByName("btn_video")
	self.btn_skill_view = self.panel_top:getChildByName("btn_skill_view")

	self.panel_skill = container:getChildByName("panel_skill")
	self.skill_view = self.panel_skill:getChildByName("skill_view")
	self.panel_skill:setSwallowTouches(false)

	self.panel_middle = container:getChildByName("panel_middle")
	local image_2 = self.panel_middle:getChildByName("image_2")
	local Panel_1 = image_2:getChildByName("Panel_1")
	self.label_reward_1 = Panel_1:getChildByName("label_reward_1")
	setTextSpacing(self.label_reward_1,-14)
	self.label_reward_1:setChangeScaleOffWidth(20)
	local image_3 = self.panel_middle:getChildByName("image_3")
	local Panel_3 = image_3:getChildByName("Panel_3")
	self.label_reward_2 = Panel_3:getChildByName("label_reward_2")
	setTextSpacing(self.label_reward_2,-10)
	self.label_reward_2:setChangeScaleOffWidth(20)

	self.panel_reward_1 = self.panel_middle:getChildByName("panel_reward_1")
	self.panel_reward_2 = self.panel_middle:getChildByName("panel_reward_2")
	self.label_air_des = self.panel_middle:getChildByName("label_air_des")
	self.label_air_des:setString(transformTextToShort(TI18N("语言_c_5058"),40))
	addEvt2showAllTextTips(self.label_air_des,TI18N("语言_c_5058"),40)
	self.label_entry_des = self.panel_middle:getChildByName("label_entry_des")
	self.label_entry_des:setString(transformTextToShort(TI18N("语言_c_5407"),80))
	addEvt2showAllTextTips(self.label_entry_des,TI18N("语言_c_5407"),80)

	self.label_down_des = self.panel_middle:getChildByName("label_down_des")
	self.label_down_des:setString(TI18N("语言_c_5059"))



	self.panel_bottom = container:getChildByName("panel_bottom")
	self.label_entry_title = self.panel_bottom:getChildByName("label_entry_title")
	self.label_entry_title:setString(TI18N("语言_c_5060"))
	self.label_entry_title:getChildByName("img_deck_2"):setPositionX(-10)
	self.label_entry_title:getChildByName("img_deck_1"):setPositionX(self.label_entry_title:getContentSize().width + 15)
	self.label_entry_count = self.panel_bottom:getChildByName("label_entry_count")
	self.label_entry_count:setString(TI18N("语言_c_5061"))
	self.Panel_2 = self.panel_bottom:getChildByName("Panel_2")
	self.btn_select = self.Panel_2:getChildByName("btn_select")
	self.btn_select:getChildByName("label"):setString(TI18N("语言_c_898"))
	self.btn_add = self.Panel_2:getChildByName("btn_add")
	self.btn_add:setTouchEnabled(true)
	--词条
	self.entry_icon_temp = self.Panel_2:getChildByName("entry_icon_temp")
	self.entry_icon_temp.name = self.entry_icon_temp:getChildByName("name")
	self.entry_icon_temp.star_1 = self.entry_icon_temp:getChildByName("star_1")
	self.entry_icon_temp.star_2 = self.entry_icon_temp:getChildByName("star_2")
	self.entry_icon_temp.star_3 = self.entry_icon_temp:getChildByName("star_3")
	self.entry_icon_temp.starList = {self.entry_icon_temp.star_1,self.entry_icon_temp.star_2, self.entry_icon_temp.star_3}
	self.entry_icon_temp.pos = cc.p(self.entry_icon_temp:getPosition())
	self.entry_icon_temp:setVisible(false)

	self.tips_label = createRichLabel(26, cc.c4b(0xf8,0xef,0x76,0xff),cc.p(0.5,0.5) , cc.p(322,70), -4, nil, 600)
	self.panel_bottom:addChild(self.tips_label)

	self.close_btn = container:getChildByName("close_btn")
	self.challenge_btn = container:getChildByName("challenge_btn")
	self.challenge_btn:getChildByName("label"):setString(TI18N("语言_c_457"))


	--首通奖励
	self.label_reward_1:setString(TI18N("语言_c_2878"))
	local scroll_view_size = self.panel_reward_1:getContentSize()
	local scale = 0.9
	local setting = {
		item_class = BackPackItem,      -- 单元类
		start_x = 3,                  -- 第一个单元的X起点
		space_x = 15,                    -- x方向的间隔
		start_y = 0,                    -- 第一个单元的Y起点
		space_y = 4,                   -- y方向的间隔
		item_width = BackPackItem.Width*scale,               -- 单元的尺寸width
		item_height = BackPackItem.Height*scale,              -- 单元的尺寸height
		row = 1,                        -- 行数，作用于水平滚动类型
		col = 0,                         -- 列数，作用于垂直滚动类型
		scale = scale
	}
	self.reward_scrollview = CommonScrollViewLayout.new(self.panel_reward_1, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
	self.reward_scrollview:setBounceEnabled(false)
	self.reward_scrollview:setSwallowTouches(false)

	
	--额外奖励
	self.label_reward_2:setString(TI18N("语言_c_5062"))
	local scroll_view_size = self.panel_reward_2:getContentSize()
	local setting = {
		item_class = BackPackItem,      -- 单元类
		start_x = 3,                  -- 第一个单元的X起点
		space_x = 15,                    -- x方向的间隔
		start_y = 0,                    -- 第一个单元的Y起点
		space_y = 4,                   -- y方向的间隔
		item_width = BackPackItem.Width*scale,               -- 单元的尺寸width
		item_height = BackPackItem.Height*scale,              -- 单元的尺寸height
		row = 1,                        -- 行数，作用于水平滚动类型
		col = 0,                         -- 列数，作用于垂直滚动类型
		scale = scale
	}
	self.extra_scrollview = CommonScrollViewLayout.new(self.panel_reward_2, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
	self.extra_scrollview:setBounceEnabled(false)
	self.extra_scrollview:setSwallowTouches(false)

end

function BraveRoadBossDes:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), nil, 1)
	registerButtonEventListener(self.background, handler(self, self._onClickCloseBtn), nil, 1)
	registerButtonEventListener(self.btn_switch, handler(self, self._onClickSwitch), true, 1)
	registerButtonEventListener(self.panel_skill, handler(self, function()
		self.panel_skill:setVisible(false)
	end))
	registerButtonEventListener(self.btn_video, handler(self, self._onClickVideo), true, 2)
	registerButtonEventListener(self.btn_skill_view, handler(self, self._onClickSkillView), true, 2)

	registerButtonEventListener(self.challenge_btn, handler(self, self._onClickEmbattleBtn), true, 2)

	registerButtonEventListener(self.btn_select, handler(self, self._onClickAddBtn), true, 2)
	registerButtonEventListener(self.btn_add, handler(self, self._onClickAddBtn), true, 2)

	self:addGlobalEvent(BraveRoadEvent.Select_Tips_Brave_Road_Update, function ()
        -- self:updateEntry()
		self:updateBossPower()
    end)
end

function BraveRoadBossDes:_onClickSelectBtn(  )

end

function BraveRoadBossDes:_onClickSwitch(  )
	if _model:checkOpenFirstMonth() then 
		message(TI18N("语言_c_5456")) 
		return
	end
	local boss_is_violent = _model:getBossIsViolent(self.cid)
	if boss_is_violent then
		_model:setBossIsViolent(self.cid,false)
		self.label_name:setString(self.bossData.name)
	else
		_model:setBossIsViolent(self.cid,true)
		self.label_name:setString(self.bossData.boss_name_m)
	end
	self:setBossSpine()
end

function BraveRoadBossDes:_onClickAddBtn(  )
	--首月不能选星
	if _model:checkOpenFirstMonth() then
		return message(TI18N("语言_c_5405"))
	end
	_controller:openBraveRoadBossSelectEntryPanel(true, {cid = self.config.cid})
end

function BraveRoadBossDes:_onClickVideo(  )
	_controller:openBraveRoadVideo(true, {cid = self.cid})
end

function BraveRoadBossDes:_onClickSkillView(  )
	self:showSkillView()
end

function BraveRoadBossDes:_onClickEmbattleBtn(  )
	if _model:getBossIsViolent(self.cid) and #_model:getCurCidTips(self.cid) == 0 then
		message(TI18N("语言_c_5459"))
		return
	end

	if _model:getLastCount() <= 0 and (not _model:checkBossPass(self.cid)) then
		message(TI18N("语言_c_1678"))
		return
	end
	local boss_is_violent = _model:getBossIsViolent(self.cid)
	HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.Brave_Road, {dun_type = self.config.formation or 0, cid = self.cid, boss_is_violent = boss_is_violent,diff = _model:getMonthDiff()})
end

function BraveRoadBossDes:_onClickCloseBtn(  )
	_controller:openBraveRoadBossDes(false)
end

function BraveRoadBossDes:openRootWnd(data)
	self.cid = data.cid
	self:generateBossData()
	self:setData()
end

function BraveRoadBossDes:generateBossData()
	self.bossData = {}
	local config = Config.LimitTrainingData.data_dungeon_boss[self.cid]
	self.config = config
	local unit_cfg = {}
	local power, unit_id = _model:getCurBossPower(self.cid)

	unit_cfg = Config.UnitData.data_unit(unit_id)
	local boss_info = Config.UnitData.data_unit(unit_cfg.monster3) 
	local chapter_info = _model:getDunDataById(self.cid)
	self.bossData.boss_star = chapter_info.boss_star
	self.bossData.bid = tonumber(boss_info.head_icon)
	self.bossData.lev = boss_info.lev
	self.bossData.star = 1
	self.bossData.body_id = boss_info.body_id
	self.bossData.name = boss_info.name
	self.bossData.boss_name_m = config.boss_name_m
	self.bossData.camp_type = boss_info.camp_type
	self.bossData.power = power
	self.bossData.type = boss_info.type

	local monsters = {unit_cfg.monster1, unit_cfg.monster2, unit_cfg.monster3, unit_cfg.monster4, unit_cfg.monster5}
	self.bossData.hero_vo = {}
    for i,v in ipairs(monsters) do
        local monster_id = v
        local monster_cfg = Config.UnitData.data_unit(monster_id)
        if monster_cfg then
			self.bossData.hero_vo.body_id = monster_cfg.body_id
			break
        end
	end
end

function BraveRoadBossDes:updateBossPower()
	-- self.bossData.power = _model:getCurBossPower(self.cid)
	-- self.label_power_value:setString(self.bossData.power)
	self:generateBossData()
	self:setData()
end

function BraveRoadBossDes:generateRewardData()
	local f_award = self.config.f_award
	local item_data = {}
	for k, v in pairs(f_award) do
        local vo = deepCopy(Config.ItemData.data_get_data(v[1]))
        vo.quantity = v[2]
        table.insert(item_data, vo)
	end
	return item_data
end

function BraveRoadBossDes:generateExtraRewardData()
	local extra_data = {}
	local t_award = self.config.t_award
	local star_count = _model:getCurCidTipsAllStar(self.cid)
	local dif_value = _model:getMonthDiffVal()
	for k, v in pairs(t_award) do
        local vo = deepCopy(Config.ItemData.data_get_data(v[1]))
		vo.quantity = math.floor(v[2]*dif_value*(star_count - self.bossData.boss_star))
		if vo.quantity > 0 then
			table.insert(extra_data, vo)
		end
	end
	return extra_data
end


function BraveRoadBossDes:setData()
	self.label_limit:setString(TI18N("语言_c_5063"))
	self.label_star:setString(self.bossData.boss_star)
	ccui.Helper:doLayout(self.label_limit)
	self.label_star:setPositionX(self.image_star:getPositionX() + self.image_star:getContentSize().width*self.image_star:getScale())
	self.label_lv:setString(string.format(TI18N("语言_c_4520"), self.bossData.lev))
	local boss_is_violent = _model:getBossIsViolent(self.cid)
	if boss_is_violent then
		self.label_name:setString(self.bossData.boss_name_m)
	else
		self.label_name:setString(self.bossData.name)
	end
	local type_res = PathTool.getHeroCampTypeIcon(self.bossData.camp_type)
	loadSpriteTexture(self.sp_camp, type_res, LOADTEXT_TYPE_PLIST)
	self.label_power_value:setString(MoneyTool.moneyFormat(self.bossData.power))

	local cfg = Config.LimitTrainingData.data_choose_diff[_model:getMonthDiff()+1]
	local lv = _model:getMonthDiff()
    if not _model:checkOpenFirstMonth() then
        local fake_lev = Config.LimitTrainingData.data_const["fake_lev"]
		if fake_lev then
			lv = lv + fake_lev.val
		else
			lv = lv + 10
		end
		self.tips_label:setString(TI18N("语言_c_5457"))
	else
		self.tips_label:setString(string.format(TI18N("语言_c_5458"),cfg.name))
    end
    self.tip_diff:setString(TI18N("语言_c_5074")..cfg.name)
    self.tip_diff:setColor(Config.ColorData.data_color4[cfg.color_a])
    if self.tip_diff:getContentSize().width + off_width > self.Image_diff.size.width then
        self.Image_diff:setContentSize(cc.size(self.tip_diff:getContentSize().width + off_width, self.Image_diff.size.height))
    end

	-- local body_id = self.bossData.hero_vo.body_id
	
	self:setBossSpine()

	local item_data = self:generateRewardData()
	self.reward_scrollview:setData(item_data)
	self.reward_scrollview:addEndCallBack(function()
        local item_list = self.reward_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
			v:setSwallowTouches(false)
			v:setGotIcon(_model:checkBossPass(self.cid))
        end
	end)

	self.label_entry_count:setString(string.format(TI18N("语言_c_5061"), self.config.tips_num)) 

	self:updateEntry()
end
function BraveRoadBossDes:setBossSpine()
	local cfg = Config.LimitTrainingData.data_dungeon_boss[self.cid]
	local body_id = cfg.boss_act
	local boss_is_violent = _model:getBossIsViolent(self.cid)
	local body_act = cfg.boss_n
	if boss_is_violent then
		body_act = cfg.boss_m
		self.tips_label:setVisible(false)
		self.Panel_2:setVisible(true)
		self.extra_scrollview:setVisible(true)
		self.label_air_des:setVisible(false)
		local data_diff = Config.LimitTrainingData.data_diff[_model:getMonthDiff()]
		if data_diff then
			local boss_id = data_diff["boss"..self.cid]
			local violent_boss_id = Config.UnitData2.data_unit1(boss_id).monster3
			local violent_boss_cfg = Config.UnitData2.data_unit2(violent_boss_id)
			self.label_lv:setString(string.format(TI18N("语言_c_4520"), violent_boss_cfg.lev))
			if #_model:getCurCidTips(self.cid) ~= 0 then
				self.label_power_value:setString(MoneyTool.moneyFormat(self.bossData.power))
			else
				self.label_power_value:setString(MoneyTool.moneyFormat(data_diff["power"..self.cid]))
			end
		end
	else
		self.tips_label:setVisible(true)
		self.Panel_2:setVisible(false)
		self.extra_scrollview:setVisible(false)
		self.label_air_des:setVisible(true)
		self.label_lv:setString(string.format(TI18N("语言_c_4520"), self.bossData.lev))
		-- self.label_power_value:setString(self.bossData.power)
		if _model:checkOpenFirstMonth() then
			self.label_power_value:setString(MoneyTool.moneyFormat(cfg.power2))
		else
			self.label_power_value:setString(MoneyTool.moneyFormat(cfg.power))
		end
	end

	if self.spine_model then
		self.spine_model:removeFromParent()
		self.spine_model = nil
	end
	if not self.spine_model then
		self.spine_model = createEffectSpine(body_id,cc.p(0,0),cc.p(0.5,0),true, body_act)
		local cfg = Config.LimitTrainingData.data_dungeon_boss[self.cid]
		self.spine_model:setScale(cfg.fight_draw_scale / 100)
		self.spine_model:setPositionY(cfg.fight_y_offset[1][2])
		self.node_effect:addChild(self.spine_model)
		self.spine_model:setAnimation(0, body_act, true)
	end
end
function BraveRoadBossDes:updateExtraReward()
	local extra_data = self:generateExtraRewardData()
	self.extra_scrollview:setData(extra_data)
	self.extra_scrollview:addEndCallBack(function()
        local item_list = self.extra_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
            v:setSwallowTouches(false)
        end
    end)
	-- self.label_air_des:setVisible(#extra_data == 0)
end

function BraveRoadBossDes:createEntryItem(index)
	local item = self.entry_icon_temp
	if index > 1 then
		item = self.entry_icon_temp:clone()
		self.Panel_2:addChild(item)
		item.name = item:getChildByName("name")
		item.star_1 = item:getChildByName("star_1")
		item.star_2 = item:getChildByName("star_2")
		item.star_3 = item:getChildByName("star_3")
		item.starList = {item.star_1, item.star_2, item.star_3}
		item.pos = cc.p(item:getPosition())
	end
	item:setVisible(true)
	return item
end

function BraveRoadBossDes:updateEntry()
	self.entry_data = _model:getCurCidTips(self.cid)
	local config = Config.LimitTrainingData.data_dungeon_boss[self.cid or 1]
	-- self.btn_add:setVisible(#self.entry_data < config.tips_num and _model:getBossIsViolent(self.cid))
	self.btn_add:setVisible(#self.entry_data < config.tips_num)
	self.tips_item = self.tips_item or {}
	for i, v in ipairs(self.tips_item) do
		v:setVisible(false)
	end
	local pos = self.entry_icon_temp.pos
	for i, v in ipairs(self.entry_data) do
		local item = self.tips_item[i]
		if not item then
			item = self:createEntryItem(i)
			self.tips_item[#self.tips_item + 1] = item 
		else
			item:setVisible(true)
		end
		item:setPosition(cc.p(pos.x + (i - 1)*110, pos.y))
		local tips_config = _model:getTipsConfigByBid(v.tips_id)
		local tab_index = _model:getTipsTabTypeByBid(self.cid, v.tips_id)
		item:loadTexture(PathTool.getResFrame("limit_training",PathTool.getBraveRoadEntryIcon(tab_index)), LOADTEXT_TYPE_PLIST)
		-- item.name:setString(tips_config.tip)
		item.name:setString(transformTextToShort(tips_config.tip, 6))
		item.name:setTouchEnabled(true)
		addEvt2showAllTextTips(item.name,tips_config.tip,6)
		local num = tips_config.star
		item.star_3:setVisible(num >= 3)
		item.star_2:setVisible(num >= 2)
		item.star_1:setVisible(num >= 1)
		self:adpatStar(item)
		item:setTouchEnabled(true)
		registerButtonEventListener(item, function()
			_controller:openBraveRoadBossEntryView(true, {entry_data = {{cid = self.cid, tips_id = v.tips_id}}})
		end, false, 2)
	end
	self.btn_add:setPositionX(pos.x + #self.entry_data* 110)

	self:updateExtraReward()
end

function BraveRoadBossDes:adpatStar(partner)
	local list = {partner.star_1, partner.star_2, partner.star_3}
	local num = 0
	for i, v in ipairs(list) do
		if v:isVisible() then
			num = num + 1
		end
	end
	local init_x = partner:getContentSize().width/2
	local single_w = partner.star_1:getContentSize().width
	local single_s = -15
	local total_s_w = num * single_w + (num - 1) * single_s
	local off_init_x = single_w*partner.star_1:getAnchorPoint().x
	for i, v in ipairs(list) do
		v:setPositionX(init_x - total_s_w/2 + off_init_x + (i - 1)*(single_w + single_s))
	end
end

function BraveRoadBossDes:showSkillView()
	--技能
	if not self.skill_scrollview then
		local scroll_view_size = self.skill_view:getContentSize()
		scroll_view_size.height = scroll_view_size.height - 20
		local setting = {
			item_class = BraveRoadBossSkillItem,      -- 单元类
			start_x = 3,                  -- 第一个单元的X起点
			space_x = 15,                    -- x方向的间隔
			start_y = 11,                    -- 第一个单元的Y起点
			space_y = 4,                   -- y方向的间隔
			item_width = 636,               -- 单元的尺寸width
			item_height = 130,              -- 单元的尺寸height
			row = 1,                        -- 行数，作用于水平滚动类型
			col = 1,                         -- 列数，作用于垂直滚动类型
		}
		self.skill_scrollview = CommonScrollViewLayout.new(self.skill_view, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
		self.skill_scrollview:setPositionY(10)
		self.skill_scrollview:setBounceEnabled(false)
		self.skill_scrollview:setSwallowTouches(false)
	end
	local list = {}
	for i, v in ipairs(self.config.skill_list) do
		list[#list + 1] = {skill_id = v} 
	end
	self.skill_scrollview:setData(list)
	self.panel_skill:setVisible(true)
end


function BraveRoadBossDes:close_callback(  )
	_controller:openBraveRoadBossDes(false)
end