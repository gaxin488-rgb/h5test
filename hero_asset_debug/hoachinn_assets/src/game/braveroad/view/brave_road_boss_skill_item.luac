local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadBossSkillItem = class("BraveRoadBossSkillItem", function()
    return ccui.Widget:create()
end)

function BraveRoadBossSkillItem:ctor()
	self:configUI()
	self:register_event()
end

function BraveRoadBossSkillItem:configUI( )
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0.5, 0.5))

	local csbPath = PathTool.getTargetCSB("braveroad/brave_road_boss_skill_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
	self:addChild(self.root_wnd)
	self.size = self.root_wnd:getContentSize()
	self:setContentSize(self.size)
	
    local container = self.root_wnd:getChildByName("container")
	self.container = container
	
	local node_skill = self.container:getChildByName("node_skill")
	self.skill_item = SkillItem.new(false,true,true,nil,nil,false)
	node_skill:addChild(self.skill_item)

	self.label_name = self.container:getChildByName("label_name")
	self.label_name:ignoreContentAdaptWithSize(true)
	self.label_name:setTextAreaSize(cc.size(490,0))
	setTextSpacing(self.label_name,-10)
	self.label_des = self.container:getChildByName("label_des")
	self.label_des:ignoreContentAdaptWithSize(true)
	self.label_des:setTextAreaSize(cc.size(490,0))
	setTextSpacing(self.label_des,-10)
end

function BraveRoadBossSkillItem:register_event(  )
	-- registerButtonEventListener(self.container, function (  )
	-- end, true, 1)
end

function BraveRoadBossSkillItem:setData(data)
	self.data = data
	self.skill_id = data
	local skill_config = Config.SkillData.data_get_skill(data.skill_id)
	if skill_config then
		self.skill_item:setData(skill_config)
	
		self.label_name:setString(skill_config.name)
		self.label_des:setString(transformTextToShort(skill_config.des, 36))
		self.label_des:setTouchEnabled(true)
		self.label_des:setSwallowTouches(false)
		addEvt2showAllTextTips(self.label_des,skill_config.des,36)
	end
end

function BraveRoadBossSkillItem:DeleteMe(  )
	self:removeAllChildren()
    self:removeFromParent()
end