local _controller = BraveRoadController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert

BraveRoadClearanceViewWindow = BraveRoadClearanceViewWindow or BaseClass(BaseView)

function BraveRoadClearanceViewWindow:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "braveroad/brave_road_clearance_view_window"

    self.role_vo = RoleController:getInstance():getRoleVo()
    self.show_list = {}
end

function BraveRoadClearanceViewWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then 
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
	self.container = container
    self:playEnterAnimatianByObj(container, 2)
    local image_2 = container:getChildByName("image_2")
	local win_title = container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_5077"))
    moveTextBg(win_title,image_2,60,image_2:getContentSize().width)
    self.close_btn = container:getChildByName("close_btn")
    
    self.layout_tab_1 = container:getChildByName("layout_tab_1")
    self.layout_tab_1.unselect_bg = self.layout_tab_1:getChildByName("unselect_bg")
    self.layout_tab_1.select_bg = self.layout_tab_1:getChildByName("select_bg")
    self.layout_tab_1.title = self.layout_tab_1:getChildByName("title")
    self.layout_tab_1.title:setString(TI18N("语言_c_5078"))
    self.layout_tab_2 = container:getChildByName("layout_tab_2")
    self.layout_tab_2.unselect_bg = self.layout_tab_2:getChildByName("unselect_bg")
    self.layout_tab_2.select_bg = self.layout_tab_2:getChildByName("select_bg")
    self.layout_tab_2.title = self.layout_tab_2:getChildByName("title")
    self.layout_tab_2.title:setString(TI18N("语言_c_5079"))

	self.list_panel = container:getChildByName("list_panel")
	self.res_label = container:getChildByName("res_label")

	local scroll_view_size = self.list_panel:getContentSize()
    local setting = { 
        item_class = BraveRoadClearanceViewItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 4,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 610,               -- 单元的尺寸width
        item_height = 100,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 1,                         -- 列数，作用于垂直滚动类型
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
	self.item_scrollview:setSwallowTouches(false)
end

function BraveRoadClearanceViewWindow:register_event(  )
	registerButtonEventListener(self.close_btn, function (  )
		_controller:openBraveRoadClearanceViewWindow(false)
	end, true, 2)

	registerButtonEventListener(self.background, function (  )
		_controller:openBraveRoadClearanceViewWindow(false)
    end, false, 2)

    registerButtonEventListener(self.layout_tab_1, function (  )
        self:selectTab(1)
    end, false, 2)

    registerButtonEventListener(self.layout_tab_2, function (  )
        self:selectTab(2)
    end, false, 2)
end

function BraveRoadClearanceViewWindow:selectTab(index)
    if self.select_type and self.select_type == index then return end
    self.select_type = index
    self.layout_tab_1.select_bg:setVisible(self.select_type == 1)
    self.layout_tab_2.select_bg:setVisible(self.select_type == 2)
    if self.select_type == 2 then
        self.layout_tab_1.title:setTextColor(cc.c4b(0x92, 0xb1, 0xdc, 0xff))
        self.layout_tab_2.title:setTextColor(cc.c4b(0xf8, 0xef, 0x76, 0xff))

        self.layout_tab_1.title:enableOutline(cc.c4b(0x34, 0x4c, 0x5f, 0xff), 2)
        self.layout_tab_2.title:enableOutline(cc.c4b(0x5c, 0x27, 0x05, 0xff), 2)
    else
        self.layout_tab_2.title:setTextColor(cc.c4b(0x92, 0xb1, 0xdc, 0xff))
        self.layout_tab_1.title:setTextColor(cc.c4b(0xf8, 0xef, 0x76, 0xff))
        self.layout_tab_2.title:enableOutline(cc.c4b(0x34, 0x4c, 0x5f, 0xff), 2)
        self.layout_tab_1.title:enableOutline(cc.c4b(0x5c, 0x27, 0x05, 0xff), 2)
    end
    self:updateList()
end

function BraveRoadClearanceViewWindow:openRootWnd(dun_type)
    self:selectTab(1)
end

function BraveRoadClearanceViewWindow:updateList()
    local list = {}
    for i, v in ipairs(Config.LimitTrainingData.data_dungeon_boss) do
        list[#list + 1] = {
            cfg = v,
            dun_type = self.select_type
        }
    end
	self.item_scrollview:setData(list)
end

function BraveRoadClearanceViewWindow:close_callback(  )
	_controller:openBraveRoadClearanceViewWindow(false)
end