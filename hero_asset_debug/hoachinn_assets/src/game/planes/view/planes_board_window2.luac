local _controller = PlanesafkController:getInstance()
local _model = _controller:getModel()
local _string_format = string.format

PlanesBoardWindow2 = PlanesBoardWindow2 or BaseClass(BaseView)

function PlanesBoardWindow2:__init()
	self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "planes/planes_board_window2"

    self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("planes", "planes_map"), type = ResourcesType.plist},
	}
end

function PlanesBoardWindow2:open_callback( )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.main_container = main_container

	self.win_title = main_container:getChildByName("win_title")
	self.title_bg = main_container:getChildByName("image_title")

	self.board_sp = main_container:getChildByName("board_sp")
	self.scroll_view=main_container:getChildByName("scroll_view")
	self.scroll_view:setScrollBarEnabled(false)
    self.scroll_size = self.scroll_view:getContentSize()
	self.goods=main_container:getChildByName("goods")
	self.reward_txt=main_container:getChildByName("reward_txt")
	-- self.title_txt = main_container:getChildByName("title_txt") -- 标题 

	local scroll_view_size = self.goods:getContentSize()
    local setting = {
        item_class = BackPackItem,
        start_x = 0,
        space_x = 10,
        start_y = 15,
        space_y = 0,
        item_width = BackPackItem.Width,--*0.90,
        item_height = BackPackItem.Height,--*0.90,
        row = 1,
        col = 0,
        scale = 1
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.goods,cc.p(0,0),ScrollViewDir.horizontal,ScrollViewStartPos.top,scroll_view_size,setting)
    self.item_scrollview:setSwallowTouches(false)

	self.main_con_size = main_container:getContentSize()
end

function PlanesBoardWindow2:register_event( )
	registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn), false, 2)
	-- registerButtonEventListener(self.btn_comfirm, handler(self, self.onClickComfirmBtn), true)
end

function PlanesBoardWindow2:onClickCloseBtn(  )
	_controller:openPlanesBoardWindow2(false)
end

function PlanesBoardWindow2:openRootWnd( id, index , setting)
	self.board_id = id
	self.comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
	self.grid_index = index
	setting = setting or {}
	--广告显示类型: 1 位面的  2 年兽活动
	self.board_show_type = setting.show_type or 1
	self.board_cfg = setting.board_cfg
	self:setData(id)
end

function PlanesBoardWindow2:setData( id)
	if not id then return end
	local board_cfg 
	if self.board_show_type == 2 then
		board_cfg = self.board_cfg
	else
		board_cfg = Config.SecretDunData.data_board[id]
	end
	if not board_cfg then return end

	-- -- 按钮
	-- if board_cfg.btn_str ~= "" then
	-- 	self.btn_comfirm:setVisible(true)
	-- 	self.btn_comfirm_label:setString(board_cfg.btn_str)
	-- else
	-- 	self.btn_comfirm:setVisible(false)
	-- end

	-- 标题
	self.win_title:setString(board_cfg.title)
	autoSizeTitleBg(self.win_title, self.title_bg)

	local cfg=Config.HolidayNianData.data_board[self.comp_id]
	if cfg==nil then
		cfg=Config.HolidayNianCrossData.data_board[self.comp_id]
	end
	-- 图片
	if self.board_show_type == 2 then
		local res= cfg[self.board_id].res_id
		local board_res = _string_format("resource/planes/%s.png", res)
		self.board_img_load = loadSpriteTextureFromCDN(self.board_sp, board_res, ResourcesType.single, self.board_img_load)
	else
		local board_res = _string_format("resource/planes/board_img/%s.png", board_cfg.res_id)
		self.board_img_load = loadSpriteTextureFromCDN(self.board_sp, board_res, ResourcesType.single, self.board_img_load)
	end

	-- 标题
	-- self.title_txt:setString(board_cfg.title)
	-- 描述内容一
	if not self.desc_txt_1 then
		self.desc_txt_1 = createRichLabel(24, cc.c4b(149, 83, 34, 255), cc.p(0.5, 1), cc.p(self.main_con_size.width*0.5,550), 0, 0, self.main_con_size.width - 100)
		self.main_container:addChild(self.desc_txt_1)
	end
	self.desc_txt_1:setString(board_cfg.desc_1)
	-- 描述内容二
	if not self.desc_txt_2 then
		self.desc_txt_2 = createRichLabel(24, cc.c4b(149, 83, 34, 255), cc.p(0,1), cc.p(15,100), 0, 0, self.scroll_size.width-30)
		self.scroll_view:addChild(self.desc_txt_2)
	end
	self.desc_txt_2:setString(board_cfg.desc_2)--
	local label_siez = self.desc_txt_2:getContentSize()
	local max_height = math.max(label_siez.height, self.scroll_size.height)
	self.scroll_view:setInnerContainerSize(cc.size(self.scroll_size.width-15, max_height))
	self.desc_txt_2:setPositionY(max_height-10)
	local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
	local cfg1=Config.HolidayNianData.data_const[self.comp_id]
	if cfg1==nil then
		cfg1=Config.HolidayNianCrossData.data_const[self.comp_id]
	end
	local config = cfg1.holiday_nian_reward_show
	if config then
		self.reward_txt:setString(config.desc)
		local item_data=config.val
		if item_data then
			local list = {}
			for k, v in ipairs(item_data) do
				local vo = {}
				vo.bid = v[1]
				vo.quantity = v[2]
				table.insert(list, vo)
			end
			self.item_scrollview:setData(list)
			self.item_scrollview:addEndCallBack(function()
				local list = self.item_scrollview:getItemList()
				for k,v in pairs(list) do
					v:setDefaultTip()
				end
			end)
		end
	end
    
end

function PlanesBoardWindow2:close_callback( )
	if self.board_img_load then
		self.board_img_load:DeleteMe()
		self.board_img_load = nil
	end
	_controller:openPlanesBoardWindow2(false)
end