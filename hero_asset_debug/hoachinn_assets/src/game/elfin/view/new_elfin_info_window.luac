end

function NewElfinInfoWindow:register_event(  )
	registerButtonEventListener(self.effect_preview, function ()
		ElfinController:getInstance():openElfinOverViewWindow(true,self.elfin_id)
	end, true, 2)
	registerButtonEventListener(self.level_view, function ()
		_controller:openElfinView2Window(true,self.elfin_id)
	end, true, 2)

	registerButtonEventListener(self.right_btn, function (  )
		if self.active_enough then
			BackpackController:getInstance():sender26570(self.first_id)
		else
			local config = Config.ItemData.data_get_data(self.active_item)
			message(string.format(TI18N("语言_c_1249"),config.name))
			BackpackController:getInstance():openTipsSource(true, config)
		end
	end, true, 1)

	registerButtonEventListener(self.right_btn_1, function (  )
		--打开升星界面
		if self.elfin_pos ~= 0 then
			local order = _model:getTreeElfinDanByPos(self.elfin_pos)
			_controller:openElfinCompoundWindow(true, self.elfin_id, self.elfin_pos, order)
			_controller:openElfinMainInfoWindow(false)
		else
			local item_data = BackpackController:getInstance():getModel():getRedHomePetItemById(self.elfin_id)
			if item_data then
				local order = item_data.elfin_order
				_controller:openElfinCompoundWindow(true, self.elfin_id, self.elfin_pos, order)
				_controller:openElfinMainInfoWindow(false)
			else
				local attch_data = _model:getAttachSrc(self.elfin_id)
				if attch_data then
					local tips = ""
					local itemCfg = Config.ItemData.data_get_data(attch_data)
					if itemCfg then
						tips = string.format(TI18N("语言_c_7344"), itemCfg.name)
						local call_back = function()
							_controller:send26574(0, attch_data,0,0)
						end
						CommonAlert.show( tips, TI18N("语言_c_2"), call_back, TI18N("语言_c_62"), nil, CommonAlert.type.rich )
					end
				end
			end
		end
	end, true, 1)

	if not self.update_num_event then
        self.update_num_event = GlobalEvent:getInstance():Bind(ElfinEvent.ElfinBookComposeSuccess, function ( bid, status )
			-- self:setActiveStatus()
			-- self:upGradeOrCompose()
			-- if self.attach_panel then
			-- 	self.attach_panel:setData(self.elfin_id)
			-- end
			self:setData( self.id_list, self.is_show )
        end)
    end

	self:addGlobalEvent(ElfinEvent.ElfinStrengEvent, function() 
        self:setData( self.id_list, self.is_show )
   end)
end

function NewElfinInfoWindow:setActiveStatus()
	local list = self.elfin_id_list
	self.is_active = false
	for k, v in pairs(list) do
		local id = v
		local status = _model:checkElfinActStatus(id)
		if status then
			self.elfin_id = id
			self.is_active = true
			break
		end
	end
end

function NewElfinInfoWindow:openRootWnd( data, is_show )
	self.id_list = data
	self.is_show = is_show
	self:setData(data, is_show)
end

function NewElfinInfoWindow:setData( data, is_show)
	if not data then return end
	local id_list = data
	local list = {}
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("sprite_data")
	for i,bid in ipairs(id_list) do
		local item_cfg = Config.ItemData.data_get_data(bid)
		local item_cache = Config.SpriteData.data_elfin_data(bid)
		-- if item_cfg then
		-- 	if item_cache and item_cache.isshow == 0 and not table.indexof(nohideIds,bid) then
		-- 		-- 后台配置屏蔽的
		-- 	else
				_table_insert(list, bid)
			-- end
		-- end
	end
	local function sortFunc( objA, objB )
			return objA < objB
	end
	table.sort(list, sortFunc)
	self.elfin_id_list = list
	
	self.elfin_id = list[#list]
	self.first_id = list[1]
	self.is_active = false
	for k, v in pairs(list) do
		local id = v
		local status = _model:checkElfinActStatus(id)
		if status then
			self.elfin_id = id
			self.is_active = true
			break
		end
	end
	self.elfin_pos = _controller:getModel():getElfinTreeByBid(self.elfin_id) or 0
	local cfg = Config.ItemData.data_get_data(self.elfin_id)
	self.item_cfg = cfg

	self.gold_eff_info:setVisible(true)
	self.name_txt:setVisible(false)

	local elfin_cfg = Config.SpriteData.data_elfin_data(self.item_cfg.id)
	if not elfin_cfg then return end
	--当前积分
	local score_cfg = Config.SpriteData.data_sprite_score
	local score_data = score_cfg[self.elfin_id]
	if score_data then
		local score_num = score_data.score

		self.level_txt:setNum(score_num) 
	end

	-- 名称
	local str = self.item_cfg.name or ""
	if is_show then
		str = str .. TI18N("语言_hol_sp_lo_02_3")
	end
	self.name_txt:setString(str)
	self.gold_name:setString(str)
	self.name_tips:setPositionY(855)
	autoSizeTitleBg(self.gold_name, self.gold_name_bg, 60, 185)

	if cfg.quality == 6 then
		local res_id = PathTool.getPlistImgForDownLoad("elfin", "elfin_info_bg_1")
		self.load1 = createResourcesLoad(res_id, ResourcesType.single, function()
			if self.image_bg and not tolua.isnull(self.image_bg) then
				self.image_bg:loadTexture(res_id, LOADTEXT_TYPE)	-- loadSpriteTexture(self.image_bg, res_id, LOADTEXT_TYPE)
				self.image_bg:setScale9Enabled(true)
				self.image_bg:setCapInsets(cc.rect(16, 700, 687, 102))
			end
		end, self.load1)
	end

	self:upGradeOrCompose()

	-- 阶数
	if cfg then
		local start_y = 785
		-- if cfg.quality > 5 then
			start_y = 815
		-- end
		self:showElfinStep(cfg.eqm_jie,start_y)
		self:showBottomEffect(true, cfg.quality)
		local res = PathTool.getResFrame("elfin", "elfin_1054")
		local res2 = PathTool.getResFrame("elfin", "txt_cn_elfin_type_1")
		local color = cc.c4b(0x84,0xde,0xfc,0xff)
		local color2 = cc.c4b(0x1c,0x2d,0x5f,0xff)
    	if cfg.quality >= BackPackConst.quality.orange then
			res = PathTool.getResFrame("elfin", "elfin_1056")
			res2 = PathTool.getResFrame("elfin", "txt_cn_elfin_type_3")
			color = cc.c4b(0xff,0xef,0xb2,0xff)
			color2 = cc.c4b(0x84,0x3e,0x23,0xff)
    	elseif cfg.quality == BackPackConst.quality.purple then
			res = PathTool.getResFrame("elfin", "elfin_1055")
			res2 = PathTool.getResFrame("elfin", "txt_cn_elfin_type_2")
			color = cc.c4b(0xe2,0xcd,0xff,0xff)
			color2 = cc.c4b(0x51,0x35,0x7f,0xff)
		end
		self.type_bg:loadTexture(res,LOADTEXT_TYPE_PLIST)
		loadSpriteTexture(self.type_img, res2, LOADTEXT_TYPE_PLIST)
		self.type_name:setTextColor(color)
		self.type_name:enableOutline(color2, 2)
		self.type_name:setString(cfg.use_desc)
		moveTextBg(self.type_name,self.type_bg,13,150)
	end

	
	local attachElfinId = _model:getAttachElfinById(self.elfin_id)
	if attachElfinId then
	if not self.attach_panel then
		self.attach_panel = ElfinAttachInfoPanel.new()
		self.attach_node:addChild(self.attach_panel)
	end
		self.attach_panel:setVisible(true)
	self.attach_panel:setData(self.elfin_id)
	else
		if self.attach_panel then
			self.attach_panel:setVisible(false)
		end
	end

	local is_show_atttch = elfin_cfg.embed_shield
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("sprite_possess_show")
    if is_show_atttch == 0 and not table.indexof(nohideIds,self.elfin_id) then
		self.attach_node:setVisible(false)
    else
        self.attach_node:setVisible(true)
    end

	-- 模型
	local effect_id = elfin_cfg.effect_id or "E70001"
	if not self.elfin_spine then
		local offset_y = tonumber(elfin_cfg.offset_y) or 0
		self.elfin_spine = createEffectSpine( effect_id, cc.p(self.con_size.width*0.5, 470+offset_y), cc.p(0.5, 0), true, PlayerAction.stand )
		self.elfin_node:addChild(self.elfin_spine)
	end
	if elfin_cfg.scale_val and elfin_cfg.scale_val > 0 then
		self.elfin_spine:setScale(elfin_cfg.scale_val)
	end

	-- 技能图标
	if not self.skill_item then
		self.skill_item = SkillItem.new(true, true, true, 0.8, true)
		self.skill_item:setPosition(cc.p(52, 204))
		self.container:addChild(self.skill_item)
	end
	if elfin_cfg.skill then
		local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
		if skill_cfg then
			self.skill_item:setData(skill_cfg)
			local left_width = 475
			setTextMaxWidth(self.skill_name_txt,left_width) 
			self.skill_name_txt:setString(string.format(TI18N("语言_c_4726"),skill_cfg.name,skill_cfg.level))
			if skill_cfg.type == "active_skill" then 
		        self.skill_type_txt:setString(TI18N("语言_c_2003"))
		    else 
		        self.skill_type_txt:setString(TI18N("语言_c_2004")) 
		    end
			self.skill_type_txt:setPositionY(195)--(self.skill_name_txt:getPositionY()-self.skill_name_txt:getContentSize().height)
			self.line:setPositionY(self.skill_type_txt:getPositionY()-self.skill_type_txt:getContentSize().height)
		    -- 描述
			if not self.desc_txt then
				self.desc_txt = createRichLabel(22, cc.c4b(0x7c,0x55,0x36,0xff), cc.p(0, 1), cc.p(0, 0), 5, nil, 590)
				self.skill_desc_scroll:addChild(self.desc_txt)
			end
			self.desc_txt:setString(skill_cfg.des)
		    local desc_size = self.desc_txt:getSize()
		    local max_height = math.max(desc_size.height, self.skill_desc_scroll:getContentSize().height)
		    self.desc_txt:setPositionY(max_height)
    		self.skill_desc_scroll:setInnerContainerSize(cc.size(self.skill_desc_scroll:getContentSize().width, max_height))
    		self.skill_desc_scroll:setTouchEnabled(desc_size.height > 100)
			self.skill_desc_scroll:setPositionY(self.line:getPositionY()-self.line:getContentSize().height-10)
		end
	end
	if elfin_cfg.support_skill_id then
		local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.support_skill_id)
		if skill_cfg then
			if not self.support_item then
				self.support_item = SkillItem.new(true, true, true, 0.8, true)
				self.support_item:setPosition(cc.p(90, 50))
				self.container:addChild(self.support_item)
			end
			self.support_item:setVisible(true)
			self.support_item:setData(skill_cfg)
		else
			if self.support_item then
				self.support_item:setVisible(false)
			end
		end
	else
		if self.support_item then
			self.support_item:setVisible(false)
		end
	end

	self:setAttr()
end

--合成和升级信息
function NewElfinInfoWindow:upGradeOrCompose()
	if not self.is_active then
		self.name_tips:setVisible(true)
		local need_cfg = Config.SpriteData.data_merge_info[self.elfin_id_list[1]]
		local chip_id = need_cfg.need_id
		local need_num = need_cfg.need_num
		local own_num =  BackpackController:getInstance():getModel():getItemNumByBid(chip_id)
		if not self.chip_item then
			self.chip_item = BackPackItem.new(true,true)
			self.chip_item:setDefaultTip(true)
			self.chip_item:setScale(0.7)
			self.chip_item:setPosition(cc.p(45, 56))
			self.compose_panel:addChild(self.chip_item)
		end
		self.chip_item:setBaseData(chip_id)
		local str = "<div fontcolor=#7C5536>%s/%s</div>"
		self.active_item = chip_id
		if own_num >= need_num then
			self.active_enough = true
			str = "<div fontcolor=#26952F>%s/%s</div>"
			addRedPointToNodeByStatus(self.right_btn, true,10,10)
		else
			self.enough_use = false
			str = "<div fontcolor=#FF1515>%s/%s</div>"
			addRedPointToNodeByStatus(self.right_btn, false)
		end
		self.num_txt:setString(string.format(str, own_num,need_num))

		local cfg = Config.SpriteData.data_sprite_score[self.first_id]
		local add_score = cfg.score
		self.add_score:setString("")--(TI18N("语言_spr_01_16")..add_score)--(string.format("图鉴积分：+%s", add_score))
		self.compose_panel:setVisible(true)
		self.up_star_panel:setVisible(false)
	else
		self.name_tips:setVisible(false)
		local next_elfin_id
		local temp_i = 1
		--print("self.elfin_id_list",vardump(self.elfin_id_list))
		for i = 1, #self.elfin_id_list do
			if self.elfin_id_list[i] == self.elfin_id then
				temp_i = i
				break
			end
		end
		local next_i = temp_i + 1
		if self.elfin_id_list[next_i] then
			next_elfin_id = self.elfin_id_list[next_i]
			local need_cfg = Config.SpriteData.data_elfin_com[self.elfin_id].expend
			local chip_id = need_cfg[1][1]
			local need_num = need_cfg[1][2]
			local own_num =  BackpackController:getInstance():getModel():getItemNumByBid(chip_id)
			if not self.chip_item1 then
				self.chip_item1 = BackPackItem.new(true,true)
				self.chip_item1:setDefaultTip(true)
				self.chip_item1:setScale(0.7)
				self.chip_item1:setPosition(cc.p(45, 56))
				self.up_star_panel:addChild(self.chip_item1)
			end
			self.chip_item1:setBaseData(chip_id)
			local str = "<div fontcolor=#7C5536>%s/%s</div>"
			if own_num >= need_num then
				str = "<div fontcolor=#26952F>%s/%s</div>"
				addRedPointToNodeByStatus(self.right_btn_1, true,10,10)
			else
				str = "<div fontcolor=#FF1515>%s/%s</div>"
				addRedPointToNodeByStatus(self.right_btn_1, false)
			end
			self.num_txt_1:setString(string.format(str, own_num,need_num))
			self.right_btn_1:setVisible(true)
		else
			--已满星
			if self.chip_item1 then
				self.chip_item1:setVisible(false)
			end
			self.num_txt_1:setVisible(false)
			self.right_btn_1:setVisible(false)
			self.num_label:setVisible(true)
			addRedPointToNodeByStatus(self.right_btn_1, false)
		end
		self.compose_panel:setVisible(false)
		self.up_star_panel:setVisible(true)
	end
end
--设置宠物属性
function NewElfinInfoWindow:setAttr()
	local score_num = 0
	local show_id 
	if self.is_active then
		show_id = self.elfin_id
	else
		show_id = self.elfin_id_list[#self.elfin_id_list]
	end
	local attr_cfg = Config.SpriteData.data_attr_info[show_id]
	
	local elfin_cfg = Config.SpriteData.data_elfin_data(self.item_cfg.id)
	score_num = elfin_cfg.power
	local attrs = deepCopy(attr_cfg.attrs)
	local item_cfg = Config.ItemData.data_get_data(show_id)
	local lev = _model:getElfinStrongLev(show_id)
	
	if item_cfg and Config.SpriteData.data_sprite_enhance[item_cfg.quality] then
		if not self.is_active then
			lev = #Config.SpriteData.data_sprite_enhance[item_cfg.quality]
		end
		if Config.SpriteData.data_sprite_enhance[item_cfg.quality][lev] then
			local lev_attr_cfg = Config.SpriteData.data_sprite_enhance[item_cfg.quality][lev]
			score_num = score_num + lev_attr_cfg.power
			for k,v in ipairs(lev_attr_cfg.attr) do
				table.insert(attrs,v)
			end
			attrs = getAttrRemovalOfDuplicatesList(attrs)
		end
	end

	for index,v in ipairs(attrs) do
        local attr_key = v[1]
        local attr_val = v[2]
        local attr_name = Config.AttrData.data_key_to_name[attr_key]
        if attr_name then
            if not self.base_list[index] then 
                self.base_list[index] = createRichLabel(22, cc.c4b(0xc1,0xb7,0xab,0xff), cc.p(0, 0.5), cc.p(4, 28), nil, nil, 380)
                self.attr_panel:addChild(self.base_list[index])
            end
            local label = self.base_list[index]
            local _x = (617/#attrs)*(index-1) + 10
            label:setPosition(cc.p(_x,20))
            if attr_name then
                local icon = PathTool.getAttrIconByStr(attr_key)
                local is_per = PartnerCalculate.isShowPerByStr(attr_key)
                if is_per == true then
                    attr_val = (attr_val*0.1).."%"
                end--<div fontcolor=#7c5536> %s：</div> attr_name
                local attr_str = string_format("<img src='%s' scale=1 /> <div fontcolor=#7c5536>%s</div>", PathTool.getResFrame("common", icon), attr_val)
                label:setString(attr_str)
            end
        end
    end
	self.power_label:setNum(score_num)
end

--宠物星级
function NewElfinInfoWindow:showElfinStep(num,posy)
	posy = posy or 815
	if not self.name_tips:isVisible() then
		posy = 850
	end
	local width_s = 25
    local _cStar = function(star_count, res, star_list,moveW)
        local width = width_s
		local x = self.con_size.width * 0.5 - star_count * width * 0.5 + width * 0.5
        if moveW then 
            x = x + moveW
        end
		for k, v in pairs(star_list or {}) do
			v:setVisible(false)
		end
        for i=1,star_count do
            if not star_list[i] then 
                local star = createImage(self.container,res,0,0,cc.p(0.5,0),true,1,false)
                star:setScale(1)
                star_list[i] = star
            end
            star_list[i]:setVisible(true)
            star_list[i]:setPosition(cc.p(x + (i-1) * width,posy))
        end
    end
    if num > 0 and num <= 5 then
        local res = PathTool.getResFrame("common","common_90032")
        _cStar(num, res, self.elfin_step_list.star_list,0)
	elseif num >= 6 then
		local res = PathTool.getResFrame("common_1","common_1_572")
		if self.elfin_step_list.moon == nil then 
            local star = createImage(self.container,res,295, posy,cc.p(0.5,0.5),true,0,false)
            self.elfin_step_list.moon = star
        else
            self.elfin_step_list.moon:setVisible(true)
        end
		if self.elfin_step_list.label == nil then 
            local label = createLabel(18, 1, cc.c3b(0x00, 0x00, 0x00), 292, posy-4, "", self.container, 2, cc.p(0.5, 0.5))
			label:setString(num)
            self.elfin_step_list.label = label
        else
            self.elfin_step_list.label:setVisible(true)
			self.elfin_step_list.label:setString(num)
        end
    -- elseif num >= 6 and num <= 9 then
    --     local res = PathTool.getResFrame("common","common_90032")
    --     local moonres = PathTool.getResFrame("pet","pet_star_1")
    --     if self.elfin_step_list.moon == nil then 
    --         local star = createImage(self.container,moonres,0, 782,cc.p(0.5,0),true,0,false)
    --         self.elfin_step_list.moon = star
    --         self.elfin_step_list.moon:setScale(1.2)
    --     else
    --         self.elfin_step_list.moon:setVisible(true)
    --     end
    --     local count = num - 5
    --     -- _cStar(count, res, self.elfin_step_list.star_list,width_s*0.5+60)
	-- 	_cStar(count, res, self.elfin_step_list.star_list,width_s*0.5)

    --     local startmoon = - count * width_s * 0.5 + self.con_size.width * 0.5
    --     self.elfin_step_list.moon:setPositionX(startmoon)
    -- elseif num >= 10 then
    --     local new_num  = num - 10
    --     local res = PathTool.getResFrame("pet","pet_star_2")
    --     if self.elfin_step_list.star10 == nil then
    --         local star = createImage(self.container,res,0, 782,cc.p(0.5,0),true,0,false)
    --         star:setScale(1.2)
    --         star:setCascadeOpacityEnabled(true)
    --         self.elfin_step_list.star10 = star
    --     else
    --         self.elfin_step_list.star10:setVisible(true)
    --     end

    --     local res = PathTool.getResFrame("common","common_90032")
    --     _cStar(new_num, res, self.container,width_s*0.5+4+60)
    --     local startsun = self.con_size.width * 0.5
    --     self.elfin_step_list.star10:setPositionX(startsun)
    end
end

-- 底盘特效
function NewElfinInfoWindow:showBottomEffect( status, quality )
	if status == false then
        if self.bottom_effect then
            self.bottom_effect:clearTracks()
            self.bottom_effect:removeFromParent()
            self.bottom_effect = nil
        end
    else
		local eff_id = "E27004"
		local action = PlayerAction.action_3
		if quality == 6 then
			eff_id = "E27008"
			action = PlayerAction.action_3
		elseif quality == 5 then
			eff_id = "E27007"
			action = PlayerAction.action_3
		elseif quality == 4 then
			action = PlayerAction.action_3
		elseif quality == 3 then
			action = PlayerAction.action_2
		elseif quality == 2 then
			action = PlayerAction.action_1
		end
        if not tolua.isnull(self.stage_node) and self.bottom_effect == nil then
            self.bottom_effect = createEffectSpine(eff_id, cc.p(0, -40), cc.p(0.5, 0), true, action)
            self.stage_node:addChild(self.bottom_effect)
        end
    end
end

function NewElfinInfoWindow:close_callback(  )
	self:showBottomEffect(false)
	if self.update_num_event then
		GlobalEvent:getInstance():UnBind(self.update_num_event)
		self.update_num_event = nil
	end
	if self.power_label then
        self.power_label:DeleteMe()
        self.power_label = nil
	end
	if self.chip_item1 then
		self.chip_item1:DeleteMe()
		self.chip_item1 = nil
	end
	if self.chip_item then
		self.chip_item:DeleteMe()
		self.chip_item = nil
	end
	if self.skill_item then
		self.skill_item:DeleteMe()
		self.skill_item = nil
	end
	if self.support_item then
		self.support_item:DeleteMe()
		self.support_item = nil
	end
	if self.elfin_spine then
		self.elfin_spine:clearTracks()
		self.elfin_spine:removeFromParent()
		self.elfin_spine = nil
	end
	_controller:openRedElfinInfoWindow(false)
end