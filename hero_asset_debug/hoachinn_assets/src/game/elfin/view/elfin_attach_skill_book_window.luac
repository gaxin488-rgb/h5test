
ElfinAttachSkillBookWindow = ElfinAttachSkillBookWindow or BaseClass(BaseView)
-- desc: 
local _controller = ElfinController:getInstance()
local _model = _controller:getModel()

function ElfinAttachSkillBookWindow:__init()
	self.win_type = WinType.Tips
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "elfin/elfin_book_window"
	self.res_list = {
		{ path = PathTool.getPlistImgForDownLoad("elfin","elfin_soul_bg"), type = ResourcesType.single },
	}
end
-- desc: 
function ElfinAttachSkillBookWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(container, 2)
	
	container:getChildByName("win_title"):setString(TI18N("语言_c_1990"))
	self.have_txt = container:getChildByName("have_txt")
	self.have_txt:setString("")
	self.btn_close = container:getChildByName("btn_close")
	self.image_bg_2 = container:getChildByName("image_bg_2")
	self.image_bg_2:setContentSize(cc.size(607,752))
    local item_list = container:getChildByName("item_list")
	item_list:setContentSize(cc.size(607,750))

    local scroll_view_size = item_list:getContentSize()
    local setting = {
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 0,                    -- x方向的间隔
        start_y = 10,                    -- 第一个单元的Y起点
        space_y = 53,                   -- y方向的间隔
        item_width = 607/4,               -- 单元的尺寸width
        item_height = BackPackItem.Height,              -- 单元的尺寸height
        row = 0,                        -- 行数，作用于水平滚动类型
        col = 4,                         -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.item_scrollview = CommonScrollViewSingleLayout.new(item_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)

    self.item_scrollview:registerScriptHandlerSingle(handler(self,self._createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
    self.item_scrollview:registerScriptHandlerSingle(handler(self,self._numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
    self.item_scrollview:registerScriptHandlerSingle(handler(self,self._updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell

end

function ElfinAttachSkillBookWindow:register_event(  )
	registerButtonEventListener(self.background, function (  )
		_controller:openElfinAttachBookWindow(false)
	end, false, 2)
	registerButtonEventListener(self.btn_close, function (  )
		_controller:openElfinAttachBookWindow(false)
	end, true, 2)
end

function ElfinAttachSkillBookWindow:_createNewCell(  )
	local cell = BackPackItem.new(false, true, false)
    cell:addCallBack(function() self:onCellTouched(cell) end)
    return cell
end

function ElfinAttachSkillBookWindow:_numberOfCells(  )
	if not self.elfinList then return 0 end
	return #self.elfinList
end

function ElfinAttachSkillBookWindow:_updateCellByIndex( cell, index )
	cell.index = index
    local data = self.elfinList[index]
    if data then
		local item_cfg = Config.ItemData.data_get_data(data.id)
		cell:setData(item_cfg)
		cell:showItemQualityNameScroll(true)
    end
end

function ElfinAttachSkillBookWindow:onCellTouched( cell )
	local index = cell.index
	local data = self.elfinList[index]
	local skillCfg = Config.SkillData.data_get_skill(data.soul_skill)
	TipsManager:getInstance():showSkillTips(skillCfg)
	-- local item_cfg = cell:getData()
	-- if item_cfg then
	-- 	_controller:openElfinInfoWindow(true, item_cfg)
	-- end
end

function ElfinAttachSkillBookWindow:openRootWnd(  )
	local cfg = Config.SpriteData.data_sprite_list
	local temp_list = {}
	for i, v in ipairs(cfg) do
		local id_list = v.id_list[1]--={{111001,111101,111201,111301,111401}}
		local elfin_id = id_list[#id_list]
		local item_cfg = Config.ItemData.data_get_data(elfin_id)
		local a = {id=elfin_id, quality=item_cfg.quality}
		table.insert(temp_list, a)
	end
	local sort_func = SortTools.tableCommonSorter({{"quality", true}})
	table.sort(temp_list,sort_func)

	self.elfinList = {}
	for i, v in ipairs(temp_list) do
		local id = v.id
		local sprite_cfg = Config.SpriteData.data_elfin_data(id)
		if sprite_cfg.soul_skill and sprite_cfg.soul_skill ~= 0 then
			table.insert(self.elfinList, sprite_cfg)
		end
	end
	
	self.item_scrollview:reloadData()
end

function ElfinAttachSkillBookWindow:close_callback(  )
	if self.item_scrollview then
		self.item_scrollview:DeleteMe()
		self.item_scrollview = nil
	end
	_controller:openElfinAttachBookWindow(false)
end