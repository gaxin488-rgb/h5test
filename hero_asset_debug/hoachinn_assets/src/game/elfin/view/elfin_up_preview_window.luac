local _controller = ElfinController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local _table_sort = table.sort
local _string_format = string.format

ElfinUpPreviewWindow = ElfinUpPreviewWindow or BaseClass(BaseView)

function ElfinUpPreviewWindow:__init()
	self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.is_full_screen = false
	self.layout_name = "elfin/elfin_up_preview_window"

end

function ElfinUpPreviewWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(container, 2)
	
	self.image_bg = container:getChildByName("image_bg")
	self.bottom_bg = container:getChildByName("bottom_bg")
	self.title_bg = container:getChildByName("title_bg")
	self.elfin_node = container:getChildByName("elfin_node")
	self.title_txt2 = container:getChildByName("title_txt2")
	setTextMaxWidth(self.title_txt2, 600)
	self.title_txt2:setString(TI18N("语言_spr_01_25"))
	self.title_txt1 = container:getChildByName("title_txt1")
	setTextMaxWidth(self.title_txt1, 600)
	self.title_txt1:setString(TI18N("语言_spr_01_26"))
	local max_width = math.max(self.title_txt1:getContentSize().width,self.title_txt2:getContentSize().width)
	local _width = math.max(max_width, 384)
	self.title_bg:setContentSize(cc.size(_width, 92))
	
	local tips1 = container:getChildByName("tips1")
	local posx = tips1:getPositionX()
	local posy = tips1:getPositionY()
	-- setTextMaxWidth(self.tips1, 565)
	self.tips1 = createRichLabel(20, cc.c4b(0x47, 0x21, 0x03, 0xff), cc.p(0.5, 0.5), cc.p(posx, posy), nil, -4, 565)
	container:addChild(self.tips1)
	self.tips1:setHorizontalLayoutType(2)
	-- self.tips1:setString(TI18N("语言_spr_01_27"))

	self.tips2 = container:getChildByName("tips2")
	setTextMaxWidth(self.tips2, 580,-2)
	self.line = container:getChildByName("line")
	self.close_btn = container:getChildByName("close_btn")
	self.right_btn = container:getChildByName("right_btn")
	self.right_btn:getChildByName("label"):setString(TI18N("语言_c_766"))
	self.right_btn:setVisible(false)
end

function ElfinUpPreviewWindow:register_event(  )
	registerButtonEventListener(self.background, function (  )
		_controller:openElfinUpPoolPreviewWindow(false)
	end, false, 2)

	registerButtonEventListener(self.close_btn, function (  )
		_controller:openElfinUpPoolPreviewWindow(false)
	end, true, 1)

	registerButtonEventListener(self.right_btn, function (  )
		if self.is_can_upgrade_pool then
			_controller:sender26569()
			_controller:openElfinUpPoolPreviewWindow(false)
		end
	end, true, 1)
	
end

function ElfinUpPreviewWindow:openRootWnd()
	self:setData()
	self:showBottomEffect()
end

function ElfinUpPreviewWindow:setData()
	self.data = _model:getElfinSummonData()
	if self.data then
		local chose = self.data.chose
		if chose == 1 then --已升级
			self.right_btn:setVisible(false)
			self.tips2:setString(TI18N("语言_c_6951"))
			self.tips2:setPositionY(108)
		else
			self:checkAndupCardPool()
			if self.is_can_upgrade_pool then --可升级
				self.right_btn:setVisible(true)
				self.tips2:setString(TI18N("语言_spr_01_28"))
				self.tips2:setPositionY(36)
			else
				self.right_btn:setVisible(false)
				self.tips2:setString(TI18N("语言_c_6952"))
				self.tips2:setPositionY(82)
			end
		end
	end

end
function ElfinUpPreviewWindow:checkAndupCardPool()
	local target = Config.HolidaySpriteLotteryData.data_const.draw_count.val
	local now_summon_num = self.data.all_times
	self.tips1:setString(string.format(TI18N("语言_spr_01_27"), now_summon_num))
	if now_summon_num >= target then
		self.is_can_upgrade_pool = true
		return
	end

	local special_target = Config.HolidaySpriteLotteryData.data_const.draw_open.val
	local need_quality = special_target[1][1]
	local need_star = special_target[1][2]
	local need_number = special_target[1][3]
	local now_num = 0
	--先计算背包的数量
	local list = BackpackController:getInstance():getModel():getAllBackPackArray(BackPackConst.item_tab_type.ELFIN) or {}
	--print( need_quality,need_star,need_number,"先计算背包的数量+++++++++++++++",vardump(list))
	if list and next(list) then
		for k, v in pairs(list) do
			local cfg = v.config
			if cfg and cfg.quality >= need_quality and cfg.eqm_jie >= need_star then
				now_num = now_num + 1
			end
			local attachElfinId = _controller:getModel():getAttachElfinById(v.base_id)
			if attachElfinId then
				local attachCfg = Config.ItemData.data_get_data(attachElfinId)
				if attachCfg and attachCfg.quality >= need_quality and attachCfg.eqm_jie >= need_star then
					now_num = now_num + 1
				end
			end
		end
	end

	local tree_data = _model:getElfinTreeData()
	if not self.is_can_upgrade_pool then
		if tree_data and tree_data.sprites and next(tree_data.sprites) ~= nil then
			for k, v in pairs(tree_data.sprites) do
				local sprite_id = v.item_bid
				local item_cfg = Config.ItemData.data_get_data(sprite_id)
				if item_cfg and item_cfg.eqm_jie >= need_star and item_cfg.quality >= need_quality then
					now_num = now_num + 1
				end

				local attachElfinId = _controller:getModel():getAttachElfinById(sprite_id)
				if attachElfinId then
					local attachCfg = Config.ItemData.data_get_data(attachElfinId)
					if attachCfg and attachCfg.quality >= need_quality and attachCfg.eqm_jie >= need_star then
						now_num = now_num + 1
					end
				end

			end
		end
	end
	--附身相关

	if now_num >= need_number then
		self.is_can_upgrade_pool = true
	end
end

function ElfinUpPreviewWindow:showBottomEffect( status )
	if status == false then
        if self.bottom_effect then
            self.bottom_effect:clearTracks()
            self.bottom_effect:removeFromParent()
            self.bottom_effect = nil
        end
    else
    	local config = Config.ItemData.data_get_data(114001)
		local elfin_cfg = Config.SpriteData.data_elfin_data(config.id)
		local effect_id = elfin_cfg.effect_id or "E70001"
		if not self.elfin_spine then
			self.elfin_spine = createEffectSpine(effect_id, cc.p(0, 0), cc.p(0.5, 0.5), true, PlayerAction.stand)
			self.elfin_node:addChild(self.elfin_spine)
		end
    end
end

function ElfinUpPreviewWindow:close_callback(  )
	self:showBottomEffect(false)
	_controller:openElfinUpPoolPreviewWindow(false)
end