local _controller = ElfinController:getInstance()
local _model = _controller:getModel()

ElfinAttachInfoPanel = class("ElfinAttachInfoPanel", function() return ccui.Widget:create() end)

function ElfinAttachInfoPanel:ctor(...)

	local csbPath = PathTool.getTargetCSB("elfin/elfin_attach_info_panel")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
	
	self.Image_1_0 = self.root_wnd:getChildByName("Image_1_0")
	self.Image_1_0:setVisible(false)
	self._hasAttach = self.root_wnd:getChildByName("_hasAttach")
	self._skillNode = self._hasAttach:getChildByName("_skillNode")
	self._elfinNode = self.root_wnd:getChildByName("_elfinNode")
	self._replaceIcon = self.root_wnd:getChildByName("_replaceIcon")
	self._bubbleBg = self.root_wnd:getChildByName("_bubbleBg")
	self._bubbleLabel = self._bubbleBg:getChildByName("_bubbleLabel")
	self.elfin_soul_05_1 = self.root_wnd:getChildByName("elfin_soul_05_1")
	
	self._ui = self
	local ui = self
	ui._bubbleLabel:setString(TI18N("语言_c_d_240"))

	ui._elfinItem = BackPackItem.new(false, true, nil, 0.78, nil, true)
	ui._elfinNode:addChild(self._ui._elfinItem)
	ui._elfinItem:setBackgroundRes(PathTool.getResFrame("common", "common_1005"))

	ui._elfinItem:addTouchEventCb(function (sender, event_type)
		customClickAction_2(ui._replaceIcon, event_type)
	end)
	ui._replaceIcon:addTouchEventListener(function(sender, event_type)
		if event_type == ccui.TouchEventType.ended then
			if self._elfinId then
				-- if not _model:checkSpriteIsOwn(self._elfinId)  then
				-- 	message(TI18N("语言_c_7335"))
				-- 	return
				-- end
				local is_used,use_id = _model:checkisALLattchElfin(self._elfinId)
				if is_used then
					local cfg = Config.ItemData.data_get_data(use_id)
					message(string.format(TI18N("语言_c_7354"),cfg.name))
					return
				end
				local _elfinId = self._elfinId
				_controller:openRedElfinInfoWindow(false)
				_controller:openNewElfinStrengWindow(false)
				_controller:openElfinMainInfoWindow(false)
				_controller:openElfinAttachWindow(true, _elfinId)
			end
		end
	end)

	ui._elfinItem:addBtnCallBack(function ()
		if self._elfinId then
			-- if not _model:checkSpriteIsOwn(self._elfinId)  then
			-- 	message(TI18N("语言_c_7335"))
			-- 	return
			-- end
			local is_used,use_id = _model:checkisALLattchElfin(self._elfinId)
			if is_used then
				local cfg = Config.ItemData.data_get_data(use_id)
				message(string.format(TI18N("语言_c_7354"),cfg.name))
				return
			end
			local _elfinId = self._elfinId
			_controller:openRedElfinInfoWindow(false)
			_controller:openNewElfinStrengWindow(false)
			_controller:openElfinMainInfoWindow(false)
			_controller:openElfinAttachWindow(true, _elfinId)
		end
	end)


	ui._skillItem = SkillItem.new(true, true, true, 0.72, true)
	ui._skillNode:addChild(ui._skillItem)

	-- ui._bubbleBg:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(2), cc.FadeOut:create(1), cc.FadeIn:create(1))))

end

function ElfinAttachInfoPanel:setData(elfinId)
	self._elfinId = elfinId
	local elfin_cfg = Config.SpriteData.data_elfin_data(elfinId)
	self._elfinCfg = elfin_cfg
	self:refresh()
end



function ElfinAttachInfoPanel:refresh()
	if not self._elfinCfg then
		self:setVisible(false)
		return
	end

	if not _model:checkElfinAttachOpen() then
		self:setVisible(false)
		return
	end
	
	-- 不能被附魂
	if not _model:checkCanAttach(self._elfinId) then
		self:setVisible(false)
		return
	end

	-- if not _model:checkElfinIsActivatedByBid(self._elfinId) then
	-- 	self:setVisible(false)
	-- 	return
	-- end
	local ui = self._ui
	self:setVisible(true)
	local attachElfinId = _model:getAttachElfinById(self._elfinId)
	if attachElfinId then
		-- 存在 附魂的精灵
		ui._hasAttach:setVisible(true)
		ui.Image_1_0:setVisible(false)
		ui.elfin_soul_05_1:setVisible(true)
		ui._elfinItem:setData({bid = attachElfinId})
		ui._elfinItem:showAddIcon(false)
		ui._elfinItem:showElfinLock(false)
		ui._replaceIcon:setVisible(true)
		-- ui._bubbleBg:setVisible(false)
		
		local attachCfg = Config.SpriteData.data_elfin_data(attachElfinId)
		if attachCfg then
			local skillCfg = Config.SkillData.data_get_skill(attachCfg.soul_skill)
			if skillCfg then
				ui._skillItem:setData(skillCfg)
			end
		end
		-- ui._elfinItem:addBtnCallBack(nil)
	else
		-- 不存在附魂的精灵
		-- ui._bubbleBg:setVisible(true)
		ui._hasAttach:setVisible(false)
		ui.elfin_soul_05_1:setVisible(false)
		ui.Image_1_0:setVisible(true)
		ui._elfinItem:setData(nil)
		-- if not _model:checkSpriteIsOwn(self._elfinId) then
		-- 	ui._elfinItem:showAddIcon(false)
		-- 	ui._elfinItem:showElfinLock(true)
		-- else
			ui._elfinItem:showAddIcon(true)
			ui._elfinItem:showElfinLock(false)
		-- end

		ui._elfinItem:setBackgroundRes(PathTool.getResFrame("common", "common_1005"))
		ui._replaceIcon:setVisible(false)
	end
end

-- desc: 
function ElfinAttachInfoPanel:onCleanup()


end