end

function ElfinIllustratedhandbookItem:createElfinBottomEff(quality)
	if self.bottom_eff then
		self.bottom_eff:clearTracks()
		self.bottom_eff:removeFromParent()
		self.bottom_eff = nil
	end
	if not self.bottom_eff then
		local eff_id = "E27004"
		local action = PlayerAction.action_3
		if quality == 6 then
			eff_id = "E27008"
			action = PlayerAction.action_3
		elseif quality == 5 then
			eff_id = "E27007"
			action = PlayerAction.action_3
		elseif quality == 4 then
			action = PlayerAction.action_3
		elseif quality == 3 then
			action = PlayerAction.action_2
		elseif quality == 2 then
			action = PlayerAction.action_1
		end
		self.bottom_eff = createEffectSpine(eff_id, cc.p(23, -23), cc.p(0, 0), true, action)
		self.bottom_eff:setScale(0.45)
		self.bottom_node:addChild(self.bottom_eff)
	end
end

function ElfinIllustratedhandbookItem:updateResStatus(id)
	local red_status = _model:getRedPetRedStatusById(id) or _model:getElfinStrongRed(id)
	addRedPointToNodeByStatus(self.main_container, red_status)
end

function ElfinIllustratedhandbookItem:DeleteMe(  )
	if self.sprite_eff then
		self.sprite_eff:clearTracks()
		self.sprite_eff:removeFromParent()
		self.sprite_eff = nil
	end
	if self.bottom_eff then
		self.bottom_eff:clearTracks()
		self.bottom_eff:removeFromParent()
		self.bottom_eff = nil
	end
	self:removeAllChildren()
	self:removeFromParent()
end
