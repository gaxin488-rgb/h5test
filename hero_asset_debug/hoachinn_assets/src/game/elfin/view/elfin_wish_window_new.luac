function ElfinWishItemNew:setItemList(cur_id_list)
    self.item_list = {}
    local size = self.elfin_list:getContentSize()

    for k, v in pairs(self.elfin_data_list) do
        if not self.item_list[k] then
            local cell = self:createNewCell()
            self.elfin_list:addChild(cell)
            local posx = 10 + (k-1)%4 * (BackPackItem.Width+24) + 60
            local posy = size.height - math.floor((k-1)/4) * (BackPackItem.Height+5) - 63
            cell:setPositionX(posx)
            cell:setPositionY(posy)
            self.item_list[k] = cell
        end
        local item_vo = v
        if item_vo then
            self.item_list[k]:setData(item_vo)
            for key, val in pairs(cur_id_list) do
                if val and val == item_vo.id then
                    self.item_list[k]:IsGetStatus(true)
                else
                    self.item_list[k]:IsGetStatus(false)
                end
            end
        end
    end

end

function ElfinWishItemNew:getItemList()
    return self.item_list
end

function ElfinWishItemNew:createNewCell()
    local cell = ElfinWishItem.new()
    cell:addCallBack(function()
        self.callback(cell)
    end)
    return cell
end

function ElfinWishItemNew:setData(data)
    self.data = data
    self.elfin_data_list = data.list_data
    local num = #data.list_data

    local line_num = math.ceil(num/4)
    local hight = line_num * (BackPackItem.Height+10)
    local total_height = hight + 44

    self:setContentSize(cc.size(580, total_height))
    self.root_wnd:setContentSize(cc.size(580, total_height))
    self.main_container:setContentSize(cc.size(580, total_height))
    self.elfin_list:setContentSize(cc.size(580, hight))
    -- self.elfin_list_view.scroll_view:setContentSize(cc.size(580, hight))
    -- self.elfin_list_view.scroll_view:setInnerContainerSize(cc.size(580, hight))

    self.title_bg:setPositionY(total_height-22)
    self.title_txt:setPositionY(total_height-22)
    self.elfin_list:setPositionY(0)
    self.root_wnd:setPositionY(0)
    self.main_container:setPositionY(0)

    local str = ""
    if data.quality == 4 then
        str = TI18N("语言_hol_sp_lo_07_1")
    elseif  data.quality == 5 then
        str = TI18N("语言_hol_sp_lo_07_5")
    end
    self.title_txt:setString(str)
end

function ElfinWishItemNew:addCallBack(callback)
    self.callback = callback
end

function ElfinWishItemNew:getSize(data)
    return self:getContentSize()
end
-- function ElfinWishItemNew:getData(data)
--     return self.data
-- end


function ElfinWishItemNew:registerEvent()
end

function ElfinWishItemNew:DeleteMe()
    for k, v in pairs(self.item_list) do
        if v and v.DeleteMe then
            v:DeleteMe()
        end
    end
    self:removeAllChildren()
    self:removeFromParent()
end


