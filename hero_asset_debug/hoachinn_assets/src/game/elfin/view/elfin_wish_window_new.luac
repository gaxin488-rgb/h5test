local _controller = ElfinController:getInstance()
local _model = _controller:getModel()
local _string_format = string.format
local _table_insert = table.insert

ElfinWishWindowNew = ElfinWishWindowNew or BaseClass(BaseView)

function ElfinWishWindowNew:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.layout_name = "elfin/elfin_wish_window_new"
    self.item_list = {}
    self.cur_item_id_list = {}
    self.select_cell_list = {}
    self.elfin_data_list = {}
    self.lucky_sprite_num = 1
    self.quliaty_item_list = {}
    local lucky_sprite_num_cfg = Config.HolidaySpriteLotteryData.data_const["lucky_sprite_num"]
    if lucky_sprite_num_cfg then
        self.lucky_sprite_num = lucky_sprite_num_cfg.val -- 可许愿精灵数量
    end
end

function ElfinWishWindowNew:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background then
        self.background:setScale(display.getMaxScale())
    end
    self.item = self.root_wnd:getChildByName("item")

    local container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(container, 2)

    self.win_title = container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_c_1944"))
    self.img_title = container:getChildByName("image_title")
    local img_width = self.win_title:getContentSize().width + 120
    local img_heigth = self.win_title:getContentSize().height
    self.img_title:setContentSize(cc.size(img_width, 63))
    self.left_btn = container:getChildByName("left_btn")
    self.left_btn:getChildByName("label"):setString(TI18N("语言_c_395"))
    self.right_btn = container:getChildByName("right_btn")
    self.right_btn:getChildByName("label"):setString(TI18N("语言_c_261"))
    self.close_btn = container:getChildByName("close_btn")
    self.elfin_info_panel = container:getChildByName("elfin_info_panel")
    local Image_1 = self.elfin_info_panel:getChildByName("Image_1")
    local name_txt = self.elfin_info_panel:getChildByName("name_txt")
    name_txt:setString(TI18N("语言_c_1940"))
    moveTextBg(name_txt, Image_1, 30)
    self.btn_rule = container:getChildByName("btn_rule")

    self.item_scrollview = self.elfin_info_panel:getChildByName("item_scrollview")
    self.item_scrollview:setScrollBarEnabled(false)
    self.item_scrollview_size = self.item_scrollview:getContentSize()

    self.elfin_list = container:getChildByName("elfin_list")
    local size = self.elfin_list:getContentSize()
    self.list_view = createScrollView(size.width, size.height, 0, 0, self.elfin_list, ScrollViewDir.vertical) 
    self.list_view:setAnchorPoint(cc.p(0, 0))
    self.scrollview_container = self.list_view:getInnerContainer()
  

    self.choose_tips_txt = createRichLabel(24, cc.c4b(0x64, 0x32, 0x23, 0xff), cc.p(0, 0), cc.p(110, 625), nil, nil, 500)
    self.choose_tips_txt:setLineSpace(-2)
    self.choose_tips_txt:setPositionY(721)
    container:addChild(self.choose_tips_txt)
    self.choose_tips_txt:setString(transformTextToShort(TI18N("语言_c_1945"), 150))
    addEvt2showAllTextTips(self.choose_tips_txt, TI18N("语言_c_1945"), 150, nil, nil, nil, true, true)

end

function ElfinWishWindowNew:onCellTouched(cell)
    local isSelect = false
    local item_vo = cell:getData()
    for k, v in pairs(self.cur_item_id_list) do
        if v and v.id == item_vo.id then
            if self.select_cell_list[k] then
                self.select_cell_list[k]:IsGetStatus(false)
                self.select_cell_list[k] = nil
            end

            self.cur_item_id_list[k] = nil
            isSelect = true
            break
        end
    end

    if isSelect == false then
        if #self.cur_item_id_list >= self.lucky_sprite_num then
            if self.cur_item_id_list[1] and self.select_cell_list[1] then
                self.select_cell_list[1]:IsGetStatus(false)
                self.select_cell_list[1] = cell
                self.cur_item_id_list[1] = item_vo
            end
        else
            _table_insert(self.select_cell_list, cell)
            _table_insert(self.cur_item_id_list, item_vo)
        end
        cell:IsGetStatus(true)
    end

    self:updateElfinInfo()
    self:updateIconShow()
end

function ElfinWishWindowNew:updateElfinInfo()
    if not self.cur_item_id_list or #self.cur_item_id_list <= 0 then -- 没选中任何一个精灵
        self.item_scrollview:setVisible(false)
        return
    end

    local cell_list = {}
    for k, v in pairs(self.select_cell_list) do
        if v then
            _table_insert(cell_list, v)
        end
    end
    self.select_cell_list = cell_list

    local temp_list = {}
    for k, v in pairs(self.cur_item_id_list) do
        if v then
            _table_insert(temp_list, v)
        end
    end
    self.cur_item_id_list = temp_list

    local data_list = {}
    for i, v in ipairs(temp_list) do
        _table_insert(data_list, {v.id, 1})
    end

    local setting = {}
    setting.max_count = 4
    setting.is_center = true
    self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, data_list, setting)

    self.item_scrollview:setVisible(true)
end

function ElfinWishWindowNew:register_event()
    registerButtonEventListener(self.left_btn, function()
        if self.elfin_bid_list == nil or next(self.elfin_bid_list) == nil then
            self:showCommonAlert(true)
            return
        end
        self:onClickCloseBtn()
    end, true)

    registerButtonEventListener(self.right_btn, handler(self, self.onClickChooseBtn), true)

    registerButtonEventListener(self.close_btn, function()
        if self.elfin_bid_list == nil or next(self.elfin_bid_list) == nil then
            self:showCommonAlert(true)
            return
        end
        self:onClickCloseBtn()
    end, true, 2)

    registerButtonEventListener(self.btn_rule, function()
        if self.summon_data then
            local action_cfg = Config.HolidaySpriteLotteryData.data_action[self.summon_data.camp_id]
            if action_cfg and action_cfg.group_id then
                local conf = Config.HolidaySpriteLotteryData.data_summon[action_cfg.group_id]
                if conf then
                    TimesummonController:getInstance():openTimeSummonAwardView(true, conf.group_id, self.summon_data,
                        TimesummonConst.ActonInfoType.ElfinType2)
                end
            end
        end
    end, true, 1)

    registerButtonEventListener(self.background, function()
        if self.elfin_bid_list == nil or next(self.elfin_bid_list) == nil then
            self:showCommonAlert(true)
            return
        end
        self:onClickCloseBtn()
    end, false, 2)
end

function ElfinWishWindowNew:onClickCloseBtn()
    _controller:openElfinWishWindowNew(false)
end

function ElfinWishWindowNew:onClickChooseBtn()
    if next(self.elfin_data_list) == nil then
        message(TI18N("语言_c_1946"))
        return
    end

    local temp_list = {}
    if next(self.cur_item_id_list) == nil then
        self:showCommonAlert(false)
    else
        for k, v in pairs(self.cur_item_id_list) do
            if v then
                _table_insert(temp_list, {
                    lucky_sprites_bid = v.id
                })
            end
        end
        _controller:send26554(temp_list)
        self:onClickCloseBtn()
    end
end

function ElfinWishWindowNew:showCommonAlert(is_close)
    local str = TI18N("语言_c_1947")
    if is_close == true then
        local function fun()
            self:onClickCloseBtn()
        end
        CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, nil,
            nil, true)
    else
        local function fun()
            _controller:send26554({})
            self:onClickCloseBtn()
        end
        CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, nil,
            nil, true)
    end
end

function ElfinWishWindowNew:setData(data)
    if not data then
        return
    end
    self.summon_data = data
    
	local chose = self.summon_data.chose
	if chose == 1 then
        local lucky_sprite_num_cfg = Config.HolidaySpriteLotteryData.data_const["lucky_sprite_num2"]
        self.lucky_sprite_num = lucky_sprite_num_cfg.val -- 可许愿精灵数量
    end

    self.elfin_bid_list = {}

    for k, v in pairs(data.lucky_ids) do
        if v.lucky_sprites_bid then
            _table_insert(self.elfin_bid_list, v.lucky_sprites_bid)
            local cur_elfin_cfg = Config.ItemData.data_get_data( v.lucky_sprites_bid)
            _table_insert(self.cur_item_id_list,cur_elfin_cfg)
        end
    end

    self.elfin_data_list = {}
    local all_elfin_data = {}
    local lucky_sprite_ids_cfg = Config.HolidaySpriteLotteryData.data_const["lucky_sprite_ids"]
    if chose == 1 then
        lucky_sprite_ids_cfg = Config.HolidaySpriteLotteryData.data_const["lucky_sprite_ids2"]
    end
    if lucky_sprite_ids_cfg then
        all_elfin_data = lucky_sprite_ids_cfg.val
    end

    local have_cfg_list = {}
    if all_elfin_data and next(all_elfin_data) ~= nil then
        for k, v in pairs(all_elfin_data) do
            local cur_elfin_cfg = Config.ItemData.data_get_data(v)
            if cur_elfin_cfg then
                local quality = cur_elfin_cfg.quality
                if have_cfg_list[quality] then
                    _table_insert(have_cfg_list[quality], cur_elfin_cfg)
                else
                    have_cfg_list[quality] = {}
                    _table_insert(have_cfg_list[quality], cur_elfin_cfg)
                end
            end
        end
    end
    local temp_list = {}
    for k, v in pairs(have_cfg_list) do
        local a = {}
        a.quality = k
        a.list_data = v
        _table_insert(temp_list, a)
    end
    self.elfin_data_list = temp_list

    if next(self.elfin_data_list) == nil then
        self.item_scrollview:setVisible(false)
    else
        local function sort_func(objA, objB)
            for k, v in pairs(self.elfin_bid_list) do
                if objA.id == v and objB.id ~= v then
                    return true
                elseif objA.id ~= v and objB.id == v then
                    return false
                end
            end
            if objA.quality ~= objB.quality then
                return objA.quality > objB.quality
            elseif objA.eqm_jie ~= objB.eqm_jie then
                return objA.eqm_jie > objB.eqm_jie
            else
                return objA.id < objB.id
            end
        end
        for i, v in ipairs(self.elfin_data_list) do
            table.sort(v.list_data, sort_func)
        end
        local function sortFunc2( objA, objB )
            return objA.quality > objB.quality
        end
        table.sort(self.elfin_data_list, sortFunc2)

        self:updateIconShow()
        
        local __height = 0

        for i, v in pairs(self.elfin_data_list) do
            local _data = v
            if self.quliaty_item_list[i] == nil then
                local item = ElfinWishItemNew.new()
                item:setPositionX(290)
                item:addCallBack(function ( cell )
                    self:onCellTouched(cell)
                end)--addCallBack(self.onCellTouched)
                self.list_view:addChild(item)
                self.quliaty_item_list[i] = item
            end
            self.quliaty_item_list[i]:setData(_data)
            self.quliaty_item_list[i]:setItemList(self.elfin_bid_list)
            local size = self.quliaty_item_list[i]:getSize()
            __height = __height + size.height
        end

        self.list_view:setInnerContainerSize(cc.size(580, __height))

        for i, v in ipairs(self.quliaty_item_list) do
            local hight = v:getContentSize().height
            v:setPositionY(__height-hight)
            __height = __height - hight
        end

        if self.cur_item_id_list and #self.cur_item_id_list > 0 then
            for i, v in pairs(self.quliaty_item_list) do
                local item_list = v:getItemList()
                for key, val in pairs(item_list) do
                    local item_data = val:getData()
                    if item_data then
                        for j, q in pairs(self.elfin_bid_list) do
                            if q == item_data.id then
                                _table_insert(self.select_cell_list, val)
                            end
                        end
                    end
                end
            end
            self:updateElfinInfo()
        end

    end
end

function ElfinWishWindowNew:updateIconShow()
    if self.cur_item_id_list and #self.cur_item_id_list > 0 then
        if self.item_node then
            self.item_node:setVisible(false)
        end
    else
        if self.item_node then
            self.item_node:setVisible(true)
        else
            self.item_node = BackPackItem.new(false, true, false)
            self.item_node:setPosition(cc.p(588 * 0.5, 176 * 0.5 - 20))
            self.elfin_info_panel:addChild(self.item_node)
            self.item_node:setData()
            self.item_node:showFlagByRes(true, PathTool.getResFrame("elfin", "elfin_1045"), 38, 94)
        end
    end
end

function ElfinWishWindowNew:openRootWnd(data)
    self:setData(data)
end

function ElfinWishWindowNew:close_callback()
    if self.elfin_list_view then
        self.elfin_list_view:DeleteMe()
        self.elfin_list_view = nil
    end
    if self.item_node then
        self.item_node:DeleteMe()
        self.item_node = nil
    end
    for i, v in pairs(self.quliaty_item_list) do
        v:DeleteMe()
    end
    self.quliaty_item_list = nil
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    _controller:openElfinWishWindowNew(false)
end


