AdvanceCardPanel = class("AdvanceCardPanel", function()
    return ccui.Widget:create()
end)

local card_list = Config.HolidayWarOrderData.data_advance_card_list
function AdvanceCardPanel:ctor(period)
    self.period = period or 1
    self:layoutUI()
    self:registerEvents()
end
function AdvanceCardPanel:layoutUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("orderaction/advance_card_panel"))
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
    self:setContentSize(cc.size(656,562))

    local main_container = self.root_wnd:getChildByName("main_container")
    self.top_banner = main_container:getChildByName("Image_16")
    local reward_bg = main_container:getChildByName("Image_15")
    if self.period == 2 then
        reward_bg:setVisible(false)
    else
        reward_bg:setVisible(true)
    end

    self:changeTopBanner(self.period)

    self.item_sprite = {}
    for i=1,4 do
        local tab = {}
        tab.title = main_container:getChildByName("text_bg_"..i):getChildByName("title")
        tab.title:setString("")
        tab.text = main_container:getChildByName("text_bg_"..i):getChildByName("text")
        tab.spr = main_container:getChildByName("item_"..i):getChildByName("spr")
        self.item_sprite[i] = tab
    end
    self:setData()
end
--更换头部标题
function AdvanceCardPanel:changeTopBanner(period)
    local banner_str
    if period == 2 then
        banner_str = "orderaction_banner2"
    end
    if banner_str then
        local banner_res = PathTool.getPlistImgForDownLoad("bigbg/orderaction", banner_str)
        if not self.barner_top_load then
            self.barner_top_load = loadImageTextureFromCDN(self.top_banner, banner_res, ResourcesType.single, self.barner_top_load)
        end
    end
end

function AdvanceCardPanel:setData()
    if card_list[self.period] and card_list[self.period][1] then
        self.item_sprite[1].title:setString(card_list[self.period][1].desc1 or "")
        self.item_sprite[1].text:setString(card_list[self.period][1].desc1_1 or "")
        self.item_sprite[2].title:setString(card_list[self.period][1].desc2 or "")
        self.item_sprite[2].text:setString(card_list[self.period][1].desc2_1 or "")
        self.item_sprite[3].title:setString(card_list[self.period][1].desc3 or "")
        self.item_sprite[3].text:setString(card_list[self.period][1].desc3_1 or "")
        self.item_sprite[4].title:setString(card_list[self.period][1].desc4 or "")
        self.item_sprite[4].text:setString(card_list[self.period][1].desc4_1 or "")

        if card_list[self.period][1].award_pic then
            for i=1,4 do
                local res = card_list[self.period][1].award_pic[1][i]
                loadSpriteTexture(self.item_sprite[i].spr, PathTool.getResFrame("orderaction",res), LOADTEXT_TYPE_PLIST)
            end
        end
    end
    
end
function AdvanceCardPanel:registerEvents()

end
function AdvanceCardPanel:setVisibleStatus(bool)
    self:setVisible(bool)
end

function AdvanceCardPanel:DeleteMe()
    if self.barner_top_load then
        self.barner_top_load:DeleteMe()
    end
    self.barner_top_load = nil
end
