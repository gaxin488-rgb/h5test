-- --------------------------------------------------------------------
-- --------------------------------------------------------------------
KeyinRuleTips = KeyinRuleTips or BaseClass(BaseView)

local controller = KeyinController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_sort = table.sort
local table_insert = table.insert

local tyep_bgres = {
    [2] = "fa",
    [3] = "wu",
    [4] = "rou",
    [5] = "fu",
}

function KeyinRuleTips:__init()
    self.is_full_screen = true
    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.strength_attr_list = {}
    self.strength_effect_list = {}
    self.skill_item_list = {}
    self.is_can_up = true
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("engraved", "engraved"), type = ResourcesType.plist}
	}
    self.layout_name = "keyin/keyin_rule_tips"
end

function KeyinRuleTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.mainContainer = self.root_wnd:getChildByName("main_panel")

    self.close_btn = self.mainContainer:getChildByName("close_btn")
    self:playEnterAnimatianByObj(self.mainContainer , 1)

    self.container = self.mainContainer:getChildByName("container")
    
    self.base_panel = self.container:getChildByName("base_panel")
    local left_img = self.base_panel:getChildByName("left_img")
    local right_img = self.base_panel:getChildByName("right_img")
    local title = self.base_panel:getChildByName("name")
    title:setString(TI18N("语言_c_6364"))
    setLeftRightImg(left_img,title ,right_img , 20)

    local tips = self.base_panel:getChildByName("tips")
    tips:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    setTextMaxWidth(tips, 520, -4)
    tips:setString(TI18N("语言_c_7014"))
    self.node1 = self.base_panel:getChildByName("Node_1")
    self.node2 = self.base_panel:getChildByName("Node_2")
    self.node3 = self.base_panel:getChildByName("Node_3")

    self.desc_panel = self.container:getChildByName("desc_panel")
    self.scroll_view = self.desc_panel:getChildByName("scroll_view")
    self.scroll_view:setScrollBarEnabled(false)
    self.desc = createRichLabel(24, cc.c4b(0xc5,0xb9,0x9e,0xff), cc.p(0.5, 1), cc.p(0, 0), 0, nil, 540)
    self.scroll_view:addChild(self.desc)
end

function KeyinRuleTips:register_event()
    registerButtonEventListener(self.background, function() self:_onClickBtnClose() end ,false, 2)
end

function KeyinRuleTips:_onClickBtnClose()
    controller:openKeyinRuletipsWindow(false)
end

function KeyinRuleTips:openRootWnd()
    -- common_90073_1
    -- ["sun_order"] = {key='sun_order', val={60,85,110}, desc=TI18N("太阳展示等级")}
    local lev_list = Config.PartnerEngravedData.data_constant["sun_order"].val
    self.eff1 = createEffectSpine("E27806", cc.p(0,-35), cc.p(0.5, 0.5), true, PlayerAction.action)
    self.eff1:setScale(0.8)
    self.node1:addChild(self.eff1)
    local res = PathTool.getResFrame("common","common_90073_2")--这个是太阳标记
    self.sun_img1 = createImage(self.node1,res,0,-30,cc.p(0.5,0.5),true,0,false)
    self.sun_lv1 = createLabel(24, cc.c4b(0xfe,0xee,0xba,0xff), cc.c4b(0x00,0x00,0x00,0xff), 0, -65, "", self.node1, -4, cc.p(0.5,0.5))
    self.sun_lv1:setString(string.format(TI18N("语言_c_540"),lev_list[1]))
    
    self.eff2 = createEffectSpine("E27807", cc.p(0,-35), cc.p(0.5, 0.5), true, PlayerAction.action)
    self.eff2:setScale(0.8)
    self.node2:addChild(self.eff2)
    local res = PathTool.getResFrame("common","common_90073_3")--这个是太阳标记
    self.sun_img2 = createImage(self.node2,res,0,-30,cc.p(0.5,0.5),true,0,false)
    self.sun_lv2 = createLabel(24, cc.c4b(0xfe,0xee,0xba,0xff), cc.c4b(0x00,0x00,0x00,0xff), 0, -65, "", self.node2, -4, cc.p(0.5,0.5))
    self.sun_lv2:setString(string.format(TI18N("语言_c_540"),lev_list[2]))
    
    self.eff3 = createEffectSpine("E27808", cc.p(0,-35), cc.p(0.5, 0.5), true, PlayerAction.action)
    self.eff3:setScale(0.8)
    self.node3:addChild(self.eff3)
    local res = PathTool.getResFrame("common","common_90073_4")--这个是太阳标记
    self.sun_img3 = createImage(self.node3,res,0,-30,cc.p(0.5,0.5),true,0,false)
    self.sun_lv3 = createLabel(24, cc.c4b(0xfe,0xee,0xba,0xff), cc.c4b(0x00,0x00,0x00,0xff), 0, -65, "", self.node3, -4, cc.p(0.5,0.5))
    self.sun_lv3:setString(string.format(TI18N("语言_c_540"),lev_list[3]))

    local str = Config.PartnerEngravedData.data_constant["game_rule1"].desc
    self.desc:setString(str)
    local desc_size = self.desc:getContentSize()
    local panel_size = self.desc_panel:getContentSize()
    local scroll_height = math.max(panel_size.height,desc_size.height)
    self.scroll_view:setInnerContainerSize(cc.size(panel_size.width, scroll_height))
    self.desc:setPositionX(panel_size.width/2)
    self.desc:setPositionY(scroll_height)
end

function KeyinRuleTips:close_callback()
    if self.eff1 then
        self.eff1:clearTracks()
        self.eff1:removeFromParent()
        self.eff1 = nil
    end
    if self.eff2 then
        self.eff2:clearTracks()
        self.eff2:removeFromParent()
        self.eff2 = nil
    end
    if self.eff3 then
        self.eff3:clearTracks()
        self.eff3:removeFromParent()
        self.eff3 = nil
    end
    controller:openKeyinRuletipsWindow(false)
end
