-- --------------------------------------------------------------------
-- --------------------------------------------------------------------
KeyinMaxAttrTips = KeyinMaxAttrTips or BaseClass(BaseView)

local controller = KeyinController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_sort = table.sort
local table_insert = table.insert

local tyep_bgres = {
    [2] = "fa",
    [3] = "wu",
    [4] = "rou",
    [5] = "fu",
}

function KeyinMaxAttrTips:__init()
    self.is_full_screen = true
    self.win_type = WinType.Tips
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.attr_list = {}
    -- self.strength_effect_list = {}
    self.skill_item_list = {}
    -- self.is_can_up = true
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("engraved", "engraved"), type = ResourcesType.plist}
	}
    self.layout_name = "keyin/keyin_max_attr_tips"
end

function KeyinMaxAttrTips:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.item = self.root_wnd:getChildByName("item")
    self.item:setVisible(false)

    self.container = self.root_wnd:getChildByName("container")
    self.close_btn = self.container:getChildByName("close_btn")
    self:playEnterAnimatianByObj(self.container , 1)

    self.base_panel = self.container:getChildByName("base_panel")
    self.keyin_icon = self.base_panel:getChildByName("icon")
    self.keyin_name = self.base_panel:getChildByName("name")
    local score_title = self.base_panel:getChildByName("score_title")
    score_title:setString(TI18N("语言_c_1742"))
    self.power_label = CommonNum.new(1, self.base_panel, 1, - 2, cc.p(0, 0))
    self.power_label:setPosition(cc.p(score_title:getPositionX() + score_title:getContentSize().width + 5 , 32))
    self.power_label:setNum(0)
    self.power_label:setScale(0.8)

    self.base_attr = self.container:getChildByName("base_attr")
    self.base_label = self.base_attr:getChildByName("label")
    self.base_label:setString(TI18N("语言_c_6071"))

    self.skill_panel = self.container:getChildByName("skill_panel")
    self.skill_lab = self.skill_panel:getChildByName("label")
    self.skill_lab:setString(TI18N("语言_c_6904"))

    self.scroller_view = createScrollView(self.skill_panel:getContentSize().width, self.skill_panel:getContentSize().height - 50, 0, 10, self.skill_panel, ccui.ScrollViewDir.vertical)

end

function KeyinMaxAttrTips:createNewCell(width, height)
    local cell = KeyinSkillItemItem.new()
    return cell
end
function KeyinMaxAttrTips:numberOfCells()
    if not self.cell_data_list then
        return 0
    end
    return #self.cell_data_list
end
function KeyinMaxAttrTips:updateCellByIndex(cell, index)
    cell.index = index
    local cell_data = self.cell_data_list[index]
    if not cell_data then
        return
    end

    local skill_id
    local unlock = cell_data.unlock
    local skill_id_list = unlock[#unlock][3]
    skill_id = skill_id_list[1]
    local config = Config.SkillData.data_get_skill(skill_id)
    
    local skill_name = cell:getChildByName("name")
    skill_name:setString(config.name)
    local skill_desc = cell:getChildByName("skill_type")
    setTextMaxWidth(skill_desc, 460, -4)
    if cell_data.skill_desc ~= "" then
        skill_desc:setString(cell_data.skill_desc)
    else
        skill_desc:setString(config.des)
    end
    local line = cell:getChildByName("line")

    local label_siez = skill_desc:getContentSize()
    local name_height = skill_name:getContentSize().height
    local total_height = name_height + label_siez.height + 20 + 5
    cell:setContentSize(cc.size(590, total_height))
    skill_name:setPositionY(total_height - 5)
    skill_desc:setPositionY(total_height - 10 - name_height - 5)
    line:setPositionY(0)
    cell.show_height = total_height

    return total_height
end

function KeyinMaxAttrTips:register_event()
    registerButtonEventListener(self.background, function() self:_onClickBtnClose() end ,false, 2)
    registerButtonEventListener(self.close_btn, function() self:_onClickBtnClose() end ,true, 2)
end

function KeyinMaxAttrTips:_onClickBtnClose()
    controller:openKeyinPreviewTipsWindow(false)
end

function KeyinMaxAttrTips:openRootWnd(bid)
    self.hero_bid = bid
    local partner_cfg = Config.PartnerData.data_partner_base[self.hero_bid]
    self.engraved_id = partner_cfg.engraved_id
    self.total_lv = model:getAllLevById(self.engraved_id)

    local hero_type = partner_cfg.type
    local bg_id = "engraved_pic_"..tyep_bgres[hero_type].."_01"
    loadSpriteTexture(self.keyin_icon, PathTool.getResFrame("engraved", bg_id), LOADTEXT_TYPE_PLIST)

    local base_cfg = Config.PartnerEngravedData.data_base_info[self.engraved_id]
    if base_cfg then
        local info = base_cfg[1]
        self.keyin_name:setString(info.name)
        self.power_label:setNum(info.max_lev_score)
    end

    self:setUpStatus()
    self:setSkillInfo()
end

--设置技能信息
function KeyinMaxAttrTips:setSkillInfo()
    local cfg = Config.PartnerEngravedData.data_get_skill 
    local list = {}
    for k, v in pairs(cfg) do
        if v.id == self.hero_bid then
            table.insert(list,v)
        end
    end
    local sort_fun = SortTools.tableLowerSorter({"total_lv"})
    table.sort(list, sort_fun)
    self.cell_data_list = list
    
    local total_height = 0

    for i, v in ipairs(list) do
        if not self.skill_item_list[i] then
            local cell = self.item:clone()
            self.scroller_view:addChild(cell)
            self.skill_item_list[i] = cell
        end
        local item_height = self:updateCellByIndex(self.skill_item_list[i],i)
        -- local item_size = self.skill_item_list[i]:getHereItemSize()
        total_height = total_height + item_height + 5
    end
    self.scroller_view:setInnerContainerSize(cc.size(590,total_height))
    local _height = total_height
    for k, v in pairs(self.skill_item_list) do
        v:setVisible(true)
        v:setPositionX(295)
        v:setPositionY(_height)
        local item_size = v.show_height
        _height = _height - item_size - 5
    end
end

--设置强化状态
function KeyinMaxAttrTips:setUpStatus()
    local cfg = Config.PartnerEngravedData.data_lv_info[self.engraved_id]
    local full_attr_list ={}
    --总的属性
    if cfg and next(cfg) then
        for k, v in pairs(cfg) do
            local pos = k
            local data = v
            local max_data = data[#data]
            local attr = max_data.attr
            for key, val in ipairs(attr) do
                local attr_key = val[1]
                local attr_id = Config.AttrData.data_key_to_id[attr_key] or Config.AttrExtraData.data_key_to_id[attr_key]
                local attr_num = val[2]
                if full_attr_list[attr_id] then
                    full_attr_list[attr_id] = attr_num + full_attr_list[attr_id]
                else
                    full_attr_list[attr_id] = attr_num
                end
            end
        end
    end
    local _full_attr_list = {}
    for k, v in pairs(full_attr_list) do
        table.insert(_full_attr_list, {id=k,num=v})
    end
    local function sortFunc( objA, objB )
        return objA.id < objB.id
    end
    table.sort(_full_attr_list, sortFunc)

    local num = tableLen(full_attr_list)
    local total_height = 40 * math.ceil(num/2) + 50
    self.base_attr:setContentSize(cc.size(540, total_height))
    self.base_label:setPositionY(total_height - 10)

    local start_y = total_height - 10 - self.base_label:getContentSize().height - 10

    local index = 1
    for k, v in pairs(_full_attr_list) do
        local res, attr_name, attr_val = commonGetAttrInfoByIDValue(v.id, v.num)
        local str = string_format("<img src='%s' scale=1 /><div fontcolor=#aaa29a> %s:</div><div fontcolor=#efe0d1>%s</div>", res,attr_name,attr_val)
		if not self.attr_list[index] then
			self.attr_list[index] = createRichLabel(20, cc.c4b(0xff, 0xff, 0xff, 0xff), cc.p(0, 1), cc.p(45, 115), -4, nil, 620)
			self.base_attr:addChild(self.attr_list[index])
		end
		self.attr_list[index]:setString(str)

        local _x = 20 + (260)* ((index-1) % 2)
		local _y = start_y - math.floor((index-1)/2)*40
        self.attr_list[index]:setPositionX(_x)
        self.attr_list[index]:setPositionY(_y)
        index = 1 + index
    end
end

function KeyinMaxAttrTips:close_callback()
    if self.scroller_view then
        self.scroller_view:removeAllChildren()
        self.scroller_view:removeFromParent()
    end
    controller:openKeyinPreviewTipsWindow(false)
end