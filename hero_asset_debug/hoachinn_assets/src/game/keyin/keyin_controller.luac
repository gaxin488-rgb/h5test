--刻印满级预览tips
function KeyinController:openKeyinPreviewTipsWindow(bool,bid)
    if bool == true then
        if not self.keyin_preview_tips_window then
            self.keyin_preview_tips_window = KeyinMaxAttrTips.New()
        end
        if self.keyin_preview_tips_window and self.keyin_preview_tips_window:isOpen() == false then
            self.keyin_preview_tips_window:open(bid)
        end
    else
        if self.keyin_preview_tips_window then
            self.keyin_preview_tips_window:close()
            self.keyin_preview_tips_window = nil
        end
    end
end

function KeyinController:__delete()
    if self.model ~= nil then
        self.model:DeleteMe()
        self.model = nil
    end
end