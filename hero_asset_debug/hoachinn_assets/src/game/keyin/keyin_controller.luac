--刻印说明tips
function KeyinController:openKeyinRuletipsWindow(bool)
    if bool == true then
        if not self.keyin_rule_tips_window then
            self.keyin_rule_tips_window = KeyinRuleTips.New()
        end
        if self.keyin_rule_tips_window and self.keyin_rule_tips_window:isOpen() == false then
            self.keyin_rule_tips_window:open()
        end
    else
        if self.keyin_rule_tips_window then
