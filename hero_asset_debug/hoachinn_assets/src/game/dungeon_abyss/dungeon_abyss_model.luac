-- 这里填写简要说明(必填),
--
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-06-07
-- --------------------------------------------------------------------
DungeonAbyssModel = DungeonAbyssModel or BaseClass()

function DungeonAbyssModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function DungeonAbyssModel:config()
    --普通副本信息
    self.base_info = {}
    ---进阶副本信息
    self.advance_info = {}

    self.reward_list = {} --战令奖励
end

-- 是否屏蔽功能
function DungeonAbyssModel:isHideShinobi()
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	local featuresId = MainuiConst.FeaturesShield.DungeonAbyss
    if not table.indexof(nohideIds,featuresId) then
		return true
	end
end

--异界深渊
function DungeonAbyssModel:getDungeonAbyssIsOpen(not_tips)
    --60级开放
    local open_lv = 60
    local desc = ""
    local role_vo = RoleController:getInstance():getRoleVo() 
    if role_vo.lev >= open_lv then
        return true, desc
    end
    return false, desc
end

--是否已经获取试练塔的协议信息
function DungeonAbyssModel:isInitData(type)
    if type and type == 2 then
        if next(self.advance_info) == nil then
            return false
        end
    else
        if next(self.base_info) == nil then
            return false
        end
    end
    return true
end

function DungeonAbyssModel:setBaseInfo(data)
    self.base_info = data
    self.reward_list[1] = {} --类型
    if next(data.rewards) ~= nil then
        for i,v in pairs(data.rewards) do
            local tab = {}
            tab.id = v.id
            tab.award1 = v.reward1
            tab.award2 = v.reward2
            self.reward_list[1][v.id] = tab
        end
    end
end

function DungeonAbyssModel:checkBaseIsPass()
    return self.base_info.pass == 1
end

--判断进阶是否开放
function DungeonAbyssModel:checkAdvanceIsOpen()
    if next(self.base_info) == nil then
        return false
    end
    local open_index = Config.DungeonAbyssCircleData.data_nor_challenge_data_length
    if self.base_info.max >= open_index then
        return true 
    end
    return false
end
function DungeonAbyssModel:setAdvanceInfo(data)
    self.advance_info = data
    self.reward_list[2] = {} --类型
    if next(data.rewards) ~= nil then
        for i,v in pairs(data.rewards) do
            local tab = {}
            tab.id = v.id
            tab.award1 = v.reward1
            tab.award2 = v.reward2
            self.reward_list[2][v.id] = tab
        end
    end
end

function DungeonAbyssModel:checkIsEnd()
    --提前一小时结算
    local time_str = 60*60
    local end_time= self.advance_info.end_time - GameNet:getInstance():getTime() - time_str
    if end_time <= 0 then
        return true
    else
        return false
    end
end

function DungeonAbyssModel:getEndtime()
    return self.advance_info.end_time or 0
end
function DungeonAbyssModel:checkIsChooseDifDone()
    if self.advance_info and self.advance_info.lv then
        return self.advance_info.lv ~= 0
    end
    return false
end
--推荐难度
function DungeonAbyssModel:getRecommendLevel()
    local role_vo = RoleController:getInstance():getRoleVo() 
	local self_power = role_vo and role_vo.power or 0
    local selfLevel = 0
    local cfg = Config.DungeonAbyssCircleData.data_diff_data
    for key, value in pairs(cfg) do
        if self_power >= value.power[1][1] and self_power <= value.power[1][2] then
            selfLevel = value.id
            return selfLevel
        end
    end
    return selfLevel
end
--推荐英灵难度
function DungeonAbyssModel:getHeroRecommendLevel()
    local selfLevel = 0
    local cfg = Config.DungeonAbyssCircleData.data_diff_data
    for key, value in pairs(cfg) do
        local star = 0
        local num = 0
        for k, v in pairs(value.partner_star) do
            if v[1] == "partner_star" then
                star = v[2]
                num = v[3]
            end
        end
        local list = {0,star,num}
        if HeroController:getInstance():getModel():getHeroReachCon(list)[1] then
            selfLevel = math.max(selfLevel,value.id)
        end
    end
    return selfLevel
end

--当前通关层
function DungeonAbyssModel:getNowTowerId(type)
    type = type or 1
    if type == 1 then
        return self.base_info.max or 0
    else
        return self.advance_info.max or 0
    end
end

function DungeonAbyssModel:setAdvacneDiff(diff_id)
    self.advance_info.lv = diff_id
end

function DungeonAbyssModel:getAdvanceDiff(type)
    if type and type == 1 then
        return 1
    else
        return self.advance_info.lv or 1
    end
end
function DungeonAbyssModel:getAdvanceGroupId()
    return self.advance_info.group_id or 1
end

function DungeonAbyssModel:getRewardData(type, id)
    if not self.reward_list then return end
    if not self.reward_list[type] then return end
    if id == nil then
        return self.reward_list[type] or {}
    else
        return self.reward_list[type][id] or {}
    end
end

function DungeonAbyssModel:getTowerMaxLevel(type)
    if type == 1 then -- 普通
        return Config.DungeonAbyssCircleData.data_nor_challenge_data_length
    else --进阶
        local group_id = self:getAdvanceGroupId()
        local diff_id = self:getAdvanceDiff()
        local list = Config.DungeonAbyssCircleData.data_dif_challenge_data[group_id][diff_id]
        return #list
    end
end
--获取当前层信息
function DungeonAbyssModel:getDunInfoById(type, id)
    if type == 1 then
        for i, v in ipairs(self.base_info.dun_list) do
            if v.dun_id == id then
                return v
            end
        end
    else
        for i, v in ipairs(self.advance_info.dun_list) do
            if v.dun_id == id then
                return v
            end
        end
    end
    return nil
end

--获取星塔战令最大层级
function DungeonAbyssModel:getOrderMaxFloor(type, diff)
    local cfg = Config.DungeonAbyssCircleData.data_task_data[type][diff]
    local max_floor = 1
    for i, v in ipairs(cfg) do
        if v.tower > max_floor then
            max_floor = v.tower
        end
    end
    return max_floor
end

function DungeonAbyssModel:getOrderStatus(type)
    if type == 1 then
        return self.base_info.charge == 1
    else
        return self.advance_info.charge == 1
    end
end

function DungeonAbyssModel:getOrderReceive(type, index)
	for k, v in ipairs(self.reward_list[type]) do
		if v.id == index then
			return v
		end
	end
	return {}
end

function DungeonAbyssModel:getOrderData(type)
    if type == 1 then
        return 	{order_awards = self.base_info.rewards,
        buy = self.base_info.charge,
        end_time = self.base_info.end_time}
    else
        return 	{order_awards = self.advance_info.rewards,
        buy = self.advance_info.charge,
        end_time = self.advance_info.end_time}
    end
end

function DungeonAbyssModel:getReceiveFinishNext(type, diff)
    if type == 1 then
        diff = 1
    end
	local cfg = Config.DungeonAbyssCircleData.data_task_data[type][diff]
	-- table.sort(self:getOrderAwardsData(), function(a,b) return a.id < b.id end)
	local id = 0
	for k, v in ipairs(self.reward_list[type]) do
		if v.award1 == 0 and v.award2 == 0 then
			id = v.id
			if cfg[id] then
				return cfg[id]
			end
		end
	end
	return cfg[tableLen(cfg)]
end

function DungeonAbyssModel:getReceiveFinish(type, diff)
	local cfg = Config.DungeonAbyssCircleData.data_task_data[type][diff]
	-- table.sort(self:getOrderAwardsData(), function(a,b) return a.id < b.id end)
	local id = 1
	for k, v in ipairs(self.reward_list[type]) do
		if v.award1 == 0 and v.award2 == 0 then
			id = v.id - 1
			if cfg[id] then
				return id
			end
		end
	end
	return tableLen(cfg)
end
--获取当前总星星
function DungeonAbyssModel:getTotalStarCount(type)
    local count = 0
    if type == 1 then
        count = self.base_info.star_num
    else
        count = self.advance_info.star_num
    end
    return count
end
--获取当前功能入口供电
function DungeonAbyssModel:getTotalRedStatus(type)
    if type == 1 then --异界深渊
        return false
    else  --无限异界深渊
        --是否选择难度
        if self:isHideShinobi() or not self:checkAdvanceIsOpen() then
            return false
        end
        return not self:checkIsChooseDifDone()
    end
end

--战令红点
function DungeonAbyssModel:getOrderRedStatus(type)
    local reward_data = self.reward_list[type]
    if reward_data and next(reward_data) ~= nil then
        for k, v in pairs(reward_data) do
            if v.award1 == 1 or v.award2 == 1 then
                return true
            end
        end
    end
    return false
end

function DungeonAbyssModel:getOrderRedStatusAll()
    local reward_data = self.reward_list
    if reward_data and next(reward_data) ~= nil then
        for key, value in pairs(reward_data) do
            for k, v in pairs(value) do
                if v.award1 == 1 or v.award2 == 1 then
                    return true
                end
            end
        end
    end
    return false
end
--判断异界是否开放 跳转用 type1异界2无限异界
function DungeonAbyssModel:getFunIsOpen(type,is_jump)
    if type == 1 then
        local cfg = Config.CrossGroundData.data_base2[301][1]
        if cfg and cfg.open_limit then
            local is_open = MainuiController:getInstance():checkIsOpenByActivate(cfg.open_limit)
            if is_open then
                if not self:isHideShinobi() then
                    self.ctrl:openDungeonAbyssShopPanel(false)
                    if self:isInitData(1) then
                        MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.main_scene)
                        self.ctrl:openDungeonAbyssMainWindow(true, 1)
                        return true
                    else
                        self.ctrl:sender22500()
                        return true
                    end
                end
            end
        end
    elseif type == 2 then
        local cfg = Config.CrossGroundData.data_base2[401][1]
        if cfg and cfg.open_limit then
            local is_open = MainuiController:getInstance():checkIsOpenByActivate(cfg.open_limit)
            if is_open then
                if not self:isHideShinobi() and self:checkAdvanceIsOpen() then
                    self.ctrl:openDungeonAbyssShopPanel(false)
                    if self:isInitData(2) then
                        MainuiController:getInstance():changeMainUIStatus(MainuiConst.btn_index.main_scene)
                        self.ctrl:openDungeonAbyssMainWindow(true, 2,is_jump)
                        return true
                    else
                        self.ctrl:sender22501()
                        return true
                    end
                end
            end
        end
    end
    return false
end
function DungeonAbyssModel:__delete()
end
