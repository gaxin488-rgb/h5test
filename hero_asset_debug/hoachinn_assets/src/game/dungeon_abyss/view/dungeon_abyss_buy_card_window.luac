--******** 文件说明 ********
-- 
-- @description: 冒险战令购买进阶卡
-- @DateTime:    2019-06-24 20:08:18
-- *******************************
DungeonAbyssBuyCardWindow = DungeonAbyssBuyCardWindow or BaseClass(BaseView)

local controller = DungeonAbyssController:getInstance()
local model = controller:getModel()
function DungeonAbyssBuyCardWindow:__init(cur_type)
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.cur_type = cur_type or 1
    self.layout_name = "dungeon_abyss/dungeon_abyss_buy_card_window"
end

function DungeonAbyssBuyCardWindow:open_callback()
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2)
    self.title = main_container:getChildByName("Text_3")
    if self.cur_type == 1 then
        self.title:setString(TI18N("语言_dun_aby_cir_5_1"))
    else
        self.title:setString(TI18N("语言_dun_aby_cir_5_2"))
    end
    local title_bg = main_container:getChildByName("title_bg")
    local title_width = main_container:getChildByName("Text_3"):getContentSize().width
    local title_bg_width = math.max(title_width+130, 266)
    title_bg:setContentSize(cc.size(title_bg_width,44))
    
    self.title_1 = main_container:getChildByName("Text_3_0")
    setTextMaxWidth(self.title_1, 285)
    self.title_1:setString(TI18N("语言_c_742"))
    self.title_2 = main_container:getChildByName("Text_3_1")
    setTextMaxWidth(self.title_2, 285)
    self.title_2:setString(TI18N("语言_c_743"))
    self.title_2:setPositionX(325)
    
    local label_lock = createRichLabel(20,cc.c4b(0xff,0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(325,135),nil,nil,400)
    main_container:addChild(label_lock)
    label_lock:setHorizontalLayoutType(2)
    local str = TI18N("语言_c_7012")
    if self.cur_type == 2 then
        str = TI18N("语言_c_7013")
    end
    label_lock:setString(str)
    -- main_container:addChild(label_lock)

    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_label = self.btn_change:getChildByName("Text_6")
    local chargeId = Config.DungeonAbyssCircleData.data_constant.charge1.val
    if self.cur_type == 2 then
        chargeId = Config.DungeonAbyssCircleData.data_constant.charge2.val
    end
    local cdata = Config.ChargeData.data_charge_data[chargeId]
    local val = 198
    if cdata then
        val = GetMoneyNum(cdata,"val")
    end
    self.btn_change_label:setString(string.format(TI18N("语言_c_4441"),val))

    if model:getOrderStatus(self.cur_type) then
        self.btn_change:setTouchEnabled(false)
        setChildUnEnabled(true, self.btn_change)
        self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
    end
    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    self:setData()

    self.btn_close = main_container:getChildByName("btn_close")
end

function DungeonAbyssBuyCardWindow:setData()
    local baseCfg = Config.DungeonAbyssCircleData.data_constant
    local list_1 = baseCfg.dungeon_show_order1.val
    local list_2 = baseCfg.dungeon_reward_order1.val
    if self.cur_type == 2 then
        list_1 = baseCfg.dungeon_show_order2.val
        list_2 = baseCfg.dungeon_reward_order2.val
    end

	if list_1 and next(list_1) then
		local setting = {}
		setting.scale = 0.7
        setting.space_x = 3
		setting.max_count = 4
		setting.is_center = true
		self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, list_1, setting)
    end
    if list_2 and next(list_2) then
		local setting = {}
		setting.scale = 0.7
		setting.max_count = 4
		setting.is_center = true
		self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, list_2, setting)
	end

end

function DungeonAbyssBuyCardWindow:register_event()
    if not self.update_order_event then --更新战令解锁信息
        self.update_order_event = GlobalEvent:getInstance():Bind(DungeonAbyssEvent.Update_Base_Data, function(data)
            if model:getOrderStatus(self.cur_type) then
                self.btn_change:setTouchEnabled(false)
                setChildUnEnabled(true, self.btn_change)
                self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
            end
        end)
    end
    if not self.update_advance_data then --更新战令解锁信息
        self.update_advance_data = GlobalEvent:getInstance():Bind(DungeonAbyssEvent.Update_Advance_Data, function(data)
            if model:getOrderStatus(self.cur_type) then
                self.btn_change:setTouchEnabled(false)
                setChildUnEnabled(true, self.btn_change)
                self.btn_change_label:disableEffect(cc.LabelEffect.OUTLINE)
            end
        end)
    end

	registerButtonEventListener(self.btn_close, function()
        controller:openDungeonAbyssBuyCardWindow(false)
    end,true, 2)

    registerButtonEventListener(self.background, function()
        controller:openDungeonAbyssBuyCardWindow(false)
    end,false, 2)

    registerButtonEventListener(self.btn_change, function()
        self:changeWarn()
    end,true, 1)
end

function DungeonAbyssBuyCardWindow:changeWarn()
    local act_status = model:getOrderStatus(self.cur_type)
    if act_status then
    else
        local baseCfg = Config.DungeonAbyssCircleData.data_constant
        local chargeId = baseCfg.charge1.val
        if self.cur_type == 2 then
            chargeId = baseCfg.charge2.val
        end
        local cdata = Config.ChargeData.data_charge_data[chargeId]
        local val = 198
        if cdata then
            val = GetMoneyNum(cdata,"val")
        end
        -- local str = string.format(TI18N("语言_c_4441"),val)
        -- local str1 = string.format("是否花费%s升级战令",str)
        -- CommonAlert.show(str1,TI18N("语言_c_63"),function()
            sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
        -- end,TI18N("语言_c_62"),nil,CommonAlert.type.common,nil,{timer=5, timer_for=true},26)
    end        
end
function DungeonAbyssBuyCardWindow:openRootWnd()

end

function DungeonAbyssBuyCardWindow:close_callback()
	if self.image_bg_load then
        self.image_bg_load:DeleteMe()
    end
    self.image_bg_load = nil

    if self.update_order_event then
        GlobalEvent:getInstance():UnBind(self.update_order_event)
        self.update_order_event = nil
    end
    if self.update_advance_data then
        GlobalEvent:getInstance():UnBind(self.update_advance_data)
        self.update_advance_data = nil
    end
	if self.item_list1 then
        for i,v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i,v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
	controller:openDungeonAbyssBuyCardWindow(false)
end
