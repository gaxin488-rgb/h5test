-- --------------------------------------------------------------------
-- 通用的规则说明面板,只需要传固定格式的就行了
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-xx-xx
-- --------------------------------------------------------------------
DungeonAbyssDifficultyReward =  DungeonAbyssDifficultyReward or BaseClass(BaseView)

function DungeonAbyssDifficultyReward:__init()
    self.ctrl = DungeonAbyssController:getInstance()
    self.model = self.ctrl:getModel()
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "dungeon_abyss/dungeon_abyss_difficulty_reward"
    self.cache_list = {}
    self.height_list = {}
    self.title_str = TI18N("语言_c_625")
end

function DungeonAbyssDifficultyReward:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.container = self.root_wnd:getChildByName("container")
    -- self:playEnterAnimatianByObj(self.container)
    self.close_btn = self.container:getChildByName("close_btn")
    self.scroll_view = self.container:getChildByName("scroll_view")
    self.scroll_view:setScrollBarEnabled(false)
    self.scroll_width = self.scroll_view:getContentSize().width
    self.scroll_height = self.scroll_view:getContentSize().height
    self.Image_2 = self.container:getChildByName("Image_2")
    self.win_title = self.container:getChildByName("win_title")
    self.win_title:setString(self.title_str)
    self.Image_2:setContentSize(cc.size(self.win_title:getContentSize().width + 120,self.Image_2:getContentSize().height))
end

function DungeonAbyssDifficultyReward:register_event()
    self.background:addTouchEventListener(
        function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                self.ctrl:openDungeonAbyssDifficultyReward(false)
            end
        end
    )

    self.close_btn:addTouchEventListener(
        function(sender, event_type)
            customClickAction_2(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                playCloseSound()
                self.ctrl:openDungeonAbyssDifficultyReward(false)
            end
        end
    )
end

function DungeonAbyssDifficultyReward:openRootWnd(id)
    self.max_height = 0
    self:setDataList(id)
end

function DungeonAbyssDifficultyReward:setDataList(id)
    self.cfg = Config.DungeonAbyssCircleData.data_diff_data[id]
    -- for i=1,4 do
    --     delayRun(
    --         self.container, i / display.DEFAULT_FPS, function()
    --             self:createList(i)
    --         end
    --     )
    -- end
    self:createList(id)
end
function DungeonAbyssDifficultyReward:creatPanel()
    local _height = 0
    for key, value in pairs(self.height_list) do
        _height = _height + value
    end
    local max_height = math.max(_height+45, self.scroll_height)
    self.scroll_view:setInnerContainerSize(cc.size(self.scroll_width, max_height))
    local off_y = 0
    for i,v in ipairs(self.cache_list) do
        v:setPosition(8, max_height-off_y)
        off_y = off_y + v:getContentSize().height + 15
    end
end
function DungeonAbyssDifficultyReward:createList(index)
    local container, height = self:createTitleContent(index)
    self.scroll_view:addChild(container)
    table.insert(self.cache_list, container)
    table.insert(self.height_list, height)
    -- if tableLen(self.height_list) == 4 then
        self:creatPanel()
    -- end
end

function DungeonAbyssDifficultyReward:createTitleContent(index)
    local container = ccui.Widget:create()
    container:setAnchorPoint(cc.p(0, 1))
    container:setCascadeOpacityEnabled(true)
    local cfg = Config.DungeonAbyssCircleData.data_diff_data[index]
    local res = PathTool.getResFrame("common", "common_90025")
    local bg = createScale9Sprite(res, 0, 0,LOADTEXT_TYPE_PLIST, container)
    bg:setAnchorPoint(cc.p(0, 1))
    local _height = 0
    local title_name = createRichLabel(30, cc.c4b(0xf1,0xe2,0xc7,0xff), cc.p(0,1), cc.p(0,0),nil,nil,600)
    container:addChild(title_name)
    title_name:setString(cfg.name)
    bg:setContentSize(cc.size(self.scroll_width,title_name:getContentSize().height+6))
    _height = _height + bg:getContentSize().height + 10
    local tip_list = {}
    for i=1,tableLen(cfg.desc) do
        local txt_list = cfg.desc[i]
        local tips = createRichLabel(20, cc.c4b(0x7c,0x55,0x36,0xff), cc.p(0,1), cc.p(0,0),-4,nil,600)
        container:addChild(tips)
        tips:setString(txt_list[2])
        _height = _height + tips:getContentSize().height + 10
        tip_list[txt_list[1]] = tips
    end
    local container_list = {}
    for i=1,tableLen(cfg.reward) do
        local reward_list = cfg.reward[i]
        local list = {}
        if index == 4 then
            list = reward_list[2]
        elseif index == 3 then
            list = reward_list[2]
        elseif index == 2 then
            list = reward_list[2]
        elseif index == 1 then
            list = reward_list[2]
        end
        if tableLen(list) ~= 0 then
            local list_container = ccui.Widget:create()
            list_container:setAnchorPoint(cc.p(0, 1))
            list_container:setCascadeOpacityEnabled(true)
            list_container:setContentSize(cc.size(self.scroll_width, 120*0.8))
            container:addChild(list_container)
            _height = _height + 125
            local reward_view = nil
            if reward_view == nil then
                local scroll_view_size = list_container:getContentSize()
                local setting = {
                    item_class = BackPackItem,      -- 单元类
                    start_x = 0,                  -- 第一个单元的X起点
                    space_x = 10,                    -- x方向的间隔
                    start_y = 0,                    -- 第一个单元的Y起点
                    space_y = 10,                   -- y方向的间隔
                    item_width = 119 * 0.8,               -- 单元的尺寸width
                    item_height = 119 * 0.8,              -- 单元的尺寸height
                    row = 1,                        -- 行数，作用于水平滚动类型
                    col = 0,
                    scale = 0.8
                }
                reward_view = CommonScrollViewLayout.new(list_container, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
                reward_view:setSwallowTouches(false)
                reward_view:setData(list)
            end
            list_container:setPositionY(120*0.8 + 6)
            reward_view:addEndCallBack(function()
                local list = reward_view:getItemList()
                for k,v in pairs(list) do
                    v:setDefaultTip()
                end
            end)
            container_list[reward_list[1]] = list_container
        end
    end
    local _h = deepCopy(_height)
    bg:setPositionY(_height)
    title_name:setPositionY(bg:getPositionY() - 3)
    -- tips:setPositionY(_height - bg:getContentSize().height - 5)
    _height = _height - bg:getContentSize().height - 5
    for i=1,tableLen(tip_list) do
        tip_list[i]:setPositionY(_height)
        _height = _height - tip_list[i]:getContentSize().height - 10
        if container_list[i] then
            container_list[i]:setPositionY(_height - 20)
        end
        _height = _height - 125
    end
    container:setContentSize(cc.size(self.scroll_width, _h))
    return container,_h
end

function DungeonAbyssDifficultyReward:close_callback()
    self.ctrl:openDungeonAbyssDifficultyReward(false)
end