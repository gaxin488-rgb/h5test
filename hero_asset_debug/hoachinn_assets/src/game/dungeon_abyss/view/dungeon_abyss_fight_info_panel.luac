DungeonAbyssFightInfoPanel = DungeonAbyssFightInfoPanel or BaseClass(BaseView)

local controller = DungeonAbyssController:getInstance()
local model = controller:getModel()

function DungeonAbyssFightInfoPanel:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.is_full_screen = false
    self.win_type = WinType.Big
    self.layout_name = "dungeon_abyss/dungeon_abyss_fight_info_panel"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("planes", "planes_map"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("planes", "planes_info"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("planes","big_bg_2"), type = ResourcesType.single},
        {path = PathTool.getPlistImgForDownLoad("planes","big_bg_3"), type = ResourcesType.single},
    }
    self.hero_data = {}
    self.team_index = 1
    self.fun_form_type = PartnerConst.Fun_Form.DungeonAbyss
end

function DungeonAbyssFightInfoPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    self.image_title = self.main_container:getChildByName("image_title")
    self.win_title = self.main_container:getChildByName("win_title")
    local hero_panel=self.main_container:getChildByName("hero_panel")
    self.hero_img=hero_panel:getChildByName("hero_img")
    self.record_img = self.main_container:getChildByName("record_img")
    self.record_img:getChildByName("name_txt_1"):setString(TI18N("语言_c_5208"))   
    self.record_img:setVisible(false)
    self.tips_txt = self.main_container:getChildByName("tips_txt")
    self.tips_txt:setString(transformTextToShort(TI18N("语言_c_5209"), 80))
    self.tips_txt:setTouchEnabled(true)
    addEvt2showAllTextTips(self.tips_txt,TI18N("语言_c_5209"),80)
    self.dunlist={}
    self.top_panel = self.main_container:getChildByName("top_panel")
    self.top_panel:setScrollBarEnabled(false)
    self.line=self.top_panel:getChildByName("bottom_bg")
    self.linWid=self.line:getContentSize().width 
    self.orginx=self.top_panel:getPositionX()
    local desc_bg = self.main_container:getChildByName("desc_bg")
    local left_bg_1 = self.main_container:getChildByName("left_bg_1")
    left_bg_1:setVisible(false)
    local right_bg_1 = self.main_container:getChildByName("right_bg_1")
    right_bg_1:setVisible(false)
    loadSpriteTexture(left_bg_1, PathTool.getPlistImgForDownLoad("planes","big_bg_3"), LOADTEXT_TYPE)
    loadSpriteTexture(right_bg_1, PathTool.getPlistImgForDownLoad("planes","big_bg_2"), LOADTEXT_TYPE)

    self.left_role_panel = self.main_container:getChildByName("panel_role_left")
    self.left_role_panel:setVisible(false)
    local panel_size = self.left_role_panel:getContentSize()
    --9位置
    self.left_position_list = {}
    self.left_bg_list = {}
    self.left_hero_list = {}
    for i=1,9 do
        local item_bg = self.left_role_panel:getChildByName("pos_bg_" .. i)
        local pos_x, pos_y = item_bg:getPosition()
        table.insert(self.left_position_list, cc.p(pos_x, pos_y - 5))
        table.insert(self.left_bg_list, item_bg)
        item_bg:setVisible(false)
    end
    local pos = {2,4,6,7,9,3} --
    for index=1,6 do
        self.left_hero_list[index] = HeroExhibitionItem.new(0.6, true)
        self.left_hero_list[index]:setPosition(self.left_position_list[pos[index]])
        self.left_role_panel:addChild(self.left_hero_list[index])
        self.left_bg_list[pos[index]]:setVisible(true)
    end
    self.right_role_panel = self.main_container:getChildByName("panel_role_right")
    self.right_role_panel:setVisible(false)
    self.right_position_list = {}
    self.right_bg_list = {}
    self.right_hero_list = {}
    for i=1,9 do
        local item_bg = self.right_role_panel:getChildByName("pos_bg_" .. i)
        local pos_x, pos_y = item_bg:getPosition()
        table.insert(self.right_position_list, cc.p(pos_x, pos_y - 5))
        table.insert(self.right_bg_list, item_bg)
        item_bg:setVisible(false)
    end

    -- 精灵
    self.tree_lv_left = self.main_container:getChildByName("tree_lv_left")
    self.tree_lv_left:setVisible(false)
    self.tree_lv_right = self.main_container:getChildByName("tree_lv_right")
    self.tree_lv_right:setVisible(false)
    self.left_elfin_item_list = {}
    self.right_elfin_item_list = {}

    --reward
    self.main_container:getChildByName("award_txt"):setString(TI18N("语言_c_11"))
    self.reward_panel = self.main_container:getChildByName("reward_panel")
    local panel_size = self.reward_panel:getContentSize()
    local scroll_view_size = cc.size(panel_size.width, panel_size.height+10)
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 15,                    -- x方向的间隔
        start_y = 10,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.8,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.8,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.8
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.reward_panel, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.btn_embattle = self.main_container:getChildByName("btn_embattle")
    self.btn_embattle:getChildByName("label"):setString(TI18N("语言_c_1389"))
    self.btn_embattle:setName("battle_btn")

    --top 
    self.award_bg_1 = self.main_container:getChildByName("award_bg_1")
    local label_title = self.award_bg_1:getChildByName("label_title")
    label_title:setString(TI18N("语言_c_161"))
    self.hero_items = {}
    for index=1,6 do
        local node_hero = self.award_bg_1:getChildByName("node_hero"..index)
        self.right_hero_list[index] = HeroExhibitionItem.new(0.6, true)
        -- self.right_hero_list[index]:setPosition(self.right_position_list[pos[index]])
        node_hero:addChild(self.right_hero_list[index])
        self.hero_items[index] = node_hero
        self.right_hero_list[index]:setVisible(false)
    end
    --center
    self.award_bg_2 = self.main_container:getChildByName("award_bg_2")
    local label_title = self.award_bg_2:getChildByName("label_title")
    label_title:setString(TI18N("语言_c_2511"))
    self.label_tab_title1 = self.award_bg_2:getChildByName("label_tab_title1")
    self.label_tab_title1:setString(TI18N("语言_dun_aby_c_11"))
    self.label_des = self.award_bg_2:getChildByName("label_des")

    self.label_tab_title2 = self.award_bg_2:getChildByName("label_tab_title2")
    self.label_tab_title2:setString(TI18N("语言_dun_aby_c_12"))

    self.image_star_bg1 = self.award_bg_2:getChildByName("image_star_bg1")
    self.image_star_bg1.image_star = self.image_star_bg1:getChildByName("image_star")
    self.image_star_bg2 = self.award_bg_2:getChildByName("image_star_bg2")
    self.image_star_bg2.image_star = self.image_star_bg2:getChildByName("image_star")
    self.image_star_bg3 = self.award_bg_2:getChildByName("image_star_bg3")
    self.image_star_bg3.image_star = self.image_star_bg3:getChildByName("image_star")
    self.label_star_des1 = self.award_bg_2:getChildByName("label_star_des1")
    self.label_star_des1:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des1,-10)
    self.label_star_des1:setString(Config.DungeonAbyssCircleData.data_star_cond[1001].type)
    self.label_star_des2 = self.award_bg_2:getChildByName("label_star_des2")
    self.label_star_des2:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des2,-10)
    self.label_star_des2:setString(Config.DungeonAbyssCircleData.data_star_cond[2001].type)
    self.label_star_des3 = self.award_bg_2:getChildByName("label_star_des3")
    self.label_star_des3:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des3,-10)
    self.label_star_des3:setString(Config.DungeonAbyssCircleData.data_star_cond[3001].type)
    self.star_list = {}
    for i = 1, 3, 1 do
        local image_star_bg = self.award_bg_2:getChildByName("image_star_bg"..i)
        image_star_bg.image_star = image_star_bg:getChildByName("image_star")
        image_star_bg.label_star_des = self.award_bg_2:getChildByName("label_star_des"..i)
        self.star_list[#self.star_list + 1] = image_star_bg
    end

    self.close_btn = self.main_container:getChildByName("close_btn")
end
function DungeonAbyssFightInfoPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.main_container, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickCloseBtn), false, 2)
    registerButtonEventListener(self.btn_embattle, handler(self, self.onClickEmbattleBtn), true)
    if self.update_form_event == nil then
		self.update_form_event = GlobalEvent:getInstance():Bind(RoleEvent.UPDATE_MORE_TEAM_LINEUP_EVENT, function(data)
			self.hero_data = deepCopy(data.formations)
            self:updateHeroData()
		end)
	end
    self.record_img:addTouchEventListener(function(sender, event_type) 
        customClickAction_2(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            sender.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if sender.touch_began ~= nil then
                is_click =
                    math.abs(sender.touch_end.x - sender.touch_began.x) <= 20 and
                    math.abs(sender.touch_end.y - sender.touch_began.y) <= 20
            end
            if is_click == true then
                playButtonSound2()
                if self.data then
                    controller:sender11352(self.data.lev, true)
                end
            end
        elseif event_type == ccui.TouchEventType.began then
            sender.touch_began = sender:getTouchBeganPosition()
        end
    end)
end

function DungeonAbyssFightInfoPanel:onClickEmbattleBtn()
    if self.data.type == 2 then
        if DungeonAbyssController:getInstance():getModel():checkIsEnd() then
            message(TI18N("语言_c_5434"))
            return
        end
    end
    for key, value in pairs(self.hero_data) do
        local sub_id=value.order
        --更新池子
        local data_list = value.pos_info
        for __, info in pairs(data_list) do
            local hero_id = info.id
            local hero_vo = HeroController:getInstance():getModel():getHeroById(hero_id)
            if hero_vo then
                hero_vo.point_id = sub_id
                hero_vo.is_ui_select = true
            end
        end
    end
    local setting = {
        data = {
            lev = self.data.lev,
            index = self.team_index,
            type = self.data.type,
        }
    }
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.DungeonAbyss,setting)
end

function DungeonAbyssFightInfoPanel:onClickCloseBtn()
    controller:openDungeonAbyssFightInfoPanel(false)
end

function DungeonAbyssFightInfoPanel:updateHeroData()
    for i = 1, tableLen(self.dunlist) do
        for k, v in pairs(self.hero_data) do
            if v.order == i then
                local num=0
                for key, value in pairs(v.pos_info) do
                    num=num+1
                end
                self.dunlist[i]:setData(i,num)
            end
        end
    end
    self:UpdateHero(self.team_index)
end

function DungeonAbyssFightInfoPanel:openRootWnd(data)
    self.data = data
    self:CreateDunBtn()
    self:onClickDunBtn(self.team_index)
    -- local form_data = RoleController:getInstance():getModel():getRoleForm(PartnerConst.Fun_Form.DungeonAbyss)
    -- if form_data and form_data.formations then
    --     self.hero_data = deepCopy(form_data.formations)
    --     self:updateHeroData()
    -- else
        RoleController:getInstance():sender16823(PartnerConst.Fun_Form.DungeonAbyss)
    -- end
    self:updateAward()
    local path= string.format("resource/partner/%d.png", self.data.show[1])
    self.hero_img:loadTexture(path, LOADTEXT_TYPE)
    self.win_title:setString(string.format(self.data.gr_name or "%s",self.data.lev))
    autoSizeTitleBg(self.win_title, self.image_title)

    self.label_tab_title1:setString(string.format(TI18N("语言_dun_aby_c_11"), self.data.lev))
    local skill_cfg = Config.SkillData.data_get_skill(self.data.skill)
    setTextMaxWidth(self.label_des,550,-10)
    self.label_des:setString(TI18N(skill_cfg.des))

    --star
    local info = model:getDunInfoById(self.data.type, self.data.lev)

    local complete = {}
    if info then
        for i, v in ipairs(info.star_info) do
            complete[v.star_id] = v.flag == 1
        end
    else
    end
    for i, v in ipairs(self.star_list) do
        if complete[i] then
            v.image_star:setVisible(complete[i])
            v.label_star_des:setTextColor(cc.c3b(0x0e, 0xa8, 0x0e))
        else
            v.image_star:setVisible(false)
            v.label_star_des:setTextColor(cc.c3b(0x7c, 0x55, 0x36))
        end
    end
end

function DungeonAbyssFightInfoPanel:CreateDunBtn()
    self.dunlist={}
    local cfg = deepCopy(self.data.unit_id)
    -- table.sort(cfg,function(a,b) return a[1] < b[1] end)
    local len=#cfg
    local startX=80
    local wid= self.linWid-(5-len)*100 
    local offx = 0
    if wid < self.linWid then
        offx = (self.linWid - wid)/2
    end
    for i=1,len do
        local btn=DungeonAbyssFightTeamTab.new()
        btn:setAnchorPoint(cc.p(0.5,0.5))
        self.top_panel:addChild(btn)
        btn:setPosition(offx + startX+(i-1)*100,30)
        registerButtonEventListener(btn.container, function()
            self:onClickDunBtn(i)
        end ,true, 2, nil, nil, nil, true)
        btn.container:setSwallowTouches(false)
        self.dunlist[i]=btn
    end
    self.line:setContentSize(cc.size(wid,self.line:getContentSize().height))
    self.line:setPositionX(offx)
    -- self.top_panel:setPositionX(self.orginx+(5-len)*50)
    if wid < self.linWid then
        wid = self.linWid
    end
    self.top_panel:setInnerContainerSize(cc.size(wid,self.top_panel:getContentSize().height))
end

function DungeonAbyssFightInfoPanel:onClickDunBtn(index)
    for i=1,#self.dunlist do
        self.dunlist[i]:setStatus(i==index)
    end
    -- self.info.sub_id=index
    -- if not self.QueueData then
    --     controller:sender13235(self.info.chapter_id, self.info.dun_id,index)
    -- else
    --     self:setData()
    -- end 
    self.team_index = index
    self:UpdateUnit(index)
    self:UpdateHero(index)
end

function DungeonAbyssFightInfoPanel:UpdateHero(index)
    for k, v in pairs(self.left_bg_list) do
        v:setVisible(false)
    end
    local data = {}
    for k, v in pairs(self.hero_data) do
        if v.order == index then
            data = deepCopy(v)
        end
    end
    for i = 1, 6 do
        local item = self.left_hero_list[i]
        local id = 0
        if data.pos_info then
            for k, v in pairs(data.pos_info) do
                if v.pos == i then
                    id = v.id
                end
            end
        end
        local pos = self:getFormPosByIndex(data.formation_type,i)
        local hero_vo = HeroController:getInstance():getModel():getHeroById(id)
        if hero_vo and next(hero_vo) then
            item:setVisible(true)
            item:setData(hero_vo)
            item:setPosition(self.left_position_list[pos])
        else
            item:setVisible(false)
        end
        self.left_bg_list[pos]:setVisible(true)
    end
end

function DungeonAbyssFightInfoPanel:UpdateUnit(index)
    for k, v in pairs(self.right_bg_list) do
        v:setVisible(false)
    end
    local unit_id = self.data.unit_id[index]
    local unit_cfg = Config.UnitData.data_unit(unit_id)
    local form_cfg = deepCopy(Config.FormationData.data_form_data[unit_cfg.formation[1]].pos)
    if table.indexof(PartnerConst.Fun_six_Type, self.fun_form_type) then
        form_cfg = deepCopy(Config.FormationData.data_six_form_data[unit_cfg.formation[1]].pos)
    end
    table.sort(form_cfg,function(a,b) return a[1] < b[1] end)
    for i = 1, 6 do
        local item = self.right_hero_list[i]
        local id = unit_cfg["monster"..i]
        local pos = self:getFormPosByIndex(unit_cfg.formation[1],i)
        if id then
            item:setVisible(true)
            local cfg = Config.UnitData.data_unit(id)
            if cfg then
                local unit_data = {
                    bid = cfg.bid,
                    lev = cfg.lev,
                    star = cfg.star}
                item:setMonsterData(unit_data)
                -- item:setPosition(self.right_position_list[pos])
            else
                item:setVisible(false)
            end
        else
            item:setVisible(false)
        end
        -- self.right_bg_list[pos]:setVisible(true)
        -- self.hero_items[i]:setVisible(true)
    end

end

function DungeonAbyssFightInfoPanel:setData()
    -- for i=1,#self.dunlist do
    --     local list=model:getSubHerolist(i)
    --     local num=0
