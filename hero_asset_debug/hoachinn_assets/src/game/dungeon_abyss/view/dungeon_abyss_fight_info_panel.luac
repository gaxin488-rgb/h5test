end
-- 根据阵法类型和index，获取对应的位置
function DungeonAbyssFightInfoPanel:getFormPosByIndex( form_type, index )
    local pos = 1
    local formation_config = Config.FormationData.data_form_data[form_type]
    if table.indexof(PartnerConst.Fun_six_Type, self.fun_form_type) then
        formation_config = deepCopy(Config.FormationData.data_six_form_data[form_type])
    end
    if formation_config then
        for k,v in pairs(formation_config.pos) do
            if v[1] == index then
                pos = v[2]
                break
            end
        end
    end
    return pos
end

function DungeonAbyssFightInfoPanel:updateAward()
    local list = {}
    for k, v in pairs(self.data.f_award) do
        local data = {}
		data[1] = v[1]
		data[2] = v[2]
		table.insert(list, data)
    end
    self.item_scrollview:setData(list)
    local info = model:getDunInfoById(self.data.type, self.data.lev)
	self.item_scrollview:addEndCallBack(function()
        local item_list = self.item_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
			v:setSwallowTouches(false)
			v:setGotIcon(false)
            if info then
                v:setReceivedIcon(true)
            else
                v:setReceivedIcon(false)
            end
        end
	end)
end

function DungeonAbyssFightInfoPanel:close_callback()
    -- HeroController:getInstance():getModel():setBossFormPoint()
    if self.update_form_event then
		GlobalEvent:getInstance():UnBind(self.update_form_event)
		self.update_form_event = nil
	end
    for i, v in ipairs(self.dunlist) do
        if v and not tolua.isnull(v) then
            v:DeleteMe()
        end
    end
    self.dunlist = nil
    controller:openDungeonAbyssFightInfoPanel(false)
end

-- --------------------------------------------------------------------
DungeonAbyssFightTeamTab = class('DungeonAbyssFightTeamTab',function()
        return ccui.Layout:create()
    end
)
DungeonAbyssFightTeamTab.WIDTH = 55
DungeonAbyssFightTeamTab.HEIGHT = 58
function DungeonAbyssFightTeamTab:ctor()
    self.size = size or cc.size(DungeonAbyssFightTeamTab.WIDTH, DungeonAbyssFightTeamTab.HEIGHT)
    self:setContentSize(self.size)
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB('dungeon_abyss/dungeon_abyss_fight_team_tab'))
    self:addChild(self.root_wnd)
    self.container = self.root_wnd:getChildByName('container')
    self.chose_img = self.container:getChildByName("chose_img")
    self.chose_img:setVisible(false)
    self.num_txt = self.container:getChildByName("num_txt")
    self:setTouchEnabled(true)
    self.item_list = {}
    for i=1,5 do
        local item=self.container:getChildByName("img_"..i)
        item:setVisible(false)
        table.insert(self.item_list,item)
    end
    -- self:registerEvent()
end

function DungeonAbyssFightTeamTab:registerEvent()

end

function DungeonAbyssFightTeamTab:setData(sub_id,num)
    self.num_txt:setString(sub_id)
    for i=1,5 do
        self.item_list[i]:setVisible(i<=num) 
    end
end

function DungeonAbyssFightTeamTab:setStatus(status)
    self.chose_img:setVisible(status)
end
function DungeonAbyssFightTeamTab:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end
