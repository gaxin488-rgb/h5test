DungeonAbyssDes = DungeonAbyssDes or BaseClass(BaseView)
local table_insert = table.insert
function DungeonAbyssDes:__init(type, diff)
    self.ctrl = DungeonAbyssController:getInstance()
    self.is_full_screen = false
    self.layout_name = "dungeon_abyss/dungeon_abyss_des"
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("startower","startower"), type = ResourcesType.plist },
    }
   self.item_list = {}
   self.win_type = WinType.Big
   self.cur_type = type or 1
   self.diff = diff or 1
end

function DungeonAbyssDes:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_panel = self.root_wnd:getChildByName("main_panel")    
    self:playEnterAnimatianByObj(self.main_panel, 1)
    self.bg = self.main_panel:getChildByName("bg")
    self.title_bg = self.main_panel:getChildByName("title_bg")
    self.title = self.main_panel:getChildByName("title")

    self.buff_panel = self.main_panel:getChildByName("buff_panel")
    self.skill_panel = self.main_panel:getChildByName("skill_panel")
    self.skill_panel:setVisible(false)
    self.target_panel = self.main_panel:getChildByName("target_panel")
    self.item_panel = self.main_panel:getChildByName("item_panel")
    self.award_panel = self.item_panel:getChildByName("award_panel")
    self.reward_panel = self.award_panel:getChildByName("reward_panel")
    self.reward_panel:setScrollBarEnabled(false)
    
    self.close_btn = self.main_panel:getChildByName("close_btn")

    local label  =self.award_panel:getChildByName("label")
    label:setString(TI18N("语言_dun_aby_c_10"))

    self.image_bg5 = self.buff_panel:getChildByName("image_bg5")
    self.image_bg1 = self.buff_panel:getChildByName("image_bg1")
    self.image_bg2 = self.buff_panel:getChildByName("image_bg2")
    self.label_tab_title1 = self.buff_panel:getChildByName("label_tab_title1")
    self.label_tab_title1:setString(TI18N("语言_dun_aby_c_11"))
    self.label_des = self.buff_panel:getChildByName("label_des")


    self.skill_scroll = self.skill_panel:getChildByName("skill_scroll")
    self.skill_scroll:setScrollBarEnabled(false)
    self.skill_des = self.skill_scroll:getChildByName("skill_des")
    self.skill_line_1 = self.skill_panel:getChildByName("skill_line_1")
    self.skill_line_2 = self.skill_panel:getChildByName("skill_line_2")
    self.skill_title_bg = self.skill_panel:getChildByName("skill_title_bg")
    self.skill_title = self.skill_panel:getChildByName("skill_title")
    self.skill_title:setString(TI18N("语言_c_7165"))
    moveTextBg(self.skill_title,self.skill_title_bg,15,225)
    setLeftRightImg(self.skill_line_1,self.skill_title,self.skill_line_2,30)

    self.image_bg6 = self.target_panel:getChildByName("image_bg6")
    self.image_bg3 = self.target_panel:getChildByName("image_bg3")
    self.image_bg4 = self.target_panel:getChildByName("image_bg4")
    self.label_tab_title2 = self.target_panel:getChildByName("label_tab_title2")
    self.label_tab_title2:setString(TI18N("语言_dun_aby_c_12"))
    moveTextBg(self.label_tab_title2,self.image_bg6,15,225)
    setLeftRightImg(self.image_bg3,self.label_tab_title2,self.image_bg4,30)

    self.image_star_bg1 = self.target_panel:getChildByName("image_star_bg1")
    self.image_star_bg1.image_star = self.image_star_bg1:getChildByName("image_star")
    self.image_star_bg2 = self.target_panel:getChildByName("image_star_bg2")
    self.image_star_bg2.image_star = self.image_star_bg2:getChildByName("image_star")
    self.image_star_bg3 = self.target_panel:getChildByName("image_star_bg3")
    self.image_star_bg3.image_star = self.image_star_bg3:getChildByName("image_star")
    self.label_star_des1 = self.target_panel:getChildByName("label_star_des1")
    self.label_star_des1:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des1,-10)
    self.label_star_des1:setString(Config.DungeonAbyssCircleData.data_star_cond[1001].type)
    self.label_star_des2 = self.target_panel:getChildByName("label_star_des2")
    self.label_star_des2:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des2,-10)
    self.label_star_des2:setString(Config.DungeonAbyssCircleData.data_star_cond[2001].type)
    self.label_star_des3 = self.target_panel:getChildByName("label_star_des3")
    self.label_star_des3:setChangeScaleOffWidth(146)
    setTextSpacing(self.label_star_des3,-10)
    self.label_star_des3:setString(Config.DungeonAbyssCircleData.data_star_cond[3001].type)
    self.star_list = {}
    for i = 1, 3, 1 do
        local image_star_bg = self.target_panel:getChildByName("image_star_bg"..i)
        image_star_bg.image_star = image_star_bg:getChildByName("image_star")
        image_star_bg.label_star_des = self.target_panel:getChildByName("label_star_des"..i)
        self.star_list[#self.star_list + 1] = image_star_bg
    end
    self.image_go = self.main_panel:getChildByName("image_go")
    self.image_go:getChildByName("label"):setString(TI18N("语言_dun_aby_c_13"))

    self.label_complete = self.main_panel:getChildByName("label_complete")
    self.label_complete:setString(TI18N("语言_dun_aby_c_14"))

    self.record_btn = self.main_panel:getChildByName("record_btn")
end

function DungeonAbyssDes:register_event()
    self.close_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self.ctrl:openDungeonAbyssDes(false)
        end
    end)
    self.background:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self.ctrl:openDungeonAbyssDes(false)
        end
    end)

    self.image_go:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            -- if self.cur_type == 2 then
            --     if self.ctrl:getModel():checkIsEnd() then
            --         message(TI18N("语言_c_5434"))
            --         return
            --     end
            -- end
            local now_index = self.ctrl:getModel():getNowTowerId(self.cur_type)
            if self.data.index > now_index + 1 then
                message(TI18N("语言_c_4095"))
                return
            end
            local _config = nil
            if self.cur_type == 2 then
                local group_id = self.ctrl:getModel():getAdvanceGroupId()
                local diff_id = self.ctrl:getModel():getAdvanceDiff()
                _config = Config.DungeonAbyssCircleData.data_dif_challenge_data[group_id][diff_id]
            else
                _config = Config.DungeonAbyssCircleData.data_nor_challenge_data
            end
            local data = clone(_config[self.data.index])
            data.type = self.cur_type
            data.lev = data.id or data.dun_id
            self.ctrl:openDungeonAbyssFightInfoPanel(true, data)
            self.ctrl:openDungeonAbyssDes(false)
        end
    end)

    self.record_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playCloseSound()
            self.ctrl:sender22506(self.cur_type, self.data.index)
        end
    end)
end
function DungeonAbyssDes:updateDesc()
    -- print("--------------------------- updateDesc", vardump(self.data))
    local cfg = nil
    if self.cur_type == 2 then
        local group_id = self.ctrl:getModel():getAdvanceGroupId()
        local diff_id = self.ctrl:getModel():getAdvanceDiff()
        cfg = Config.DungeonAbyssCircleData.data_dif_challenge_data[group_id][diff_id][self.data.index]
        self.record_btn:setVisible(true)
        setTextMaxWidth(self.label_des, 500)
    else
        cfg = Config.DungeonAbyssCircleData.data_nor_challenge_data[self.data.index]
        self.record_btn:setVisible(false)
        setTextMaxWidth(self.label_des, 550)
    end
    local skill_cfg = Config.SkillData.data_get_skill(cfg.skill)
    if skill_cfg then
        self.label_des:setString(TI18N(skill_cfg.des))
        self.title:setString(TI18N((cfg.gr_name or "")))
    end

    -- self.label_tab_title1:setString(string.format(TI18N("语言_dun_aby_c_11"), self.data.index))
    moveTextBg(self.label_tab_title1,self.image_bg5,15,225)
    setLeftRightImg(self.image_bg1,self.label_tab_title1,self.image_bg2,30)

    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list = nil
    local expend_list = {}

    for i,v in pairs( cfg.f_award) do
        table_insert(expend_list,v)
    end
    local info = self.ctrl:getModel():getDunInfoById(self.cur_type, self.data.index)
    
    --star
    local complete = {}
    local status = false
    if info then
        status = true
        for i, v in ipairs(info.star_info) do
            complete[v.star_id] = v.flag == 1
        end
        self.label_complete:setVisible(false)--(info.star >= 3)
        self.image_go:setVisible(true)--(info.star < 3)
    else
        self.label_complete:setVisible(false)
        self.image_go:setVisible(true)
    end
    local setting = {}
    setting.scale = 1
    setting.space_x = 10
    setting.max_count = 4
    setting.is_center = true
    setting.is_get_status = status
    setting.get_status_res = PathTool.getResFrame("common","common_1000")
    self.item_list = commonShowSingleRowItemList(self.reward_panel, self.item_list, expend_list, setting)
    for i, v in ipairs(self.star_list) do
        if complete[i] then
            v.image_star:setVisible(complete[i])
            v.label_star_des:setTextColor(cc.c3b(0x0e, 0xa8, 0x0e))
        else
            v.image_star:setVisible(false)
            v.label_star_des:setTextColor(cc.c3b(0x7c, 0x55, 0x36))
        end
    end
    self:updateSkillPanel()
end

function DungeonAbyssDes:updateSkillPanel()
    if self.cur_type == 2 then
        local group_id = self.ctrl:getModel():getAdvanceGroupId()
        local diff_id = self.ctrl:getModel():getAdvanceDiff()
        local cfg = Config.DungeonAbyssCircleData.data_dif_challenge_data[group_id][diff_id][self.data.index]
        if cfg and cfg.monster_skills and cfg.monster_skills[1] then
            self.skill_panel:setVisible(true)
            local txt = ""
            local skill_cfg = Config.SkillData.data_get_skill(cfg.monster_skills[1])
            txt = skill_cfg.des
            -- for i,v in ipairs(cfg.monster_skills) do
            --     local skill_cfg = Config.SkillData.data_get_skill(v)
            --     if txt == "" then
            --         txt = txt .. skill_cfg.des
            --     else
            --         txt = txt .. "\n" .. skill_cfg.des
            --     end
            -- end
            self.skill_des:setString(txt)
            local _h = math.max(self.skill_des:getContentSize().height,self.skill_scroll:getContentSize().height)
            self.skill_scroll:setTouchEnabled(_h > self.skill_scroll:getContentSize().height)
            self.skill_scroll:setInnerContainerSize(cc.size(self.skill_scroll:getContentSize().width,_h))
            self.skill_des:setPositionY(_h)
        else
            self.skill_panel:setVisible(false)
        end
    else
        self.skill_panel:setVisible(false)
    end
    self:updatePage()
end
function DungeonAbyssDes:updatePage()
    local _h = 739
    if self.skill_panel:isVisible() then
        _h = _h + self.skill_panel:getContentSize().height
        self.main_panel:setContentSize(cc.size(self.main_panel:getContentSize().width,_h))
        self.bg:setContentSize(cc.size(self.bg:getContentSize().width,_h))
        self.bg:setPositionY(_h*0.5)
        self.title_bg:setPositionY(_h-13)
        self.buff_panel:setPositionY(_h-69)
        self.skill_panel:setPositionY(_h-224)
        -- self.target_panel:setPositionY(515)
        -- self.item_panel:setPositionY(315)
        self.close_btn:setPositionY(_h-19)
        self.title:setPositionY(_h-9)
        -- self.image_go:setPositionY(68)
        -- self.label_complete:setPositionY(68)
        self.record_btn:setPositionY(_h - 139)
    end
end
function DungeonAbyssDes:openRootWnd(data)
    self.data = data or {index = 1}
    self:updateDesc()
end

--[[
    @desc: 设置标签页面板数据内容
    author:{author}
    time:2018-05-03 21:57:09
    return
]]
function DungeonAbyssDes:setPanelData()
end

function DungeonAbyssDes:close_callback()
    self.ctrl:openDungeonAbyssDes(false)
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list = nil
    if self.video_data_event then
        GlobalEvent:getInstance():UnBind(self.video_data_event)
        self.video_data_event = nil
    end
end
