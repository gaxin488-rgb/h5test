function DungeonAbyssMainWindow:changeTowerType()
    local type = self.cur_type
    if type == 1 then
        if not self.ctrl:getModel():checkAdvanceIsOpen() then
            message(TI18N("语言_dun_aby_c_15"))
            return
        end
        if not self.ctrl:getModel():checkIsChooseDifDone() then
            self.ctrl:openDungeonAbyssChooseDifficultyPanel(true)
            return
        end
        self.cur_type = 2
    else
        self.cur_type = 1
    end
    self:starTowerShowAward()
    self:updateTowerList()
    self:updatePage()
end

--设置倒计时
function DungeonAbyssMainWindow:setEnterTime(status)
    if tolua.isnull(self.label_time) then return end
    doStopAllActions(self.label_time)
    local end_time = self.ctrl:getModel():getEndtime() - GameNet:getInstance():getTime()
    if status then
        if end_time > 0 then
            self:setTimeFightString(end_time)
            self.label_time:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1), cc.CallFunc:create(function()
                end_time = end_time - 1
                self:setTimeFightString(end_time)
                if end_time <= 0 then
                    doStopAllActions(self.label_time)
                end
            end))))
        else
            doStopAllActions(self.label_time)
            self:setTimeFightString(0)
        end
    else
        doStopAllActions(self.label_time)
    end
end

function DungeonAbyssMainWindow:setTimeFightString(less_time)
    if less_time > 0 then
        local str = string_format(TI18N("语言_c_4605"), TimeTool.GetTimeForFunction(less_time))
        self.label_time.label_value:setString(TimeTool.GetTimeForFunction(less_time))
    else
        self.label_time.label_value:setString(TI18N("语言_c_5434"))
    end
    ccui.Helper:doLayout(self.label_time)
    local total_width = self.label_time:getContentSize().width + self.label_time.label_value:getContentSize().width
    self.label_time:setPositionX((720 - total_width)/2 + self.label_time:getContentSize().width/2)
end

--战令奖励红点
function DungeonAbyssMainWindow:updataRewardRedPoint()
    local status = self.ctrl:getModel():getOrderRedStatusAll()
    addRedPointToNodeByStatus(self.award_btn, status)
end

