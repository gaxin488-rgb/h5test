function DungeonAbyssMainWindow:updateTowerList(is_reload)
   -- print("-------------------------------- updateTowerList", self.cur_type)
    --最大数量
    self.max_count = self.ctrl:getModel():getTowerMaxLevel(self.cur_type)
    if self.list_view then 
        self.list_view:DeleteMe()
        self.list_view = nil
    end
    if not self.list_view then
        local scroll_view_size = cc.size(SCREEN_WIDTH,self.scroll_height)
        local bottom_y = display.getBottom(self.mainContainer)
        self.list_view = DungeonAbyssList.new(self.container, cc.p(SCREEN_WIDTH/2, bottom_y), scroll_view_size)
        self.list_view:registerScriptHandlerSingle(handler(self,self.createNewCell), ScrollViewFuncType.CreateNewCell) --创建cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.numberOfCells), ScrollViewFuncType.NumberOfCells) --获取数量
        self.list_view:registerScriptHandlerSingle(handler(self,self.updateCellByIndex), ScrollViewFuncType.UpdateCellByIndex) --更新cell
        self.list_view:registerScriptHandlerSingle(handler(self,self.onCellTouched), ScrollViewFuncType.OnCellTouched) --更新cell
        self.list_view:setInnerContainer()
        self.list_view:updateBgList()
    end
    self.list_view:setListType(self.cur_type)
    -- if not self.is_init_list then
    --     self.is_init_list = true 
        local lev_id = self.ctrl:getModel():getNowTowerId(self.cur_type)
        local index = self.max_count - lev_id
        self.list_view:reloadData(index)
    -- end
end

--创建cell 
function DungeonAbyssMainWindow:createNewCell()
    local cell = DungeonAbyssMainItem.new(self.cur_type)
    cell:addCallBack(function() self:onCellTouched(cell) end)
    return cell
end
--获取数据数量
function DungeonAbyssMainWindow:numberOfCells()
    return self.max_count or 0
end
--更新cell(拖动的时候.刷新数据时候会执行次方法)
--cell :createNewCell的返回的对象
--inde :数据的索引
function DungeonAbyssMainWindow:updateCellByIndex(cell, index)
    cell.index = index
    cell:setData(self.max_count - index + 1)
end

--点击cell .需要在 createNewCell 设置点击事件
function DungeonAbyssMainWindow:onCellTouched(cell)
    local index = cell.index
    local cur_lev = self.ctrl:getModel():getNowTowerId(self.cur_type) + 1
    if index > cur_lev then
        message(TI18N("语言_c_4095"))
        return
    end
    local config = Config.DungeonAbyssCircleData.data_nor_challenge_data[index]
    if config then
        self.select_vo = config
        self.select_item = cell
        self.data = config
        self:clickFun(config)
    end
end

function DungeonAbyssMainWindow:clickFun(vo)
    if not vo then return end
    self.ctrl:openDungeonAbyssFightInfoPanel(true,vo)
end

function DungeonAbyssMainWindow:createSingleRankItem(i)
	local container = ccui.Layout:create()
	container:setAnchorPoint(cc.p(0,1))
	container:setContentSize(cc.size(180,40))
	local sp = createSprite(PathTool.getResFrame("common","common_300"..i),30,40/2,container)
	sp:setScale(0.5)
	container.sp = sp
	local label = createLabel(20,1,nil,60,18,"",container)
	label:setAnchorPoint(cc.p(0,0.5))
	label:setTextColor(cc.c4b(0x89,0xed,0xff,0xff))

	local value = createLabel(20,1,nil,188,18,"",container)
	value:setAnchorPoint(cc.p(0,0.5))
	value:setTextColor(cc.c4b(0x89,0xed,0xff,0xff))
	container.label = label
    container.value = value
	return  container
end

function DungeonAbyssMainWindow:close_callback()
    --关闭页面时，停止自动战斗
    -- self.ctrl:getModel():setSkipFight(false)
    self.ctrl:openDungeonAbyssMainWindow(false)
    if self.list_view then 
        self.list_view:DeleteMe()
        self.list_view = nil
    end
    if self.play_effect then
        self.play_effect:clearTracks()
        self.play_effect:removeFromParent()
        self.play_effect = nil
    end
    self.select_item = nil
    if self.lock_icon then 
        self.lock_icon:DeleteMe()
        self.lock_icon = nil
    end
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    if self.update_base_data then
        GlobalEvent:getInstance():UnBind(self.update_base_data)
        self.update_base_data = nil
    end
    if self.update_advance_data then
        GlobalEvent:getInstance():UnBind(self.update_advance_data)
        self.update_advance_data = nil
    end
    if self.task_reward_event then
        GlobalEvent:getInstance():UnBind(self.task_reward_event)
        self.task_reward_event = nil
    end
    if self.video_data_event then
        GlobalEvent:getInstance():UnBind(self.video_data_event)
        self.video_data_event = nil
    end
    -- AudioManager:getInstance():playMusic(AudioManager.AUDIO_TYPE.SCENE, "s_002", true) -- 恢复主城背景音乐播放
    doStopAllActions(self.check_time_txt)
end
