function DungeonAbyssMainWindow:__init(type)
    self.num = 1
    self.ctrl = DungeonAbyssController:getInstance()
    self.is_full_screen = true
    self.layout_name = "dungeon_abyss/dungeon_abyss_main_window"
    self.cur_type = type or 1  -- 1 普通  2 进阶 DungeonAbyssController:getInstance():getModel():getSealTowerIsOpen()
    self.win_type = WinType.Full  
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("startower","startower"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("dungeon_abyss_circle","dungeon_abyss_circle"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("dungeon_abyss_circle","dungeon_ab_c_bg"), type = ResourcesType.single },
        { path = PathTool.getPlistImgForDownLoad("gem","gem"), type = ResourcesType.plist },
    }

    self.need_id = Config.StarTowerHighData.data_tower_const["open_cost"].val[1][1]
    self.need_num = Config.StarTowerHighData.data_tower_const["key_reward"].val
end

function DungeonAbyssMainWindow:open_callback()
    self.mainContainer = self.root_wnd:getChildByName("main_container")

    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.mainContainer)
    local bottom_y = display.getBottom(self.mainContainer)

     -- --主菜单 顶部底部的高度
    local top_height = MainuiController:getInstance():getMainUi():getTopViewHeight()
    local bottom_height = MainuiController:getInstance():getMainUi():getBottomHeight()

    self.mainContainer_size = self.mainContainer:getContentSize()
    self.bg = self.mainContainer:getChildByName("bg")
    if self.bg ~= nil then
        self.bg:setScale(display.getMaxScale())
        self.bg:setPositionY(top_y)
    end
    self.container = self.mainContainer:getChildByName("container")
    self.top_panel = self.mainContainer:getChildByName("top_panel")

    self.btnRule = self.top_panel:getChildByName("btnRule")
    self.btnRule:setPositionX(663)
    self.title = self.top_panel:getChildByName("title")
    self.title:setString(TI18N("语言_c_1204"))

    self.bg3 = self.top_panel:getChildByName("bg3")
    self.label_dif = self.top_panel:getChildByName("label_dif")
    self.label_dif.image_left = self.label_dif:getChildByName("image_left")
    self.label_dif.image_right = self.label_dif:getChildByName("image_right")
    self.label_time = self.top_panel:getChildByName("label_time")
    self.label_time:setString(TI18N("语言_c_6707"))
    self.label_time.label_value = self.label_time:getChildByName("label_value")

    self.black_bg = self.mainContainer:getChildByName("black_bg")
    self.close_btn = self.black_bg:getChildByName("close_btn")

    self.award_btn = self.top_panel:getChildByName("award_btn")
    local label = self.award_btn:getChildByName("label")
    label:setString(TI18N("语言_dun_aby_c_16"))
    self.award_btn.label = label
    label:setTextAreaSize(cc.size(100, 0))
    setTextSpacing(label,-10)
   
    self.rank_btn = self.top_panel:getChildByName("rank_btn")
    local label = self.rank_btn:getChildByName("label")
    label:setString(TI18N("语言_c_73"))

    self.buff_btn = self.top_panel:getChildByName("buff_btn")
    local label = self.buff_btn:getChildByName("label")
    label:setChangeScaleOffWidth(-9999)    
    setTextMaxWidth(label,100,-8)
    label:setString(TI18N("语言_c_7152"))

    self.rank_shop = self.top_panel:getChildByName("rank_shop")
    local label = self.rank_shop:getChildByName("label")
    label:setString(TI18N("语言_c_3347"))

    self.rank_change = self.top_panel:getChildByName("rank_change")
    local label = self.rank_change:getChildByName("label")
    setTextMaxWidth(label,100,-10)
    label:setString(TI18N("语言_dun_aby_c_7"))
    self.rank_change.label = label

    self.icon_btn = self.top_panel:getChildByName("icon_btn")
    self.icon_txt = self.icon_btn:getChildByName("label")
    self.icon_txt:setString(string.format(TI18N("语言_sta_to_h_01_8"),self.need_num))
    setTextSpacing(self.icon_txt,-10)
    self.receive_btn = self.icon_btn:getChildByName("receive_btn")
    self.receive_txt = self.receive_btn:getChildByName("label")
    self.receive_txt:setString(TI18N("语言_sta_to_h_01_6"))
    addRedPointToNodeByStatus(self.receive_btn, true,15,15)
    self.lock = self.icon_btn:getChildByName("lock")
    self.icon = BackPackItem.new(false, true, false, 0.5, false, true)
    self.icon_btn:addChild(self.icon,2)
    self.icon:setBg(false)
    self.icon:setPosition(cc.p(self.icon_btn:getContentSize().width*0.5,self.icon_btn:getContentSize().height*0.5))
    self.icon:setData(Config.ItemData.data_get_data(self.need_id))
    self.lock:setZOrder(3)

    self.mainContainer:getChildByName("rank_container"):setVisible(false)
    -- self.rank_container = self.mainContainer:getChildByName("rank_container")
    -- self.rank_container:getChildByName("rank_desc_label"):setString(TI18N("语言_c_1642"))
    -- self.rank_top3_btn = self.rank_container:getChildByName("rank_btn")
    
    local tab_y = self.top_panel:getPositionY()
    local top_panel_y = top_y - (self.mainContainer_size.height - tab_y)
    self.top_panel:setPositionY(top_panel_y)
    -- local rank_y = self.rank_container:getPositionY()
    -- self.rank_container:setPositionY(top_y - (self.mainContainer_size.height - rank_y))

    self.black_bg:setPositionY(bottom_y)
    -- 滚动高度
    self.scroll_height = top_panel_y - 20 - bottom_y - 154
    self:updateTowerList()

    self.awardbg = self.top_panel:getChildByName("awardbg");
    self.good_cons = self.awardbg:getChildByName("good_cons")
    self.guanlabel = self.award_btn:getChildByName("guanlabel")
    self:starTowerShowAward()

    self:updatePage()
end
function DungeonAbyssMainWindow:updatePage()
    -- if self.cur_type == 1 then --未开启无尽深渊
        if GemstoneController:getInstance():getModel():GemstoneIsHide() and GemstoneController:getInstance():getModel():GemstoneIsOpen() then
            self.buff_btn:setVisible(true)
        else
            self.buff_btn:setVisible(false)
        end
        self.title:setVisible(true)
        if self.cur_type == 1 then
            self.title:setString(TI18N("语言_dun_aby_c_6"))
            self.award_btn.label:setString(TI18N("语言_dun_aby_c_16"))
            self.rank_change.label:setString(TI18N("语言_dun_aby_c_7"))
            self.bg3:setVisible(false)
            self.label_dif:setVisible(false)
            self.label_time:setVisible(false)
            self.rank_btn:setVisible(false)
            self.buff_btn:setPositionY(-242)
            self:setEnterTime(false)
        else
            self.title:setString(TI18N("语言_dun_aby_c_7"))
            self.award_btn.label:setString(TI18N("语言_dun_aby_cir_5_2"))
            self.rank_change.label:setString(TI18N("语言_dun_aby_c_6"))
            self.bg3:setVisible(true)
            self.label_dif:setVisible(true)
            local diff_id = controller:getModel():getAdvanceDiff(self.cur_type) 
            local cfg = Config.DungeonAbyssCircleData.data_diff_data[diff_id]
            self.label_dif:setString(cfg.name)

            self.label_dif.image_left:loadTexture(PathTool.getResFrame("dungeon_abyss_circle", diff_info[diff_id].mark_image), LOADTEXT_TYPE_PLIST)
            self.label_dif.image_left:setPositionX(0)
            self.label_dif.image_right:loadTexture(PathTool.getResFrame("dungeon_abyss_circle", diff_info[diff_id].mark_image), LOADTEXT_TYPE_PLIST)
            self.label_dif.image_right:setPositionX(self.label_dif:getContentSize().width)
            self.label_dif:setTextColor(diff_info[diff_id].color)
            self.label_time:setVisible(true)
            self.rank_btn:setVisible(true)
            self.buff_btn:setPositionY(-342)
            self:setEnterTime(true)
        end
        self:updataRewardRedPoint()
        local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
        local featuresId = MainuiConst.FeaturesShield.SealTower
        if table.indexof(nohideIds,featuresId) then
            self.icon_btn:setVisible(false)
        else
            self.icon_btn:setVisible(false)
        end
        -- self.btnRule:setPositionX(663)
        -- self.rank_btn:setPosition(cc.p(50,880))

        -- self.icon:setTouchEnabled(true)
        -- self.receive_btn:setVisible(false)
        -- self.lock:setVisible(true)
        -- self.icon_txt:setVisible(true)
        -- self.icon_txt:setString(string.format(TI18N("语言_sta_to_h_01_8"),self.need_num))
        -- if self.play_effect then
        --     self.play_effect:setVisible(false)
        -- end
    -- else --开启无尽深渊
    --     self.title:setVisible(false)
    --     self.icon_btn:setVisible(false)
    --     self.btnRule:setPositionX(665)
    --     self.rank_btn:setPosition(cc.p(50,880))
    -- end
end
function DungeonAbyssMainWindow:starTowerShowAward()
    if not self.item_scrollview then
        local scroll_view_size = self.good_cons:getContentSize()
        local setting = {
            item_class = BackPackItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 6,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = BackPackItem.Width*0.42,               -- 单元的尺寸width
            item_height = BackPackItem.Height*0.42,              -- 单元的尺寸height
            row = 1,                        -- 行数，作用于水平滚动类型
            col = 0,                         -- 列数，作用于垂直滚动类型
            scale = 0.42,
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.good_cons, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
        self.item_scrollview:setSwallowTouches(false)
    end
    self:setAwardData()
end

function DungeonAbyssMainWindow:setAwardData(data)
    local now_id = controller:getModel():getNowTowerId(self.cur_type)
    local diff_id = controller:getModel():getAdvanceDiff(self.cur_type) 
    -- print("---------------------------- setAwardData",self.cur_type, diff_id)
    -- local reward_cfg = Config.DungeonAbyssCircleData.data_task_data[self.cur_type][diff_id]
    -- local reward_data = reward_cfg[now_id + 1]
    -- if not reward_data then
    --     reward_data = reward_cfg[now_id]
    -- end

    local need_id = Config.DungeonAbyssCircleData.data_constant["task_item_id_"..self.cur_type].val
    local nextCfg = controller:getModel():getReceiveFinishNext(self.cur_type, diff_id)
    local num1 = controller:getModel():getTotalStarCount(self.cur_type)--role_vo:getActionAssetsNumByBid(need_id)
    local num2 = nextCfg and nextCfg.need or 0
    local str = num1.."/"..num2
    self.guanlabel:setString(str)

    local list = {}
    for i,v in pairs(nextCfg.reward) do
        local tab = {}
        tab.id = v[1]
        tab.quantity = v[2]
        table_insert(list,tab)
    end
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function ()
        local list = self.item_scrollview:getItemList()
        for k,v in pairs(list) do
            v:setDefaultTip()
        end
    end)
end

function DungeonAbyssMainWindow:setRankShow()
    if RankController:getInstance():checkRankIsShow() then
        self.rank_container:setVisible(true)
        self.rank_btn:setVisible(true)
        -- self.ctrl:requestStarTowerRank()
    else
        self.rank_container:setVisible(false)
        self.rank_btn:setVisible(false)
    end
end

function DungeonAbyssMainWindow:register_event()
    registerButtonEventListener(self.close_btn, function()
        self.ctrl:openDungeonAbyssMainWindow(false)
    end,true, 2)
    registerButtonEventListener(self.icon_btn, function()
        local id = self.ctrl:getModel():getNowTowerId(self.cur_type)
        if id >= self.need_num then
            local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(self.need_id)
            if num >= 1 then
                SealtowerController:getInstance():sender11345()
            else
                self.ctrl:sender11348()
            end
        else
            TipsManager:getInstance():showGoodsTips(self.need_id)
        end
    end,true, 1)
    registerButtonEventListener(self.award_btn, function()
        self.ctrl:openDungeonAbyssWarOrderPanel(true, {type = self.cur_type, diff = controller:getModel():getAdvanceDiff(self.cur_type) })
    end,true, 1)

    registerButtonEventListener(self.rank_btn, function()
        if self.cur_type == 1 then
            RankController:getInstance():openRankView(true,RankConstant.RankType.dungeon_abyss)
        else
            RankController:getInstance():openRankView(true,RankConstant.RankType.dungeon_abyss_advance)
        end
    end,true, 1)

    registerButtonEventListener(self.buff_btn, function()
        GemstoneController:getInstance():openGemstoneBuffView(true,1,{cur_type = self.cur_type})
    end,true, 1)

    registerButtonEventListener(self.rank_shop, function()
        self.ctrl:openDungeonAbyssShopPanel(true, {type = self.cur_type, diff = controller:getModel():getAdvanceDiff(self.cur_type) })
    end,true, 1)

    registerButtonEventListener(self.rank_change, function()
        self:changeTowerType()
    end,true, 1)

    registerButtonEventListener(self.receive_btn, function()
        local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(self.need_id)
        if num >= 1 then
            SealtowerController:getInstance():sender11345()
        else
            self.ctrl:sender11348()
        end
    end,true, 1)
    -- registerButtonEventListener(self.rank_top3_btn, function()
    --     RankController:getInstance():openRankView(true,RankConstant.RankType.tower)
    -- end,true, 1)
    registerButtonEventListener(self.btnRule, function(param,sender, event_type)
        -- local config = Config.DungeonAbyssCircleData.data_constant["abyss_rule"]
        -- TipsManager:getInstance():showCommonTips(config.desc, sender:getTouchBeganPosition())
        if Config.DungeonAbyssCircleData.data_desc then
            MainuiController:getInstance():openCommonExplainView(true, Config.DungeonAbyssCircleData.data_desc)
        end
    end,true, 1)

    if self.update_base_data == nil then
        self.update_base_data = GlobalEvent:getInstance():Bind(DungeonAbyssEvent.Update_Base_Data, function(is_pass)
            if is_pass then
                self.ctrl:openDungeonAbyssMainWindow(false)
                return
            end
            self:starTowerShowAward()
            self:updateTowerList()
            self:updatePage()
        end)
    end
    if self.update_advance_data == nil then
        self.update_advance_data = GlobalEvent:getInstance():Bind(DungeonAbyssEvent.Update_Advance_Data, function(choose)
