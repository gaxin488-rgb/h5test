local _controller = DungeonAbyssController:getInstance()
local _model = _controller:getModel()

DungeonAbyssChooseDifficultyPanel = DungeonAbyssChooseDifficultyPanel or BaseClass(BaseView)

function DungeonAbyssChooseDifficultyPanel:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "dungeon_abyss/dungeon_abyss_choose_difficulty_panel"
	-- self.holiday_bid = Config.LimitTrainingData.data_const.event_bid.val or 993071
end

function DungeonAbyssChooseDifficultyPanel:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	self.background:setScale(display.getMaxScale())

	local container = self.root_wnd:getChildByName("container")
	self:playEnterAnimatianByObj(container, 2)  

	self.title_bg = container:getChildByName("image_2")
	self.win_title = container:getChildByName("win_title")
	self.win_title:setString(TI18N("语言_c_5446"))
	self.title_bg:setContentSize(cc.size(self.win_title:getContentSize().width+120,self.title_bg:getContentSize().height))
	self.close_btn = container:getChildByName("close_btn")
	self.rule_btn = container:getChildByName("rule_btn")
	self.difficulty_panel = container:getChildByName("difficulty_panel")
	
	self.activity_panel = container:getChildByName("activity_panel")
	self.activity_panel:getChildByName("tips"):setString(TI18N("语言_c_6302"))
	self.jump_btn = self.activity_panel:getChildByName("jump_btn")
	self.jump_btn:getChildByName("txt"):setString(TI18N("语言_adv_05_74"))
	self.activity_panel:setVisible(false)
end

function DungeonAbyssChooseDifficultyPanel:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), true, 1)
	registerButtonEventListener(self.background, handler(self, self._onClickCloseBtn), false, 1)
	registerButtonEventListener(self.rule_btn, function ( param, sender, event_type )
        -- MainuiController:getInstance():openCommonExplainView(true, Config.LimitTrainingData.data_explain, TI18N("语言_c_76"))
		if Config.DungeonAbyssCircleData.data_desc then
            MainuiController:getInstance():openCommonExplainView(true, Config.DungeonAbyssCircleData.data_desc)
        end
    end, true, 2)
	registerButtonEventListener(self.jump_btn, function ( param, sender, event_type )
		-- JumpController:getInstance():jumpViewByEvtData({700, self.holiday_bid})
    end, true, 2)
end
function DungeonAbyssChooseDifficultyPanel:_onClickCloseBtn()
	_controller:openDungeonAbyssChooseDifficultyPanel(false)
end
function DungeonAbyssChooseDifficultyPanel:openRootWnd()
	self:setData()
end

function DungeonAbyssChooseDifficultyPanel:setData()
	-- local ac_controller = ActionController:getInstance()
	-- local tab_vo = ac_controller:getActionSubTabVo(self.holiday_bid)
	-- if tab_vo then
	-- 	self.activity_panel:setVisible(true)
	-- 	self.difficulty_panel:setPositionY(730)
	-- 	self.difficulty_panel:setContentSize(cc.size(583, 705))
	-- else
	-- 	self.activity_panel:setVisible(false)
	-- end

	self.cfg = Config.DungeonAbyssCircleData.data_diff_data
	if self.difficulty_view == nil then
        local scroll_view_size = self.difficulty_panel:getContentSize()
        local setting = {
            item_class = DungeonAbyssChooseDifficultyItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 583,               -- 单元的尺寸width
            item_height = 136,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.difficulty_view = CommonScrollViewLayout.new(self.difficulty_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
        self.difficulty_view:setData(self.cfg)
    end
end

function DungeonAbyssChooseDifficultyPanel:close_callback(  )
	if self.item_load1 then
        self.item_load1:DeleteMe()
        self.item_load1 = nil
    end
	_controller:openDungeonAbyssChooseDifficultyPanel(false)
end

---------------------------------
--子项
---------------------------------
DungeonAbyssChooseDifficultyItem = class("DungeonAbyssChooseDifficultyItem", function()
    return ccui.Widget:create()
end)

function DungeonAbyssChooseDifficultyItem:ctor()
	self:configUI()
	self:register_event()
end

function DungeonAbyssChooseDifficultyItem:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("dungeon_abyss/dungeon_abyss_choose_difficulty_item"))
    self:setContentSize(cc.size(583, 136))
    self:addChild(self.root_wnd)
    self.container = self.root_wnd:getChildByName("container")
    self.container:setSwallowTouches(false)
    self.bg = self.container:getChildByName("bg")
    self.difficulty_name = self.container:getChildByName("difficulty_name")
    self.power_bg = self.container:getChildByName("power_bg")
    self.power = createRichLabel(20, cc.c4b(0x00,0x00,0x00,0xff), cc.p(0,0.5), cc.p(45,30),nil,nil,600)
	self.container:addChild(self.power)
	self.form_bg = self.container:getChildByName("form_bg")
	self.form = createRichLabel(20, cc.c4b(0xff,0xff,0xff,0xff), cc.p(0,0.5), cc.p(45,60),nil,nil,600)
	self.container:addChild(self.form)
    self.reward = self.container:getChildByName("reward")
    self.reward_txt = self.reward:getChildByName("reward_txt")
	self.reward_txt:setString(TI18N("语言_c_21"))
	local _x = self.reward_txt:getContentSize().width - 80
	if _x < 0 then
		_x = 0
	end
	local reward_x = self.reward:getPositionX() - _x
	self.reward:setPositionX(reward_x)
	self.tag = self.container:getChildByName("tag")
	self.tag_txt = self.tag:getChildByName("label")
	self.tag_txt:setString(TI18N("语言_c_1363"))
	self.tag_txt:setScaleX(self.tag_txt:getScaleX())
    self.not_unlocked_panel = self.container:getChildByName("not_unlocked_panel")
    self.look = self.not_unlocked_panel:getChildByName("look")
	self.not_unlocked_panel:setVisible(false)
    self.not_unlocked_panel:setSwallowTouches(false)
end

function DungeonAbyssChooseDifficultyItem:register_event()
	registerButtonEventListener(self.container, handler(self, self._onClickSelf), true, 1)
	self.container:addTouchEventListener(function(sender, event_type)
		customClickAction_2(sender, event_type)        
        if event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
			self.isclick = true
        elseif event_type == ccui.TouchEventType.moved then
            local touch_began = self.touch_began
            local touch_move = sender:getTouchMovePosition()
            if touch_began and touch_move and (math.abs(touch_move.x - touch_began.x) > 20 or math.abs(touch_move.y - touch_began.y) > 20) then 
                --移动大于20了..表示取消长点击效果
				self.isclick = false
            end 
        elseif event_type == ccui.TouchEventType.canceled then
            self.isclick = false
        elseif event_type == ccui.TouchEventType.ended then
			playButtonSound2()
			if self.isclick then
				self:_onClickSelf()
			end
        end

	end)
	registerButtonEventListener(self.reward, handler(self, self._onClickreward), true, 1)
end

function DungeonAbyssChooseDifficultyItem:_onClickSelf()
	if self.data.id - self.recommendLevel >= 2 then return end
	local star = 0
	local num = 0
	for k, v in pairs(self.data.partner_star) do
		if v[1] == "partner_star" then
			star = v[2]
			num = v[3]
		end
	end
	local list = {0,star,num}
	if not HeroController:getInstance():getModel():getHeroReachCon(list)[1] then
		message(LangStringFormat(TI18N("语言_dun_aby_c_6_9a1"),star,num))
		return
	end
	local function fun()
		if self.data then
			_controller:sender22503(self.data.id)
		end
	end
	local str = TI18N("语言_dun_aby_c_18")
	-- if self.recommendLevel == self.data.id then
	-- 	str = TI18N("语言_c_5447")
	-- elseif self.recommendLevel > self.data.id then
	-- 	str = TI18N("语言_c_5448")
	-- elseif self.recommendLevel < self.data.id then
	-- 	str = TI18N("语言_c_5449")
	-- end
	if self.data.id == 2 then
		str = TI18N("语言_dun_aby_c_18")
	elseif self.data.id == 5 then
		str = TI18N("语言_dun_aby_c_19")
	elseif self.data.id == 6 then
		str = TI18N("语言_dun_aby_c_20")
	end
	-- local other_condition = self:checkThemeTrainAction()
	-- if other_condition and other_condition > self.data.id then
	-- 	str = str .. TI18N("语言_c_6333")
	-- end
	CommonAlert.show(str, TI18N("语言_c_63"), fun, TI18N("语言_c_62"), nil, CommonAlert.type.rich, nil, {timer=5}, nil, true)
end

