function DungeonAbyssChooseDifficultyItem:_onClickreward()
	_controller:openDungeonAbyssDifficultyReward(true,self.data.id)
end

function DungeonAbyssChooseDifficultyItem:setData(data)
	self.data = data
	local res = PathTool.getTargetRes("dungeon_abyss_circle",string.format("dungeon_ab_c_level_%s", data.id) or "dungeon_ab_c_level_1",false,false)
	if not self.item_load1 then
		self.item_load1 = loadSpriteTextureFromCDN(self.bg, res, ResourcesType.single, self.item_load1)
	end
	self.difficulty_name:setString(data.name)

	self.recommendLevel = _model:getRecommendLevel()
	self.hero_recommendLevel = _model:getHeroRecommendLevel()
	if self.recommendLevel == data.id then
		self.tag:setVisible(true)
	else
		self.tag:setVisible(false)
	end
	local str = ""
	if self.recommendLevel >= data.id then
		str = "语言_c_5450"
	else
		if data.id - self.recommendLevel == 1 then
			str = "语言_c_5451"
		else
			str = "语言_c_5452" 
		end
	end
	local _txt_col_1 = "<div fontcolor=#0ea80e outline=2,#000000>"
	local _txt_col_2 = "</div>"
	if self.hero_recommendLevel >= data.id then
		_txt_col_1 = "<div fontcolor=#0ea80e outline=2,#000000>"
		_txt_col_2 = "</div>"
	else
		if data.id - self.hero_recommendLevel == 1 then
			_txt_col_1 = "<div fontcolor=#ff580e outline=2,#000000>"
			_txt_col_2 = "</div>" 
		else
			_txt_col_1 = "<div fontcolor=#ff1515 outline=2,#000000>"
			_txt_col_2 = "</div>"
		end
	end
	self.power:setString(string.format(TI18N(str), MoneyTool.moneyFormat(data.power[1][1]),MoneyTool.moneyFormat(data.power[1][2])))
	self.power_bg:setContentSize(cc.size(self.power:getContentSize().width + 90, self.power_bg:getContentSize().height))
	local star_list = {}
	for k, v in pairs(data.partner_star) do
		if v[1] == "partner_star" then
			table.insert(star_list, v[2])
			table.insert(star_list, v[3])
			table.insert(star_list, _txt_col_1)
			table.insert(star_list, _txt_col_2)
		end
	end
	self.form:setString(LangStringFormat(data.formation,star_list))
	self.form_bg:setContentSize(cc.size(self.form:getContentSize().width + 90, self.form_bg:getContentSize().height))

	if self.recommendLevel < data.id and (data.id - self.recommendLevel) >=2 then
		self.not_unlocked_panel:setVisible(true)
	else
		self.not_unlocked_panel:setVisible(false)
	end
end

function DungeonAbyssChooseDifficultyItem:DeleteMe()
end
