		-- 龙地洞 关卡数据
---------------------------------
HeavenHighCustomsVo = HeavenHighCustomsVo or BaseClass(EventDispatcher)

function HeavenHighCustomsVo:__init(  )
	self.chapter_id = 0  -- 章节id
	self.id = 0 		 -- 关卡id
	self.state = 0 		 -- 是否可挑战(0不可挑战 1可挑战 2已通关)
	self.star = 0 		 -- 通关星数
	self.star_info = {}  -- 三星点亮状态
end

function HeavenHighCustomsVo:updateData( data )
	for key, value in pairs(data) do
        self[key] = value
    end
    self:dispatchUpdateAttrByKey()
end

function HeavenHighCustomsVo:dispatchUpdateAttrByKey()
    self:Fire(HeavenHighEvent.Update_Customs_Vo_Event) 
end

function HeavenHighCustomsVo:__delete(  )
	
end