FindHighWindow = FindHighWindow or BaseClass(BaseView)

local _controller = HeavenHighController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local string_format = string.format
local table_sort = table.sort

function FindHighWindow:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big   
    self.is_full_screen = false
    self.layout_name = "heaven_high/heaven_high_find_window"
    self.data_chapter = {} -- 章节数据

    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("vedio","vedio"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("heaven","heaven"), type = ResourcesType.plist },
    }
end

function FindHighWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")

    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)

    self.main_panel = self.main_container:getChildByName("main_panel")

    self.title = self.main_panel:getChildByName("win_title")
    self.title:setString(TI18N("语言_c_4527"))

    self.scroll_container = self.main_panel:getChildByName("scroll_container")

    self.close_btn = self.main_panel:getChildByName("close_btn")
end

function FindHighWindow:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,true, 2)
end

--关闭
function FindHighWindow:onClickBtnClose()
    _controller:openFindHighWindow(false)
end


function FindHighWindow:openRootWnd()
    self:setData()
end

function FindHighWindow:setData(data)
    -- local data_chapter = Config.DungeonHeavenAdvanceData.data_chapter
    -- local self_chapter = _model:getOpenMaxChapterId() or 1
    -- for i = self_chapter,tableLen(data_chapter) do
    --     if i == self_chapter then
    --         local chapter_vo = _model:getChapterDataById(data_chapter[i].id)
    --         local all_star
    --         if chapter_vo then
    --             all_star = chapter_vo.all_star
    --             data_chapter[i].all_star = all_star
    --             data_chapter[i].is_unlock = true
    --         end
    --     end
    --     _table_insert(self.data_chapter,data_chapter[i])
    -- end
    -- for i = 1,self_chapter-1 do
    --     local chapter_vo = _model:getChapterDataById(data_chapter[i].id)
    --     local all_star
    --     if chapter_vo then
    --         all_star = chapter_vo.all_star
    --         data_chapter[i].all_star = all_star
    --         data_chapter[i].is_unlock = true
    --     end
    --     _table_insert(self.data_chapter,data_chapter[i])
    -- end
    local data_chapter = Config.DungeonHeavenAdvanceData.data_chapter
    for i = 1,#data_chapter do
        local chapter_vo = _model:getChapterDataById(data_chapter[i].id)
        local all_star
        if chapter_vo then
            all_star = chapter_vo.all_star
            data_chapter[i].all_star = all_star
            data_chapter[i].is_unlock = true
        end
        _table_insert(self.data_chapter,data_chapter[i])
    end
    self:updateList()
end

function FindHighWindow:updateList()
    if self.item_scrollview == nil then
        local scroll_view_size = self.scroll_container:getContentSize()
        local setting = {
            item_class = FindHighItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 6,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 616,               -- 单元的尺寸width
            item_height = 124,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1                        -- 列数，作用于垂直滚动类型
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.scroll_container, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, self.scroll_container:getContentSize(), setting)
        local ext = {showCheckBox = true, red_point = true, show_use_target = true, is_other = false}
        self.item_scrollview:setData(self.data_chapter)
    end
end
function FindHighWindow:close_callback()
    doStopAllActions(self.main_container)

    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
    end
    self.item_scrollview = nil
    _controller:openFindHighWindow(false)
end