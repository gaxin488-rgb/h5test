-- --------------------------------------------------------------------
-- 天界副本查找章节单个
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2018-xx-xx
-- --------------------------------------------------------------------
FindHighItem = class("FindHighItem", function()
	return ccui.Widget:create()
end)

function FindHighItem:ctor()
	self:configUI()
	self:registerEvent()
end

function FindHighItem:configUI()
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("heaven_high/heaven_high_find_item"))
	
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(616,124))
	self:setTouchEnabled(true)

	self.main_container = self.root_wnd:getChildByName("main_container")
	self.star_container = self.main_container:getChildByName("star_container")
	self.main_container:setTouchEnabled(false)
	self.bg = self.main_container:getChildByName("bg")
	self.icon = self.main_container:getChildByName("icon")
	self.title = self.main_container:getChildByName("title")
	self.star = self.main_container:getChildByName("star")
	self.star_num = createRichLabel(22,cc.c4b(0x00,0x00,0x00,0xff),cc.p(0.5,0.5),cc.p(298,75),-4)
	self.main_container:addChild(self.star_num)
	self.small_title = self.main_container:getChildByName("small_title")
	self.small_title:setString("")
	self.reward = self.main_container:getChildByName("reward")
	self.reward:getChildByName("label"):setString(TI18N("语言_c_11"))
	self.go = self.main_container:getChildByName("go")
	self.go:getChildByName("label"):setString(TI18N("语言_c_7"))
	self.progress_bg = self.star_container:getChildByName("progress_bg")
	self.progress = self.progress_bg:getChildByName("progress")
	self.progress:setScale9Enabled(true)
    self.progress:setPercent(0)
	self.no_container = self.root_wnd:getChildByName("no_container")
	-- self.no_container:setTouchEnabled(true)
	self.MaskTxt = self.no_container:getChildByName("MaskTxt")
	self.MaskLock = self.no_container:getChildByName("common_90009_1")
	self.perferct = self.main_container:getChildByName("perferct")
	self.perferct:setVisible(false)
	self.perferct:setString(TI18N("语言_c_4993"))
end
function FindHighItem:setData(data)
	self.data = data
	if data.is_unlock then
		self.no_container:setVisible(false)
		self.no_container:setTouchEnabled(false)
		self.star_container:setVisible(true)
		self.star:setVisible(true)
		self.star_num:setVisible(true)
	else
		self.star:setVisible(false)
		self.star_num:setVisible(false)
		self.star_container:setVisible(false)
	end
	local id = self.data.level_picture or 1
	local path = string.format("campicon_100%s", id)
	local res_id2 = PathTool.getPlistImgForDownLoad("campicon", path)
	self.icon:loadTexture(res_id2,LOADTEXT_TYPE)
	local titleStr = self.data.type
	self.title:setString(titleStr)
	local small_titleStr = self.data.vice_chapter_name
	local starNum = self.data.all_star or 0
	local max_star = HeavenHighController:getInstance():getModel():getChapterMaxStarNum(self.data.id) or 30
	local star_num = string.format("<div fontColor=#ffffff outline=2,#5c2705>%s/%s</div>",starNum,max_star)
	self.progress:setPercent(starNum/max_star*100)
	if starNum >= max_star then
		self.progress:setVisible(false)
		self.progress_bg:setVisible(false)
		self.perferct:setVisible(true)
	else
		self.progress:setVisible(true)
		self.progress_bg:setVisible(true)
		self.perferct:setVisible(false)
	end
	self.star_num:setString(star_num)
	self.star:setPositionX(self.star_num:getPositionX() - self.star_num:getContentSize().width/2 - 20)
	local cfg = Config.DungeonHeavenAdvanceData.data_chapter
	local lastId = data.id - 1
	if lastId == 0 then
		lastId = 1
	end
	local lastName = cfg[lastId].type
	local condition = data.cond_info
	local conditionId
	local conditionStar
	local str
	if condition and condition[1] and condition[1][1] then
		conditionId = condition[1][1]
		conditionStar = condition[1][2]
		local conditionName = cfg[conditionId].type
		str = string.format(TI18N("语言_c_4525"), lastName,conditionName,conditionStar)
	else
		str = string.format(TI18N("语言_c_4526"), lastName)
	end
	self.MaskTxt:setString(str)
end
function FindHighItem:registerEvent()
	registerButtonEventListener(self.reward, function (  )
        self:onClickReward(self.data.id)
	end, true)
	registerButtonEventListener(self.go, function (  )
        self:onClickGo(self.data.id)
    end, true)
end
function FindHighItem:onClickReward(id)
	HeavenHighController:getInstance():openHeavenHighStarAwardWindow(true, id)
end
function FindHighItem:onClickGo(id)
	GlobalEvent:getInstance():Fire(HeavenHighEvent.Jump_Page,id)
	HeavenHighController:getInstance():openFindHighWindow(false)
end
function FindHighItem:DeleteMe()
	self:removeAllChildren()
	self:removeFromParent()
end