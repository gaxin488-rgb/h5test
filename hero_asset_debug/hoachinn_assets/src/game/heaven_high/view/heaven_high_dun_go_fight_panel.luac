function HeavenHighDunGoFightPanel:setData(data, info)
    if not data then return end
    if not info then return end
    self.team_data_list = data.formations
    if self.team_data_list and next(self.team_data_list) and tableLen(self.team_data_list) > 1 then
        table.sort(self.team_data_list,function(a,b) return a.order < b.order end)
    end
    self.info = info
    self.team_index = self.info.index
    local pointData = {}
    for k, v in pairs(data.formations) do
        if v.order == self.team_index then
            pointData = v
        end
    end
    -- -- 神器id
    self.hallows_id = pointData.hallows_id
    -- -- 阵法类型
    self.formation_type = pointData.formation_type
    self:setTipsPanel()
    self:updateLeftTeamInfo()
    self:updateTeamInfo()
    self:updateFormationData(true)
    self:updateRightTeamInfo()
    self:CreateDunBtn()
    self:setBtnStatus()
    self:updateElfinList()
end

function HeavenHighDunGoFightPanel:setTipsPanel()
    self.condition = {}
    local data = Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id]
    self.condition_status = true
    for k, v in pairs(data.is_show) do
        local num = 0
        for key, value in pairs(v[2]) do
            if value[2] == 1 then
                num = num + 1
            end
        end
        if num > 1 then
            self.condition_status = false
        end
    end
    if self.condition_status then
        self.pos_tips:setVisible(true)
        self.pos_tips_panel:setVisible(false)
        self.heaven_tip:setVisible(false)
    else
        self.pos_tips:setVisible(false)
        self.pos_tips_panel:setVisible(true)
        self.heaven_tip:setVisible(true)
    end
    
    local cfg = Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id]
    self.id = {}
    local num = {}
    for k, v in pairs(cfg.is_show) do
        if v[1] == self.team_index then
            for key, value in pairs(v[2]) do
                if value[2] == 1 then
                    table.insert(num,value[1])
                end
            end
        end
    end
    for k, v in pairs(cfg.cond_info) do
        if v[1] == self.team_index then
            for key, value in pairs(v[2]) do
                for i, j in pairs(num) do
                    if value[1] == j then
                        table.insert(self.id,value[2])
                    end
                end
            end
        end
    end
    for k, v in pairs(self.id) do
        local star_cfg = Config.DungeonHeavenAdvanceData.data_star_cond[v]
        table.insert(self.condition,star_cfg.condition)
    end
    if self.condition_status then
        local star_cfg = Config.DungeonHeavenAdvanceData.data_star_cond[self.id[1]]
        self.pos_tips:setString(star_cfg.type)
        self:setPosTipColor()
    else
        for k, v in pairs(self.pos_tip_list) do
            v:setVisible(false)
        end
        for i = 1, tableLen(self.id) do
            self.pos_tip_list[i]:setVisible(true)
            self.pos_tip_list[i]:setPosition(self.tip_list_pos[tableLen(self.id)][i])
        end
        self:setHeavenPosTipColor()
    end
end

function HeavenHighDunGoFightPanel:setBtnStatus()
    for i=1,#self.dunlist do
        self.dunlist[i]:setStatus(i==self.team_index)
    end
    local cfg = deepCopy(Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id])
    if cfg then
        -- local power_num = cfg.power[self.team_index]
        local power_num = cfg.power[1]
        self.label_power_left:setString(TI18N("语言_c_248")..power_num)
    end
end

function HeavenHighDunGoFightPanel:updateLeftTeamInfo()
    -- 给每个item设置站位数据(站位数据是固定的)
    for i,item in ipairs(self.hero_item_list_left) do
        local pos = self:getFormPosByIndex(self.formation_type, i)
        item:setExtendData({scale = 1, can_click = true, pos_id = pos})
    end
    local pointData = self.team_data_list[self.team_index]
    -- 英雄数据
    if self.hero_item_list_left and pointData then
        local function _getHeroInfoByPos(pos)
            for _,info in pairs(pointData.pos_info) do
                if info.pos == pos then
                    return info
                end
            end
        end
        for index,hero_item in ipairs(self.hero_item_list_left) do
            if pointData.pos_info then
                local hero_info = _getHeroInfoByPos(index)
                if hero_info then
                    local hero_vo = HeroController:getInstance():getModel():getHeroById(hero_info.id)
                    if hero_vo then
                        hero_item:setData(hero_vo)
                        hero_item:setChosenImg(0)
                    end
                else
                    hero_item:setData()
                    hero_item:setChosenImg(0)
                end
            else
                hero_item:setData()
                hero_item:setChosenImg(0)
            end
        end
    end
end

-- 根据阵法类型和index，获取对应的位置
function HeavenHighDunGoFightPanel:getFormPosByIndex( form_type, index )
    local pos = 1
    local formation_config = Config.FormationData.data_form_data[form_type]
    if formation_config then
        for k,v in pairs(formation_config.pos) do
            if v[1] == index then
                pos = v[2]
                break
            end
        end
    end
    return pos
end

function HeavenHighDunGoFightPanel:getData()
    local team_data = model:GetTeamData()
    return team_data
end

-- 英雄列表选择了一位英雄
function HeavenHighDunGoFightPanel:onSelectHero( item, hero_vo )
    if self.is_show_act == true or self.is_move_hero == true then return end
    local sub_id = self.team_index
    if hero_vo.is_ui_select == true then
        if hero_vo.point_id==sub_id then
            hero_vo.is_ui_select = false
            hero_vo.teamNum=nil
            hero_vo.point_id = nil
            for key, value in pairs(self.team_data_list) do
                if value.order == sub_id then
                    for k, v in pairs(value.pos_info) do
                        if v.id == hero_vo.partner_id then
                            table.remove(value.pos_info,k)
                            -- v = nil
                            break
                        end
                    end
                end
            end
            item:setChosenImg(0)
            self:cancelSelectHeroItem(hero_vo.partner_id, item)
        else
            local change_index = self:setEmptyHeroItem(hero_vo, item)
            if change_index then
                for key, value in pairs(self.team_data_list) do
                    if value.order == hero_vo.teamNum then
                        for k, v in pairs(value.pos_info) do
                            if v.id == hero_vo.partner_id then
                                table.remove(value.pos_info,k)
                                break
                            end
                        end
                    end
                end
                for k, v in pairs(self.team_data_list) do
                    if v.order == sub_id then
                        local temp={id=hero_vo.id,pos=change_index}
                        table.insert(v.pos_info,temp)
                        break
                    end
                end
                hero_vo.teamNum=sub_id
                hero_vo.point_id = sub_id
                item:setChosenImg(sub_id)
            end
        end
    else
        local change_index = self:setEmptyHeroItem(hero_vo, item)
        if change_index then
            for k, v in pairs(self.team_data_list) do
                if v.order == sub_id then
                    local temp={id=hero_vo.id,pos=change_index}
                    table.insert(v.pos_info,temp)
                    break
                end
            end
            hero_vo.is_ui_select = true
            hero_vo.point_id = sub_id
            item:setSelected(true)
            hero_vo.teamNum=sub_id
            item:setChosenImg(sub_id)
        end
    end
    self:ChangeDunCount()
end
-- 判读全部队伍中是否有超过指定数量的同类英雄
function HeavenHighDunGoFightPanel:checkIsHaveTwoSameHeroInAllTeam( hero_vo, no_tips,limit_num )
    limit_num = limit_num or 2
    local is_have = false
    local have_num = 0
    for _,team_object in pairs(self.team_data_list) do
        for k,v in pairs(team_object.pos_info) do
            local data = HeroController:getInstance():getModel():getHeroById(v.id)
            if data and data.bid == hero_vo.bid then
                have_num = have_num + 1
                if have_num >= limit_num then
                    is_have = true
                    break
                end
            end
        end
        if is_have then
            break
        end
    end
    local str = ""
    if is_have and not no_tips then
        str = TI18N("语言_c_448")
        if limit_num == 1 then
            str = TI18N("语言_c_447")
        end
        message(str)
    end
    return is_have
end
function HeavenHighDunGoFightPanel:ChangeDunCount()
    for i = 1, tableLen(self.team_data_list) do
        local list={}
        local data = self.team_data_list[i]
        list = data.pos_info
        local count=0
        if list and next(list) ~= nil then
            for _,v in pairs(list) do
                count=count+1
            end
        end
        if self.dunlist[i] then
            self.dunlist[i]:setData(i,count)
        end
    end
end

function HeavenHighDunGoFightPanel:cancelSelectHeroItem( partner_id, super_hero_item )
    if self.hero_item_list_left then
        for _,item in ipairs(self.hero_item_list_left) do
            local hero_vo = item:getData()
            if hero_vo and hero_vo.partner_id == partner_id then
                hero_vo.is_ui_select = false
                item:setData()
                if not self.move_hero_item then
                    self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                    self.main_container:addChild(self.move_hero_item)
                end
                self.move_hero_item:setData(hero_vo)
                local world_pos = item:convertToWorldSpace(cc.p(0, 0))
                local target_pos = self.main_container:convertToNodeSpace(world_pos)
                local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                local item_pos = self.main_container:convertToNodeSpace(super_world_pos)
                self.is_show_act = true
                self.move_hero_item:setPosition(cc.p(target_pos.x+HeroExhibitionItem.Width*0.7/2, target_pos.y+HeroExhibitionItem.Height*0.7/2))
                local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(item_pos.x+HeroExhibitionItem.Width/2, item_pos.y+HeroExhibitionItem.Height/2))
                local call_back = function ()
                    self.move_hero_item:setData()
                    self.move_hero_item:setPosition(cc.p(-1000, -1000))
                    if super_hero_item then
                        super_hero_item:setSelected(false)
                    end
                    self:updateTeamInfo()
                    self.is_show_act = false
                end
                self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                return
            end
        end
    end
end

-- 取出第一个空位置
function HeavenHighDunGoFightPanel:setEmptyHeroItem( data, super_hero_item )
    if self.hero_item_list_left and not self:checkIsHaveSameHeroInOneTeam(data, true) then
        if self:checkIsHaveTwoSameHeroInAllTeam(data) then return end
        for i,item in ipairs(self.hero_item_list_left) do
            local hero_vo = item:getData()
            if not hero_vo then
                if not self.move_hero_item then
                    self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                    self.main_container:addChild(self.move_hero_item)
                end
                self.move_hero_item:setData(data)
                local world_pos = item:convertToWorldSpace(cc.p(0, 0))
                local target_pos = self.main_container:convertToNodeSpace(world_pos)
                local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                local item_pos = self.main_container:convertToNodeSpace(super_world_pos)
                self.is_show_act = true
                self.move_hero_item:setPosition(cc.p(item_pos.x+HeroExhibitionItem.Width/2, item_pos.y+HeroExhibitionItem.Height/2))
                local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+HeroExhibitionItem.Width*0.7/2, target_pos.y+HeroExhibitionItem.Height*0.7/2))
                local call_back = function (  )
                    self.move_hero_item:setData()
                    self.move_hero_item:setPosition(cc.p(-1000, -1000))
                    if item then
                        item:setData(data)
                        item:setChosenImg(0)
                    end
                    self:updateTeamInfo()
                    self.is_show_act = false
                end
                self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                return i
            end
        end
        return 
    end
    -- 能走到这里，就一定是同队伍有同类英雄
    message(TI18N("语言_c_447"))
end

-- 判断某一队伍中是否有同类英雄
function HeavenHighDunGoFightPanel:checkIsHaveSameHeroInOneTeam(hero_vo, no_tips )
    local is_have = false
    local team_object = self.hero_item_list_left
    if team_object then
        for k,item in pairs(team_object) do
            local data = item:getData()
            if data and data.bid == hero_vo.bid then
                is_have = true
                break
            end
        end
    end
    if is_have and not no_tips then
        message(TI18N("语言_c_447"))
    end
    return is_have
end

-- 点击英雄
function HeavenHighDunGoFightPanel:onClickHeroItem(hero_index)
    local hero_item_list = self.hero_item_list_left or {}
    local hero_item = hero_item_list[hero_index]
    if hero_item then
        local hero_vo = hero_item:getData()
        if hero_vo then
            hero_vo.is_ui_select = false
            hero_item:setData()
            for key, value in pairs(self.team_data_list) do
                if value.order == hero_vo.teamNum then
                    for k, v in pairs(value.pos_info) do
                        if v.id == hero_vo.partner_id then
                            table.remove(value.pos_info,k)
                            break
                        end
                    end
                end
            end
            hero_vo.teamNum=nil
            hero_vo.point_id=nil
            self:updateTeamInfo()
            self:ChangeDunCount()
            if self.super_panel then
                local super_hero_item = self.super_panel:getCellHeroItemByPartnerId(hero_vo.partner_id)
                self.super_panel:updateShowlist(hero_vo.partner_id)
                if super_hero_item then
                    self.is_show_act = true
                    if not self.move_hero_item then
                        self.move_hero_item = HeroExhibitionItem.new(0.7, false)
                        self.main_container:addChild(self.move_hero_item)
                    end
                    self.move_hero_item:setData(hero_vo)
                    local world_pos = hero_item:convertToWorldSpace(cc.p(0, 0))
                    local item_pos = self.main_container:convertToNodeSpace(world_pos)
                    self.move_hero_item:setPosition(cc.p(item_pos.x+HeroExhibitionItem.Width*0.7/2, item_pos.y+HeroExhibitionItem.Height*0.7/2))
                    local super_world_pos = super_hero_item:convertToWorldSpace(cc.p(0, 0))
                    local target_pos = self.main_container:convertToNodeSpace(super_world_pos)
                    local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+HeroExhibitionItem.Width/2, target_pos.y+HeroExhibitionItem.Height/2))
                    local call_back = function ()
                        self.move_hero_item:setData()
                        self.move_hero_item:setPosition(cc.p(-1000, -1000))
                        super_hero_item:setSelected(false)
                        super_hero_item:setChosenImg(0)
                        self.is_show_act = false
                    end
                    self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))                    
                end
            end
        end
    end
end
---- 更新right战力、阵营信息
function HeavenHighDunGoFightPanel:updateRightTeamInfo( )
    local cfg = deepCopy(Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id])
    local unit_list = cfg.unit_id
    local unit_cfg = Config.UnitData.data_unit(unit_list[self.team_index])
    local team_object = self.hero_item_list_right
    if not team_object then return end
    -- 战力
    local power_num = cfg.power[1]
    self.label_power_left:setString(TI18N("语言_c_5812")..power_num)
    for i = 1, 5 do
        local item = team_object[i]
        local id = unit_cfg["monster"..i]
        local pos = self:getFormPosByIndex(unit_cfg.formation[1],i)
        if id then
            item:setVisible(true)
            local cfg = Config.UnitData.data_unit(id)
            if cfg then
                local unit_data = {
                    bid = cfg.bid,
                    lev = cfg.lev,
                    star = cfg.star}
                item:setMonsterData(unit_data)
                item:setPosition(self.nine_position_right[pos])
            else
                item:setVisible(false)
            end
        else
            item:setVisible(false)
        end
    end
    --更新位置
    local formation_config = Config.FormationData.data_form_data[unit_cfg.formation[1]]
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        dic_pos_index[pos] = index
        --更新位置
        if team_object[index] then
            team_object[index]:setPosition(self.nine_position_right[pos])
        end
    end

    --没使用的要变灰变暗
    local index = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img_right[index]:setPosition(self.nine_position_right[pos])
            index = index + 1
            if index > 4 then
                break
            end
        end
    end
end

-- 更新left战力、阵营信息
function HeavenHighDunGoFightPanel:updateAllTeamInfo(  )
    self:updateTeamInfo()
end

-- 更新队伍的信息
function HeavenHighDunGoFightPanel:updateTeamInfo( )
    local team_object = self.hero_item_list_left
    if not team_object then return end

    -- 战力
    local power_num = 0
    local dic_camp = {}
    for k,item in pairs(team_object) do
        local hero_vo = item:getData()
        if hero_vo then
            power_num = power_num + (hero_vo.power or 0)
            local config = Config.PartnerData.data_partner_base[hero_vo.bid] 
            if config and config.camp_type then
                if dic_camp[config.camp_type] == nil then
                    dic_camp[config.camp_type] = 1
                else
                    dic_camp[config.camp_type] = dic_camp[config.camp_type] + 1
                end
            end
        end
    end
    self.fight_label:setNum(power_num)
    local form_id_list = BattleController:getInstance():getModel():getFormIdListByCamp(dic_camp)
    self.halo_form_id_list = form_id_list
    local halo_icon_config, alien_effect = BattleController:getInstance():getModel():getCampIconConfigByIds(form_id_list)
    if halo_icon_config then
        local halo_res = PathTool.getCampGroupIcon(halo_icon_config.icon)
        self.halo_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_load)
        addCountForCampIcon(self.halo_btn, halo_icon_config.nums)
        if self.halo_btn and self.halo_btn.top_num_txt and self.halo_btn.top_sp then
            self.halo_btn.top_num_txt:setVisible(false)
            self.halo_btn.top_sp:setVisible(false)
        end
        if self.halo_btn and self.halo_btn.bottom_num_txt and self.halo_btn.bottom_sp then
            self.halo_btn.bottom_num_txt:setVisible(false)
            self.halo_btn.bottom_sp:setVisible(false)
        end
        if self.halo_btn and self.halo_btn.bottom_num_txt2 and self.halo_btn.bottom_sp2 then
            self.halo_btn.bottom_num_txt2:setVisible(false)
            self.halo_btn.bottom_sp2:setVisible(false)
        end
        self.halo_label:setString("")
        self:updateEffect(true, halo_res, alien_effect)
    else
        local halo_res = PathTool.getCampGroupIcon(1000)
        self.halo_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_load)
        addCountForCampIcon(self.halo_btn)
        self.halo_label:setString(TI18N("语言_c_3170"))
        self:updateEffect(false, halo_res)
    end

    --神器
    local hallows_config = Config.HallowsData.data_base[self.hallows_id]
    if hallows_config then
        self.hallow_item:showAddIcon(false)
        local hallows_vo = HallowsController:getInstance():getModel():getHallowsById(self.hallows_id)
        if hallows_vo and hallows_vo.look_id ~= 0 then
            local magic_cfg = Config.HallowsData.data_magic[hallows_vo.look_id]
            if magic_cfg then
                self.hallow_item:setBaseData(magic_cfg.item_id)
                self.hallow_item:setMagicIcon(true)
            else
                self.hallow_item:setBaseData(hallows_config.item_id)
                self.hallow_item:setMagicIcon(false)
            end
        else
            self.hallow_item:setBaseData(hallows_config.item_id)
            self.hallow_item:setMagicIcon(false)
        end
    else
        self.hallow_item:setData()
        self.hallow_item:showAddIcon(true)
    end
    self:setTipsPanel()
    self:initSpSkillInfoList(self.team_index)
end

--播放特效
function HeavenHighDunGoFightPanel:updateEffect(status, halo_res, alien_effect)
    if status then
        if self.select == nil then
            local x, y = self.halo_btn:getPosition()
            self.select = createImage(self.btn_scroll, PathTool.getResFrame("common", "common_1101"), x, y, cc.p(0.5, 0.5), true)
            self.select:setCascadeOpacityEnabled(true)
            self.select:setScale(0.8)
        else
            self.select:setVisible(true)
        end
        if not self.select.alien then
            local size = self.select:getContentSize()
            local alien_res = PathTool.getCampGroupIcon("2001")
            self.select.alien = createImage(self.select, "", size.width/2, size.height/2, cc.p(0.5, 0.5), false)
            loadImageTextureFromCDN(self.select.alien, alien_res, ResourcesType.single)
            self.select.alien:setVisible(false)
        end
        self.select.alien:setVisible(alien_effect and alien_effect ~= "")

        local fadein = cc.FadeIn:create(0.6)
        local fadeout = cc.FadeOut:create(0.6)
        self.select:runAction(cc.RepeatForever:create(cc.Sequence:create(fadein, fadeout)))
    else
        if self.select then
            doStopAllActions(self.select)
            self.select:setVisible(false)
        end
    end
end

function HeavenHighDunGoFightPanel:updateFormationData(is_fixed)
    local formation_config = Config.FormationData.data_form_data[self.formation_type]
    local dic_pos_index = {}
    self.pos_name_list = {}
    self.pos_rect_list = {}
    local width = self.cell_width - 10
    --改变锁定忍者的位置
    local target_item = nil
    local new_pos = 4
    
    if self.team_data_list[self.team_index] then
        for i,hero_item in ipairs(self.hero_item_list_left) do
            local hero_vo = hero_item:getData()
            local extend = hero_item:getExtendData()
            if hero_vo and hero_vo.is_init_lock then
                target_item = hero_item
                break
            end
        end
    end
    if is_fixed then
        target_item = nil
    end
    for i,v in ipairs(formation_config.pos) do
        local index = v[1] 
        local pos = v[2] 
        dic_pos_index[pos] = index
        --更新位置
        if self.hero_item_list_left[index] then
            self.hero_item_list_left[index]:setPosition(self.nine_position[pos])
            self.hero_item_list_left[index]:setExtendData({scale = 1, can_click = true, pos_id = pos})

            if target_item and pos == new_pos then
                local item = self.hero_item_list_left[index]
                local change_hero_vo = item:getData()
                item:setData(target_item:getData())
                target_item:setData(change_hero_vo)
            end
        end
        local world_pos = self.hero_item_list_left[index]:convertToWorldSpace(cc.p(0, 0))
        local node_pos = self.main_container:convertToNodeSpace(world_pos)
        local rect = cc.rect( node_pos.x, node_pos.y, HeroExhibitionItem.Width*0.7, HeroExhibitionItem.Height*0.7)
        self.item_rect_list[i] = rect
    end

    --没使用的要变灰变暗
    local index = 1
    for pos=1,9 do
        if dic_pos_index[pos] == nil then
            self.four_blank_img_left[index]:setPosition(self.nine_position[pos])
            index = index + 1
            if index > 4 then
                break
            end
        end
    end
    self:updateFormationIcon()
end

--更新阵法item
function HeavenHighDunGoFightPanel:updateFormationIcon()
    if not self.formation_type  then return end

    local res = PathTool.getResFrame("form", "form_icon_"..self.formation_type)
    loadSpriteTexture(self.form_icon, res, LOADTEXT_TYPE_PLIST)
    self:setTipsPanel()
end

-- 更新精灵
function HeavenHighDunGoFightPanel:updateElfinList()
    if not self.elfin_btn then return end

    local elfin_bid_list = {}
    if self.elfin_data and self.elfin_data.team_list then
        for key, value in pairs(self.elfin_data.team_list) do
            if value.team == self.team_index then
                elfin_bid_list = value.sprites
            end
        end
    end

    local function getElfinBidByPos( pos )
        local elfin_bid
        for k,v in pairs(elfin_bid_list) do
            if v.pos == pos then
                elfin_bid = v.item_bid
                break
            end
        end
        return elfin_bid
    end
    for i=1,4 do
        local elfin_bid = getElfinBidByPos(i)
        local elfin_item = self.elfin_item_list[i]
        if elfin_item == nil then
            elfin_item = SkillItem.new(true, false, true, 0.4)
            local pos_x = 20
            local pos_y = 66
            if i == 3 or i == 4 then
                pos_y = 18
            end
            if i == 2 or i == 4 then
                pos_x = 68
            end
            elfin_item:setPosition(cc.p(pos_x, pos_y))
            self.elfin_btn:addChild(elfin_item)
            self.elfin_item_list[i] = elfin_item
        end
        local item_bid = ElfinController:getInstance():getModel():getElfinItemByPos(i)
        if item_bid then
            local bid = elfin_bid or 0
            elfin_item:showLockIcon(false)
            local elfin_cfg = Config.SpriteData.data_elfin_data(bid)
            if bid == 0 or not elfin_cfg then -- 已解锁，但未放置精灵
                elfin_item:setData()
            else
                local skill_cfg = Config.SkillData.data_get_skill(elfin_cfg.skill)
                if skill_cfg then
                    elfin_item:setData(skill_cfg)
                end
            end
        else
            elfin_item:setData()
            elfin_item:showLockIcon(true)
        end
    end
    if self.condition_status then
        self:setPosTipColor()
    else
        self:setHeavenPosTipColor()
    end
end

-- 移动英雄item
function HeavenHighDunGoFightPanel:onClickHeroItemMove( sender, hero_vo )
    if not self.move_hero_item then
        self.move_hero_item = HeroExhibitionItem.new(0.7, false)
        self.main_container:addChild(self.move_hero_item)
    end
    if not self.move_hero_vo and hero_vo then
        self.move_hero_vo = hero_vo
        sender:setData()
        self.move_hero_item:setData(hero_vo)
        self.move_hero_item:setChosenImg(0)
    end
    local touch_pos = sender:getTouchMovePosition()
    local target_pos = self.main_container:convertToNodeSpace(touch_pos)
    self.move_hero_item:setPosition(target_pos)
end

function HeavenHighDunGoFightPanel:onClickHeroItemCanceled( sender )
    if self.move_hero_item and self.move_hero_vo then
        local touch_pos = sender:getTouchMovePosition()
        local target_pos = self.main_container:convertToNodeSpace(touch_pos) 
        local is_have = false
        for index,rect in ipairs(self.item_rect_list) do
            if cc.rectContainsPoint( rect, target_pos ) then
                local hero_item = self.hero_item_list_left[index]
                if hero_item and not self:checkIsHaveSameHeroInOneTeam(self.move_hero_vo) then
                    is_have = true
                    self.is_show_act = true
                    local world_pos = hero_item:convertToWorldSpace(cc.p(0, 0))
                    local item_pos = self.main_container:convertToNodeSpace(world_pos) 
                    local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(item_pos.x+41.5, item_pos.y+41.5))
                    local call_back = function (  )
                        self.move_hero_item:setData()
                        self.move_hero_item:setPosition(cc.p(-1000, -1000))
                        local hero_vo = hero_item:getData()
                        sender:setData(hero_vo)
                        sender:setChosenImg(0)
                        hero_item:setData(self.move_hero_vo)
                        hero_item:setChosenImg(0)
                        self:changeHeroPOS(hero_vo,self.move_hero_vo,index)
                        self.move_hero_vo = nil
                        self:updateAllTeamInfo()
                        self.is_show_act = false
                    end
                    self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
                end
                break
            end
        end
        if not is_have then
            self:onClickHeroItemEnd(sender)
        end
    end
end

function HeavenHighDunGoFightPanel:changeHeroPOS(hero_vo, move_hero_vo,index)
    local sub_id = hero_vo and hero_vo.point_id or move_hero_vo.point_id
    local id = hero_vo and hero_vo.partner_id
    local move_id = move_hero_vo and move_hero_vo.partner_id
    local pos = 0
    local move_pos = 0
    for key, value in pairs(self.team_data_list) do
        if value.order == sub_id then
            if id then
                for k, v in pairs(value.pos_info) do
                    if v.id == id then
                        pos = v.pos
                    end
                    if v.id == move_id then
                        move_pos = v.pos
                    end
                end
                for k, v in pairs(value.pos_info) do
                    if v.pos == pos then
                        v.id = move_id
                    end
                    if v.pos == move_pos then
                        v.id = id
                    end
                end
            else
                for k, v in pairs(value.pos_info) do
                    if v.id == move_id then
                        v.pos = index
                    end
                end
            end
        end
    end
end

function HeavenHighDunGoFightPanel:onClickHeroItemEnd( sender )
    if self.move_hero_item then
        self.is_show_act = true
        local world_pos = sender:convertToWorldSpace(cc.p(0, 0))
        local target_pos = self.main_container:convertToNodeSpace(world_pos) 
        local act_1 = cc.MoveTo:create(CrossarenaConst.Form_Act_Time, cc.p(target_pos.x+41.5, target_pos.y+41.5))
        local call_back = function (  )
            self.move_hero_item:setData()
            self.move_hero_item:setPosition(cc.p(-1000, -1000))
            if self.move_hero_vo then
                sender:setData(self.move_hero_vo)
                sender:setChosenImg(0)
                self.move_hero_vo = nil
            end
            self.is_show_act = false
        end
        self.move_hero_item:runAction(cc.Sequence:create(act_1, cc.CallFunc:create(call_back)))
    end
end

function HeavenHighDunGoFightPanel:checkTargetTipsDo(condition,index)
    local index = index or self.team_index
    local status = 1
    local num = 0
    local targetNum = condition[1][3]
    local elfin_data = {}
    if self.elfin_data then
        for k, v in pairs(self.elfin_data.team_list) do
            if v.team == index then
                elfin_data = v.sprites
            end
        end
    end
    if condition[1][1] == "hallows_pet" then --携带x宠物神器过关 指定神器、宠物 神器0为不判断 宠物空列表为不判断
        if condition[1][2] ~= 0 and next(condition[1][3]) then
            local n = 0
            for k, v in pairs(elfin_data) do
                if table.indexof(condition[1][3],v.item_bid) then
                    n = n + 1
                end
            end
            if self.team_data_list[index].hallows_id == condition[1][2] then
                n = n + 1
            end
            if n >= 2 then
                status = 2
                return status
            end
        elseif condition[1][2] == 0 then
            for k, v in pairs(elfin_data) do
                if table.indexof(condition[1][3],v.item_bid) then
                    status = 2
                    return status
                else
                    status = 1
                end
            end
        elseif not next(condition[1][3]) then
            if self.team_data_list[index].hallows_id == condition[1][2] then
                status = 2
                return status
            else
                status = 1
            end
        end
    end
    if condition[1][1] == "hero_list" then --携带x忍者+x忍者+x忍者 指定忍者+指定忍者+指定忍者+......
        local num = 0
        for i, v in pairs(self.team_data_list[index].pos_info) do
            local hero_vo = HeroController:getInstance():getModel():getHeroById(v.id)
            if table.indexof(condition[1][2],hero_vo.bid) then
                num = num + 1
            end
        end
        if num >= tableLen(condition[1][2]) then
            status = 2
            return status
        else
            status = 1
        end
    end
    for i, v in pairs(self.team_data_list[index].pos_info) do
        local hero_vo = HeroController:getInstance():getModel():getHeroById(v.id)
        if condition[1][1] == "combat_result" then --战斗胜利 1 胜利
        elseif condition[1][1][1] == "combat_camp_type" then --阵营 水火风阳阴 camp_type
            if hero_vo.camp_type == condition[1][1][2] then
                num = num + 1
            end
        elseif condition[1][1][1] == "career_type" then --职业 远程 近程 防御 辅助 type
            if hero_vo.type == condition[1][1][2] then
                num = num + 1
            end
        elseif condition[1][1] == "formation_type" then --阵位 
            local cfg = Config.FormationData.data_form_data[self.team_data_list[index].formation_type]
            if cfg.type == condition[1][3] then
                status = 2
            else
                status = 1
            end
        elseif condition[1][1] == "combat_order" then -- 战斗时间
        elseif condition[1][1] == "dead_num" then --阵亡数量
        elseif condition[1][1] == "attk_hp_per" then --存活忍者血量
        elseif condition[1][1] == "server_time" then --服务器时间
        elseif condition[1][1] == "hero_camp_star_career" then --携带x星的x过关  指定忍者id、属性、星级、职业  星级>= 
            if condition[1][2] ~= 0 then
                if hero_vo.bid == condition[1][2] and hero_vo.star >= condition[1][4] then
                    status = 2
                    return status
                else
                    status = 1
                end
            else
                if (condition[1][3] == 0 or condition[1][3] ~= 0 and condition[1][3] == hero_vo.camp_type) and (condition[1][4] == 0 or condition[1][4] ~= 0 and hero_vo.star >= condition[1][4]) and (condition[1][5] == 0 or condition[1][5] ~= 0 and condition[1][5] == hero_vo.type) then
                    status = 2
                    return status
                else
                    status = 1
                end
            end
        elseif condition[1][1] == "hero_pos" then --x忍者站在x位置过关 指定忍者+指定阵位
            if hero_vo.bid == condition[1][2] then
                local cfg = Config.FormationData.data_form_data[self.team_data_list[index].formation_type]
                local pos = 0
                if cfg then
                    for key, value in pairs(cfg.pos) do
                        if value[1] == v.pos then
                            pos = value[2]
                        end
                    end
                    if table.indexof(condition[1][3],pos) then
                        status = 2
                        return status
                    else
                        status = 1
                    end
                end
            end
        elseif condition[1][1] == "hero_equip" then --某个忍者携带x神装套装（一套4件）过关  指定某个人携带某神装
            if hero_vo.bid == condition[1][2] then
                local n = 0
                for k, v in pairs(hero_vo.holy_eqm_list) do
                    if v.config then
                        if v.config.id and table.indexof(condition[1][3],v.config.id) then
                            n = n + 1
                        end
                    end
                end
                if n >= tableLen(condition[1][3]) then
                    status = 2
                    return status
                else
                    status = 1
                end
            end
        end
    end
    local condition_t = condition[1][2]
    if condition_t == "==" then
        if num == targetNum then
            status = 2
        end
    elseif condition_t == '>=' then
        if num >= targetNum then
            status = 2
        end
    elseif condition_t == "=<" then
        if num <= targetNum then
            status = 2
        end
    end
    return status
end
--龙地洞通关条件刷新
function HeavenHighDunGoFightPanel:setHeavenPosTipColor()
    if self.condition then
        if #self.hero_item_list_left ~= 0 then
            for i, v in ipairs(self.condition) do
                setChildUnEnabled(self:checkTargetTipsDo(v) ~= 2,self.pos_tip_list[i])
            end
        end
    end
end
--龙地洞通关条件刷新
function HeavenHighDunGoFightPanel:setPosTipColor()
    if self.condition then
        local status = 2
        if #self.hero_item_list_left ~= 0 then
            for i, v in ipairs(self.condition) do
                status = self:checkTargetTipsDo(v)
                if status == 1 then
                    break
                end
            end
        end
        if status == 2 then
            self.pos_tips:setTextColor(cc.c3b(14,168,14))
        else
            self.pos_tips:setTextColor(cc.c3b(201,38,6))
        end
    end
end

function HeavenHighDunGoFightPanel:onClickBtnHeavenTip(  )
    if not self.heavne_tip_bg then
        self.heavne_tip_bg = ccui.Layout:create()
        self.heavne_tip_bg:setAnchorPoint(cc.p(0.5, 0.5))
        self.heavne_tip_bg:setTouchEnabled(true)
        self.heavne_tip_bg:setContentSize(cc.size(2000, 2000))
        self.heavne_tip_bg:setPosition(cc.p(self.main_container:getContentSize().width*0.5,0))
        self.main_container:addChild(self.heavne_tip_bg)
        registerButtonEventListener(self.heavne_tip_bg, handler(self, function()
            if self.heavne_tip_bg then
                self.heavne_tip_bg:setVisible(false)
            end
        end),true, 1)
    end
    if not self.heavne_panle_bg then
        local res = PathTool.getResFrame("common_2", "tips_6")
        self.heavne_panle_bg = createImage(self.heavne_tip_bg,res,self.heavne_tip_bg:getContentSize().width*0.5,self.heavne_tip_bg:getContentSize().height*0.5,cc.p(0.5,0.5),true,nil,true)
        self.heavne_panle_bg:setTouchEnabled(true)
    end
    self.heavne_tip_bg:setVisible(true)
    if not self.heaven_scroll_panel then
        self.heaven_scroll_panel = createScrollView(420,100,self.heavne_tip_bg:getContentSize().width*0.5,self.heavne_tip_bg:getContentSize().height*0.5,self.heavne_tip_bg)
        self.heaven_scroll_panel:setAnchorPoint(cc.p(0.5, 0.5))
    end
    if not self.heavne_tip_panel then
        self.heavne_tip_panel = ccui.Layout:create()
        self.heavne_tip_panel:setAnchorPoint(cc.p(0.5, 0.5))
        self.heavne_tip_panel:setPosition(cc.p(self.heaven_scroll_panel:getContentSize().width*0.5,self.heaven_scroll_panel:getContentSize().height*0.5))
        self.heavne_tip_panel:setContentSize(cc.size(420, 50))
        self.heaven_scroll_panel:addChild(self.heavne_tip_panel)
    end
    self.heavne_tip_panel:setVisible(true)
    if not self.heaven_limit then
        self.heaven_limit = {}
    end
    local id = {}
    local num = {}
    local condition = {}
    local cfg = Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id]
    for key, value in pairs(cfg.is_show) do
        for k, v in pairs(value[2]) do
            if v[2] == 1 then
                if not num[key] then
                    num[key] = {}
                end
                table.insert(num[key], v[1])
            end
        end
    end
    for a, b in pairs(num) do
        for key, value in pairs(cfg.cond_info) do
            if a == value[1] then
                for i, j in pairs(b) do
                    for k, v in pairs(value[2]) do
                        if j == v[1] then
                            if not id[a] then
                                id[a] = {}
                            end
                            table.insert(id[a],v[2])
                            if not condition[a] then
                                condition[a] = {}
                            end
                            table.insert(condition[a],Config.DungeonHeavenAdvanceData.data_star_cond[v[2]].condition)
                        end
                    end
                end
            end
        end
    end
    local _h = 40
    for i = 1, tableLen(id) do
        if not self.heaven_limit[i] then
            self.heaven_limit[i] = {}
        end
        for j = 0, tableLen(id[i]) do
            local txt = string.format(TI18N("语言_c_2023"),i)
            if id[i][j] then
                txt = Config.DungeonHeavenAdvanceData.data_star_cond[id[i][j]].type
            end
            if self.heaven_limit[i][j] then
                self.heaven_limit[i][j]:setString(txt)
            else
                self.heaven_limit[i][j] = createLabel(20,cc.c3b(0x69,0x5b,0x50),nil,20,0,txt,self.heavne_tip_panel,0,cc.p(0,1))
                self.heaven_limit[i][j]:setWidth(380)
            end
            if condition[i][j] then
                if self:checkTargetTipsDo(condition[i][j],i) == 2 then
                    self.heaven_limit[i][j]:setTextColor(cc.c3b(0xe0,0xbf,0x98))
                else
                    self.heaven_limit[i][j]:setTextColor(cc.c3b(0x69,0x5b,0x50))
                end
            else
                self.heaven_limit[i][j]:setTextColor(cc.c3b(0xff,0xbb,0x2a))
            end
            _h = _h + self.heaven_limit[i][j]:getContentSize().height + 10
        end
    end
    local max_h = math.min(500, _h)
    self.heaven_scroll_panel:setContentSize(cc.size(self.heavne_tip_panel:getContentSize().width,max_h))
    self.heaven_scroll_panel:setInnerContainerSize(cc.size(self.heavne_tip_panel:getContentSize().width,_h))
    self.heavne_tip_panel:setContentSize(cc.size(self.heavne_tip_panel:getContentSize().width,_h))
    self.heavne_panle_bg:setContentSize(cc.size(self.heavne_tip_panel:getContentSize().width,max_h+20))
    self.heavne_tip_panel:setPosition(cc.p(self.heaven_scroll_panel:getContentSize().width*0.5,_h*0.5))
    _h = _h - 20
    for i = 1, tableLen(self.heaven_limit) do
        for j = 0, tableLen(self.heaven_limit[i])-1 do
            self.heaven_limit[i][j]:setPosition(cc.p(10,_h))
            _h = _h - self.heaven_limit[i][j]:getContentSize().height-10
        end
    end
end

function HeavenHighDunGoFightPanel:__delete(  )
    HeroController:getInstance():getModel():setBossFormPoint()
    local data = self.team_data_list
    local count=0
    for i, v in pairs(data) do
        if #v.pos_info>0 then
            count=count+1
        end
    end
    if count<#self.dunlist then
       message(TI18N("语言_dun_he_09_17"))
       return
    end
    HeavenHighController:getInstance():sender25246(data)
    _hero_controller:sender11216(self.fun_form_type,self.sp_data.formations)
    if self.hero_item_list_left then
        for _,item in pairs(self.hero_item_list_left) do
            item:setData()
            item:DeleteMe()
            item = nil
        end
        self.hero_item_list_left = {}
    end
    if self.fight_label then
        self.fight_label:DeleteMe()
    end
    self.fight_label = nil
    if self.hallow_item then
        self.hallow_item:DeleteMe()
        self.hallow_item = nil
    end
    if self.dunlist then
        for _,item in pairs(self.dunlist) do
            item:DeleteMe()
            item = nil
        end
        self.dunlist = {}
    end
    if self.halo_load then
        self.halo_load:DeleteMe()
        self.halo_load = nil
    end
    if self.move_hero_item then
        self.move_hero_item:DeleteMe()
        self.move_hero_item = nil
    end
end