local _hero_controller = HeroController:getInstance()
local _table_insert = table.insert
local controller = HeavenHighController:getInstance()
local model = controller:getModel()

HeavenHighDunGoFightPanel = HeavenHighDunGoFightPanel or BaseClass(BaseView)

function HeavenHighDunGoFightPanel:__init(parent, super_panel, form_show_type, fun_form_type)
    self.view_tag = ViewMgrTag.WIN_TAG
    self.is_full_screen = false
    self.win_type = WinType.Big
    self.is_init = true
    self.parent = parent
    self.super_panel = super_panel
    self.form_show_type = form_show_type
    self.fun_form_type = fun_form_type or 1
    self.halo_load = nil
    self.is_move_hero = false -- move_item 正在跟随手指移动中
    self.is_show_act = false  -- move_item 是否在移动动作中

    --英雄对象 left
    self.hero_item_list_left = {}
    self.plan_id = 0 --精灵方案
    self.hallows_id = 0  --神器id
    self.formation_type = 1 --默认阵法
    --英雄对象 right
    self.hero_item_list_right = {}

    --四个空白图片
    self.four_blank_img_left = {}
    self.four_blank_img_right = {}

    self.item_rect_list = {} --记录格子的区域

    self.halo_form_id_list = {}

    self.team_data_list = {}

    self.elfin_item_list = {} --精灵

    self.cell_width = 134

    self.team_index = 1
    
    self.btn_list = {}

    self.pos_tip_list = {}
    
    self.tip_list_pos = {
        [1] = {cc.p(0,0)},
        [2] = {cc.p(-28,0),cc.p(28,0)},
        [3] = {cc.p(-56,0),cc.p(0,0),cc.p(56,0)},
    }

    self.nine_position = {
        [1] = cc.p(self.cell_width, -self.cell_width),
        [2] = cc.p(self.cell_width, 0),
        [3] = cc.p(self.cell_width, self.cell_width),
        [4] = cc.p(0, -self.cell_width),
        [5] = cc.p(0, 0),
        [6] = cc.p(0, self.cell_width),
        [7] = cc.p(-self.cell_width, -self.cell_width),
        [8] = cc.p(-self.cell_width, 0),
        [9] = cc.p(-self.cell_width, self.cell_width),
    }

    self.nine_position_right = {
        [7] = cc.p(self.cell_width, -self.cell_width),
        [8] = cc.p(self.cell_width, 0),
        [9] = cc.p(self.cell_width, self.cell_width),
        [4] = cc.p(0, -self.cell_width),
        [5] = cc.p(0, 0),
        [6] = cc.p(0, self.cell_width),
        [1] = cc.p(-self.cell_width, -self.cell_width),
        [2] = cc.p(-self.cell_width, 0),
        [3] = cc.p(-self.cell_width, self.cell_width),
    }
    self.halo_num = PotentialController:getInstance():getModel():getHaloNum()
    self:createRoorWnd()
    self:registerEvent()
    self:updateBtnList()
end

function HeavenHighDunGoFightPanel:createRoorWnd(  )
	self.root_wnd = createCSBNote(PathTool.getTargetCSB("battledrama/battle_darma_dun_go_fight_panel"))
    if not tolua.isnull(self.parent) then
        self.root_wnd:setPosition(cc.p(-5, 350))
        self.parent:addChild(self.root_wnd)
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    local form_panel = self.main_container:getChildByName("form_panel")
    self.form_panel = form_panel
    local analyzeFormUI = function(node, hero_item_list, four_blank_img, station)
        local pos = {2,4,6,7,9}--一开始默认 第一个阵法位置
        local nine_position = self.nine_position --默认是左边
        if station == "right" then
            nine_position = self.nine_position_right
        end
        for index=1,5 do
            if station == "right" then
                hero_item_list[index] = HeroExhibitionItem.new(1, true)
                hero_item_list[index]:setExtendData({from_type = HeroConst.ExhibitionItemType.eLegendTrial})
                hero_item_list[index]:addCallBack(function(_,data)
                    self:onClickItem(data, "right")
                end)
            else
                hero_item_list[index] = HeroExhibitionItem.new(1, false)
            end
            hero_item_list[index]:setPosition(nine_position[pos[index]])
            node:addChild(hero_item_list[index])
            local world_pos = hero_item_list[index]:convertToWorldSpace(cc.p(0, 0))
            local node_pos = self.main_container:convertToNodeSpace(world_pos)
            _table_insert(self.item_rect_list, cc.rect( node_pos.x, node_pos.y, HeroExhibitionItem.Width*0.7, HeroExhibitionItem.Height*0.7))
        end
        for i=1,4 do
            four_blank_img[i] = node:getChildByName("hero_info_21_"..i) 
        end
    end
    local fight_hero_node_left = form_panel:getChildByName("fight_hero_node_left")
    analyzeFormUI(fight_hero_node_left, self.hero_item_list_left, self.four_blank_img_left, "left")
    self.fight_hero_node_left = fight_hero_node_left
    local fight_hero_node_right = form_panel:getChildByName("fight_hero_node_right")
    analyzeFormUI(fight_hero_node_right, self.hero_item_list_right, self.four_blank_img_right, "right")
    self.fight_hero_node_right = fight_hero_node_right
    self.dunlist={}
    --妙木山关卡条件显示
    self.heaven_tip = form_panel:getChildByName("heaven_tip")
    if self.heaven_tip then
        self.heaven_tip:getChildByName("label"):setString(TI18N("语言_c_6462"))
        setTextMaxWidth(self.heaven_tip:getChildByName("label"), 100)
        self.heaven_tip:setVisible(false)
    end
    self.top_panel = form_panel:getChildByName("top_panel")
    self.line=self.top_panel:getChildByName("bottom_bg")
    self.linWid=self.line:getContentSize().width 
    self.orginx=self.top_panel:getPositionX()
    self.btn_scroll = form_panel:getChildByName("btn_scroll")
    self.btn_scroll:setScrollBarEnabled(false)
    --阵法
    self.form_change_btn = self.btn_scroll:getChildByName("form_change_btn")
    self.form_change_btn:getChildByName("label"):setString(TI18N("语言_c_1966"))
    --阵法icon
    self.form_icon = self.form_change_btn:getChildByName("form_icon")
    --光环icon
    self.halo_btn = self.btn_scroll:getChildByName("halo_btn")
    self.halo_label = self.halo_btn:getChildByName("label")
    --sp光环icon
    self.sp_btn = self.btn_scroll:getChildByName("sp_btn")
    self.sp_skill = self.sp_btn:getChildByName("sp_skill")
    self.sp_label = self.sp_btn:getChildByName("label")
    self.sp_label:setString(TI18N("语言_c_6756"))
        --穿戴
    self.equip_btn = form_panel:getChildByName("equip_btn")

    local size = self.equip_btn:getContentSize()
    self.hallow_item = BackPackItem.new(false, false, false, 0.8)
    self.hallow_item:showAddIcon(true)
    self.hallow_item:setPosition(cc.p(size.width * 0.5, size.height * 0.5))
    self.equip_btn:addChild(self.hallow_item)
    self.equip_btn_label = self.equip_btn:getChildByName("label")
    self.equip_btn_label:setString(TI18N("语言_c_3148"))
    setTextMaxWidth(self.equip_btn_label,100) 
    setTextSpacing(self.equip_btn_label,-10)
    -- 精灵
    self.Panel_1 = form_panel:getChildByName("Panel_1")
    self.change_btn = form_panel:getChildByName("change_btn")
    self.change_btn:setVisible(false)
    self.elfin_btn = self.Panel_1:getChildByName("elfin_btn")
    if self.elfin_btn then
        local elfin_label=self.elfin_btn:getChildByName("label")
        elfin_label:setString(TI18N("语言_c_3149"))
        setTextMaxWidth(elfin_label,100)
        setTextSpacing(elfin_label,-10)
    end
    self.pos_tips = form_panel:getChildByName("pos_tips")
    self.pos_tips_panel = form_panel:getChildByName("pos_tips_panel")
    for i = 1, 3 do
        self.pos_tip_list[i] = self.pos_tips_panel:getChildByName("pos_tips_"..i)
        self.pos_tip_list[i]:setVisible(false)
    end
    self.pos_tips_panel:setVisible(false)
    self.label_power_left = form_panel:getChildByName("label_power_left")
    self.label_power_right = form_panel:getChildByName("label_power_right")
    -- self.label_power = form_panel:getChildByName("label_power")
    -- self.label_power:setString(TI18N("语言_c_5812"))
    self.go_fight_btn = form_panel:getChildByName("go_fight_btn")
    self.go_fight_btn:getChildByName("label"):setString(TI18N("语言_c_444"))
    self.go_fight_btn:setPositionY(-450)
    self.save_btn = form_panel:getChildByName("save_btn")
    self.save_btn:getChildByName("label"):setString(TI18N("语言_c_443"))
    self.save_btn:setPositionY(-450)
    -- self.save_btn:setVisible(false)
    self.power_click = form_panel:getChildByName("power_click")
    self.fight_label = CommonNum.new(20, self.power_click, 99999, - 2, cc.p(0.5, 0.5),4)
    self.fight_label:setPosition(103, 35)
    self.fight_label:setScale(1.4)
end

function HeavenHighDunGoFightPanel:onClickItem(item_data, state)
    if not item_data then
        return 
    end
end
function HeavenHighDunGoFightPanel:updateBtnList()
    local num = 1
    self.btn_list[1] = self.halo_btn
    self.halo_btn:setVisible(true)
    num = num + 1
    self.btn_list[2] = self.form_change_btn
    self.form_change_btn:setVisible(true)
    --sp光环技能
    if not HeroController:getInstance():getModel():getSpecialHeroHuanShield() then
        self.sp_btn:setVisible(false)
    else
        self.sp_btn:setVisible(true)
        num = num + 1
        self.btn_list[num] = self.sp_btn
    end
    local _w = math.max(self.btn_scroll:getContentSize().width,num*100+20)
    self.btn_scroll:setInnerContainerSize(cc.size(_w,self.btn_scroll:getContentSize().height))
    for i = 1, num do
        self.btn_list[i]:setPositionX(10 + i*100 - 50)
    end
end

function HeavenHighDunGoFightPanel:registerEvent(  )
    registerButtonEventListener(self.form_change_btn, handler(self, self.onClickFormChangeBtn) ,true, 1)
    registerButtonEventListener(self.halo_btn, handler(self, self.onClickHaloBtn) ,true, 1)
    registerButtonEventListener(self.equip_btn, handler(self, self.onClickEquipBtn) ,true, 1)
    registerButtonEventListener(self.elfin_btn, handler(self, self.onClickElfinBtn), true, 1)
    registerButtonEventListener(self.go_fight_btn, handler(self, self.onClickGoFightBtn), true, 2)
    registerButtonEventListener(self.save_btn, handler(self, self.onClickGoSaveBtn), true, 2)
    registerButtonEventListener(self.heaven_tip, handler(self, self.onClickBtnHeavenTip), true, 2)
    registerButtonEventListener(self.sp_btn, handler(self, self.onClickSPBtn) ,true, 1)
    
    self:addGlobalEvent(ElfinEvent.Elfin_Plan_From_Info_Event, function (data)
        if data.type == PartnerConst.Fun_Form.Heaven_high then
            self.elfin_data = data
            self:updateElfinList()
        end
    end)
    --sp光环获取
    self:addGlobalEvent(HeroEvent.Hero_Sp_Skill_Send_Event, function (data)
        if not data then return end
        local _data = deepCopy(data)
        if self.sp_data.type == _data.type then
            local status = false
            for k,v in pairs(self.sp_data.formations) do
                if v.order == self.team_index then
                    self.sp_data.formations[k].skill_bid = _data.skill_bid
                    status = true
                    break
                end
            end
            if not status then
                local _list = {}
                _list.order = self.team_index
                _list.skill_bid = _data.skill_bid
                table.insert(self.sp_data.formations,_list)
            end
        end
        self:initSpSkillInfoList(self.team_index)
    end)
    self:addGlobalEvent(HeroEvent.Hero_Sp_Skill_Get_Event, function (data)
        if not data then return end
        local _data = deepCopy(data)
        if _data.type == self.fun_form_type then
            self.sp_data = _data
            self:initSpSkillInfoList(self.team_index)
        end
    end)
    self.long_touch_type = LONG_TOUCH_INIT_TYPE
    for i,item in ipairs(self.hero_item_list_left) do
        item:addTouchEventListener(function(sender, event_type)
            --播放动作中 和 数据为空
            if self.is_show_act == true then return end
            local hero_vo = sender:getData()
            if not hero_vo and not self.is_move_hero then return end
            if event_type == ccui.TouchEventType.began then
                self.touch_move = false
                self.is_move_hero = false
                self.touch_began = sender:getTouchBeganPosition()
                doStopAllActions(self.form_panel)
                self.long_touch_type = LONG_TOUCH_BEGAN_TYPE
                delayRun(self.form_panel, 0.6, function ()
                    if self.long_touch_type == LONG_TOUCH_BEGAN_TYPE then
                        if hero_vo then
                            if hero_vo then--长按
                                HeroController:getInstance():openHeroTipsPanel(true, hero_vo)
                            end
                        end
                    end
                    self.long_touch_type = LONG_TOUCH_END_TYPE
                end)           
            elseif event_type == ccui.TouchEventType.moved then
                if self.long_touch_type == LONG_TOUCH_END_TYPE then
                    --事件触发了就不处理移动事件了
                    return 
                elseif self.long_touch_type == LONG_TOUCH_BEGAN_TYPE then
                    local touch_began = self.touch_began
                    local touch_end = sender:getTouchMovePosition()
                    if touch_began and touch_end and (math.abs(touch_end.x - touch_began.x) > 20 or math.abs(touch_end.y - touch_began.y) > 20) then 
                        --移动大于20了..表示取消长点击效果
                        doStopAllActions(self.form_panel)
                        self.long_touch_type = LONG_TOUCH_CANCEL_TYPE
                    end 
                end
                self.touch_move = true
                self.is_move_hero = true
                self:onClickHeroItemMove(sender, hero_vo)
            elseif event_type == ccui.TouchEventType.canceled then
                if self.long_touch_type == LONG_TOUCH_BEGAN_TYPE then
                    doStopAllActions(self.form_panel)
                    self.long_touch_type = LONG_TOUCH_CANCEL_TYPE
                elseif self.long_touch_type == LONG_TOUCH_END_TYPE then
                    --事件触发了就不处理点击事件了
                    if self.move_hero_item then
                        self.move_hero_item:setPosition(-10000, 0)
                    end
                    if self.move_hero_vo then
                        sender:setData(self.move_hero_vo)
                        self.move_hero_vo = nil
                    end
                    return
                end
                self.is_move_hero = false
                self:onClickHeroItemCanceled(sender)
            elseif event_type == ccui.TouchEventType.ended then
                if self.long_touch_type == LONG_TOUCH_BEGAN_TYPE then
                    doStopAllActions(self.form_panel)
                    self.long_touch_type = LONG_TOUCH_CANCEL_TYPE
                elseif self.long_touch_type == LONG_TOUCH_END_TYPE then
                    --事件触发了就不处理点击事件了
                    if self.move_hero_item then
                        self.move_hero_item:setPosition(-10000, 0)
                    end
                    if self.move_hero_vo then
                        sender:setData(self.move_hero_vo)
                        self.move_hero_vo = nil
                    end
                    return
                end
                self.is_move_hero = false
                self.touch_end = sender:getTouchEndPosition()
                local is_click = true
                if self.touch_began ~= nil then
                    is_click = math.abs(self.touch_end.x - self.touch_began.x) <= 20 and math.abs(self.touch_end.y - self.touch_began.y) <= 20
                end
                if self.touch_move then
                    if is_click then -- 一定小范围内的移动算作点击
                        self.move_hero_item:setData()
                        self.move_hero_item:setPosition(cc.p(-1000, -1000))
                        local temp_hero_vo = self.move_hero_vo
                        if self.move_hero_vo then
                            sender:setData(self.move_hero_vo)
                            self.move_hero_vo = nil
                        end
                        self:onClickHeroItem(i)
                    else
                        self:onClickHeroItemEnd(sender)
                    end
                else
                    self:onClickHeroItem(i)
                end
            end
        end)
    end
end

--sp光环
function HeavenHighDunGoFightPanel:onClickSPBtn()
    local setting = {}
    setting.select_skill = self.sp_data.formations
    setting.order = self.sp_order
    local hero_list = {}
    for k, v in pairs(self.team_data_list[self.team_index].pos_info) do
        local hero_vo = HeroController:getInstance():getModel():getHeroById(v.id)
        table.insert(hero_list, v.pos, hero_vo)
    end
    setting.form_data = hero_list
    _hero_controller:openFormSpMoreSelectPanel(true,self.fun_form_type,setting)
end
--更新sp光环
function HeavenHighDunGoFightPanel:initSpSkillInfoList(index)
    self.sp_order = index
    self.sp_skill_id = 0
    local team_object = self.hero_item_list_left
    local status = false
    for k,item in pairs(team_object) do
        local hero_vo = item:getData()
        if hero_vo then
            local config = Config.PartnerData.data_partner_base[hero_vo.bid] 
            if config and config.score >= 9 then
                status = true
            end
        end
    end
    if self.sp_data and next(self.sp_data) then
        for key,value in pairs(self.sp_data.formations) do
            if value.order == index then
                for k,v in pairs(value.sp_skills) do
                    local sp_status = false
                    for k,item in pairs(team_object) do
                        local hero_vo = item:getData()
                        if hero_vo and hero_vo.id == v.id then
                            sp_status = true
                        end
                    end
                    if not sp_status then
                        v.show_bid = 0
                        v.skill_bid = 0
                    end
                end
            end
        end
        if not status then
            for k,v in pairs(self.sp_data.formations) do
                if v.order == index then
                    self.sp_data.formations[k].sp_skills = {}
                end
            end
        else
            for k,v in pairs(self.sp_data.formations) do
                if v.order == index then
                    if v.sp_skills and next(v.sp_skills) then
                        if tableLen(v.sp_skills) > 1 then
                            table.sort(v.sp_skills,function(a,b) return a.pos < b.pos end)
                        end
                        for key, value in pairs(v.sp_skills) do
                            if self.sp_skill_id == 0 and value.show_bid ~= 0 and value.skill_bid ~= 0 then
                                self.sp_skill_id = value.show_bid
                            end
                        end
                    end
                end
            end
        end
    end
    if not self.mask then
        self.mask = createSprite(PathTool.getResFrame("form", "form_1007"), 39, 39, nil, cc.p(0.5, 0.5))--模板
        self.mask:setScale(self.mask_scale or 1)
    end
    if not self.clipNode then
        self.clipNode = cc.ClippingNode:create(self.mask)
        self.clipNode:setAnchorPoint(cc.p(0.5,0.5))
        self.clipNode:setContentSize(cc.size(78,78))
        self.clipNode:setCascadeOpacityEnabled(true)
        self.clipNode:setPosition(0,0)
        self.clipNode:setAlphaThreshold(0)
        self.sp_skill:addChild(self.clipNode,1)
    end
    if not self.sp_icon then
        self.sp_icon = ccui.ImageView:create()
        self.sp_icon:setCascadeOpacityEnabled(true)
        self.sp_icon:setAnchorPoint(0.5,0.5)
        self.sp_icon:setPosition(39,39)--底板
        self.clipNode:addChild(self.sp_icon,1)
        self.sp_icon:setScale(0.75)
    end
    local skill_config = Config.SkillData.data_get_skill(self.sp_skill_id)
    if skill_config then
        local skill_icon = PathTool.getSkillRes(skill_config.icon, false)
        self.sp_icon:loadTexture(skill_icon, LOADTEXT_TYPE)
        self.sp_icon:setVisible(true)
    else
        self.sp_icon:setVisible(false)
    end
    
    self:updateSpRed()
end
function HeavenHighDunGoFightPanel:updateSpRed()
    local hero_list = {}
    for k, v in pairs(self.team_data_list[self.team_index].pos_info) do
        local hero_vo = HeroController:getInstance():getModel():getHeroById(v.id)
        table.insert(hero_list, v.pos, hero_vo)
    end
    local num = 0
    local sp_num_list = {}
    if self.sp_data and self.sp_data.formations and next(self.sp_data.formations) then
        for _,info in pairs(self.sp_data.formations) do
            if info.order == self.sp_order then
                for k,v in pairs(info.sp_skills) do
                    if v.skill_bid ~= 0 then
                        num = num + 1
                        sp_num_list[v.pos] = v.skill_bid
                    end
                end
            end
        end
    end
    self.sp_label:setString(TI18N("语言_c_6756")..string.format("(%s/%s)",num,self.halo_num))
    local status = HeroController:getInstance():getModel():getSpSkillRed(hero_list,sp_num_list,self.halo_num)
    addRedPointToNodeByStatus(self.sp_btn,status,5,5)
end
function HeavenHighDunGoFightPanel:onClickFormChangeBtn()
    if not self.formation_type then return end
    HeroController:getInstance():openFormationSelectPanel(true, self.formation_type, function(formation_type, team_index)
        if formation_type and not tolua.isnull(self.root_wnd) then
            self.formation_type = formation_type or 1
            self.team_data_list[self.team_index].formation_type=formation_type
            self:updateFormationData()
        end
    end, 1)
end
function HeavenHighDunGoFightPanel:onClickDunBtn(index)
    for i=1,#self.dunlist do
        self.dunlist[i]:setStatus(i==index)
    end
    self.team_index = index
    local pointinfo=self.team_data_list[index]
    if pointinfo then
        local info = {
            index = self.team_index,
            id = self.info.id,
            order_id = self.info.order_id
        }
        local data = {
            formations = self.team_data_list
        }
        self:setData(data, info)
        self.super_panel:undateHeavenHighFormInfo(info)
    end
    self:initSpSkillInfoList(index)
end

function HeavenHighDunGoFightPanel:CreateDunBtn()
    if #self.dunlist>0 then return end
    self.dunlist={}
    local cfg=deepCopy(Config.DungeonHeavenAdvanceData.data_customs[self.info.id][self.info.order_id].unit_id)
    local len=#cfg
    self.len = len
    local startX=0
    for i=1,len do
        local btn=BattleDramaWarDunItem.new()
        btn:setAnchorPoint(cc.p(0.5,0.5))
        self.top_panel:addChild(btn)
        btn:setPosition(startX+(i-1)*100,25)
        registerButtonEventListener(btn.container, function()
            self:onClickDunBtn(i)
        end ,true, 2)
        local list=self.team_data_list[i].pos_info
        local num=0
        for k,v in pairs(list) do
            num=num+1
        end
        btn:setData(i,num)
        self.dunlist[i]=btn
    end
    local wid= self.linWid-(5-len)*100    --self.linWid*((len-1)/4)
    self.line:setContentSize(cc.size(wid,self.line:getContentSize().height))
    self.top_panel:setPositionX(self.orginx+(5-len)*50)
end

function HeavenHighDunGoFightPanel:onClickHaloBtn()
    BattleController:getInstance():openBattleCampView(true, self.halo_form_id_list)
end
function HeavenHighDunGoFightPanel:onClickEquipBtn()
    local dic_equips = {}
    local setting = {
        fun_form_type = self.fun_form_type,
    }
    for i=1,#self.dunlist do
        local pointinfo = {}
        for k, v in pairs(self.team_data_list) do
            if v.order == i then
                pointinfo = v
            end
        end
        if pointinfo and pointinfo.order~=self.team_index and pointinfo.hallows_id and pointinfo.hallows_id ~= 0  then
           dic_equips[pointinfo.hallows_id] = i
        end
    end
    _hero_controller:openFormHallowsSelectPanel(true, self.hallows_id, function(hallows_id, team_index)
        local team_object = self.hero_item_list_left
        local pointData = {} 
        for k, v in pairs(self.team_data_list) do
            if v.order == self.team_index then
                pointData = v
            end
        end
        if hallows_id and team_object then
            if self.hallows_id == hallows_id then
                self.hallows_id = 0
                self.hallow_item:setData()
                self.hallow_item:showAddIcon(true)
            end
            if hallows_id == 0 then
                self.hallows_id = 0
                self.hallow_item:setData()
                self.hallow_item:showAddIcon(true)
            else
                -- 更新选中的神器显示
                local hallows_config = Config.HallowsData.data_base[hallows_id]
                if not hallows_config  then return end
                self.hallows_id = hallows_id
                pointData.hallows_id=hallows_id
                self.hallow_item:showAddIcon(false)
                local hallows_vo = HallowsController:getInstance():getModel():getHallowsById(hallows_id)
                if hallows_vo then
                    local magic_cfg = Config.HallowsData.data_magic[hallows_vo.look_id]
                    if magic_cfg then
                        self.hallow_item:setBaseData(magic_cfg.item_id)
                        self.hallow_item:setMagicIcon(true)
                    else
                        self.hallow_item:setBaseData(hallows_config.item_id)
                        self.hallow_item:setMagicIcon(false)
                    end
                else
                    self.hallow_item:setBaseData(hallows_config.item_id)
                    self.hallow_item:setMagicIcon(false)
                end
                for i=1,#self.dunlist do
                    local pointinfo = {}
                    for k, v in pairs(self.team_data_list) do
                        if v.order == 1 then
                            pointinfo = v
                        end
                    end
                    if pointinfo and pointinfo.order~=pointData.order and pointinfo.hallows_id==hallows_id then
                        for k, v in pairs(self.team_data_list) do
                            if v.order == pointinfo.order then
                                v.hallows_id = 0
                            end
                        end
                    end
                end
            end
            for k, v in pairs(self.team_data_list) do
                if v.order == pointData.order then
                    v.hallows_id = self.hallows_id
                end
            end
            if self.condition_status then
                self:setPosTipColor()
            else
                self:setHeavenPosTipColor()
            end
        end
    end, dic_equips, 1, {}, setting)
end

function HeavenHighDunGoFightPanel:getPlayIndex(plan_id)
    if not self.pointData then
        return 0, {}
    end
    local plan_sprites=self.pointData.plan_sprites
    if plan_sprites and next(plan_sprites)~=nil then
        for i, v in ipairs(plan_sprites) do
            if v.id == plan_id then
                return i, v
            end
        end
    end
    return 0, {}
end

-- 调整精灵
function HeavenHighDunGoFightPanel:onClickElfinBtn(  )
    local elfin_tree_data = ElfinController:getInstance():getModel():getElfinTreeData()
    --古树信息没有回来不给点
    if next(elfin_tree_data) == nil then return end
    local setting = {}
    setting.fun_form_type= PartnerConst.Fun_Form.Heaven_high   --self.pointData.formation_type
    setting.team_index=self.team_index
    self.super_panel:setPlanSettingInfo(setting)
    if setting.cur_plan_data then
        for k, v in pairs(self.elfin_data.team_list) do
            if v.team == self.team_index then
                setting.cur_plan_data.sprites = v.sprites
            end
        end
    end
    ElfinController:getInstance():openElfinFightPlanPanel(true, setting)
end

