local _controller = HeavenHighController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local _string_format = string.format
local _table_sort = table.sort

HeavenHighChapterWindow = HeavenHighChapterWindow or BaseClass(BaseView)

function HeavenHighChapterWindow:__init()
    self.is_full_screen = true
    self.layout_name = "heaven_high/heaven_high_chapter_window"
    self.win_type = WinType.Full  
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("heaven","heaven"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("heaven_ad","heaven_ad"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("heaven_ad","heaven_ad_text"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("bigbg","bigbg_104", true), type = ResourcesType.single },
    }
    self.star_list = {}
    self.gary_star_list = {}
    self.desc_list = {}
    self.customs_item_list = {}
    self.line_node_list = {}
    self.award_box_list = {}
    self.award_item_list = {}
    self.show_customs_num = 0 -- 当前显示的关卡数量
    self.boss_item_list = {}
    self.show_item_list = {}
    self.dunlist={}
    self.boss_unit_bg_list = {}
    self.boss_team_list = {}
    self.unit_cfg_list = {}
    self.detail_list = {}
    self.boss_details_bg_list = {}
    self.boss_details_list = {}

    local sys_ctrl = SysController:getInstance()
    if sys_ctrl:newCheckProtocalIsCanRequest(MainuiConst.functionIdList.highHeaven) then
        _controller:sender25256()
        _controller:sender25254()
        sys_ctrl:setProtocalIsCanRequest(MainuiConst.functionIdList.highHeaven)
    end

    _model:setHeavenHighLoginRed(false)
end

function HeavenHighChapterWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background:loadTexture(PathTool.getPlistImgForDownLoad("bigbg","bigbg_84",true), LOADTEXT_TYPE)
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)

    self.customs_panel = self.main_container:getChildByName("customs_panel")

    local top_panel = self.main_container:getChildByName("top_panel")
    self.arrow_left = top_panel:getChildByName("arrow_left")
    self.arrow_right = top_panel:getChildByName("arrow_right")
    self.wnd_title = top_panel:getChildByName("wnd_title")
    self.btn_rule = top_panel:getChildByName("btn_rule")

    self.award_panel = self.main_container:getChildByName("award_panel")
    local progress_bg = self.award_panel:getChildByName("progress_bg")
    self.progress = progress_bg:getChildByName("progress")
    self.progress:setScale9Enabled(true)
    self.progress:setPercent(0)
    self.star_count = self.award_panel:getChildByName("star_count")
    self.item_1 = self.award_panel:getChildByName("item_1")
    -- self.item_1:getChildByName("scroll")


    local bottom_panel = self.main_container:getChildByName("bottom_panel")
    self.bottom_panel = bottom_panel
    -- self.image_bust = bottom_panel:getChildByName("image_bust")
    -- self.image_bust:ignoreContentAdaptWithSize(true)
    self.first_sp = bottom_panel:getChildByName("first_sp")
    self.btn_check = bottom_panel:getChildByName("btn_check")
    self.add_btn = bottom_panel:getChildByName("add_btn")
    self.challenge_btn = bottom_panel:getChildByName("challenge_btn")
    self.challenge_btn:getChildByName("label"):setString(TI18N("语言_c_457"))
    self.customs_num = bottom_panel:getChildByName("customs_num")
    self.power_txt_txt = bottom_panel:getChildByName("power_txt_txt")
    self.power_txt = bottom_panel:getChildByName("power_txt")
    self.add_bg = bottom_panel:getChildByName("add_bg")
    self.count_label = bottom_panel:getChildByName("count_label")
    self.clearance = bottom_panel:getChildByName("clearance")
    self.clearance:setVisible(false)
    self.clearance:setString(TI18N("语言_c_3686"))
    setTextMaxWidth(self.clearance,300)
    self.level_panel = bottom_panel:getChildByName("level_panel")
    self.line = self.level_panel:getChildByName("bottom_bg")
    self.linWid=self.line:getContentSize().width 
    self.orginx=self.level_panel:getPositionX()
    self.details_btn = bottom_panel:getChildByName("details_btn")
    self.count_title = bottom_panel:getChildByName("count_title")
    self.count_title:setString(TI18N("语言_c_4528"))
    self.count_label:setPositionX(self.count_title:getPositionX() + self.count_title:getContentSize().width + 10)
    self.find_chapter = self.main_container:getChildByName("find_chapter")
    self.daily_reward = self.main_container:getChildByName("daily_reward")
    self.red_point = self.daily_reward:getChildByName("tips_point")    
    local daily_reward_label = self.daily_reward:getChildByName("label")
    daily_reward_label:setString(TI18N("语言_c_4890"))
    setTextMaxWidth(daily_reward_label,85,-10)
    local find_chapter_label = self.find_chapter:getChildByName("label")
    find_chapter_label:setString(TI18N("语言_c_4891"))
    setTextMaxWidth(find_chapter_label,85,-10)
    self.order_reward = self.main_container:getChildByName("order_reward")
    local cfg = Config.DungeonHeavenAdvanceData.data_const
    local res = PathTool.getResFrame("heaven",cfg["dungeons_war_order_access"].val)
    self.order_reward:setVisible(cfg["dungeons_war_order_desc"].val == 1)
    self.order_reward:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.order_red_point = self.order_reward:getChildByName("tips_point") 
    self.order_red_point:setVisible(false)
    local order_reward_label = self.order_reward:getChildByName("label")
    order_reward_label:setString(TI18N("语言_dun_he_09_7"))
    setTextMaxWidth(order_reward_label,85,-10)
    self.rank_btn = self.main_container:getChildByName("rank_btn")
    local rank_label = self.rank_btn:getChildByName("label")
    rank_label:setString(TI18N("语言_dun_he_09_8"))
    setTextMaxWidth(rank_label,85,-10)
    self.shop_btn = self.main_container:getChildByName("shop_btn")
    self.shop_btn:setVisible(cfg["dungeons_heaven_store_close"].val == 1)
    local shop_label = self.shop_btn:getChildByName("label")
    shop_label:setString(TI18N("语言_dun_he_09_9"))
    setTextMaxWidth(shop_label,85,-10)

    for i=1,3 do
        local star = bottom_panel:getChildByName("star_" .. i)
        if star then
            star:setVisible(false)
            _table_insert(self.star_list, star)
        end
    end
    for i=1,3 do
        local star = bottom_panel:getChildByName("gary_star_" .. i)
        if star then
            star:setVisible(false)
            _table_insert(self.gary_star_list, star)
        end
    end
    for i=1,3 do
        local desc_txt = bottom_panel:getChildByName("star_desc_" .. i)
        if desc_txt then
            desc_txt:setString("")
            desc_txt:setTouchEnabled(true)
            _table_insert(self.desc_list, desc_txt)
        end
    end

    local award_list = bottom_panel:getChildByName("award_list")
    local bgSize = award_list:getContentSize()
    local scroll_view_size = cc.size(bgSize.width, bgSize.height)
    local scale = 0.6
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 3,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = BackPackItem.Width*scale,               -- 单元的尺寸width
        item_height = BackPackItem.Height*scale,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = scale
    }
    self.good_scrollview = CommonScrollViewLayout.new(award_list, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.good_scrollview:setSwallowTouches(false)
    
    self.close_btn = self.main_container:getChildByName("close_btn")

    -- 适配
    local top_off = display.getTop(self.main_container)
    local bottom_off = display.getBottom(self.main_container)
    top_panel:setPositionY(top_off - 216)
    self.award_panel:setPositionY(top_off - 238)
    bottom_panel:setPositionY(bottom_off+110)
    self.find_chapter:setPositionY(bottom_off+408)
    self.daily_reward:setPositionY(bottom_off+408)
    self.order_reward:setPositionY(bottom_off+408)
    self.shop_btn:setPositionY(bottom_off+406)
    self.rank_btn:setPositionY(bottom_off+408)
    self.close_btn:setPositionY(bottom_off+160)
    self:reward_red()
end

function HeavenHighChapterWindow:CreateDunBtn()
    local cfg = deepCopy(self.cur_customs_cfg.unit_id)
    local len=#cfg
    local startX=35
    for k, v in pairs(self.dunlist) do
        v:setVisible(false)
    end
    for i=1,len do
        local btn = self.dunlist[i]
        if not btn then
            btn=BattleDramaWarDunItem.new()
            btn:setAnchorPoint(cc.p(0.5,0.5))
            self.level_panel:addChild(btn)
            btn:setData(i,5)
            btn:setScale(0.7)
        end
        btn:setVisible(true)
        btn:setPosition(startX+(i-1)*70,25)
        registerButtonEventListener(btn.container, function()
            self:onClickDunBtn(i)
        end ,true, 2)
        self.dunlist[i]=btn
    end
    local wid= self.linWid-(5-len)*70 
    self.line:setContentSize(cc.size(wid,self.line:getContentSize().height))
    self.level_panel:setPositionX(self.orginx+(5-len)*35)
    self:onClickDunBtn(1)
end
function HeavenHighChapterWindow:onClickDunBtn(index)
    for k, v in pairs(self.dunlist) do
        v:setStatus(k == index)
    end
    local customs_vo = _model:getCustomsDataById(self.cur_customs_cfg.id, self.cur_customs_cfg.order_id)
    for k,v in pairs(self.desc_list) do
        v:setString("")
    end
    for k,v in pairs(self.star_list) do
        v:setVisible(false)
    end
    for k,v in pairs(self.gary_star_list) do
        v:setVisible(false)
    end
    for key, value in pairs(self.cur_customs_cfg.cond_info or {}) do
        if value[1] == index then
            for i,v in ipairs(value[2] or {}) do
                local star_id = v[1]
                local con_id = v[2]
                local desc_txt = self.desc_list[i]
                local con_cfg = Config.DungeonHeavenAdvanceData.data_star_cond[con_id]
                if desc_txt and con_cfg then
                    desc_txt:setString(transformTextToShort(con_cfg.type, 16))
                    addEvt2showAllTextTips(desc_txt,con_cfg.type,16)
                end
                if customs_vo.state == 2 then
                    local star = self.star_list[i]
                    local gary_star = self.gary_star_list[i]
                    if star and customs_vo then
                        local star_status = 0
                        for key,value in pairs(customs_vo.star_info) do
                            if value.order_id == index then
                                for k, v in pairs(value.info_list) do
                                    if v.star_id == star_id then
                                        star_status = v.flag
                                    end
                                end
                            end
                        end
                        star:setVisible(star_status == 1)
                        gary_star:setVisible(star_status == 0)
                    end
                end
            end
        end
    end
    self.power_txt:setString(MoneyTool.moneyFormat(self.cur_customs_cfg.power[1]))
end

function HeavenHighChapterWindow:onClickDetailsBtn()
    if not self.cur_customs_cfg then return end
    local cfg = self.cur_customs_cfg.cond_info or {}
    if not self.boss_details then
        self.boss_details = ccui.Layout:create()
        self.boss_details:setContentSize(SCREEN_WIDTH, display.height)
        self.boss_details:setPositionY(display.getBottom(self.main_container))
        self.boss_details:setTouchEnabled(true)
        self.main_container:addChild(self.boss_details, 1)
        self.boss_details:setSwallowTouches(true)
        self.boss_details:addTouchEventListener(function(sender, event_type)
            if event_type == ccui.TouchEventType.ended then
                self.boss_details:setVisible(false)
            end
        end)
    end
    self.boss_details:setVisible(true)
    local len = tableLen(self.cur_customs_cfg.unit_id)
    local _h = math.min(300,180*len)+50
    if not self.boss_details_bg then
        local btn_world_pos = self.btn_check:convertToWorldSpace(cc.p(0, 0))
        local node_pos = self.main_container:convertToNodeSpace(btn_world_pos)
        self.boss_details_bg = createImage(self.boss_details, PathTool.getResFrame("common","common_1092"), node_pos.x+229, node_pos.y+75, cc.p(0.5, 0), true, nil, true)
        self.boss_details_bg:setTouchEnabled(true)
    end
    self.boss_details_bg:setContentSize(cc.size(576, _h))
    if not self.boss_details_scroll then
        self.boss_details_scroll = createScrollView(560,_h-50,0,25,self.boss_details_bg,ccui.ScrollViewDir.vertical)
    end
    self.boss_details_scroll:setContentSize(cc.size(560, _h-50))
    self.boss_details_scroll:setInnerContainerSize(cc.size(560, 180*len))
    for k, v in pairs(self.boss_details_bg_list) do
        v:setVisible(false)
    end
    for k, v in pairs(self.boss_details_list) do
        v:setVisible(false)
    end
    for i = 1, len do
        local item = self.boss_details_bg_list[i]
        if not item then
            item = createImage(self.boss_details_scroll, PathTool.getResFrame("common","common_90058"), 576/2, (len - i)*150, cc.p(0.5, 0), true, nil, true)
            item:setContentSize(cc.size(560, 150))
            self.boss_details_bg_list[i] = item
        end    
        item:setVisible(true)
        item:setPositionY((len - i)*180)
        if not item.line then
            item.line = {}
        end
        if not item.txt then
            item.txt = {}
        end
        for k, v in pairs(cfg) do
            if v[1] == i then
                for j = 1, tableLen(v[2]) do
                    local data = {}
                    for key, value in pairs(v[2]) do
                        if value[1] == j then
                            data = value
                        end
                    end
                    if j ~= 1 then
                        if not item.line[j] then
                            local line = createImage(item, PathTool.getResFrame("heaven","heaven_1015"), item:getContentSize().width*0.5,item:getContentSize().height-(j-1)*50 , cc.p(0.5, 0.5), true, nil, true)
                            line:setContentSize(cc.size(item:getContentSize().width - 50, line:getContentSize().height))
                            item.line[j] = line
                        end
                    end
                    if not item.txt[j] then
                        local txt = createLabel(22, cc.c3b(224, 191, 152), nil, item:getContentSize().width*0.5,item:getContentSize().height-j*50 + 25, "", item, nil, cc.p(0.5, 0.5))
                        txt:setWidth(460)
                        txt:setLineSpacing(-10)
                        item.txt[j] = txt
                    end
                    local con_id = data[2]
                    local con_cfg = Config.DungeonHeavenAdvanceData.data_star_cond[con_id]
                    if con_cfg then
                        item.txt[j]:setString(con_cfg.type)
                    end
                end
            end
        end
        local txt = self.boss_details_list[i]
        if not txt then
            txt = createLabel(22, cc.c3b(224, 191, 152), nil, 20, (len-i+1)*180, string.format(TI18N("语言_c_4768"),StringUtil.numToChinese(i)), self.boss_details_scroll, nil, cc.p(0, 1))
            self.boss_details_list[i] = txt
        end
        txt:setVisible(true)
        txt:setPositionY((len-i+1)*180)
    end
end

function HeavenHighChapterWindow:register_event(  )
    registerButtonEventListener(self.close_btn, function (  )
        _controller:openHeavenMainWindow(false)
        -- self:close(true)
    end, true, 2)

    -- 规则说明
    registerButtonEventListener(self.btn_rule, function ( param, sender, event_type )
        local rule_cfg = Config.DungeonHeavenAdvanceData.data_const["dunheaven_rule"]
        if rule_cfg then
            TipsManager:getInstance():showCommonTips(rule_cfg.desc, sender:getTouchBeganPosition())
        end
    end, true)

    registerButtonEventListener(self.arrow_left, function (  )
        self:onClickLeftArrow()
    end, true)

    registerButtonEventListener(self.arrow_right, function (  )
        self:onClickRightArrow()
    end, true)

    registerButtonEventListener(self.btn_check, function (  )
        self:onClickCheckBtn()
    end, true)

    -- registerButtonEventListener(self.add_btn, function (  )
    --     self:onClickAddCountBtn()
    -- end, true)

    registerButtonEventListener(self.challenge_btn, function ( )
        self:onClickChallengeBtn()
    end, true)
    
    registerButtonEventListener(self.daily_reward, function ( )
        self:onClickDailyRewardBtn()
    end, true)

    registerButtonEventListener(self.order_reward, function ( )
        self:onClickorderRewardBtn()
    end, true)

    registerButtonEventListener(self.find_chapter, function ( )
        self:onClickFindChapterBtn()
    end, true)

    registerButtonEventListener(self.rank_btn, function ( )
        HeavenController:getInstance():openHeavenRankWindow(true,RankConstant.RankType.heavenHigh)
    end, true)

    registerButtonEventListener(self.shop_btn, function ( )
        SuitShopController:getInstance():openSuitShopMainView(true,Config.ExchangeData.data_shop_exchage_suit)
    end, true)

    registerButtonEventListener(self.details_btn, function ( )
        self:onClickDetailsBtn()
    end, true)

    -- 挑战次数更新
    self:addGlobalEvent(HeavenHighEvent.Update_Chapter_Count_Event, function (  )
        self:updateChallengeCount()
        -- self:updateLeftBuyCount()
    end)

    -- 章节关卡数据
    self:addGlobalEvent(HeavenHighEvent.Update_Chapter_Basedata_Event, function (  )
        self:updateCustomsList()
        self:updateStarAwardInfo()
        self:updateCustomsInfo(self.cur_customs_cfg)
        self:updateArrowBtnStatus()
    end)

    -- 战斗结束点返回游戏刷新界面
    self:addGlobalEvent(HeavenHighEvent.Update_Chapter_FIGHT_BACK, function (sdata)
        local bl_refreash = true 
        self.chapter_id = _model:getOpenMaxChapterId() or 1
        self:setData()
        if not _model:checkIsHaveCustomsCache(self.chapter_id) then
            _controller:sender25235(self.chapter_id)
        end
    end)

    -- 领取章节奖励
    self:addGlobalEvent(HeavenHighEvent.Get_Chapter_Award_Event, function (  )
        for k,v in pairs(self.award_box_list) do
            v:updateEffectStatus()
        end
    end)

    --章节跳转接收
	if not self.get_chapter_data_event  then
        self.get_chapter_data_event = GlobalEvent:getInstance():Bind(HeavenHighEvent.Jump_Page,function (param)
			self:jumpPage(param)
		end)
    end

    --天界副本每日奖励领取接收
	if not self.get_Receive_Reward  then
        self.get_Receive_Reward = GlobalEvent:getInstance():Bind(HeavenHighEvent.Receive_Reward,function ()
			self:reward_red()
		end)
    end
    if not self.order_reward_event then
        self.order_reward_event = GlobalEvent:getInstance():Bind(HeavenHighEvent.Order_Reward_Event, function ()
            self:setOrderRed()
        end)
    end
    if not self.task_reward_event then
        self.task_reward_event = GlobalEvent:getInstance():Bind(HeavenHighEvent.Task_Reward_Event, function ()
            self:setOrderRed()
        end)
    end
end
--跳转章节
function HeavenHighChapterWindow:jumpPage( id )
    if self.chapter_id and _model:checkHeavenChapterIsOpen(id) then
        self.chapter_id = id
        self:setData()
        if not _model:checkIsHaveCustomsCache(self.chapter_id) then
            _controller:sender25235(self.chapter_id)
        end     
    end
end
function HeavenHighChapterWindow:onClickLeftArrow(  )
    if self.chapter_id and _model:checkHeavenChapterIsOpen(self.chapter_id - 1) then
        self.chapter_id = self.chapter_id - 1
        self:setData()
        if not _model:checkIsHaveCustomsCache(self.chapter_id) then
            _controller:sender25235(self.chapter_id)
        end     
    end
end

function HeavenHighChapterWindow:onClickRightArrow(  )
    if self.chapter_id and _model:checkHeavenChapterIsOpen(self.chapter_id + 1) then
        self.chapter_id = self.chapter_id + 1
        self:setData()
        if not _model:checkIsHaveCustomsCache(self.chapter_id) then
            _controller:sender25235(self.chapter_id)
        end     
    end
end

-- 查看怪物
function HeavenHighChapterWindow:onClickCheckBtn(  )
    self:showCustomsBossList()
end

-- 挑战
function HeavenHighChapterWindow:onClickChallengeBtn(  )
    _controller:openHeavenHighDunFightInfo(true,self.cur_customs_cfg)
end

function HeavenHighChapterWindow:openRootWnd( chapter_id,is_first)
    MainuiController:getInstance():getMainUi():setDialRed()
    if chapter_id then
        if type(chapter_id) == "table" then
            if _model:getOpenMaxChapterId() == 0 then
                self.chapter_id = 1
            else
                self.chapter_id = _model:getOpenMaxChapterId() or 1
            end

        else
            self.chapter_id = chapter_id
        end
    end
    self:setData()
    if not _model:checkIsHaveCustomsCache(self.chapter_id) then
        _controller:sender25235(self.chapter_id)
    end
    local cfg = Config.DungeonHeavenAdvanceData.data_const["daily_reward"]
    self.daily_reward:setVisible(next(cfg.val))
    if is_first then
        self:playEnterEffect(is_first)
    end
end

-- 播放开门进入特效
function HeavenHighChapterWindow:playEnterEffect( status )
    if status == true then
        if not tolua.isnull(self.root_wnd) and self.enter_effect == nil then
            self.enter_effect = createEffectSpine("E532295", cc.p(SCREEN_WIDTH*0.5,0), cc.p(0.5, 0.5), false, PlayerAction.action_1)-- 
            self.enter_effect:setScale(display.getMaxScale())
            self.root_wnd:addChild(self.enter_effect, 99)
        elseif self.enter_effect then
            self.enter_effect:setToSetupPose()
            self.enter_effect:setAnimation(0, PlayerAction.action_1, false)
        end
	else
		if self.enter_effect then
            self.enter_effect:clearTracks()
            self.enter_effect:removeFromParent()
            self.enter_effect = nil
        end
	end
end
--查找章节
function HeavenHighChapterWindow:onClickFindChapterBtn()
    _controller:openFindHighWindow(true)
end
--每日奖励
function HeavenHighChapterWindow:onClickDailyRewardBtn()
