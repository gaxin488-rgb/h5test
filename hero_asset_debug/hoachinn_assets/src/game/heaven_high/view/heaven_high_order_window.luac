function HeavenHighOrderWindow:close_callback()
    self.time_txt:stopAllActions()
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.reward_num_item then
        self.reward_num_item:DeleteMe()
        self.reward_num_item = nil
    end
    if self.order_reward_event then
        GlobalEvent:getInstance():UnBind(self.order_reward_event)
        self.order_reward_event = nil
    end
    if self.task_reward_event then
        GlobalEvent:getInstance():UnBind(self.task_reward_event)
        self.task_reward_event = nil
    end
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
    end
    self.item_scrollview = nil
    controller:openHeavenHighOrderWindow(false)
end

