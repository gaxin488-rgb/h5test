HeavenHighOrderWindow = HeavenHighOrderWindow or BaseClass(BaseView)

local controller = HeavenHighController:getInstance()
local model = controller:getModel()
local string_format = string.format
local config = Config.DungeonHeavenAdvanceData.data_const
local charge_cfg = Config.ChargeData.data_charge_data
local role_vo = RoleController:getInstance():getRoleVo()

function HeavenHighOrderWindow:__init()
    self.is_full_screen = true
    self.win_type = WinType.Big

    self.layout_name = "heaven_high/heaven_high_order_window"
    self.res_list = {{path = PathTool.getPlistImgForDownLoad("planesafkorderaction", "planesafkorderaction"),type = ResourcesType.plist}, 
    {path = PathTool.getPlistImgForDownLoad("oncewarorder", "oncewarorder"),type = ResourcesType.plist},
    {path = PathTool.getPlistImgForDownLoad("monopoly", "monopolyenter"),type = ResourcesType.plist},
    {path = PathTool.getPlistImgForDownLoad("monopoly","monopolyboard"), type = ResourcesType.plist}}

    self.reward_list = {}
end

function HeavenHighOrderWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    -- self.background:ignoreContentAdaptWithSize(true)
    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container, 1)
    self.order_panel=self.main_container:getChildByName("order_panel")
    self.icon_img = self.order_panel:getChildByName("icon_img")
    -- 解锁奖励总览
    self.btn_open_lock = self.order_panel:getChildByName("btn_open_lock")
    self.btn_open_lock_label = self.btn_open_lock:getChildByName("name")
    self.title_bg=self.main_container:getChildByName("title_bg")
    self.title_txt = self.title_bg:getChildByName("title_txt")
    self.title_txt:setString(TI18N("语言_dun_he_09_14"))

    self.type_btn_panel = self.main_container:getChildByName("type_btn_panel")

    self.Image_1 =self.order_panel:getChildByName("Image_1")
    local medal_title=self.Image_1:getChildByName("medal_title")
    self.medal_num=self.Image_1:getChildByName("medal_num")
    medal_title:setString(TI18N("语言_c_5311"))
    setTextMaxWidth(medal_title,210)

    self.Image_2 = self.main_container:getChildByName("Image_2")
    self.win_title = self.main_container:getChildByName("win_title")
    self.win_title:setString(TI18N("语言_dun_he_09_15"))
    autoSizeTitleBg(self.win_title,self.Image_2,60)
    self.btn_rule = self.order_panel:getChildByName("btn_rule")
    self.btn_close = self.main_container:getChildByName("btn_close")
    
    local tips_bg = self.order_panel:getChildByName("Image_7")
    tips_bg:getChildByName("coin_label"):setString(TI18N("语言_hol_sta_pa_01_2"))
    self.goods_item = self.order_panel:getChildByName("goods_item")
    self.time_bg = self.main_container:getChildByName("time_bg")
    self.time_str = self.main_container:getChildByName("time_str")
    self.time_str:setString(TI18N("语言_dun_he_09_16"))
    self.time_txt = self.main_container:getChildByName("time_txt")
    self.task_panel=self.main_container:getChildByName("task_panel")
    self.task_con = self.task_panel:getChildByName("task_con")
    self.task_tip_bg = self.task_panel:getChildByName("tip_bg")
    self.task_tip = self.task_panel:getChildByName("tip")
    self.task_time_txt = self.task_panel:getChildByName("time_txt")
    self.task_panel:setVisible(true)
	self.order_panel:setVisible(false)
    self.limit_list = {}

    --根据任务id 保存的列表
    self.dic_task_list = {}
    self:initOrderPanel()
    self:initTaskPanel()
    self:initTypeBtnList()
end

-- 初始化Tab按钮列表
function HeavenHighOrderWindow:initTypeBtnList()
    self.tab_array = {
        TI18N("语言_c_5333"),
        TI18N("语言_c_5334")
    }
    self.tab_btn_list = {}
    for i=1,2 do
        local tab_btn = {}
        local item = self.type_btn_panel:getChildByName("tab_btn_"..i)
        tab_btn.btn = item
        tab_btn.index = i
        tab_btn.select_bg = item:getChildByName("select_img")
        tab_btn.select_bg:setVisible(false)
        tab_btn.title = item:getChildByName("label")
        tab_btn.title:getVirtualRenderer():setLineSpacing(-10)
        tab_btn.title:setTextColor(cc.c4b(247,238,117,255))
        tab_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
        tab_btn.title:setFontSize(25)
        tab_btn.title:setChangeScaleOffWidth(60)
        tab_btn.title:setString(self.tab_array[i])
        tab_btn.red_point = item:getChildByName("red_point")
        tab_btn.red_point:setVisible(false)
        self.tab_btn_list[tab_btn.index] = tab_btn
    end

    for index, tab_btn in ipairs(self.tab_btn_list) do
        registerButtonEventListener(tab_btn.btn, function() self:_onClickTabBtn(tab_btn.index) end ,false, 2) 
    end
end

-- 更新红点显示
function HeavenHighOrderWindow:updateTaskAwardRedStatus(  )
    if not self.tab_btn_list then return end
    for k,tab_btn in pairs(self.tab_btn_list) do
        local red_status
        if tab_btn.index == 1 then
            red_status = model:getTaskRed() 
        else
            red_status= model:getOrderRed()
        end
        tab_btn.red_point:setVisible(red_status)
    end
end

-- 点击Tab按钮
function HeavenHighOrderWindow:_onClickTabBtn( index )
    if self.select_btn and self.select_btn.index == index then return end

    if self.select_btn then 
        self.select_btn.select_bg:setVisible(false)
        self.select_btn.title:setTextColor(cc.c4b(249,238,208,255))
        self.select_btn.title:enableOutline(cc.c4b(58,41,10,255), 2)
    end
    self.select_btn = self.tab_btn_list[index]
    if self.select_btn then 
        self.select_btn.select_bg:setVisible(true)
        self.select_btn.title:setTextColor(cc.c4b(248,239,118,255))
        self.select_btn.title:enableOutline(cc.c4b(92,39,5,255), 2)
        self:updateSubTabBtn(index)
    end
end

function HeavenHighOrderWindow:updateSubTabBtn( index )
    self.task_panel:setVisible(index ==1)
	self.order_panel:setVisible(index ==2)
end

--设置倒计时
function HeavenHighOrderWindow:setLessTime(txt,less_time,node,node_bg)
    if tolua.isnull(node) then
        return
    end
    local less_time = less_time or 0
    node:stopAllActions()
    if less_time > 0 then
        self:setTimeFormatString(txt,less_time,node,node_bg)
        node:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1),
            cc.CallFunc:create(function()
                less_time = less_time - 1
                if less_time < 0 then
                    node:stopAllActions()
                    controller:openHeavenHighOrderWindow(false)
                else
                    self:setTimeFormatString(txt,less_time,node,node_bg)
                end
            end))))
    else
        self:setTimeFormatString(txt,less_time,node,node_bg)
    end
end

function HeavenHighOrderWindow:setTimeFormatString( txt,time ,node,node_bg)
    if time > 0 then
        local str = string.format(txt,TimeTool.GetTimeForFunction(time))
        node:setString(str)
    else
        node:setString(TI18N("语言_c_233"))
    end
    if node_bg then
        node_bg:setContentSize(cc.size(math.max(self.time_str:getContentSize().width,node:getContentSize().width)+20,node_bg:getContentSize().height))
        if self.time_str:getContentSize().width > node:getContentSize().width then
            node:setPositionX(self.time_str:getPositionX() - (self.time_str:getContentSize().width - node:getContentSize().width)*0.5)
        else
            self.time_str:setPositionX(node:getPositionX() - (node:getContentSize().width - self.time_str:getContentSize().width)*0.5)
        end
    end
end
function HeavenHighOrderWindow:updateSlideShowByVertical()
    local container_y = self.reward_goods_item:getCurContainerPosY()
    if container_y and self.reward_num_item and not tolua.isnull(self.reward_num_item) then
        if self.reward_num_item.container and not tolua.isnull(self.reward_num_item.container) then
            self.reward_num_item.container:setPositionY(container_y)
            self.reward_num_item:checkRectIntersectsRect()
        end
    end
end
function HeavenHighOrderWindow:setChangeLevelStatus()
    local title_pos = 1
    local data = model:getOrderData()
    for key, value in pairs(data.awards or {}) do
        if value.award1 == 1 or value.award2 == 1 then
            title_pos = value.id
            break
        end
    end
    self:jumpToMoveByY(139 * (title_pos - 1))
end
function HeavenHighOrderWindow:jumpToMoveByY(y)
    if not y then
        return
    end
    local pos = y
    if pos < 0 then
        pos = 0
    end

    local len = #self.reward_list or 1
    local scroll_view_size = self.goods_item:getContentSize()
    local pos_per = pos * 100 / (len * 139 - scroll_view_size.height)
    if pos_per > 100 then
        pos_per = 100
    end
    self.reward_goods_item:scrollToPercentVertical(pos_per, 0.5, true)
end
function  HeavenHighOrderWindow:initOrderPanel()
    local scroll_view_size = self.goods_item:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔 k, 
        item_width = 720, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true,
        checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,
        ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.createTaskCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
    ---进度条相关
    local scroll_view_size2 = cc.size(100, scroll_view_size.height)
    local setting = {
        start_x = -2, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 0, -- y方向的间隔
        item_width = 100, -- 单元的尺寸width
        item_height = 139, -- 单元的尺寸height
        row = 0, -- 行数，作用于水平滚动类型
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
    }
    self.reward_num_item = CommonScrollViewSingleLayout.new(self.goods_item, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size2, setting)
    self.reward_num_item:setClickEnabled(false)
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.createTaskCell2),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.numberOfTaskCells2),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_num_item:registerScriptHandlerSingle(handler(self, self.updateTaskCellByIndex2),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
end

function HeavenHighOrderWindow:initTaskPanel()
    if self.item_scrollview == nil then
        local scroll_view_size = self.task_con:getContentSize()
        local setting = {
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 0,                     -- y方向的间隔
            item_width = 688,                -- 单元的尺寸width
            item_height = 152,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 1,                    -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewSingleLayout.new(self.task_con, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting, cc.p(0, 0))

        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.CreateNewCell3), ScrollViewFuncType.CreateNewCell) --创建cell
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.NumberOfCells3), ScrollViewFuncType.NumberOfCells) --获取数量
        self.item_scrollview:registerScriptHandlerSingle(handler(self,self.UpdateyIndexCell), ScrollViewFuncType.UpdateCellByIndex) --更新cell
    end
end

--奖励列表
function HeavenHighOrderWindow:CreateNewCell3()
    local cell = HeavenHighMoonItem.new()
    return cell
end

function HeavenHighOrderWindow:NumberOfCells3()
    if not self.limit_list then return 0 end
    return #self.limit_list
end

function HeavenHighOrderWindow:UpdateyIndexCell(cell, index)
    cell.index = index
    local cell_data = self.limit_list[index]
    if not cell_data then return end
    cell:setData(cell_data)
end
function HeavenHighOrderWindow:initAwardConfig()
    self.btn_open_lock:setVisible(not model:getOrderStatus())
    local val = charge_cfg[config["dungeons_war_order_exchange"].val].val
    self.btn_open_lock_label:setString(string.format(TI18N("语言_dun_he_09_10"),val))
    local less_time=0
    local data= model:getOrderData()
    local end_time= data.end_time or GameNet:getInstance():getTime()
    local cur_time = GameNet:getInstance():getTime()
    less_time = end_time - cur_time
    self:setLessTime("%s",less_time,self.time_txt,self.time_bg)

    self.reward_list = deepCopy(Config.DungeonHeavenAdvanceData.data_task_reward)
    table.sort(self.reward_list, SortTools.KeyLowerSorter("id"))
    self.reward_goods_item:reloadData()
    self.reward_num_item:reloadData()

    if self.comp_bar_bg and not tolua.isnull(self.comp_bar_bg) and self.comp_bar and not tolua.isnull(self.comp_bar) and
        self.bar_layout and not tolua.isnull(self.bar_layout) then
        local len = #self.reward_list or 1
        self.comp_bar_bg:setContentSize(cc.size(139 * (len - 1), 27))
        self.comp_bar:setContentSize(cc.size(139 * (len - 1), 15))
        self.bar_layout:setPosition(cc.p(57, 139 * (len - 1) + 139 / 2))
    end
    self:setChangeLevelStatus()
    local need_id = Config.DungeonHeavenAdvanceData.data_const["task_item_id"].val
    local nextCfg = model:getReceiveFinishNext()
    -- local num1 = BackpackController:getInstance():getModel():getItemNumByBid(need_id)
    local num1 = role_vo:getActionAssetsNumByBid(need_id)
    local num2 = nextCfg and nextCfg.need_num or 0
    local str = num1.."/"..num2
    self.medal_num:setString(str)
end

function HeavenHighOrderWindow:setData()
    self:initAwardConfig()
    self:updateTaskAwardRedStatus()
end

function HeavenHighOrderWindow:setTaskData()
    self:initTaskConfig()
    self:updateTaskAwardRedStatus()
end

function HeavenHighOrderWindow:initTaskConfig()
    local less_time = TimeTool.getOneDayLessTimeServer(GameNet:getInstance():getTime(),InviteCodeController:getInstance():getModel():getServerTimeZone())
    self:setLessTime(TI18N("语言_dun_he_09_11"),tonumber(less_time),self.task_time_txt)
    local num = model:getTaskRewardNum()
    local max_num = Config.DungeonHeavenAdvanceData.data_const["dungeons_war_order_scorelimit"].val
    self.task_tip:setString(string.format(TI18N("语言_dun_he_09_12"),num,max_num))
    local _w = math.max(self.task_tip:getContentSize().width+30,self.task_tip_bg:getContentSize().width)
    self.task_tip_bg:setContentSize(cc.size(_w, self.task_tip_bg:getContentSize().height))
    self.limit_list = model:getTaskTasks()
    self.item_scrollview:reloadData()
end

-- 奖励列表
function HeavenHighOrderWindow:createTaskCell()
    local cell = HeavenHighOrderItem.new()
    return cell
end

function HeavenHighOrderWindow:numberOfTaskCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function HeavenHighOrderWindow:updateTaskCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end
    cell:setData(cell_data,index)
end

