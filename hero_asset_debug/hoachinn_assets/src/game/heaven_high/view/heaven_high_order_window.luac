function HeavenHighOrderWindow:register_event()
    if not self.order_reward_event then
        self.order_reward_event = GlobalEvent:getInstance():Bind(HeavenHighEvent.Order_Reward_Event, function ()
            self:setData()
        end)
    end
    if not self.task_reward_event then
        self.task_reward_event = GlobalEvent:getInstance():Bind(HeavenHighEvent.Task_Reward_Event, function ()
            self:setTaskData()
        end)
    end
    registerButtonEventListener(self.btn_open_lock, function()
        if config["dungeons_war_order_exchange"] and charge_cfg[config["dungeons_war_order_exchange"].val] and charge_cfg[config["dungeons_war_order_exchange"].val].val then
            local val = charge_cfg[config["dungeons_war_order_exchange"].val].val
            local str = string.format(TI18N("语言_dun_he_09_13"),val)
            CommonAlert.show( str, TI18N("语言_c_63"), function()
                local cdata = charge_cfg[config["dungeons_war_order_exchange"].val]
                sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
            end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
        end
    end, true, 1)

    -- 关闭按钮
    registerButtonEventListener(self.btn_close, function()
        controller:openHeavenHighOrderWindow(false)
    end, true, 2)
    registerButtonEventListener(self.background, function()
        controller:openHeavenHighOrderWindow(false)
    end, true, 2)

    -- 帮助说明
    registerButtonEventListener(self.btn_rule, function(param, sender, event_type)
        local config = config["dungeons_war_order_rule"]
        if config then
            local config_desc = config.val
            TipsManager:getInstance():showCommonTips(config_desc, sender:getTouchBeganPosition(), nil, nil, 500)
        end
    end, false, 1)
end


