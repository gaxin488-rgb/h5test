-- 子项
HeavenHighMoonItem = class("HeavenHighMoonItem", function()
    return ccui.Widget:create()
end)

function HeavenHighMoonItem:ctor()
    self:configUI()
    self:register_event()
end

function HeavenHighMoonItem:configUI(  )
    self.size = cc.size(688,152)
    self:setTouchEnabled(true)
    self:setContentSize(self.size)

    local csbPath = PathTool.getTargetCSB("action/action_limit_yuanzhen_small_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.max_tip = main_container:getChildByName("max_tip")
    self.max_tip:setString(TI18N("语言_dun_he_09_18"))
    self.btn_goto = main_container:getChildByName("btn_goto")
    self.btn_goto:getChildByName("Text_6"):setString(TI18N("语言_c_108"))
    self.btn_goto:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_get:getChildByName("Text_5"):setString(TI18N("语言_c_109"))
    self.btn_get:setVisible(false)
    self.btn_has = main_container:getChildByName("btn_has")
    self.btn_has:setVisible(false)

    self.goods_con = main_container:getChildByName("good_cons")

    self.Image_1 = main_container:getChildByName("Image_1")

    --标题
    self.title_desc = createRichLabel(28, cc.c4b(0x64,0x32,0x23,0xff), cc.p(0,0.5), cc.p(20,130), -15, nil, 500)
    main_container:addChild(self.title_desc)
    --小标题
    self.little_desc = createRichLabel(22, cc.c4b(0x95,0x53,0x22,0xff), cc.p(0,1), cc.p(230,78), -5, nil, 280)
    main_container:addChild(self.little_desc)

    local size = self.goods_con:getContentSize()
    self.item_scrollview = createScrollView(size.width, size.height+1, 0, 0, self.goods_con, ScrollViewDir.horizontal)
end

function HeavenHighMoonItem:register_event( )
    registerButtonEventListener(self.btn_get, function()
        if not self.data then return end
        controller:sender25257(self.data.id)
    end,true, 1)

    registerButtonEventListener(self.btn_goto, function() self:onGotoBtn() end,true, 1)
end

function HeavenHighMoonItem:onGotoBtn()
    controller:openHeavenHighOrderWindow(false)
    if not self.cfg then return end
    local config = Config.SourceData.data_source_data[self.cfg.skip]
    BackpackController:getInstance():gotoItemSources(config.evt_type, config.extend)
end

function HeavenHighMoonItem:setData( data )
    self.data = data
    local num = model:getTaskRewardNum()
    local max_num = Config.DungeonHeavenAdvanceData.data_const["dungeons_war_order_scorelimit"].val
    self.btn_goto:setVisible(data.state == TaskConst.task_status.un_finish and num < max_num)
    self.btn_get:setVisible(data.state == TaskConst.task_status.finish and num < max_num)
    addRedPointToNodeByStatus(self.btn_get, data.state == TaskConst.task_status.finish,10,10)
    self.btn_has:setVisible(data.state == TaskConst.task_status.completed)
    self.max_tip:setVisible(num >= max_num and data.state ~= TaskConst.task_status.completed)
    self.cfg = Config.DungeonHeavenAdvanceData.data_task_info[self.data.id]
    self.title_desc:setString(self.cfg.title)
    local desc = ""
    if data.id == 1 then
        desc = string.format(self.cfg.desc,1,self.cfg.limit[1][2])
    else
        desc = string.format(self.cfg.desc,model:getTaskChallengeNum(),self.cfg.limit[1][2])
    end
    if data.state == TaskConst.task_status.finish then
        self.little_desc:setString(string_format("<div fontColor=#249003>%s</div>", desc))
    else
        self.little_desc:setString(desc)
    end

    local data_list = deepCopy(self.cfg.reward)
    if data.id == 1 and model:getTaskStarNum() > 0 then
        for i,v in pairs(data_list) do
            v[2] = v[2] * model:getTaskStarNum()
        end
    end
    local setting = {}
    setting.scale = 0.8
    setting.max_count = 2
    self.item_list = commonShowSingleRowItemList(self.item_scrollview, self.item_list, data_list, setting)
end

function HeavenHighMoonItem:DeleteMe( )
    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    self.item_list = nil

    if self.item then
        self.item:DeleteMe()
        self.item = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end

--------------------------------
-- 功勋子项
HeavenRewardItem = class("HeavenRewardItem", function()
    return ccui.Widget:create()
end)

function HeavenRewardItem:ctor()
    self.size = cc.size(100, 139)
    self:configUI()
    self:register_event()
end

function HeavenRewardItem:configUI()
    self.root_wnd = ccui.Layout:create()
    self.root_wnd:setContentSize(self.size)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self:addChild(self.root_wnd)
    self.num_bg = createImage(self.root_wnd, PathTool.getResFrame("planesafkorderaction", "planesafkaction_11"),
    self.size.width / 2, self.size.height / 5 + 11, cc.p(0.5, 0.5), true, nil, true)
    self.num_bg:setCapInsets(cc.rect(19, 17, 2, 2))
    self.num_bg:setContentSize(cc.size(71, 37))
    self.num_txt = createLabel(20, Config.ColorData.data_color4[1], nil, self.size.width / 2 - 2,
    self.size.height / 5 + 11, "", self.root_wnd, nil, cc.p(0.5, 0.5))
end

function HeavenRewardItem:register_event()
end

function HeavenRewardItem:setData(data,index)
    if not data then
        return
    end
    self.data = data
    -- self.orderReceive = model:getOrderReceive(index)
    if not self.select_img then 
        local resid= Config.DungeonHeavenAdvanceData.data_const["task_item_id"].val
        local itemcfg = Config.ItemData.data_get_data(resid)
        self.select_bg = createSprite(PathTool.getResFrame("heaven_ad","heavenad_1034"),self.size.width / 2, self.size.height / 2 + 6,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
        setChildUnEnabled(true,self.select_bg)
        self.select_img = createSprite(PathTool.getResFrame("heaven_ad","heavenad_1034"),self.size.width / 2, self.size.height / 2 + 6,self.root_wnd,cc.p(0.5,0.5),LOADTEXT_TYPE_PLIST)
    end
    self.select_img:setVisible(false)
    -- 进度条相关
    local cfg = Config.DungeonHeavenAdvanceData.data_task_reward
    if cfg[self.data.id+1] then
        if self.comp_bar == nil then
            local size = cc.size(139, 27)
            local res = PathTool.getResFrame("planesafkorderaction", "planesafkaction_4")
            local res1 = PathTool.getResFrame("planesafkorderaction", "planesafkaction_7")
            local bar_layout = ccui.Layout:create()
            bar_layout:setContentSize(cc.size(27, 27))
            bar_layout:setAnchorPoint(0, 0)
            bar_layout:setRotation(90)
            if bar_layout then
                self.root_wnd:addChild(bar_layout, 1)
                bar_layout:setPosition(cc.p(50, 77))
                self.bar_layout = bar_layout
            end
            local bg, comp_bar =createLoadingBar(res, res1, size, self.bar_layout, cc.p(0, 0.5), 0, 0, true, true, 0, 0)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            self.comp_bar_bg:setContentSize(cc.size(139, 27))
            self.comp_bar:setContentSize(cc.size(139, 15))
        end
        if self.bar_layout then
            self.bar_layout:setVisible(true)
        end
        local id = model:getReceiveFinish()
        if self.data then
            if self.data.id < id then
                self.comp_bar:setPercent(100)
                self.select_img:setVisible(true)
            elseif self.data.id == id then
                self.select_img:setVisible(true)
                local nextData = cfg[index + 1]
                if nextData then
                    local nowData = Config.DungeonHeavenAdvanceData.data_task_reward[index]
                    local need_id = Config.DungeonHeavenAdvanceData.data_const["task_item_id"].val
                    local num1 = role_vo:getActionAssetsNumByBid(need_id)
                    self.comp_bar:setPercent((num1 - nowData.need_num)/(nextData.need_num - nowData.need_num)*100)
                else
                    self.comp_bar:setPercent(0)
                end
            else
                self.comp_bar:setPercent(0)
            end
        else
            self.comp_bar:setPercent(0)
        end
    else
        if self.bar_layout then
            self.bar_layout:setVisible(false)
        end
        local id = model:getReceiveFinish()
        if self.data.id == id then
            self.select_img:setVisible(true)
        end
    end
    self.num_txt:setString(data.need_num)
    self.select_bg:setLocalZOrder(9)
    self.select_img:setLocalZOrder(10)
    self.num_bg:setLocalZOrder(11)
    self.num_txt:setLocalZOrder(12)
    self:setLocalZOrder(index)
end

function HeavenRewardItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end


HeavenHighOrderItem = class("HeavenHighOrderItem", function()
    return ccui.Widget:create()
end)

function HeavenHighOrderItem:ctor()
    self:configUI()
    self:register_event()
end

function HeavenHighOrderItem:configUI()
    self.root_wnd = cc.CSLoader:createNode(PathTool.getTargetCSB("heaven_high/heaven_high_order_item"))
    self:setContentSize(cc.size(720, 139))
    self:addChild(self.root_wnd)

    local main_container = self.root_wnd:getChildByName("main_container")
    self.goods_item = main_container:getChildByName("goods_item") -- 付费礼物
    self.goods_item:setScrollBarEnabled(false)
    self.free_goods_item = main_container:getChildByName("free_goods_item") -- 免费礼物
    self.free_goods_item:setScrollBarEnabled(false)
    self.finish_img = main_container:getChildByName("finish_img")
    self.finish_img:setVisible(false)
    self.btn_get = main_container:getChildByName("btn_get")
    self.btn_name = self.btn_get:getChildByName("name")
    self.btn_name:setString("")
end

function HeavenHighOrderItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        local is_unlock = model:getOrderStatus()
        if is_unlock then -- 战令已解锁
            if self.orderReceive.award1 == 1 or self.orderReceive.award2 == 1 then
                controller:sender25255()
            else
                controller:openHeavenHighOrderWindow(false)
            end
        else -- 未解锁
            if self.orderReceive.award1 == 1 then -- 可领取
                controller:sender25255()
            elseif self.orderReceive.award1 == 2 then -- 前往购买
                if config["dungeons_war_order_exchange"] and charge_cfg[config["dungeons_war_order_exchange"].val] and charge_cfg[config["dungeons_war_order_exchange"].val].val then
                    local val = charge_cfg[config["dungeons_war_order_exchange"].val].val
                    local str = string.format(TI18N("语言_dun_he_09_13"),val)
                    CommonAlert.show( str, TI18N("语言_c_63"), function()
                        local cdata = charge_cfg[config["dungeons_war_order_exchange"].val]
                        sdkOnPay(cdata.val, nil, cdata.id, cdata.name)
                    end, TI18N("语言_c_62"),nil,nil,nil,{timer=0, timer_for=true, off_y = 10, title = TI18N("语言_c_5014"), extend_aligment = cc.TEXT_ALIGNMENT_CENTER })
                end
            elseif self.orderReceive.award1 == 0 then -- 前往过关
                controller:openHeavenHighOrderWindow(false)
            end
        end
    end, true, 1)
end

function HeavenHighOrderItem:setData(data,index)
    if not data then
        return
    end
    self.data = data
    self.orderReceive = model:getOrderReceive(index) or {}
    local free_effect_id = false
    local free_data_list = data.reward or {}
    local status = self.orderReceive.award1 == 0
    local setting1 = {}
    setting1.start_x = 10
    setting1.scale = 0.7
    setting1.is_tip = true
    setting1.lock = status
    setting1.is_lock_bg = status
    setting1.show_effect_id = free_effect_id
    setting1.is_get_status = self.orderReceive.award1 == 2 or false
    setting1.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.free_item_list = commonShowSingleRowItemList(self.free_goods_item, self.free_item_list, free_data_list,setting1)

    -- 进阶奖励
    local is_locak_status = model:getOrderStatus() -- 战令解锁状态
    local pay_effect_id = false
    -- 付费道具
    local data_list = data.rmb_reward or {}
    local rmbStatus = self.orderReceive.award2 == 0
    local setting = {}
    setting.start_x = 10
    setting.scale = 0.7
    setting.lock = rmbStatus
    setting.is_lock_bg = rmbStatus
    setting.is_tip = true
    setting.show_effect_id = pay_effect_id
    setting.is_get_status = self.orderReceive.award2 == 2 or false
    setting.max_count = 2
    setting.get_status_res = PathTool.getResFrame("planesafkorderaction", "txt_cn_planesafkaction_1")
    self.item_list = commonShowSingleRowItemList(self.goods_item, self.item_list, data_list, setting)

    if self.btn_get then
        addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
        if is_locak_status then -- 战令已经解锁
            if self.orderReceive.award2 == 1 then -- 可领取
                self.btn_name:enableOutline(Config.ColorData.data_color4[264], 2)
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 10, 10)
                setChildUnEnabled(false,self.btn_get)
            elseif self.orderReceive.award2 == 2 then -- 已领取
                self.btn_get:setVisible(false)
                self.finish_img:setVisible(true)
                addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
            elseif self.orderReceive.award2 == 0 then -- 前往过关
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 10, 10)
            end
        else -- 战令未解锁时
            if self.orderReceive.award1 == 1 then -- 可领取
                self.btn_name:setString(TI18N("语言_c_988"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                addRedPointToNodeByStatus(self.btn_get, true, 10, 10)
                setChildUnEnabled(false,self.btn_get)
            elseif self.orderReceive.award1 == 2 then -- 前往购买
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
            elseif self.orderReceive.award1 == 0 then
                self.btn_name:setString(TI18N("语言_c_108"))
                self.btn_get:setVisible(true)
                self.finish_img:setVisible(false)
                setChildUnEnabled(false,self.btn_get)
                addRedPointToNodeByStatus(self.btn_get, false, 5, 5)
            end
        end
    end
end

function HeavenHighOrderItem:DeleteMe()
    if self.item_list then
        for i, v in pairs(self.item_list) do
            v:DeleteMe()
        end
        self.item_list = nil
    end
    if self.common_goods_item then
        self.common_goods_item:DeleteMe()
        self.common_goods_item = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end