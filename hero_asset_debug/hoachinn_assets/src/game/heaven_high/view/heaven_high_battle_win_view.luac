local _controller = HeavenHighController:getInstance()
local _model = _controller:getModel()
local _string_format = string.format

HeavenHighBattleWinView = HeavenHighBattleWinView or BaseClass(BaseView)

function HeavenHighBattleWinView:__init()
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Tips
    self.layout_name = "heaven_high/heaven_high_battle_win_view"

    self.effect_cache_list = {}
    self.desc_txt_list = {}
    self.star_list = {}
    self.gary_star_list = {}
    self.big_star_list = {}
    self.big_gary_star_list = {}
    self.dunlist = {}
    self.star_pos = {
        [1] = {{cc.p(373,1000),1,0}},
        [2] = {{cc.p(350,998),0.9,-5},{cc.p(392,998),0.9,5}},
        [3] = {{cc.p(331,995),0.9,-5},{cc.p(373,1000),1,0},{cc.p(414,995),0.9,5}},
        [4] = {{cc.p(309,993),0.8,-10},{cc.p(350,998),0.9,-5},{cc.p(392,998),0.9,5},{cc.p(432,993),0.8,10}},
        [5] = {{cc.p(293,988),0.8,-10},{cc.p(331,995),0.9,-5},{cc.p(373,1000),1,0},{cc.p(414,995),0.9,5},{cc.p(452,988),0.8,10}}
    }
end

function HeavenHighBattleWinView:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")
    local Sprite_7 = container:getChildByName("Sprite_7")
    local Sprite_8 = container:getChildByName("Sprite_8")
    local get_title = container:getChildByName("get_title")
    get_title:setString(TI18N("语言_c_121"))
    Sprite_7:setPositionX(get_title:getPositionX() - get_title:getContentSize().width/2 - 20)
    Sprite_8:setPositionX(get_title:getPositionX() + get_title:getContentSize().width/2 + 20)


    self.success_bg = container:getChildByName("success_bg")
    self.Sprite_1 = self.success_bg:getChildByName("Sprite_1")
    if self.sprite_1_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_97")
        self.sprite_1_load = loadSpriteTextureFromCDN(self.Sprite_1, res, ResourcesType.single, self.sprite_1_load)
    end
    
    self.Sprite_2 = self.success_bg:getChildByName("Sprite_2")
    if self.sprite_2_load == nil then
        local res = PathTool.getPlistImgForDownLoad("bigbg","bigbg_98")
        self.sprite_2_load = loadSpriteTextureFromCDN(self.Sprite_2, res, ResourcesType.single, self.sprite_2_load)
    end
    

    self.confirm_btn = container:getChildByName("confirm_btn")
    self.confirm_btn:setVisible(false)
    self.harm_btn = container:getChildByName("harm_btn")
    self.harm_btn:setVisible(false)
    self.harm_btn:getChildByName("harm_lab"):setString(TI18N("语言_c_120"))
    for i=1,3 do
    	local star = container:getChildByName("star_" .. i)
    	if star then
    		table.insert(self.star_list, star)
    	end
        local star = container:getChildByName("gary_star_" .. i)
    	if star then
    		table.insert(self.gary_star_list, star)
    	end
    	local desc_txt = container:getChildByName("desc_txt_" .. i)
    	if desc_txt then
    		table.insert(self.desc_txt_list, desc_txt)
    	end
    end
    for i=1,5 do
        local big_star = self.root_wnd:getChildByName("big_star_" .. i)
        if big_star then
            table.insert(self.big_star_list, big_star)
        end
    end
    for i=1,5 do
        local big_star = self.root_wnd:getChildByName("big_star_gary_" .. i)
        if big_star then
            table.insert(self.big_gary_star_list, big_star)
        end
    end
    
    self.fight_text = createLabel(24, cc.c4b(0xff,0xee,0xac,0xff), nil, 360, 490, "",container, nil, cc.p(0.5,0.5))

    self.comfirm_btn = createButton(self.root_wnd,TI18N("语言_c_63"), 620, 580, cc.size(162, 62), PathTool.getResFrame("common", "common_1017"), 24, Config.ColorData.data_color4[1])
    self.comfirm_btn:setPosition(self.root_wnd:getContentSize().width / 2 - 170, 315)
    self.comfirm_btn:enableOutline(Config.ColorData.data_color4[264], 2)
    self.comfirm_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:_onClickBtnClose()
        end
    end)

    self.cancel_btn = createButton(self.root_wnd,TI18N("语言_c_262"), 620, 580, cc.size(162, 62), PathTool.getResFrame("common", "common_1018"), 24, Config.ColorData.data_color4[1])
    self.cancel_btn:setPosition(self.root_wnd:getContentSize().width / 2 + 170, 315)
    self.cancel_btn:enableOutline(Config.ColorData.data_color4[263], 2)
    self.cancel_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            if not HeavenHighController:getInstance():getHeavenHighChapterWindowIsOpen() then
                BattleResultReturnMgr:returnByFightType(BattleConst.Fight_Type.HeavenHighWar) --先
            else
                GlobalEvent:getInstance():Fire(HeavenHighEvent.Update_Chapter_FIGHT_BACK)
            end
            self:_onClickBtnClose()    
        end
    end)

    self.title_container = self.root_wnd:getChildByName("title_container")
    self.title_width = self.title_container:getContentSize().width
    self.title_height = self.title_container:getContentSize().height

    local list_view = container:getChildByName("list_view")
    local scroll_view_size = list_view:getContentSize()
    local setting = {
        item_class = HeavenHighBattleWinItem,
        start_x = 94,
        space_x = 20,
        start_y = 0,
        space_y = 10,
        item_width = 120,
        item_height = 145,
        row = 4,
        col = 4,
        delay = 6,
        need_dynamic = true
    }
    self.scroll_view = CommonScrollViewLayout.new(list_view, nil, nil, nil, scroll_view_size, setting)
    self.level_panel = container:getChildByName("level_panel")
    self.line = self.level_panel:getChildByName("bottom_bg")
    self.linWid=self.line:getContentSize().width 
    self.orginx=self.level_panel:getPositionX()

    self.container = container
end

function HeavenHighBattleWinView:register_event(  )
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.confirm_btn, handler(self, self._onClickBtnClose), true, 2)
    registerButtonEventListener(self.harm_btn, handler(self, self._onClickHarmBtn), true)
end

function HeavenHighBattleWinView:_onClickBtnClose(  )
	_controller:openHeavenHighBattleWinView(false)
end

function HeavenHighBattleWinView:_onClickHarmBtn(  )
    if self.data and self.data.all_hurt_statistics then
        table.sort( self.data.all_hurt_statistics, function(a, b) return a.type < b.type end)
        local role_vo = RoleController:getInstance():getRoleVo()
        local atk_name = role_vo.name
        local is_boss = _model:getCustomsIsBossType(self.data.id, self.data.order_id)
        for i,v in ipairs(self.data.all_hurt_statistics) do
            if is_boss then
                v.atk_name  = _string_format("%s(%s)",atk_name, string.format(TI18N("语言_c_2023"), v.a_round))
                v.target_role_name  = _string_format("%s(%s)",v.target_role_name, string.format(TI18N("语言_c_2023"), v.b_round))
            else
                v.atk_name  = atk_name
            end
        end
        BattleController:getInstance():openBattleHarmInfoView(true, self.data.all_hurt_statistics)
    end
end

function HeavenHighBattleWinView:handleEffect( status )
	if status == false then
        if self.play_effect then
            self.play_effect:clearTracks()
            self.play_effect:removeFromParent()
            self.play_effect = nil
        end
    else
        if not tolua.isnull(self.title_container) and self.play_effect == nil then
            self.play_effect = createEffectSpine(PathTool.getEffectRes(901), cc.p(self.title_width*0.5,self.title_height*0.5), cc.p(0.5, 0.5), false, PlayerAction.action)
            self.title_container:addChild(self.play_effect, 1)
        end
    end
end

function HeavenHighBattleWinView:openRootWnd( data )
	playOtherSound("c_arenasettlement", AudioManager.AUDIO_TYPE.COMMON)
    if data ~= nil then
        self.data = data
        self:setBaseInfo()
        self:setRewardsList()
        self:handleEffect(true)
        if data.all_hurt_statistics then
            self.harm_btn:setVisible(true)
        end

        if self.fight_text then
            local name = Config.BattleBgData.data_fight_name[BattleConst.Fight_Type.HeavenHighWar]
            if name then
                self.fight_text:setString(TI18N("语言_c_122")..name)
            end
        end
        self:CreateDunBtn()
    end
end
function HeavenHighBattleWinView:CreateDunBtn()
    local config = Config.DungeonHeavenAdvanceData.data_customs[self.data.id][self.data.order_id]
    local cfg = deepCopy(config.unit_id)
    local len=#cfg
    local startX=35
    for k, v in pairs(self.dunlist) do
        v:setVisible(false)
    end
    for i=1,len do
        local btn = self.dunlist[i]
        if not btn then
            btn=BattleDramaWarDunItem.new()
            btn:setAnchorPoint(cc.p(0.5,0.5))
            self.level_panel:addChild(btn)
            btn:setData(i,5)
            btn:setScale(0.7)
        end
        btn:setVisible(true)
        btn:setPosition(startX+(i-1)*70,25)
        registerButtonEventListener(btn.container, function()
            self:onClickDunBtn(i)
        end ,true, 2)
        self.dunlist[i]=btn
    end
    local wid= self.linWid-(5-len)*70 
    self.line:setContentSize(cc.size(wid,self.line:getContentSize().height))
    self.level_panel:setPositionX(self.orginx+(5-len)*35)
    self:onClickDunBtn(1)
end
function HeavenHighBattleWinView:onClickDunBtn(index)
    for k, v in pairs(self.dunlist) do
        v:setStatus(k == index)
    end
	for k,v in pairs(self.desc_txt_list) do
		v:setVisible(false)
	end
	for k,v in pairs(self.star_list) do
		v:setVisible(false)
	end
	for k,v in pairs(self.gary_star_list) do
		v:setVisible(false)
	end
    local config = Config.DungeonHeavenAdvanceData.data_customs[self.data.id][self.data.order_id]
    local cfg = config.cond_info
	if not cfg then return end
    local num = 25
    if judgingLanguage() then
        num = 13
    end
    for key, value in pairs(cfg) do
        if value[1] == index then
            for i,v in ipairs(value[2]) do
                local star_id = v[1]
                local con_id = v[2] 
                local desc_txt = self.desc_txt_list[i]
                local con_data = Config.DungeonHeavenAdvanceData.data_star_cond[con_id]
                if con_data and desc_txt then
                    desc_txt:setVisible(true)
                    desc_txt:setString(transformTextToShort(con_data.type, num))
                    addEvt2showAllTextTips(desc_txt,con_data.type,num,nil,nil,nil,true,true)
                end
                local status = self:checkStarIsShowById(index,star_id)
                local star = self.star_list[i]
                if star then
                    star:setVisible(status)
                end
                local star = self.gary_star_list[i]
                if star then
                    star:setVisible(not status)
                end
            end
        end
    end
end

function HeavenHighBattleWinView:setBaseInfo(  )
	if not self.data then return end
    
	for k,v in pairs(self.big_star_list) do
		v:setVisible(false)
	end
    for k,v in pairs(self.big_gary_star_list) do
		v:setVisible(false)
	end
    local list = deepCopy(self.data.star_info)
    table.sort(list,function(a,b) return a.order_id < b.order_id end)
    for i = 1, tableLen(list) do
        local data = list[i]
        local big_star = self.big_star_list[i]
        local big_gary_star = self.big_gary_star_list[i]
        local num = 0
        for k,v in pairs(data.info_list) do
            if v.flag == 1 then
                num = num + 1
            end
        end
        if num > 0 and big_star then
            big_star:setVisible(true)
            big_gary_star:setVisible(true)
            local res = PathTool.getResFrame("heaven_ad","heavenad_10"..37+num)
            loadSpriteTexture(big_star, res, LOADTEXT_TYPE_PLIST)
            big_star:setPosition(self.star_pos[tableLen(list)][i][1])
            big_star:setScale(self.star_pos[tableLen(list)][i][2])
            big_star:setRotation(self.star_pos[tableLen(list)][i][3])
            big_gary_star:setPosition(self.star_pos[tableLen(list)][i][1])
            big_gary_star:setScale(self.star_pos[tableLen(list)][i][2])
            big_gary_star:setRotation(self.star_pos[tableLen(list)][i][3])
        end
    end
end

function HeavenHighBattleWinView:checkStarIsShowById(index,id)
	local is_show = false
	if self.data and self.data.star_info then
		for k,v in pairs(self.data.star_info) do
            if v.order_id == index then
                for key,value in pairs(v.info_list) do
                    if value.star_id == id then
                        is_show = (value.flag == 1)
                        return is_show
                    end
                end
            end
		end
	end
	return is_show
end

function HeavenHighBattleWinView:setRewardsList(  )
	if self.data == nil or self.data.award == nil or next(self.data.award) == nil then return end
    self.scroll_view:setData(self.data.award)
end

function HeavenHighBattleWinView:close_callback(  )
    if self.scroll_view then
        self.scroll_view:DeleteMe()
        self.scroll_view = nil
    end
    self:handleEffect(false)

    if self.sprite_1_load then
        self.sprite_1_load:DeleteMe()
        self.sprite_1_load = nil
    end

    if self.sprite_2_load then
        self.sprite_2_load:DeleteMe()
        self.sprite_2_load = nil
	end
    _controller:openHeavenHighBattleWinView(false)
end

-------------------------------------@ item
HeavenHighBattleWinItem = class("HeavenHighBattleWinItem", function()
    return ccui.Layout:create()
end)

function HeavenHighBattleWinItem:ctor()
    self:setAnchorPoint(cc.p(0.5,0.5))
    self:setContentSize(cc.size(120,145))
    self:setCascadeOpacityEnabled(true)

    self.item = BackPackItem.new(false, true, false, 1, false, true)
    self.item:setPosition(60,85)
    self:addChild(self.item)

    -- self.item_name_label = createLabel(24, cc.c4b(0xff,0xe8,0x87,0xff),nil, 60, 0, "", self, nil, cc.p(0.5, 0))

    self:registerEvent()
end

function HeavenHighBattleWinItem:registerEvent()
    self:registerScriptHandler(function(event)
        if "enter" == event then
            self:setOpacity(0)
            self:setScale(2)
            local fadeIn = cc.FadeIn:create(0.1)
            local scaleTo = cc.ScaleTo:create(0.1, 1)
            self:runAction(cc.Spawn:create(fadeIn, scaleTo))
        elseif "exit" == event then

        end 
    end)
end

function HeavenHighBattleWinItem:setData(data)
    if data then
        self.item:setBaseData(data.item_id, data.num)

        -- local item_config = Config.ItemData.data_get_data(data.item_id)
        -- if item_config then
            -- self.item_name_label:setString(item_config.name)
        -- end
    end
end

function HeavenHighBattleWinItem:suspendAllActions()
end

function HeavenHighBattleWinItem:DeleteMe()
    if self.item then
        self.item:DeleteMe()
    end
    self.item = nil
    self:removeAllChildren()
    self:removeFromParent()
end