-- 根据阵法类型和index，获取对应的位置
function HeavenHighDunFightInfo:getFormPosByIndex( form_type, index )
    local pos = 1
    local formation_config = Config.FormationData.data_form_data[form_type]
    if formation_config then
        for k,v in pairs(formation_config.pos) do
            if v[1] == index then
                pos = v[2]
                break
            end
        end
    end
    return pos
end

function HeavenHighDunFightInfo:updateAward()
    local list = {}
    for k, v in pairs(self.data.f_show_award) do
        local data = {}
		data[1] = v[1]
		data[2] = v[2]
		table.insert(list, data)
    end
    self.item_scrollview:setData(list)
	self.item_scrollview:addEndCallBack(function()
        local item_list = self.item_scrollview:getItemList()
        for k,v in pairs(item_list) do
            v:setDefaultTip()
			v:setSwallowTouches(false)
			v:setGotIcon(false)
        end
	end)
end

function HeavenHighDunFightInfo:close_callback()
    HeroController:getInstance():getModel():setBossFormPoint()
    if self.update_boss_form_event then
		GlobalEvent:getInstance():UnBind(self.update_boss_form_event)
		self.update_boss_form_event = nil
	end
    controller:openHeavenHighDunFightInfo(false)
end