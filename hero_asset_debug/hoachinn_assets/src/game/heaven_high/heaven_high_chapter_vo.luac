		-- 龙地洞 章节数据
---------------------------------
HeavenHighChapterVo = HeavenHighChapterVo or BaseClass(EventDispatcher)

function HeavenHighChapterVo:__init(  )
	self.id = 0  	  	 -- 章节id
	self.all_star = 0 	 -- 总星数
	self.award_info = {} -- 星数奖励数据
	self.is_finish = HeavenHighConst.Chapter_Pass_Status.NotPass -- 通关状态

	self.red_status = false -- 章节奖励红点
end

function HeavenHighChapterVo:updateData( data )
	for key, value in pairs(data) do
        self[key] = value
    end
    self:checkChapterRedStatus()
    self:dispatchUpdateAttrByKey()
end

function HeavenHighChapterVo:dispatchUpdateAttrByKey()
    self:Fire(HeavenHighEvent.Update_Chapter_Vo_Event) 
end

function HeavenHighChapterVo:checkChapterRedStatus(  )
	self.red_status = false
	for k,v in pairs(self.award_info) do
		if v.flag == 1 then
			self.red_status = true
			break
		end
	end
end

-- 章节奖励红点状态
function HeavenHighChapterVo:getRedStatus(  )
	return self.red_status
end

function HeavenHighChapterVo:__delete(  )
	
end