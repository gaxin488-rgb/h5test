		if data.flag == 0 then
			message(data.msg)
		end
	end
end
-- 领取钥匙
function HeavenHighController:sender25249( )
	local protocal = {}
    self:SendProtocal(25249, protocal)
end
function HeavenHighController:handle25249( data )
	self:printData(25249,data)
	if data.result == 1 then
		self:openHeavenHighUnlockKeyPanel(true)
	else
		message(data.msg)
	end
end

-- 龙地洞进阶开启
function HeavenHighController:sender25250( )
	local protocal = {}
    self:SendProtocal(25250, protocal)
end
function HeavenHighController:handle25250( data )
	self:printData(25250,data)
	if data.result == 1 then
		self:openHeavenMainWindow(true, self.relevance_params,nil,true,true)
		-- AdventureActivityController:getInstance():onClickGotoAdvenTureAcivity(AdventureActivityConst.Ground_Type.heaven_high)
	end
	message(data.msg)
end

