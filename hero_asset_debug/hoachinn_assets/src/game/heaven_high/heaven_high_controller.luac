-- 龙地洞登录红点
function HeavenHighController:sender25242( )
	local protocal = {}
    self:SendProtocal(25242, protocal)
end
function HeavenHighController:handle25242( data )
	local status = false
    for k, v in pairs(data.red_point_list) do
        status = status or v.code == 1
        if status then
            break
        end
    end

    self.model:setHeavenHighLoginRed(status)
end

-- 检测挑战次数并且进入战斗
function HeavenHighController:checkJoinHeavenBattle(formations )
	self:sender25246(formations)
end

--领取每日奖励
function HeavenHighController:getkDailyReward(  )
	self:sender25248()
end

-----------------------@ 界面相关
-- 打开天界副本主界面 chapter_id:强制打开某一章节
function HeavenHighController:openHeavenMainWindow( status, chapter_id,group_id,is_open_chapter,is_first)
	if status == true then
		-- 判断是否开启
		if not self.model:checkHeavenIsOpen() then
			return
		end
		
		if not self.heaven_main_wnd then
			self.heaven_main_wnd = HeavenHighChapterWindow.New()
			self:sender25234()
		end
		
		if self.heaven_main_wnd:isOpen() == false then
			local list = {group_id = group_id,is_open_chapter = is_open_chapter,chapter_id = chapter_id}
			self.heaven_main_wnd:open(list,is_first)
		end		
	else
		if self.heaven_main_wnd then
			self.heaven_main_wnd:close()
			self.heaven_main_wnd = nil
		end
	end
end
-- 打开天界章节界面
function HeavenHighController:openHeavenHighChapterWindow( status, chapter_id ,is_first)
	if status == true then
		if not self.heaven_chapter_wnd then
			self.heaven_chapter_wnd = HeavenHighChapterWindow.New()
			self:sender25234()
		end
		if self.heaven_chapter_wnd:isOpen() == false then
			self.heaven_chapter_wnd:open(chapter_id,is_first)
		end
	else
		if self.heaven_chapter_wnd then
			self.heaven_chapter_wnd:close()
			self.heaven_chapter_wnd = nil
		end
	end
end
-- 是否打开天界章节界面
function HeavenHighController:getHeavenHighChapterWindowIsOpen()
	if self.heaven_main_wnd then
		return self.heaven_main_wnd:isOpen()
	end
end
