HeavenHighController = HeavenHighController or BaseClass(BaseController)

function HeavenHighController:config()
    self.model = HeavenHighModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function HeavenHighController:getModel()
    return self.model
end

function HeavenHighController:registerEvents()
	-- 断线重连时需要清掉缓存数据
    if self.re_link_game_event == nil then
        self.re_link_game_event = GlobalEvent:getInstance():Bind(LoginEvent.RE_LINK_GAME, function()
        	self.model:clearData()
        	self:sender25234()
        end)
    end
end

-------------------@ c2s
-- 请求天界基础数据
function HeavenHighController:sender25234(  )
	self:SendProtocal(25234, {})
end

-- 请求天界某一章节数据
function HeavenHighController:sender25235( id )
	local protocal = {}
	protocal.id = id
    self:SendProtocal(25235, protocal)
end

-- 请求挑战副本
function HeavenHighController:sender25238( id, order_id )
	local protocal = {}
	protocal.id = id
	protocal.order_id = order_id
    self:SendProtocal(25238, protocal)
end

-- 请求天界副本阵法数据
function HeavenHighController:sender25247(num)
	if num then
		self.team_num = num
	end
	local protocal = {}
    self:SendProtocal(25247, protocal)
end

-- 设置天界副本阵法数据
function HeavenHighController:sender25246( formations )
	local protocal = {}
	protocal.formations = formations
    self:SendProtocal(25246, protocal)
end

-- 请求领取章节星级奖励
function HeavenHighController:sender25244( id, award_id )
	local protocal = {}
	protocal.id = id
	protocal.award_id = award_id
    self:SendProtocal(25244, protocal)
end

function HeavenHighController:printData(id,data)
	-- print("龙地洞协议返回",id,vardump(data))
end

------------------@ s2c
function HeavenHighController:registerProtocals()
	self:RegisterProtocal(25234, "handle25234")     -- 天界基础数据  25200
	self:RegisterProtocal(25235, "handle25235")     -- 天界某一章节数据  25201
	self:RegisterProtocal(25236, "handle25236")     -- 天界基础数据更新   25203
	self:RegisterProtocal(25237, "handle25237")     -- 天界某一章数据更新  25204
	self:RegisterProtocal(25238, "handle25238")     -- 天界挑战关卡  25205
	self:RegisterProtocal(25239, "handle25239")     -- 天界挑战结算  25206
	self:RegisterProtocal(25244, "handle25244")     -- 领取章节奖励返回  25215
	self:RegisterProtocal(25245, "handle25245")     -- 当前是否还有未完成的战斗  25216
	self:RegisterProtocal(25246, "handle25246")     -- 设置阵法数据返回  25211
	self:RegisterProtocal(25247, "handle25247")     -- 天界副本阵法数据  25210
	self:RegisterProtocal(25248, "handle25248")     -- 每日奖励  25233
	self:RegisterProtocal(25249, "handle25249")     -- 领取钥匙
	self:RegisterProtocal(25250, "handle25250")     -- 龙地洞进阶开启
	self:RegisterProtocal(25251, "handle25251")     -- 战斗中星级条件刷新
	self:RegisterProtocal(25254, "handle25254")     -- 战令基本信息
	self:RegisterProtocal(25255, "handle25255")     -- 战令一键领取
	self:RegisterProtocal(25256, "handle25256")     -- 战令任务基本信息
	self:RegisterProtocal(25257, "handle25257")     -- 战令任务领取

	self:RegisterProtocal(25242, "handle25242")     -- 龙地洞登录红点
end

-- 天界基础数据
function HeavenHighController:handle25234( data )
	self:printData(25234,data)
	if data then
		if data.count then
			self.model:setLeftChallengeCount(data.count)
		end
		if data.buy_count then
			self.model:setTodayBuyCount(data.buy_count)
		end
		if data.max_dun_id then
			self.model:setMaxDunId(data.max_dun_id)
		end
		if data.chapter_info then
			self.model:setChapterData(data.chapter_info)
		end
		if data.open then
			self.model:setHeavenHighOpen(data.open)
		end
		if data.daily_reward then
			self.model:setDailyReward(data)
		end
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Get_Chapter_Data_Event)
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Update_Chapter_Basedata_Event)
	end
end

-- 天界某一章节数据
function HeavenHighController:handle25235( data )
	self:printData(25235,data)
	if data then
		if data.dun_info then
			self.model:setCustomsData(data.dun_info, data.id)
		end
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Update_Chapter_Basedata_Event)
	end
end

-- 天界基础数据更新
function HeavenHighController:handle25236( data )
	self:printData(25236,data)
	if data then
		if data.count then
			self.model:setLeftChallengeCount(data.count)
		end
		if data.buy_count then
			self.model:setTodayBuyCount(data.buy_count)
		end
		if data.max_dun_id then
			self.model:setMaxDunId(data.max_dun_id)
		end
		if data.chapter_info then
			self.model:updateChapterData(data.chapter_info)
		end
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Update_Chapter_Count_Event)
	end
end

-- 天界某一章数据更新
function HeavenHighController:handle25237( data )
	self:printData(25237,data)
	if data then
		if data.dun_info then
			self.model:updateCustomsData(data.dun_info, data.id)
			GlobalEvent:getInstance():Fire(HeavenHighEvent.Update_Chapter_Basedata_Event)
		end
	end
end

-- 挑战关卡
function HeavenHighController:handle25238( data )
	self:printData(25238,data)
	if data then
		message(data.msg)
	end
end

-- 挑战结算
function HeavenHighController:handle25239( data )
	self:printData(25239,data)
	if data then
		BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.HeavenHighWar, data)
	end
end

-- 天界副本阵法数据
function HeavenHighController:handle25247( data )
	self:printData(25247,data)
	for key, value in pairs(data.formations) do
		if value.order > self.team_num then
			value.pos_info = {}
		end
	end
	self.model:setBossForm(data,self.team_num)
end

-- 设置阵法数据返回
function HeavenHighController:handle25246( data )
	self:printData(25246,data)
	if data then
		if data.code == 1 then
			message(TI18N("语言_c_5804"))
		else
			message(data.msg)
		end
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Save_Heaven_Fun_Form, data)
		MainuiController:getInstance():getMainUi():setDialRed()
	end
end

-- 领取章节奖励返回
function HeavenHighController:handle25244( data )
	self:printData(25244,data)
	if data then
		message(data.msg)
		local temp_data = {}
		temp_data.award_info = data.award_info
		self.model:updateOneChapterDataById(data.id, temp_data)
		GlobalEvent:getInstance():Fire(HeavenHighEvent.Get_Chapter_Award_Event)
	end
end

-- 是否还有未完成的战斗
function HeavenHighController:handle25245( data )
	self:printData(25245,data)
	if data then
		BattleController:getInstance():getModel():setUnfinishedWarStatus(data.combat_type, data.flag)
		if data.flag == 0 then -- 服务端可能会先告知客户端有战斗，再结算，再告知无战斗
			MainuiController:getInstance():openRelevanceWindowAtOnce(data.combat_type)
		end
	end
end

