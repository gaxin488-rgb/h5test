--请求阵法
function ArenaWorldController:handle14333( data )
	-- print(vardump(data))
	local model = HeroController:getInstance():getModel()
	if data.type == 2 then
		for i,v in ipairs(data.formations) do
			v.type = PartnerConst.Fun_Form.ArenaWorldDef
			model:setFormList(v, v.order)
		end
		self:setDefRedPoint(data)
    end 
    GlobalEvent:getInstance():Fire(ArenaWorldEvent.GetArenaTeamData,data)
end

--防守阵容的红点
function ArenaWorldController:setDefRedPoint(data)
	local model = HeroController:getInstance():getModel()
	local max, count = model:getHeroMaxCount()
	local team_list = {1,2}
	local use_num = 0
	local is_empty = false
	self.def_red_point = false
	if data.type == 2 and data.formations then
		for i,v in ipairs(team_list) do
			local team_info = data.formations[v]
			if team_info then --
				local pos_info = team_info.pos_info
				local num = #pos_info
				use_num = use_num + num
				if num == 0 then --说明本队没数据
					is_empty = true
				end
			else
				is_empty = true
			end
		end
		--当前拥有未上阵的忍者数量≥1个时，时空竞技场如果有一个队伍未上阵忍者，图上的入口需要显示红点
		if is_empty and count - use_num > 0 then
			self.def_red_point = true
		end
    end 
	-- print(self.def_red_point,"self.def_red_point")
	self.model:updateArenaRedStatus(777, self.def_red_point)
end

function ArenaWorldController:getDefRedPoint()
	return self.def_red_point
end

--设置阵法
function ArenaWorldController:handle14332( data )
    if data then
		if data.code == 1 then
			if self.isTips == 0 then
				message(data.msg)
			end
		else
			if self.isTips == 0 then
				message(data.msg)
			end
			GlobalEvent:getInstance():Fire(HeroEvent.Hero_no_Sacrifice_bttom_Event,data.msg,PartnerConst.Fun_Form.ArenaWorldDef)
			HeroController:getInstance():getModel():NextBattle(14332)
		end
		self.isTips = 0
		if data.code == 1 then -- 设置阵法成功，则通知布阵界面进入战斗
			if self.record_formations then
				local model = HeroController:getInstance():getModel()
				for i,v in ipairs(self.record_formations) do
					if self.record==2 then
						v.type = PartnerConst.Fun_Form.ArenaWorldDef
						model:setFormList(v, v.team_id)
					end
				end
			end
			HeroController:getInstance():getModel():NextBattle(14332)
			GlobalEvent:getInstance():Fire(ArenaWorldEvent.ARENAWORLD_SAVE_FROM_EVENT)
		end
	end
end

-- 天梯结算界面
function ArenaWorldController:openArenaBattleResultWindow( status, data )
	if status then
		if self.arena_result_window == nil then
			self.arena_result_window = ArenaWorldBattleResultWindow.New()
		end
		self.arena_result_window:open(data)
	else
		if self.arena_result_window then
			self.arena_result_window:close()
			self.arena_result_window = nil
		end
	end
end

-- 检测挑战次数并且进入战斗
function ArenaWorldController:checkJoinArenaBattle( data, is_quick )
	local myBaseInfo=self.model:getArenaMyBaseInfo()
	if myBaseInfo.can_combat_num<1 then
		local role_vo = RoleController:getInstance():getRoleVo()
		local buy_combat_num = myBaseInfo.buy_combat_num or 0
		local cost_config = Config.ArenaWorldData.data_buy_num[buy_combat_num+1]
		if cost_config then
			if role_vo.vip_lev >= cost_config.vip then
				local msg =string.format(TI18N("语言_c_2844"),PathTool.getItemRes(Config.ItemData.data_assets_label2id.gold),cost_config.cost)
				CommonAlert.show(
					msg,
					TI18N("语言_c_63"),
					function()
						self.temp_data = data
						self:requestBuyChallengeCount()
					end,
					TI18N("语言_c_62"),
					nil,
					CommonAlert.type.rich
				)
			else
				message(TI18N("语言_c_2851"))
			end
		else
			message(TI18N("语言_c_2842"))
		end
	    return 
    end
     self:openArenaWorldMatchingWindow(true,data)
end

