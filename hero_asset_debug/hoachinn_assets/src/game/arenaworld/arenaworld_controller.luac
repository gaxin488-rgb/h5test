--打开天梯匹配界面
function ArenaWorldController:openArenaWorldMatchingWindow(status,scdata)
    if status == true then
        if self.arenaworld_matching_window == nil then
            self.arenaworld_matching_window = ArenaWorldMatchingWindow.New()
        end
        if self.arenaworld_matching_window:isOpen() == false then
            self.arenaworld_matching_window:open(scdata)
        end
    else
        if self.arenaworld_matching_window then
            self.arenaworld_matching_window:close()
            self.arenaworld_matching_window = nil
        end
    end
end

