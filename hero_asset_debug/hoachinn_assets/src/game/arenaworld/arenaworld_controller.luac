end

-- 请求日志详情
function ArenaWorldController:requestLogInfo(type,id)
	local protocal = {}
	protocal.type = type
    protocal.id = id
	self:SendProtocal(14313,protocal)
end 

-- 请求天梯录像分享
function ArenaWorldController:requestShareVideo(replay_id, srv_id, channel, target_name )
	local protocal = {}
    protocal.replay_id = replay_id
    protocal.srv_id = srv_id
    protocal.channel = channel
    protocal.target_name = target_name
    self:SendProtocal(14318, protocal)
end

-- 请求布阵
function ArenaWorldController:send14333(type)
	local protocal = {}
    protocal.type = type
    self:SendProtocal(14333, protocal)
end

-- 设置阵法
function ArenaWorldController:send14332(type,formations,isTips)
	self.isTips = isTips or 0
	local protocal = {}
    protocal.type = type
	protocal.formations = formations
	self.record=type
	self.record_formations = formations
    self:SendProtocal(14332, protocal)
end

----------------------------@ s2c
function ArenaWorldController:registerProtocals()
	self:RegisterProtocal(14300, "handle14300")     -- 个人数据
	self:RegisterProtocal(14301, "handle14301")     -- 挑战对手列表
	self:RegisterProtocal(14302, "handle14302")     -- 对手数据
	self:RegisterProtocal(14303, "handle14303")     -- 挑战对手
	self:RegisterProtocal(14304, "handle14304")     -- 刷新对手
	self:RegisterProtocal(14305, "handle14305")     -- 购买挑战次数
	self:RegisterProtocal(14306, "handle14306")     -- 一键挑战
	self:RegisterProtocal(14307, "handle14307")     -- 挑战结算
	self:RegisterProtocal(14308, "handle14308")     -- 前六名玩家数据
	self:RegisterProtocal(14309, "handle14309")     -- 排行榜数据
	self:RegisterProtocal(14310, "handle14310")     -- 我的记录
	self:RegisterProtocal(14311, "handle14311")     -- 大神风采
	self:RegisterProtocal(14312, "handle14312")     -- 红点信息
	self:RegisterProtocal(14313, "handle14313")     -- 日志详情
	-- self:RegisterProtocal(14314, "handle14314")     -- 战报红点
	self:RegisterProtocal(14315, "handle14315")     -- 清除cd时间
	self:RegisterProtocal(14316, "handle14316")     -- 查看英雄信息
	self:RegisterProtocal(14317, "handle14317")     -- 挑战次数红点
	self:RegisterProtocal(14318, "handle14318")     -- 录像分享
	self:RegisterProtocal(14332, "handle14332")     -- 设置阵法
	self:RegisterProtocal(14333, "handle14333")     -- 请求阵法
end

-- 个人数据
function ArenaWorldController:handle14300( data )
	if data then
		self.model:setArenaMyBaseInfo(data)
	end
	GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaMyBaseInfo)
end

-- 挑战对手列表
function ArenaWorldController:handle14301( data )
	if data then
		if data.type == 0 then -- 全部更新
			self.model:setArenaEnemyListData(data.f_list)
		else -- 部分更新
			self.model:updateArenaEnemyListData(data.f_list)
		end
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateAllArenaEnemyList)
	end
end

-- 对手数据
function ArenaWorldController:handle14302( data )
	if data then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.GetArenaEnemyData, data)
	end
end

-- 挑战对手
function ArenaWorldController:handle14303( data )
	message(data.msg)
    self:openArenaRoleInfoWindow(false)
end

-- 刷新对手
function ArenaWorldController:handle14304( data )
	message(data.msg)
end

-- 购买挑战次数
function ArenaWorldController:handle14305( data )
	message(data.msg)
	if data.code == 1 and self.temp_data~=nil then
		-- self:requestChallengeEnemy(self._temp_rid, self._temp_srv_id)
		self:openArenaWorldMatchingWindow(true,self.temp_data)
		self.temp_data = nil
	elseif data.code == 1 and self._temp_quick_flag then
		self:requestQuickChallenge()
		self._temp_quick_flag = nil
	end
end

-- 一键挑战
function ArenaWorldController:handle14306( data )
	message(data.msg)
end

-- 挑战结算
function ArenaWorldController:handle14307( data )
	-- self.model:updateCombatCount()
	data.item_rewards = data.reward
	table.sort(data.all_hurt_statistics, function(a, b) return a.round < b.round end)
	data.hurt_statistics=data.all_hurt_statistics
	BattleController:getInstance():openFinishView(true,BattleConst.Fight_Type.ArenaWorld, data)
end

-- 前六名数据
function ArenaWorldController:handle14308( data )
	if data and data.rank_list then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaTopSixRoleData, data.rank_list)
	end
end

-- 排行榜数据
function ArenaWorldController:handle14309( data )
	if data then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaRankData, data)
	end
end

-- 我的记录
function ArenaWorldController:handle14310( data )
	if data then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaMyLogData, data)
	end
end

-- 大神风采
function ArenaWorldController:handle14311( data )
	if data then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaGodLogData, data)
	end
end

-- 天梯是否开启
function ArenaWorldController:handle14312( data )
	if data and data.red_point_list then
        for i,v in pairs(data.red_point_list) do
            self.model:updateArenaRedStatus(v.type, v.code==1)
		end
		-- self.model:updateArenaRedStatus(ArenaWorldConst.RedType.TopThree, )
		-- self.model:setArenaOpenStatus(data.code)
		-- GlobalEvent:getInstance():Fire(ArenaWorldEvent.UpdateArenaOpenStatus)
	end
end

-- 日志详情
function ArenaWorldController:handle14313( data )
	if data.arena_world_replay_list and next(data.arena_world_replay_list)~=nil then
		GlobalEvent:getInstance():Fire(ArenaWorldEvent.GetArenaRecordInfo,data)
	end
end

