ArenaWorldController = ArenaWorldController or BaseClass(BaseController)

function ArenaWorldController:config()
    self.model = ArenaWorldModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function ArenaWorldController:getModel()
    return self.model
end

function ArenaWorldController:registerEvents()
	if self.init_role_event == nil then
        self.init_role_event = GlobalEvent:getInstance():Bind(EventId.ROLE_CREATE_SUCCESS, function()
            GlobalEvent:getInstance():UnBind(self.init_role_event)
            self.init_role_event = nil
            --上线时请求
            -- self:requestArenaRedStatus()
        end)
    end
end

function ArenaWorldController:openArenaChoosePanel(status)
    if status == false then
        if self.Arena_choose ~= nil then
            self.Arena_choose:close()
            self.Arena_choose = nil
        end
    else
        if self.Arena_choose == nil then
            self.Arena_choose = ArenaWorldChoosePanel.New(self)
        end
        if self.Arena_choose and self.Arena_choose:isOpen() == false then
            self.Arena_choose:open()
        end
    end
end

-----------------------------@ c2s
-- 请求天梯个人信息
function ArenaWorldController:requestArenaMyBaseInfo(  )
	self:SendProtocal(14300, {})
end

-- 请求挑战列表
function ArenaWorldController:requestArenaEnemyListData(  )
	self:SendProtocal(14301, {})
end

-- 请求玩家信息
function ArenaWorldController:requestArenaEnemyData( rid, srv_id )
	local protocal = {}
    protocal.rid = rid
    protocal.srv_id = srv_id
    self:SendProtocal(14302, protocal)
end

-- 请求挑战玩家
function ArenaWorldController:requestChallengeEnemy( rid, srv_id,is_auto )
	local protocal = {}
    protocal.rid = rid
    protocal.srv_id = srv_id
	protocal.is_auto = is_auto     --self.model:getAutoBattle() or 0
    self:SendProtocal(14303, protocal)
end

-- 请求刷新对手列表
function ArenaWorldController:requestRefreshEnemyList(  )
	self:SendProtocal(14304, {})
end

-- 请求购买挑战次数
function ArenaWorldController:requestBuyChallengeCount()
	self:SendProtocal(14305, {})
end

-- 请求一键挑战
function ArenaWorldController:requestQuickChallenge(num)
	local protocal = {}
	if num then
		protocal.num = num
	end
	self.isOneKey=true
	self:SendProtocal(14306, protocal)
end

