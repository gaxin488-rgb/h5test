----------------------@ 打开界面
-- 天梯主界面
function ArenaWorldController:openMainWindow( status )
	if status then
		local role_vo = RoleController:getInstance():getRoleVo()
		local config = Config.ArenaWorldData.data_const.opening_lv
		if role_vo.lev < config.val then
	        message(config.desc)
	        return 
	    end

		if self.Arena_main_window == nil then
			self.Arena_main_window = ArenaWorldMainWindow.New()
		end
		self.Arena_main_window:open()
	else
		if self.Arena_main_window then
			self.Arena_main_window:close()
			self.Arena_main_window = nil
		end
	end
end

-- 天梯商店
function ArenaWorldController:openArenaShopWindow( status )
	if status then
		if self.Arena_shop_window == nil then
			self.Arena_shop_window = ArenaWorldShopWindow.New()
		end
		self.Arena_shop_window:open()
	else
		if self.Arena_shop_window then
			self.Arena_shop_window:close()
			self.Arena_shop_window = nil
