function ArenaWorldMainWindow:refreshSixRank( data )
	data = data or {}
	self.rankData=data
	local function sortFunc( objA, objB )
		if objA.rank ~= 0 and objB.rank ~= 0 then
			return objA.rank < objB.rank
		elseif objA.rank == 0 and objB.rank ~= 0 then
			return false
		elseif objA.rank ~= 0 and objB.rank == 0 then
			return true
		else
			return false
		end
	end
	table.sort(data, sortFunc)
	for i=1,6 do
		delayRun(self.honour_container, i*4/60, function()
			local honor_item = self.honor_items[i]
            if not honor_item then
                honor_item = AreanWorldHonourItem:new()
                local honour_panel = self.honour_panels[i]
				honor_item:setAnchorPoint(cc.p(0.5,0.5))
				honour_panel:addChild(honor_item)
                honor_item:setPosition(cc.p(0, self.honour_panel_size.height-100))
                self.honor_items[i] = honor_item
            end
			local rankData ={}
			for k,v in pairs(data) do 
                if v.rank==i then
					rankData = v
				end
			end
            if rankData and next(rankData) ~= nil then
            	honor_item:setData(rankData,i)
            	honor_item:setVisible(true)
				self.info_bgs[i]:setVisible(false)
            else
            	honor_item:setVisible(false)  
				self.info_bgs[i]:setVisible(true)
            end
        end)
	end
end

-- 切换标签页
function ArenaWorldMainWindow:changeSelectedTab( index )
	if self.tab_object ~= nil and self.tab_object.index == index then return end
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        self.tab_object = nil
    end
    self.tab_object = self.tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
    end
	self.main_container:setVisible(index==1)
	self.honour_container:setVisible(index==2)
	if index==2 and self.myBaseInfo then
		controller:requestTopSixRoleData(self.myBaseInfo.zone_id)	
	end
	-- if index == CrossArenaWorldConst.Sub_Type.Challenge then
	-- 	self.background:loadTexture(PathTool.getPlistImgForDownLoad("crossarena","crossarena_25",true), LOADTEXT_TYPE)
	-- else
	-- 	self.background:loadTexture(PathTool.getPlistImgForDownLoad("crossarena","crossarena_28",true), LOADTEXT_TYPE)
	-- end
end

-- 添加挑战次数
function ArenaWorldMainWindow:_onClickBtnAdd(  )
	local is_open = model:getArenaIsOpen()
	if not is_open then
		local txt_cfg = Config.ArenaWorldData.data_const["close_text"]
		if txt_cfg then
			message(string.format(TI18N("语言_c_5891")))
			-- message(string.format(TI18N("语言_c_4109"), txt_cfg.desc))
		end
		return
	end
	if self.myBaseInfo then
		local role_vo = RoleController:getInstance():getRoleVo()
		local buy_combat_num = self.myBaseInfo.buy_combat_num or 0
		local cost_config = Config.ArenaWorldData.data_buy_num[buy_combat_num+1]
		if cost_config then
			if role_vo.vip_lev >= cost_config.vip then
				local msg =string.format(TI18N("语言_c_2844"),PathTool.getItemRes(Config.ItemData.data_assets_label2id.gold),cost_config.cost)
	            CommonAlert.show(
	                msg,
	                TI18N("语言_c_63"),
	                function()
	                    controller:requestBuyChallengeCount()
	                end,
	                TI18N("语言_c_62"),
	                nil,
	                CommonAlert.type.rich
	            )
			else
				message(TI18N("语言_c_2851"))
				--message(string.format(TI18N("语言_c_2843"), cost_config.vip))
			end
		else
			message(TI18N("语言_c_2842"))
		end
	end
end
