function ArenaWorldMainWindow:close_callback(  )
	if self.Arena_mybaseinfo_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.Arena_mybaseinfo_event)
        self.Arena_mybaseinfo_event = nil
    end
    if self.Arena_update_enemy_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.Arena_update_enemy_event)
        self.Arena_update_enemy_event = nil
    end
	if self.arena_top_six_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.arena_top_six_event)
        self.arena_top_six_event = nil
    end
    if self.update_red_status_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_red_status_event)
        self.update_red_status_event = nil
    end
    if self.defance_red_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.defance_red_event)
        self.defance_red_event = nil
    end
	if self.update_worship_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_worship_event)
        self.update_worship_event = nil
    end
    if self.role_vo ~= nil then
        if self.role_assets_event ~= nil then
            self.role_vo:UnBind(self.role_assets_event)
            self.role_assets_event = nil
        end
    end
    
    for k,item in pairs(self.role_items) do
    	item:DeleteMe()
    	item = nil
    end

    self:openArenaTimer(false)
	controller:openMainWindow(false)
end