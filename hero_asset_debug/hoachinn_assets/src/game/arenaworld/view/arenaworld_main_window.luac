ArenaWorldMainWindow = ArenaWorldMainWindow or BaseClass(BaseView)

local controller = ArenaWorldController:getInstance()
local model = controller:getModel()

function ArenaWorldMainWindow:__init()
	self.is_full_screen = true
	self.layout_name = "arenaworld/arenaworld_main_window"

	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("space_arena", "space_arena"), type = ResourcesType.plist},
	}

	self.role_vo = RoleController:getInstance():getRoleVo()
	self.tab_list = {}
	self.role_panels = {}
	self.honour_panels = {}
	self.info_bgs={}
	self.role_items = {}
	self.honor_items = {}
end

function ArenaWorldMainWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end

	local main_container = self.root_wnd:getChildByName("main_container")
	self.close_btn = self.root_wnd:getChildByName("close_btn")
	self.main_container = main_container
    self:playEnterAnimatianByObj(main_container , 1) 
	local tab_container = self.root_wnd:getChildByName("tab_container")
	for i=1,2 do
		local tab_btn = tab_container:getChildByName("tab_btn_" .. i)
		if tab_btn then
			local object = {}
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(true)
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
			object.text = tab_btn:getChildByName('text')
            object.tab_btn = tab_btn
            object.index = i
            self.tab_list[i] = object
		end
	end
	self.tab_list[1].text:setString(TI18N("语言_c_5948"))
	self.tab_list[2].text:setString(TI18N("语言_c_4902"))
	setTextSpacing(self.tab_list[1].text,-10)
	setTextSpacing(self.tab_list[2].text,-10)

	self.btn_rule = self.main_container:getChildByName("btn_rule")
	self.btn_role = self.main_container:getChildByName("btn_role")
	self.btn_log = self.main_container:getChildByName("btn_log")
	self.btn_rank = self.main_container:getChildByName("btn_rank")
	self.btn_shop = self.main_container:getChildByName("btn_shop")
	self.btn_role:getChildByName("label"):setString(TI18N("语言_c_166"))
	local shop_label=self.btn_shop:getChildByName("label")
	setTextMaxWidth(shop_label,100)
	setTextSpacing(shop_label,-10)
	shop_label:setString(TI18N("语言_c_5922"))
	self.btn_rank:getChildByName("label"):setString(TI18N("语言_c_271"))
	self.btn_log:getChildByName("label"):setString(TI18N("语言_c_2595"))
	local bottom_panel = main_container:getChildByName("bottom_panel")
	self.bottom_panel = bottom_panel
	self.rank_bg = bottom_panel:getChildByName("rank_bg")
	local black_bg = bottom_panel:getChildByName("black_bg")
	self.rank_title=bottom_panel:getChildByName("label_1")
	self.rank_title:setFontSize(22)
	self.rank_title:setString(TI18N("语言_c_2553"))
	local label_2=bottom_panel:getChildByName("label_2")
	label_2:setString(TI18N("语言_c_21"))
	self.label_3=bottom_panel:getChildByName("label_3")
	self.label_3:setString(TI18N("语言_c_5881"))
	self.label_3:setPositionX(bottom_panel:getContentSize().width - 20)
	self.rank_label = bottom_panel:getChildByName("rank_label")
	self.rank_label:setFontSize(22)
	self.local_label=bottom_panel:getChildByName("local_label")
	self.local_label:setPositionX(bottom_panel:getContentSize().width - 20)
    self.reward_layout=bottom_panel:getChildByName("reward_layout")
	self.reward_layout:setPositionX(label_2:getPositionX() + label_2:getContentSize().width + 10)
	self.season_label = bottom_panel:getChildByName("season_label")
	self.season_label:setFontSize(22)
	self.season_label:setString(TI18N("语言_c_552"))
	self.season_label:setAnchorPoint(cc.p(0,0.5))
	self.season_val = bottom_panel:getChildByName("season_val")
	self.season_val:setFontSize(22)
	self.season_val:setAnchorPoint(cc.p(1,0.5))
	self.tips_label=self.main_container:getChildByName("tips_label")
	self.tips_label:setString(TI18N("语言_c_4106"))
    local score_image=bottom_panel:getChildByName("score_image")
	self.score_image = score_image
    local itemcfg = Config.ItemData.data_get_data(45)
    if itemcfg then
        local icon_res = PathTool.getItemRes(itemcfg.icon)
        loadSpriteTexture(score_image, icon_res, LOADTEXT_TYPE)
        score_image:setScale(0.3)
    end
    self.score_val=bottom_panel:getChildByName("score_val")
	self.score_val:setFontSize(22)
	self.score_val:setString(self.role_vo.arena_world_cent)
	self.score_val:setAnchorPoint(cc.p(1,0.5))
	self.score_val:setPositionX(bottom_panel:getContentSize().width-10)
	self:updateScorePos()
	self.count_bg = main_container:getChildByName("count_bg")
	self.count_title = self.count_bg:getChildByName("count_title")
	self.count_title:setString(TI18N("语言_c_92"))
	self.count_label = self.count_bg:getChildByName("count_label")
	self.add_btn = self.count_bg:getChildByName("add_btn")

	self.time_label = main_container:getChildByName("time_label")
	self.time_label:setString(TI18N("语言_c_2759"))
	self.time_val = main_container:getChildByName("time_val")
	self.refresh_btn = main_container:getChildByName("refresh_btn")
	self.refresh_btn._can_touch = true
	self.refresh_btn_label = self.refresh_btn:getChildByName("label")
	self.refresh_btn_label:setString(TI18N("语言_c_468"))
	self.challenge_btn = main_container:getChildByName("challenge_btn")
	self.challenge_btn_label = self.challenge_btn:getChildByName("label")
	self.challenge_btn_label:setString(TI18N("语言_c_4107"))

	for i=1,5 do
		local role_panel = main_container:getChildByName(string.format("role_pos_%d", i))
		self.role_panels[i] = role_panel
	end
	self.role_panel_size = self.role_panels[1]:getContentSize()
	-- 适配
	local scale_off = display.getMaxScale(self.root_wnd)
	local top_off = display.getTop(main_container)
	local bottom_off = display.getBottom(main_container)
	local left_off = display.getLeft(main_container)
	local right_off = display.getRight(main_container)
    tab_container:setPositionY(top_off - 125*scale_off)
	self.time_label:setPositionY(top_off - 180*scale_off)
	self.time_val:setPositionY(top_off - 180*scale_off)
    self.bottom_panel:setPositionY(bottom_off+280*scale_off)

	self.honour_container=self.root_wnd:getChildByName("honour_container")
	self.btn_battle=self.honour_container:getChildByName("btn_battle")
	self.btn_battle:getChildByName("label"):setString(TI18N("语言_c_5432"))
	for i=1,6 do
		local honour_panel = self.honour_container:getChildByName(string.format("honour_pos_%d", i))
		self.honour_panels[i] = honour_panel
		local info_bg = self.honour_container:getChildByName(string.format("info_bg%d", i))
        info_bg:getChildByName("tips"):setString(TI18N("语言_c_526"))
		self.info_bgs[i]=info_bg
	end
	self.honour_panel_size = self.honour_panels[1]:getContentSize()
	black_bg:setScaleX(display.getScale())
	self.close_btn:setPositionY(bottom_off+149*scale_off)
	self.refresh_btn:setPosition(cc.p(left_off+125, bottom_off+160*scale_off))
	self.btn_rule:setPosition(cc.p(left_off+self.btn_rule:getPositionX(), bottom_off+self.btn_rule:getPositionY()*scale_off))
	self.time_val:setPositionX(self.time_label:getPositionX()+self.time_label:getContentSize().width + 5)
	-- self.time_val:setPosition(cc.p(left_off+self.time_val:getPositionX(), bottom_off+self.time_val:getPositionY()*scale_off))
	self.count_bg:setPosition(cc.p(left_off+self.count_bg:getPositionX(), bottom_off+self.count_bg:getPositionY()*scale_off))
	-- self.season_bg:setPosition(cc.p(left_off+self.season_bg:getPositionX(), bottom_off+self.season_bg:getPositionY()*scale_off))
	self.challenge_btn:setPosition(cc.p(360, bottom_off+160*scale_off))
	self.tips_label:setPosition(cc.p(360, bottom_off+205*scale_off))
	self.count_label:setPositionX(self.count_title:getPositionX() + self.count_title:getContentSize().width + 5)
    self.season_val:setPositionX(self.season_label:getPositionX() + self.season_label:getContentSize().width + 5)
	self.add_btn:setPositionX(self.count_label:getPositionX() + self.count_label:getContentSize().width + 15)
	local scroll_view_size = self.reward_layout:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 3,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.5,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.5,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.5
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.reward_layout, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
end
function ArenaWorldMainWindow:updateScorePos()
	self.score_image:setPositionX(self.bottom_panel:getContentSize().width-15 - self.score_image:getContentSize().width*0.3)
	self.score_val:setPositionX(self.score_image:getPositionX() - 10)
	self.score_txt = createLabel(22,cc.c3b(0xf9,0xee,0xd0),nil,self.score_val:getPositionX() - self.score_val:getContentSize().width-10,self.score_val:getPositionY(),TI18N("语言_c_6056"),self.bottom_panel,nil,cc.p(1,0.5))
end
function ArenaWorldMainWindow:refreshRoleList(  )
	local enemy_datas = model:getArenaEnemyListData()
	local function sortFunc( objA, objB )
		if objA.rank ~= 0 and objB.rank ~= 0 then
			return objA.rank < objB.rank
		elseif objA.rank == 0 and objB.rank ~= 0 then
			return false
		elseif objA.rank ~= 0 and objB.rank == 0 then
			return true
		else
			return false
		end
	end
	table.sort(enemy_datas, sortFunc)	
	for i=1,5 do
		delayRun(self.main_container, i*4/60, function()
			local role_item = self.role_items[i]
            if not role_item then
                role_item = ArenaWorldRoleItem.new()
                local role_panel = self.role_panels[i]
                role_item:setPosition(cc.p(self.role_panel_size.width/2, self.role_panel_size.height-150))
                role_panel:addChild(role_item)
                self.role_items[i] = role_item
            end
            local enemy_data = enemy_datas[i]
            if enemy_data and next(enemy_data) ~= nil then
            	role_item:setData(enemy_data)
            	role_item:setVisible(true)
            else
            	role_item:setVisible(false)
            end
        end)
	end
end


-- 刷新个人信息数据
function ArenaWorldMainWindow:refreshMyBaseInfo(  )
	self.myBaseInfo = model:getArenaMyBaseInfo()
	local is_open = model:getArenaIsOpen()
	local freetime = self.myBaseInfo and self.myBaseInfo.can_combat_num or 0
	self.count_label:setString(freetime)
	local count_width = self.count_label:getContentSize().width + self.count_title:getContentSize().width + self.add_btn:getContentSize().width +100
	self.count_bg:setContentSize(cc.size(count_width,52))
	-- 今日剩余购买次数
	if not self.left_buy_count then
        self.left_buy_count = createRichLabel(22, 1, cc.p(1, 0.5), cc.p(count_width - 20, -20))
        self.count_bg:addChild(self.left_buy_count)
    end
    local left_count = model:getTodayLeftBuyCount()
    self.left_buy_count:setString(string.format(TI18N("语言_c_5876"), left_count))
    
	if left_count == 0 and freetime == 0 then
		setChildUnEnabled(true, self.challenge_btn)
		self.challenge_btn:setTouchEnabled(false)
		self.challenge_btn_label:setTextColor(Config.ColorData.data_color4[1])
		self.challenge_btn_label:enableOutline(cc.c4b(0x49,0x49,0x49,0xff), 2)
	else
		setChildUnEnabled(false, self.challenge_btn)
		self.challenge_btn:setTouchEnabled(true)
		self.challenge_btn_label:setTextColor(cc.c4b(0xff,0xff,0xff,0xff))
		self.challenge_btn_label:enableOutline(cc.c4b(0x76,0x45,0x19,0xff), 2)
	end
	if not self.myBaseInfo.rank or self.myBaseInfo.rank == 0 then
		self.rank_label:setString(TI18N("语言_c_273"))
	else
		self.rank_label:setString(self.myBaseInfo.rank)
	end
	self:updateRewardList(self.myBaseInfo.rank)
	local total_rank_width = self.rank_title:getContentSize().width + self.rank_label:getContentSize().width + 45
	self.rank_bg:setContentSize(cc.size(total_rank_width, self.rank_bg:getContentSize().height))
	self.rank_label:setPositionX(self.rank_title:getContentSize().width + self.rank_title:getPositionX()+5)
	self.ref_time = self.myBaseInfo.ref_time or 0  -- 下次可刷新时间
	self.combat_time = self.myBaseInfo.combat_time or 0 -- 结束时间
	local cfg=model:getCurArea()
	if cfg then
		local location=cfg.name
		local round=cfg.round
		self.local_label:setString(string.format(location,round))
	end
	-- local start_str = TimeTool.getMD(self.myBaseInfo.start_time)
    -- local end_str = TimeTool.getMD(self.myBaseInfo.end_time)
	local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
    local st_m = TimeTool.xsdate("%m",self.myBaseInfo.start_time,timezone)
    local st_d = TimeTool.xsdate("%d",self.myBaseInfo.start_time,timezone)
    local et_m = TimeTool.xsdate("%m",self.myBaseInfo.end_time,timezone)
    local et_d = TimeTool.xsdate("%d",self.myBaseInfo.end_time,timezone)
    local st_str = st_m.."."..st_d
    local et_str = et_m.."."..et_d
	self.season_val:setString(st_str.."-"..et_str)
	local _w = self.season_label:getContentSize().width + self.season_val:getContentSize().width + 5
	self.season_label:setPositionX(self.bottom_panel:getContentSize().width*0.5 - _w*0.5)
	self.season_val:setPositionX(self.bottom_panel:getContentSize().width*0.5 + _w*0.5)
	local val=Config.ArenaWorldData.data_const.end_time.val
	local com_left_time =TimeTool.getOneDayLessTimeToPoint(val[1],val[2],val[3])
    local cur_time = GameNet:getInstance():getTime()
	-- local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
	-- local e_dZoneDiff = (timezone - TimeTool.getTimeZone())*3600
	-- local com_left_time = less_time -e_dZoneDiff- cur_time
	-- local com_left_time = self.combat_time --- cur_time
	if com_left_time < 0 then
		com_left_time = 0
	end
	-- 活动开启显示剩余时间、活动未开启显示参赛条件
	if not is_open then
		self.time_label:setVisible(false)
		self.time_val:setVisible(false)
		if not self.join_text then
			self.join_text = createRichLabel(22, 1, cc.p(0, 0.5), cc.p(400, 120),nil,nil,700)
			self.bottom_panel:addChild(self.join_text)
		end
		self.join_text:setVisible(true)
		local rank_cfg = Config.ArenaWorldData.data_const["arena_rank"]
		if rank_cfg then
			self.join_text:setString(string.format(TI18N("语言_c_4108"), rank_cfg.val))
		end
	else
		self.time_label:setVisible(true)
		self.time_val:setVisible(true)
		self.time_val:setString(TimeTool.GetTimeFormat(com_left_time))
		if self.join_text then
			self.join_text:setVisible(false)
		end
		self:openArenaTimer(true)
	end

	local ref_left_time = self.ref_time - cur_time
	if ref_left_time <= 0 and self.refresh_btn._can_touch == false then
		setChildUnEnabled(false, self.refresh_btn)
		self.refresh_btn:setTouchEnabled(true)
		self.refresh_btn._can_touch = true
		self.refresh_btn_label:enableOutline(cc.c3b(118,69,25), 2)
		self.refresh_btn_label:setString(TI18N("语言_c_468"))
	elseif ref_left_time > 0 and self.refresh_btn._can_touch == true then
		setChildUnEnabled(true, self.refresh_btn)
		self.refresh_btn:setTouchEnabled(false)
		self.refresh_btn._can_touch = false
		self.refresh_btn_label:disableEffect(cc.LabelEffect.OUTLINE)
		self.refresh_btn_label:setString(string.format(TI18N("语言_c_473"), ref_left_time))
	end
end

function ArenaWorldMainWindow:updateRewardList(myidx)
    local reward_list  = Config.ArenaWorldData.data_const["reward_preview"].val
    -- local item_data
    -- for i,v in pairs(reward_list) do
    --     if v.min<= myidx and v.max>=myidx then
    --         item_data=v.reward_d
    --         break
    --     end
    -- end
    if reward_list then
		self.item_scrollview:setData(reward_list)
        self.item_scrollview:addEndCallBack(function()
            local list = self.item_scrollview:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip()
            end
        end)
	end
end

-- 计时器
function ArenaWorldMainWindow:openArenaTimer( status )
	if status == true then
		if self.Arena_timer == nil then
            self.Arena_timer = GlobalTimeTicket:getInstance():add(function()
                local cur_time = GameNet:getInstance():getTime()
				-- local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
			    -- local e_dZoneDiff = (timezone - TimeTool.getTimeZone())*3600
				local val=Config.ArenaWorldData.data_const.end_time.val
				local com_left_time =TimeTool.getOneDayLessTimeToPoint(val[1],val[2],val[3])
				-- local end_time = os.time({year=year, month=month, day=day, hour=val[1], min=val[2], sec=val[3], isdst=false})
                -- local com_left_time = end_time -e_dZoneDiff- cur_time
                local ref_left_time = self.ref_time- cur_time
                if com_left_time <= 0 and ref_left_time <= 0 then
                	GlobalTimeTicket:getInstance():remove(self.Arena_timer)
            		self.Arena_timer = nil
                end
				if com_left_time < 0 then
					com_left_time = 0
				end
				if com_left_time <= 0 then
					self.time_label:setVisible(false)
					self.time_val:setVisible(false)
					if self.join_text then
						self.join_text:setVisible(true)
					end
				else
					self.time_label:setVisible(true)
					self.time_val:setVisible(true)
					self.time_val:setString(TimeTool.GetTimeFormat(com_left_time))
				end
				if ref_left_time <= 0 then
					if self.refresh_btn._can_touch == false then
						setChildUnEnabled(false, self.refresh_btn)
						self.refresh_btn:setTouchEnabled(true)
						self.refresh_btn._can_touch = true
						self.refresh_btn_label:enableOutline(cc.c3b(118, 69, 25), 2)
					end
					self.refresh_btn_label:setString(TI18N("语言_c_468"))
				elseif ref_left_time > 0 then
					if self.refresh_btn._can_touch == true then
						setChildUnEnabled(true, self.refresh_btn)
						self.refresh_btn:setTouchEnabled(false)
						self.refresh_btn._can_touch = false
						self.refresh_btn_label:disableEffect(cc.LabelEffect.OUTLINE)
					end
					self.refresh_btn_label:setString(string.format(TI18N("语言_c_473"), ref_left_time))
				end
            end, 1)
        end
	else
		if self.Arena_timer ~= nil then
            GlobalTimeTicket:getInstance():remove(self.Arena_timer)
            self.Arena_timer = nil
        end
	end
end

function ArenaWorldMainWindow:openRootWnd(  )
	self.isOneKey=false
	controller:requestArenaMyBaseInfo()
	-- controller:requestArenaRedStatus()
	controller:requestArenaEnemyListData()
	self:refrehsBtnRedStatus()
	self:changeSelectedTab(1)
	self:updateDefanceRed()
end

function ArenaWorldMainWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), true, 2)
	registerButtonEventListener(self.btn_rule, handler(self, self._onClickBtnRule))
	registerButtonEventListener(self.btn_role, handler(self, self._onClickBtnRolePalace),true,1)
	registerButtonEventListener(self.btn_log, handler(self, self._onClickBtnLog),true,1)
	registerButtonEventListener(self.btn_rank, handler(self, self._onClickBtnRank),true,1)
	registerButtonEventListener(self.btn_shop, handler(self, self._onClickBtnShop),true,1)
	registerButtonEventListener(self.add_btn, handler(self, self._onClickBtnAdd))
	registerButtonEventListener(self.refresh_btn, handler(self, self._onClickBtnRefresh), true)
	registerButtonEventListener(self.challenge_btn, handler(self, self._onClickBtnChallenge), true)
	registerButtonEventListener(self.btn_battle, handler(self, self._onClickBtnArea), true)

	-- 个人数据更新
    if self.Arena_mybaseinfo_event == nil then
        self.Arena_mybaseinfo_event = GlobalEvent:getInstance():Bind(ArenaWorldEvent.UpdateArenaMyBaseInfo, function (  )
            self:refreshMyBaseInfo()
        end)
    end
    
    -- 更新所有对手列表
    if self.Arena_update_enemy_event == nil then
    	self.Arena_update_enemy_event = GlobalEvent:getInstance():Bind(ArenaWorldEvent.UpdateAllArenaEnemyList, function (  )
            self:refreshRoleList()
        end)
    end

	if self.arena_top_six_event == nil then
        self.arena_top_six_event = GlobalEvent:getInstance():Bind(ArenaWorldEvent.UpdateArenaTopSixRoleData, function ( data )
            self:refreshSixRank(data)
			controller:requestArenaRedStatus()
        end)
    end
	
	if self.update_worship_event == nil then
        self.update_worship_event = GlobalEvent:getInstance():Bind(RoleEvent.WorshipOtherRole, function(rid, srv_id, idx)
			if self.myBaseInfo then
				controller:requestTopSixRoleData(self.myBaseInfo.zone_id)
			end
            -- if idx ~= nil and self.select_item ~= nil and self.select_item.data ~= nil then
				--     if idx == self.select_item.data.rank then
					--         self.select_item:updateWorshipStatus()
					--     end
					-- end
				end)
			end

			-- 积分更新
    if self.role_vo ~= nil then
        if self.role_assets_event == nil then
            self.role_assets_event = self.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE, function(key, value)
                if key == "arena_world_cent" then
                    self.score_val:setString(value)
					self:updateScorePos()
                end
            end)
        end
    end
	
    -- 活动开启/关闭
    self:addGlobalEvent(ArenaWorldEvent.UpdateArenaOpenStatus, function (  )
    	self:refreshMyBaseInfo()
    end)
    
	-- tab按钮
	for k, object in pairs(self.tab_list) do
		if object.tab_btn then
			object.tab_btn:addTouchEventListener(function(sender, event_type)
				if event_type == ccui.TouchEventType.ended then
					playTabButtonSound()
					self:changeSelectedTab(object.index)
				end
			end)
		end
	end
	
    -- 红点
    if self.update_red_status_event == nil then
    	self.update_red_status_event = GlobalEvent:getInstance():Bind(ArenaWorldEvent.UpdateArenaRedStatus, function ()
            self:refrehsBtnRedStatus()
        end)
    end

	if self.defance_red_event == nil then
		self.defance_red_event = GlobalEvent:getInstance():Bind(ArenaWorldEvent.GetArenaTeamData, function ()
			self:updateDefanceRed()
		end)
	end
end
function ArenaWorldMainWindow:updateDefanceRed()
	local red_status = controller:getDefRedPoint() or false
	addRedPointToNodeByStatus(self.btn_role, red_status, 10, 10)
end

