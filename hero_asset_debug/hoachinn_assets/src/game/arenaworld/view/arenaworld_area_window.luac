ArenaWorldAreaWindow = ArenaWorldAreaWindow or BaseClass(BaseView)

local controller = ArenaWorldController:getInstance()
local model = controller:getModel()

function ArenaWorldAreaWindow:__init()
	self.win_type = WinType.Big
	self.is_full_screen = false
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
	self.layout_name = "arenaworld/arenaworld_area_window"
	self.res_list = {
    }
end

function ArenaWorldAreaWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
	if self.background then
		self.background:setScale(display.getMaxScale())
	end
	local container = self.root_wnd:getChildByName("container")
    self:playEnterAnimatianByObj(container, 2) 
	local win_title = container:getChildByName("win_title")
	win_title:setString(TI18N("语言_c_5432"))
	self.close_btn = container:getChildByName("close_btn")
	self.list_panel = container:getChildByName("list_panel")
    container:getChildByName("tips"):setString(TI18N("语言_c_5882"))
end

function ArenaWorldAreaWindow:openRootWnd(  )
   self:setData()
end

function ArenaWorldAreaWindow:register_event(  )
	registerButtonEventListener(self.close_btn, handler(self, self._onClickBtnClose), false, 2)
	registerButtonEventListener(self.background, handler(self, self._onClickBtnClose), false, 2)

    if self.item_scrollview == nil then
        local scroll_view_size = self.list_panel:getContentSize()
        local setting = {
            item_class = ArenaWorldAreaItem,
            start_x = 0,                     -- 第一个单元的X起点
            space_x = 0,                     -- x方向的间隔
            start_y = 0,                     -- 第一个单元的Y起点
            space_y = 10,                     -- y方向的间隔
            item_width = 620,                -- 单元的尺寸width
            item_height = 140,               -- 单元的尺寸height
            row = 1,                         -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            once_num = 1,                    -- 每次创建的数量
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.list_panel, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)--cc.p(0, 0)
        self.item_scrollview:setSwallowTouches(false)
    end
end

function ArenaWorldAreaWindow:setData()
    local list = Config.ArenaWorldData.data_zone
    self.myBaseInfo = model:getArenaMyBaseInfo()
    local maxCount= self.myBaseInfo.max_zone_id
    local temp={}
    local len=#list
    local round=1
    if maxCount then
        for i=1,maxCount do 
            local t=deepCopy(list[i%len==0 and len or i%len])
            round= i%len==0 and i/len or math.floor(i/len)+1
            t.round=round
            t.cur_id=i
            table.insert(temp,t)
        end
    end
    -- if temp and next(temp)~=nil then
    --     table.sort(temp ,function (a,b) return a.cur_id<b.cur_id end)
    -- end
    self.item_scrollview:setData(temp)
end

function ArenaWorldAreaWindow:_onClickBtnClose(  )
	controller:openArenaAreaWindow(false)
end

function ArenaWorldAreaWindow:close_callback(  )
	if self.item_scroll_view then
        self.item_scroll_view:DeleteMe()
        self.item_scroll_view = nil
    end

	if self.update_have_count then
        GlobalEvent:getInstance():UnBind(self.update_have_count)
        self.update_have_count = nil
    end
	controller:openArenaAreaWindow(false)
end

---------------------------@ 排行榜 子项
ArenaWorldAreaItem = class("ArenaWorldAreaItem", function()
    return ccui.Widget:create()
end)

function ArenaWorldAreaItem:ctor()
	self:configUI()
	self:register_event()
end

function ArenaWorldAreaItem:configUI(  )
	self.size = cc.size(620,140)
	self:setTouchEnabled(false)
    self:setContentSize(self.size)

	local csbPath = PathTool.getTargetCSB("arenaworld/arenaworld_area_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("main_container")
    self.container = container
    self.container:setSwallowTouches(false)
    self.area_image = container:getChildByName("area_image")
    self.area_name = container:getChildByName("area_name")
    self.btn_goto = container:getChildByName("btn_goto")
    self.cur_img=container:getChildByName("cur_img")
    self.curlabdel=container:getChildByName("curlabel")
    self.curlabdel:setString(TI18N("语言_c_5889"))
    local bwidth = math.max(self.curlabdel:getContentSize().width + 60, self.cur_img:getContentSize().width)
    local bheight = self.cur_img:getContentSize().height
    self.cur_img:setContentSize(cc.size(bwidth,bheight))
    self.btn_goto:getChildByName("label"):setString(TI18N("语言_c_7"))
end

function ArenaWorldAreaItem:register_event(  )
    registerButtonEventListener(self.btn_goto, handler(self, self.onClickGoto), true)
end

function ArenaWorldAreaItem:onClickGoto( )  
    controller:requestTopSixRoleData(self.cur_id)	
    controller:openArenaAreaWindow(false)
end

function ArenaWorldAreaItem:setData( data )
	data = data or {}
	self.data = data
    self.cur_id=data.cur_id
    local isshow=self.cur_id==model:getArenaMyBaseInfo().zone_id
    self.cur_img:setVisible(isshow)
    self.curlabdel:setVisible(isshow)
	self.area_name:setString(string.format(data.name,data.round))
    local res= PathTool.getResFrame("space_arena", data.icon)
    self.area_image:loadTexture(res, LOADTEXT_TYPE_PLIST)
    self.area_image:ignoreContentAdaptWithSize(true)
    
end

function ArenaWorldAreaItem:DeleteMe(  )
	self:removeAllChildren()
	self:removeFromParent()
end