function ArenaWorldRoleItem:DeleteMe(  )
	if self.role_spine then
		self.role_spine:DeleteMe()
		self.role_spine = nil
	end
	if self.Arena_buyCount_event ~=nil then
		GlobalEvent:getInstance():UnBind(self.Arena_buyCount_event)
        self.Arena_buyCount_event = nil
	end
end