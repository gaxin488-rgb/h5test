function ArenaWorldRoleItem:setData( data )
	self.data = data or {}
    local info= model:getArenaMyBaseInfo()
	if not data.rank or data.rank == 0 then
		-- self.rank_label:setFontSize(22)
		self.rank_label:setString(TI18N("语言_c_285"))
	else
		-- self.rank_label:setFontSize(22)
		self.rank_label:setString(string.format(TI18N("语言_c_4114"), data.rank))
	end
	moveTextBg(self.rank_label,self.rank_bg,30)
	-- local rank_size = self.rank_label:getContentSize()
	-- self.rank_bg:setContentSize(cc.size(rank_size.width+10, 30))
	if info.status==2 then
		local name_txt = transformNameByServ(data.name, data.srv_id)
		self.name_label:setString(name_txt)
		self.attk_label:setString(MoneyTool.moneyFormat(data.power or 0))
		local label_size = self.attk_label:getContentSize()
		self.attk_image:setVisible(true)
		self.atk_icon:setVisible(true)
		self.atk_icon:setPositionX(121-label_size.width/2)
	else
		self.attk_label:setString(TI18N("语言_c_5877"))
		local txt_cfg = Config.ArenaWorldData.data_const["close_text"]
		if txt_cfg then
			self.name_label:setString(txt_cfg.desc)
		end
		self.attk_image:setVisible(false)
		self.atk_icon:setVisible(false)
	end

	-- self.name_label:setPositionX((self.container:getContentSize().width - self.rank_label:getContentSize().width-25)/2 + self.rank_label:getContentSize().width)
	-- self.rank_label:setPositionX((self.container:getContentSize().width - self.name_label:getContentSize().width-25)/2)

	if self.role_spine then
		self.role_spine:DeleteMe()
		self.role_spine = nil
	end
	if data.look then
		self.role_spine = BaseRole.new(BaseRole.type.role, data.look)
	    self.role_spine:setCascade(true)
	    self.role_spine:setAnchorPoint(cc.p(0.5, 0))
	    self.role_spine:setPosition(cc.p(0, 130))
	    self.role_spine:setScale(0.7)
	    self.role_spine:setAnimation(0,PlayerAction.show,true)
	    self.pos_role:addChild(self.role_spine)
	end

	-- -- 设置底框
	-- local res_path = self:getRoleBoxResPath(data.rank)
	-- if res_path then
	-- 	self.image_line:loadTexture(res_path, LOADTEXT_TYPE_PLIST)
	-- 	self.image_line:setVisible(true)
	-- else
	-- 	self.image_line:setVisible(false)
	-- end
end

