-- 战斗结果
function Actionyearmonster2Controller:handle18209( data )
    data.item_rewards = data.reward
    for i,v in ipairs(data.item_rewards) do
        v.bid = v.base_id
    end
    table.sort(data.all_hurt_statistics, function(a, b) return a.a_team_id < b.a_team_id end)
	data.hurt_statistics=data.all_hurt_statistics
    BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.MonsterYear2,data)
    if self.actionyearmonster_challenge_panel then
        if data.type == Actionyearmonster2Constants.Evt_Type.YearMonster or 
            data.type == Actionyearmonster2Constants.Evt_Type.GoldYearMonster then
            self:sender18203(data.evt_index, 0, {} )
        end
    end
end


