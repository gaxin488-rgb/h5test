--打开通用单个排行类型的排行榜界面
--@ setting 说明
--@setting.rank_type 
function Actionyearmonster2Controller:openRankMainWindow(bool, setting, view_type)
    if bool == true then 
        local setting = setting or {}
        local title_name = setting.title_name
        local background_path = setting.background_path
        if not self.actionyearmonster_rank_main_window then 
            self.actionyearmonster_rank_main_window = Actionyearmonster2RankMainWindow.New(title_name, background_path)
        end
        self.actionyearmonster_rank_main_window:open(setting, view_type)
    else
        if self.actionyearmonster_rank_main_window then 
            self.actionyearmonster_rank_main_window:close()
            self.actionyearmonster_rank_main_window = nil
        end
    end
end

--战斗结算界面
function Actionyearmonster2Controller:openActionyearmonster2ResultPanel(status, data, fight_type)
    if status == false then
        if self.actionyearmonster_result_panel ~= nil then
            self.actionyearmonster_result_panel:close()
            self.actionyearmonster_result_panel = nil
        end
    else
        if self.actionyearmonster_result_panel == nil then
            self.actionyearmonster_result_panel = Actionyearmonster2ResultPanel.New(fight_type)
        end
        self.actionyearmonster_result_panel:open(data)
    end
end

-----------------@ 处理事件
-- evt_type:事件类型 index:格子索引
function Actionyearmonster2Controller:onHandleYearEvtById( evt_type, index )
    self.evt_grid_index = index  -- 这里缓存一下格子id

    if evt_type == Actionyearmonster2Constants.Evt_Type.Normal then -- 空事件
        -- 无需处理
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Monster then -- 怪物(小年兽)
        self:openActionyearmonster2MonsterInfo(true, index)
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Start then -- 出生点
        -- 无需处理
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Board then -- 广告牌
        self:sender18203( index, 0, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Goods then -- 获得道具
        self:sender18203( index, 1, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Dialog then -- 奖励NPC对话
        self:sender18203( index, 0, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.DesBarrier then -- 可破坏的障碍物
        --不知道id不知道怎么处理..
        -- local board_cfg = Config.HolidayNianCrossData.data_board[v.val1]
        -- if board_cfg then
        --     PlanesController:getInstance():openPlanesBoardWindow(true, v.val1, data.index, {show_type = 2, board_cfg = board_cfg })
        -- end
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Barrier then -- 不可破坏的障碍物
        message(TI18N("语言_c_2353"))
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Character then  --获取文字
        self:sender18203( index, 1, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Tribute then  --获取贡品
        self:sender18203( index, 1, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.Fireworks then  --获取烟花
        self:sender18203( index, 1, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.RedBag then  --获取红包
        self:sender18203( index, 1, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.YearMonster then  --年兽
        -- self:openActionyearmonster2ChallengePanel(true, {monster_type = 1})
        self:sender18203( index, 0, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.GoldYearMonster then  --黄金年兽
        -- self:openActionyearmonster2ChallengePanel(true, {monster_type = 2})
        self:sender18203( index, 0, {} )
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.YearMonster_nothit then  --年兽(不可挑战)
        local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
        local str=Config.HolidayNianCrossData.data_const[comp_id].holiday_nian_lang_6.desc
        message(str)
    elseif evt_type == Actionyearmonster2Constants.Evt_Type.GoldYearMonster_nothit then  --黄金年兽 (不可挑战)
        local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
        local str=Config.HolidayNianCrossData.data_const[comp_id].holiday_nian_lang_7.desc
        message(str)
    end
end

-- 事件处理返回
function Actionyearmonster2Controller:handle18205( data )
    local evt_vo = self.model:getYearEvtVoByGridIndex(data.index)
    if not evt_vo or not evt_vo.config then return end
    local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
    if data.ext_list and next(data.ext_list) ~= nil then
        for k,v in pairs(data.ext_list) do
            if v.type == Actionyearmonster2Constants.Proto_18205.Dialog then
                local dialog_cfg = Config.HolidayNianCrossData.data_dialogue[comp_id][v.val1]
                if dialog_cfg then
                    delayOnce(function ( )
                        ActionController:getInstance():openActionTimeCollectWindow(true,80, data.index, dialog_cfg)
                    end, 0.5)
                end
            elseif v.type == Actionyearmonster2Constants.Proto_18205.Board  then --广告牌
                local board_cfg = Config.HolidayNianCrossData.data_board[comp_id][v.val1]
                if board_cfg then
                    PlanesafkController:getInstance():openPlanesBoardWindow2(true, v.val1, data.index, {show_type = 2, board_cfg = board_cfg })
                end
            elseif v.type == Actionyearmonster2Constants.Proto_18205.Goods then--获取道具
                -- v.type == Actionyearmonster2Constants.Evt_Type.Character or --获取文字
                -- v.type == Actionyearmonster2Constants.Evt_Type.Tribute or -- 获取贡品
                -- v.type == Actionyearmonster2Constants.Evt_Type.Fireworks  then --获取烟花
                self:showEvtItem(v.val1)
            elseif v.type == Actionyearmonster2Constants.Proto_18205.DesBarrier then--可破坏道具
            elseif v.type == Actionyearmonster2Constants.Proto_18205.YearMonster then--大年兽
            elseif v.type == Actionyearmonster2Constants.Proto_18205.GoldYearMonster then--金年兽

            end
        end
    end
end

function Actionyearmonster2Controller:showEvtItem(item_bid)
    if not item_bid then return end
    local items = {{bid = item_bid, num = 1}}
    MainuiController:getInstance():openGetItemView(true, items, 0, {is_backpack = true}, MainuiConst.item_open_type.normal)
end

