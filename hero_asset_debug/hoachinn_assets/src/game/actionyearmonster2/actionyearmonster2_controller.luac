Actionyearmonster2Controller = Actionyearmonster2Controller or BaseClass(BaseController)

function Actionyearmonster2Controller:config()
    self.model = Actionyearmonster2Model.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function Actionyearmonster2Controller:getModel()
    return self.model
end

function Actionyearmonster2Controller:registerEvents()

    if not self.red_bg_event then
        self.red_bg_event = GlobalEvent:getInstance():Bind(MainuiEvent.CLOSE_ITEM_VIEW, function(data)
            if data and data.is_year_red_bag then
                --此数据是 18214 返回的数据
                local info_data = data.info_data
                self:openActionyearmonster2RedbagEventPanel(true,{info_data = info_data})
            end
        end)
    end
end

function Actionyearmonster2Controller:registerProtocals()
    self:RegisterProtocal(18200, "handle18200") -- 基础数据信息
    self:RegisterProtocal(18201, "handle18201") -- 格子数据信息
    self:RegisterProtocal(18202, "handle18202") -- 移动进入指定格子，需接收到成功后方可移动 
    self:RegisterProtocal(18203, "handle18203") --  操作指定格子事件
    self:RegisterProtocal(18204, "handle18204") -- 请求进入副本
    self:RegisterProtocal(18205, "handle18205") -- 事件信息返回
    self:RegisterProtocal(18206, "handle18206") -- 背包信息
    self:RegisterProtocal(18207, "handle18207") -- 背包新增（更新）信息
    self:RegisterProtocal(18208, "handle18208") -- 背包删除信息

    self:RegisterProtocal(18209, "handle18209") -- 战斗结果

    self:RegisterProtocal(18210, "handle18210") -- 获取对方阵容信息
    self:RegisterProtocal(18211, "handle18211") -- 提交贡品
    self:RegisterProtocal(18212, "handle18212") -- 购买挑战次数
    self:RegisterProtocal(18213, "handle18213") -- 排行奖励
    self:RegisterProtocal(18214, "handle18214") -- 获取红包情况
    self:RegisterProtocal(18215, "handle18215") -- 挑战信息

    self:RegisterProtocal(18218, "handle18218") -- 格子更新

    self:RegisterProtocal(18216, "handle18216") -- 集字兑换
    self:RegisterProtocal(18217, "handle18217") -- 集字兑换界面

    self:RegisterProtocal(18219, "handle18219") -- 保存年兽表情
    self:RegisterProtocal(18220, "handle18220") -- 个人年兽表情
    self:RegisterProtocal(18221, "handle18221") -- 使用烟花
    self:RegisterProtocal(18222, "handle18222") -- 个人交换
    self:RegisterProtocal(18223, "handle18223") -- 是否有红包事件
    self:RegisterProtocal(18224, "handle18224") -- 是否有年兽可以挑战
    self:RegisterProtocal(18225, "handle18225") -- 一键扫荡
    self:RegisterProtocal(18226, "handle18226") -- 设置阵法
    self:RegisterProtocal(18227, "handle18227") -- 请求阵法
    self:RegisterProtocal(18228, "handle18228") -- 排行榜数据
end

--基本数据
function Actionyearmonster2Controller:sender18200( )
    self:SendProtocal(18200, {})
end

function Actionyearmonster2Controller:handle18200( data )
    --活动未开启
    if data.camp_id == 0 then
        self:openActionyearmonster2ChallengePanel(false)
        self:openActionyearmonster2RedbagEventPanel(false)
        self:openActionyearmonster2RedbagEffectPanel(false)
        self:openActionyearmonster2SubmitPanel(false)
        self:openActionyearmonster2BagPanel(false)
        self:openActionyearmonster2MonsterInfo(false)
        self:openActionyearmonster2ExchangeWindow(false)
        self:openActionyearmonster2MainWindow(false)
        self.model:setyearMonster2Open(false)
        return
    end
    self.model:setBaseData(data)
    self.model:setPlanesRoleLookId(data.look_id)
    self.model:setHolidayOpen(data.camp_id)
    HomeworldController:getInstance():getModel():setMyCurHomeFigureId(data.look_id)
    HomeworldController:getInstance():getModel():setActivateFigureList(data.list, true)

    GlobalEvent:getInstance():Fire(Actionyearmonster2Event.YEAR_MONSTER_BASE_INFO, data)

    --主界面红点
    local role_vo = RoleController:getInstance():getRoleVo()
    if role_vo then
        local isshow=false
        if data.val >= data.max_val then
            isshow=false
        else
            local holiday_nian_tribute_id = 80351
            local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
            local data_const_config = Config.HolidayNianCrossData.data_const
            if data_const_config and data_const_config[comp_id] then
                local config  = data_const_config[comp_id].holiday_nian_tribute_id
                if config then
                    holiday_nian_tribute_id = config.val
                end
                local have_count = role_vo:getActionAssetsNumByBid(holiday_nian_tribute_id)

                if have_count > 0 then
                    isshow=true
                else
                    isshow=false
                end
            end
        end
        if isshow==false then
            local orderid= MonopolyController:getInstance():getModel():getOrderBid()
            local ho = ActionController:getInstance():getHolidayAweradsStatus(orderid)
            if ho ~= nil and ho.status == true then
                isshow=true
            end
            local vo = ActionController:getInstance():getHolidayAweradsStatus(93032)
            if vo ~= nil and vo.status == true then
                isshow=true
            end
        end
        MainuiController:getInstance():setFunctionTipsStatus(MainuiConst.icon.year_monster2, isshow)
    end
end

