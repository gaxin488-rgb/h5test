--打开活动主界面
function Actionyearmonster2Controller:openActionyearmonster2MainWindow(status, setting)
    if status == false then
        if self.actionyearmonster_main_window ~= nil then
            self.actionyearmonster_main_window:close()
            self.actionyearmonster_main_window = nil
        end
    else
        local comp_id = MonopolyController:getInstance():getModel():getCamp_id1()
        local config  = Config.HolidayNianCrossData.data_const[comp_id]
        if not config then
            --不存在配置 上报错误
            send_error_to_pf(simpleTrace(debug.traceback()))
            send_error_to_pf("openActionyearmonsterMainWindow_camp2"..comp_id)
            return
        end
        if self.actionyearmonster_main_window == nil then
            self.actionyearmonster_main_window = Actionyearmonster2MainWindow.New()
        end
        if self.actionyearmonster_main_window:isOpen() == false then
			self.actionyearmonster_main_window:open(setting)
		end
        -- self.actionyearmonster_main_window:open(setting)
    end
end


