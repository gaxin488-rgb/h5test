            self.model:setYearTimeData(data)
            self.model:setyearMonster2Open(true)
            GlobalEvent:getInstance():Fire(Actionyearmonster2Event.Go_Map_Event)
            -- if self.planes_main_wnd then -- 解除锁屏，如果是需要先播特效的，特效播完会解除锁屏
