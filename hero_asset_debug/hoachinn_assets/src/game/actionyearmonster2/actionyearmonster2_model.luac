--获取需要挑战券数量
function Actionyearmonster2Model:getNeedTicketNum()
    local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
    local num=0
    local cfg=Config.HolidayNianCrossData.data_const[comp_id]["fight_little_monster"].val
    for i,v in pairs(cfg) do
        for x,y in pairs(self.evt_vo_list) do
            if y.evtid>0 and y.index==v then
               num=num+1
               break
            end
        end
    end
    return num
end

function Actionyearmonster2Model:getYearEvtVoList( )
    return self.evt_vo_list
end

function Actionyearmonster2Model:getBubbleStatus()
    return self.isshowBubble
end

function Actionyearmonster2Model:setBubbleStatus(status)
    self.isshowBubble = status
end

function Actionyearmonster2Model:getYearEvtVoByGridIndex( index )
    return self.evt_vo_list[index]
end

-- 是否需要走到事件格子前停下来 
-- 有事件、且事件未完成，则需要走到事件前一格停下来（出生点除外，出生点一直是未完成） 空事件 不算事件
function Actionyearmonster2Model:checkIsNeedStopPreGrid( index )
    local evt_vo = self.evt_vo_list[index]
    if evt_vo and evt_vo.config and evt_vo.config.type ~= Actionyearmonster2Constants.Evt_Type.Start and evt_vo.config.id ~= 0 then
        return true
    end
    return false
end

-- 设置所有格子事件的数据
function Actionyearmonster2Model:setYearEvtVoList( data_list )
    self.evt_vo_list = {}
    for _,v in pairs(data_list) do
        if v.evtid > 0 then -- 只记录有事件的数据
            local evt_vo = Actionyearmonster2EvtVo.New()
            evt_vo:updateData(v)
            self.evt_vo_list[v.index] = evt_vo

            
            if evt_vo.config  then
                if evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_hit or 
                   evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_not_hit then
                   --限时年兽
                    self.year_monster_list[1] = v
                elseif evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_hit or 
                    evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_not_hit then 
                       --黄金年兽
                    self.year_monster_list[2] = v
                end
            end
        end
    end
end

-- -- 更新事件数据
function Actionyearmonster2Model:updateYearEvtVoList( data_list )
    --没有说明还没有初始化就不处理事件更新了
    if not self.evt_vo_list then return end

    local add_evt_vo_list = {}
    for _,v in pairs(data_list) do
        local evt_vo = self.evt_vo_list[v.index]
        if not evt_vo then -- 可能是之前事件为0的格子变为了非0的格子
            evt_vo = Actionyearmonster2EvtVo.New()
            evt_vo:updateData(v)
            self.evt_vo_list[v.index] = evt_vo
            table.insert( add_evt_vo_list, evt_vo )
        else
            evt_vo:updateData(v)
        end
    end
    -- 通知场景新增地图事件显示
    if next(add_evt_vo_list) ~= nil then
        GlobalEvent:getInstance():Fire(Actionyearmonster2Event.YEAR_Add_Evt_Data_Event, add_evt_vo_list)
    end
end

-- 根据格子坐标判断该坐标是否有事件
function Actionyearmonster2Model:checkIsHaveEvtByGridIndex( index )
    if self.evt_vo_list[index] then
        return true
    end
    return false
end

-- 根据格子坐标判断对应的事件是否可行走 
-- is_check_status 为 true，则事件状态不为已完成，则都可以走(用于点击事件格子时)
-- 升降台特殊处理:仅根据升降台状态判断是否可行走
function Actionyearmonster2Model:checkEvtCanWalkByGridIndex( index, is_check_status )
    local is_can_walk = true
    local evt_vo = self.evt_vo_list[index]
    if evt_vo then
        -- 事件类型不是不可破坏的障碍物、且状态没有完成，则可以走
        if is_check_status and evt_vo.config and evt_vo.config.type ~= Actionyearmonster2Constants.Evt_Type.Barrier then
            is_can_walk = true
        elseif evt_vo.config and evt_vo.config.is_walk == 0 then
            is_can_walk = false
        end
    end
    return is_can_walk
end

--根据格子判断是不是主年兽格子
function Actionyearmonster2Model:checkYearmonsterCentreGrid(index)
    local evt_vo = self.evt_vo_list[index]
    if evt_vo and evt_vo.config and 
        (evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_not_hit or
        evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_hit or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_not_hit or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_hit) then
        return true
    end
    return false
end
--根据格子判断是不是年兽格子
function Actionyearmonster2Model:checkYearmonsterGrid( index )
    local evt_vo = self.evt_vo_list[index]
    if evt_vo and evt_vo.config and 
        (evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_not_hit or
        evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_hit or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_not_hit or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_hit or
        evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_not_hit_2 or
        evt_vo.config.id == Actionyearmonster2Constants.evt_limit_monster_hit_2 or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_not_hit_2 or 
        evt_vo.config.id == Actionyearmonster2Constants.evt_gold_monster_hit_2) then
        return true
    end
    return false
end

