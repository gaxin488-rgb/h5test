--设置活动开启中
function Actionyearmonster2Model:setFirst(status)
    self.is_first=status
end

--判断是否开启
function Actionyearmonster2Model:checkActionOpen()
    local data=self:getYearTimeData()
    local cur_time = GameNet:getInstance():getTime()
    if not data then return false end
    if cur_time<data.start_time or cur_time>data.end_time then 
        return  false
    end
    return true
end

