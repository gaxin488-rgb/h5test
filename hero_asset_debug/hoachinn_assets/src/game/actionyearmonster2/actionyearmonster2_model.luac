Actionyearmonster2Model = Actionyearmonster2Model or BaseClass()

function Actionyearmonster2Model:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function Actionyearmonster2Model:config()
    --格子数据 
    self.cell_data = nil
    --地图事件(有才记录) self.evt_vo_list[index] = ActionyearmonsterEvtVo
    self.evt_vo_list = nil

    self.base_data = nil

    --主年兽对象 结构是 28201的一个格子数据
    -- self.year_monster_list[1] = v --限时年兽数据
    -- self.year_monster_list[2] = v --黄金年兽数据 写死的
    self.year_monster_list = {}

    self.is_holiday_open = false

    self.is_yearMonster2_open = false

    self.is_first = true

    self.isshowBubble=nil

    self.isopenQuick=false

    self.isshowMain=true

    self.MonsterTeamNum=0

    self.HeroPool={}
end

