end


-- 设置年兽背包数据
function Actionyearmonster2Model:setYearBagData( secret_item )
    secret_item = secret_item or {}
    self.year_bag_data = {}
    for i,v in ipairs(secret_item) do
        self.year_bag_data[v.id] = v
    end
    GlobalEvent:getInstance():Fire(Actionyearmonster2Event.Year_Iint_Bag_Data_Event)
end

-- 获取全部位面背包数据
function Actionyearmonster2Model:getYearBagData(  )
    return self.year_bag_data
end

-- 更新、新增背包数据
function Actionyearmonster2Model:updateYearBagData( data_list )
    if not self.year_bag_data then return end
    local is_add = false
    for _,n_data in pairs(data_list) do
        if self.year_bag_data[n_data.id] then
            -- for k,v in pairs(n_data) do
            --    self.year_bag_data[n_data.id][k] = v
            -- end
            self.year_bag_data[n_data.id].num = n_data.num --目前更新就只有数量
        else
            self.year_bag_data[n_data.id] = n_data
            is_add = true
        end
    end
    GlobalEvent:getInstance():Fire(Actionyearmonster2Event.Year_Update_Bag_Data_Event, data_list, is_add)
end
function Actionyearmonster2Model:getYearBagDataByBaseID(base_id)
    if not self.year_bag_data then return end
    for i,v in pairs(self.year_bag_data) do
        if v.base_id == base_id then
            return v
        end
    end
end

-- 删除背包数据
function Actionyearmonster2Model:deleteYearBagData( data_list )
    if not self.year_bag_data then return end
    for _,v in pairs(data_list) do
        self.year_bag_data[v.id] = nil
    end
    GlobalEvent:getInstance():Fire(Actionyearmonster2Event.Year_Delete_Bag_Data_Event, data_list)
end

-- 设置集字兑换数据
function Actionyearmonster2Model:setExchangeData( data )
    if self.exchange_data == nil then
        self.exchange_data = {}
    end
    if data and data.collection then
        for _,v in pairs(data.collection) do
            self.exchange_data[v.id] = v
        end
    end
end

function Actionyearmonster2Model:setMonsterTeamNum( num )
    self.MonsterTeamNum=num
end

function Actionyearmonster2Model:getMonsterTeamNum(  )
    return self.MonsterTeamNum
end

-- 设置对象池
function Actionyearmonster2Model:setTeamData(team)
     self.HeroPool[team.team_id]=team
end
--更新对象池
function Actionyearmonster2Model:undateTeamData(partner_id,pos)
    if self.HeroPool then
        for i,v in ipairs(self.HeroPool) do
            local team=v.pos_info
            if v.team_id==1 then
                for _,k in pairs(team) do
                    if k.pos==pos then
                        k.id=partner_id
                    end
                end
            else
                for j,k in pairs(team) do
                    if k.id==partner_id then
                        table.remove(team,j)
                    end
                end
            end
        end
    end
end

--是否在队伍中
function Actionyearmonster2Model:isInTeam(partner_id)
    if self.HeroPool then
        for i,v in ipairs(self.HeroPool) do
            for _,k in ipairs(v.pos_info) do
                if k.id==partner_id and v.team_id~=1 then
                   return v.team_id
                end
            end
         end
    end
    return nil
end

--神器是否在队伍中
function Actionyearmonster2Model:getHallowTeam()
    local temp={}
    if self.HeroPool then
        for i,v in ipairs(self.HeroPool) do
            if v.hallows_id~=0 then
                temp[v.hallows_id]=v.team_id
            end
         end
    end
    return temp
end

--更新神器数据
function Actionyearmonster2Model:updateHallowdata(hallows_id,team_index)
    if self.HeroPool then
        for i,v in ipairs(self.HeroPool) do
            if v.hallows_id==hallows_id then
                v.hallows_id=0
            end
            if v.team_id==team_index then
                v.hallows_id=hallows_id
            end
         end
    end
end


--是否在队伍中
function Actionyearmonster2Model:getTeamData()
    return  self.HeroPool or nil
end
-- 设置集字兑换数据
function Actionyearmonster2Model:getExchangeDataById( id )
    if self.exchange_data then
        return self.exchange_data[id]
    end
    return nil
end
--获取伤害值对应的奖励数据
--返回 最大伤害值  和 box个数
function Actionyearmonster2Model:getHarmRewardInfo(harm_count, evt_type)
    harm_count = harm_count or 0
    -- Actionyearmonster2Constants.Evt_Type.YearMonster
    local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
    if comp_id then
        local key=comp_id.."_"..evt_type
        local config_list = Config.HolidayNianCrossData.data_harm_reward[key]
        if config_list and next(config_list) ~= nil then
            table.sort(config_list, function(a, b) return a.dps_low < b.dps_low end)
            local len = #config_list
            local max_high = config_list[len].dps_high
            for i,config in ipairs(config_list) do
                if i == 1 and harm_count <= config.dps_high then
                    return i, config, max_high
                elseif i == len and harm_count > config.dps_low then
                    return i, config,max_high
                elseif harm_count > config.dps_low and harm_count <= config.dps_high then
                    return i, config, max_high
                end
            end
        end
    end
    return 0
end

function Actionyearmonster2Model:getMonsterHeadId(type)
    local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
    if comp_id and Config.HolidayNianCrossData.data_const[comp_id] then
        if type==12 then
            return Config.HolidayNianCrossData.data_const[comp_id].holiday_nian_boss2_head.val
        else
            return Config.HolidayNianCrossData.data_const[comp_id].holiday_nian_boss1_head.val
        end
    end
    return nil
end

function Actionyearmonster2Model:saveLocalSelfData(data)
    self.myLocalInfo = nil
    if not data and not data.dps_list then return end 
    local role_vo = RoleController:getInstance():getRoleVo()
    local list = deepCopy(data.dps_list)
    for i,v in pairs(list) do
        if role_vo and role_vo.rid == v.rid and role_vo.srv_id == v.srv_id then
            self.myLocalInfo = v
        end
    end
end
function Actionyearmonster2Model:getLocalSelfData()
    return self.myLocalInfo
end

function Actionyearmonster2Model:__delete()
end