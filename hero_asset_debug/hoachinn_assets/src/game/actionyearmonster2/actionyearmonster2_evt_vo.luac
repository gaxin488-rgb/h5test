---------------------------------
-- 
-- @date 2019/11/28 10:06:35
-- @description: 年兽冒险事件的数据结构
---------------------------------
Actionyearmonster2EvtVo = Actionyearmonster2EvtVo or BaseClass(EventDispatcher)

function Actionyearmonster2EvtVo:__init(  )
    self.index = 0 -- 格子坐标
    self.evtid = 0 -- 事件id
    self.status = PlanesConst.Evt_State.None -- 事件状态
    self.platform = 0 -- 升降台状态(1升0降)
    self.switch = 0 -- 开关状态(1开0关)
    self.is_hide = 0 -- 是否隐藏(0不隐藏，1隐藏)
    self.config = {} -- 配置数据
end

function Actionyearmonster2EvtVo:updateData(data)
    local comp_id=MonopolyController:getInstance():getModel():getCamp_id1()
    if not comp_id then return end
    for key, value in pairs(data) do
        self[key] = value
        if key == "evtid" then
            self.config = Config.HolidayNianCrossData.data_evt_info[comp_id] and Config.HolidayNianCrossData.data_evt_info[comp_id][value] or {}
        end
    end  
    self:dispatchUpdateAttrByKey()
end

function Actionyearmonster2EvtVo:dispatchUpdateAttrByKey(  )
    self:Fire(Actionyearmonster2Event.Year_Update_Evt_Status_Event)
end

function Actionyearmonster2EvtVo:__delete(  )
end