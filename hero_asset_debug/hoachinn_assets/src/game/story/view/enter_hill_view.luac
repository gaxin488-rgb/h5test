EnterHillView = EnterHillView or BaseClass(BaseView)

local controller = StoryController:getInstance()
local story_view = controller:getView() 

function EnterHillView:__init(  )
	self.win_type = WinType.Big
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "drama/drama_enter_hill_window"
	self.is_full_screen = true
	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("drama", "drama"), type = ResourcesType.plist},
	}
end

function EnterHillView:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.container = self.root_wnd:getChildByName("container")

    self.right_hill = self.container:getChildByName("right_hill")
    self.left_hill = self.container:getChildByName("left_hill")
    self.right_cloudy = self.container:getChildByName("right_cloudy")
    self.left_cloudy = self.container:getChildByName("left_cloudy")
    -- self:showCloudyFun()
end

function EnterHillView:showspineMv1( status)
    if status == true then
        if not tolua.isnull(self.container) and self.hill_mv == nil then
            self.hill_mv = createEffectSpine("E532295", cc.p(SCREEN_WIDTH / 2, 0), cc.p(0.5, 0.5), true, PlayerAction.action_2)
            self.container:addChild(self.hill_mv, 99)
            self.hill_mv:setOpacity(0)
            self.hill_mv:runAction(cc.Sequence:create(cc.FadeIn:create(2),cc.CallFunc:create(function()
                self.hill_mv:setVisible(false)
                self:showSpineMv(true)
            end)))
        end
    else
        if self.hill_mv then
            self.hill_mv:stopAllActions()
            self.hill_mv:clearTracks()
            self.hill_mv:removeFromParent()
            self.hill_mv = nil
        end
    end
end

function EnterHillView:showSpineMv(status)
    if status == true then
        if not tolua.isnull(self.container) and self.flicker_effect == nil then
            self.flicker_effect = createEffectSpine("E532295", cc.p(SCREEN_WIDTH / 2, 0), cc.p(0.5, 0.5), false, PlayerAction.action_1)
            self.container:addChild(self.flicker_effect, 99)
            self.flicker_effect.paused = true
            local function finish_func()--某一组播完直接移除会导致游戏崩溃，加一个延迟0.1秒
                if self.entrance and self.entrance == 1 then
                    -- delayRun(self.container, 0.3, function()
                        GlobalEvent:getInstance():Fire(StoryEvent.PLAY_NEXT_ACT)
                        -- self:close()
                    -- end)
                end
            end
            self.flicker_effect:registerSpineEventHandler(finish_func, sp.EventType.ANIMATION_COMPLETE)
        end
    else
        if self.flicker_effect then
            self.flicker_effect:clearTracks()
            self.flicker_effect:removeFromParent()
            self.flicker_effect = nil
        end
    end
end

function EnterHillView:register_event(  )
	self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            if self.entrance and self.entrance == 1 then
                GlobalEvent:getInstance():Fire(StoryEvent.PLAY_NEXT_ACT)
            end
            self:close()
        end
    end)
end

function EnterHillView:openRootWnd( msg_data )
	self.entrance = msg_data
    self:showSpineMv(true)
    -- MainSceneController:getInstance():removeCloudy()
    -- print("EnterHillView:openRootWnd----------------------------------------")
end

