-- --------------------------------------------------------------------
-- 剧情对话面板,出于一些设定,现在只要进剧情都会打开这个面板,只是状态不同 
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-xx-xx
-- --------------------------------------------------------------------
StoryNewTalk = StoryNewTalk or BaseClass(BaseView)

local controller = StoryController:getInstance()
local model = controller:getModel()
local story_view = controller:getView()
local table_insert = table.insert
local string_format = string.format

function StoryNewTalk:__init(is_skip)
    self.is_skip = is_skip
    self.win_type = WinType.Big
    self.is_full_screen = true
    self.view_tag = ViewMgrTag.MSG_TAG -- 父级层次
    
    self.max_height = 0
    self.item_info_list = {} -- 数据对象
    self.item_height = 162
    self.item_show_list = {}
    self.can_click = false

    self.layout_name = "drama/dramatalk_new_view"
    self.res_list = {{
        path = PathTool.getPlistImgForDownLoad("drama", "drama"),
        type = ResourcesType.plist
    }}
end

function StoryNewTalk:open_callback()
    local background = self.root_wnd:getChildByName("background")
    background:setScale(display.getMaxScale())
    background:setOpacity(100)
    self.background = background

    local container = self.root_wnd:getChildByName("container")
    self.container = container

    local offset_y = display.getBottom(self.root_wnd)
    container:setPositionY(offset_y + 50)
    self.skip_btn = container:getChildByName("skip_btn")
    self.skip_btn:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.FadeTo:create(1.0, 100), cc.FadeTo:create(1.0, 255))))

    self.leftPeople = container:getChildByName("Sprite_56")
    self.lefttalk = container:getChildByName("left_talk")
    self.left_name = self.lefttalk:getChildByName("left_name")
    self.left_text = createRichLabel(24, 1, cc.p(0, 1), cc.p(15, 110), 0, 0, 470)
    self.lefttalk:addChild(self.left_text)

    self.rigthPeople = container:getChildByName("Sprite_57")
    self.righttalk = container:getChildByName("right_talk")
    self.right_name = self.righttalk:getChildByName("right_name")
    self.right_text = createRichLabel(24, 1, cc.p(0, 1), cc.p(15, 110), 0, 0, 470)
    self.righttalk:addChild(self.right_text)

    self.righttalk:setVisible(false)
    self.lefttalk:setVisible(false)

    self.left_node = container:getChildByName("Node_1")
    self.right_node = container:getChildByName("Node_2")
end

function StoryNewTalk:register_event()
    self.background:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:playNextAcrt()
        end
    end)
    self.container:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:playNextAcrt()
        end
    end)
    self.lefttalk:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:playNextAcrt()
        end
    end)
    self.righttalk:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:playNextAcrt()
        end
    end)
    self.skip_btn:addTouchEventListener(function(sender, event_type)
        if event_type == ccui.TouchEventType.ended then
            self:playNextAcrt()
        end
    end)
end

function StoryNewTalk:playNextAcrt()
    if self.can_click == true then
        GlobalEvent:getInstance():Fire(StoryEvent.PLAY_NEXT_ACT)
    else
    end
end

function StoryNewTalk:openRootWnd(type, bid, actiontype, name, msg, spk, lis)
    self:setData(type, bid, actiontype, name, msg, spk, lis)
end

-- ==============================--
-- desc:设置剧情对白
-- time:2018-07-13 01:58:46
-- @type:1:说话的人在左侧, 2:说话的人在右侧
-- @bid: 骨骼动画朝向
-- @actiontype：骨骼动画名称
-- @msg:
-- @speak:谁说的话图片
-- @listen:听话的人图片
-- @return 
-- ==============================--
function StoryNewTalk:setData(type, name, msg, spk, lis)
    -- print("$$$$$$$$$$$$$$$$$$$$$$$$$",type, name, msg, spk, lis)
	if not self then return end
    self.can_click = false
    delayRun(self.container, 0.5, function() 
        self.can_click = true
    end) 
    if type == 1 then
        self.left_name:setString(TI18N(name))
        if self.left_text then
        else
            self.left_text = createRichLabel(24, 1, cc.p(0, 1), cc.p(10, 540), 0, 0, 470)
            self.lefttalk:addChild(self.left_text)
        end
        -- self:showLeftSprite(spk, false)
        -- self:showRightSprite(lis, true)
        self:showLeftSpine(spk, false)
        self:showRightSpine(lis, true)
        self.left_text:setString(TI18N(msg))
        self.lefttalk:setVisible(true)
        self.righttalk:setVisible(false)
    elseif type == 2 then
        self.right_name:setString(TI18N(name))
        if self.right_text then
        else
            self.right_text = createRichLabel(24, 1, cc.p(0, 1), cc.p(10, 540), 0, 0, 470)
            self.righttalk:addChild(self.right_text)
        end
        -- self:showLeftSprite(lis, true)
        -- self:showRightSprite(spk, false)
        self:showLeftSpine(lis, true)
        self:showRightSpine(spk, false)
        self.right_text:setString(TI18N(msg))
        self.lefttalk:setVisible(false)
        self.righttalk:setVisible(true)
    end
    -- if spk == 4 or lis == 4 then
    --     self:showSpine()
    -- else
    --     if self.first_show_effect then
    --         self.first_show_effect:setVisible(false)
    --     end
    -- end
end

function StoryNewTalk:showLeftSprite(res, status)
    if res == nil then
        if self.leftPeople then
            self.leftPeople:setVisible(false)
        end
        return
    end
    if res == 4 then
        res = res + 2
    else
        res = res + 1
    end
    if res ~= 5 then
        local leftres = nil
        local leftPicName = "drama_" .. res
        leftres = PathTool.getResFrame("drama", leftPicName)
        if leftres then
            loadSpriteTexture(self.leftPeople, leftres, LOADTEXT_TYPE_PLIST)
            setChildDarkShader(status, self.leftPeople)
            self.leftPeople:setVisible(true)
        end
    end
end

function StoryNewTalk:showRightSprite(res, status)
    if res == nil then
        self.rigthPeople:setVisible(false)
        return
    end
    if res == 4 then
        res = res + 2
    else
        res = res + 1
    end
    if res ~= 5 then
        local leftres = nil
        local leftPicName = "drama_" .. res
        leftres = PathTool.getResFrame("drama", leftPicName)
        if leftres then
            loadSpriteTexture(self.rigthPeople, leftres, LOADTEXT_TYPE_PLIST)
            setChildDarkShader(status, self.rigthPeople)
            self.rigthPeople:setVisible(true)
        end
    end
end
--如果需要人物动画
function StoryNewTalk:showLeftSpine( res, status )
    if self.left_show_effect then
        self.left_show_effect:clearTracks()
        self.left_show_effect:removeFromParent()
        self.left_show_effect = nil
    end
    if res == nil then return end
    if self.left_show_effect == nil then
        local effName = "E3000" .. res
        self.left_show_effect = createEffectSpine(effName, cc.p(-135, -150), cc.p(0.5, 0.5), true, PlayerAction.action)
        self.left_node:addChild(self.left_show_effect)
        self.left_show_effect:setVisible(true)
        setChildDarkShader(status, self.left_show_effect)
    else
        self.left_show_effect:setVisible(true)
    end
end
function StoryNewTalk:showRightSpine( res, status )
    if self.right_show_effect then
        self.right_show_effect:clearTracks()
        self.right_show_effect:removeFromParent()
        self.right_show_effect = nil
    end
    if res == nil then return end
    if self.right_show_effect == nil then
        local effName = "E3000" .. res
        self.right_show_effect = createEffectSpine(effName, cc.p(135, -150), cc.p(0.5, 0.5), true, PlayerAction.action)
        self.right_node:addChild(self.right_show_effect)
        self.right_show_effect:setVisible(true)
        setChildDarkShader(status, self.right_show_effect)
    else
        self.right_show_effect:setVisible(true)
    end
end

function StoryNewTalk:close_callback()
    doStopAllActions(self.container)
    if self.left_show_effect then
        self.left_show_effect:clearTracks()
        self.left_show_effect:removeFromParent()
        self.left_show_effect = nil
    end
    if self.right_show_effect then
        self.right_show_effect:clearTracks()
        self.right_show_effect:removeFromParent()
        self.right_show_effect = nil
    end
    story_view:hideNewTalk()
end
