Shura_trailModel = Shura_trailModel or BaseClass()

function Shura_trailModel:__init(ctrl)
    self.ctrl = ctrl
    self:config()
end

function Shura_trailModel:config()
    self.role_rank_list = {}
    -- self.first_item_list = {}
    -- self.five_item_list = {}
    -- self.rank_item_list = {}
    self.shura_data = {}
    self.first_data = {}
    self.send_partner = {}
    self.hire_partner_list = {}
    self.has_hire_partner_list = {} --已雇佣的
    self.is_first_get = false
    self.is_award_get = false
    self.is_award_get_new = false
    
    self.is_send_partner = false
    self.shura_battle_data = nil
    -- self:getFirstKindList()
    -- self:getFiveKindList()
    -- self:getRankKindList()
	self.shura_login_red = false --试炼之地登录红点状态
end

--[[
    @desc: 设置无尽试炼基础信息
    author:{author}
    time:2018-08-20 11:56:42
    --@data: 
    @return:
]]
function Shura_trailModel:setShuraData(data)
    if data then
        if data.type == 0 then
            data.day_pass_round = 0
            data.new_day_pass_round = 0
            data.is_reward = 0
        end
        self.shura_data = data
        self:checkRedPoint()
        GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_BASE_DATA)
    end
end
-- 是否屏蔽功能
function Shura_trailModel:isHideShura()
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	local featuresId = MainuiConst.FeaturesShield.Shura
    if not table.indexof(nohideIds,featuresId) then
		return true
	end
end
--[[
    @desc: 获取无尽试炼基础信息
    author:{author}
    time:2018-08-20 11:56:42
    --@data: 
    @return:
]]
function Shura_trailModel:getShuraIsOpen()
    if self.shura_data then
        return self.shura_data.open
    end
end
function Shura_trailModel:getShuraMaxRound()
    if self.shura_data then
        return self.shura_data.max_round
    end
end
function Shura_trailModel:getShuraData()
    if  self.shura_data then
        return  self.shura_data 
    end
end
function Shura_trailModel:setShuraBUFFData(data)
    if  self.shura_data then
        self.shura_data.click = data.click
        self.shura_data.pos = data.pos
        GlobalEvent:getInstance():Fire(Shura_trailEvent.CHOOSE_BUFF_END,self.shura_data)
    end
end

--刷新排行榜信息
function Shura_trailModel:updateRankInfo(data)
    if data and self.shura_data and next(self.shura_data or {}) ~= nil then
        self.shura_data.my_idx = data.my_idx
        self.shura_data.rank_list = data.rank_list
        GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_RANK_DATA)
    end
end

