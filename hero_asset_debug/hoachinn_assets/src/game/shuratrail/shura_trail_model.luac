--获取前三个
function Shura_trailModel:getRaknRoleTopThreeList()
    local list = {{rank = 1, name = TI18N("语言_c_526")}, {rank = 2, name = TI18N("语言_c_526")}, {rank = 3, name = TI18N("语言_c_526")}}
    local rank_list = self.shura_data.new_rank_list
    rank_list = self.shura_data.rank_list
    
    if rank_list and next(rank_list or {}) ~= nil then
        for i, v in ipairs(rank_list) do
            for i2, v1 in ipairs(list) do
                if v.idx == v1.rank then
                    list[i2] = v
                end
            end
        end
    end
    return list
end

--红点判断
function Shura_trailModel:checkRedPoint()
    local is_open = MainuiController:getInstance():checkMainFunctionOpenStatus(MainuiConst.btn_index.esecsice, MainuiConst.function_type.main, true)
    if is_open == false then return false end
    
    --先判断首通奖励是否领取
    if self.first_data.status == 1 then
        self.is_first_get = true
    else
        self.is_first_get = false
    end
       
    GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_REDPOINT_FIRST_DATA)
    --再判断是否已获所有日常奖励结算(开始挑战按钮的红点，，改成只要进去挑战过，就不会有红点提示)
    if self.shura_data and self.shura_data.day_pass_round then
        if tonumber(self.shura_data.day_pass_round) > 0 then
            self.is_award_get = false
        else
            self.is_award_get = true
        end
        GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_REDPOINT_REWARD_DATA)
    end

    if self.shura_data and self.shura_data.new_day_pass_round and self.ctrl:checkNewEndLessIsOpen() == true then
        if tonumber(self.shura_data.new_day_pass_round) > 0 or (self.shura_data.type ~= 0 and self.shura_data.type ~= self.shura_data.select_type) then
            self.is_award_get_new = false
        else
            self.is_award_get_new = true
        end
        GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_REDPOINT_REWARD_DATA)
    end

    --再判断是否已上阵
    if self.shura_data then
        if self.shura_data.is_appoint == 0 and self.send_partner and next(self.send_partner.list or {}) == nil then--没派出
            self.is_send_partner = true
        else
            self.is_send_partner = false
        end
    end
    self:enterRedPoint()
    local is_show_red = self:checkRedStatus()
    --设置入口红点
    GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_REDPOINT_SENDPARTNER_DATA)
    GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_ESECSICE_ENDLESS_REDPOINT)

    MainuiController:getInstance():setBtnRedPoint(MainuiConst.btn_index.esecsice, {bid=RedPointType.shura, status=is_show_red}) 
end

--入口等级未到的时候不显示红点
function Shura_trailModel:enterRedPoint()
    local open_data = StrongerController:getInstance():getExerciseactivityDataForID(EsecsiceConst.exercise_index.shuratrail)
    if open_data then
        local bool = MainuiController:getInstance():checkIsOpenByActivate(open_data.activate)
        if bool == false then
            self.is_first_get = false
            self.is_send_partner = false
            self.is_award_get = false
            self.is_award_get_new = false
            self.first_status = false
        end
    end
end

--获取首通红点状态
function Shura_trailModel:getFirstGet()
    return self.is_first_get
end

--获取是否已经派遣伙伴
function Shura_trailModel:getIsSendPartner()
    return self.is_send_partner
end

--获取是否已获所有日常奖励结算
function Shura_trailModel:getIsGetAllReward(  )
    return self.is_award_get
end

--获取是否已获所有日常奖励结算 新版
function Shura_trailModel:getIsGetAllRewardNew(  )
    return self.is_award_get_new
end

function Shura_trailModel:checkRedStatus()
    local status = false
    if not self:getShuraIsOpen() or self:getShuraIsOpen() ~= 1 then
        return status
    end
    if self.first_status and self.first_status == true then
        status = true
    else
        if self.is_first_get then
            status = true
        end
    end
    
    return status or self.is_send_partner or self.is_award_get or self.is_award_get_new or self.shura_login_red
end

