]]
function Shura_trailModel:setFirstData(data)
    if data then
        self.first_data = data
        self:checkRedPoint()
        GlobalEvent:getInstance():Fire(Shura_trailEvent.UPDATA_FIRST_DATA)
    end
end

function Shura_trailModel:setFirstStatus(data)
    if data then
        self.first_status = data.flag == 1
        self:checkRedPoint()
    end
end

