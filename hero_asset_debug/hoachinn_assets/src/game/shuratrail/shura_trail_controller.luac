--[[
    @desc: 战斗领取
    author:{author}
    time:2018-08-17 15:41:56
    @return:
]]

function Shura_trailController:openShuraRewardTips(status,id)
    if status == true then
        if not self.shura_reward_tips then
            self.shura_reward_tips = ShuraAwardsTips.New()
        end
        if self.shura_reward_tips and self.shura_reward_tips:isOpen() == false then
            self.shura_reward_tips:open(id)
        end
    else
        if self.shura_reward_tips then
            self.shura_reward_tips:close()
            self.shura_reward_tips = nil
        end
    end
end

