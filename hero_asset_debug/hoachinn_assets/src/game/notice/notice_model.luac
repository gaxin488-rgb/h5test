function NoticeModel:formatToChat(msg, isSelf)
	local data = {}
	data.channel = 1
	data.len = 0
	data.msg = msg.msg or ""
	data.role_list = {}
	local role_data = {}
	local role = RoleController:getInstance():getRoleVo()
	if isSelf == 1 then
		role_data.capacity = role.capacity or 0
		role_data.career = role.capacity or 0
		role_data.chat_bubble = 0
		role_data.city = ""
		-- role_data.ext_list = {
		-- 	[1] = {
		-- 		type = 2,
		-- 		val = 1,
		-- 	},
		-- }
		role_data.face_file = role.face_file or ""
		role_data.face_id = role.face_id or 10401
		role_data.face_update_time = role.face_update_time or 0
		role_data.g_name = role.g_name or ""
		role_data.gid = role.gid or 3
		role_data.gsrv_id = role.gsrv_id or "dev_14"
		role_data.head_bid = role.avatar_base_id or 5100
		role_data.is_show_vip = role.is_show_vip or 0
		role_data.lev = role.lev or 103
		role_data.name = msg.send_time..""
		role_data.province = ""
		role_data.rid = role.rid or 28
		role_data.sex = role.sex or 1
		role_data.srv_id = role.srv_id or "dev_14"
		role_data.vip_lev = role.vip_lev or 10
	else
		role_data.bubble_bid = 0
		role_data.capacity = 0
		role_data.career = 0
		role_data.city = ""
		-- role_data.ext_list = {
		-- 	[1] = {
		-- 		type = 2,
		-- 		val = 1,
		-- 	},
		-- }
		role_data.face_file = ""
		role_data.face_id = 1002
		role_data.face_update_time = 0
		role_data.g_name = ""
		role_data.gid = 0
		role_data.gsrv_id = "0"
		role_data.head_bid = 0
		role_data.is_show_vip = 0
		role_data.lev = 0
		role_data.name = TI18N("语言_c_2655").."  "..msg.send_time
		role_data.province = ""
		role_data.rid = -1
		role_data.sex = 2
		role_data.srv_id = role.srv_id or ""
		role_data.vip_lev = 0
	end
	data.role_list[#data.role_list + 1] = role_data
	data.tick = msg.send_time
	local vo = ChatModel.clone(data, 1)
	return vo
end

function NoticeModel:setNoticeBaseData(data)
	self.n_baseData = data
end

function NoticeModel:getNoticeBaseData()
	return self.n_baseData
end

function NoticeModel:updateNoticeBaseDataEmail(email)
	self.n_baseData = self.n_baseData or {}
	self.n_baseData.email = email
end

function NoticeModel:checkQuestionsDataExist()
	return self.n_questionsData
end

function NoticeModel:setQuestionsData(data)
	self.n_questionsData = self.n_questionsData or {}
	for k,v in pairs(data) do
		if not self.n_questionsData[v.id] then
			self.n_questionsData[v.id] = v
		end
	end
end

function NoticeModel:getQuestionById(id)
	if self then
		self.n_questionsData = self.n_questionsData or {}
		return self.n_questionsData[id]
	end
end

function NoticeModel:markQuestionReportStatus(id, mark)
	if not tolua.isnull(self) and self.n_questionsData and type(self.n_questionsData) == "table" then
		local data = self.n_questionsData[id]
		if data then
			data.report_status = mark or 1
		end
	end
end

function NoticeModel:getQuestionList()
	local dataList = self.n_questionsData
	local list = {}
	for k,v in pairs(self.n_questionsData) do
		list[#list + 1] = v
	end
	table.sort(list, function(a, b) return a.id > b.id end)
	return list
end

function NoticeModel:setQuestionsInfoData(post_id, datalist)  --全部
	self.n_questionsInfoData = self.n_questionsInfoData or {}
	self.n_questionsInfoData[post_id] = self.n_questionsInfoData[post_id] or {}
	for k,v in pairs(datalist) do
		self.n_questionsInfoData[post_id][#self.n_questionsInfoData[post_id] + 1] = v
	end
end

function NoticeModel:addQuestionsInfoData(post_id, data)  --增加
	self.n_questionsInfoData = self.n_questionsInfoData or {}
	self.n_questionsInfoData[post_id] = self.n_questionsInfoData[post_id] or {}
	self.n_questionsInfoData[post_id][#self.n_questionsInfoData[post_id] + 1] = data
end

function NoticeModel:getQuestionsInfoData(post_id)
	self.n_questionsInfoData = self.n_questionsInfoData or {}
	return self.n_questionsInfoData[post_id]
end

--收到有新消息并且没有打开的情况 存起来
function NoticeModel:addQuestionNewState(post_id)
	self.n_questionsInfoState = self.n_questionsInfoState or {}
	self.n_questionsInfoState[post_id] = 1
end

function NoticeModel:removeQuestionNewState(post_id)
	self.n_questionsInfoState = self.n_questionsInfoState or {}
	self.n_questionsInfoState[post_id] = nil
end

function NoticeModel:checkRedStatus()
	local status = false
	self.n_questionsInfoState = self.n_questionsInfoState or {}
	for k,v in pairs(self.n_questionsInfoState) do
		if v == 1 then
			return true
		end
	end
	return false
end

function NoticeModel:checkRedStatusById(post_id)
	if self.n_questionsInfoState[post_id] then
		return self.n_questionsInfoState[post_id] == 1
	end
	return false
end

function NoticeModel:setQuestionInfoPage(post_id, page)
	self.n_questionsInfoPage = self.n_questionsInfoPage or {}
	self.n_questionsInfoPage[post_id] = page
end

function NoticeModel:getQuestionInfoPage(post_id)
	self.n_questionsInfoPage = self.n_questionsInfoPage or {}
	return self.n_questionsInfoPage[post_id] or 1
end

function NoticeModel:setQuestionListPage(page)
	self.n_questionsListPage = page
end

function NoticeModel:getQuestionListPage()
	return self.n_questionsListPage or 1
end 

function NoticeModel:checkQuestionNoExist()
	self.n_questionsInfoState = self.n_questionsInfoState or {}
	for k,v in pairs(self.n_questionsInfoState) do
		if v == 1 then
			if not self:getQuestionById(k) then
				return true
			end
		end
	end
	return false
end

function NoticeModel:__delete()
end