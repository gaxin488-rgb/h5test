CommunityPanel = CommunityPanel or BaseClass(BaseView)

local controller = NoticeController:getInstance()
local model = controller:getModel()

local string_format = string.format
function CommunityPanel:__init()
    self.view_tag = ViewMgrTag.LOADING_TAG
    self.win_type = WinType.Mini   
    self.is_full_screen = false
    self.layout_name = "notice/community_panel"

    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("login", "login2"), type = ResourcesType.plist}
    }
end

function CommunityPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.main_container_size = self.main_container:getContentSize()


    self.close_btn = self.main_container:getChildByName("close_btn")

    self.panel_bg = self.main_container:getChildByName("panel_bg")
    self.content = self.main_container:getChildByName("content")
    local content_size = self.content:getContentSize()

    -- self.Image_2 = self.main_container:getChildByName("Image_2")
    -- self.title = self.main_container:getChildByName("win_title")
    -- self.title:setString(TI18N("闪烁社区"))

    -- self.comfirm_btn = self.main_container:getChildByName("comfirm_btn")
    -- self.comfirm_btn:getChildByName("label"):setString(TI18N("确认并同意"))
        
    --适配
    local top_y = display.getTop(self.main_container)
    local bottom_y = display.getBottom(self.main_container)

    --变化的高度
    local height = (top_y - self.main_container_size.height) - bottom_y

    -- self.main_container:setContentSize(self.main_container_size.width, self.main_container_size.height + height)
    -- self.panel_bg:setContentSize(self.main_container_size.width, self.main_container_size.height + height)
    self.panel_bg:setPositionY(self.panel_bg:getPositionY() - (self.main_container_size.height - top_y))
    self.close_btn:setPositionY(self.close_btn:getPositionY() - (self.main_container_size.height - top_y))

    self.content:setContentSize(content_size.width, content_size.height + height)
    self.content_size = self.content:getContentSize()
    self.content:setPositionY(self.content:getPositionY() + bottom_y)

    
end

function CommunityPanel:register_event()
    registerButtonEventListener(self.background, handler(self, self.onClickBtnClose) ,false, 1)
    registerButtonEventListener(self.close_btn, handler(self, self.onClickBtnClose) ,false, 1)
    -- registerButtonEventListener(self.comfirm_btn, handler(self, self.onClickComfirmBtn) ,true, 2)

    self:addGlobalEvent(ActionEvent.Platform_Linkage_Code_Event, function(scdata)
        if not scdata then return end
        -- model:setCommunityToken(scdata.token)
        self:setToken(scdata.token)
    end)
end

--关闭
function CommunityPanel:onClickBtnClose()
    controller:openCommunityPanel(false)
end


--@show_type 显示类型 1 社区  2 服务协议 3 用户隐私
function CommunityPanel:openRootWnd(show_type)
    show_type = show_type or 1

    if show_type == 2 then
        --参考 方法 openUserProto(value)
        local url = "https://www.shiyue.com/protocol/agreement.html"
        self:setUrlData(url)
    elseif show_type == 3 then
        local url = "https://www.shiyue.com/protocol/privacy.html"
        self:setUrlData(url)
    else
        --先获取token值
        local token = model:getCommunityToken()
        if token then
            self:setToken(token)
        else
            ActionController:getInstance():sender10972(999)
        end
    end
end

function CommunityPanel:setUrlData(url)
    self.url = url 
    self:layoutWebView()
    self:setWebViewUrl()
end

function CommunityPanel:setToken(token)
    if not token then return end
    local url = nil
    if IS_IOS_PLATFORM == true then --ios
        if PLATFORM_NAME == "release2" or PLATFORM_NAME == "demo" then
            url = string_format("http://test-bbs-h5.shiyue.com/forum/project/11/?isSdk=2&sdkDevice=ios&token=%s", token)
        else
            url = string_format("https://bbs.shiyue.com/forum/project/11/?isSdk=2&sdkDevice=ios&token=%s", token)
        end
    else --安卓
        if PLATFORM_NAME == "release2" or PLATFORM_NAME == "demo" then
            url = string_format("http://test-bbs-h5.shiyue.com/forum/project/11/?isSdk=2&sdkDevice=android&token=%s", token)
        else
            url = string_format("https://bbs.shiyue.com/forum/project/11/?isSdk=2&sdkDevice=android&token=%s", token)
        end
    end
    self.url = url
    -- if self.url == nil or self.url == "" then
    --     commonShowEmptyIcon(self.content, true, {text = TI18N("暂无数据")})
    -- else
    --     commonShowEmptyIcon(self.content, false)
        self:layoutWebView()
        self:setWebViewUrl()
    -- end
end


-- 分离处理webview，如果有问题可以只修改局部代码
function CommunityPanel:layoutWebView()
    if self.url and self.url ~= "" and ccexp.WebView then
        self.web_view = ccexp.WebView:create()
        self.web_view:setAnchorPoint(0.5, 0.5)
        self.web_view:setPosition(self.content_size.width * 0.5, self.content_size.height * 0.5)
        self.web_view:setContentSize(self.content_size)
        self.web_view:setScalesPageToFit(true)
        self.web_view:setVisible(false)
        self.content:addChild(self.web_view, 99)
    end
end

function CommunityPanel:setWebViewUrl()
    if not tolua.isnull(self.web_view) then
        self.web_view:setVisible(true) 
        self.web_view:loadURL(self.url)
    end
end


function CommunityPanel:close_callback()
    controller:openCommunityPanel(false)
end