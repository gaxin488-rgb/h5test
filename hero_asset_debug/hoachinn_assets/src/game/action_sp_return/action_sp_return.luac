ActionSpReturn = ActionSpReturn or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local string_format = string.format

function ActionSpReturn:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action_sp_return/action_sp_return"
    self.tab_list = {}
    self.res_list = {{
        path = PathTool.getPlistImgForDownLoad("dailypack", "dailypack"),
        type = ResourcesType.plist
    }}
end

function ActionSpReturn:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    self.main_container = self.root_wnd:getChildByName("main_container")
    local container = self.main_container:getChildByName("container")
    self.title_img = container:getChildByName("title_img")
    self.bgImg = container:getChildByName("bgImg")
    self.title = container:getChildByName("title")
    setTextMaxWidth(self.title, 700, -20)
    self.title:setString(TI18N("语言_c_7006"))
    self.close_btn = container:getChildByName("close_btn")
    self.help_btn = container:getChildByName("help_btn")
    self.scroller = container:getChildByName("scroller")
    self.tips = container:getChildByName("tips")
    self.tips:setString(Config.HolidaySpecialRecruitData.data_constant.action_tips_1.desc)
    setTextMaxWidth(self.tips, 600, -8)

    self.actime = createRichLabel(22, cc.c4b(0xff, 0xff, 0xff, 0xff), cc.p(0.5,0.5), cc.p(360, -22), -4, nil, 680)
    container:addChild(self.actime)

    self.tableContainer = container:getChildByName("tab")
    local bgSize = self.tableContainer:getContentSize()
    local scroll_view_size = cc.size(bgSize.width, bgSize.height)
    local setting = {
        item_class = CommonTabBtn,      -- 单元类
        start_x = 0,                  -- 第一个单元的X起点
        space_x = 5,                    -- x方向的间隔
        start_y = 5,                    -- 第一个单元的Y起点
        space_y = 0,                   -- y方向的间隔
        item_width = 162,               -- 单元的尺寸width
        item_height = 64,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
    }
    self.tab_scrollview = CommonScrollViewLayout.new(self.tableContainer, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)

    local scroll_view_size = self.scroller:getContentSize()
    local setting = {
        start_x = 0, -- 第一个单元的X起点
        space_x = 0, -- x方向的间隔
        start_y = 0, -- 第一个单元的Y起点
        space_y = 10, -- y方向的间隔
        item_width = 610, -- 单元的尺寸width
        item_height = 130, -- 单元的尺寸height
        col = 1, -- 列数，作用于垂直滚动类型
        need_dynamic = true
        -- checkovercallback = handler(self, self.updateSlideShowByVertical)
    }
    self.reward_goods_item = CommonScrollViewSingleLayout.new(self.scroller, cc.p(0, 0), ScrollViewDir.vertical,ScrollViewStartPos.top, scroll_view_size, setting)
    self.reward_goods_item:setSwallowTouches(true)
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.CreateNewCell),ScrollViewFuncType.CreateNewCell) -- 创建cell
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.NumberOfCells),ScrollViewFuncType.NumberOfCells) -- 获取数量
    self.reward_goods_item:registerScriptHandlerSingle(handler(self, self.UpdateCellByIndex),ScrollViewFuncType.UpdateCellByIndex) -- 更新cell
end
-- 奖励列表
function ActionSpReturn:CreateNewCell()
    local cell = ActionSpReturnItem.new()
    return cell
end

function ActionSpReturn:NumberOfCells()
    if not self.reward_list then
        return 0
    end
    return #self.reward_list
end

function ActionSpReturn:UpdateCellByIndex(cell, index)
    if not self.reward_list then
        return
    end
    local cell_data = self.reward_list[index]
    if not cell_data then
        return
    end

    cell:setData(cell_data,self.holiday_bid)
end

function ActionSpReturn:openRootWnd(bid,index)
    self.holiday_bid = bid
    ActionController:getInstance():sender21620(bid)
    self:setPanelData()
    self:setTimeInfo()
end

function ActionSpReturn:setTimeInfo()
    local sp_action = ActionController:getInstance():getActionSubTabVo(self.holiday_bid )
    if sp_action then
        local less_time = sp_action.remain_sec
        local str = string.format("<div fontcolor=#ffffff outline=2,#000000>%s</div>",TI18N("语言_c_7009")) 
        self.actime:setString(string.format(str,TimeTool.GetTimeFormatDayIII(less_time)))
        self.timeticket = GlobalTimeTicket:getInstance():add(function() 
            less_time = less_time - 1
            if not tolua.isnull(self.actime) then
                self.actime:setString(string.format(str,TimeTool.GetTimeFormatDayIII(less_time)))
            end
            if less_time <= 0 then
                GlobalTimeTicket:getInstance():remove(self.timeticket)
                self.timeticket = nil
                ActionController:getInstance():openSpReturnPanel(false)
            end
        end, 1)
    end
end

function ActionSpReturn:setPanelData()
    local act_vo = ActionController:getInstance():getActionSubTabVo( self.holiday_bid )
    if not act_vo then return end
    local camp_id = act_vo.camp_id
    local group_id = Config.HolidaySpecialRecruitData.data_group[camp_id]
    local task_list = Config.HolidaySpecialRecruitData.data_quest_list[group_id]
    
    self.task_list = {}
    for k, v in pairs(task_list) do
        local task_data = v
        local round = task_data.type
        if not self.task_list[round] then
            self.task_list[round] = {}
        end
        table.insert(self.task_list[round],task_data)
    end

    local round_num = #self.task_list
    local tab_array = {}
    for i = 1, round_num do
        local str= string_format(TI18N("语言_c_1558"),i)
        local a = { title = str, index = i }
        table.insert(tab_array, a)
    end

    local now_round = ActionController:getInstance():getModel():getCurrencyReturn(ActionRankCommonType.sp_return) 

    local tab_setting = {}
    tab_setting.tab_size = cc.size(160, 64)
    tab_setting.select_color =  cc.c4b(248,239,118,255)--Config.ColorData.data_color4[1]
    -- tab_setting.select_outline = cc.c4b(0x6d,0x35,0x07,0xff)
    tab_setting.normal_color = cc.c4b(0xff,0xff,0xff,0xff)
    -- tab_setting.normal_outline = cc.c4b(0x6d,0x35,0x07,0xff)
    tab_setting.img_rect = cc.rect(47, 40, 0, 0)
    self.tab_scrollview:setData(tab_array, handler(self, self.changeTabView), nil, tab_setting)
    self.tab_scrollview:addEndCallBack(function (  )
        self.tab_list = self.tab_scrollview:getItemList()
        -- self:isRedPoint()
        for k, v in pairs(self.tab_list) do
            if v.index == now_round then
                self:changeTabView(v)
            end
            local ststus = model:getRoundIsCanGet(self.holiday_bid,v.index)
            if v.index <= now_round then
                setChildUnEnabled(false,v)
                if v.lock then
                    v.lock:setVisible(false)
                end
                v:setRedStatus(ststus)
                v:setBtntitlepos(cc.p(80, 32))
            else
                if not v.lock then
                    local lock = createSprite(PathTool.getResFrame("common","common_lock"), 9, 32, v, cc.p(0, 0.5), LOADTEXT_TYPE_PLIST)
                    v.lock = lock
                end
                setChildUnEnabled(true,v)
                v:setRedStatus(false)
                v:setBtntitlepos(cc.p(93, 32))
            end
        end
    end)
end

function ActionSpReturn:isRedPoint()
    local now_round = ActionController:getInstance():getModel():getCurrencyReturn(ActionRankCommonType.sp_return) 
    for k, v in pairs(self.tab_list) do
        local ststus = model:getRoundIsCanGet(self.holiday_bid,v.index)
        if v.index <= now_round then
            setChildUnEnabled(false,v)
            if v.lock then
                v.lock:setVisible(false)
            end
            v:setRedStatus(ststus)
        else
            if not v.lock then
                local lock = createSprite(PathTool.getResFrame("common","common_lock"), 9, 32, v, cc.p(0, 0.5), LOADTEXT_TYPE_PLIST)
                v.lock = lock
            end
            setChildUnEnabled(true,v)
            v:setRedStatus(false)
        end
    end
end

function ActionSpReturn:register_event()
    registerButtonEventListener(self.close_btn, function()
        controller:openSpReturnPanel(false)
    end, false, 2)

    if self.help_btn then
		self.help_btn:addTouchEventListener(function( sender,event_type )
            if event_type == ccui.TouchEventType.ended then
                playButtonSound2()
                local des = Config.HolidaySpecialRecruitData.data_constant.action_rule.desc
                if des ~= "" then
                    TipsManager:getInstance():showCommonTips(des,sender:getTouchBeganPosition())
                end
            end
        end)
    end

    -- registerButtonEventListener(self.background, function()
    --     controller:openActionSpReturnWindow(false)
    -- end, false, 2)

    if not self.update_action_even_event then
        self.update_action_even_event = GlobalEvent:getInstance():Bind(ActionEvent.setSpActionTaskData, function(data)
            if self.task_list and self.task_list[self.cur_index] then
                local taskdata = self.task_list[self.cur_index]
                if not taskdata then return end
                local arr = {}
                for k, v in pairs(taskdata) do
                    local data = deepCopy(v)
                    local id = data.id
                    local server_data = model:getSpactionDataByid(self.holiday_bid,id)
                    if server_data.finish == 2 then
                        data.sort = 2
                    elseif server_data.finish == 1 then
                        data.sort = 0
                    elseif server_data.finish == 0 then
                        data.sort = 1
                    end
                    table.insert(arr, data)
                end
                local sort_func = SortTools.tableCommonSorter({{"sort", false},{"id", false}})
                table.sort(arr, sort_func)
                self.reward_list = deepCopy(arr)
                self.reward_goods_item:reloadData()
                self:isRedPoint()
            end
        end)
    end

end

function ActionSpReturn:changeTabView(tab_btn)
    if not tab_btn or tab_btn.index == self.cur_index then return end
    if self.cur_tab ~= nil then
        self.cur_tab:setBtnSelectStatus(false)
    end

    self.cur_tab = tab_btn
    self.cur_index = tab_btn.index
    self.cur_tab:setBtnSelectStatus(true)

    local taskdata = self.task_list[self.cur_index]
    local arr = {}
    for k, v in pairs(taskdata) do
        local data = deepCopy(v)
        local id = data.id
        local server_data = model:getSpactionDataByid(self.holiday_bid,id)
        if server_data and next(server_data) then
            if server_data.finish == 2 then
                data.sort = 2
            elseif server_data.finish == 1 then
                data.sort = 0
            elseif server_data.finish == 0 then
                data.sort = 1
            end
        else
            data.sort = 1
        end
        table.insert(arr, data)
    end
    local sort_func = SortTools.tableCommonSorter({{"sort", false},{"id", false}})
    table.sort(arr, sort_func)

    self.reward_list = deepCopy(arr)
    self.reward_goods_item:reloadData()
end

function ActionSpReturn:close_callback()
    if self.timeticket then
        GlobalTimeTicket:getInstance():remove(self.timeticket)
        self.timeticket = nil
    end
    if self.update_action_even_event then
        GlobalEvent:getInstance():UnBind(self.update_action_even_event)
        self.update_action_even_event = nil
    end
    if self.reward_goods_item then
        self.reward_goods_item:DeleteMe()
        self.reward_goods_item = nil
    end
    if self.tab_scrollview then
        self.tab_scrollview:DeleteMe()
        self.tab_scrollview = nil
    end
    controller:openSpReturnPanel(false)
end

---------------------------@ 子项
ActionSpReturnItem = class("ActionSpReturnItem", function()
    return ccui.Widget:create()
end)

function ActionSpReturnItem:ctor()
    self:configUI()
    self:register_event()
end

function ActionSpReturnItem:configUI()
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("action_sp_return/action_sp_return_item"))
    self:setAnchorPoint(0, 0)
    self:setContentSize(cc.size(610, 130))
    self:addChild(self.root_wnd)

    self.main_container = self.root_wnd:getChildByName("main_container")
    self.good_cons = self.main_container:getChildByName("good_cons")
    -- self.item_container:setScrollBarEnabled(false)
    local gift_name = self.main_container:getChildByName("gift_name")
    gift_name:setString("")
    self.gift_name = createRichLabel(22, cc.c4b(0x35,0x15,0x00), cc.p(0,0.5), cc.p(200,90), -4, nil, 240)
    self.main_container:addChild(self.gift_name)
    -- setTextMaxWidth(self.gift_name, 270, -4)

    self.bar_bg = self.main_container:getChildByName("bar_bg")
    self.bar = self.main_container:getChildByName("bar")
    self.bar:setScale9Enabled(true)
    self.bar_pro = self.main_container:getChildByName("bar_pro")
    self.btn_get = self.main_container:getChildByName("btn_get")
    self.btn_lab = self.btn_get:getChildByName("label")
    self.btn_lab:setString("")
    self.spr_get = self.main_container:getChildByName("spr_get")

    self.lock_txt = self.main_container:getChildByName("lock_txt")
    self.lock_txt:setString(TI18N("语言_c_4868"))
    self.lock_txt:setVisible(false)
    self.lock_img = self.main_container:getChildByName("lock_img")
    self.lock_img:setVisible(false)

end

function ActionSpReturnItem:register_event()
    registerButtonEventListener(self.btn_get, function()
        if self.finish_status == 1 then --可领取
            controller:sender21621(self.bid,self.data.id)
        else --跳转招募界面
            controller:openSpReturnPanel(false)
            JumpController:getInstance():jumpViewByEvtData({758})
        end
    end, true)
end

function ActionSpReturnItem:setData(data,bid)
    -- [1] = {group=1, type=1, id=1, progress={{cli_label="evt_recruit",target=600,target_val=10,param={}}}, 
    -- task_desc=TI18N("活动期间,在SP特殊招募中招募{1}次"), award={{10001,500}}, jump_id=1, max_num=80},
    if not data then
        return
    end
    self.data = data
    self.bid = bid
    local target = data.progress[1]
    local target_val = target.target_val - data.max_num
    local target_str = string.format("<div fontcolor=#009f00>%s</div>",(target_val))
    local str = LangStringFormat(data.task_desc,target_str)
    self.gift_name:setString(str)

    local server_data = model:getSpactionDataByid(self.bid,self.data.id)
    local now_pro = 0
    if server_data then
        now_pro = server_data.value
    end
    self.bar_pro:setString(now_pro.."/"..target_val)
    self.bar:setPercent(now_pro/target_val*100)
    local reward = data.award
    self:setItemData(reward)
    self:setbtnstatus()
end

function ActionSpReturnItem:setbtnstatus()
    local ing_round = model:getCurrencyReturn(self.bid)
    if ing_round >= self.data.type then --当前轮次已开放
        self.lock_img:setVisible(false)
        self.lock_txt:setVisible(false)
        self.bar:setVisible(true)
        self.bar_bg:setVisible(true)
        self.bar_pro:setVisible(true)
        local server_data = model:getSpactionDataByid(self.bid,self.data.id)
        addRedPointToNodeByStatus(self.btn_get, false)
        if server_data then
            self.finish_status = server_data.finish
            if self.finish_status == 2 then
                self.btn_get:setVisible(false)
                self.spr_get:setVisible(true)
            end
            if self.finish_status == 0 or self.finish_status == 1 then
                self.btn_get:setVisible(true)
                self.spr_get:setVisible(false)
                if self.finish_status == 0 then
                    self.btn_lab:setString(TI18N("语言_c_108"))
                end
                if  self.finish_status == 1 then
                    self.btn_lab:setString(TI18N("语言_c_109"))
                    addRedPointToNodeByStatus(self.btn_get, true,10,10)
                end
            end
        end
    else
        self.lock_img:setVisible(true)
        self.lock_txt:setVisible(true)
        self.bar:setVisible(false)
        self.bar_bg:setVisible(false)
        self.bar_pro:setVisible(false)
        self.btn_get:setVisible(false)
        self.spr_get:setVisible(false)
    end
end

-- 设置奖励列表
function ActionSpReturnItem:setItemData(data)
    if not data then
        return
    end
    if not self.item_scrollview  then
        local scroll_view_size = self.good_cons:getContentSize()
        local setting = {
            item_class = BackPackItem, -- 单元类
            start_x = 0, -- 第一个单元的X起点
            space_x = 8, -- x方向的间隔
            start_y = 5, -- 第一个单元的Y起点
            space_y = 0, -- y方向的间隔
            item_width = BackPackItem.Width * 0.7, -- 单元的尺寸width
            item_height = BackPackItem.Height * 0.7, -- 单元的尺寸height
            row = 1, -- 行数，作用于水平滚动类型
            col = 0, -- 列数，作用于垂直滚动类型
            scale = 0.7
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.good_cons, cc.p(0, 0), ScrollViewDir.horizontal,ScrollViewStartPos.top, scroll_view_size, setting)
    end
    local list = {}
    for k, v in pairs(data) do
        local temp = Config.ItemData.data_get_data(v[1])
        local vo = deepCopy(temp)
        vo.quantity = v[2]
        table.insert(list, vo)
    end
    self.item_scrollview:setData(list)
    self.item_scrollview:addEndCallBack(function()
        local list = self.item_scrollview:getItemList()
        for k, v in pairs(list) do
            v:setDefaultTip()
        end
    end)
end

function ActionSpReturnItem:DeleteMe()
    if self.item_scrollview then
        self.item_scrollview:DeleteMe()
        self.item_scrollview = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end
