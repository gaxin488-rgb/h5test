	end
end

-- 大神风采
function ShinobiController:handle14411( data )
	if data then
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_GodLogData_Event,data)
	end
end

-- 推送红点
function ShinobiController:handle14412( data )
	if data and data.red_point_list then
		for i,v in pairs(data.red_point_list) do
			self.model:updateShinobiRedStatus(v.type,v.code== 1)
	    end
	end
end

-- 设置阵法
function ShinobiController:handle14432( data )
	if data then
		if data.code == 1 then
			if self.isTips == 0 then
				message(TI18N("语言_s_132"))
			end
		else
			if self.isTips == 0 then
				message(data.msg)
			end
			GlobalEvent:getInstance():Fire(HeroEvent.Hero_no_Sacrifice_bttom_Event,data.msg,PartnerConst.Fun_Form.ShinobiDef)
			HeroController:getInstance():getModel():NextBattle(14432)
		end
		self.isTips = 0
		if data.code == 1 then -- 设置阵法成功，则通知布阵界面进入战斗
			-- GlobalEvent:getInstance():Fire(ShinobiEvent.Save_Shinobi_Form_Event, data)
			if self._temp_formation then
				local model = HeroController:getInstance():getModel()
				local temp=self._temp_formation
				temp.type = PartnerConst.Fun_Form.ShinobiDef
				model:setFormList(temp)
				self._temp_formation = nil
			end
			HeroController:getInstance():getModel():NextBattle(14432)
		end
	end
end

-- 阵法数据
function ShinobiController:handle14433( data )
	if data.type == 2 then
	    local model = HeroController:getInstance():getModel()
		data.type=PartnerConst.Fun_Form.ShinobiDef
		model:setFormList(data)
    end 
	GlobalEvent:getInstance():Fire(ShinobiEvent.Update_Form_Data_Event, data) 
end

-- 挑战记录
function ShinobiController:handle14416( data )
	if data then
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_Video_Data_Event, data)
	end
end

-- 挑战记录详情
function ShinobiController:handle14417( data )
	if data then
		GlobalEvent:getInstance():Fire(ElitematchEvent.Elite_Challenge_Record_Info_Event, data)
	end
end

---------------@ 界面相关
-- 打开忍界联赛主界面
function ShinobiController:openShinobiMainWindow( status )
	if status == true then
		-- 功能是否开启
		if not self.model:getShinobiIsOpen() then
			return
		end
		if not self.Shinobi_main_wnd then
			self.Shinobi_main_wnd = ShinobiMainWindow.New()
		end
		if self.Shinobi_main_wnd:isOpen() == false then
			self.Shinobi_main_wnd:open()
		end
	else
		if self.Shinobi_main_wnd then
			self.Shinobi_main_wnd:close()
			self.Shinobi_main_wnd = nil
		end
	end
end

function ShinobiController:getShinobiMainRoot(  )
	if self.Shinobi_main_wnd then
		return self.Shinobi_main_wnd.root_wnd
	end
end

-- 打开段位界面
function ShinobiController:openShinobiLevelPanel( status,group)
	if status == true then
		if not self.Shinobi_level_wnd then
			self.Shinobi_level_wnd = ShinobiLevelPanel.New()
		end
		if self.Shinobi_level_wnd:isOpen() == false then
			self.Shinobi_level_wnd:open(group)
		end
	else
		if self.Shinobi_level_wnd then
			self.Shinobi_level_wnd:close()
			self.Shinobi_level_wnd = nil
		end
	end
end

