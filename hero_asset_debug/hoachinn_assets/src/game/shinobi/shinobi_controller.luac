ShinobiController = ShinobiController or BaseClass(BaseController)

function ShinobiController:config()
    self.model = ShinobiModel.New(self)
    self.dispather = GlobalEvent:getInstance()
end

function ShinobiController:getModel()
    return self.model
end

function ShinobiController:registerEvents()
	-- 断线重连
    if self.re_link_game_event == nil then
        self.re_link_game_event = GlobalEvent:getInstance():Bind(LoginEvent.RE_LINK_GAME, function()
        	-- 断线重连成功后，如果结算界面正在显示，则重新请求一次翻牌数据
        	if self.Shinobi_result_wnd then
        		self:sender14412()
        	end
        end)
    end
end

------------------ c2s
-- 请求个人信息
function ShinobiController:sender14400(  )
	self:SendProtocal(14400, {})
end

-- 请求挑战列表
function ShinobiController:sender14401(  )
	self:SendProtocal(14401, {})
end

-- 请求挑战玩家的信息
function ShinobiController:sender14402( rid, srv_id )
	local protocal = {}
    protocal.rid = rid
    protocal.srv_id = srv_id
    self:SendProtocal(14402, protocal)
end

-- 挑战玩家
function ShinobiController:sender14403( rid, srv_id,is_test,stars )
	MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.Shinobi)
	local protocal = {}
    protocal.rid = rid
    protocal.srv_id = srv_id
	protocal.is_test = is_test
    protocal.stars = stars
    self:SendProtocal(14403, protocal)
end

-- 请求设置阵法
function ShinobiController:sender14432( type,formation_type,pos_info,hallows_id,isTips)
	self.isTips = isTips or 0
	local protocal = {}
    protocal.type = type
	protocal.formation_type = formation_type
    protocal.pos_info = pos_info
	protocal.hallows_id = hallows_id
    if type == 2 then -- 缓存一下，设置成功之后再写入锁定英雄数据
    	self._temp_formation = protocal
    end
    self:SendProtocal(14432, protocal)
end

-- 请求阵法数据
function ShinobiController:sender14433( type )
	local protocal = {}
    protocal.type = type
    self:SendProtocal(14433, protocal)
end

-- 请求挑战玩家
function ShinobiController:sender14406( rid, srv_id )
    --策划要求进入战斗要去掉提示
	PromptController:getInstance():getModel():removePromptDataByTpye(PromptTypeConst.Corss_arena_tips)
	local protocal = {}
    protocal.rid = rid
    protocal.srv_id = srv_id
    protocal.is_auto = self.model:getShinobiAutoBattle() or 0
    self:SendProtocal(14406, protocal)
end

