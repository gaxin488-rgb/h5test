-- 战斗结算
function ShinobiController:handle14407( data )
	if data then
		BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.Shinobi, data)
	end
end

-- 每日排行榜数据
function ShinobiController:handle14408( data )
	if data then	
		if data.rank_list_daily and next(data.rank_list_daily)~=nil then
           table.sort(data.rank_list_daily,function (a,b)
			  return a.rank<b.rank
		   end)
		end
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_Rank_Data_Event, data)
	end
end

-- 赛区排行榜数据
function ShinobiController:handle14409( data )
	if data then
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_ZoneRank_Data_Event,data)
	end
end

-- 日志记录
function ShinobiController:handle14410( data )
	if data then
