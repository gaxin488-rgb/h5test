function ShinobiController:registerProtocals()
	self:RegisterProtocal(14400, "handle14400")     -- 个人数据
	self:RegisterProtocal(14401, "handle14401")     -- 挑战角色列表数据
	self:RegisterProtocal(14402, "handle14402")     -- 挑战角色的信息
	self:RegisterProtocal(14403, "handle14403")     -- 挑战玩家
	self:RegisterProtocal(14407, "handle14407")     -- 战斗结算
	self:RegisterProtocal(14408, "handle14408")     -- 每日排行榜数据
	self:RegisterProtocal(14409, "handle14409")     -- 赛区排行榜数据
	self:RegisterProtocal(14410, "handle14410")     -- 日志记录
	self:RegisterProtocal(14411, "handle14411")     -- 大神风采
	self:RegisterProtocal(14412, "handle14412")     -- 推送红点
	self:RegisterProtocal(14413, "handle14413")     -- 主界面系统提示跳转相关
	self:RegisterProtocal(14432, "handle14432")     -- 设置阵法
    self:RegisterProtocal(14433, "handle14433")     -- 请求阵法数据

end

------------------ s2c
function ShinobiController:handle14413( data )
end
-- 个人信息
function ShinobiController:handle14400( data )
	if data then
		-- print("handle14400",vardump(data))
		self.model:setShinobiMyBaseInfo(data)
		self.model:checkShinobiPrompt()
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_MyBaseInfo_Event)
	end
end

-- 挑战角色列表数据
function ShinobiController:handle14401(data)
	if data then
		-- print("handle14401",vardump(data))
		if data.f_list and next(data.f_list)~=nil then
            for i,v in ipairs(data.f_list) do
                if v.is_challenged>0 then
				   local t=v.stars>0 and 100000 or 1000
                   v.force=v.power*t
				else
					v.force=v.power
				end
			end
			table.sort(data.f_list, function(a, b) return a.force < b.force end)
			if data.type == 0 then -- 全部更新
				self.model:setChallengeRoleData(data.f_list)
			elseif data.type == 1 then -- 部分更新
				self.model:updateChallengeRoleData(data.f_list)
			end
		else
			self.model:setChallengeRoleData({})
		end
		self.model:checkShinobiPrompt1()
		GlobalEvent:getInstance():Fire(ShinobiEvent.Update_Challenge_Role_Event)
	end
end

-- 挑战角色的信息
function ShinobiController:handle14402( data )
	if data then
		if data and self.Shinobi_Atk_wnd then
			self.Shinobi_Atk_wnd:setData(data)
		end
	end
end

-- 查看对方英雄信息(成功返回11061)
function ShinobiController:handle14403( data )
	if data then
		message(data.msg)
	end
end

-- 挑战玩家
function ShinobiController:handle14406( data )
	if data then
		message(data.msg)
	end
end

