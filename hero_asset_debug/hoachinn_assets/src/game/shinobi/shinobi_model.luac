end

-- 忍界联赛功能开启状态
function ShinobiModel:getShinobiIsOpen( not_tips )
	if not Config.ArenaShinobiData then return false end
	local role_vo = RoleController:getInstance():getRoleVo()
	local lev_limt_cfg = Config.ArenaShinobiData.data_shinobi_const["character_level"]
	if role_vo and role_vo.lev < lev_limt_cfg.val then
		if not not_tips then
			message(lev_limt_cfg.desc)
		end
		return false, lev_limt_cfg.desc
	end
	-- local world_lv = RoleController:getInstance():getModel():getWorldLev()
	-- local world_lv_cfg = Config.ArenaShinobiData.data_const["world_lev_open"]
	-- if world_lv < world_lv_cfg.val then
	-- 	if not not_tips then
	-- 		message(world_lv_cfg.desc)
	-- 	end
	-- 	return false, world_lv_cfg.desc
	-- end
	return true
end

-- 根据排名获取对应的奖励数据
function ShinobiModel:getShinobiRankAward( rank )
	for k,cfg in pairs(Config.ArenaShinobiData.data_rank_award) do
		if rank <= cfg.max and rank >= cfg.min then
			return cfg.items
		end
	end
end

-- 是否屏蔽功能
function ShinobiModel:isHideShinobi()
	local nohideIds = RoleController:getInstance():getModel():getSeverShowIds("features_shield")
	local featuresId = MainuiConst.FeaturesShield.shinobi
    if not table.indexof(nohideIds,featuresId) then
		return true
	end
end

--设置赛季荣耀数据
function ShinobiModel:setHonourRoleData( data )
	self.honourRoleData = data

	local red_status = false
	for k,v in pairs(self.honourRoleData) do
		if v.worship_status == 0 then
			red_status = true
			break
		end
	end
	self:updateShinobiRedStatus(ShinobiConst.Red_Index.Like, red_status)
end

function ShinobiModel:getHonourRoleData(  )
	return self.honourRoleData
end

-- 红点相关
function ShinobiModel:updateShinobiRedStatus( type, status )
    local _status = self.shinobi_red_list[type]
    if _status == status then return end
    self.shinobi_red_list[type] = status
	local arena_status = self:checkShinobiRedStatus()
	MainSceneController:getInstance():setBuildRedStatus(CenterSceneBuild.shinobi, {bid = CrossgroundConst.Red_Type.Shinobi, status = arena_status})
	-- 更新天梯界面红点
	GlobalEvent:getInstance():Fire(ShinobiEvent.Update_Red_Status_Event,status)
end

function ShinobiModel:checkShinobiRedStatus(  )
	if self.shinobi_red_list then
	    return self.shinobi_red_list[1] and self.shinobi_red_list[4] 
	else
		return false
	-- for k,v in pairs(self.shinobi_red_list) do
	-- 	if v == true then
	-- 	    return true
	-- 	end
	end
end

-- 根据红点类型获取红点状态
function ShinobiModel:getShinobiRedStatus( red_type )
	return self.shinobi_red_list[red_type] or false
end

function ShinobiModel:__delete()
end