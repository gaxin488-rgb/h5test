ShinobiAttkPositionWindow = ShinobiAttkPositionWindow or BaseClass(BaseView)

local controller = ShinobiController:getInstance()
local model = controller:getModel()

function ShinobiAttkPositionWindow:__init(  )
	self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.win_type = WinType.Big 
	self.is_full_screen = false
	self.res_list = {
		{path = PathTool.getPlistImgForDownLoad("guildwar", "guildwar"), type = ResourcesType.plist},
		{path = PathTool.getPlistImgForDownLoad("form", "form"), type = ResourcesType.plist },
	}
	self.layout_name = "shinobi/shinobi_attk_position_window"

	self.item_list = {}
end

function ShinobiAttkPositionWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    local container = self.root_wnd:getChildByName("container")
    self.container = container
    self:playEnterAnimatianByObj(container, 1)

    local pos_panel = container:getChildByName("pos_panel")

    self.pos_panel = pos_panel

    local win_title = container:getChildByName("win_title")
    win_title:setString(TI18N("语言_c_3836"))
	moveTextBg(win_title,container:getChildByName("image_1"),65)
    self.checkbox=container:getChildByName("checkbox")
	local check_label=self.checkbox:getChildByName("name")
	setTextMaxWidth(check_label,550)
	check_label:setString(TI18N("语言_c_5992"))
    local award_label = pos_panel:getChildByName("award_label")
    -- award_label:setString(TI18N("语言_c_6027"))
	-- setTextMaxWidth(award_label,540)
	award_label:setTouchEnabled(true)
    award_label:setString(transformTextToShort(TI18N("语言_c_6027"),50))
    addEvt2showAllTextTips(award_label,TI18N("语言_c_6027"),50)

    self.close_btn = container:getChildByName("close_btn")
    self.easy_btn = pos_panel:getChildByName("easy_btn")
    local easy_btn_label = self.easy_btn:getChildByName("label")
    easy_btn_label:setString(TI18N("语言_c_457"))
    self.com_btn = pos_panel:getChildByName("com_btn")
    local com_btn_label = self.com_btn:getChildByName("label")
    com_btn_label:setString(TI18N("语言_c_457"))
    self.diff_btn = pos_panel:getChildByName("diff_btn")
    local diff_btn_label = self.diff_btn:getChildByName("label")
    diff_btn_label:setString(TI18N("语言_c_457"))
    self.form_btn=container:getChildByName("form_btn")
	self.form_btn:getChildByName("label"):setString(TI18N("语言_c_3860"))
	setTextSpacing(self.form_btn:getChildByName("label"), -8)
    self.tips_label = container:getChildByName("tips_label")
    self.award_bg = container:getChildByName("image_2")
    local title_label=container:getChildByName("title_label")
	local line_4=container:getChildByName("line_4")
	local line_3=container:getChildByName("line_3")
	title_label:setString(TI18N("语言_c_6141"))
	setTextTweenBg(title_label,line_3,line_4,nil,20,true)
    self.count_label = container:getChildByName("count_label")
    self.easy_label = pos_panel:getChildByName("easy_label")
    self.easy_coe_label = pos_panel:getChildByName("easy_coe_label")
    self.com_label = pos_panel:getChildByName("com_label")
    self.com_coe_label = pos_panel:getChildByName("com_coe_label")
    self.diff_label = pos_panel:getChildByName("diff_label")
    self.diff_coe_label = pos_panel:getChildByName("diff_coe_label")
    self.good_con = container:getChildByName("good_con")

    self.image_easy = pos_panel:getChildByName("image_easy")
    self.image_com = pos_panel:getChildByName("image_com")
    self.image_dif = pos_panel:getChildByName("image_dif")

    local count_title = container:getChildByName("count_title")
    count_title:setString(TI18N("语言_c_92"))
	self.time_title = container:getChildByName("time_title")
    self.time_title:setString(TI18N("语言_c_5993"))
	self.time_val= container:getChildByName("time_val")
    local good_con_size = self.good_con:getContentSize()
    self.good_con_size = good_con_size
    self.item_scroll_view = createScrollView(good_con_size.width, good_con_size.height, 0, good_con_size.height/2, self.good_con, ccui.ScrollViewDir.horizontal) 
    self.item_scroll_view:setAnchorPoint(cc.p(0, 0.5))
    self.item_scroll_view:setInnerContainerSize(cc.size(good_con_size.width, good_con_size.height))
end

function ShinobiAttkPositionWindow:setData( data )
	self.data = data
	local base_info = model:getShinobiMyBaseInfo()
	local power = data.power or 0
	-- 难度系数显示
	local easy_cfg = Config.ArenaShinobiData.data_shinobi_const["easy_diff_addition"]
	if self.easy_coe_label then
		self.easy_coe_label:setString(string.format(TI18N("语言_c_4739"),easy_cfg.val/10))
	end
	local normal_cfg = Config.ArenaShinobiData.data_shinobi_const["normal_diff_addition"]
	if self.com_coe_label then
		self.com_coe_label:setString(string.format(TI18N("语言_c_4739"),normal_cfg.val/10))
	end
	local hard_cfg = Config.ArenaShinobiData.data_shinobi_const["hard_diff_addition"]
	if self.diff_coe_label then
		self.diff_coe_label:setString(string.format(TI18N("语言_c_4739"),hard_cfg.val/10))
	end
	self.ref_time = base_info.ref_time or 0  -- 下次可刷新时间
	local cur_time = GameNet:getInstance():getTime()
	local pos_data = Config.ArenaShinobiData.data_group_fun(base_info.group)
	if pos_data then
		local easy_value = pos_data.score_list[1] or 0
		self.easy_label:setString(string.format(TI18N("语言_c_6034"), math.ceil(easy_value)))
		local com_value = pos_data.score_list[2] or 0
		self.com_label:setString(string.format(TI18N("语言_c_6034"),math.ceil(com_value)))
		local diff_value = pos_data.score_list[3] or 0
		self.diff_label:setString(string.format(TI18N("语言_c_6034"),math.ceil(diff_value)))
	end
	self.award_bg:setContentSize(cc.size(560, 190))
	local award_data =pos_data.award_list[3]
	if award_data then
		local item_num = #award_data
		local space_x = 30
		local scale = 0.8
		local start_x = (self.good_con_size.width-item_num*BackPackItem.Width*scale-(item_num-1)*space_x)/2
		if start_x < 0 then
			start_x = 0
		end
		for k,award in pairs(award_data) do
			if type(award) == "table" then
				local bid = award[1]
	            local num = award[2]
	            local item_conf = Config.ItemData.data_get_data(bid)
	            if item_conf then
	            	local item = self.item_list[k]
	            	if not item then
	            		item = BackPackItem.new(false, true, false, 1, false, true)
	            		item:setDefaultTip(true,true)
	                	item:setScale(scale)
	                	self.item_scroll_view:addChild(item)
	                	self.item_list[k] = item
	            	end
	                local _x = start_x + (BackPackItem.Width*scale + space_x) * (k-1) + BackPackItem.Width*scale*0.5
	                local _y = self.good_con_size.height/2
	                item:setBaseData(bid, num)	                
	                item:setPosition(_x, _y)
	            end
			end
		end
	end
	local challenge_count = model:getChallengeCount(self.rid,self.srv_id)
	local max_count = Config.ArenaShinobiData.data_shinobi_const.arena_time.val
	self.count_label:setString(string.format("%d/%d", max_count-challenge_count, max_count))
	self.ischallenged= max_count-challenge_count<=0
	self.is_rest=base_info.status~=3
	-- 敌方阵容
	if not self.enemy_battle_array_panel then
		self.enemy_battle_array_panel = ShinobiBattleArrayPanel.new()
		local container_size = self.container:getContentSize()
		self.container:addChild(self.enemy_battle_array_panel)
		self.enemy_battle_array_panel:setPosition(cc.p(32, 585))
	end
	local battle_array_data = {}
	local partner_list = {}
	for k,v in pairs(data.p_list) do
		table.insert(partner_list, v)
	end
	battle_array_data.partner_list = partner_list
	battle_array_data.rid = data.rid
	battle_array_data.srv_id = data.srv_id
	battle_array_data.is_robot = data.is_robot
	battle_array_data.name = self.data.name
	battle_array_data.power = power
	battle_array_data.formation_type = data.formation_type
	battle_array_data.formation_lev = data.formation_lev
	self.enemy_battle_array_panel:setData(battle_array_data)
	local ref_left_time = self.ref_time - cur_time
	if ref_left_time <= 0 then
		self.time_title:setVisible(false)
		self.time_val:setVisible(false)
		self.isCD=false
	elseif ref_left_time > 0 then
		self.time_title:setVisible(true)
		self.time_val:setVisible(true)
		self.isCD=true
		-- commonCountDownTime(self.time_val, ref_left_time)
		commonCountDownTime(self.time_val, ref_left_time, {end_callback = function(ref_left_time) 
			if ref_left_time <= 0 then
				self.isCD=false
				self:SetBtnStatus(self.isCD or self.ischallenged or self.is_rest)
				self.time_title:setVisible(false)
				self.time_val:setVisible(false)
			end       
		end})
		local pos_x = self.time_title:getPositionX() + self.time_title:getContentSize().width
		self.time_val:setPositionX(pos_x+5)
	end
	self:SetBtnStatus(self.ischallenged or self.is_rest)
end

function ShinobiAttkPositionWindow:SetBtnStatus(status)	
	setChildUnEnabled(status, self.easy_btn)
	setChildUnEnabled(status, self.com_btn)
	setChildUnEnabled(status, self.diff_btn)
	-- setChildUnEnabled(status, self.image_easy)
	-- setChildUnEnabled(status, self.image_com)
	-- setChildUnEnabled(status, self.image_dif)
end

function ShinobiAttkPositionWindow:_onClickFormBtn(  )
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.ShinobiAtk, {}, HeroConst.FormShowType.eFormSave)
end

function ShinobiAttkPositionWindow:_onClickFightBtn( star)
	local base_info = model:getShinobiMyBaseInfo()
	self.is_rest = base_info.status~=3 --重新取一下服务器数据

	local is_select = self.checkbox:isSelected()
	if self.is_rest then
        message(TI18N("语言_c_1473"))
		return 
	end
	if self.ischallenged then
        message(TI18N("语言_c_1678"))
		return 
	end
	if self.isCD and is_select then
        message(TI18N("语言_c_5995"))
		return 
	end
    if self.rid and self.srv_id then
		local is_test=is_select and 1 or 0
		controller:sender14403(self.rid,self.srv_id,is_test,star)
		controller:openShinobiAtkWindow(false)
	end
end

function ShinobiAttkPositionWindow:register_event(  )
	-- self.background:addTouchEventListener(function(sender, event_type)
	-- 	if event_type == ccui.TouchEventType.ended then
	-- 		playCloseSound()
	-- 		controller:openShinobiAtkWindow(false)
	-- 	end
	-- end)
	registerButtonEventListener(self.form_btn, handler(self, self._onClickFormBtn), true)
	registerButtonEventListener(self.easy_btn, function (  )
    	self:_onClickFightBtn(1)
    end, false)
	registerButtonEventListener(self.com_btn, function (  )
    	self:_onClickFightBtn(2)
    end, false)
	registerButtonEventListener(self.diff_btn, function (  )
    	self:_onClickFightBtn(3)
    end, false)

	self.close_btn:addTouchEventListener(function(sender, event_type)
		if event_type == ccui.TouchEventType.ended then
			playCloseSound()
			controller:openShinobiAtkWindow(false)
		end
	end)
end

function ShinobiAttkPositionWindow:openRootWnd(data)
	self.rid=data.rid
	self.srv_id=data.srv_id
	self.data=data
	self.checkbox:setSelected(false)
	controller:sender14402(data.rid,data.srv_id)
end

function ShinobiAttkPositionWindow:close_callback(  )
	if self.enemy_battle_array_panel then
		self.enemy_battle_array_panel:DeleteMe()
		self.enemy_battle_array_panel = nil
	end
	for k,item in pairs(self.item_list) do
		item:DeleteMe()
		item = nil
	end
	doStopAllActions(self.time_val)
	controller:openShinobiAtkWindow(false)
end