function ShinobiMainWindow:updateDanInfo()
    local config = Config.ArenaShinobiData.data_shinobi_level[self.myBaseInfo.cur_dan]
    if config then
        local res= PathTool.getPlistImgForDownLoad("shinobi/shinobi_icon",config.ico, false)
        if self.record_res ~= res then
            self.record_res = res
            self.item_load = loadSpriteTextureFromCDN(self.level_img, res, ResourcesType.single, self.item_load) 
        end
        local bg_res = PathTool.getPlistImgForDownLoad("shinobi/shinobi_icon",config.name_ico, false)
        if self.record_txt_res ~= bg_res then
            self.record_txt_res = bg_res
            self.item_load1 = loadSpriteTextureFromCDN(self.level_txt_icon, bg_res, ResourcesType.single, self.item_load1) 
        end
        if config.next_id>0 then
           local score =self.myBaseInfo.tol_score-config.all_exp
           score=math.max(score,0)
           local nextcfg=Config.ArenaShinobiData.data_shinobi_level[config.next_id]
           if score<config.need_exp then
              self:showProgress(true,score,config.need_exp)
              self.condition_label:setString(TI18N("语言_c_5989"))
           else
              self:showProgress(false) 
              self.condition_label:setString(_string_format(TI18N("语言_c_5990"),nextcfg.need_rank))
           end
        else
           self.condition_label:setString(TI18N("语言_c_5991"))
           self:showProgress(false)
        end
    end
end
 
function ShinobiMainWindow:updateRewardList()
    local reward_list  = Config.ArenaShinobiData.data_shinobi_const["reward_preview"].val
    if reward_list then
		self.item_scrollview:setData(reward_list)
        self.item_scrollview:addEndCallBack(function()
            local list = self.item_scrollview:getItemList()
            for k, v in pairs(list) do
                v:setDefaultTip()
            end
        end)
	end
end

function ShinobiMainWindow:setLessTime(str,star_time,end_time)
    doStopAllActions(self.time_label)
    if end_time~=nil then
        local zero_time = TimeTool.getServerToDayZeroTime()
        local endtime= zero_time+end_time[1]*3600+end_time[2]*60+end_time[3]
        local cur_time = GameNet:getInstance():getTime()
        local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone() -- 服务器时区
        local e_dZoneDiff = (timezone - TimeTool.getTimeZone())*3600
        cur_time = cur_time + e_dZoneDiff
        local left_time=endtime-cur_time
        local time=TimeTool.GetTimeFormatDayIIIIII(left_time)
        local time_str= _string_format(TI18N("<div fontcolor=#ffffff outline=2,#000000>%s</div><div fontcolor=#00ff00 outline=2,#000000>%s</div>"),str,time)
        if left_time > 0 then
            self.time_label:setString(time_str)
            self.time_label:runAction(cc.RepeatForever:create(cc.Sequence:create(cc.DelayTime:create(1), cc.CallFunc:create(function()
                left_time = left_time - 1
                if left_time < 0 then
                    left_time=0
                    doStopAllActions(self.time_label)
                else
                    self.time_label:setString(time_str)
                end
            end))))
        else
            self.time_label:setString(time_str)
        end
    else
         self.time_label:setString(_string_format("<div fontcolor=#ffffff outline=2,#000000>%s</div>",str))
    end
    local len=self.time_label:getContentSize().width
    self.time_panel:setContentSize(cc.size(len+50,self.time_panel:getContentSize().height))
    self.time_label:setPositionX(self.time_panel:getContentSize().width/2)
end

function ShinobiMainWindow:clearRoleItemList( )
    for i, object in ipairs(self.role_items) do
        if object.role_spine ~= nil then
            object.role_spine:DeleteMe()
            object.role_spine = nil
        end
    end
    self.role_items={}
    for i=1,3 do
        self.role_models[i]:removeAllChildren()
    end
end
-- 创建英雄列表
function ShinobiMainWindow:updateRoleItemList( )
    self.maxIndex=_model:getChallengeLen()
	local role_datas = _model:getChallengeRoleData(self.curindex)	
    for i=1,3 do
        self.emptylist[i]:setVisible(i>#role_datas)
    end
	for i,v in ipairs(role_datas) do
		delayRun(self.main_container, i*4/60, function()
			local role_item = self.role_items[i]
            if not role_item then
                role_item = ShinobiRoleItem.new()
                local role_panel = self.role_models[i]
                role_panel:addChild(role_item)
                role_item:setScale(0.9, 0.9)
                role_item:setPosition(cc.p(self.role_panel_size.width/2, 0))
                self.role_items[i] = role_item
            end
            local role_data = role_datas[i]
            if role_data and next(role_data) ~= nil then
            	role_item:setData(role_data)
            	role_item:setVisible(true)
            else
            	role_item:setVisible(false)
            end
        end)
	end
    self.left_btn:setVisible(self.curindex>1)
    self.right_btn:setVisible(self.curindex<self.maxIndex)
    self.maxIndex=math.max(self.maxIndex,1)
    if self.turn_label then
        self.turn_label:setString(_string_format("%s/%s",math.min(self.curindex,self.maxIndex),self.maxIndex))
    end
    self:updateRoleRed()
end

--刷新箭头红点
function ShinobiMainWindow:updateRoleRed()
    local leftred=false 
    local rightred=false
    if self.maxIndex>1 then
        rightred=_model:getChallengRed(self.curindex,false)
        leftred=_model:getChallengRed(self.curindex,true)
    end
    addRedPointToNodeByStatus(self.left_btn,leftred, 0, 5)
    addRedPointToNodeByStatus(self.right_btn,rightred, 0,5)
end

function ShinobiMainWindow:setStatueModel( object )
    if not object or tolua.isnull(object.model) then return end
    local data = object.data
    if data == nil then
        if object.spine ~= nil then
            if object.spine ~= nil then
                object.spine:DeleteMe()
                object.spine = nil
            end
            object.spine_id = nil
        end
        return
    end
    
    if object.spine_id == data.lookid then return end
    
    if object.spine ~= nil then
        object.spine:DeleteMe()
        object.spine = nil
    end
    object.spine_id = data.lookid
    object.spine = BaseRole.new(BaseRole.type.role, data.lookid)
    object.spine:setAnimation(0, PlayerAction.show, true)
    object.spine:setPosition(cc.p(object.size.width * 0.5, 145))
    object.spine:setAnchorPoint(cc.p(0.5, 0))
    object.model:addChild(object.spine)
end

function ShinobiMainWindow:close_callback(  )
    doStopAllActions(self.dec_container)
    doStopAllActions(self.time_label)
    self:clearRoleItemList()
	_controller:openShinobiMainWindow(false)
end