function ShinobiMainWindow:showProgress(status, cur,max)
    if status then
        local persent=(cur/max)*100
        if self.comp_bar == nil then
            local size = cc.size(180, 19)
            local res = PathTool.getResFrame("common_1","common_1_106")
            local res1 = PathTool.getResFrame("common_1","common_1_105")
            local bg,comp_bar = createLoadingBar(res, res1, size, self.main_container, cc.p(0.5,0.5), 125,820, true, true)
            self.comp_bar_bg = bg
            self.comp_bar = comp_bar
            local text=createLabel(20, cc.c4b(255,255,255,255), cc.c4b(0,0,0,255), 90, 10, "120", self.comp_bar_bg, 1, cc.p(0.5, 0.5))
            self.progress_label=text
        else
            self.comp_bar_bg:setVisible(true)
        end
        self.comp_bar:setPercent(persent) 
        self.progress_label:setString(cur.."/"..max)
    else
        if self.comp_bar_bg then
            self.comp_bar_bg:setVisible(false)
        end
    end
end

