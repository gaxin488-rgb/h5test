local _controller = ShinobiController:getInstance()
local _model = _controller:getModel()
local _table_insert = table.insert
local _string_format = string.format

ShinobiMainWindow = ShinobiMainWindow or BaseClass(BaseView)

function ShinobiMainWindow:__init()
    self.is_full_screen = true
    self.layout_name = "shinobi/shinobi_main_window"
    self.win_type = WinType.Full  
    self.res_list = {
        { path = PathTool.getPlistImgForDownLoad("shinobi/shinobi","shinobi"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("common","common_1"), type = ResourcesType.plist },
        { path = PathTool.getPlistImgForDownLoad("shinobi/shinobi_group","shinobi_group"), type = ResourcesType.plist }
    }
    self.statue_list = {}
    self.role_items={}
    self.role_models={}
    self.emptylist={}
    self.open_status = 0
    self.curindex=1
    self.happening_touch = nil --避免玩家不断点击动画的时候
    self.item_pos_x={118,356,600}
    self.item_width=150
    self.offset=5
    self.is_first=true;
end

function ShinobiMainWindow:open_callback(  )
	self.background = self.root_wnd:getChildByName("background")
    self.background:loadTexture(self.background_path, LOADTEXT_TYPE)
    self.background:setScale(display.getMaxScale())

    local main_container = self.root_wnd:getChildByName("container")
    self.main_container = main_container
    self:playEnterAnimatianByObj(main_container, 1)

    local top_panel = main_container:getChildByName("top_panel")
    local label_1=top_panel:getChildByName("label_1")
    local label_2=top_panel:getChildByName("label_2")
    local label_3=top_panel:getChildByName("label_3")
    local label_4=top_panel:getChildByName("label_4")
    label_1:setString(TI18N("语言_c_5258"))
    label_2:setString(TI18N("语言_c_552"))
    label_3:setString(TI18N("语言_c_553"))
    label_4:setString(TI18N("语言_c_5980"))
    local label3_width = label_3:getContentSize().width
    local tips_width = 470 - label3_width - 20
    self.rank_label=top_panel:getChildByName("rank_label")
    self.season_label=top_panel:getChildByName("season_label")
    self.tip_label=top_panel:getChildByName("tip_label")
    setTextMaxWidth(self.tip_label,tips_width)--350
    setItemXOneByOne({label_1,self.rank_label})
    setItemXOneByOne({label_2,self.season_label})
    setItemXOneByOne({label_3,self.tip_label})

    self.reward_layout=top_panel:getChildByName("reward_layout")
    local label_4_width = label_4:getContentSize().width 
    local reward_layer_width = 470 - label_4_width
    if reward_layer_width < 250 then
        self.reward_layout:setContentSize(cc.size(reward_layer_width-30, self.reward_layout:getContentSize().height))
    end
    setItemXOneByOne({label_4,self.reward_layout},20)

    self.team_btn=main_container:getChildByName("team_btn")
    self.bottom_panel=main_container:getChildByName("bottom_panel")
    self.condition_label=main_container:getChildByName("condition_label")
    setTextMaxWidth(self.condition_label,220)
    setTextSpacing(self.condition_label,-10)
    self.rule_btn=self.bottom_panel:getChildByName("rule_btn")
    self.form_btn=self.bottom_panel:getChildByName("form_btn")
    self.shop_btn=self.bottom_panel:getChildByName("shop_btn")
    self.reward_btn=self.bottom_panel:getChildByName("reward_btn")
    self.rank_btn=self.bottom_panel:getChildByName("rank_btn")
    self.record_btn=self.bottom_panel:getChildByName("record_btn")
    self.elite_btn=self.bottom_panel:getChildByName("elite_btn")
    self.left_btn=self.bottom_panel:getChildByName("left_btn")
    self.right_btn=self.bottom_panel:getChildByName("right_btn")
    for i=1,3 do
        local model=self.bottom_panel:getChildByName("model_"..i)
        _table_insert(self.role_models,model)
        if i==1 then
            self.role_panel_size=model:getContentSize()
        end
        local empty=self.bottom_panel:getChildByName("empty_"..i)
        empty:getChildByName("label"):setChangeScaleOffWidth(-10000)
        empty:getChildByName("label"):setString(TI18N("语言_c_526"))
        moveTextBg(empty:getChildByName("label"),empty:getChildByName("image_bg"),10)
        _table_insert(self.emptylist,empty)      
    end
    self.touch_rect = self.bottom_panel:getChildByName("touch_rect")
    self.touch_rect:setTouchEnabled(false)
    self.team_btn:getChildByName("label"):setString(TI18N("语言_c_5981"))
    self.level_img = main_container:getChildByName("level_img")
    self.level_txt_icon = main_container:getChildByName("level_txt_icon")
    self.form_btn:getChildByName("label"):setString(TI18N("语言_c_166"))
    setTextMaxWidth(self.form_btn:getChildByName("label"),91)
    self.record_btn:getChildByName("label"):setString(TI18N("语言_c_2595"))
    local rank_label=self.rank_btn:getChildByName("label")
    rank_label:setString(TI18N("语言_c_271"))
    setTextMaxWidth(rank_label,100)
    setTextSpacing(rank_label,-10)
    local shop_label=self.shop_btn:getChildByName("label")
    shop_label:setString(TI18N("语言_c_5982"))
    setTextMaxWidth(shop_label,100)
    setTextSpacing(shop_label,-10)
    self.reward_btn:getChildByName("label"):setString(TI18N("语言_c_21"))
    self.elite_btn:getChildByName("label"):setString(TI18N("语言_c_3863"))
    -- setTextSpacing(self.shop_btn:getChildByName("label"),-10)
    self.time_panel=self.bottom_panel:getChildByName("time_panel")
    self.no_game_label=self.bottom_panel:getChildByName("no_game_label")
    self.no_game_label:setString(TI18N("语言_c_5984"))
    self.cannotplay_txt = self.bottom_panel:getChildByName("cannotplay_txt")
    self.cannotplay_txt:setString("")
    self.cannotplay_txt:setVisible(false)
    self.time_label = createRichLabel(24,cc.c4b(0xff,0xff,0xff,0xff),cc.p(0.5,0.5),cc.p(140,21),-10,nil,600)
    self.time_panel:addChild(self.time_label)
    local turn_panel=self.bottom_panel:getChildByName("turn_panel")
    self.turn_label=turn_panel:getChildByName("label")
    
    local scroll_view_size = self.reward_layout:getContentSize()
    local setting = {
        item_class = BackPackItem,      -- 单元类
        start_x = 3,                  -- 第一个单元的X起点
        space_x = 10,                    -- x方向的间隔
        start_y = 0,                    -- 第一个单元的Y起点
        space_y = 4,                   -- y方向的间隔
        item_width = BackPackItem.Width*0.5,               -- 单元的尺寸width
        item_height = BackPackItem.Height*0.5,              -- 单元的尺寸height
        row = 1,                        -- 行数，作用于水平滚动类型
        col = 0,                         -- 列数，作用于垂直滚动类型
        scale = 0.5
    }
    self.item_scrollview = CommonScrollViewLayout.new(self.reward_layout, cc.p(0,0) , ScrollViewDir.horizontal, ScrollViewStartPos.top, scroll_view_size, setting)
    self.item_scrollview:setSwallowTouches(false)
    self.close_btn = main_container:getChildByName("close_btn")
    -- 适配
    local top_off = display.getTop(main_container)
	local bottom_off = display.getBottom(main_container)
	-- tab_container:setPositionY(top_off - 174)
	-- self.bottom_panel:setPositionY(bottom_off +300)
    self:addTouchEvent()
end

function ShinobiMainWindow:addTouchEvent()
    local function onTouchBegin(touch, event)
        if self.touch_ticket == nil then
            self.touch_ticket = GlobalTimeTicket:getInstance():add(function()
                self.happening_touch = nil
                if self.touch_ticket ~= nil then
                    GlobalTimeTicket:getInstance():remove(self.touch_ticket)
                    self.touch_ticket = nil
                end
            end, 0.3)
        end
        if self.happening_touch then
            -- message(TI18N("语言_c_1054"))
            return false
        end
        self.happening_touch = true
        self.touch_began = touch:getLocation()
        self.touch_point = nil
        for i=1,3 do
            doStopAllActions(self.role_models[i])
        end
        local status = self:isTouchRect(self.touch_began.x ,self.touch_began.y)
        return status
    end
    local function onTouchMoved(touch, event)
        self.touch_point = touch:getDelta()
        self:setMoveItenPos(self.touch_point.x)
    end
    local function onTouchEnded(touch, event)
        self.touch_end = touch:getLocation()
        local dis = self.touch_end.x - self.touch_began.x
        if math.abs(dis)<self.offset then return end
        if not self.maxIndex or self.maxIndex<2 then return end
        if dis<0 and self.curindex>=self.maxIndex then return end
        if dis>0 and self.curindex<=1 then return end 
        if self.touch_began then
            for i=1,3 do
                self.role_models[i]:setPositionX(self.item_pos_x[i])
            end
        end
        if dis>0 then--滑动的时候
            self:_onClickLeftBtn()
        elseif dis<-0 then--点击的时候
            self:_onClickRightBtn()
        end
    end
    local listener = cc.EventListenerTouchOneByOne:create()
    listener:registerScriptHandler(onTouchBegin,cc.Handler.EVENT_TOUCH_BEGAN)
    listener:registerScriptHandler(onTouchMoved,cc.Handler.EVENT_TOUCH_MOVED)
    listener:registerScriptHandler(onTouchEnded,cc.Handler.EVENT_TOUCH_ENDED)
    self.touch_rect:getEventDispatcher():addEventListenerWithSceneGraphPriority(listener, self.touch_rect)
end

--判断是否在点击区域里面
function ShinobiMainWindow:isTouchRect(x,y)
    local status = false
    local y_ = self.touch_rect:getPositionY()
    local height_ = self.touch_rect:getContentSize().height
    if y >= (y_) and y <= (y_ + height_) then
        status = true
    end
    return status
end

function ShinobiMainWindow:setMoveItenPos(inter_x)
    if math.abs(inter_x)<self.offset then return end
    if not self.maxIndex or self.maxIndex<2 then return end
    if inter_x<0 and self.curindex>=self.maxIndex then return end
    if inter_x>0 and self.curindex<=1 then return end 
    for i=1,3 do
        if self.role_models[i] then
            local item_x = self.role_models[i]:getPositionX() 
            local x = item_x + inter_x
            if x <= (-self.item_width/2) then
                x = x + self.item_pos_x[3] + self.item_width 
            end
            if x > (self.item_pos_x[3] + self.item_width/2) then
                x = x - (self.item_pos_x[3] + self.item_width) 
            end
            self.role_models[i]:setPositionX(x)
        end
    end
end

function ShinobiMainWindow:register_event(  )
    registerButtonEventListener(self.team_btn, handler(self, self._onClickTeamBtn), true)
	registerButtonEventListener(self.rank_btn, handler(self, self._onClickRankBtn), true)
	registerButtonEventListener(self.shop_btn, handler(self, self._onClickShopBtn), true)
	registerButtonEventListener(self.form_btn, handler(self, self._onClickFormBtn), true)
	registerButtonEventListener(self.close_btn, handler(self, self._onClickCloseBtn), true)
	registerButtonEventListener(self.record_btn, handler(self, self._onClickRecordBtn), true)
    registerButtonEventListener(self.elite_btn, handler(self, self._onClickEliteBtn), true)
	registerButtonEventListener(self.reward_btn, handler(self, self._onClickRewardBtn), true)
    registerButtonEventListener(self.rule_btn, function (param,sender, event_type)
        local desc= Config.ArenaShinobiData.data_explain[1].desc
        if desc then
            MainuiController:getInstance():openCommonExplainView(true, Config.ArenaShinobiData.data_explain)
            -- TipsManager:getInstance():showCommonTips(desc, sender:getTouchBeganPosition())
        end
    end, true, 2)
    registerButtonEventListener(self.left_btn, handler(self, self._onClickLeftBtn), true)
    registerButtonEventListener(self.right_btn, handler(self, self._onClickRightBtn), true)

    -- 基础信息
    self:addGlobalEvent(ShinobiEvent.Update_MyBaseInfo_Event, function (  )
        self:setBaseInfo()
    end)

    -- 前三名数据
    self:addGlobalEvent(ShinobiEvent.Update_Challenge_Role_Event, function ( )
        self:clearRoleItemList()
        self:updateRoleItemList()
    end)
       -- 跨服竞技场红点
	self:addGlobalEvent(ShinobiEvent.Update_Red_Status_Event, function (  )
		self:updateRedStatusShow()
	end)
end

function ShinobiMainWindow:_onClickTeamBtn(  )
    if self.myBaseInfo then
        if self.myBaseInfo.status ==1 then
            message(TI18N("语言_c_6028"))
            return 
        elseif self.myBaseInfo.status ==4 or self.myBaseInfo.status ==5 or self.myBaseInfo.group==0 then
            message(TI18N("语言_c_6029"))
            return 
        else
          _controller:openShinobiLevelPanel(true,self.myBaseInfo.group)
        end
    end
end

function ShinobiMainWindow:_onClickRankBtn(  )
	_controller:openShinobiRankWindow(true)
end

function ShinobiMainWindow:_onClickShopBtn(  )
	_controller:openShinobiShopWindow(true)
end

function ShinobiMainWindow:_onClickFormBtn(  )
    HeroController:getInstance():openFormGoFightPanel(true, PartnerConst.Fun_Form.ShinobiDef, {}, HeroConst.FormShowType.eFormSave)
end

function ShinobiMainWindow:_onClickCloseBtn(  )
	_controller:openShinobiMainWindow(false)
end

function ShinobiMainWindow:_onClickEliteBtn(  )
    MainuiController:getInstance():openCommonExplainView(true, Config.ArenaShinobiData.data_explain2)
end

function ShinobiMainWindow:_onClickRecordBtn(  )
    _controller:openShinobiLogWindow(true)
end

--左
function ShinobiMainWindow:_onClickLeftBtn()
    if self.curindex<=1 then return end
    self.curindex=self.curindex-1
    self:updateRoleItemList()
end
--右
function ShinobiMainWindow:_onClickRightBtn()
    if self.curindex>=self.maxIndex then return end
    self.curindex=self.curindex+1
    self:updateRoleItemList()
end

function ShinobiMainWindow:_onClickRewardBtn(  )
    _controller:openShinobiAwardWindow(true)
end

function ShinobiMainWindow:openRootWnd(  )
    self.curindex=1
    self.is_first=true
    self.left_btn:setVisible(false)
    self.right_btn:setVisible(false) 
    _controller:sender14400()
    self:updateRedStatusShow()
end

function ShinobiMainWindow:setBaseInfo(  )
    local base_info = _model:getShinobiMyBaseInfo()
    -- print(vardump(base_info))
    if not base_info then return end
    self.myBaseInfo=base_info
    self.open_status = base_info.status or 0
    if base_info.group>0 and self.is_first then
        _controller:sender14401()
        self.is_first=false
    else
        if self.turn_label then
            self.turn_label:setString(_string_format("%s/%s",1,1))
        end
        local maxIndex=_model:getChallengeLen()
        if maxIndex > 0 then
            self.maxIndex = maxIndex
            self.left_btn:setVisible(self.curindex>1)
            self.right_btn:setVisible(self.curindex<self.maxIndex)
            self.maxIndex=math.max(self.maxIndex,1)
            if self.turn_label then
                self.turn_label:setString(_string_format("%s/%s",math.min(self.curindex,self.maxIndex),self.maxIndex))
            end
        end
    end
    if not base_info.rank or base_info.rank == 0 then
		self.rank_label:setString(TI18N("语言_c_273"))
	else
		self.rank_label:setString(base_info.rank)
	end
    self:SetTimeVal(self.myBaseInfo.status)
    local start_str = TimeTool.getMD(base_info.start_time)
    local end_str = TimeTool.getMD(base_info.end_time)
	self.season_label:setString(start_str.."-"..end_str)
    self.tip_label:setTouchEnabled(true)
    self.tip_label:setString(transformTextToShort(TI18N("语言_c_5983"),70))
    -- addEvt2showAllTextTips(self.tip_label,TI18N("语言_c_5983"),70)
    local temp_height = self.tip_label:getContentSize().height
    if temp_height>58 then
        self.tip_label:setString(transformTextToShort(TI18N("语言_c_5983"),45))
        addEvt2showAllTextTips(self.tip_label,TI18N("语言_c_5983"),45)
    else
        self.tip_label:setString(transformTextToShort(TI18N("语言_c_5983"),70))
        addEvt2showAllTextTips(self.tip_label,TI18N("语言_c_5983"),70)
    end

    self:updateRewardList()
    self:updateDanInfo()
end

function ShinobiMainWindow:SetTimeVal(status)
    local str=""
    local star_time=nil
    local end_time=nil
    local cfg=Config.ArenaShinobiData.data_shinobi_const
    local is_enough = 0
    if self.myBaseInfo and self.myBaseInfo.group then
        is_enough = self.myBaseInfo.group
    end
    self.no_game_label:setVisible(is_enough == 0)--self.myBaseInfo.group==0
    if self.cannotplay_txt then
        self.cannotplay_txt:setString("")
        self.cannotplay_txt:setVisible(false)
    end
    if status==0 then
       str=TI18N("语言_c_5984")
    elseif status==1 then
       str=TI18N("语言_c_5985")
       star_time= cfg.group_time.val 
       end_time=  cfg.match_time.val 
       self.no_game_label:setVisible(false)
    elseif status==2 then
        str=TI18N("语言_c_5986")
        star_time= cfg.match_time.val 
        end_time=  cfg.contest_start_time.val 
    elseif status==3 then
        str=TI18N("语言_c_5987")
        star_time= cfg.contest_start_time.val 
        end_time=  cfg.contest_end_time.val 
    elseif status==6 then
        if self.cannotplay_txt then
            self.cannotplay_txt:setString(TI18N("语言_c_6284"))
            self.cannotplay_txt:setVisible(true)
        end
        self.no_game_label:setVisible(false)
    else
        str=TI18N("语言_c_5988")
    end
    if status~=0 then
       self:setLessTime(str,star_time,end_time)
    end
end

