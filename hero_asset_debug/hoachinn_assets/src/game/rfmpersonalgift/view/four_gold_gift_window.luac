FourGoldGiftWindow = FourGoldGiftWindow or BaseClass(BaseView)
local rfm_controller = RfmPersonnalGiftController:getInstance()
local controller = ActionController:getInstance()
local model = controller:getModel()
function FourGoldGiftWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.TOP_TAG
    self.layout_name = "rfmpersonalgift/four_gold_gift_window"
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("holiday_special_recruit", "holiday_special_recruit"), type = ResourcesType.plist},
    }
end

function FourGoldGiftWindow:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())

    self.main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(self.main_container , 2)
    self.spine_node = self.main_container:getChildByName("spine_node")
    self.bg_img = self.main_container:getChildByName("bg_img")
    self.title_img = self.main_container:getChildByName("title_img")
    self.tip_img = self.main_container:getChildByName("tip_img")
    self.btn_close = self.main_container:getChildByName("btn_close")
    self.item_scroll = self.main_container:getChildByName("item_scroll")
    self.label_time_key = self.main_container:getChildByName("label_time_key")
    self.label_time_key:setString(TI18N("语言_c_1242"))
    self.label_time = self.main_container:getChildByName("label_time")
    if self.task_view == nil then
        local scroll_view_size = self.item_scroll:getContentSize()
        local setting = {
            item_class = FourGoldGiftItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 3,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 626,               -- 单元的尺寸width
            item_height = 118,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1            
        }
        self.task_view = CommonScrollViewLayout.new(self.item_scroll, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
end

function FourGoldGiftWindow:openRootWnd()
    self.holiday_bid = ActionRankCommonType.fourGold
    controller:cs16603(self.holiday_bid)
    local list = controller:getActionSubTabVo(self.holiday_bid)
    if list and list.reward_title then
        local img_list = string.split(list.reward_title,",")
        local res = PathTool.getResFrame("holiday_special_recruit",img_list[1])
        loadSpriteTexture(self.bg_img, res, LOADTEXT_TYPE_PLIST)
        local res = PathTool.getTargetRes("bigbg/action",img_list[2],false,false)
        loadSpriteTexture(self.title_img, res, LOADTEXT_TYPE)
        if img_list[4] then
            if not self.role1 then
                self.role1 = createSprite(PathTool.getTargetRes("bigbg/action",img_list[4],false,false),0,763,self.spine_node,cc.p(0.5,0.5),LOADTEXT_TYPE)
            end
        end
    end
    local act_time = list and list.remain_sec or 0
    controller:getModel():setCountDownTime(self.label_time,act_time)
    self.label_time_key:setPositionX((600-self.label_time_key:getContentSize().width - self.label_time:getContentSize().width)*0.5)
    self.label_time:setPositionX(self.label_time_key:getPositionX() + self.label_time_key:getContentSize().width +5)
end
function FourGoldGiftWindow:register_event()
    registerButtonEventListener(self.btn_close, function() rfm_controller:openFourGoldGiftWindow(false) end, false, 2)
    self:addGlobalEvent(ActionEvent.UPDATE_HOLIDAY_SIGNLE, function(data)
        if data.bid == self.holiday_bid then
            self:setData(data)
        end
    end)
end
function FourGoldGiftWindow:setData(data)
    local item_list = {}
    for k, v in pairs(data.aim_list) do
        local list = {}
        list.charge_id = v.aim
        list.sort = keyfind('aim_args_key', 39, v.aim_args).aim_args_val
        list.limit_count = keyfind('aim_args_key', 2, v.aim_args).aim_args_val
        list.buy_count = keyfind('aim_args_key', 6, v.aim_args).aim_args_val
        list.status = list.buy_count >= list.limit_count and 2 or 1
        list.buy_items = {}
        list.deliver_items = {}
        local _num = 0
        for i = 1, tableLen(v.item_list) do
            _num = math.max(_num,v.item_list[i].num)
        end
        for i = 1, tableLen(v.item_list) do
            local _list = {v.item_list[i].bid,v.item_list[i].num}
            if v.item_list[i].num == _num and not next(list.deliver_items) then
                list.deliver_items=_list
            else
                table.insert(list.buy_items,_list)
            end
        end
        table.insert(item_list, list)
    end
    local sort_func = SortTools.tableCommonSorter({{"status", false},{"sort",false}})--{"id", false}
    table.sort(item_list, sort_func)
    self.task_view:setData(item_list)
end

function FourGoldGiftWindow:close_callback()
	if self.task_view then
		self.task_view:DeleteMe()
		self.task_view = nil
	end
    rfm_controller:openRfmPersonalGiftView(false)
end

--子项
FourGoldGiftItem = class("FourGoldGiftItem", function()
    return ccui.Widget:create()
end)

function FourGoldGiftItem:ctor()
    self.goods_list = {}
    self:configUI()
    self:register_event()
end

function FourGoldGiftItem:configUI( )
    self.root_wnd = createCSBNote(PathTool.getTargetCSB("rfmpersonalgift/four_gold_gift_item"))
    self:setAnchorPoint(cc.p(0, 1))
    self:addChild(self.root_wnd)
	self:setCascadeOpacityEnabled(true)
	self:setContentSize(cc.size(626,118))
	self:setTouchEnabled(true)
	self.main_container = self.root_wnd:getChildByName("main_container")
    self.buy_scroll = self.main_container:getChildByName("buy_scroll")
    self.buy_scroll:setScrollBarEnabled(false)
    self.buy_scroll:setSwallowTouches(false)
	self.tip_txt = self.main_container:getChildByName("tip_txt")
	self.tip_img = self.main_container:getChildByName("tip_img")
	self.btn = self.main_container:getChildByName("btn")
	self.btn_txt = self.btn:getChildByName("label")
    self.btn_txt:setString(TI18N("语言_c_8"))
    self.give_img = createSprite(PathTool.getItemRes(3),235,60,self.main_container,cc.p(0.5,0.5),LOADTEXT_TYPE)
    self.give_img:setScale(0.8)
    self.give_num = CommonNum.new(23, self.main_container, 99999, - 2, cc.p(0, 0.5), 4)
    self.give_num:setPosition(280, 70)
    self.give_num:setScale(0.9)
    self.give_img:setVisible(false)
    self.give_num:setVisible(false)
end

function FourGoldGiftItem:setData( data)
    if not data or next(data) == nil then return end
    self.data = data

    if self.data.status == 1 then --未购买
        self.btn:setVisible(true)
        self.tip_img:setVisible(false)
        self.tip_txt:setVisible(true)
        local charge_data = Config.ChargeData.data_charge_data
        if charge_data[self.data.charge_id] then
            local pay_value = GetMoneyNum(charge_data[self.data.charge_id],"val")
            self.btn_txt:setString(string.format(TI18N("语言_c_4440"),pay_value))
        end
        self.tip_txt:setString(TI18N("语言_c_359")..self.data.buy_count.."/"..self.data.limit_count)
    elseif self.data.status == 2 then --已购买
        self.btn:setVisible(false)
        self.tip_img:setVisible(true)
        self.tip_txt:setVisible(false)
    end

    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    local setting = {}
    setting.scale = 0.75
    setting.space_x = 2
    setting.max_count = 1
    setting.is_center = false
    -- setting.is_get_status = self.data.finish and self.data.finish > 1
    -- setting.get_status_res = PathTool.getResFrame("get_ninja","txt_cn_get_ninja_lingqu")
    self.item_list1 = commonShowSingleRowItemList(self.buy_scroll, self.item_list1, self.data.buy_items, setting)
    
    local item_cfg = Config.ItemData.data_get_data(self.data.deliver_items[1])
    loadSpriteTexture(self.give_img,PathTool.getItemRes(item_cfg.icon),LOADTEXT_TYPE)
    self.give_img:setVisible(true)
    self.give_num:setNum("x"..self.data.deliver_items[2])
    self.give_num:setVisible(true)
end

function FourGoldGiftItem:register_event( )
    registerButtonEventListener(self.btn, function()
        if self.data.charge_id then
            ActionController:getInstance():sender21016(self.data.charge_id)
        end
    end,true, 1)
    if not self.charge_data_event then
        self.charge_data_event = GlobalEvent:getInstance():Bind(ActionEvent.Is_Charge_Event, function(data)
            if data and data.status and data.charge_id and data.charge_id == self.data.charge_id then
                local charge_config = Config.ChargeData.data_charge_data[data.charge_id]
                if charge_config and data.status == 1 and data.charge_id == self.data.charge_id then
                    sdkOnPay(charge_config.val, 1, charge_config.id, charge_config.name, charge_config.name)
                end
            end
        end)
    end
end

function FourGoldGiftItem:DeleteMe()
    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.give_num then
        self.give_num:DeleteMe()
    end
    self.give_num = nil
    if self.charge_data_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.charge_data_event)
        self.charge_data_event = nil
    end
end