['语言_hom_03_5']='Chủ đề mùa hè mát mẻ',
['语言_hom_03_d_1']='Hoa anh đào quê hương lại nở rồi!',
['语言_hom_03_d_2']='Đồ nội thất tông màu hồng có thể khơi dậy trái tim cô gái của bạn không?',
['语言_hom_03_d_3']='Nội thất gỗ dường như đưa con người vào thiên nhiên.',
['语言_hom_03_d_4']='Tìm được cảm giác đi nghỉ lễ.',
['语言_hom_03_d_5']='Mang lại cho bạn sự mát mẻ trong mùa hè nóng nực.',
['语言_hom_05_1']='Bộ 3 mảnh hoa anh đào',
['语言_hom_05_2']='Bộ 6 mảnh hoa anh đào',
['语言_hom_05_3']='Bộ 9 mảnh hoa anh đào',
['语言_hom_05_4']='Bộ 12 mảnh hoa anh đào',
['语言_hom_05_5']='Bộ 3 mảnh Meow Meow',
['语言_hom_05_6']='Bộ 6 mảnh Meow Meow',
['语言_hom_05_7']='Bộ 9 mảnh Meow Meow',
['语言_hom_05_8']='Bộ 12 mảnh Meow Meow',
['语言_hom_05_9']='Bộ 3 mảnh Khởi Nguyên',
['语言_hom_05_10']='Bộ 6 mảnh Khởi Nguyên',
['语言_hom_05_11']='Bộ 9 mảnh Khởi Nguyên',
['语言_hom_05_12']='Bộ 12 mảnh Khởi Nguyên',
