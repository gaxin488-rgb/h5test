['语言_ski_ot_pa_d_30132']='Giảm 4% chỉ số Tấn công (ATK) của đơn vị mang hiệu ứng này. Kéo dài 1 lượt, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_d_30134']='Giảm 5% chỉ số Tấn công (ATK) của đơn vị mang hiệu ứng này. Kéo dài 1 lượt, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_d_30136']='Giảm 6% chỉ số Tấn công (ATK) của đơn vị mang hiệu ứng này. Kéo dài 1 lượt, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_d_30138']='Giảm 10% chỉ số Tấn công (ATK) của đơn vị mang hiệu ứng này. Kéo dài 2 lượt, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_30151']='Steal DEF',
['语言_ski_ot_pa_30152']='DEF↓',
['语言_ski_ot_pa_d_30151']='Cướp chỉ số Phòng thủ (DEF) từ đối thủ. Giảm 10% DEF của đối thủ, và chỉ số DEF bị cướp sẽ được cộng thêm cho bản thân. Kéo dài 2 lượt, tối đa 6 lớp, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_d_30152']='Giảm 10% chỉ số Phòng thủ (DEF) của đơn vị mang hiệu ứng này. Kéo dài 2 lượt, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_30141']='Steal SPD',
['语言_ski_ot_pa_30142']='SPD↓',
['语言_ski_ot_pa_d_30141']='Cướp chỉ số Tốc độ (SPD) từ đối thủ. Giảm 10% SPD của đối thủ, và chỉ số SPD bị cướp sẽ được cộng thêm cho bản thân. Kéo dài 3 lượt, có thể tích lũy, không thể bị gỡ bỏ.',
['语言_ski_ot_pa_d_30142']='Giảm 10% chỉ số Tốc độ (SPD) của đơn vị mang hiệu ứng này. Kéo dài 3 lượt, không thể bị gỡ bỏ.',

['语言_ski_ot_pa_30143']='Chậm Chạp',
['语言_ski_ot_pa_d_30143']='Đơn vị mang hiệu ứng này giảm 5% chỉ số Tốc độ (SPD) của đơn vị mang hiệu ứng này. Cộng dồn nhiều nhất 10 tầng, Kéo dài 3 lượt, không thể bị gỡ bỏ.',

