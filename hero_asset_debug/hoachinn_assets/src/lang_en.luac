['语言_ite_16_d_121']='Khi tấn công có 36% xác suất giảm hiệu quả trị liệu 30%, duy trì trong 3 hiệp',
['语言_ite_16_d_122']='Mục tiêu bị tấn công có 30% xác suất không thể hồi sinh trong 4 hiệp; sát thương đối với chuyển sinh bảo mệnh tăng 16%',
['语言_ite_16_d_123']='Khi tấn công có 30% xác suất tẩy phép bổ trợ trên mục tiêu',
['语言_ite_16_d_124']='Sát thương vượt quá 26% sinh mệnh mục tiêu có 40% xác suất làm choáng mục tiêu trong 2 hiệp',
['语言_ite_16_d_125']='Khi tấn công có 12% xác suất khống chế mục tiêu tự tấn công vào bản thân, duy trì trong 1 hiệp',
['语言_ite_16_d_126']='Khi tấn công có 40% xác suất giảm 10% tốc độ mục tiêu, duy trì trong 2 hiệp',
['语言_ite_16_d_127']='Khi chết có 50% xác suất tăng 30% tấn công toàn bộ đồng đội, duy trì trong 2 hiệp',
['语言_ite_16_d_128']='Tăng né tránh 14%; khi chịu tấn công bởi đơn vị dùng bí thuật thần lực hoặc nhẫn thuật sẽ giảm 15% sát thương',
['语言_ite_16_d_129']='Sát thương tăng 25% đối với mục tiêu có sinh cơ hoặc tái sinh',
['语言_ite_16_d_130']='Đánh trúng tăng 14%; sát thương tăng 15% đối với mục tiêu có né tránh hoặc tăng tốc',
['语言_ite_16_d_131']='Khi bắt đầu hiệp đấu có 60% xác suất loại trừ tất cả trạng thái tiêu cực trên bản thân',
['语言_ite_16_d_132']='Hiệu quả đề kháng tăng 20%, hiệu quả đề kháng càng cao thì xác suất kháng khống chế thành công càng cao',
['语言_ite_16_d_133']='Khi bắt đầu hiệp đấu hồi phục 6% giới hạn trên lượng sinh mệnh',
['语言_ite_16_d_134']='Khí chết có 60% xác suất hồi sinh lượng nhỏ sinh mệnh ',
['语言_ite_16_d_135']='Khí chết có 16% xác suất hồi sinh 50% lượng sinh mệnh ',
['语言_ite_16_d_136']='Giảm 20% xác suất chịu bạo kích',
['语言_ite_16_d_137']='Chịu sát thương nhẫn thuật giảm 15%',
['语言_ite_16_d_138']='Chịu sát thương thể thuật giảm 15%',
['语言_ite_16_d_139']='Hiệu quả trị liệu và được trị liệu của Ninja tăng 15%',
['语言_ite_16_d_140']='Tốc độ giảm 10%, sinh mệnh tăng 15%',
['语言_ite_16_d_141']='Sát thương bỏ qua 30% đỡ đòn của mục tiêu',
['语言_ite_16_d_142']='Đánh trúng tăng 11%, bạo kích giảm 10%',
['语言_ite_16_d_143']='Tấn công nhẫn thuật có 40% xác suất kích hoạt liên kích, khi thi triển kỹ lần thứ 2 thì sát thương, khống chế, hồi phục bằng 50% lần đầu',
['语言_ite_16_d_144']='Khi bắt đầu chiến đấu, giảm thương tăng 30% trong 2 hiệp đầu',
['语言_ite_16_d_145']='Tấn công thể thuật có 40% xác suất kích hoạt liên kích, khi thi triển kỹ lần thứ 2 thì sát thương, khống chế, hồi phục bằng 50% lần đầu',
['语言_ite_16_d_146']='Sử dụng kỹ năng sát thương thể thuật, dùng 30% lượng sát thương hồi phục sinh mệnh của người tấn công',
['语言_ite_16_d_147']='Khi bị tấn công bởi đơn vị có cuồng bạo, đánh chùm hoặc liên pháp, lượng sát thương phải chịu giảm 30%',
['语言_ite_16_d_148']='Khi bắt đầu chiến đấu, dùng 12% lượng máu để hộ thuẫn cho tất cả đồng đội, duy trì trong 2 hiệu, hiệu ứng này không thể cộng dồn',
['语言_ite_16_d_149']='Khi sử dụng kỹ năng trị liệu hoặc hồi sinh có 40% xác suất giải trừ trạng thái tiêu cực của 1 đồng đội ngẫu nhiên',
['语言_ite_16_d_150']='Khi chịu sát thương có 45% xác suất phản 40% sát thương',
['语言_ite_16_d_151']='Khi bắt đầu chiến đấu, sát thương vật lý tăng 20%, duy trì trong 2 hiệp, hiệu ứng này không thể bị giải trừ',
['语言_ite_16_d_152']='Khi bắt đầu chiến đấu, sát thương nhẫn thuật tăng 20%, duy trì trong 2 hiệp, hiệu ứng này không thể bị giải trừ',
['语言_ite_16_d_153']='Khi tạo ra sát thương nhẫn thuật, lượng sát thương biến động trong khoảng 100 đến 120%',
['语言_ite_16_d_154']='Tấn công tăng 6%, khi chịu sát thương lớn hơn 40% giới hạn sinh mệnh  có 30% xác suất giảm thương 50%',
['语言_ite_16_d_155']='Sau khi chết được trị liệu bên ngoài, hiệp đấu sau có 15% xác suất quay trở lại chiến trường với 25% lượng sinh mệnh, sau mỗi hiệp xác suất hồi sinh tăng 5%, sau 5 hiệp chắc chắn hồi sinh, mỗi trận đấu chỉ có hiệu lực 1 lần',
['语言_ite_16_d_156']='Sát thương tăng 20% đối với đơn vị có [linh niệm], nếu tiêu diệt đơn vị thì không thể kích hoạt hiệu ứng [linh niệm]',
['语言_ite_16_d_157']='Sử dụng kỹ năng sát thương nhẫn, dùng 20% lượng sát thương hồi phục sinh mệnh của người tấn công',
['语言_ite_16_d_158']='Sát thương tăng 15% đối với đơn vị có [hộ thuẫn], ngoài ra 50% lượng sát thương vô hiệu với hiệu ứng hộ thuẫn',
['语言_ite_16_d_159']='Khi không thể di chuyển trong hiệp đấu, lần thi triển kỹ năng tấn công sau sát thương tăng thêm 25% (có thể cộng dồn, không thể bị tẩy phép, bị loại bỏ sau mỗi lần thi triển kỹ năng)',
['语言_ite_16_d_160']='Vô hiệu tất cả các hiệu ứng giảm tốc, khi bắt đầu mỗi hiệp đấu, với thêm mỗi Ninja đồng đội cùng hệ có thể tăng tốc độ bản thân lần lượt lên 75%, 10%, 13%, 15% (không thể kết hợp với [tăng tốc], ưu tiên hiệu ứng)',
['语言_ite_16_d_161']='Khi tấn công khiến cho mục tiêu chịu thêm sát thương bằng 7% sinh mệnh (không vượt quá 30% lượng sát thương phải chịu từ kỹ năng)',
['语言_ite_16_d_162']='Khi sinh mệnh bản thân lớn hơn 50%, giảm sát thương vật lí 12%; khi sinh mệnh nhỏ hơn 50%, tăng trị liệu 20%',
['语言_ite_16_d_163']='Khi đồng đội chịu sát thương bị tiêu diệt, dùng 15% sinh mệnh bản thân bảo vệ đồng đội, nếu lượng máu bản thân nhỏ hơn 30% sẽ không thể kích hoạt, thời gian hồi chiêu 4 hiệp',
['语言_ite_16_d_164']='Khi sử dụng kỹ năng chủ động bổ trợ, có 30% xác suất duy trì bổ trợ thêm 1 hiệp, thời gian hồi chiêu 2 hiệp; khi sử dụng kỹ năng giảm bổ trợ có 10% khả năng kích hoạt hiệu ứng',
['语言_ite_16_d_165']='Khi sử dụng kỹ năng chủ động trị liệu, đối với đồng đội có sinh mệnh nhỏ hơn 30% sẽ giúp họ nhận được hiệu ứng trị liệu bằng 30% (cố định) lượng sinh mệnh đã mất',
['语言_ite_16_d_166']='Tăng DMG nghệ thuật +18%. ATK +420',
['语言_ite_16_d_167']='Tăng DMG Taijutsu +18%. ATK +420',
['语言_ite_16_d_168']='100% cơ hội tấn công cơ bản thêm một lần khi đối thủ bị giết bởi kỹ năng Taijutsu',
['语言_ite_16_d_169']='100% cơ hội tấn công cơ bản thêm một lần khi kỹ năng Taijutsu gây CRIT',
['语言_ite_16_d_170']='Tăng Crit DMG +36%',
['语言_ite_16_d_171']='Tăng Crit Rate +20%',
['语言_ite_16_d_172']='Tăng DMG +0,35% cho mỗi 1% HP giảm',
['语言_ite_16_d_173']='Tăng SPD +20%+40',
['语言_ite_16_d_174']='Tránh +30% sau khi hồi sinh trong 2 lượt',
['语言_ite_16_d_175']='Tăng ATK +36% sau khi hồi sinh trong 2 lượt',
['语言_ite_16_d_176']='40% cơ hội giảm [Chữa Lành] và [Hồi Phục] của đối thủ xuống 36% trong 3 lượt',
['语言_ite_16_d_177']='36% cơ hội ngăn không cho đối thủ hồi sinh trong 4 lượt; +18% DMG chống lại đối thủ dưới hiệu ứng Blessing hoặc Respawn',
['语言_ite_16_d_178']='36% cơ hội xóa tất cả các buff của đối thủ khi tấn công',
['语言_ite_16_d_179']='50% cơ hội [Choáng] một đối thủ trong 2 lượt khi DMG gây ra vượt quá 26% HP tối đa của đối thủ',
['语言_ite_16_d_180']='15% cơ hội buộc mục tiêu tấn công cơ bản vào bản thân trong 1 lượt',
['语言_ite_16_d_181']='40% cơ hội giảm SPD của mục tiêu xuống 15% trong 2 lượt khi tấn công',
['语言_ite_16_d_182']='60% cơ hội tăng ATK của tất cả đồng minh lên 30% khi bị giết',
['语言_ite_16_d_183']='Tránh +17%; nhận 30% ít DMG hơn từ đối thủ dưới hiệu ứng Assault hoặc Ninjutsu',
['语言_ite_16_d_184']='DMG +30% chống lại đối thủ dưới hiệu ứng Lifebloom hoặc Restoration',
['语言_ite_16_d_185']='HIT +18%; DMG +18% chống lại đối thủ dưới hiệu ứng Dodge hoặc Swift',
['语言_ite_16_d_186']='70% cơ hội xóa tất cả các hiệu ứng tiêu cực vào đầu lượt của bạn',
['语言_ite_16_d_187']='Kháng hiệu ứng Kỹ năng +22%; kháng hiệu ứng cao hơn có nghĩa là khả năng kháng CC lớn hơn. Khi bản thân đang bị ảnh hưởng bởi CC, hồi phục HP bằng 5% HP tối đa của bản thân (1 lần trong mỗi lượt)',
['语言_ite_16_d_188']='Hồi phục HP cho 7,2% HP tối đa vào đầu lượt của bạn',
['语言_ite_16_d_189']='60% cơ hội hồi sinh khi bị giết, hồi phục một ít HP và tăng ATK của bản thân lên 10% (1 lượt, không thể bị Xóa)',
['语言_ite_16_d_190']='18% cơ hội hồi sinh khi bị giết, hồi phục 55% HP',
['语言_ite_16_d_191']='Giảm 23% cơ hội bị Crit. Giảm DMG cuối cùng -10% khi nhận DMG Critical',
['语言_ite_16_d_192']='Giảm A.DMG -18%',
['语言_ite_16_d_193']='Giảm 18% DMG Taijutsu nhận được',
['语言_ite_16_d_194']='Tăng 18% Healing và Recovery',
['语言_ite_16_d_195']='Giảm SPD -10%; tăng HP +20%',
['语言_ite_16_d_196']='Bỏ qua 33% DEF của mục tiêu. Tăng 8% DMG chống lại mục tiêu Tank và Support',
['语言_ite_16_d_197']='Kháng CC +14%, Crit Rate -10%.',
['语言_ite_16_d_198']='48% cơ hội khi đánh trúng để thực hiện thêm một kỹ năng trong các kỹ năng Ninjutsu, gây 50% DMG gốc và hiệu ứng CC với cùng kỹ năng',
['语言_ite_16_d_199']='+30% GIẢM DMG trong 3 lượt đầu tiên khi trận chiến bắt đầu',
['语言_ite_16_d_200']='48% cơ hội khi đánh trúng để thực hiện thêm một đòn trong các kỹ năng Taijutsu, gây 50% DMG gốc và hiệu ứng CC với cùng kỹ năng',
['语言_ite_16_d_201']='Hồi phục cho người tấn công 33% DMG gây ra từ kỹ năng Taijutsu',
['语言_ite_16_d_202']='48% cơ hội khi đánh trúng để thực hiện thêm một kỹ năng trong các kỹ năng Ninjutsu, gây 50% DMG gốc và hiệu ứng CC với cùng kỹ năng',
['语言_ite_16_d_203']='+30% GIẢM DMG trong 3 lượt đầu tiên khi trận chiến bắt đầu',
['语言_ite_16_d_204']='48% cơ hội khi đánh trúng để thực hiện thêm một đòn trong các kỹ năng Taijutsu, gây 50% DMG gốc và hiệu ứng CC với cùng kỹ năng',
['语言_ite_16_d_205']='Hồi phục cho người tấn công 33% DMG gây ra từ kỹ năng Taijutsu',
['语言_ite_16_d_206']='Giảm 35% DMG nhận được chống lại đối thủ dưới hiệu ứng Berserk/Taijutsu Combo/Ninjutsu Combo',
['语言_ite_16_d_207']='Thêm một [Barrier] cho tất cả đồng minh khi trận chiến bắt đầu, hấp thụ DMG bằng 15% HP tối đa của Ninja trong 2 lượt',
['语言_ite_16_d_208']='45% cơ hội xóa tất cả các hiệu ứng tiêu cực từ một đồng minh ngẫu nhiên trong khi chữa trị hoặc hồi sinh',
['语言_ite_16_d_209']='Tăng ATK +8%. 35% cơ hội giảm thiệt hại nhận được xuống 50% nếu vượt quá 40% HP tối đa',
['语言_ite_16_d_210']='Rời khỏi trận chiến nếu bị hạ gục, và 18% cơ hội trở lại trận chiến với 30% HP hồi phục trong lượt tiếp theo. Mỗi lượt qua đi, tăng cơ hội hồi sinh lên 5%. Chắc chắn hồi sinh sau 5 lượt. Kỹ năng chỉ có hiệu lực 1 lần trong mỗi trận chiến.',
['语言_ite_16_d_211']='Tăng ATK +5%. Gây thêm 36% DMG lên mục tiêu có hiệu ứng [Spirit]. [Spirit] sẽ không có hiệu lực nếu mục tiêu bị hạ gục',
['语言_ite_16_d_212']='DMG dao động từ 110% - 125% cho mỗi đòn tấn công của các ninja tầm xa.',
['语言_ite_16_d_213']='Gây thêm 25% DMG lên mục tiêu có hiệu ứng [Barrier], và 65% DMG của bạn sẽ bỏ qua [Barrier]',
['语言_ite_16_d_214']='Nếu không thể thực hiện hành động trong lượt này do hiệu ứng kỹ năng, tăng 40% DMG cho kỹ năng tiếp theo. (Có thể chồng chất và không thể bị Xóa. Nó bị xóa sau khi thực hiện kỹ năng tấn công)',
['语言_ite_16_d_215']='Bỏ qua bất kỳ loại hiệu ứng SPD↓ nào. Vào đầu mỗi lượt, cải thiện SPD của bản thân theo thứ tự 12%/15%/19%/25% cho mỗi ninja cùng yếu tố tồn tại. (Không tồn tại cùng với [Swift]. Kỹ năng này có hiệu lực ưu tiên)',
['语言_ite_16_d_216']='Mục tiêu nhận thêm [HP tối đa của chúng * 10%] DMG. (Không vượt quá 30% DMG kỹ năng nhận được)',
['语言_ite_16_d_217']='Giảm T.DMG nhận được xuống 18% khi HP trên 50%, nhận 30% hiệu ứng Healing khi HP dưới 50%',
['语言_ite_16_d_218']='Nếu một đồng minh có thể bị hạ gục do thiệt hại chí mạng, nhập 20% HP của bản thân để Bảo vệ nó. Kỹ năng sẽ không được kích hoạt nếu chỉ còn 25% HP hoặc thấp hơn. Thời gian hồi chiêu: 4 lượt.',
['语言_ite_16_d_219']='Khi sử dụng kỹ năng buffing chủ động, 40% cơ hội kéo dài hiệu ứng buff thêm 1 lượt. Thời gian hồi chiêu: 2 lượt. Khi sử dụng kỹ năng debuffing, thành công CC +15%',
['语言_ite_16_d_220']='Khi sử dụng kỹ năng Healing chủ động, đồng minh có HP thấp hơn 40% sẽ nhận thêm 40% * tỷ lệ HP bị mất để hồi phục',																																	 
