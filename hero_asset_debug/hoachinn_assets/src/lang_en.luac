['语言_c_3633']='Thu thập điểm màn để nhận',
['语言_c_3634']='<div fontcolor=#7c5536 >Mở khóa Lệnh Tàn Tích và kích hoạt </div><div fontcolor=#0DFD00 > Cấp 5</div><div fontcolor=#7c5536 > phần thưởng nhanh chóng!</div>',
