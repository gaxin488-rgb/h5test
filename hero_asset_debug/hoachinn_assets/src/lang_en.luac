['语言_shi_02_19']='Hộ tống đồ cổ',
['语言_shi_02_20']='Lễ Konoha',
['语言_shi_02_21']='Cứu nạn nhân',
['语言_shi_05_1']='Có Ninja 1 sao x1',
['语言_shi_05_2']='Có Ninja 2 sao x1',
['语言_shi_05_3']='Có Ninja 3 sao x1',
['语言_shi_05_4']='Có Ninja 4 sao x1',
['语言_shi_05_5']='Có Ninja 5 sao x1',
['语言_shi_05_6']='Có Ninja 6 sao x1',
