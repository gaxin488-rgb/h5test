['语言_s_3086']='Ω4494',
['语言_s_3087']='Tháp Ninja Tầng %s',
['语言_s_3088']='Vượt %s để mở khóa',
['语言_s_3089']='Thời gian thưởng gấp đôi %s đã bắt đầu (%s-%s). Hãy tận dụng nó!',
['语言_s_3090']='%s đã tìm thấy %s trong rương BOSS Thí Luyện Gia Tộc!',
['语言_s_3091']=' Tốc chiến BOSS Gia Tộc và gây tổng %s sát thương',
['语言_s_3092']='Boss %s Sinh mệnh là 0',
['语言_s_3093']='Chiến thắng! %s đã tiêu diệt BOSS %s. EXP Gia Tộc +%s. Hãy đến nhận rương của bạn!',
['语言_s_3094']='Tấn công BOSS Thí Luyện Gia Tộc của Chương %s %s lần, gây sát thương %s tổng cộng',
['语言_s_3095']='Thủ lĩnh Gia Tộc %s kêu gọi tất cả các thành viên của Gia Tộc tham gia vào Trùm Gia Tộc! Phần thưởng tuyệt vời đang chờ đợi Gia Tộc hoàn thành! %s',
['语言_s_3096']='Xương sống của Gia Tộc %s kêu gọi tất cả các thành viên của Gia Tộc tham gia vào Trùm Gia Tộc! Phần thưởng tuyệt vời đang chờ đợi Gia Tộc hoàn thành! %s',
['语言_s_3097']='Gia Tộc của bạn đã hoàn thành [Chương %s] trong các đối thủ Gia Tộc của tuần này và nhận được phần thưởng sau!',
['语言_s_3098']='Gia Tộc của bạn đã đánh bại BOSS của Chương %s và bạn xếp hạng %s về sát thương. Bạn sẽ nhận được phần thưởng sau đây.',
['语言_s_3099']='Gia Tộc của bạn đã đánh bại BOSS của Chương %s và bạn xếp hạng %s về sát thương. Bạn sẽ nhận được phần thưởng sau đây. (Đây không phải là lần hạ gục đầu tiên của bạn. Bạn sẽ nhận được phần thưởng tối thiểu.)',
['语言_s_3100']='Người chơi thân mến:   \nXin các bạn chú ý, để bày tỏ sự chia buồn sâu sắc tới các liệt sĩ và đồng bào đã khuất của mọi quốc gia trong cuộc chiến chống lại COVID-19, và để đáp lại lời kêu gọi của Hội đồng Nhà nước về việc ngừng các hoạt động giải trí công cộng trên toàn quốc, trò chơi đã bị đình chỉ vì một ngày. Vì nhân vật của bạn đang ở vào ngày cuối cùng của Thời gian vận động, chúng tôi hiện đang gửi cho bạn tiến trình Phần Thưởng không thể hoàn thành do sự kiện bị tạm dừng (%s), vui lòng kiểm tra. Chúng tôi xin lỗi vì sự bất tiện của bạn',
['语言_s_3101']='Ω6482',
['语言_s_3102']='Yêu cầu VIP %s để mua',
['语言_s_3103']='Kho bạc của bạn không thể giữ thêm nữa~',
['语言_s_3104']='Mặt hàng đã được bán cho người khác.',
['语言_s_3105']='Đặt Vật Phẩm th.gian còn: %s',
['语言_s_3106']='Các cơ hội để đưa vào đã được sử dụng hết cho ngày hôm nay',
['语言_s_3107']='Ω4516',
['语言_s_3108']='Bạn đã đạt giới hạn tối đa Thông Tin Sinh Tồn trong [%s] [%s]. Thực hiện một cuộc phiêu lưu để lấy Bạc và các vật phẩm khác!',
['语言_s_3109']='Bạn đã đạt đến số lần thách đấu BOSS Thế giới tối đa trong [%s] [%s]. Đánh bại BOSS Thế giới để nhận mảnh trang bị cam!',
['语言_s_3110']='Bạn đã đạt đến giới hạn tối đa phần thưởng tự đánh trong [%s] [%s]. Vui lòng truy cập trang Chiến đấu để nhận phần thưởng của bạn.',
