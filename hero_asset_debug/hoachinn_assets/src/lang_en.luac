['语言_ski_ot_pa_d_22891']='<div vote=000023>Hiệu ứng dị năng</div>, đơn vị mang hiệu ứng này không thể hành động, DMG REDUC giảm 50%, duy trì 1 hiệp và không thể tẩy phép',
['语言_ski_ot_pa_22911']='Luân hồi nhãn',
['语言_ski_ot_pa_d_22911']='Người mang miễn dịch hiệu ứng xấu, trong thời gian này nếu HP bản thân thấp hơn 30% HP lớn nhất sẽ trao đổi HP với kẻ địch có HP cao nhất hiện tại, lượng tăng giảm HP không vượt quá 50% và bảo lưu ít nhất 20%, khi thấp hơn 20% sẽ không giảm HP (không coi là Heal hoặc sát thương, chỉ kích hoạt với kẻ địch có HP cao hơn bản thân, không có tác dụng với Boss), duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_d_22912']='Người mang miễn dịch hiệu ứng xấu, trong thời gian này nếu HP bản thân thấp hơn 30% HP lớn nhất sẽ trao đổi HP với kẻ địch có HP cao nhất hiện tại, lượng tăng giảm HP không vượt quá 50% và bảo lưu ít nhất 20%, khi thấp hơn 20% sẽ không giảm HP (không coi là Heal hoặc sát thương, chỉ kích hoạt với kẻ địch có HP cao hơn bản thân, không có tác dụng với Boss), duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_d_22913']='Người mang miễn dịch hiệu ứng xấu, trong thời gian này nếu HP bản thân thấp hơn 30% HP lớn nhất sẽ trao đổi HP với kẻ địch có HP cao nhất hiện tại, lượng tăng giảm HP không vượt quá 50% và bảo lưu ít nhất 20%, khi thấp hơn 20% sẽ không giảm HP (không coi là Heal hoặc sát thương, chỉ kích hoạt với kẻ địch có HP cao hơn bản thân, không có tác dụng với Boss), duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_22931']='Luân hồi độc đoán',
['语言_ski_ot_pa_d_22931']='Khi người mang chịu sát thương chí mạng, sẽ hồi phục 50% HP lớn nhất và xóa bỏ hiệu ứng này, duy trì 6 hiệp và không thể tẩy phép',
['语言_ski_ot_pa_d_22932']='Khi người mang chịu sát thương chí mạng, sẽ hồi phục 60% HP lớn nhất và xóa bỏ hiệu ứng này, duy trì 5 hiệp và không thể tẩy phép',
