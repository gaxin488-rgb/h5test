['语言_ski_ot_pa_217111']='Susanoo: Song trảm',
['语言_ski_ot_pa_21571']='Đồng đội',
['语言_ski_ot_pa_d_21571']='Hỗ trợ Hashirama trong trận chiến. Miễn nhiễm vĩnh viễn với các hiệu ứng Khống chế.',
['语言_ski_ot_pa_215711']='Đồng đội',
['语言_ski_ot_pa_d_215711']='Hỗ trợ Madara trong trận chiến. Miễn nhiễm vĩnh viễn với các hiệu ứng Khống chế.',

['语言_ski_ot_pa_d_21729'] = 'Nhận tạm thời 20% bỏ qua phòng thủ, sau đó gây tổng cộng <div fontcolor=#45a436>750%</div> sát thương vật lý lên tất cả kẻ địch và chia đều cho chúng, sát thương lên mỗi mục tiêu bị giới hạn ở mức tối đa 500% ATK của [Uế Thổ Hợp Nhất], và tất cả đồng minh sẽ được hồi máu dựa trên 40% ATK của Orochimaru. Đồng thời gây cho ngẫu nhiên 3 kẻ địch hiệu ứng [Hoảng Loạn] và tất cả kẻ địch nhận 1 tầng [Dấu Nguyền Lục Đạo]',

--
