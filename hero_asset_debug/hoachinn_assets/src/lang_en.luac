['语言_ite_2_26413']=	'Hinata Uzumaki',
['语言_ite_2_26913']=	'Hinata Uzumaki Shard',
['语言_loo_02_30514']=	'Get Hinata Uzumaki to unlock',
['语言_ite_2_d_26413']=	'Stars: <div fontcolor=#3dbf5f> 5</div> \n<div fontcolor=#aa6400> -- nhận được 5★ Đỡ đòn Phong: Hinata Uzumaki</div>',
['语言_ite_2_d_26913']=	'A shard containing the Chakra of Hinata Uzumaki.<div fontcolor=#9e501b> Craft</div> 50 shards into the 5★ Ninja: Hinata Uzumaki',
['语言_par_01_d_50513']='Nguyền, Tăng ST',
['语言_par_11_405261']='Hoa bãi biển',
['语言_par_11_405262']='Thật là can đảm... Tới đây nào!',
['语言_par_11_405263']='Trước khi Đại chiến Ninja nổ ra, một cơn bão sắp ập đến, mây đen dần dần bao phủ toàn bộ thế giới Ninja. Để đuổi kịp Naruto và Sasuke, Haruno Sakura đã bận rộn luyện tập cả ngày ngoại trừ lúc làm nhiệm vụ. Đúng lúc cô dần kiệt sức, Tsunade đến gặp cô và yêu cầu cô cùng tham gia khóa huấn luyện đặc biệt với mình...',
['语言_par_11_505261']='Uy phong lục đạo',
['语言_par_11_505262']='Tôi sẽ chém đứt mọi thứ!',
['语言_par_11_505263']='Sau khi Kaguya Otsutsuki bị phong ấn, Lục Đạo Tiên Nhân hy vọng Naruto và Sasuke sẽ hợp tác để giải trừ Tsukuyomi Vô Hạn. Tuy nhiên, Sasuke kiên quyết phát động một "cuộc cách mạng", đe dọa sẽ xử tử ngũ ảnh đương nhiệm. Sau đó, cậu sử dụng ảo thuật và Địa Bạo Thiên Tinh để phong ấn cửu vĩ. Naruto quyết định ngăn cản Sasuke, và cả hai cùng nhau đến thung lũng tận cùng cho trận chiến định mệnh.',
['语言_cro_gr_01_15']='Mở vào 3-23h từ thứ 2 đến thứ 6',
