['语言_ski_ot_pa_14391']='Tình bạn Ninja',
['语言_ski_ot_pa_d_14371']='Đơn vị mang hiệu ứng này không thể hành động (1 lượt), đồng thời -5% Tốc độ, -20% Kháng thể thuật, -20% Kháng nhẫn thuật, -20% Tấn công, kéo dài 1 lượt',
['语言_ski_ot_pa_d_14381']='sát thương nhẫn thuật+10%',
