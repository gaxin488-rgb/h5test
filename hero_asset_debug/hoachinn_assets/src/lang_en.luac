['语言_ite_2_d_29923']='Một mảnh chứa Chakra của Pain Lục Đạo: Tối Thượng.<div fontcolor=#9e501b> Ghép</div> 50 mảnh thành Ninja UR 5★: Pain Lục Đạo: Tối Thượng',
['语言_ski_ot_pa_21931']='Vua Địa Ngục: Luân Hồi Tái Sinh',  
['语言_ski_ot_pa_d_21931']='Khi bắt đầu trận đấu, nhận phục hồi HP, loại bỏ mọi debuff trên bản thân và nhận [Miễn Sát Thương] trong 2 lượt. Hiệu ứng này kéo dài đến hết trận chiến và không thể bị xóa.',

['语言_ski_pa1_d_494103'] = 'Asura Ōtsutsuki gây sát thương vật lý bằng <div fontcolor=#45a436>290%</div> tấn công của mình + <div fontcolor=#45a436>10%</div> HP tối đa của bản thân(sát thương chuẩn) cho tất cả kẻ địch, sau đó có 50% cơ hội phát động hiệu ứng [Phong Ấn] và 80% cơ hội thêm 2 lần [Chảy Máu] cho tất cả kẻ thù, bản thân và đồng minh thấp máu nhất sẽ nhận được [Lá chắn lửa]',
['语言_ski_pa1_d_494102'] = 'Asura Ōtsutsuki gây sát thương vật lý bằng <div fontcolor=#45a436>210%</div> tấn công của mình + <div fontcolor=#45a436>7%</div> HP tối đa của bản thân(sát thương chuẩn) cho tất cả kẻ địch, sau đó có 40% cơ hội phát động hiệu ứng [Phong Ấn] và 80% cơ hội thêm 2 lần [Chảy Máu] cho tất cả kẻ thù, bản thân và đồng minh thấp máu nhất sẽ nhận được [Lá chắn lửa]',
['语言_ski_pa1_d_494101'] = 'Asura Ōtsutsuki gây sát thương vật lý bằng <div fontcolor=#45a436>170%</div> tấn công của mình + <div fontcolor=#45a436>5%</div> HP tối đa của bản thân(sát thương chuẩn) cho tất cả kẻ địch, sau đó có 30% cơ hội phát động hiệu ứng [Phong Ấn] và 80% cơ hội thêm 2 lần [Chảy Máu] cho tất cả kẻ thù, bản thân và đồng minh thấp máu nhất sẽ nhận được [Lá chắn lửa]',
['语言_ski_pa1_d_494203'] = 'HP+<div fontcolor=#45a436>50%</div>, ATK+<div fontcolor=#45a436>40%</div>, CRIT+<div fontcolor=#45a436>40%</div>, đánh cắp 50% ATK và SPEED của kẻ địch thấp máu nhất. Nếu có mục tiêu dưới 20%, sẽ gây thêm hiệu ứng [Cấm Hồi Máu]',
['语言_ski_pa1_d_494202'] = 'HP+<div fontcolor=#45a436>40%</div>, ATK+<div fontcolor=#45a436>30%</div>, CRIT+<div fontcolor=#45a436>30%</div>, đánh cắp 50% ATK và SPEED của kẻ địch thấp máu nhất. Nếu có mục tiêu dưới 20%, sẽ gây thêm hiệu ứng [Cấm Hồi Máu]',
['语言_ski_pa1_d_494201'] = 'HP+<div fontcolor=#45a436>30%</div>, ATK+<div fontcolor=#45a436>20%</div>, CRIT+<div fontcolor=#45a436>20%</div>, đánh cắp 50% ATK và SPEED của kẻ địch thấp máu nhất. Nếu có mục tiêu dưới 20%, sẽ gây thêm hiệu ứng [Cấm Hồi Máu]',
['语言_ski_pa1_d_494303'] = 'Gây <div fontcolor=#45a436>400%</div> sát thương vật lý lên toàn bộ kẻ địch, cộng thêm sát thương vật lý bằng <div fontcolor=#45a436>5%</div> giới hạn HP của bản thân lên kẻ địch, đồng thời gây từ 1-3 hiệu ứng [Chảy Máu] và tiếp thêm hiệu ứng [Lá chắn lửa] cho toàn bộ đồng minh, bản thần không bị ảnh hưởng bởi các trạng thái hiệu ứng tiêu cực',
['语言_ski_pa1_d_494302'] = 'Gây <div fontcolor=#45a436>300%</div> sát thương vật lý lên toàn bộ kẻ địch, cộng thêm sát thương vật lý bằng <div fontcolor=#45a436>4%</div> giới hạn HP của bản thân lên kẻ địch, đồng thời gây từ 1-3 hiệu ứng [Chảy Máu] và tiếp thêm hiệu ứng [Lá chắn lửa] cho toàn bộ đồng minh, bản thần không bị ảnh hưởng bởi các trạng thái hiệu ứng tiêu cực',
['语言_ski_pa1_d_494301'] = 'Gây <div fontcolor=#45a436>250%</div> sát thương vật lý lên toàn bộ kẻ địch, cộng thêm sát thương vật lý bằng <div fontcolor=#45a436>3%</div> giới hạn HP của bản thân lên kẻ địch, đồng thời gây từ 1-3 hiệu ứng [Chảy Máu] và tiếp thêm hiệu ứng [Lá chắn lửa] cho toàn bộ đồng minh, bản thần không bị ảnh hưởng bởi các trạng thái hiệu ứng tiêu cực',
['语言_ski_pa1_d_494403'] = 'Sau khi sử dụng kĩ năng chủ động, bản thân và đồng minh thấp máu nhất sẽ nhận được [Tiếp tục hồi phục] và [Lá Chắn Lửa]',
['语言_ski_pa1_d_494402'] = 'Sau khi sử dụng kĩ năng chủ động, bản thân và đồng minh thấp máu nhất sẽ nhận được [Tiếp tục hồi phục] và [Lá Chắn Lửa]',
