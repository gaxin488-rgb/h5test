['语言_ite_1_d_55837']='Kurama đã chuẩn bị đặc biệt cho lễ Giáng sinh',
['语言_ava_01_d_10000']='Nhận được trong sự kiện đêm trước giáng sinh năm 2023',
['语言_ite_1_50065']='Vịt conのDu lịch suối nước nóng',
['语言_ite_1_d_50065']='Khi đang tắm suối nước nóng, thả vài con vịt con cũng là một lựa chọn thoải mãi nha',
['语言_ite_1_d_50064']='Người dân làng Lá dệt vòng hoa giáng sinh cho Kurama',

