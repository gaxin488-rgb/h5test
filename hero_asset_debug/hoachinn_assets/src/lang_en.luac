['语言_dun_02_1']='Khởi Đầu Mới',
['语言_dun_02_2']='Bài Kiểm Tra Của Kakashi',
['语言_dun_02_3']='Lớp Học Tập Trung 7',
['语言_dun_02_4']='Hướng Tới Con Sóng',
['语言_dun_02_5']='Sát Thủ Sương Mù',
['语言_dun_02_6']='Cầu Anh Hùng',
