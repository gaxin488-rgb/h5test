['语言_ski_pa1_d_725702_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>114%</div>',
['语言_ski_pa1_d_725703_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>125%</div>, hiệu ứng cường hóa<div fontcolor=#45a436>gây thêm 296% sát thương thể thuật lên mục tiêu mang nhiều tầng [Ấn khắc sét mòn] nhất</div>',
['语言_ski_pa1_d_725704_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>137%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>335%</div>',
['语言_ski_pa1_d_725705_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>150%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>374%</div>, thêm<div fontcolor=#45a436>hồi phục 1 điểm nộ khí cho toàn bộ sau khi thi triển kỹ năng</div>',
['语言_ski_pa1_d_725261']='Hiệu ứng này cũng kích hoạt 1 lượt khi thấp hơn 20% tổng HP',
['语言_ski_pa1_d_725351']='[Thần uy: Phán quyết] Thời gian CD giảm 1 nửa',
['语言_ski_ot_pa_72541']='Uế thổ: chiến ý',
['语言_ski_ot_pa_d_72541']='Đơn vị mang tăng 10% CRIT, 15% CRIT DMG, có thể cộng dồn nhiều nhất 10 tầng, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép; Khi chết, xóa bỏ 1 nửa số tầng hiệu ứng này, lấy số chẵn dưới',
['语言_ski_ot_pa_72511']='Uế Thổ Chuyển Sinh',
['语言_ski_ot_pa_d_72511']='Khi người mang chịu sát thương chí mạng sẽ hồi phục lại 70% máu tối đa, duy trì 3 hiệp và không thể tẩy phép ',
['语言_ski_ot_pa_72521']='Sức Mạnh Tiên Pháp',
['语言_ski_ot_pa_d_72521']='Nhận được sức mạnh tiên pháp sau khi hồi sinh, nhận được 50% tốc độ và 100% atk, miễn nhiễm với các hiệu ứng tiêu cực không thể xóa và kéo dài đến khi hết trận đấu',
['语言_ski_ot_pa_73221']='Uế Thổ Chiến Ý',
['语言_ski_ot_pa_d_73221']='Mỗi cộng dồn tăng 3% ATK và CRIT tối đa 20 tầng, không thể bị loại bỏ và kéo dài đến hết trận đấu',
['语言_ski_ot_pa_73222']='Uế Thổ Ăn Mòn',
['语言_ski_ot_pa_d_73222']='DEF giảm 10%, DMG REDUC giảm 10% cộng dồn nhiều nhất 5 tầng, không thể bị loại bỏ và kéo dài đến hết trận đấu',
['语言_ski_ot_pa_74221']='Tế bào Hashirama',
['语言_ski_ot_pa_d_74221']='Nó viện trợ cho người nhận 30% ATK và 30% CRIT, không thể bị loại bỏ và kéo dài đến hết trận đấu, và ban cho miễn dịch debuff trong 2 hiệp',
['语言_ski_ot_pa_74321']='Thần Môn Uế Thổ',
['语言_ski_ot_pa_d_74321']='Gây 200% sát thương cho tất cả kẻ địch đồng thời xuyên giáp 50% và xuyên giáp ảo 50%, hồi phục cho tất cả đồng minh 50% atk của Hashirama',

