['语言_ite_1_d_496']='Ω9709',
['语言_ite_1_d_497']='Khung hình đại diện có được trong Hội thao Naruto có thể được sử dụng để kích hoạt khung hình đại diện <div fontcolor=#9e501b> "Thể chất cường tráng" </div>',
['语言_ite_1_d_498']='Ω9707',
['语言_ite_1_d_499']='Khung hình đại diện Top 3 bảng xếp hạng Hội thao Naruto nhận được, có thể được sử dụng để kích hoạt khung hình đại diện <div fontcolor=#9e501b> "Thể chất cường tráng" </div>',
['语言_ite_1_d_500']='Ω9705',
