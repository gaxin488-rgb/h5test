['语言_ite_1_d_50073']='Trong thời gian vận động cường độ cao, bổ sung nước rất quan trọng',
['语言_ite_1_50074']='Mũ che nắng và Tonton',
['语言_ite_1_d_50074']='Lướt sóng cần chú ý an toàn! Tonton cũng vậy!',
