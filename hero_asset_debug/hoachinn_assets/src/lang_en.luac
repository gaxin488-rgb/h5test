['语言_ite_1_d_259']='Điểm kiếm được từ Săn $ 1. Sử dụng để đổi lấy Phần Thưởng trong cửa hàng sự kiện',
['语言_ite_1_d_260']='Ω9783',
['语言_ite_1_d_261']='Sử dụng nó để chơi rút thăm may mắn trong Quý Tộc Shinobi. Khi sự kiện kết thúc, chúng sẽ được chuyển đổi thành 10k Bạc với tỉ lệ 1:1',
['语言_ite_1_d_2779']='Sử dụng nó để đổi các vật phẩm quý hiếm trong sự kiện. Khi sự kiện kết thúc, chúng sẽ không còn khả dụng, hãy nhanh tay đến lấy!',
['语言_ite_1_d_2879']='Sử dụng nó để ghép thành các trang bị cao cấp trong lò rèn, có thể tìm thấy ở Boss và các sự kiện ingame!',

['语言_ite_1_d_1300101']='Sử dụng nó để ghép thành tinh thể đột phá',
['语言_ite_1_d_1307101']='Tinh thể dùng thể đột phá cho Ninja cấp thấp <div fontcolor=#9e501b>SP</div> và <div fontcolor=#9e501b>UR</div>, sau khi đột phá sẽ nhận được kỹ năng và thuộc tính nâng cấp tương đương với Ninja <div fontcolor=#9e501b>MR</div>',

['语言_ite_1_d_262']='Ω9778',
['语言_ite_1_d_263']='Ω9776',
['语言_ite_1_d_264']='Vật phẩm bắt buộc để chơi Lật Bài May Mắn: sử dụng 100 Lăng Đá May Mắn để bắt đầu 1 lần lật.\n<div fontcolor=#9e501b> Vật phẩm được chuyển thành Bạc theo tỷ lệ 1: 2000 khi sự kiện kết thúc.</div>',
['语言_ite_1_d_265']='Phần thưởng xếp hạng nhận được trong đấu trường liên máy chủ, sau khi mở ngẫu nhiên nhận được 1 bộ<div fontcolor = # 9e501b>trang bị cam 3 sao</div>',
['语言_ite_1_d_266']='Rương báu may mắn, mở nhận được một trong các đạo cụ sau: \n <div fontcolor = # 9e501b>1 vé chiêu mộ cao cấp</div> \n<div fontcolor = # 9e501b>2 vé chiêu mộ cao cấp</div> \n < div fontcolor = # 9e501b>10 vé chiêu mộ cao cấp</div> \n',
['语言_ite_1_d_267']='Ω292',
['语言_ite_1_d_268']='Ω290',
['语言_ite_1_d_269']='Ω288',
['语言_ite_1_d_270']='Ω286',
['语言_ite_1_d_271']='Ω284',
['语言_ite_1_d_272']='Một túi nguyên tố được may mắn cầu phúc. Mở ngẫu nhiên nhận 1 trong các vật phẩm sau: \n<div fontcolor=#9e501b> Vé Triệu Hồi Đặc Biệt*2</div> \n<div fontcolor=#9e501b> Vé Triệu Hồi Đặc Biệt*5</div> \n<div fontcolor=#9e501b> Vé Triệu Hồi Ưu Tú*1</div>',
['语言_ite_1_d_273']='Một túi truy tìm kho báu được may mắn cầu phúc. Mở ngẫu nhiên nhận 1 trong các vật phẩm sau: \n<div fontcolor=#9e501b> Vé Vòng Quay*3</div> \n<div fontcolor=#9e501b> Vé Vòng Quay*5</div> \n<div fontcolor=#9e501b> Vé Vòng Quay Đặc Biệt*1</div>',
['语言_ite_1_d_274']='Gói vật phẩm tùy chọn sang trọng, mở nó để chọn 1 trong các thứ sau: \n<div fontcolor=#9e501b> Bình Tinh Hoa*2000</div> \n<div fontcolor=#9e501b> Đá Hiền Nhân*130</div> \n<div fontcolor=#9e501b> Cầu Tăng Bậc*2000</div> \n<div fontcolor=#9e501b> Tinh Hoa Nguyên Tố*200</div>',
['语言_ite_1_d_275']='Gói vật phẩm tùy chọn siêu hiếm, mở nó để chọn 1 trong các thứ sau: \n<div fontcolor=#9e501b> Bình Tinh Hoa*4000</div> \n<div fontcolor=#9e501b> Đá Hiền Nhân*265</div> \n<div fontcolor=#9e501b> Cầu Tăng Bậc*4000</div> \n<div fontcolor=#9e501b> Tinh Hoa Nguyên Tố*400</div>',
['语言_ite_1_d_276']='Gói được nạp sức mạnh Đá Charka Nguyên Thủy, sử dụng nó để nhận ngẫu nhiên 1 trong các thứ sau: <div fontcolor=#9e501b> Bụi Đá Trưởng Lão, Mảnh Đá Trưởng Lão và Đá Trưởng Lão</div>',
