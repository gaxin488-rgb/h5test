['语言_par_01_30514']=	'Hinata Uzumaki',
['语言_par_01_d_30514']=	'Tank hỗ trợ buff, Phản đòn, khống chế',
['语言_par_11_305141']=	'<PROTECTION>',
['语言_par_11_30514']=	'Tôi sẽ không bao giờ quay lại lời nói của mình, bởi vì đó cũng là cách ninja của tôi!',
['语言_par_11_305143']=	'Hinata là một kunoichi của làng Lá. Trước đây là nữ thừa kế của gia tộc Hyūga, cô mất vị trí khi bị cho là không phù hợp với trách nhiệm lãnh đạo gia tộc. Tuy nhiên, Hinata vẫn kiên trì và từ việc quan sát đặc biệt là Naruto Uzumaki, Hinata đã tìm ra một tấm gương để noi theo. Thông qua việc trở thành thành viên của Đội 8, cô ấy đã tìm cách trở nên đủ mạnh mẽ để thay đổi bản thân, dù chỉ là một chút tại một thời điểm. Vài năm sau Chiến tranh thế giới Shinobi lần thứ tư, Hinata gia nhập gia tộc Uzumaki sau khi kết hôn với Naruto.',	
['语言_ski_pa1_547001']=	'Basic Attack',
['语言_ski_pa1_547101']=	'Assist Attack',
['语言_ski_pa1_547201']=	'Byakugan',
['语言_ski_pa1_547301']=	'Protect: Eight Trigrams 64 Palms',
['语言_ski_pa1_547401']=	'Will to Protect',
['语言_ski_pa1_d_547101']=	'Hinata buff hỗ trợ đồng minh của mình. \n\nATK + 10% và DEF + 10% (2 lượt, không thể loại bỏ) cho đồng minh có ATK cao nhất và cấp cho đồng minh 2 lượt, và buff máu cho tất cả đồng đội.',
['语言_ski_pa1_d_547102']=	'Hinata buff để hỗ trợ đồng minh của mình. \n\nATK + 15% và DEF + 15% (2 lượt, không thể loại bỏ) cho đồng minh có ATK cao nhất và cấp cho đồng minh 2 lượt, và buff máu cho tất cả đồng đội.',
['语言_ski_pa1_d_547103']=	'Hinata buff để hỗ trợ đồng minh của mình. \n\nATK + 30% và DEF + 30% (2 lượt, không thể loại bỏ) cho đồng minh có ATK cao nhất và cấp cho đồng minh 2 lượt, và buff máu cho tất cả đồng đội.',
['语言_ski_pa1_d_547201']=	'Công chúa Byakugan tăng cho Hinata.\n\nHP+20%, ATK+10%, SPD+10',
['语言_ski_pa1_d_547202']=	'Công chúa Byakugan tăng cho Hinata.\n\nHP+30%, ATK+15%, SPD+20',
['语言_ski_pa1_d_547203']=	'Công chúa Byakugan tăng cho Hinata.\n\nHP+40%, ATK+20%, SPD+30',
['语言_ski_pa1_d_547301']=	'Hinata tập hợp Chakra giữa hai lòng bàn tay thành hình kim. \n\nKích 150% T.DMG cho tất cả kẻ thù, gây [Mất Máu: 30%] (2 lượt) cho chúng. Nếu Hinata đã hỗ trợ một đồng minh, thì đòn tấn công truy đuổi của cô ấy từ [Hỗ trợ: Đánh đuổi] sẽ được thay thế thành [Hỗ trợ].',
['语言_ski_pa1_d_547302']=	'Hinata tập hợp Chakra giữa hai lòng bàn tay thành hình kim. \n\nKích 200% T.DMG cho tất cả kẻ thù, gây [Mất Máu: 30%] (2 lượt) cho chúng. Nếu Hinata đã hỗ trợ một đồng minh, thì đòn tấn công truy đuổi của cô ấy từ [Hỗ trợ: Đánh đuổi] sẽ được thay thế thành [Hỗ trợ].',
['语言_ski_pa1_d_547303']=	'Hinata tập hợp Chakra giữa hai lòng bàn tay thành hình kim. \n\nKích 250% T.DMG cho tất cả kẻ thù, gây [Mất Máu: 30%] (2 lượt) cho chúng. Nếu Hinata đã hỗ trợ một đồng minh, thì đòn tấn công truy đuổi của cô ấy từ [Hỗ trợ: Đánh đuổi] sẽ được thay thế thành [Hỗ trợ].',
['语言_ski_pa1_d_547401']=	'Hinata sử dụng Hồi Thiên phản tất cả đòn đánh của kẻ thù kèm theo các hiệu ứng đặc biệt khống chế.',
['语言_ski_pa1_d_547402']=	'Hinata sử dụng Hồi Thiên phản tất cả đòn đánh của kẻ thù kèm theo các hiệu ứng đặc biệt khống chế.',
['语言_ski_pa1_d_547403']=	'Hinata sử dụng Hồi Thiên phản tất cả đòn đánh của kẻ thù kèm theo các hiệu ứng đặc biệt khống chế.',
['语言_ski_ot_pa_14331']=	'Assist: Chase Attack',
['语言_ski_ot_pa_d_14331']=	'ATK + 30%, DEF+ 30%',
