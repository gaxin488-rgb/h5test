['语言_gui_09_4']='Hãy cùng nhau tận hưởng niềm vui khi chơi game!',
['语言_gui_09_5']='Một ngày tuyệt vời đáng để ăn mừng!',
['语言_gui_09_6']='Tất cả là của bạn ! > 3<',
