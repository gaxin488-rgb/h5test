['语言_ski_ot_pa_21729'] = 'Uy trang: Đỉnh trượng hóa phật',
['语言_ski_ot_pa_d_21718'] = 'Nhận tạm thời 40% Bỏ Qua DEF, sau đó gây tổng cộng <div fontcolor=#45a436>521%</div> S.DMG lên tất cả kẻ địch, sát thương lên mỗi mục tiêu bị giới hạn ở mức tối đa 500% ATK của [Đồng Đội].',
['语言_ski_ot_pa_d_21719'] = 'Nhận tạm thời 40% Bỏ Qua DEF, sau đó gây tổng cộng <div fontcolor=#45a436>626%</div> S.DMG lên tất cả kẻ địch, sát thương lên mỗi mục tiêu bị giới hạn ở mức tối đa 500% ATK của [Đồng Đội].',
