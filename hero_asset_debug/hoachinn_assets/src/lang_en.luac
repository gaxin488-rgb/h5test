['语言_s_2869']='Vĩ Thú Cam %s',
['语言_s_2870']='%s nhận %s trong %s!%s',
['语言_s_2871']='Tôi đã chia sẻ thành tích chiến đấu của mình trong Đấu Xếp Hạng Đỉnh, hãy cho tôi một lượt Thích! %s',
