['语言_ite_7_d_1']='Đồ ăn nhẹ và dễ mang theo, dễ cảm thấy khát sau khi ăn.',
['语言_ite_7_d_2']='Bánh quy hình quả trứng nhỏ và dẹt, dễ mang theo.',
['语言_ite_7_d_3']='Thức ăn làm bằng gạo nguyên chất dễ mang theo và đáp ứng được nhu cầu sinh tồn.',
['语言_ite_7_d_4']='Món salad với mì trơn kiểu Nhật làm nguyên liệu chính là món khoái khẩu của những người đam mê thể dục.',
['语言_ite_7_d_5']='Đá viên làm từ nhiều loại trái cây khác nhau rất cần thiết để giải nhiệt trong mùa hè.',
['语言_ite_7_d_6']='Cơm tôm tươi nấu bằng tôm tươi.',
['语言_ite_7_d_7']='Mì nấu với nước lèo được ninh từ xương heo có giá trị dinh dưỡng cực cao.',
['语言_ite_7_d_8']='Một hộp bento tinh tế gồm nhiều món ăn khác nhau, phải có cho những chuyến du lịch đường dài.',
['语言_ite_7_d_9']='Một hộp vật phẩm được làm cẩn thận với những điều bất ngờ được lưu trữ trong đó.',
['语言_ite_7_d_10']='Túi vải có mùi thơm có thể mang lại may mắn.',
['语言_ite_7_d_11']='Được sử dụng để vẽ ra những gì bạn đã thấy và nghe thấy trong suốt cuộc hành trình.',
['语言_ite_7_d_12']='Bạn có thể kêu gọi các đối tác khác để cùng nhau tìm kiếm các đạo cụ của tiền vàng.',
['语言_ite_7_d_13']='Rương báu lớn có thể có những bất ngờ bất ngờ sau khi mở ra.',
['语言_ite_7_d_14']='Chai thủy tinh trơn bóng chứa đựng sự bí ẩn.',
['语言_ite_7_d_15']='Sách vẽ chất lượng cao có thể mô tả những gì bạn thấy và nghe rõ ràng hơn.',
['语言_ite_7_d_16']='Mặt dây chuyền tượng trưng cho sự may mắn, có thể mang lại may mắn khi cầm trên tay',
['语言_ite_7_d_17']='Một vé tàu màu vàng cho chuyến tàu sa mạc.',
['语言_ite_7_d_18']='Một vé tàu màu xanh cho chuyến tàu ngầm.',
['语言_ite_7_d_19']='Một vé thông thường đến quốc gia láng giềng.',
['语言_ite_7_d_20']='Phong quốc có một đặc điểm, đó là thời gian nắng ở vùng sa mạc tương đối dài, do đó, những loài hoa mọc dưới địa hình này khác hẳn với những loài hoa ở bốn quốc gia kia.',
['语言_ite_7_d_21']='Cối xay gió ở Phong quốc là một trong những món đồ chơi yêu thích của trẻ nhỏ.',
['语言_ite_7_d_22']='Ichiraku Ramen nổi tiếng là món ăn yêu thích của tất cả Ninja ở Hỏa quốc.',
['语言_ite_7_d_23']='Những con dao của Thiết quốc là vũ khí cứng nhất trên thế giới.',
['语言_ite_7_d_24']='Nói về rượu Sake của Lôi quốc thật khiến người ta khó quên.',
['语言_ite_7_d_25']='Những đôi guốc mộc của Thổ quốc len lỏi trên đường và thích hợp để đi trong những ngày mưa gió, bùn lầy.',
['语言_ite_7_d_26']='Lá trà của Hỏa quốc có màu xanh ngọc lục bảo, nước trà có vị thanh tao và êm dịu.',
['语言_ite_7_d_27']='Không ai không thích những chiếc ô giấy ở làng Vũ Ẩn.',
['语言_ite_7_d_28']='Thổ quốc có khoáng sản phong phú nhất, tiếng chuông gió của họ nghe rõ ràng và sắc nét.',
['语言_ite_7_d_29']='Các sản phẩm thủy tinh của Thổ quốc có thể nói là những tác phẩm nghệ thuật.',
['语言_ite_7_d_30']='Nói đến thịt nướng của Lôi quốc thì bụng sẽ réo lên òng ọc.',
['语言_ite_7_d_31']='Cơm trứng cá của Thủy quốc vô cùng tươi ngon.',
['语言_ite_7_d_32']='Phân thân đa bóng là một nhẫn thuật do thế hệ thứ hai sáng tạo ra, vì nó sẽ tách chakra của người chế tạo ra, nó sẽ khiến người ta gục xuống và chết, và chỉ những người có lượng chakra lớn mới có thể sử dụng nó.',
['语言_ite_7_d_33']='Người bị thi triển phép thuật hy sinh mạng sống của mình để chết cùng với kẻ thù.',
['语言_ite_7_d_34']='Người thi triển phép thuật có thể triệu hồi thần chết theo thứ tự "Tị - Hợi - Mùi - Mão -  Tuất - Tý - Dậu - Ngọ - Tị" sau khi chắp tay để triệu hồi thần chết, và sau đó là thần của cái chết sẽ chém linh hồn của mục tiêu bằng một thanh kiếm và nuốt nó vào bụng, từ đó phong ấn linh hồn của mục tiêu',
['语言_ite_7_d_35']='Loa Toàn Thủ Lý Kiếm sẽ có tác dụng phụ rất lớn đối với bản thân sau khi sử dụng nó, bởi vì nhẫn thuật này là một đòn tấn công cự ly gần, cơn bão chakra mà nó mang lại sẽ khiến bạn bị thương.',
['语言_ite_7_d_36']='Nếu người thi triển phép thuật không thể chịu được gánh nặng của sức mạnh đó, nó sẽ làm tổn thương cơ thể của anh ta, vì vậy nó được coi là một cấm thuật.',
['语言_ite_7_d_37']='Trạng thái có tất cả tám cánh cửa mở được gọi là "Trận Bát Môn Độn Giáp", có thể đạt được sức mạnh mạnh hơn Naruto hàng chục lần trong một khoảng thời gian ngắn, nhưng đó là trạng thái nguy hiểm đến tính mạng đối với người chơi.',
['语言_ite_7_d_38']='Chuyển sinh là một cấm thuật thông linh của thế giới khác được phát triển bởi thế hệ Hokage đệ nhị, thuật này có thể triệu hồi linh hồn của những người đã chết từ lâu trở lại thế giới và hồi sinh họ ở dạng vật chất.',
['语言_ite_7_d_39']='Việc sửa đổi cơ thể luôn bị cấm trong thế giới ninja.',
['语言_ite_7_d_40']='Đất sét được ăn bằng miệng của ngực, và chakra được trộn trực tiếp vào chakra từ hệ thống kinh mạch của tim, quá trình này sẽ tiếp tục cho đến khi bùng nổ.',
['语言_ite_7_d_41']='Một nhẫn thuật chuyển sinh bí mật. Sử dụng tất cả các Chakra như một phương tiện để phân phối sức sống cho chủ thể.',
['语言_ite_7_d_42']='Kỹ thuật này là kỹ thuật cấm thuật tối thượng được tạo ra bởi Naruto Senjutsu đệ ngũ. Trong trận chiến, lượng chakra khổng lồ được tạo ra bởi phong ấn Âm được sử dụng để tái tạo cơ thể mà không cần phong ấn, là kỹ thuật trường sinh bất tử tối thượng để có thể đạt được những trận chiến liền mạch.',
['语言_ite_7_d_43']='Với sức mạnh của Bạch Xà, một con rắn hổ mang khổng lồ có 8 đầu thành con rắn 8 đầu đã biến hình, con rắn này là hiện thân của nỗi ám ảnh và được mệnh danh là "mãnh xà mạnh nhất"',
['语言_ite_7_d_44']='Bạn có thể chuyển linh hồn của mình sang cơ thể (vật chứa) của người khác để có được khả năng trường sinh bất tử.',
['语言_ite_7_d_45']='Nhẫn thuật nổ vô hạn cấp A do Senjukuma phát triển. Dán một lá bùa kích nổ duy nhất vào các điểm quan trọng của kẻ thù với tốc độ không kịp che tai. Một lá bùa kích nổ duy nhất có thể lưu hành vô thời hạn và thông linh tạo ra hàng nghìn tỷ lá bùa phát nổ.',
['语言_ite_7_d_46']='Izanagi đã thay đổi kết quả bất lợi để viết lại hiện thực ngay cả khi nó được sống lại, nhẫn thuật mang theo sự kiêu ngạo của ninja.',
['语言_ite_7_d_47']='Izanami đối lập với Izanaki, và đó là kỹ thuật duy nhất có thể ngăn chặn Izanaki.',
['语言_ite_7_d_48']='Kỹ thuật phong ấn được thực hiện bởi Shimura Danzo có thể phong ấn tất cả các vật phẩm trong phạm vi vài trăm mét vào cơ thể một người.',
['语言_ite_7_d_49']='Hóa thân thành linh hồn sống, bỏ qua khoảng cách giết địch, còn có thể điều khiển thân thể của đối phương tiến vào thế giới tâm linh của người khác.',
['语言_ite_7_d_50']='Được phát minh bởi bọ cạp, xác của một người được biến thành một con rối, có thể lưu lại chakra của người đó, và sau đó sử dụng nhẫn thuật của anh ta trong suốt cuộc đời của mình.',
['语言_ite_7_d_51']='Một loại nhẫn thuật được sử dụng bởi Chiyo, sử dụng mười ngón tay để điều khiển đồng thời mười con rối do thế hệ đầu tiên của người sử dụng rối Menzaemon để lại, tung ra một cuộc tấn công tổng hợp vào kẻ thù từ các góc độ khác nhau.',
['语言_ite_7_d_52']='Kỹ thuật phong ấn được Akatsuki sử dụng để kéo Vĩ Thú ra khỏi cơ thể Jinchuriki và phong ấn nó vào trong ma tượng ngoại đạo.',
['语言_ite_7_d_53']='Nhẫn thuật kiểm soát lực hấp dẫn tối thượng và có thể gây ra thiệt hại rất lớn cho môi trường xung quanh.',
['语言_ite_7_d_54']='Sau khi kích hoạt, người khác có thể có ngoại hình giống với nhân vật cụ thể và có thể sử dụng tất cả các kỹ năng của nhân vật cụ thể (bao gồm cả giới hạn huyết kế), nhưng chỉ có 30% năng lực của cơ thể.',
['语言_ite_7_d_55']='Sức mạnh đồng tử chiếu rọi lên mặt trăng, khiến mọi người trên khắp thế giới rơi vào ảo ảnh và được cây thiêng bao bọc hấp thụ chakra.',
['语言_ite_7_d_56']='Gom thịt và rải các loài côn trùng độc trong chúng, để tế bào chết sinh ra khí độc, rồi để khí độc phát nổ.',
['语言_ite_7_d_57']='Với thuật này, dấu "Tị" có thể được hình thành trong vài giây, và sau đó ánh sáng tự nhiên sẽ tỏa ra xung quanh người đã chết do bị thi triển phép thuật và làm cho người đó sống lại.',
['语言_ite_7_d_58']='Tốc độ tấn công nhanh đến mức có thể cọ xát với không khí tạo ra rất nhiều ngọn lửa.',
['语言_ite_7_d_59']='Trú Hổ là tuyệt chiêu trong bảy cửa của Kai, sức chiến đấu gấp hàng chục lần bình thường, tốc độ cực nhanh, sức tấn công và phạm vi càng thêm kinh người.',
['语言_ite_7_d_60']='Sau khi sức chiến đấu đạt gấp 100 lần trạng thái bình thường, tám cánh cửa được mở hoàn toàn, thông qua khí nén bắn ra hình bàn chân voi.',
['语言_ite_7_d_61']='Night Guy là bí mật cuối cùng của cánh cổng thứ tám trong Bát Môn Độn Giáp. "Night Guy" xương ức của Lục Đạo Maradda bị đá vỡ, Madara bị trọng thương.',
['语言_ite_7_d_62']='Cả bản thân Madara và hai mặt Susa đều có những phong ấn khác nhau, triệu hồi một thiên thạch khổng lồ có đường kính hơn 100 mét rơi theo phương thẳng đứng.',
['语言_ite_7_d_63']='Một sự thay đổi mới về bản chất được tạo ra bởi sự kết hợp của chakra thuộc tính gió và chakra thuộc tính lửa.',
['语言_ite_7_d_64']='Chỉ có một Dung Độn Thuật được xác nhận trong toàn bộ tác phẩm, được sử dụng bởi Naruto Thủy Ảnh đệ ngũ: Terumi Ming.',
['语言_ite_7_d_65']='Thể chất đặc biệt của Naruto Phong Ảnh đệ tam có thể biến đổi các Chakra cô đặc cao thành lực từ trường, và sắt cát có thể tùy ý thay đổi thành nhiều dạng khác nhau để tấn công và phòng thủ. Đây là vũ khí đáng sợ nhất ở Làng Cát Ẩn.',
['语言_ite_7_d_66']='Đó là một ranh giới huyết kế có thể biến bất cứ thứ gì thành một vật thể kết tinh, và điểm yếu của nó là sóng âm.',
['语言_ite_7_d_67']='Khả năng điều khiển nước và gió cùng lúc và tổng hợp chúng thành băng.',
['语言_ite_7_d_68']='Một kết giới trong mờ có thể biến dạng được hình thành trên tay và phóng tới đối thủ, có thể tách đối thủ thành trạng thái nguyên tử và bị xóa sổ trong mây khói.',
['语言_ite_7_d_69']='Kết hợp Chakra thuộc tính thủy và hỏa, đồng thời miệng phun ra sương axit ăn mòn mạnh.',
['语言_ite_7_d_70']='Nham Độn bù đắp khuyết điểm là sấm sét không dễ kiểm soát, là ranh giới huyết kế kết hợp ưu điểm của sấm sét và nước.',
['语言_ite_7_d_71']='Thuật bí mật ban đầu được tạo ra bởi Naruto: Hashirama ban đầu. Thuật này thuộc về một loại ranh giới huyết kế, được cấu tạo bởi hai Chakra đất và nước.',
