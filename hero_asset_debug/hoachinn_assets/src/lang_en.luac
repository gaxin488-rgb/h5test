['语言_c_3601']='Không có Ninja nào có thể lựa chọn',
['语言_c_3602']='Vui lòng chọn Tăng Ninja',
['语言_c_3603']='Binh Lương Hoàn',
['语言_c_3604']='Sử dụng 1 Binh Lương Hoàn để hồi phục hoàn toàn Sinh mệnh của Ninjas và hồi sinh tất cả các Ninjas bị hạ gục, đồng thời tăng %s%% Tấn công cho tất cả Ninjas trong trận chiến tiếp theo',
['语言_c_3605']='Tăng Tấn công chỉ có hiệu lực một lần trong trận tiếp theo',
['语言_c_3606']='Hiện có: ',
['语言_c_3607']='Với sự giúp đỡ của Binh Lương Hoàn, các Ninjas đã hồi phục máu của mình',
['语言_c_3608']='Tiêu 1 <img src=\'%s\' scale=0.4 /> để khôi phục hoàn toàn Sinh mệnh của tất cả các Ninjas và hồi sinh tất cả các Ninjas đã bị loại? Và Tấn công của tất cả Ninjas +%s%% trong trận chiến tiếp theo',
['语言_c_3609']='Chưa có dữ liệu Ninja',
['语言_c_3610']='Thuê ninja',
['语言_c_3611']='Thuê một Ninja để giúp bạn vượt các màn',
['语言_c_3612']='Vui lòng chọn Ninja để thuê',
['语言_c_3613']='Thu thập Bổ trợ',
['语言_c_3614']='Bổ trợ chỉ có hiệu lực trong Thám Hiểm Tàn Tích, chúng sẽ bị xóa khi cuộc phiêu lưu kết thúc',
['语言_c_3615']='Chưa có dữ liệu Bổ trợ',
['语言_c_3616']='Tuyệt vời, bạn đã hoàn thành cuộc phiêu lưu này',
['语言_c_3617']='Hoàn thành',
['语言_c_3618']='Mở khóa Lệnh Tàn Tích',
['语言_c_3619']='Điểm màn:  ',
['语言_c_3620']='Đánh bại Boss mỗi cấp độ để nhận Điểm vượt ải',
['语言_c_3621']='Hành cước thương nhân',
['语言_c_3622']='Bạn thật may mắn khi gặp tôi, tôi có nhiều điều tốt đẹp ở đây',
['语言_c_3623']='Thoát',
['语言_c_3624']='Bỏ cuộc',
['语言_c_3625']='Chưa có dữ liệu cửa hàng',
