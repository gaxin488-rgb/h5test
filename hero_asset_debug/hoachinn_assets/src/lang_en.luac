['语言_ite_3_7222']='Huyền Tinh giày chiến 2',
['语言_ite_3_7223']='Nhật Tuyệt giày chiến',
['语言_ite_3_7224']='Nhật Tuyệt giày chiến 2',
['语言_ite_3_7225']='Nguyệt Linh giày chiến',
['语言_ite_3_d_1']='Một vũ khí cũ gỉ. Có còn hơn không!',
['语言_ite_3_d_2']='Một vũ khí sắc bén',
['语言_ite_3_d_3']='Thủ Lí Kiếm này gây sát thương rất lớn',
['语言_ite_3_d_4']='Được rèn giũa bằng tất cả tinh hoa. Linh hoạt trong cả tấn công và phòng thủ',
['语言_ite_3_d_5']='Giao ước với Vĩ Thú để tăng cường khả năng kiểm soát Chakra của ninja',
['语言_ite_3_d_6']='Chỉ khi bạn có một niềm tin cháy bỏng, bạn mới có thể được nó công nhận',
['语言_ite_3_d_7']='Thanh kiếm nguy hiểm này triệu hồi vô số vụ nổ',
['语言_ite_3_d_8']='Vũ khí của Madara, được làm từ một phần của Cây Thần Thụ. Nó kiểm soát gió và khắc chế lửa',
['语言_ite_3_d_9']='Thẻ được sử dụng để ngăn chặn Hồi sức trong cuộc chiến ninja lần thứ tư',
['语言_ite_3_d_10']='Hiện thân của vua khỉ Enma, bây giờ nó đang đợi ai đó',
['语言_ite_3_d_11']='Thời trang ninja với phong cách định hướng, tuyệt đẹp và bền',
['语言_ite_3_d_12']='Được chúc phúc bởi Kushina Uzumaki, chứa đựng phước lành vô tận',
['语言_ite_3_d_13']='Những từ được sử dụng thường xuyên của đối thủ sẽ được ghi vào thanh kiếm này. Khi người nói thốt ra những từ đã ghi âm, họ sẽ bị hút vào bầu.',
['语言_ite_3_d_14']='Đừng trả lời nó! Trừ khi bạn muốn bị niêm phong',
['语言_ite_3_d_15']='Vũ khí chẻ đôi và nguyền rủa kẻ địch',
['语言_ite_3_d_16']='Vũ khí này được biến đổi từ Quả cầu Truthseeker, với Đội Hình của mặt trời và mặt trăng ở cả hai mặt',
['语言_ite_3_d_17']='Ý chí kiên cường của bạn có thể thỏa mãn thanh kiếm',
['语言_ite_3_d_18']='Không có quần áo nào có thể phổ biến hơn những thứ này… nhưng vẫn không phiền',
['语言_ite_3_d_19']='Đặt cho các nhiệm vụ ngoài trời, xin vui lòng không bận tâm đến sự thô ráp của nó',
['语言_ite_3_d_20']='Không thể không cảm thấy cao sau khi mặc bộ danh dự này',
['语言_ite_3_d_21']='Thời trang thường xuyên cho ninja thông thường',
['语言_ite_3_d_22']='Một ninja mạnh hơn đã để lại thời trang này cho chúng ta sau khi ẩn dật, hy vọng nó có thể truyền cảm hứng cho ninja',
['语言_ite_3_d_23']='Bộ áo giáp này có vẻ mạnh mẽ hơn vẻ ngoài',
['语言_ite_3_d_24']='Mặt hàng thời trang phổ biến của các ninja nữ',
['语言_ite_3_d_25']='Từng là trang bị của các nhà thủ lĩnh samurai, nhưng các ninja đã biến nó thành phong cách riêng của họ',
['语言_ite_3_d_26']='Từng là trang bị của chủ tịch samurai, nhưng ninja đã biến nó thành phong cách riêng của họ',
['语言_ite_3_d_27']='Bộ áo giáp chứa đựng sức mạnh của Hokage Đệ Nhị',
['语言_ite_3_d_28']='Thời trang của Kaguya luôn tỏa ra sức mạnh của Chakra',
['语言_ite_3_d_29']='Thời trang mạnh mẽ nhất mà Gia tộc Uchiha kế thừa',
['语言_ite_3_d_30']='Thời trang mạnh mẽ này được để lại bởi những Bóng lửa của nhiều thế hệ',
['语言_ite_3_d_31']='Chiếc băng đô đã mất đi sức mạnh do bị phản bội',
['语言_ite_3_d_32']='Chiếc băng đô đã mất đi sức mạnh do bị phản bội',
['语言_ite_3_d_33']='Bằng chứng trở thành một ninja, được cấp bởi Làng Âm Thanh',
['语言_ite_3_d_34']='Chỉ giành cho kẻ mạnh!',
['语言_ite_3_d_35']='Chỉ giành cho kẻ mạnh!',
['语言_ite_3_d_36']='Chỉ giành cho kẻ mạnh!',
['语言_ite_3_d_37']='Hiruzen sử dụng nó để bảo vệ đầu của mình, được các ninja ưa chuộng vì độ cứng của nó',
['语言_ite_3_d_38']='Khuôn mặt của anh ta dưới chiếc mặt nạ là một câu đố. Chỗ dựa mạnh mẽ.',
['语言_ite_3_d_39']='Mặt nạ tuyệt vời này giúp tăng hoạt động của Chakra',
['语言_ite_3_d_40']='Một tấm màn che được thừa hưởng bởi những bóng lửa',
['语言_ite_3_d_41']='Mặt nạ che giấu danh tính có sức mạnh của bóng tối',
['语言_ite_3_d_42']='Hoa Tai phát triển từ sức mạnh còn lại của Kaguya',
['语言_ite_3_d_43']='Sức mạnh của Cây Thần Thụ đã phát triển thành chiếc mặt nạ này khi nó được phong ấn trên Mặt Trăng',
['语言_ite_3_d_44']='Đôi dép đi trong nhà êm ái chạm vào chân bạn, tạo cảm giác thoải mái lạ thường',
['语言_ite_3_d_45']='Mặc những thứ này và đi chơi với những người bạn ninja, là một lựa chọn khá tốt',
['语言_ite_3_d_46']='Phổ biến trong giới ninja trẻ',
['语言_ite_3_d_47']='Đôi giày này đảm bảo sự nhanh nhẹn và linh hoạt cho các thành viên Anbu',
['语言_ite_3_d_48']='Vị thần duy nhất trong mùa đông, nếu không bạn không bao giờ có một bàn chân lạnh… đùa',
['语言_ite_3_d_49']='Một đôi bốt thường được chọn cho các trận chiến',
['语言_ite_3_d_50']='Darksteel là tên của sự ổn định. Rất bền',
['语言_ite_3_d_51']='Thần Ninja, hãy tiếp thêm sức mạnh không ngừng cho ta',
['语言_ite_3_d_52']='Thần Ninja, hãy tiếp thêm sức mạnh không ngừng cho ta',
['语言_ite_3_d_53']='Thần Ninja, hãy tiếp thêm sức mạnh không ngừng cho ta',
['语言_ite_3_d_54']='Được Lục Đạo Hiền Nhân cầu phúc, đôi giày này đang phát ra sức mạnh áp đảo',
['语言_ite_3_d_55']='Được Lục Đạo Hiền Nhân cầu phúc, đôi giày này đang phát ra sức mạnh áp đảo',
['语言_ite_3_d_56']='Được Lục Đạo Hiền Nhân cầu phúc, đôi giày này đang phát ra sức mạnh áp đảo',
['语言_ite_3_d_57']='Chiếc băng đô được Naruto đeo khi còn nhỏ',
['语言_ite_3_d_58']='Giày tùy chỉnh cho ninja huyền thoại',
['语言_ite_3_d_59']='Nhẫn Cụ mạnh mẽ này thực hiện các đòn tấn công chứa lửa, nước, sét, gió và luân xa đất.',
['语言_ite_3_d_60']='The proof of becoming a ninja, issued by Hidden Leaf Village',
['语言_ite_3_d_61']='The proof of becoming a ninja, issued by Hidden Rock Village',
['语言_ite_3_d_62']='Forged for traitor ninjas. Functions fun in both offence and defence',
['语言_ite_3_d_63']='A secret gear resembles a needle. Apply poison on it to enhance its damage.',
['语言_ite_3_d_69']='Được Admin MrSon Nhangia.vusagaming.net ban phúc, khi sử dụng vũ khí này sẽ phát ra sức mạnh cực kì áp đảo.',
