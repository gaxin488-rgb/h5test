['语言_ite_1_d_50056']='Khung Avatar chuyên dụng trong sự kiện lễ hội 2 năm, tinh thần bảo vệ làng Lá trong âm thầm<div fontcolor=#9e501b>[Kế thừa tinh thần hoàng kim]</div>',
['语言_ite_1_50057']='Tinh anh thể thuật',
['语言_ite_1_d_50057']='Khung Avatar chuyên dụng sự kiện đại hội thể thao Lee, quyết đấu 1 trận để chứng minh thực lực thể thuật của tuổi thanh xuân nào:<div fontcolor=#9e501b>[Đại sư thể thuật]</div>',
['语言_ite_1_50058']='Pakkungekyo',
['语言_ite_1_d_50058']='Khung Avatar chuyên dụng sự kiện bữa tiệc mùa hè, Pakkun bị choáng khi bị ánh nắng bờ biển chiếu<div fontcolor=#9e501b>[Pakkungekyo]</div>',
['语言_ite_1_50059']='Nước dừa mùa hè',
['语言_ite_1_d_50059']='Khung Avatar chuyên dụng sự kiện bãi biển, cùng nhau tận hưởng sự mát mẻ của gió biển mùa hè nào!<div fontcolor=#9e501b>[Nước dừa mùa hè]</div>',
['语言_ite_1_50060']='Avatar thăng sao',
['语言_ite_1_d_50060']='Khung Avatar nhận được trong sự kiện thăng sao, có thể dùng để kích hoạt<div fontcolor=#9e501b>[Khung Avatar thăng sao]</div>',
['语言_ite_1_50061']='Quạ: Mật truyền',
['语言_ite_1_d_50061']='Vốn dĩ là thông linh thú của Shisui, sau này gửi gắm cho Itachi<div fontcolor=#9e501b>[Quạ: Mật truyền]</div>',
['语言_ite_1_50062']='Mũ trùm bữa tiệc dị trang',
['语言_ite_1_d_50062']='Mũ ếch được sử dụng trong bữa tiệc dị trang được tổ chức bởi 3 người Akatsuki',
['语言_ite_1_50063']='Quà tặng giáng sinh của gia tộc Uchiha',
['语言_ite_1_d_50063']='Khung Avatar chuyên dụng lễ hội giáng sinh, vật phẩm của gia tộc Uchia phát cho các thành viên, có thể dùng để mở khóa khung Avatar<div fontcolor=#9e501b>[Quà tặng giáng sinh của gia tộc Uchiha]</div>',
['语言_ite_1_50064']='Vòng hoa giáng sinh',
