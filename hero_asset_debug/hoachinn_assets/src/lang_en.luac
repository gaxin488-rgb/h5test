['语言_ski_pa1_d_723601']='Kết thúc mỗi vòng đấu, Madara thi triển phun ra 3 con rồng lửa lên không trung, gây ra lượng sát thương thực (vô hiệu giảm sát thương và đỡ đòn) bằng 20% giới hạn sinh mệnh của đơn vị hàng trước và hàng giữa phe địch, gây cho tất cả kẻ địch thêm 1 tầng <div fontcolor=#45a436>[Uế Thổ: Thiêu Đốt]</div>, thêm trạng thái <div fontcolor=#45a436>[Ấn Uchiha]</div> cho 3 đơn vị ngẫu nhiên',
['语言_ski_pa1_d_723602']='Kết thúc mỗi vòng đấu, Madara thi triển phun ra 3 con rồng lửa lên không trung, gây ra lượng sát thương thực (vô hiệu giảm sát thương và đỡ đòn) bằng 20% giới hạn sinh mệnh của đơn vị hàng trước và hàng giữa phe địch, gây cho tất cả kẻ địch thêm 1 tầng <div fontcolor=#45a436>[Uế Thổ: Thiêu Đốt]</div>, thêm trạng thái <div fontcolor=#45a436>[Ấn Uchiha]</div> cho 3 đơn vị ngẫu nhiên',
['语言_ski_pa1_d_723603']='Kết thúc mỗi vòng đấu, Madara thi triển phun ra 3 con rồng lửa lên không trung, gây ra lượng sát thương thực (vô hiệu giảm sát thương và đỡ đòn) bằng 20% giới hạn sinh mệnh của đơn vị hàng trước và hàng giữa phe địch, gây cho tất cả kẻ địch thêm 1 tầng <div fontcolor=#45a436>[Uế Thổ: Thiêu Đốt]</div>, thêm trạng thái <div fontcolor=#45a436>[Ấn Uchiha]</div> cho 3 đơn vị ngẫu nhiên',

['语言_ski_pa1_d_723701']='Bắt đầu mỗi vòng đấu Madara dùng <div fontcolor=#45a436>Uế Thổ: Thiên Ngoại Chấn Tinh</div>, gây 2 lần sát thương là sát thương thực cực lớn tổng cộng <div fontcolor=#45a436>255%</div> (vô hiệu hóa giảm sát thương và đỡ đòn của mục tiêu) sát thương đối với tất cả kẻ địch, gây cho 2 kẻ địch ngẫu nhiên 1 lần <div fontcolor=#45a436>[Uế Thổ: Dư Chấn]</div>',
['语言_ski_pa1_d_723702']='Bắt đầu mỗi vòng đấu Madara dùng <div fontcolor=#45a436>Uế Thổ: Thiên Ngoại Chấn Tinh</div>, gây 2 lần sát thương là sát thương thực cực lớn tổng cộng <div fontcolor=#45a436>275%</div> (vô hiệu hóa giảm sát thương và đỡ đòn của mục tiêu) sát thương đối với tất cả kẻ địch, gây cho 2 kẻ địch ngẫu nhiên 1 lần <div fontcolor=#45a436>[Uế Thổ: Dư Chấn]</div>',
['语言_ski_pa1_d_723703']='Bắt đầu mỗi vòng đấu Madara dùng <div fontcolor=#45a436>Uế Thổ: Thiên Ngoại Chấn Tinh</div>, gây 2 lần sát thương là sát thương thực cực lớn tổng cộng <div fontcolor=#45a436>295%</div> (vô hiệu hóa giảm sát thương và đỡ đòn của mục tiêu) sát thương đối với tất cả kẻ địch, gây cho 2 kẻ địch ngẫu nhiên 1 lần <div fontcolor=#45a436>[Uế Thổ: Dư Chấn]</div>',
['语言_ski_pa1_d_723704']='Bắt đầu mỗi vòng đấu Madara dùng <div fontcolor=#45a436>Uế Thổ: Thiên Ngoại Chấn Tinh</div>, gây 2 lần sát thương là sát thương thực cực lớn tổng cộng <div fontcolor=#45a436>315%</div> (vô hiệu hóa giảm sát thương và đỡ đòn của mục tiêu) sát thương đối với tất cả kẻ địch, gây cho 2 kẻ địch ngẫu nhiên 1 lần <div fontcolor=#45a436>[Uế Thổ: Dư Chấn]</div>',
['语言_ski_pa1_d_723705']='Bắt đầu mỗi vòng đấu Madara dùng <div fontcolor=#45a436>Uế Thổ: Thiên Ngoại Chấn Tinh</div>, gây 2 lần sát thương là sát thương thực cực lớn tổng cộng <div fontcolor=#45a436>335%</div> (vô hiệu hóa giảm sát thương và đỡ đòn của mục tiêu) sát thương đối với tất cả kẻ địch, gây cho 2 kẻ địch ngẫu nhiên 1 lần <div fontcolor=#45a436>[Uế Thổ: Dư Chấn]</div>',

['语言_ski_pa1_d_723702_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>114%</div>',
['语言_ski_pa1_d_723703_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>125%</div>, hiệu ứng cường hóa<div fontcolor=#45a436>gây thêm 296% sát thương thể thuật lên mục tiêu mang nhiều tầng [Ấn khắc sét mòn] nhất</div>',
['语言_ski_pa1_d_723704_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>137%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>335%</div>',
['语言_ski_pa1_d_723705_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>150%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>374%</div>, thêm<div fontcolor=#45a436>hồi phục 1 điểm nộ khí cho toàn bộ sau khi thi triển kỹ năng</div>',
['语言_ski_pa1_d_723261']='Hiệu ứng này cũng kích hoạt 1 lượt khi thấp hơn 20% tổng HP',
['语言_ski_pa1_d_723351']='[Thần uy: Phán quyết] Thời gian CD giảm 1 nửa',

['语言_ski_ot_pa_72301']='Uế Thổ: Phá Giáp',
['语言_ski_ot_pa_d_72301'] = 'Giảm 75% phòng thủ và 50% giảm thương của đơn vị bị debuff, kéo dài trong 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_72391']='Uế Thổ: Thiêu Đốt',
['语言_ski_ot_pa_d_72391'] = 'Sức mạnh thiêu đốt cao cấp, mỗi lượt kẻ địch chịu tổn thất đi lượng máu tương ứng với 35% ATK của người thi triển, có thể cộng dồn nhiều nhất 3 tầng kéo dài 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_723101']='Ảo Thuật Tsukuyomi',
['语言_ski_ot_pa_d_723101'] = 'Đơn vị bị ảnh hưởng bởi Ảo Thuật Tsukuyomi không thể hành động trong 1 lượt. Không thể bị xóa bỏ',

['语言_ski_ot_pa_72321']='Năng Lượng Susanoo',
['语言_ski_ot_pa_d_72321'] = 'Mỗi tầng cộng dồn 3% ATK và Giảm Thương, tối đa 15 tầng không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_723011']='Hộ Vệ Susannoo',
['语言_ski_ot_pa_d_723011'] = 'Đơn vị có Hộ Vệ Susannoo khi chiến đấu nó giúp cho người mang miễn dịch hiệu ứng xấu, cung cấp 50% ATK của Madara và 50% Giảm Thương & 30% Phòng Thủ, hiệu ứng không thể bị loại bỏ',

['语言_ski_ot_pa_72322']='Susanoo Chiến Ý',
['语言_ski_ot_pa_d_72322']='Mỗi cộng dồn tăng 3% ATK và CRIT tối đa 10 tầng, không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_723501']='Uế Thổ: Dư Chấn',
['语言_ski_ot_pa_d_723501']='Đơn vị mang trạng thái này không thể phân biệt địch ta, sẽ sử dụng tấn công thường tấn công ngẫu nhiên bất kỳ mục tiêu trên chiến trường, duy trì trong 1 hiệp và không thể bị xóa bỏ',

['语言_ski_pa1_409001']='Tấn công thường',
['语言_ski_pa1_409101']='Asakujaku / Hirudora',
['语言_ski_pa1_409201']='Bát môn độn giáp',
['语言_ski_pa1_409301']='Sekizo/Night Guy',
['语言_ski_pa1_409401']='Đỉnh cao của niềm đam mê tuổi trẻ',
['语言_ski_pa1_409501']='Phượng hoàng đêm',
['语言_ski_pa1_409601']='Ta, Madara, công nhận ngươi là người mạnh nhất!',
['语言_ski_pa1_409701']='Team Guy',
['语言_ski_pa1_409901']='Thần thoại nhẫn giới',
['语言_ski_pa1_d_409101']='Đối với tất cả đơn vị địch gây<div fontcolor=#45a436>sát thương thực</div>bằng<div vote=000002>7%</div>giới hạn HP của Guy, và thêm [Quyết đấu] lên nó, sau đó thêm [Máu sắt] cho bản thân;\n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với tất cả kẻ địch (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>160%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, sau đó thêm [Cháy lên nào!] cho bản thân',
['语言_ski_pa1_d_409102']='Đối với tất cả đơn vị địch gây<div fontcolor=#45a436>sát thương thực</div>bằng<div vote=000002>10%</div>giới hạn HP của Guy, và thêm [Quyết đấu] lên nó, sau đó thêm [Máu sắt] cho bản thân;\n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với tất cả kẻ địch (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>190%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, sau đó thêm [Cháy lên nào!] cho bản thân',
['语言_ski_pa1_d_409103']='Đối với tất cả đơn vị địch gây<div fontcolor=#45a436>sát thương thực</div>bằng<div vote=000002>14%</div>giới hạn HP của Guy, và thêm [Quyết đấu] lên nó, sau đó thêm [Máu sắt] cho bản thân;\n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với tất cả kẻ địch (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>225%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, sau đó thêm [Cháy lên nào!] cho bản thân',
['语言_ski_pa1_d_409104']='Đối với tất cả đơn vị địch gây<div fontcolor=#45a436>sát thương thực</div>bằng<div vote=000002>19%</div>giới hạn HP của Guy, và thêm [Quyết đấu] lên nó, sau đó thêm [Máu sắt] cho bản thân;\n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với tất cả kẻ địch (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>265%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, sau đó thêm [Cháy lên nào!] cho bản thân',
['语言_ski_pa1_d_409201']='HP +<div fontcolor=#45a436>30%</div>, ATK +<div fontcolor=#45a436>20%</div>.\nKhi bắt đầu lượt, áp dụng [Passionate Coaching] cho toàn bộ đồng minh. Hiệu ứng này chia đều toàn bộ sát thương nhận từ các đòn tấn công chủ động cho các đồng minh. Đơn vị có HP dưới 60% chỉ phải chịu <div fontcolor=#45a436>60%</div> sát thương chia sẻ. Sát thương chia sẻ này không thể khiến HP mục tiêu giảm xuống dưới 10% Giới Hạn HP của chính họ hoặc 10% Giới Hạn HP của Guy (lấy giá trị thấp hơn).',
['语言_ski_pa1_d_409202']='HP +<div fontcolor=#45a436>40%</div>, ATK +<div fontcolor=#45a436>25%</div>.\nKhi bắt đầu lượt, áp dụng [Passionate Coaching] cho toàn bộ đồng minh. Hiệu ứng này chia đều toàn bộ sát thương nhận từ các đòn tấn công chủ động cho các đồng minh. Đơn vị có HP dưới 70% chỉ phải chịu <div fontcolor=#45a436>50%</div> sát thương chia sẻ. Sát thương chia sẻ này không thể khiến HP mục tiêu giảm xuống dưới 15% Giới Hạn HP của chính họ hoặc 15% Giới Hạn HP của Guy (lấy giá trị thấp hơn).',
['语言_ski_pa1_d_409203']='HP +<div fontcolor=#45a436>50%</div>, ATK +<div fontcolor=#45a436>30%</div>.\nKhi bắt đầu lượt, áp dụng [Passionate Coaching] cho toàn bộ đồng minh. Hiệu ứng này chia đều toàn bộ sát thương nhận từ các đòn tấn công chủ động cho các đồng minh. Đơn vị có HP dưới 80% chỉ phải chịu <div fontcolor=#45a436>40%</div> sát thương chia sẻ. Sát thương chia sẻ này không thể khiến HP mục tiêu giảm xuống dưới 20% Giới Hạn HP của chính họ hoặc 20% Giới Hạn HP của Guy (lấy giá trị thấp hơn).',
['语言_ski_pa1_d_409204']='HP +<div fontcolor=#45a436>60%</div>, ATK +<div fontcolor=#45a436>35%</div>, SPD +<div fontcolor=#45a436>10%</div>. Khi bắt đầu lượt, áp dụng [Passionate Coaching] cho toàn bộ đồng minh. Hiệu ứng này chia đều toàn bộ sát thương nhận từ các đòn tấn công chủ động cho các đồng minh. Đơn vị có HP dưới 80% chỉ phải chịu <div fontcolor=#45a436>40%</div> sát thương chia sẻ. Sát thương chia sẻ này không thể khiến HP mục tiêu giảm xuống dưới 20% Giới Hạn HP của chính họ hoặc 20% Giới Hạn HP của Guy (lấy giá trị thấp hơn).',
['语言_ski_pa1_d_409301']='Đối với toàn bộ phe địch gây sát thương thực bằng<div fontcolor=#45a436>8%</div>giới hạn HP<div vote=000002>của Guy</div>, thêm [Sekizo nhất tốc] cho<div fontcolor=#45a436>1</div>đơn vị phe ta có ATK cao nhất. \n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với 1 kẻ địch có HP thấp nhất (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>180%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, khi tiêu diệt mục tiêu có nhiều nhất 1 lượt thi triển lại kỹ năng này với 50% sát thương',
['语言_ski_pa1_d_409302']='Đối với toàn bộ phe địch gây sát thương thực bằng<div fontcolor=#45a436>10%</div>giới hạn HP<div vote=000002>của Guy</div>, thêm [Sekizo nhất tốc] cho<div fontcolor=#45a436>2</div>đơn vị phe ta có ATK cao nhất. \n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với 1 kẻ địch có HP thấp nhất (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>215%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, khi tiêu diệt mục tiêu có nhiều nhất 1 lượt thi triển lại kỹ năng này với 50% sát thương',
['语言_ski_pa1_d_409303']='Đối với toàn bộ phe địch gây sát thương thực bằng<div fontcolor=#45a436>12%</div>giới hạn HP<div vote=000002>của Guy</div>, thêm [Sekizo nhất tốc] cho<div fontcolor=#45a436>3</div>đơn vị phe ta có ATK cao nhất. \n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với 1 kẻ địch có HP thấp nhất (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>260%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, khi tiêu diệt mục tiêu có nhiều nhất 1 lượt thi triển lại kỹ năng này với 50% sát thương',
['语言_ski_pa1_d_409304']='Đối với toàn bộ phe địch gây sát thương thực bằng<div fontcolor=#45a436>14%</div>giới hạn HP<div vote=000002>của Guy</div>, thêm [Sekizo nhất tốc] cho<div fontcolor=#45a436>toàn bộ</div>đơn vị phe ta có ATK cao nhất. \n Khi bản thân trong [Tử môn: Giải phóng]:\n Đối với 1 kẻ địch có HP thấp nhất (ưu tiên Ninja không phải đỡ đòn) gây sát thương thực bằng<div fontcolor=#45a436>315%</div>ATK của Guy+<div fontcolor=#45a436>5%</div>giới hạn HP mục tiêu (không quá 500% ATK bản thân), mục tiêu bị<div vote=000029>áp chế</div>trong thời gian kỹ năng này, khi tiêu diệt mục tiêu có nhiều nhất 1 lượt thi triển lại kỹ năng này với 50% sát thương',
['语言_ski_pa1_d_409401']='Trong chiến đấu, khi HP toàn bộ đồng đội thấp hơn 70%, lập tức xóa bỏ toàn bộ Debuff bản thân mang, giải trừ kết giới Debuff trên trận địa phe ta và kết giới Buff trên trận địa phe địch, hồi phục<div fontcolor=#45a436>50%</div>giới hạn HP, nhận [Tử môn: Giải phóng] và [Vô địch] trong 1 hiệp, đêm hiệu ứng [Chỉ đạo nhiệt huyết]<div vote=000040>thăng cấp</div>2 hiệp, dựa theo<div vote=000030>thuộc tính cơ bản</div>của bản thân đển hận ATK, tương đương<div fontcolor=#45a436>4% HP lớn nhất+5000% DEF</div>',
['语言_ski_pa1_d_409402']='Trong chiến đấu, khi HP toàn bộ đồng đội thấp hơn 70%, lập tức xóa bỏ toàn bộ Debuff bản thân mang, giải trừ kết giới Debuff trên trận địa phe ta và kết giới Buff trên trận địa phe địch, hồi phục<div fontcolor=#45a436>60%</div>giới hạn HP, nhận [Tử môn: Giải phóng] và [Vô địch] trong 1 hiệp, đêm hiệu ứng [Chỉ đạo nhiệt huyết]<div vote=000040>thăng cấp</div>2 hiệp, dựa theo<div vote=000030>thuộc tính cơ bản</div>của bản thân đển hận ATK, tương đương<div fontcolor=#45a436>6% HP lớn nhất+6000% DEF</div>',
['语言_ski_pa1_d_409403']='Trong chiến đấu, khi HP toàn bộ đồng đội thấp hơn 70%, lập tức xóa bỏ toàn bộ Debuff bản thân mang, giải trừ kết giới Debuff trên trận địa phe ta và kết giới Buff trên trận địa phe địch, hồi phục<div fontcolor=#45a436>70%</div>giới hạn HP, nhận [Tử môn: Giải phóng] và [Vô địch] trong 1 hiệp, đêm hiệu ứng [Chỉ đạo nhiệt huyết]<div vote=000040>thăng cấp</div>2 hiệp, dựa theo<div vote=000030>thuộc tính cơ bản</div>của bản thân đển hận ATK, tương đương<div fontcolor=#45a436>8% HP lớn nhất+7000% DEF</div>',
['语言_ski_pa1_d_409404']='Trong chiến đấu, khi HP toàn bộ đồng đội thấp hơn 70%, lập tức xóa bỏ toàn bộ Debuff bản thân mang, giải trừ kết giới Debuff trên trận địa phe ta và kết giới Buff trên trận địa phe địch, hồi phục<div fontcolor=#45a436>80%</div>giới hạn HP, nhận [Tử môn: Giải phóng] và [Vô địch] trong 1 hiệp, đêm hiệu ứng [Chỉ đạo nhiệt huyết]<div vote=000040>thăng cấp</div>2 hiệp, dựa theo<div vote=000030>thuộc tính cơ bản</div>của bản thân đển hận ATK, tương đương<div fontcolor=#45a436>10% HP lớn nhất+8000% DEF</div>',
['语言_ski_pa1_d_409901']='HP tăng<div fontcolor=#45a436>10%</div>, ATK tăng<div fontcolor=#45a436>5%</div>, DMG REDUC tăng<div fontcolor=#45a436>15%</div>(bất kể có trang bị Aura này hay không thì bộ phận hiệu ứng đều có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, kháng bạo và CRIT, và [200+20*số Ninja MR] SPD',
['语言_ski_pa1_d_409902']='HP tăng<div fontcolor=#45a436>13%</div>, ATK tăng<div fontcolor=#45a436>8%</div>, DMG REDUC tăng<div fontcolor=#45a436>17%</div>(bất kể có trang bị Aura này hay không thì bộ phận hiệu ứng đều có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, kháng bạo và CRIT, và [200+20*số Ninja MR] SPD',
['语言_ski_pa1_d_409903']='HP tăng<div fontcolor=#45a436>15%</div>, ATK tăng<div fontcolor=#45a436>10%</div>, DMG REDUC tăng<div fontcolor=#45a436>18%</div>(bất kể có trang bị Aura này hay không thì bộ phận hiệu ứng đều có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, kháng bạo và CRIT, và [200+20*số Ninja MR] SPD',
['语言_ski_pa1_d_409904']='HP tăng<div fontcolor=#45a436>17%</div>, ATK tăng<div fontcolor=#45a436>12%</div>, DMG REDUC tăng<div fontcolor=#45a436>19%</div>(bất kể có trang bị Aura này hay không thì bộ phận hiệu ứng đều có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, kháng bạo và CRIT, và [200+20*số Ninja MR] SPD',
['语言_ski_pa1_d_409905']='HP tăng<div fontcolor=#45a436>20%</div>, ATK tăng<div fontcolor=#45a436>15%</div>, DMG REDUC tăng<div fontcolor=#45a436>20%</div>(bất kể có trang bị Aura này hay không thì bộ phận hiệu ứng đều có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, kháng bạo và CRIT, và [200+20*số Ninja MR] SPD',
['语言_ski_pa1_d_409601']='Khi bản thân trên chiến trường, tăng [<div fontcolor=#45a436>10%+2%*số Ninja chất lượng MR và trở lên</div>] DMG REDUC và kháng bạo',
['语言_ski_pa1_d_409602']='Khi bản thân trên chiến trường, tăng [<div fontcolor=#45a436>15%+2%*số Ninja chất lượng MR và trở lên</div>] DMG REDUC và kháng bạo',
['语言_ski_pa1_d_409603']='Khi bản thân trên chiến trường, tăng [<div fontcolor=#45a436>20%+2%*số Ninja chất lượng MR và trở lên</div>] DMG REDUC và kháng bạo',
['语言_ski_pa1_d_409701']='Đối với toàn bộ phe địch gây tổng<div fontcolor=#45a436>521%</div>sát thương thể thuật, do toàn bộ đơn vị phe địc cùng gánh chịu, nếu chỉ có 1 mục tiêu thì chuyển thành gây 400% sát thương thể thuật, sau đó thêm [Bảo hộ hồn cháy] cho 1 đơn vị phe ta có HP thấp nhất ngoại trừ bản thân',
['语言_ski_pa1_d_409702']='Đối với toàn bộ phe địch gây tổng<div fontcolor=#45a436>571%</div>sát thương thể thuật, do toàn bộ đơn vị phe địc cùng gánh chịu, nếu chỉ có 1 mục tiêu thì chuyển thành gây 400% sát thương thể thuật, sau đó thêm [Bảo hộ hồn cháy] cho 1 đơn vị phe ta có HP thấp nhất ngoại trừ bản thân',
['语言_ski_pa1_d_409703']='Đối với toàn bộ phe địch gây tổng<div fontcolor=#45a436>625%</div>sát thương thể thuật, do toàn bộ đơn vị phe địc cùng gánh chịu, nếu chỉ có 1 mục tiêu thì chuyển thành gây 400% sát thương thể thuật, sau đó thêm [Bảo hộ hồn cháy] cho<div fontcolor=#45a436>1</div>đơn vị phe ta có HP thấp nhất ngoại trừ bản thân, thêm cho bản thân<div fontcolor=#45a436>[Thanh xuân!] trong 1 hiệp </div>',
['语言_ski_pa1_d_409704']='Đối với toàn bộ phe địch gây tổng<div fontcolor=#45a436>686%</div>sát thương thể thuật, do toàn bộ đơn vị phe địc cùng gánh chịu, nếu chỉ có 1 mục tiêu thì chuyển thành gây 400% sát thương thể thuật, sau đó thêm [Bảo hộ hồn cháy] cho<div fontcolor=#45a436>1</div>đơn vị phe ta có HP thấp nhất ngoại trừ bản thân, thêm cho bản thân<div fontcolor=#45a436>[Thanh xuân!] trong 1 hiệp </div>',
['语言_ski_pa1_d_409705']='Đối với toàn bộ phe địch gây tổng<div fontcolor=#45a436>751%</div>sát thương thể thuật, do toàn bộ đơn vị phe địc cùng gánh chịu, nếu chỉ có 1 mục tiêu thì chuyển thành gây 400% sát thương thể thuật, sau đó thêm [Bảo hộ hồn cháy] cho<div fontcolor=#45a436>2</div>đơn vị phe ta có HP thấp nhất ngoại trừ bản thân, thêm cho bản thân<div fontcolor=#45a436>[Thanh xuân!] trong 2 hiệp </div>',
['语言_ski_pa1_d_409702_1']='DMG tăng đến<div fontcolor=#45a436>571%</div>, biên độ kích hoạt [Bảo hộ hồn cháy] tăng đến<div fontcolor=#45a436>20%</div>',
['语言_ski_pa1_d_409703_1']='DMG tăng đến<div fontcolor=#45a436>626%</div>, biên độ kích hoạt [Bảo hộ hồn cháy] tăng đến<div fontcolor=#45a436>25%</div>, thêm cho bản thân<div fontcolor=#45a436>[Thanh xuân!]</div>',
['语言_ski_pa1_d_409704_1']='DMG tăng đến<div fontcolor=#45a436>686%</div>, biên độ kích hoạt [Bảo hộ hồn cháy] tăng đến<div fontcolor=#45a436>30%</div>, tỷ lệ Heal của [Thanh xuân!] tăng đến<div fontcolor=#45a436>10%</div>',
['语言_ski_pa1_d_409705_1']='DMG tăng đến<div fontcolor=#45a436>751%</div>, biên độ kích hoạt [Bảo hộ hồn cháy] tăng đến<div fontcolor=#45a436>35%</div>, bây giờ [Thanh xuân!]<div fontcolor=#45a436>duy trì 2 hiệp</div>',
['语言_ski_pa1_d_409261']='Thêm [Hộ thuẫn-Hàng chắn] cho mục tiêu',
['语言_ski_pa1_d_409351']='Thời gian CD [Sekizo/Night Guy] giảm 1 nửa',
