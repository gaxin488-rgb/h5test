['语言_ski_pa1_d_724705']='Bắt đầu mỗi vòng đấu Tobirama dùng <div fontcolor=#45a436>Truy Kích: Thủy Long Đạn</div>, Tăng cường vĩnh viễn đòn đánh thường của Thủy Long Ngâm · Tobirama, khi đánh thường gây đòn tấn công thứ 2 và gây tổng 150% sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa trên 1 mục tiêu không vượt quá 100%); khi Thủy Long Ngâm · Tobirama mang trạng thái [Cảm Giác Chakra] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao trạng thái [Cảm Giác Chakra] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',

['语言_ski_pa1_d_724702_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>114%</div>',
['语言_ski_pa1_d_724703_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>125%</div>, hiệu ứng cường hóa<div fontcolor=#45a436>gây thêm 296% sát thương thể thuật lên mục tiêu mang nhiều tầng [Ấn khắc sét mòn] nhất</div>',
['语言_ski_pa1_d_724704_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>137%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>335%</div>',
['语言_ski_pa1_d_724705_1']='Sát thương cơ bản tăng đến<div fontcolor=#45a436>150%</div>, sát thương thêm tăng đến<div fontcolor=#45a436>374%</div>, thêm<div fontcolor=#45a436>hồi phục 1 điểm nộ khí cho toàn bộ sau khi thi triển kỹ năng</div>',
['语言_ski_pa1_d_724261']='Hiệu ứng này cũng kích hoạt 1 lượt khi thấp hơn 20% tổng HP',
['语言_ski_pa1_d_724351']='[Thần uy: Phán quyết] Thời gian CD giảm 1 nửa',

['语言_ski_ot_pa_72401']='Uế Thổ: Phá Giáp',
['语言_ski_ot_pa_d_72401'] = 'Giảm 75% phòng thủ và 50% giảm thương của đơn vị bị debuff, kéo dài trong 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_72491']='Uế Thổ: Thiêu Đốt',
['语言_ski_ot_pa_d_72491'] = 'Sức mạnh thiêu đốt cao cấp, mỗi lượt kẻ địch chịu tổn thất đi lượng máu tương ứng với 35% ATK của người thi triển, có thể cộng dồn nhiều nhất 3 tầng kéo dài 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_724101']='Ảo Thuật Tsukuyomi',
['语言_ski_ot_pa_d_724101'] = 'Đơn vị bị ảnh hưởng bởi Ảo Thuật Tsukuyomi không thể hành động trong 1 lượt. Không thể bị xóa bỏ',

['语言_ski_ot_pa_72421']='Năng Lượng Susanoo',
['语言_ski_ot_pa_d_72421'] = 'Mỗi tầng cộng dồn 3% ATK và Giảm Thương, tối đa 15 tầng không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_724011']='Hộ Vệ Susannoo',
['语言_ski_ot_pa_d_724011'] = 'Đơn vị có Hộ Vệ Susannoo khi chiến đấu nó giúp cho người mang miễn dịch hiệu ứng xấu, cung cấp 50% ATK của Madara và 50% Giảm Thương & 30% Phòng Thủ, hiệu ứng không thể bị loại bỏ',

['语言_ski_ot_pa_72422']='Susanoo Chiến Ý',
['语言_ski_ot_pa_d_72422']='Mỗi cộng dồn tăng 3% ATK và CRIT tối đa 10 tầng, không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_724501']='Uế Thổ: Dư Chấn',
['语言_ski_ot_pa_d_724501']='Đơn vị mang trạng thái này không thể phân biệt địch ta, sẽ sử dụng tấn công thường tấn công ngẫu nhiên bất kỳ mục tiêu trên chiến trường, duy trì trong 1 hiệp và không thể bị xóa bỏ',

['语言_ski_pa1_726001'] = 'ATK thường',
['语言_ski_pa1_726101'] = 'Jougan: Không Gian Ba Động',
['语言_ski_pa1_726201'] = 'Boruto Uzumaki',
['语言_ski_pa1_726301'] = 'Jougan: Xuyên Không Kích',
['语言_ski_pa1_726401'] = 'Thức Tỉnh Jougan',
['语言_ski_pa1_726501'] = 'Jougan: Thiên Không Hủy Diệt',
['语言_ski_pa1_726601'] = 'Boruto – Đại Jougan Bạo Phá',
['语言_ski_pa1_726701'] = 'Truy Kích: Jougan Xuyên Ảnh',
['语言_ski_pa1_726901'] = 'Jougan – Vận Mệnh Chuyển Sinh',

['语言_ski_pa1_d_726101'] = 'Khi tung kỹ năng, Boruto nhận <div fontcolor=#45a436>50%</div> Hút Máu kỹ năng và có <div fontcolor=#45a436>100%</div> Giảm Sát Thương cùng <div fontcolor=#45a436>50%</div> Phòng Thủ, đồng thời tăng thêm <div fontcolor=#45a436>100%</div> Chính Xác. Kỹ năng gây <div fontcolor=#45a436>355%</div> sát thương lên toàn bộ kẻ địch và kèm sát thương theo % HP (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu) tương ứng với <div fontcolor=#45a436>30%</div> Giới Hạn Sinh Mệnh của tất cả kẻ địch. Đồng thời xóa trạng thái có lợi của 2 mục tiêu và gây debuff <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> lên toàn bộ mục tiêu, cộng thêm 1 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div>. Toàn bộ phe ta nhận <div fontcolor=#45a436>50%</div> Giảm Sát Thương và <div fontcolor=#45a436>50%</div> Phòng Thủ',
['语言_ski_pa1_d_726102'] = 'Khi tung kỹ năng, Boruto nhận <div fontcolor=#45a436>50%</div> Hút Máu kỹ năng và có <div fontcolor=#45a436>100%</div> Giảm Sát Thương cùng <div fontcolor=#45a436>50%</div> Phòng Thủ, đồng thời tăng thêm <div fontcolor=#45a436>100%</div> Chính Xác. Kỹ năng gây <div fontcolor=#45a436>365%</div> sát thương lên toàn bộ kẻ địch và kèm sát thương theo % HP (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu) tương ứng với <div fontcolor=#45a436>30%</div> Giới Hạn Sinh Mệnh của tất cả kẻ địch. Đồng thời xóa trạng thái có lợi của 2 mục tiêu và gây debuff <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> lên toàn bộ mục tiêu, cộng thêm 2 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div>. Toàn bộ phe ta nhận <div fontcolor=#45a436>50%</div> Giảm Sát Thương và <div fontcolor=#45a436>50%</div> Phòng Thủ',
['语言_ski_pa1_d_726103'] = 'Khi tung kỹ năng, Boruto nhận <div fontcolor=#45a436>50%</div> Hút Máu kỹ năng và có <div fontcolor=#45a436>100%</div> Giảm Sát Thương cùng <div fontcolor=#45a436>50%</div> Phòng Thủ, đồng thời tăng thêm <div fontcolor=#45a436>100%</div> Chính Xác. Kỹ năng gây <div fontcolor=#45a436>375%</div> sát thương lên toàn bộ kẻ địch và kèm sát thương theo % HP (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu) tương ứng với <div fontcolor=#45a436>30%</div> Giới Hạn Sinh Mệnh của tất cả kẻ địch. Đồng thời xóa trạng thái có lợi của 2 mục tiêu và gây debuff <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> lên toàn bộ mục tiêu, cộng thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div>. Toàn bộ phe ta nhận <div fontcolor=#45a436>50%</div> Giảm Sát Thương và <div fontcolor=#45a436>50%</div> Phòng Thủ',
['语言_ski_pa1_d_726104'] = 'Khi tung kỹ năng, Boruto nhận <div fontcolor=#45a436>50%</div> Hút Máu kỹ năng và có <div fontcolor=#45a436>100%</div> Giảm Sát Thương cùng <div fontcolor=#45a436>50%</div> Phòng Thủ, đồng thời tăng thêm <div fontcolor=#45a436>100%</div> Chính Xác. Kỹ năng gây <div fontcolor=#45a436>385%</div> sát thương lên toàn bộ kẻ địch và kèm sát thương theo % HP (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu) tương ứng với <div fontcolor=#45a436>30%</div> Giới Hạn Sinh Mệnh của tất cả kẻ địch. Đồng thời xóa trạng thái có lợi của 2 mục tiêu và gây debuff <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> lên toàn bộ mục tiêu, cộng thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div>. Toàn bộ phe ta nhận <div fontcolor=#45a436>50%</div> Giảm Sát Thương và <div fontcolor=#45a436>50%</div> Phòng Thủ',

['语言_ski_pa1_d_726201'] = 'Bạo Kích và ATK tăng <div fontcolor=#45a436>30%</div>, HP tăng <div fontcolor=#45a436>20%</div>; Khi bắt đầu chiến đấu, Boruto ban cho toàn bộ phe ta <div fontcolor=#45a436>[Áo Choàng Chakra Jougan]</div>. Mỗi lần Boruto chịu sát thương chí mạng, tích lũy 1 tầng <div fontcolor=#45a436>[Giáp Chakra]</div>, tối đa 10 tầng',
['语言_ski_pa1_d_726202'] = 'Bạo Kích và ATK tăng <div fontcolor=#45a436>40%</div>, HP tăng <div fontcolor=#45a436>30%</div>; Khi bắt đầu chiến đấu, Boruto ban cho toàn bộ phe ta <div fontcolor=#45a436>[Áo Choàng Chakra Jougan]</div>. Mỗi lần Boruto chịu sát thương chí mạng, tích lũy 1 tầng <div fontcolor=#45a436>[Giáp Chakra]</div>, tối đa 10 tầng',
['语言_ski_pa1_d_726203'] = 'Bạo Kích và ATK tăng <div fontcolor=#45a436>50%</div>, HP tăng <div fontcolor=#45a436>40%</div>; Khi bắt đầu chiến đấu, Boruto ban cho toàn bộ phe ta <div fontcolor=#45a436>[Áo Choàng Chakra Jougan]</div>. Mỗi lần Boruto chịu sát thương chí mạng, tích lũy 1 tầng <div fontcolor=#45a436>[Giáp Chakra]</div>, tối đa 10 tầng',
['语言_ski_pa1_d_726204'] = 'Bạo Kích và ATK tăng <div fontcolor=#45a436>60%</div>, HP tăng <div fontcolor=#45a436>50%</div>; Khi bắt đầu chiến đấu, Boruto ban cho toàn bộ phe ta <div fontcolor=#45a436>[Áo Choàng Chakra Jougan]</div>. Mỗi lần Boruto chịu sát thương chí mạng, tích lũy 1 tầng <div fontcolor=#45a436>[Giáp Chakra]</div>, tối đa 10 tầng',

['语言_ski_pa1_d_726301'] = 'Boruto giải trừ mọi hiệu ứng bất lợi trên bản thân, sau đó thi triển Jougan: Xuyên Không Kích Đạn gây tổng cộng 3 lần sát thương thực theo % HP kẻ địch (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu), tổng cộng <div fontcolor=#45a436>800%</div> sát thương và bỏ qua <div fontcolor=#45a436>100%</div> Phòng Thủ của kẻ địch. Nếu mục tiêu dưới <div fontcolor=#45a436>20%</div> HP sẽ bị tiêu diệt ngay lập tức. Đồng thời phong ấn toàn bộ kẻ địch bằng <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> và thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div> cho tất cả chúng. Boruto nhận <div fontcolor=#45a436>[Cảm Giác Jougan]</div>',
['语言_ski_pa1_d_726302'] = 'Boruto giải trừ mọi hiệu ứng bất lợi trên bản thân, sau đó thi triển Jougan: Xuyên Không Kích gây tổng cộng 3 lần sát thương thực theo % HP kẻ địch (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu), tổng cộng <div fontcolor=#45a436>800%</div> sát thương và bỏ qua <div fontcolor=#45a436>100%</div> Phòng Thủ của kẻ địch. Nếu mục tiêu dưới <div fontcolor=#45a436>20%</div> HP sẽ bị tiêu diệt ngay lập tức. Đồng thời phong ấn toàn bộ kẻ địch bằng <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> và thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div> cho tất cả chúng. Boruto nhận <div fontcolor=#45a436>[Cảm Giác Jougan]</div>',
['语言_ski_pa1_d_726303'] = 'Boruto giải trừ mọi hiệu ứng bất lợi trên bản thân, sau đó thi triển Jougan: Xuyên Không Kích gây tổng cộng 3 lần sát thương thực theo % HP kẻ địch (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu), tổng cộng <div fontcolor=#45a436>800%</div> sát thương và bỏ qua <div fontcolor=#45a436>100%</div> Phòng Thủ của kẻ địch. Nếu mục tiêu dưới <div fontcolor=#45a436>20%</div> HP sẽ bị tiêu diệt ngay lập tức. Đồng thời phong ấn toàn bộ kẻ địch bằng <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> và thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div> cho tất cả chúng. Boruto nhận <div fontcolor=#45a436>[Cảm Giác Jougan]</div>',
['语言_ski_pa1_d_726304'] = 'Boruto giải trừ mọi hiệu ứng bất lợi trên bản thân, sau đó thi triển Jougan: Xuyên Không Kích gây tổng cộng 3 lần sát thương thực theo % HP kẻ địch (vô hiệu Giảm Sát Thương và Đỡ Đòn của mục tiêu), tổng cộng <div fontcolor=#45a436>800%</div> sát thương và bỏ qua <div fontcolor=#45a436>100%</div> Phòng Thủ của kẻ địch. Nếu mục tiêu dưới <div fontcolor=#45a436>20%</div> HP sẽ bị tiêu diệt ngay lập tức. Đồng thời phong ấn toàn bộ kẻ địch bằng <div fontcolor=#45a436>[Phong Ấn Không Gian]</div> và thêm 3 tầng <div fontcolor=#45a436>[Jougan: Bào Mòn Chakra]</div> cho tất cả chúng. Boruto nhận <div fontcolor=#45a436>[Cảm Giác Jougan]</div>',

['语言_ski_pa1_d_726401'] = 'Khi bắt đầu trận đấu, Boruto ban cho tất cả đồng đội <div fontcolor=#45a436>[Chakra Kế Thừa]</div> và các đồng minh cùng tộc hệ <div fontcolor=#45a436>[Cảm Giác Jougan]</div>. Khi HP của bản thân thấp hơn <div fontcolor=#45a436>50%</div>, Boruto lập tức nhận <div fontcolor=#45a436>100%</div> Né Tránh và <div fontcolor=#45a436>50%</div> Giảm Sát Thương trong 1 hiệp, đồng thời hồi phục <div fontcolor=#45a436>35%</div> HP tối đa cho bản thân',
['语言_ski_pa1_d_726402'] = 'Khi bắt đầu trận đấu, Boruto ban cho tất cả đồng đội <div fontcolor=#45a436>[Chakra Kế Thừa]</div> và các đồng minh cùng tộc hệ <div fontcolor=#45a436>[Cảm Giác Jougan]</div>. Khi HP của bản thân thấp hơn <div fontcolor=#45a436>50%</div>, Boruto lập tức nhận <div fontcolor=#45a436>100%</div> Né Tránh và <div fontcolor=#45a436>50%</div> Giảm Sát Thương trong 1 hiệp, đồng thời hồi phục <div fontcolor=#45a436>35%</div> HP tối đa cho bản thân',
['语言_ski_pa1_d_726403'] = 'Khi bắt đầu trận đấu, Boruto ban cho tất cả đồng đội <div fontcolor=#45a436>[Chakra Kế Thừa]</div> và các đồng minh cùng tộc hệ <div fontcolor=#45a436>[Cảm Giác Jougan]</div>. Khi HP của bản thân thấp hơn <div fontcolor=#45a436>50%</div>, Boruto lập tức nhận <div fontcolor=#45a436>100%</div> Né Tránh và <div fontcolor=#45a436>50%</div> Giảm Sát Thương trong 1 hiệp, đồng thời hồi phục <div fontcolor=#45a436>35%</div> HP tối đa cho bản thân',
['语言_ski_pa1_d_726404'] = 'Khi bắt đầu trận đấu, Boruto ban cho tất cả đồng đội <div fontcolor=#45a436>[Chakra Kế Thừa]</div> và các đồng minh cùng tộc hệ <div fontcolor=#45a436>[Cảm Giác Jougan]</div>. Khi HP của bản thân thấp hơn <div fontcolor=#45a436>50%</div>, Boruto lập tức nhận <div fontcolor=#45a436>100%</div> Né Tránh và <div fontcolor=#45a436>50%</div> Giảm Sát Thương trong 1 hiệp, đồng thời hồi phục <div fontcolor=#45a436>35%</div> HP tối đa cho bản thân',

['语言_ski_pa1_d_726901'] = 'ATK tăng <div fontcolor=#45a436>10%</div>, HP tăng <div fontcolor=#45a436>5%</div>, DMG tăng <div fontcolor=#45a436>15%</div> (bất kể có trang bị Aura này hay không thì hiệu ứng vẫn có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, Kháng Bạo và CRIT, và [200+20* số Ninja MR] SPD',
['语言_ski_pa1_d_726902'] = 'ATK tăng <div fontcolor=#45a436>13%</div>, HP tăng <div fontcolor=#45a436>8%</div>, DMG tăng <div fontcolor=#45a436>17%</div> (bất kể có trang bị Aura này hay không thì hiệu ứng vẫn có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, Kháng Bạo và CRIT, và [200+20* số Ninja MR] SPD',
['语言_ski_pa1_d_726903'] = 'ATK tăng <div fontcolor=#45a436>15%</div>, HP tăng <div fontcolor=#45a436>10%</div>, DMG tăng <div fontcolor=#45a436>18%</div> (bất kể có trang bị Aura này hay không thì hiệu ứng vẫn có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, Kháng Bạo và CRIT, và [200+20* số Ninja MR] SPD',
['语言_ski_pa1_d_726904'] = 'ATK tăng <div fontcolor=#45a436>17%</div>, HP tăng <div fontcolor=#45a436>12%</div>, DMG tăng <div fontcolor=#45a436>19%</div> (bất kể có trang bị Aura này hay không thì hiệu ứng vẫn có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, Kháng Bạo và CRIT, và [200+20* số Ninja MR] SPD',
['语言_ski_pa1_d_726905'] = 'ATK tăng <div fontcolor=#45a436>20%</div>, HP tăng <div fontcolor=#45a436>15%</div>, DMG tăng <div fontcolor=#45a436>20%</div> (bất kể có trang bị Aura này hay không thì hiệu ứng vẫn có tác dụng); Tiến vào chiến đấu, thêm [Thần thoại Ninja] cho toàn bộ phe ta, tăng [10%+1% số Ninja MR] DMG, DMG REDUC, Kháng Bạo và CRIT, và [200+20* số Ninja MR] SPD',

['语言_ski_pa1_d_726601'] = 'Kết thúc mỗi vòng đấu, Boruto thi triển Boruto – Đại Jougan Bạo Phá, gây lượng sát thương lớn (vô hiệu Giảm Sát Thương và Đỡ Đòn) bằng <div fontcolor=#45a436>20%</div> Giới Hạn Sinh Mệnh của toàn bộ phe địch, đồng thời gây thêm 1 tầng <div fontcolor=#45a436>[Suy Kiệt Chakra]</div> cho tất cả kẻ địch',
['语言_ski_pa1_d_726602'] = 'Kết thúc mỗi vòng đấu, Boruto thi triển Boruto – Đại Jougan Bạo Phá, gây lượng sát thương lớn (vô hiệu Giảm Sát Thương và Đỡ Đòn) bằng <div fontcolor=#45a436>20%</div> Giới Hạn Sinh Mệnh của toàn bộ phe địch, đồng thời gây thêm 2 tầng <div fontcolor=#45a436>[Suy Kiệt Chakra]</div> cho tất cả kẻ địch',
['语言_ski_pa1_d_726603'] = 'Kết thúc mỗi vòng đấu, Boruto thi triển Boruto – Đại Jougan Bạo Phá, gây lượng sát thương lớn (vô hiệu Giảm Sát Thương và Đỡ Đòn) bằng <div fontcolor=#45a436>20%</div> Giới Hạn Sinh Mệnh của toàn bộ phe địch, đồng thời gây thêm 3 tầng <div fontcolor=#45a436>[Suy Kiệt Chakra]</div> cho tất cả kẻ địch',

['语言_ski_pa1_d_726701'] = 'Bắt đầu mỗi vòng đấu, Boruto kích hoạt <div fontcolor=#45a436>Truy Kích: Jougan Xuyên Ảnh</div>, tăng cường vĩnh viễn đòn đánh thường của Bạo Phá Jougan · Boruto. Khi đánh thường, gây thêm đòn tấn công thứ 2 và gây tổng <div fontcolor=#45a436>150%</div> sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa lên 1 mục tiêu không vượt quá <div fontcolor=#45a436>100%</div>). Khi Bạo Phá Jougan · Boruto có trạng thái [Cảm Giác Jougan] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao [Cảm Giác Jougan] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',
['语言_ski_pa1_d_726702'] = 'Bắt đầu mỗi vòng đấu, Boruto kích hoạt <div fontcolor=#45a436>Truy Kích: Jougan Xuyên Ảnh</div>, tăng cường vĩnh viễn đòn đánh thường của Bạo Phá Jougan · Boruto. Khi đánh thường, gây thêm đòn tấn công thứ 2 và gây tổng <div fontcolor=#45a436>150%</div> sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa lên 1 mục tiêu không vượt quá <div fontcolor=#45a436>100%</div>). Khi Bạo Phá Jougan · Boruto có trạng thái [Cảm Giác Jougan] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao [Cảm Giác Jougan] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',
['语言_ski_pa1_d_726703'] = 'Bắt đầu mỗi vòng đấu, Boruto kích hoạt <div fontcolor=#45a436>Truy Kích: Jougan Xuyên Ảnh</div>, tăng cường vĩnh viễn đòn đánh thường của Bạo Phá Jougan · Boruto. Khi đánh thường, gây thêm đòn tấn công thứ 2 và gây tổng <div fontcolor=#45a436>150%</div> sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa lên 1 mục tiêu không vượt quá <div fontcolor=#45a436>100%</div>). Khi Bạo Phá Jougan · Boruto có trạng thái [Cảm Giác Jougan] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao [Cảm Giác Jougan] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',
['语言_ski_pa1_d_726704'] = 'Bắt đầu mỗi vòng đấu, Boruto kích hoạt <div fontcolor=#45a436>Truy Kích: Jougan Xuyên Ảnh</div>, tăng cường vĩnh viễn đòn đánh thường của Bạo Phá Jougan · Boruto. Khi đánh thường, gây thêm đòn tấn công thứ 2 và gây tổng <div fontcolor=#45a436>150%</div> sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa lên 1 mục tiêu không vượt quá <div fontcolor=#45a436>100%</div>). Khi Bạo Phá Jougan · Boruto có trạng thái [Cảm Giác Jougan] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao [Cảm Giác Jougan] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',
['语言_ski_pa1_d_726705'] = 'Bắt đầu mỗi vòng đấu, Boruto kích hoạt <div fontcolor=#45a436>Truy Kích: Jougan Xuyên Ảnh</div>, tăng cường vĩnh viễn đòn đánh thường của Bạo Phá Jougan · Boruto. Khi đánh thường, gây thêm đòn tấn công thứ 2 và gây tổng <div fontcolor=#45a436>150%</div> sát thương vật lý lên cả hàng chứa mục tiêu (chia đều cho tất cả đơn vị bị trúng, sát thương tối đa lên 1 mục tiêu không vượt quá <div fontcolor=#45a436>100%</div>). Khi Bạo Phá Jougan · Boruto có trạng thái [Cảm Giác Jougan] và hạ gục mục tiêu bằng bất kỳ cách nào, tiêu hao [Cảm Giác Jougan] để kích hoạt 1 lần [Bạo Hải Thăng Long] truy kích',

['语言_ski_pa1_d_726702_1'] = 'Sát thương cơ bản tăng đến <div fontcolor=#45a436>114%</div>',
['语言_ski_pa1_d_726703_1'] = 'Sát thương cơ bản tăng đến <div fontcolor=#45a436>125%</div>, hiệu ứng cường hóa <div fontcolor=#45a436>gây thêm 296% sát thương thể thuật lên mục tiêu có nhiều tầng [Ấn Khắc Sét Mòn] nhất</div>',
['语言_ski_pa1_d_726704_1'] = 'Sát thương cơ bản tăng đến <div fontcolor=#45a436>137%</div>, sát thương thêm tăng đến <div fontcolor=#45a436>335%</div>',
['语言_ski_pa1_d_726705_1'] = 'Sát thương cơ bản tăng đến <div fontcolor=#45a436>150%</div>, sát thương thêm tăng đến <div fontcolor=#45a436>374%</div>, đồng thời <div fontcolor=#45a436>hồi phục 1 điểm Nộ Khí cho toàn bộ phe ta sau khi thi triển kỹ năng</div>',
['语言_ski_pa1_d_726261'] = 'Hiệu ứng này cũng kích hoạt 1 lượt khi thấp hơn 20% tổng HP',
['语言_ski_pa1_d_726351'] = '[Thần uy: Phán quyết] Thời gian CD giảm 1 nửa',

['语言_ski_ot_pa_72601'] = 'Uế Thổ: Phá Giáp',
['语言_ski_ot_pa_d_72601'] = 'Giảm 75% phòng thủ và 50% giảm thương của đơn vị bị debuff, kéo dài trong 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_72691'] = 'Uế Thổ: Thiêu Đốt',
['语言_ski_ot_pa_d_72691'] = 'Sức mạnh thiêu đốt cao cấp, mỗi lượt kẻ địch chịu tổn thất đi lượng máu tương ứng với 35% ATK của người thi triển, có thể cộng dồn nhiều nhất 3 tầng kéo dài 3 lượt và không thể bị xóa bỏ',

['语言_ski_ot_pa_726101'] = 'Ảo Thuật Tsukuyomi',
['语言_ski_ot_pa_d_726101'] = 'Đơn vị bị ảnh hưởng bởi Ảo Thuật Tsukuyomi không thể hành động trong 1 lượt. Không thể bị xóa bỏ',

['语言_ski_ot_pa_72621'] = 'Năng Lượng Susanoo',
['语言_ski_ot_pa_d_72621'] = 'Mỗi tầng cộng dồn 3% ATK và Giảm Thương, tối đa 15 tầng không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_726011'] = 'Hộ Vệ Susannoo',
['语言_ski_ot_pa_d_726011'] = 'Đơn vị có Hộ Vệ Susannoo khi chiến đấu nó giúp cho người mang miễn dịch hiệu ứng xấu, cung cấp 50% ATK của Madara và 50% Giảm Thương & 30% Phòng Thủ, hiệu ứng không thể bị loại bỏ',

['语言_ski_ot_pa_72622'] = 'Susanoo Chiến Ý',
['语言_ski_ot_pa_d_72622'] = 'Mỗi cộng dồn tăng 3% ATK và CRIT tối đa 10 tầng, không thể bị loại bỏ và kéo dài đến hết trận đấu',

['语言_ski_ot_pa_726501'] = 'Uế Thổ: Dư Chấn',
['语言_ski_ot_pa_d_726501'] = 'Đơn vị mang trạng thái này không thể phân biệt địch ta, sẽ sử dụng tấn công thường tấn công ngẫu nhiên bất kỳ mục tiêu trên chiến trường, duy trì trong 1 hiệp và không thể bị xóa bỏ',



['语言_ski_pa1_727001']='Tấn Công Thường',
['语言_ski_pa1_727101']='Limbo: Ngục Lôi',
['语言_ski_pa1_727201']='Rinne Sharingan',
['语言_ski_pa1_727301']='Thiên Uy: Sao Rơi',
['语言_ski_pa1_727401']='Vô Hạn Tsukuyomi',
['语言_ski_pa1_727501']='Vĩ Thú Ngọc: Thập Vĩ',
['语言_ski_pa1_727601']='Cầu Đạo Ngọc',
['语言_ski_pa1_727701']='Con Tốt',
['语言_ski_pa1_727901']='Mắt Trăng',
['语言_ski_pa1_727811']='Tấn Công Truy Kích',

['语言_ski_pa1_d_727101']='Nhận 50% <div vote=000009>Hút Máu Tạm Thời</div>. Kỹ năng này kích hoạt 1 trong 3 hiệu ứng với xác suất <div fontcolor=#45a436>50%/30%/20%</div>: Thường/Thành Công/Đại Thành Công. \nThường: Gây A.DMG bằng <div fontcolor=#45a436>88%</div> ATK của Madara lên hàng Trước và Giữa của địch, với <div fontcolor=#45a436>50%</div> xác suất áp dụng [Thunder Prison: LR]. \nThành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị. \nĐại Thành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị và cộng thêm A.DMG bằng <div fontcolor=#45a436>4%</div> Giới Hạn HP của mục tiêu (không vượt quá 500% ATK bản thân).',

['语言_ski_pa1_d_727102']='Nhận 50% <div vote=000009>Hút Máu Tạm Thời</div>. Kỹ năng này kích hoạt 1 trong 3 hiệu ứng với xác suất <div fontcolor=#45a436>50%/25%/25%</div>: Thường/Thành Công/Đại Thành Công. \nThường: Gây A.DMG bằng <div fontcolor=#45a436>105%</div> ATK của Madara lên hàng Trước và Giữa của địch, với <div fontcolor=#45a436>60%</div> xác suất áp dụng [Thunder Prison: LR]. \nThành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị. \nĐại Thành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị và cộng thêm A.DMG bằng <div fontcolor=#45a436>6%</div> Giới Hạn HP của mục tiêu (không vượt quá 500% ATK bản thân).',

['语言_ski_pa1_d_727103']='Nhận 50% <div vote=000009>Hút Máu Tạm Thời</div>. Kỹ năng này kích hoạt 1 trong 3 hiệu ứng với xác suất <div fontcolor=#45a436>50%/20%/30%</div>: Thường/Thành Công/Đại Thành Công. \nThường: Gây A.DMG bằng <div fontcolor=#45a436>128%</div> ATK của Madara lên hàng Trước và Giữa của địch, với <div fontcolor=#45a436>70%</div> xác suất áp dụng [Thunder Prison: LR]. \nThành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị. \nĐại Thành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị và cộng thêm A.DMG bằng <div fontcolor=#45a436>8%</div> Giới Hạn HP của mục tiêu (không vượt quá 500% ATK bản thân).',

['语言_ski_pa1_d_727104']='Nhận 50% <div vote=000009>Hút Máu Tạm Thời</div>. Kỹ năng này kích hoạt 1 trong 3 hiệu ứng với xác suất <div fontcolor=#45a436>10%/30%/60%</div>: Thường/Thành Công/Đại Thành Công. \nThường: Gây A.DMG bằng <div fontcolor=#45a436>157%</div> ATK của Madara lên hàng Trước và Giữa của địch, với <div fontcolor=#45a436>80%</div> xác suất áp dụng [Thunder Prison: LR]. \nThành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị. \nĐại Thành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị và cộng thêm A.DMG bằng <div fontcolor=#45a436>10%</div> Giới Hạn HP của mục tiêu (không vượt quá 500% ATK bản thân).',

['语言_ski_pa1_d_727105']='Nhận 50% <div vote=000009>Hút Máu Tạm Thời</div>. Kỹ năng này kích hoạt 1 trong 3 hiệu ứng với xác suất 10%/30%/60%: \nThường: Gây A.DMG bằng <div fontcolor=#45a436>167%</div> ATK của Madara, với 80% xác suất áp dụng [Thunder Prison: LR], <div fontcolor=#45a436>và sau đó áp dụng [Thunder Scourge: LR] lên tối đa 3 mục tiêu</div>. \nThành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị. \nĐại Thành Công: Dựa trên hiệu ứng Thường, nay gây sát thương lên tất cả đơn vị và cộng thêm A.DMG bằng 10% Giới Hạn HP của mục tiêu (không vượt quá 500% ATK bản thân).',

['语言_ski_pa1_d_727201']='ATK +<div fontcolor=#45a436>35%</div>, HP +<div fontcolor=#45a436>25%</div>.\nKhi bắt đầu lượt, áp dụng [Nowhere to Hide] lên toàn bộ kẻ địch. Trước khi một đơn vị có trạng thái này hành động, Madara dùng [Limbo Lv.1] lên chúng.',

['语言_ski_pa1_d_727202']='ATK +<div fontcolor=#45a436>45%</div>, HP +<div fontcolor=#45a436>30%</div>.\nKhi bắt đầu lượt, áp dụng [Nowhere to Hide] lên toàn bộ kẻ địch. Trước khi một đơn vị có trạng thái này hành động, Madara dùng [Limbo Lv.2] lên chúng.',

['语言_ski_pa1_d_727203']='ATK +<div fontcolor=#45a436>55%</div>, HP +<div fontcolor=#45a436>35%</div>.\nKhi bắt đầu lượt, áp dụng [Nowhere to Hide] lên toàn bộ kẻ địch. Trước khi một đơn vị có trạng thái này hành động, Madara dùng [Limbo Lv.3] lên chúng.',

['语言_ski_pa1_d_727204']='ATK +<div fontcolor=#45a436>65%</div>, HP +<div fontcolor=#45a436>40%</div>, SPD +<div fontcolor=#45a436>15%</div>.\nKhi bắt đầu lượt, áp dụng [Nowhere to Hide] lên toàn bộ kẻ địch. Trước khi một đơn vị có trạng thái này hành động, Madara dùng [Limbo Lv.4] lên chúng.',

['语言_ski_pa1_d_727301']='Gây <div fontcolor=#45a436>104%</div> A.DMG lên toàn bộ kẻ địch. Trước khi thi triển, chuyển đổi mỗi <div fontcolor=#45a436>3</div> tầng [Truth-Seeking Orb: LR] đang có thành 1 tầng [Heaven\'s Might] (Tối đa <div fontcolor=#45a436>1</div> tầng, tối đa kích hoạt 1 lần mỗi lượt). Dựa trên số tầng [Heaven\'s Might] nhận được, gây thêm sát thương nhiều đòn; mỗi đòn gây <div fontcolor=#45a436>416%</div> A.DMG chia đều lên toàn bộ kẻ địch (sát thương lên 1 mục tiêu không vượt quá 300% ATK của Madara).',

['语言_ski_pa1_d_727302']='Gây <div fontcolor=#45a436>125%</div> A.DMG lên toàn bộ kẻ địch. Trước khi thi triển, chuyển đổi mỗi <div fontcolor=#45a436>3</div> tầng [Truth-Seeking Orb: LR] đang có thành 1 tầng [Heaven\'s Might] (Tối đa <div fontcolor=#45a436>2</div> tầng, tối đa kích hoạt 1 lần mỗi lượt). Dựa trên số tầng [Heaven\'s Might] nhận được, gây thêm sát thương nhiều đòn; mỗi đòn gây <div fontcolor=#45a436>500%</div> A.DMG chia đều lên toàn bộ kẻ địch (sát thương lên 1 mục tiêu không vượt quá 300% ATK của Madara).',

['语言_ski_pa1_d_727303']='Gây <div fontcolor=#45a436>150%</div> A.DMG lên toàn bộ kẻ địch. Trước khi thi triển, chuyển đổi mỗi <div fontcolor=#45a436>3</div> tầng [Truth-Seeking Orb: LR] đang có thành 1 tầng [Heaven\'s Might] (Tối đa <div fontcolor=#45a436>3</div> tầng, tối đa kích hoạt 1 lần mỗi lượt). Dựa trên số tầng [Heaven\'s Might] nhận được, gây thêm sát thương nhiều đòn; mỗi đòn gây <div fontcolor=#45a436>600%</div> A.DMG chia đều lên toàn bộ kẻ địch (sát thương lên 1 mục tiêu không vượt quá 300% ATK của Madara).',

['语言_ski_pa1_d_727304']='Gây <div fontcolor=#45a436>179%</div> A.DMG lên toàn bộ kẻ địch. Trước khi thi triển, chuyển đổi mỗi <div fontcolor=#45a436>2</div> tầng [Truth-Seeking Orb: LR] đang có thành 1 tầng [Heaven\'s Might] (Tối đa <div fontcolor=#45a436>5</div> tầng, tối đa kích hoạt 1 lần mỗi lượt). Dựa trên số tầng [Heaven\'s Might] nhận được, gây thêm sát thương nhiều đòn; mỗi đòn gây <div fontcolor=#45a436>716%</div> A.DMG chia đều lên toàn bộ kẻ địch (sát thương lên 1 mục tiêu không vượt quá 300% ATK của Madara).',

['语言_ski_pa1_d_727305']='Gây <div fontcolor=#45a436>189%</div> A.DMG lên toàn bộ kẻ địch. Trước khi thi triển, chuyển đổi mỗi 2 tầng [Truth-Seeking Orb: LR] đang có thành 1 tầng [Heaven\'s Might] (Tối đa 5 tầng, tối đa kích hoạt 1 lần mỗi lượt). Dựa trên số tầng [Heaven\'s Might] nhận được, gây thêm sát thương nhiều đòn; mỗi đòn gây 716% A.DMG chia đều lên toàn bộ kẻ địch (sát thương lên 1 mục tiêu không vượt quá 300% ATK của Madara). <div fontcolor=#45a436>Sau đó, áp dụng [Intimidation: LR] lên mục tiêu có ATK cao nhất</div>.',

['语言_ski_pa1_d_727401']='Hồi sinh 1 đồng đội phe ta, và hồi phục cho nó lượng HP bằng<div fontcolor=#45a436>105%</div>ATK của Madara LR, sau đó hồi phục HP cho toàn bộ phe ta bằng<div fontcolor=#45a436>98%</div>ATK của Madara LR, lượng Heal tràn ra chuyển hóa thành [Hộ thuẫn-Trị liệu] cùng lượng; Sau khi thi triển kỹ nang này, nếu không có đơn vị có thể hồi sinh thì thêm 1 tầng [Ấn phong âm cường hóa] cho bản thân, khi hồi phục cho toàn bộ phe ta còn thêm lượng Heal bằng 6% HP lớn nhất của Madara LR, nếu bản thân mang [Ấn phong âm cường hóa] thì thi triển kỹ năng này sẽ tiêu hao nó để hồi sinh thêm đồng đội bằng với số tầng tiêu hao, Madara LR',
['语言_ski_pa1_d_727402']='Hồi sinh 1 đồng đội phe ta, và hồi phục cho nó lượng HP bằng<div fontcolor=#45a436>125%</div>ATK của Madara LR, sau đó hồi phục HP cho toàn bộ phe ta bằng<div fontcolor=#45a436>118%</div>ATK của Madara LR, lượng Heal tràn ra chuyển hóa thành [Hộ thuẫn-Trị liệu] cùng lượng; Sau khi thi triển kỹ nang này, nếu không có đơn vị có thể hồi sinh thì thêm 1 tầng [Ấn phong âm cường hóa] cho bản thân, khi hồi phục cho toàn bộ phe ta còn thêm lượng Heal bằng 6% HP lớn nhất của Madara LR, nếu bản thân mang [Ấn phong âm cường hóa] thì thi triển kỹ năng này sẽ tiêu hao nó để hồi sinh thêm đồng đội bằng với số tầng tiêu hao, Madara LR',
['语言_ski_pa1_d_727403']='Hồi sinh 1 đồng đội phe ta, và hồi phục cho nó lượng HP bằng<div fontcolor=#45a436>150%</div>ATK của Madara LR, sau đó hồi phục HP cho toàn bộ phe ta bằng<div fontcolor=#45a436>142%</div>ATK của Madara LR, lượng Heal tràn ra chuyển hóa thành [Hộ thuẫn-Trị liệu] cùng lượng; Sau khi thi triển kỹ nang này, nếu không có đơn vị có thể hồi sinh thì thêm 1 tầng [Ấn phong âm cường hóa] cho bản thân, khi hồi phục cho toàn bộ phe ta còn thêm lượng Heal bằng 6% HP lớn nhất của Madara LR, nếu bản thân mang [Ấn phong âm cường hóa] thì thi triển kỹ năng này sẽ tiêu hao nó để hồi sinh thêm đồng đội bằng với số tầng tiêu hao, Madara LR',
['语言_ski_pa1_d_727404']='Hồi sinh 1 đồng đội phe ta, và hồi phục cho nó lượng HP bằng<div fontcolor=#45a436>180%</div>ATK của Madara LR, sau đó hồi phục HP cho toàn bộ phe ta bằng<div fontcolor=#45a436>170%</div>ATK của Madara LR, lượng Heal tràn ra chuyển hóa thành [Hộ thuẫn-Trị liệu] cùng lượng; Sau khi thi triển kỹ nang này, nếu không có đơn vị có thể hồi sinh thì thêm 1 tầng [Ấn phong âm cường hóa] cho bản thân, khi hồi phục cho toàn bộ phe ta còn thêm lượng Heal bằng 6% HP lớn nhất của Madara LR, nếu bản thân mang [Ấn phong âm cường hóa] thì thi triển kỹ năng này sẽ tiêu hao nó để hồi sinh thêm đồng đội bằng với số tầng tiêu hao, Madara LR',
['语言_ski_pa1_d_727405']='Hồi sinh 1 đồng đội phe ta, và hồi phục cho nó lượng HP bằng<div fontcolor=#45a436>180%</div>ATK của Madara LR, sau đó hồi phục HP cho toàn bộ phe ta bằng<div fontcolor=#45a436>170%</div>ATK của Madara LR, lượng Heal tràn ra chuyển hóa thành [Hộ thuẫn-Trị liệu] cùng lượng; Sau khi thi triển kỹ nang này, nếu không có đơn vị có thể hồi sinh thì thêm 1 tầng [Ấn phong âm cường hóa] cho bản thân, khi hồi phục cho toàn bộ phe ta còn thêm lượng Heal bằng 6% HP lớn nhất của Madara LR, nếu bản thân mang [Ấn phong âm cường hóa] thì thi triển kỹ năng này sẽ tiêu hao nó để hồi sinh thêm đồng đội bằng với số tầng tiêu hao, Madara LR',


['语言_ski_pa1_d_727901']='ATK +<div fontcolor=#45a436>15%</div>, HP +<div fontcolor=#45a436>10%</div>, CRIT +<div fontcolor=#45a436>20%</div> (các hiệu ứng này có hiệu lực dù Aura có được trang bị hay không).\nKhi vào trận, áp dụng [Eye of the Moon: Shinra Bansho] lên toàn bộ đồng minh. Hiệu ứng Aura được tăng cường với mỗi Ninja LR được triển khai.',

['语言_ski_pa1_d_727902']='ATK +<div fontcolor=#45a436>18%</div>, HP +<div fontcolor=#45a436>13%</div>, CRIT +<div fontcolor=#45a436>22%</div> (các hiệu ứng này có hiệu lực dù Aura có được trang bị hay không).\nKhi vào trận, áp dụng [Eye of the Moon: Shinra Bansho] lên toàn bộ đồng minh. Hiệu ứng Aura được tăng cường với mỗi Ninja LR được triển khai.',

['语言_ski_pa1_d_727903']='ATK +<div fontcolor=#45a436>20%</div>, HP +<div fontcolor=#45a436>15%</div>, CRIT +<div fontcolor=#45a436>23%</div> (các hiệu ứng này có hiệu lực dù Aura có được trang bị hay không).\nKhi vào trận, áp dụng [Eye of the Moon: Shinra Bansho] lên toàn bộ đồng minh. Hiệu ứng Aura được tăng cường với mỗi Ninja LR được triển khai.',

['语言_ski_pa1_d_727904']='ATK +<div fontcolor=#45a436>22%</div>, HP +<div fontcolor=#45a436>17%</div>, CRIT +<div fontcolor=#45a436>24%</div> (các hiệu ứng này có hiệu lực dù Aura có được trang bị hay không).\nKhi vào trận, áp dụng [Eye of the Moon: Shinra Bansho] lên toàn bộ đồng minh. Hiệu ứng Aura được tăng cường với mỗi Ninja LR được triển khai.',

['语言_ski_pa1_d_727905']='ATK +<div fontcolor=#45a436>25%</div>, HP +<div fontcolor=#45a436>20%</div>, CRIT +<div fontcolor=#45a436>25%</div> (các hiệu ứng này có hiệu lực dù Aura có được trang bị hay không).\nKhi vào trận, áp dụng [Eye of the Moon: Shinra Bansho] lên toàn bộ đồng minh. Hiệu ứng Aura được tăng cường với mỗi Ninja LR được triển khai.',

['语言_ski_pa1_d_727601']='Trước khi hành động, nếu số tầng [Truth-Seeking Orb: LR] đang có không vượt quá 10, nhận 1 tầng, với <div fontcolor=#45a436>25%</div> xác suất nhận thêm 1 tầng nữa. Nếu không thể nhận [Truth-Seeking Orb: LR] từ kỹ năng này, thay vào đó nhận <div fontcolor=#45a436>10%-30% ATK Tạm Thời</div> (đạt tối đa ở 20 tầng).',

['语言_ski_pa1_d_727602']='Trước khi hành động, nếu số tầng [Truth-Seeking Orb: LR] đang có không vượt quá 10, nhận 1 tầng, với <div fontcolor=#45a436>50%</div> xác suất nhận thêm 1 tầng nữa. Nếu không thể nhận [Truth-Seeking Orb: LR] từ kỹ năng này, thay vào đó nhận <div fontcolor=#45a436>20%-40% ATK Tạm Thời</div> (đạt tối đa ở 20 tầng).',

['语言_ski_pa1_d_727603']='Trước khi hành động, nếu số tầng [Truth-Seeking Orb: LR] đang có không vượt quá 10, nhận 1 tầng, với <div fontcolor=#45a436>75%</div> xác suất nhận thêm 1 tầng nữa. Nếu không thể nhận [Truth-Seeking Orb: LR] từ kỹ năng này, thay vào đó nhận <div fontcolor=#45a436>30%-50% ATK Tạm Thời</div> (đạt tối đa ở 20 tầng).',

['语言_ski_pa1_d_727701']='Gây <div fontcolor=#45a436>360%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR].',
['语言_ski_pa1_d_727702']='Gây <div fontcolor=#45a436>400%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR].',
['语言_ski_pa1_d_727703']='Gây <div fontcolor=#45a436>440%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR] <div fontcolor=#45a436>và [Gravity Suppression: LR]</div>.',
['语言_ski_pa1_d_727704']='Gây <div fontcolor=#45a436>480%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR] và [Gravity Suppression: LR].',
['语言_ski_pa1_d_727705']='Gây <div fontcolor=#45a436>520%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR] và [Gravity Suppression: LR], <div fontcolor=#45a436>gỡ toàn bộ khiên chắn của mục tiêu trước khi gây sát thương</div>.',
['语言_ski_pa1_d_727706']='Gây <div fontcolor=#45a436>560%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR] và [Gravity Suppression: LR], gỡ toàn bộ khiên chắn của mục tiêu trước khi gây sát thương. <div fontcolor=#45a436>Nếu mục tiêu không chết, có 70% xác suất tấn công lại</div> (tối đa 1 lần kích hoạt).',
['语言_ski_pa1_d_727707']='Gây <div fontcolor=#45a436>600%</div> A.DMG lên kẻ địch có %HP cao nhất và áp dụng [Revive Ban: LR] và [Gravity Suppression: LR], gỡ toàn bộ khiên chắn của mục tiêu trước khi gây sát thương. Nếu mục tiêu không chết, có 70% xác suất tấn công lại <div fontcolor=#45a436>và xóa Nộ của mục tiêu. Tối đa 2 lần kích hoạt</div>.',

['语言_ski_pa1_d_727702_1']='Sát thương tăng lên <div fontcolor=#45a436>400%</div>.',
['语言_ski_pa1_d_727703_1']='Sát thương tăng lên <div fontcolor=#45a436>440%</div>, <div fontcolor=#45a436>đồng thời áp dụng thêm [Gravity Suppression: LR]</div>.',
