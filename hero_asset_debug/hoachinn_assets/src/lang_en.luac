['语言_ite_1_d_50071']='Mãnh thú xanh lam kiêu hãnh của làng Lá rất thừa nhận về sự hiểu biết của thủ lĩnh đối với tuổi trẻ và sự vất vả, đồng thời giơ ngón tay cái lên tán thành.',
['语言_ite_1_50072']='Tonton lướt sóng',
['语言_ite_1_d_50072']='Mùa hè nóng nực, Tonton cũng đến biển nghỉ mát rồi',
