['语言_ski_ot_pa_22221']='Hàng chắn Buff',
['语言_ski_ot_pa_d_22221']='Triệt tiêu 1 lượt hiệu ứng Buff có thể tẩy phép sắp phải chịu, duy trì 2 hiệp, cộng dồn nhiều nhất 5 tầng',
['语言_ski_ot_pa_22011']='Vĩ thú hộ thể',
['语言_ski_ot_pa_d_22011']='Nhận 10% DMG REDUC, cộng dồn nhiều nhất 5 tầng, không bị xóa bỏ khi chết, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_22021']='Nạp năng lượng dương',
['语言_ski_ot_pa_d_22021']='Nhận 2% ATK và 2% DMG, không bị xóa bỏ khi chết, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép, cộng dồn nhiều nhất 15 tầng; Khi cộng dồn đến 10 tầng và 15 tầng sẽ thi triển thêm 1 lượt [Thuật thông linh]',
['语言_ski_ot_pa_22031']='Phong ấn âm dương độn',
['语言_ski_ot_pa_d_22031']='Đơn vị mang trạng thái này không thể được Heal, khi kết thúc hiệp đấu nếu HP thấp hơn 30% thì lập tức nhận sát thương thực bằng 30% giới hạn HP bản thân (không vượt quá 500% ATK người thi triển), sau đó xóa bỏ trạng thái này, duy trì 2 hiệp và không thể tẩy phép',
['语言_ski_ot_pa_21981']='Chakra cửu vĩ ăn mòn',
['语言_ski_ot_pa_d_21981']='DEF giảm 10%, DMG REDUC giảm 10%, cộng dồn nhiều nhất 5 tầng, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_22081']='Kết giới cảm ứng tiên thuật',
['语言_ski_ot_pa_18661']='Cửu Vĩ: Phong Ấn Linh Hồn',
['语言_ski_ot_pa_d_18661']='Bàn tay kết giới của Cửu Vĩ xuất hiện phong ấn linh hồn các mục tiêu, đơn vị giảm 50% né tránh và 50% phòng thủ đến khi chết. Đơn vị mang trạng thái này không thể hồi sinh, đối với hiệu ứng hồi sinh đặc biệt thì sẽ không thể có tác dụng, duy trì 4 hiệp',
['语言_ski_ot_pa_21941']='Chế độ cửu vĩ',
['语言_ski_ot_pa_d_21941']='<div vote=000018>Hiệu ứng loại biến hình</div>, ATK tăng 15%, CRIT tăng 15%, khi gây sát thương vô hiệu 20% DEF, miễn dịch khống chế, không bị xóa bỏ khi chết, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_21951']='Baryon Mode',
['语言_ski_ot_pa_d_21951']='<div vote=000018>Hiệu ứng loại biến hình</div>, ATK tăng 30%, CRIT tăng 30%, khi gây sát thương vô hiệu 40% DEF, miễn dịch khống chế, không bị xóa bỏ khi chết, duy trì đến khi chiến đấu kết thúc và không thể tẩy phép',
['语言_ski_ot_pa_22081']='Kết giới cảm ứng tiên thuật',
['语言_ski_ot_pa_d_22081']='Khi tạo ra sẽ xóa bỏ<div vote=000017>hiệu ứng kết giới chính diện</div>trên chiến trường, đơn vị ở trong hiệu ứng kết giới này giảm 20% né và kháng Control, khi chết tạo ra [Phong ấn linh hồn] tại vị trí, trong 3 hiệp không thể hồi sinh bằng bất kỳ phương thức nào',
['语言_ski_ot_pa_22091']='Thuật thông linh',
['语言_ski_ot_pa_d_22091']='Gây 104% sát thương thể thuật lên toàn bộ kẻ địch, và tạo ra [Kết giới cảm ứng tiên thuật] trên chiến trường phe địch, duy trì 2 hiệp',
['语言_ski_ot_pa_d_22092']='Gây 125% sát thương thể thuật lên toàn bộ kẻ địch, và tạo ra [Kết giới cảm ứng tiên thuật] trên chiến trường phe địch, duy trì 2 hiệp',
['语言_ski_ot_pa_d_22093']='Gây 150% sát thương thể thuật lên toàn bộ kẻ địch, và tạo ra [Kết giới cảm ứng tiên thuật] trên chiến trường phe địch, duy trì 2 hiệp',
['语言_ski_ot_pa_d_22094']='Gây 179% sát thương thể thuật lên toàn bộ kẻ địch, và tạo ra [Kết giới cảm ứng tiên thuật] trên chiến trường phe địch, duy trì 2 hiệp',
['语言_par_11_405251']='Hỏa ảnh cháy bỏng',
['语言_par_11_405252']='Hãy để tôi bảo hộ làng Lá!',
['语言_par_11_405253']='Mang trong mình ý chí của những Hỏa ảnh đời trước, Hỏa ảnh đệ Thất Uzumaki Naruto đang sử dụng phương pháp riêng của mình để nung nóng bản thân, thực hiện ý chí của lửa để bảo vệ làng Lá.\nNơi lá nhảy múa, ngọn lửa vẫn tiếp tục.',
['语言_ite_2_27924'] = 'Mảnh Naruto: Will of Fire',

['语言_ite_2_27424']='Naruto: Will of Fire',
['语言_ite_2_d_27924']='Mảnh vỡ Chakra Naruto: Will of Fire, 50 mảnh vỡ có thể<div fontcolor=#9e501b>ghép thành</div>Ninja MR 5 sao Naruto: Will of Fire',
['语言_ite_2_d_27424']='Cấp sao:<div fontcolor=#3dbf5f>5</div>\n<div fontcolor=#aa6400>——Có thể nhận Ninja MR cận chiến hệ dương 5 sao Naruto: Will of Fire</div>',
['语言_ite_1_d_411402']='Mảnh vỡ còn lưu lại lượng lớn Chakra, 50 mảnh vỡ có thể <div fontcolor=#9e501b>ghép thành</div> thông linh thú đỏ Shukaku: Chôn cát, có thể nâng cao thuộc tính thông linh giới, đồng thời còn có thể dùng để thăng sao Shukaku: Chôn cát（Mỗi loại thông linh thú đỏ chỉ có thể sở hữu 1 con）',
['语言_ite_1_d_411403']='Mảnh vỡ còn lưu lại lượng lớn Chakra, 50 mảnh vỡ có thể <div fontcolor=#9e501b>ghép thành</div> thông linh thú đỏ Matatabi bùng cháy, có thể nâng cao thuộc tính thông linh giới, đồng thời còn có thể dùng để thăng sao（Mỗi loại thông linh thú đỏ chỉ có thể sở hữu 1 con）',
['语言_ite_1_d_411404']='Mảnh vỡ còn lưu lại lượng lớn Chakra, 50 mảnh vỡ có thể<div fontcolor=#9e501b>ghép thành</div>thông linh thú đỏ bóng ảnh: Tê giác, đồng thời còn có thể dùng để thăng sao bóng ảnh: Tê giác（Mỗi loại thông linh thú đỏ chỉ có thể sở hữu 1 con）',
['语言_ite_1_d_411501']='Mảnh vỡ còn lưu lại lượng lớn Chakra, 50 mảnh vỡ có thể<div fontcolor=#9e501b>ghép thành</div>thông linh thú vàng Fu: Lục đạo Pain mới, đồng thời còn có thể dùng để thăng sao Fu: Lục đạo Pain mới（Mỗi loại thông linh thú vàng chỉ có thể sở hữu 1 con）',
['语言_ite_1_d_411502']='Mảnh vỡ lưu lại lượng lớn Chakra, 50 mảnh vỡ có thể<div fontcolor=#9e501b>ghép thành</div>ma tượng ngoại đạo thông linh giới vàng, có thể tăng thuộc tính thông linh giới, dồng thời còn có thể dùng để thăng sao ma tượng ngoại đạo（Mỗi loại thông linh thú vàng chỉ có thể sở hữu 1 con）',
['语言_ite_2_d_400518']='Cấp sao:<div fontcolor=#3dbf5f>70</div>\n<div fontcolor=#aa6400>——Có thể dùng Ninja SP Naruto: Tiên Hồ để trao đổi lên bậc UR</div>',
