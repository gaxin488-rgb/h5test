['语言_s_3069']='Cuộc thập tự chinh đã kết thúc, hãy quay lại vào ngày mai',
['语言_s_3070']='Thách đấu BOSS ít nhất 1 lần để nhận',
['语言_s_3071']='Bạn đã xếp hạng %s trong Xếp hạng Trùm Gia Tộc lần này và nhận được các phần thưởng sau.',
['语言_s_3072']='%s đã từ chối yêu cầu kết bạn của bạn',
