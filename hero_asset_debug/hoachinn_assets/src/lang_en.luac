['语言_ite_1_d_284']='Ω9765',
['语言_ite_1_d_285']='Vật phẩm sự kiện. Mở để nhận 1 trong các thứ sau: \n<div fontcolor=#9e501b> Búa Vàng*1</div> \n<div fontcolor=#9e501b> Búa Vàng*2</div> \n<div fontcolor=#9e501b> Búa Vàng*5</div>',
['语言_ite_1_d_286']='Ω9764',
['语言_ite_1_d_287']='Túi Rương Nguyên Tố hiếm, mở để nhận 1 trong các thứ sau: \n<div fontcolor=#9e501b> Vé Triệu Hồi Đặc Biệt*1</div> \n<div fontcolor=#9e501b> Tinh Hoa Nguyên Tố*100</div> \n<div fontcolor=#9e501b> Vé Triệu Hồi Ưu Tú*1</div>',
