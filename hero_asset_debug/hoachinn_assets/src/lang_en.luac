['语言_ite_2_27418']='Sakura: Road to Ninja',
['语言_ite_2_d_27418']='Sao: <div fontcolor=#3dbf5f> 5</div> \n<div fontcolor=#aa6400> -- nhận được Sakura 5★ Dương Hỗ Trợ: Road to Ninja. Không được phép thêm Ninja SP vào các khe Chia Sẻ Chakra.',

['语言_par_01_50601'] ='Papa Sasuke Uchiha',
['语言_ski_pa1_548001']='Tấn Công Thường',
['语言_ski_pa1_548101']='Cửu Vĩ Trảo: Baryon',
['语言_ski_pa1_548201']='Hỏa Chí',
['语言_ski_pa1_548301']='Rasengan',
['语言_ski_pa1_548401']='Baryon Mode',
['语言_ski_pa1_d_548001']='Gây 100% sát thương nhẫn thuật cho kẻ thù phía trước',
['语言_ski_pa1_d_548101']='Nâng những tảng đá khổng lồ và ném chúng về phía kẻ thù. \nGây 250% sát thương nhẫn thuật cho 2 kẻ thù ngẫu nhiên. Sát thương thương bỏ qua 20% DEF',
['语言_ski_pa1_d_548102']='Nâng những tảng đá khổng lồ và ném chúng về phía kẻ thù. \nGây 300% sát thương nhẫn thuật cho 2 kẻ thù ngẫu nhiên. Sát thương thương bỏ qua 30% DEF, 40% xác suất giảm 10% tấn công của mục tiêu (2 lượt)',
['语言_ski_pa1_d_548103']='Nâng những tảng đá khổng lồ và ném chúng về phía kẻ thù. \nGây 350% sát thương nhẫn thuật cho 2 kẻ thù ngẫu nhiên. Sát thương thương bỏ qua 40% DEF, 50% xác suất giảm 20% tấn công của mục tiêu (2 lượt)',
['语言_ski_pa1_d_548201']='Naruto tăng ATK+20%, HP+10%, CRIT+5%. Khi hiệp đấu bắt đầu, bản thân kích hoạt [Baryon Chakra] tăng 15% sát thương nhẫn thuật, 10% DEF tối đa x3 lần tác dụng khi tới hiệp thứ 3. Hiệu ứng kéo dài cho đến khi trận chiến kết thúc và không thể tẩy.',
['语言_ski_pa1_d_548202']='Naruto tăng ATK+30%, HP+15%, CRIT+10%. Khi hiệp đấu bắt đầu, bản thân kích hoạt [Baryon Chakra] tăng 15% sát thương nhẫn thuật, 10% DEF tối đa x3 lần tác dụng khi tới hiệp thứ 3. Hiệu ứng kéo dài cho đến khi trận chiến kết thúc và không thể tẩy.',
['语言_ski_pa1_d_548203']='Naruto tăng ATK+40%, HP+20%, CRIT+15%. Khi hiệp đấu bắt đầu, bản thân kích hoạt [Baryon Chakra] tăng 15% sát thương nhẫn thuật, 10% DEF tối đa x3 lần tác dụng khi tới hiệp thứ 3. Hiệu ứng kéo dài cho đến khi trận chiến kết thúc và không thể tẩy.',
['语言_ski_pa1_d_548301']='Gây 300% sát thương nhẫn thuật cho 3 kẻ thù ngẫu nhiên, sau đó gây thêm 5% sát thương cho mỗi 1 hiệu ứng có lợi mà mục tiêu có (hiệu ứng này chỉ kích hoạt 1 lần trong một lượt). \n30% xác suất gây hiệu ứng [Xói mòn] (1 lượt) cho 2 kẻ thù ngẫu nhiên',
['语言_ski_pa1_d_548302']='Gây 350% sát thương nhẫn thuật cho 3 kẻ thù ngẫu nhiên, sau đó gây thêm 7% sát thương cho mỗi 1 hiệu ứng có lợi mà mục tiêu có (hiệu ứng này chỉ kích hoạt 1 lần trong một lượt). \n30% xác suất gây hiệu ứng [Xói mòn] (1 lượt) cho 2 kẻ thù ngẫu nhiên',
['语言_ski_pa1_d_548303']='Gây 400% sát thương nhẫn thuật cho 3 kẻ thù ngẫu nhiên, sau đó gây thêm 10% sát thương cho mỗi 1 hiệu ứng có lợi mà mục tiêu có (hiệu ứng này chỉ kích hoạt 1 lần trong một lượt). \n30% xác suất gây hiệu ứng [Xói mòn] (1 lượt) cho 2 kẻ thù ngẫu nhiên \n60% xác suất loại bỏ tất cả các hiệu ứng có lợi mà mục tiêu có.',
['语言_ski_pa1_d_548401']='Cửu Vĩ Kurama đã hi sinh tất cả Charka của mình để Naruto tiến vào Baryon Mode lúc này Naruto sẽ có xác suất 30% tấn công thêm 1 lần Skill Rasengan với 150% dame nhẫn thuật. \n45% xác suất gây hiệu ứng [Xói mòn] (2 lượt) cho kẻ thù',
['语言_ski_pa1_d_548402']='Cửu Vĩ Kurama đã hi sinh tất cả Charka của mình để Naruto tiến vào Baryon Mode lúc này Naruto sẽ có xác suất 40% tấn công thêm 1 lần Skill Rasengan với 150% dame nhẫn thuật. \n45% xác suất gây hiệu ứng [Xói mòn] (2 lượt) cho kẻ thù',
['语言_ski_pa1_d_548403']='Cửu Vĩ Kurama đã hi sinh tất cả Charka của mình để Naruto tiến vào Baryon Mode lúc này Naruto sẽ có xác suất 50% tấn công thêm 1 lần Skill Rasengan với 150% dame nhẫn thuật. \n45% xác suất gây hiệu ứng [Xói mòn] (2 lượt) cho kẻ thù',
