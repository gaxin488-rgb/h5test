['语言_c_3111']='<div outline=2,#000000 >%d<img src=common_90074.png visible=true scale=0.75 /> Ninja</div>',
['语言_c_3112']='Hi sinh',
['语言_c_3113']='Một hoặc nhiều Ninjas 5 sao trở lên được chọn. Xác nhận?',
['语言_c_3114']='Hi sinh Ninja',
['语言_c_3115']='Các mảnh sẽ hy sinh có thể được sử dụng để triệu hồi các Ninjas, bạn có thực sự muốn tiếp tục hy sinh không?',
['语言_c_3116']='Hi sinh mảnh',
['语言_c_3117']='<div fontcolor=#249003 href=xxx>Đi Triệu Hồi</div>',
['语言_c_3118']='Hy sinh các ninja để nhận được một số vật phẩm. Nếu Ninjas bị hy sinh đã được tu luyện như, tăng cấp hoặc tăng sao, 100% vật phẩm đã tiêu thụ như Bạc, Cầu tăng cấp và kinh nghiệm Ninja sẽ được trả lại. Lần này bạn nhận:  ',
['语言_c_3119']='Nếu Ninja Chuyển đổi đã được tu luyện trước đó, 100% nguyên liệu tu luyện (Bạc, Ninja EXP, Cầu tăng bậc) và tất cả Trang bị và Cuộn của nó sẽ được trả lại. Lần này bạn nhận được:  ',
['语言_c_3120']='Chuyển đổi Ninja',
['语言_c_3121']='Chuyển đổi',
['语言_c_3122']='Tái sinh một Ninja và bạn sẽ nhận được một số nguyên liệu. Nếu bạn đã tu luyện Ninja này, 100% nguyên liệu tu luyện (Bạc, Kinh nghiệm Ninja, Cầu tăng cấp) và tất cả Trang bị và Cuộn của nó sẽ được trả lại. Lần này bạn nhận được:  ',
['语言_c_3123']='Tái Sinh Ninja',
['语言_c_3124']='Tái sinh',
['语言_c_3125']='Bán Thần Trang',
['语言_c_3126']='Bán Đồ nội thất',
['语言_c_3127']='Khôi phục một Ninja và bạn sẽ nhận được một số nguyên liệu. Nếu bạn đã tu luyện Ninja này, 100% nguyên liệu tu luyện (Bạc, Kinh nghiệm Ninja, Cầu tăng cấp) và tất cả Trang bị và Cuộn của nó sẽ được trả lại. Lần này bạn nhận được:  ',
['语言_c_3128']='Ninja Khôi Phục',
['语言_c_3129']='Khôi phục',
['语言_c_3130']='Tái sinh một Vĩ thú sẽ trả lại tất cả Bụi Triệu hồi và Linh hồn Ninja tương đương với số Vĩ thú đã tiêu thụ. Đồng thời, một Vĩ thú Triệu hồi lv1 sẽ vẫn được duy trì',
