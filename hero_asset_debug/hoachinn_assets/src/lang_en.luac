['语言_ite_1_24060']='Sasuke [Du Xuân](Vĩnh viễn)',
['语言_ite_1_24061']='Sasuke [Du Xuân](7 ngày)',
['语言_ite_1_24062']='Sasuke [Du Xuân](shards)',
['语言_ite_1_37013']='Mua Đá Quý',
['语言_ite_1_60220']='5 sao Hồn-Ninja Tự Chọn (Gió/Nước/Lửa)',
['语言_ite_1_60221']='6 sao Hồn-Ninja Tự Chọn (Gió/Nước/Lửa)',
['语言_ite_1_d_1']='Chế tạo bằng bạc nguyên chất,  là loại tiền tệ cơ bản lưu hành trong thế giới Ninja, luôn phải đem theo trên người nhé',
['语言_ite_1_d_2']='Một trong những loại tiền tệ phổ biến trong thế giới Ninja, có thể được sử dụng cho các giao dịch hàng ngày',
['语言_ite_1_d_3']='Tiền vàng hiếm có trong thế giới Ninja, có thể dùng để đổi tất cả các đạo cụ',
['语言_ite_1_d_4']='Ω346',
['语言_ite_1_d_5']='Một biểu tượng cho sự huấn luyện nghiêm ngặt của Ninja. Cần khi muốn tăng cấp',
['语言_ite_1_d_6']='Ω344',
['语言_ite_1_d_7']='Có được nó để thực hiện các Nhiệm vụ Học Viện',
['语言_ite_1_d_8']='Một biểu tượng của vinh quang trong Đấu trường. Được sử dụng để đổi lấy các vật phẩm trong Cửa Hàng Đấu Trường',
['语言_ite_1_d_9']='Một biểu tượng cho sự năng động của bạn. Thu thập để đổi lấy rương Năng Động',
['语言_ite_1_d_10']='Biểu tượng của một Gia Tộc thịnh vượng. Được sử dụng để nâng cấp các kỹ năng của Gia Tộc hoặc đổi lấy các vật phẩm trong Cửa hàng Gia Tộc',
['语言_ite_1_d_11']='Biểu tượng của một Ninja. Tái chế Ninja và đổi lấy mảnh vỡ tại Cửa Hàng Ninja',
['语言_ite_1_d_12']='Một biểu tượng của thành tựu. Hoàn thành nhiệm vụ để nhận được điểm danh hiệu',
['语言_ite_1_d_13']='Ω342',
['语言_ite_1_d_14']='Chứng nhận tình bạn giữa bạn bè, dùng để đổi các vật phẩm trong cửa hàng điểm',
['语言_ite_1_d_15']='Ω340',
['语言_ite_1_d_16']='Kiếm được bằng cách đóng góp cho Gia Tộc. Được sử dụng để nâng cấp cấp độ Gia Tộc và mở khóa thêm các lợi ích của Gia Tộc',
['语言_ite_1_d_17']='Ω338',
['语言_ite_1_d_18']='Sử dụng để đổi các vật phẩm trong Cửa hàng Vòng Quay',
['语言_ite_1_d_19']='Dùng để đặt cược Nhà Vô Địch, và nhận điểm Giải Đấu Vô Địch',
['语言_ite_1_d_20']='Sử dụng để đổi các vật phẩm trong Cửa hàng điểm',
['语言_ite_1_d_21']='Sử dụng để đổi các vật phẩm trong Cửa hàng Đấu Trường liên SV',
['语言_ite_1_d_22']='Cuộn EXP. Nó được sử dụng để tăng cấp cho ninja.',
['语言_ite_1_d_23']='Điểm được sử dụng để triệu hồi ninja',
['语言_ite_1_d_24']='Dùng để mua bán vật phẩm trong Cửa Hàng Nguyên Tố',
['语言_ite_1_d_25']='Rơi từ Tàn Tích. Sử dụng để giao dịch các vật phẩm trong Cửa hàng Thám Hiểm',
['语言_ite_1_d_26']='Điểm May Mắn kiếm được từ Cuộn thủ công thất bại',
['语言_ite_1_d_27']='Một huy hiệu danh dự chỉ dành cho giới tinh hoa ninja. Bạn có thể sử dụng nó để giao dịch ninja hiếm và vật phẩm tiện dụng trong cửa hàng đấu hạng',
['语言_ite_1_d_28']='Sử dụng để giao dịch Ult-Trang Bị trong Cửa Hàng Thần Trang. Có được từ việc vượt ải Núi Myoboku và Cầu nguyện Myoboku',
['语言_ite_1_d_29']='Sử dụng để giao dịch Trang Phục trong Cửa Hàng Trang Phục. Nhận được từ: sự kiện lễ hội, chuyển đổi thời trang vĩnh viễn bằng cách sử dụng một số vật phẩm',
['语言_ite_1_d_30']='Kết Ấn chỉ được nắm giữ bởi các chiến binh thực sự. Sử dụng để giao dịch Ninja 5 sao hiếm và Mảnh Trang Phục trong Cửa Hàng Điểm của Hội Nindo và Đấu Trường Đội',
['语言_ite_1_d_31']='Một đồng xu với mô hình ngôi nhà ngọt ngào trên đó. Dùng nó để mua Nội thất hoặc đồ dùng cần thiết cho Thú Cưng Du Lịch',
['语言_ite_1_d_32']='Một viên đá quý hiếm đến từ một vùng đất thánh, bốc cháy như Lửa. Sử dụng nó để<div fontcolor=#9e501b> nâng cao cấp độ Tinh thuần của Nhẫn Cụ</div>',
['语言_ite_1_d_33']='Sử dụng để đặt cược trong Hội Nindo Đỉnh Cao! Chúng được chuyển đổi thành Xu Gia Tộc chiến khi cá cược kết thúc',
['语言_ite_1_d_34']='Chỉ được phát hành trong Giải vô địch tuần. Sử dụng nó để giao dịch các vật phẩm quý hiếm trong cửa hàng Giải Vô Địch Tuần',
['语言_ite_1_d_35']='Một vật phẩm nâng cao có được từ các sự kiện hoặc đáp ứng một số yêu cầu. Sử dụng nó để giao dịch ninja mạnh mẽ, Thần Trang hoặc thứ gì đó khác trong Ramen Ichiraku',
['语言_ite_1_d_36']='Một bằng chứng về việc đánh bại các BOSS Thí Luyện. Sử dụng nó để giao dịch các vật phẩm trong Kho Gia Tộc',
['语言_ite_1_d_37']='Dùng để đặt cược trong Hội Nindo Đỉnh Cao! Chúng sẽ được chuyển đổi thành Xu Đặc Quyền khi kết thúc cá cược',
['语言_ite_1_d_38']='Đồng tiền độc quyền được phát hành bởi Hội Nindo Đỉnh Cao. Sử dụng để giao dịch các vật phẩm quý hiếm trong Cửa Hàng Đỉnh',
['语言_ite_1_d_39']='Vật phẩm cần thiết để Triệu Hồi Nguyên Tố. Sử dụng nó trong Triệu Hồi Nguyên Tố - Điểm để triệu hồi ninja 5 sao!',
['语言_ite_1_d_40']='Một quả cầu ma thuật thấm nhuần sức mạnh tâm linh. Dùng nó để<div fontcolor=#9e501b> nâng cấp ninja</div>',
['语言_ite_1_d_41']='Một tấm vé do những người cao niên trong thế giới ninja phát hành, dùng nó để<div fontcolor=#9e501b> Làm mới nhiệm vụ trong Học Viện</div>',
['语言_ite_1_d_42']='Một tấm vé thấm nhuần sức mạnh của ninja. Sử dụng nó để nhận<div fontcolor=#9e501b> lượng EXP và Trang Bị lớn</div>',
['语言_ite_1_d_43']='Có được từ gói hàng tuần. Sử dụng nó để giao dịch ninja Gió/Lửa/Nước 5 sao!',
['语言_ite_1_d_44']='Một cuốn sách được viết với kiến thức rất uyên thâm. Sử dụng nó để<div fontcolor=#9e501b> cải thiện chỉ số kỹ năng PVP của Gia Tộc</div>',
['语言_ite_1_d_45']='Một vật phẩm dùng cho việc<div fontcolor=#9e501b> Tái Sinh Ninja</div> \n<div fontcolor=#9e501b> (Chỉ có sẵn trong thời gian sự kiện và sẽ bị xóa khi hết hạn</div>',
['语言_ite_1_d_46']='Một cuộn ngưng tụ sức mạnh của những người bạn cùng hội với nhau. Tăng<div fontcolor=#9e501b> Tấn công của tất cả thành viên Gia Tộc lên 2%</div> khi chiến đấu với Trùm Gia Tộc. Hiệu ứng cộng dồn.',
['语言_ite_1_d_47']='Sử dụng nó để tẩy luyện Thần Trang. Nó có thể thiết lập lại các chỉ số và giá trị của Thần Trang. Có được từ việc bán Thần Trang, vượt ải Núi Myoboku và Cầu nguyện Myoboku',
['语言_ite_1_d_48']='Ω9875',
['语言_ite_1_d_49']='Có trong Tàn Tích. Sau khi sử dụng, phục hồi tất cả ninja về trạng thái tối đa và tăng 30% tấn công của họ. <div fontcolor=#9e501b> Chỉ có hiệu lực trong trận chiến tiếp theo sau khi sử dụng</div> . Lấy từ Cửa Hàng Đấu Trường và các sự kiện',
['语言_ite_1_d_50']='Bụi thánh sinh ra bằng cách giải phóng Khế Ước Vĩ Thú. Sử dụng để<div fontcolor=#9e501b> Nâng Sao Vĩ Thú và Giới Linh</div>',
['语言_ite_1_d_51']='Một quả cầu linh hồn nuôi dưỡng các sinh vật. Sử dụng để<div fontcolor=#9e501b> Giới Linh</div>',
['语言_ite_1_d_52']='Ta nghĩ rằng ta nhìn thấy một cái gì đó sáng bóng. Gửi<div fontcolor=#9e501b> Gói Lì Xì Đỏ</div> tới bạn bè trong Gia Tộc',
['语言_ite_1_d_53']='Ta nghĩ rằng ta nhìn thấy một cái gì đó sáng bóng. Gửi<div fontcolor=#9e501b> Gói Lì Xì Cao Cấp</div> tới bạn bè trong Gia Tộc',
['语言_ite_1_d_54']='Chúa ơi, đó có phải là sự phản chiếu của vàng không? Gửi<div fontcolor=#9e501b> 388 Lì Xì Vàng Sang Trọng</div> tới bạn bè trong Gia Tộc',
['语言_ite_1_d_55']='Chúa ơi, đó có phải là sự phản chiếu của vàng không? Gửi<div fontcolor=#9e501b> 688 Lì Xì Vàng Cao Cấp</div> tới bạn bè trong Gia Tộc',
['语言_ite_1_d_56']='Một quả cầu khí lực khơi dậy tiềm năng của ninja! Một vật phẩm cần thiết và rất hiếm được sử dụng để nâng<div fontcolor=#9e501b> ninja</div> tới<div fontcolor=#9e501b> 12 và 13<img src=common_90074.png visible=true scale=0.75 /></div>',
['语言_ite_1_d_56_1']='Một viên ngọc quý hiếm thuộc dòng tộc Otsutsuki, đánh thức tiềm năng của ninja! Một vật phẩm cần thiết và rất hiếm được sử dụng để nâng<div fontcolor=#9e501b> ninja</div> tới<div fontcolor=#9e501b> 14 và 15<img src=common_90074.png visible=true scale=0.75 /></div>',
['语言_ite_1_d_56_2']='Một viên ngọc quý hiếm dùng để đột phá nhẫn giả, đánh thức tiềm năng của ninja! Một vật phẩm cần thiết và rất hiếm được sử dụng để nâng cấp<div fontcolor=#9e501b> cho ninja MR từ cấp bậc</div> <div fontcolor=#9e501b> 50<img src=common_90074.png visible=true scale=0.75 /></div> trở lên',
['语言_ite_1_d_56_22']='Mảnh Đá Nguyên Tố MR, có thể dùng để trao đổi thành Đá Nguyên Tố MR ở sự kiện! Một vật phẩm cần thiết và rất hiếm được sử dụng để nâng cấp<div fontcolor=#9e501b> cho ninja MR từ cấp bậc</div> <div fontcolor=#9e501b> 50<img src=common_90074.png visible=true scale=0.75 /></div> trở lên, có thể tìm thấy ở Boss thế giới và các sự kiện khác nhau',

['语言_ite_1_d_57']='Sử dụng để cải thiện sự phát triển của Cây Thần Thụ',
['语言_ite_1_d_58']='Ngọc cổ. Sử dụng nó để tạo Nhẫn Thuật',
['语言_ite_1_d_59']='Ω334',
['语言_ite_1_d_60']='Một tấm vé để sử dụng khi thách đấu trong Đấu Trường',
['语言_ite_1_d_61']='Một chiếc chìa khóa được rèn bởi những người thợ rèn lành nghề bằng cách sử dụng thép đen. Sử dụng nó để mở các rương gia truyền có trong Thí Luyện Sinh Tồn. Truyền thuyết kể rằng nếu bạn tìm thấy một chiếc rương, bạn có thể tìm thấy chìa khóa của nó gần đó…',
['语言_ite_1_d_62']='Tự động mở. Cần có đủ<div fontcolor=#9e501b> 300 Đấu Trường Điểm</div> mới kích hoạt, có cơ hội rơi<div fontcolor=#9e501b> Nhẫn Thuật x2</div>',
['语言_ite_1_d_63']='Tự động mở. Cần có đủ<div fontcolor=#9e501b> 500 Đấu Trường Điểm</div> mới kích hoạt, có cơ hội rơi<div fontcolor=#9e501b> Nhẫn Thuật x3</div>',
['语言_ite_1_d_64']='Thu thập 50 để triệu hồi 1 lần. Triệu Hồi một Ninja trong danh sách Hàng tuần\nDang, ta không thể để mất cơ hội ~',
['语言_ite_1_d_65']='Mở ngẫu nhiên nhận 1 trong các vật phẩm sau: \n<div fontcolor=#9e501b> Cuộn Khế Ước Vàng*1\n5<img src=common_90074.png visible=true scale=0.75 /> Mảnh Ngẫu Nhiên*50\nCuộn Dương*1\nCuộn Âm*1\n5<img src=common_90074.png visible=true scale=0.75 /> Mảnh Ngẫu Nhiên*10\n5<img src=common_90074.png visible=true scale=0.75 /> Mảnh Ngẫu Nhiên*5\nĐá Nindos*20000</div>',
['语言_ite_1_d_66']='Một cuộn cho phép bạn thực hiện các lệnh triệu hồi cơ bản. Được sử dụng cho Triệu Hồi<div fontcolor=#9e501b> ngẫu nhiên 3-Ninja 5<img src=common_90074.png visible=true scale=0.75 /></div> tại Triệu Hồi Cơ Bản',
['语言_ite_1_d_67']='Một cuộn cho phép bạn thực hiện các lệnh triệu hồi nâng cao. Được sử dụng cho Triệu Hồi<div fontcolor=#9e501b> ngẫu nhiên 3-Ninja 5<img src=common_90074.png visible=true scale=0.75 /></div> tại Triệu Hồi Cao Cấp',
['语言_ite_1_d_68']='Một cuộn cho phép bạn thực hiện các lệnh triệu hồi đặc biệt. Được sử dụng cho Triệu Hồi<div fontcolor=#9e501b> Sự Kiện Triệu Hồi Giới Hạn</div> \nCó thể quy đổi thành Vé Triệu Hồi Ưu Tú với tỉ lệ là 1:1',
['语言_ite_1_d_69']='Một cuộn cho phép bạn thực hiện các lệnh triệu hồi đặc biệt. Được sử dụng cho Triệu Hồi<div fontcolor=#9e501b> Sự Kiện Triệu Hồi Ưu Tú</div>',
['语言_ite_1_d_70']='Vé độc quyền của bạn, hãy sử dụng chúng cho Triệu Hồi<div fontcolor=#9e501b> 3~Ninja 5<img src=common_90074.png visible=true scale=0.75 /></div> tại Triệu Hồi Cao Cấp',
['语言_ite_1_d_71']='Dùng để Triệu Hồi Vĩ Thú trong<div fontcolor=#9e501b> Vĩ Thú</div>',
['语言_ite_1_d_72']='Sử dụng nó để cầu phúc và rút thăm trong<div fontcolor=#9e501b> Cầu Phúc Ninja</div>',
['语言_ite_1_d_73']='Ω6354',
['语言_ite_1_d_74']='Ω9872',
['语言_ite_1_d_75']='Các mảnh chứa sức mạnh Ninja có thể được chuyển đổi thành bất kỳ<div fontcolor=#9e501b> Mảnh Ninja Cấp A</div> , bạn có thể sử dụng chúng để<div fontcolor=#9e501b> chế tạo hoặc nâng cấp</div> ninja',
['语言_ite_1_d_76']='Các mảnh chứa sức mạnh Ninja có thể được chuyển đổi thành bất kỳ<div fontcolor=#9e501b> Mảnh Ninja Cấp S</div> , bạn có thể sử dụng chúng để<div fontcolor=#9e501b> chế tạo hoặc nâng cấp</div> ninja',
['语言_ite_1_d_77']='Các mảnh chứa sức mạnh Ninja có thể được chuyển đổi thành bất kỳ<div fontcolor=#9e501b> Mảnh Ninja Cấp SS</div> , bạn có thể sử dụng chúng để<div fontcolor=#9e501b> chế tạo hoặc nâng cấp</div> ninja',
['语言_ite_1_d_78']='Ω330',
['语言_ite_1_d_79']='Một cuộn tượng trưng cho vinh quang của Lục Đạo Hiền Nhân. Sử dụng nó và đạt được<div fontcolor=#9e501b> các kỹ năng và chỉ số tăng thêm</div> khác nhau ở các cấp độ<img src=common_90074.png visible=true scale=0.75 /> khác nhau. Cho ninja đang mặc',
['语言_ite_1_d_80']='Một viên đá chứa đựng sức mạnh của Kaguya. Sử dụng để<div fontcolor=#9e501b> Tẩy Luyện</div> Cuộn Linh Hồn: Kaguya. Ngẫu nhiên<div fontcolor=#9e501b> thay thế</div> kỹ năng hiện tại',
['语言_ite_1_d_81']='Một viên đá chứa đựng sức mạnh của các Vị Thần. Sử dụng để<div fontcolor=#9e501b> Tẩy Luyện</div> Cuộn: Lục Đạo. Ngẫu nhiên<div fontcolor=#9e501b> thay thế</div> kỹ năng và chỉ số',
['语言_ite_1_d_82']='Cuộn giấy này do Kaguya huyền thoại để lại. Nâng sao nó và đạt được<div fontcolor=#9e501b> các kỹ năng và chỉ số cộng thêm</div> khác nhau ở các cấp độ<img src=common_90074.png visible=true scale=0.75 /> khác nhau. Cho ninja đang mặc',
['语言_ite_1_d_83']='Bản chất còn lại của một cuộn giấy. Sử dụng để<div fontcolor=#9e501b> Rèn lại Cuộn</div> , cấp các kỹ năng và chỉ số mới cho Cuộn',
['语言_ite_1_d_84']='Một cuộn giấy có mùi của tất cả những gì tự nhiên. Nâng<div fontcolor=#9e501b> chỉ số cộng thêm. cho ninja đang mặc. </div> có thể Chế tạo<div fontcolor=#9e501b> thành Cuộn Mặt Trăng cấp cao hơn tại Lò Rèn',
['语言_ite_1_d_85']='Một cuộn đầy sự ảm đạm của mặt trăng. Nâng<div fontcolor=#9e501b> chỉ số cộng thêm và 1 kỹ năng cơ bản ngẫu nhiên</div> . ninja sẽ được hưởng sau khi trang bị.<div fontcolor=#9e501b> có thể Chế tạo</div> thành Cuộn Mặt Trăng cấp cao hơn tại Lò Rèn',
['语言_ite_1_d_86']='Cuộn giấy đang phát ra ánh nắng chói chang. Nâng<div fontcolor=#9e501b> chỉ số cộng thêm và 1-2 kỹ năng cơ bản ngẫu nhiên</div> . ninja sẽ được hưởng sau khi trang bị.<div fontcolor=#9e501b> có thể Chế tạo</div> thành Sách Cầu Vồng cấp cao hơn tại Lò Rèn',
['语言_ite_1_d_87']='Cô đọng với sức mạnh của nindo. Nâng<div fontcolor=#9e501b> chỉ số cộng thêm và 2 kỹ năng ngẫu nhiên</div> . ninja sẽ được hưởng sau khi trang bị.<div fontcolor=#9e501b> có thể Chế tạo</div> thành Sách Cổ Đại cấp cao hơn tại Lò Rèn',
['语言_ite_1_d_88']='Một Cuộn giấy hiếm do tổ tiên Ninja để lại. Nâng<div fontcolor=#9e501b> chỉ số cộng thêm và 2 kỹ năng ngẫu nhiên Trung/Cao</div> . ninja sẽ được hưởng sau khi trang bị.<div fontcolor=#9e501b> có thể Chế tạo</div> thành Sách Cổ Đại cấp tối đa tại Lò Rèn',
['语言_ite_1_d_89']='Vật phẩm này chứa sức mạnh nguyên thủy của Lục Đạo. Sử dụng để mua và nâng cấp<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /> Thức tỉnh Nhẫn Thuật</div>',
['语言_ite_1_d_90']='Sử dụng để<div fontcolor=#9e501b> Tẩy luyện may mắn</div> cho Sách Cổ Đại. có thể nhận các kỹ năng mạnh và hiếm, tỷ lệ *2 cho các kỹ năng Nhẫn Thuật mạnh gấp đôi!',
['语言_ite_1_d_91']='Sử dụng để<div fontcolor=#9e501b> mở khóa thêm khe</div> tại Cây Thần Thụ',
['语言_ite_1_d_92']='Sử dụng để<div fontcolor=#9e501b> Tẩy luyện may mắn</div> cho Sách Cổ Đại chắc chắn để có được kỹ năng nâng cao!',
['语言_ite_1_d_93']='Sức mạnh đặc biệt của nó cho phép bạn dỡ bỏ các Kỹ năng Nhẫn Thuật mà không làm hỏng chúng để các ninja khác có thể học và sử dụng chúng trực tiếp',
['语言_ite_1_d_94']='Kết tinh tinh hoa của các Danh tướng xưa. Thu thập 100 để Triệu Hồi một trong số các Ninja: \n<div fontcolor=#9e501b> Tobirama Senju</div> hoặc<div fontcolor=#9e501b> Toneri Otsutsuki</div>',
['语言_ite_1_d_95']='Dùng để Triệu Hồi<div fontcolor=#9e501b> 4-Ninja 5<img src=common_90074.png visible=true scale=0.75 /></div> tại Triệu Hồi Ưu Tú',
['语言_ite_1_d_96']='Tinh chất này được sử dụng để<div fontcolor=#9e501b> chuyển đổi ngẫu nhiên</div> Ninja Nước, Lửa hoặc Gió sang một hệ khác',
['语言_ite_1_d_97']='Một cuộn Khế Ước thường. Dùng để<div fontcolor=#9e501b> Gọi Vĩ Thú</div>',
['语言_ite_1_d_98']='Chúng ta có thể cảm thấy điều gì đó tuyệt vời từ nó. Dùng để<div fontcolor=#9e501b> Gọi Vĩ Thú</div>',
['语言_ite_1_d_99']='Một cuộn Khế Ước được bao phủ bởi ánh sáng vàng. Dùng để<div fontcolor=#9e501b> Gọi Vĩ Thú</div>',
['语言_ite_1_d_100']='Thanh gỗ bình thường. Sử dụng để<div fontcolor=#9e501b> tăng tốc Khế Ước</div> trong tính năng Vĩ Thú',
['语言_ite_1_d_101']='Sử dụng để<div fontcolor=#9e501b> tăng tốc Khế Ước</div> trong tính năng Vĩ Thú',
['语言_ite_1_d_102']='Một cây quyền trượng chứa đầy sức mạnh thần thoại, Sử dụng để<div fontcolor=#9e501b> tăng tốc Khế Ước</div> trong tính năng Vĩ Thú',
['语言_ite_1_d_103']='Sử dụng nó để nạp ngay φ%s và nhận EXP VIP tương ứng',
['语言_ite_1_d_104']='Tác dụng: nhận 100 Vàng mỗi ngày trong 30 ngày liên tiếp; Khe túi + 80; nhận 200 Pha lê Ninja mỗi ngày ',
['语言_ite_1_d_105']='Tác dụng: nhận 200 Kim cương mỗi ngày trong 30 ngày liên tiếp; Khe túi + 80; nhận 1 Mảnh Huyền Thoại mỗi ngày',
['语言_ite_1_d_106']='Sử dụng để nhận Đặc quyền VIP 9',
['语言_ite_1_d_107']='<div><div fontcolor=#9e501b>Nhẫn Thuật: </div> tăng Sát thương nhẫn thuật 5% và Tấn công thêm 60\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Nhẫn Thuật</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_108']='<div><div fontcolor=#9e501b>Tấn Công: </div> tăng T.DMG 5% và Tấn công thêm 60\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Công kích</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_109']='<div><div fontcolor=#9e501b>Săn Bắt: </div> 60% cơ hội tấn công cơ bản một lần nữa khi kẻ địch bị tiêu diệt bởi kỹ năng Thể Thuật.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Săn Bắt]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_110']='<div><div fontcolor=#9e501b>Truy Sát: </div> 40% cơ hội tấn công cơ bản một lần nữa khi kỹ năng Thể Thuật đạt CRIT.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Truy Sát]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_111']='<div><div fontcolor=#9e501b>Bạo Nộ: </div> tăng hiệu ứng Bạo kích lên 10%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Bạo Nộ</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_112']='<div><div fontcolor=#9e501b>Điên Cuồng: </div> tăng tỷ lệ Bạo kích lên 5%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Cuồng Bạo</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_113']='<div><div fontcolor=#9e501b>Chiến Ý: </div> với mỗi 1% Sinh mệnh bị mất, sẽ tăng DMG gây ra thêm 0.1%\n\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp</div> the<div fontcolor=#9e501b> Chiến Ý</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_114']='<div><div fontcolor=#9e501b>Nhanh: </div> tăng Tốc độ thêm 3% +10\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Nhanh</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_115']='<div><div fontcolor=#9e501b>Hồi Âm: </div> tăng 5% hiệu ứng Né tránh, giảm 2% CRIT\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Hồi Âm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_116']='<div><div fontcolor=#9e501b>Giáng Lâm: </div> tăng hiệu ứng ACC lên 10%, giảm Bạo kích đi 2%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Giáng Lâm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_117']='<div><div fontcolor=#9e501b>Trị Liệu giảm: </div> 20% cơ hội giảm 10% [Hồi Phục] và [Khôi Phục] của kẻ địch trong 3 lượt.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Trị Liệu giảm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_118']='<div><div fontcolor=#9e501b>Niêm Phong: </div> 10% cơ hội ngăn kẻ địch hồi sinh trong 4 lượt; + 5% DMG đối với kẻ địch có hiệu ứng Ban Phước hoặc Hồi Sinh.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Thách Đấu]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_119']='<div><div fontcolor=#9e501b>giải trừ: </div> khi tấn công, 10% cơ hội để giải trừ tất cả các hiệu ứng từ mục tiêu\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp</div><div fontcolor=#9e501b> [giải trừ]</div> kỹ năng. Nhẫn Thuật Học tập Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_120']='<div><div fontcolor=#9e501b>Xung Kích</div> : nếu DMG gây ra cao hơn 30% giới hạn Sinh mệnh của mục tiêu, 20% sẽ có cơ hội làm choáng nó trong 2 lượt\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Xung Kích</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_121']='<div><div fontcolor=#9e501b>Thách Đấu: </div> 4% cơ hội buộc mục tiêu phải dùng tấn công cơ bản trong 1 lượt.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Thách Đấu</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_122']='<div><div fontcolor=#9e501b>Tốc độ giảm: </div> 20% cơ hội khi tấn công sẽ giảm 10% tốc độ mục tiêu trong 2 lượt\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Tốc độ giảm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_123']='<div><div fontcolor=#9e501b>Vinh Quang: </div> 30% cơ hội khi chết sẽ tăng 5% Tấn công của tất cả đồng minh\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Vinh Quang</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_124']='<div><div fontcolor=#9e501b>Né Tránh: </div> tăng Né tránh 6%; giảm 5% DMG nhận phải từ các đơn vị tấn công bằng Công Kích/Nhẫn Thuật\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Né Tránh</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_125']='<div><div fontcolor=#9e501b>Trấn Áp: </div> tăng 15% DMG lên các mục tiêu đang có hiệu ứng Sự Sống/Phục Hồi\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Trấn Áp</div> Kỹ năng.<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div> + ninja begin learning Nhẫn Thuật.</div>',
['语言_ite_1_d_126']='<div><div fontcolor=#9e501b>Chính xác: </div> tăng HIT lên 6%; tăng 5% DMG đối với mục tiêu đang có hiệu ứng Né Tránh/Nhanh\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Chính Xác</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_127']='<div><div fontcolor=#9e501b>Thanh Lọc: </div> 30% cơ hội khi bắt đầu lượt sẽ xóa tất cả các trạng thái bất lợi khỏi bản thân\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Thanh Lọc</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_128']='<div><div fontcolor=#9e501b>Kháng CC: </div> tăng khả năng chống CC lên 4%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Kháng CC</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_129']='<div><div fontcolor=#9e501b>Phục Hồi: </div> phục hồi 2% Sinh mệnh tối đa khi bắt đầu lượt\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Phục Hồi</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_130']='<div><div fontcolor=#9e501b>Hồi Sinh: </div> 12% cơ hội khi chết sẽ hồi sinh với một lượng nhỏ Sinh mệnh\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Hồi Sinh</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_131']='<div><div fontcolor=#9e501b>Ban Phước: </div> 8% cơ hội hồi sinh khi chết, phục hồi 30% Sinh mệnh\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Ban Phước</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_132']='<div><div fontcolor=#9e501b>Kháng Bạo: </div> giảm 5% khả năng bị nhận sát thương bạo kích\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Tăng kháng bạo</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_133']='<div><div fontcolor=#9e501b>Phản Đòn: </div> -15% Sát thương nhẫn thuật gánh chịu.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Phản Đòn</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div> Học tập Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_134']='<div><div fontcolor=#9e501b>Da Sắt: </div> giảm T.DMG phải chịu đi 5%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Da Sắt</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_135']='<div><div fontcolor=#9e501b>Sự Sống: </div> tăng đầu vào và đầu ra hồi máu của Ninja lên 5%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Sự Sống</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_136']='<div><div fontcolor=#9e501b>Chậm: </div> làm chậm Tốc độ 10% và tăng Sinh mệnh lên 3%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Chậm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_137']='<div><div fontcolor=#9e501b>Xuyên Thấu: </div> DMG bỏ qua 10% Phòng thủ của mục tiêu\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Xuyên Thấu</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_138']='<div><div fontcolor=#9e501b>ĐÁNH TRÚNG: </div> tăng CC Thành công lên 3%, giảm 10% Bạo kích\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div> the<div fontcolor=#9e501b> [HIT]</div> kỹ năng. Nhẫn Thuật Học tập Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_139']='<div><div fontcolor=#9e501b>Liên Hoàn: </div> 20% cơ hội cho đòn đánh Nhẫn Thuật sẽ kích hoạt một chuỗi kết hợp đòn. Đòn tấn công kết hợp chỉ gây 50% DMG và CC thành công\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Liên Hoàn</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_140']='<div><div fontcolor=#9e501b>GIẢM THƯƠNG: </div> trong 2 lượt, tăng 10% Giảm Thương\n\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Giảm Thương</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_141']='<div><div fontcolor=#9e501b>Đánh chùm: </div> 20% cơ hội cho đòn tấn công Thể Thuật sẽ kích hoạt một chuỗi kết hợp chiêu. Tăng thêm 50% DMG và CC\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Đánh chùm</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_142']='<div><div fontcolor=#9e501b>Hấp Thụ: </div> phục hồi 20% bằng T.DMG đã gây ra thành Sinh mệnh cho bản thân.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp+ </div><div fontcolor=#9e501b> Hấp Thụ</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_143']='<div><div fontcolor=#9e501b>Cứng Rắn: </div> giảm 10% DMG khi bị Đau Khổ/Đánh chùm/Liên Hoàn unit attacks\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Cứng Rắn</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_144']='<div><div fontcolor=#9e501b>Lá Chắn: </div> Thêm [Lá Chắn]cho tất cả đồng minh khi trận chiến bắt đầu, hấp thụ DMG bằng 4% Sinh mệnh tối đa của Ninja trong 2 lượt. Không cộng dồn.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Lá Chắn]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_145']='<div><div fontcolor=#9e501b>Thanh Lọc: </div> Hồi Phục kỹ năng có 20% cơ hội xóa tất cả trạng thái bất lợi cho 1 đồng minh ngẫu nhiên\nAllows Ninja tới<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Thanh Lọc</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_146']='<div><div fontcolor=#9e501b>Dội Lại: </div> 20% cơ hội khi nhận sát thương sẽ phục hồi 30%\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> Dội Lại</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_147']='<div><div fontcolor=#9e501b>Giá Trị: </div> Tăng 10% DMG Thể Thuật trong 2 lượt khi trận chiến bắt đầu. Không thể bị giải trừ.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Giá Trị]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_148']='<div><div fontcolor=#9e501b>Nhắm Chuẩn: </div> + 10% Sát thương nhẫn thuật trong 2 lượt khi trận chiến bắt đầu. Không thể bị giải trừ.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Nhắm Chuẩn]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_149']='<div><div fontcolor=#9e501b>Chấn Động: </div> DMG giao động trong khoảng 90% - 110% trên mỗi đòn tấn công của ninja tấn công tầm xa. \nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Chấn Động]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_150']='<div><div fontcolor=#9e501b>Ân Xá: </div> Tăng 2% Tấn công của bản thân. Nếu đơn vị nhận một đòn tấn công có sát thương cao hơn 40% Sinh mệnh của bản thân, sẽ có 20% cơ hội giảm sát thương đó đi 30%.\nEnable ninja tới<div fontcolor=#9e501b> học </div> hoặc<div fontcolor=#9e501b> Tăng Cấp </div><div fontcolor=#9e501b> Ân Xá </div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_151']='<div><div fontcolor=#9e501b>Linh Hồn: </div> Rời khỏi trận chiến nếu bị hạ gục và 5% cơ hội quay lại trận chiến với 15% Sinh mệnh được phục hồi ở lượt tiếp theo. Cứ sau 1 lượt, tăng 5% cơ hội hồi sinh. Chắc chắn hồi sinh sau 5 lượt. Kỹ năng chỉ có hiệu lực 1 lần trong mỗi trận chiến.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Linh Hồn]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_152']='<div><div fontcolor=#9e501b>Mê Hoặc: </div> Gây 10% sát thương lên các mục tiêu có hiệu ứng [Linh Hồn]. [Linh Hồn] Sẽ mất hiệu lực khi mục tiêu bị hạ gục.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Mê Hoặc]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_153']='<div><div fontcolor=#9e501b>Tham Lam: </div> Hồi máu cho kẻ tấn công bằng 10% DMG gây ra từ kỹ năng Nhẫn Thuật.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Tham Lam]</div> kỹ năng. Nhẫn Thuật Học mở khóa khi ninja đạt tới<div fontcolor=#9e501b> 6<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_154']='<div><div fontcolor=#9e501b>Phá Giáp: </div> Gây 5% sát thương lên các mục tiêu có hiệu ứng [Lá Chắn], và 30% sát thương của bạn sẽ bỏ qua [Lá Chắn].\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Phá Giáp]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_155']='<div><div fontcolor=#9e501b>Tích lực: </div> Nếu không thể thực hiện lượt này do hiệu ứng kỹ năng, tăng 25% cho sát thương kỹ năng tiếp theo. (có thể cộng dồn và không thể bị giải trừ. Nó sẽ bị giải trừ sau khi một kỹ năng tấn công được tung ra).\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Tích lực]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_156']='<div><div fontcolor=#9e501b>Nhanh Nhẹn: </div> Bỏ qua mọi loại hiệu ứng giảm Tốc độ. Vào đầu mỗi lượt, theo thứ tự cải thiện Tốc độ của bản thân lên 3%/6%/9%/11% cho mỗi ninja cùng nguyên tố tồn tại. (Không tồn tại cùng với [Nhanh]. Kỹ năng này có hiệu lực ưu tiên).\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Nhanh Nhẹn]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_157']='<div><div fontcolor=#9e501b>Hình Phạt: </div> Các mục tiêu nhận thêm [Sinh mệnh* 3%] sát thương. (Không cao hơn 30% sát thương kỹ năng nhận được).\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Hình Phạt]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_158']='<div><div fontcolor=#9e501b>Niềm Tin: </div> Giảm 5% T.DMG nhận khi Sinh mệnh trên 50%, nhận 10% Hiệu ứng hồi phục khi Sinh mệnh dưới 50%.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Niềm Tin]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_159']='<div><div fontcolor=#9e501b>Bảo Hộ: </div> Nếu đồng minh bị hạ gục do sát thương bạo kích, sẽ nhập 10% Sinh mệnh của bản thân vào Bảo Hộ. Kỹ năng sẽ không được kích hoạt nếu chỉ có 40% hoặc thấp hơn Sinh mệnh. Thời gian hồi chiêu: 4 lượt.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Bảo Hộ]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_160']='<div><div fontcolor=#9e501b>Cảm Hứng: </div> Khi sử dụng kỹ năng buff chủ động, 20% cơ hội kéo dài hiệu ứng buff thêm 1 lượt. Thời gian hồi chiêu: 2 lượt. Khi sử dụng kỹ năng gỡ lỗi, CC thành công + 5%.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Cảm Hứng]</div> Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_161']='<div><div fontcolor=#9e501b>Viện Trợ: </div> Khi sử dụng các kỹ năng Hồi phục , đồng minh có lượng Sinh mệnh thấp hơn 20% sẽ nhận thêm 20% * llượng Sinh mệnh đã mất theo tỷ lệ hồi máu.\nMở để Ninja<div fontcolor=#9e501b> học</div> hoặc<div fontcolor=#9e501b> nâng cấp </div><div fontcolor=#9e501b> [Viện Trợ]</div> Lớp-độc quyền Thức tỉnh Nhẫn Thuật. Thức tỉnh Mở khóa khi ninja dạt tới<div fontcolor=#9e501b> 13<img src=common_90074.png visible=true scale=0.75 /></div></div>',
['语言_ite_1_d_162']='Nhẫn Thuật Thần Thoại này có sức mạnh Thức tỉnh. Sử dụng nó để nhận ngẫu nhiên<div fontcolor=#9e501b> Nhẫn Thuật Độc Quyền 13<img src=common_90074.png visible=true scale=0.75 /></div>',
['语言_ite_1_d_163']='Nhẫn Thuật Thần Thoại này có sức mạnh Thức tỉnh. Sử dụng nó để chọn một<div fontcolor=#9e501b> Nhẫn Thuật Độc Quyền 13<img src=common_90074.png visible=true scale=0.75 /></div>',
['语言_ite_1_d_164']='A crystal of azure color. Sử dụng để<div fontcolor=#9e501b> nâng cấp Chakra</div>',
['语言_ite_1_d_165']='Pha lê màu đỏ tươi. Sử dụng để<div fontcolor=#9e501b> nâng cấp Chakra</div>',
['语言_ite_1_d_166']='Pha lê màu ngọc lục bảo. Sử dụng để<div fontcolor=#9e501b> nâng cấp Chakra</div>',
['语言_ite_1_d_167']='Một tinh thể tỏa ra ánh sáng rạng rỡ. Sử dụng để<div fontcolor=#9e501b> nâng cấp Chakra</div>',
['语言_ite_1_d_168']='Pha lê tối tăm và u ám. Sử dụng để<div fontcolor=#9e501b> nâng cấp Chakra</div>',
