['语言_hol_ro_2_993063']='Ninjutsu\nTag',
['语言_hol_ro_2_991066']='Shop\nhuyền thoại',
['语言_gate_1']='Conduct Soul Homology in Lab, get your high-tier ninjas right away!',
['语言_gate_2']='Purchase and exchange of limited skin ends in: <div fontColor=#66e734 >%s<div>',
['语言_gate_3']='Let the ocean wash the heat away!',
['语言_gate_4']='1.You can use items to trade for skin shards %s days later, one time only.\n2.Please trade all %d shards at a time.\n3.You can obtain this Skin even though you don\'t have the corresponding ninja.\n4.Each item can only trade for a limited number of Skin shards.\n5.Players who already held this skin is not allowed to trade for it.',
['语言_gate_5']='Purchase and exchange of limited ninja ends in:<div fontColor=#66e734 >%s<div>',
['语言_hol_leg_na_01']='Thử nghiệm 8 sao',
['语言_hol_leg_na_02']='Thử nghiệm 9 sao',
['语言_hol_leg_na_03']='Thử nghiệm 10 sao',
['语言_hol_leg_na_04']='Thử nghiệm 11 sao',
['语言_hol_leg_na_05']='Thử nghiệm 12 sao',
['语言_hol_leg_na_06']='Thử nghiệm 13 sao',
['语言_hol_leg_des_01']='Các ninja huyền thoại trước đây khi đột kích đã thiết lập ở đây nhiều cửa ải. Chỉ sau khi phá bỏ mới có thể trở thành ninja huyền thoại.',
['语言_hol_leg_des_02']='Để phá vỡ, đồng đội đã kiệt sức, đến lúc thay loạt đồng đội mới để tiếp tục xuất phát rồi.',
['语言_hol_leg_des_03']='Kẻ thù ngày càng mạnh, nhưng bây giờ không phải lúc dừng lại, thu dọn đồ đạc và tiếp tục lên đường.',
['语言_hol_leg_des_04']='Chỉ còn vài bước nữa là có thể đến điểm cuối nhận phần thưởng, hãy ghép đội hình xoay quanh những ninja huyền thoại của tương lai thôi.',
['语言_hol_leg_des_05']='Điểm cuối ngay trước mắt rồi, nhưng các đối thủ ngày càng mạnh hơn, mấu chốt của chiến thắng là liệu họ có thể xếp được một đội hình tương xứng hay không.',
['语言_hol_leg_des_06']='Đánh bại ninja huyền thoại trước đó để kế thừa danh hiệu của anh ta và nhận phần thưởng. Nhưng mọi mắt xích trong đội hình cần phải được ghép nối cẩn thận.',
['语言_hol_leg_rob_01']='Hộ vệ 8 sao',
