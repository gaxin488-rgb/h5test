['语言_exc_01_8']='Cửa hành Ninja',
['语言_exc_01_9']='Tự động làm mới sau khi tất cả các vật phẩm được bán',
['语言_exc_01_10']='Cửa hàng Magatama bị khóa.',
['语言_exc_01_11']='Chưa mở khóa cửa hàng nhà ở',
['语言_exc_01_12']='Đấu Trường liên SV không khóa',
