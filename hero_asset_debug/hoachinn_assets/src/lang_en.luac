['语言_s_2785']='Trong Đấu trường (%s), của mùa trước, bạn xếp ở vị trí thứ.%s . Đây là phần thưởng của bạn. Hẹn gặp lại các bạn vào mùa sau!',
['语言_s_2786']='Hôm nay bạn xếp hạng.%s trong Đấu trường lúc 21: 00. Đây là phần thưởng xếp hạng hàng ngày của bạn!',
['语言_s_2787']='Người chơi thân mến, mùa Đấu trường sẽ được kiểm đếm trước vì máy chủ của bạn sẽ sớm được hợp nhất. Bạn đã xếp hạng %s trong Đấu trường trước khi hợp nhất, vui lòng nhận phần thưởng.',
['语言_s_2788']='Chỉ có thể bỏ qua sau %s lần thử thách',
['语言_s_2789']=' ',
['语言_s_2790']='%s đã đạt vị trí số 1 trong Đấu trường!%s',
['语言_s_2791']='Kính gửi Người chơi,\nMột mùa giải Vô địch mới sẽ bắt đầu lúc %s/%s %s:  %s. Đi đến Đấu trường để tham gia hoặc đặt cược vào Giải vô địch. 3 người chơi hàng đầu cũng sẽ nhận được phần thưởng độc quyền.\nCuối cùng thì ai sẽ chiến thắng?',
['语言_s_2792']='Kính gửi Người chơi,\nBạn đã hoàn thành với hạng.%s trong mùa giải Vô địch này. Đây là phần thưởng xếp hạng của bạn.',
['语言_s_2793']='Vòng sơ loại đã hoàn tất và vòng 32 đã bắt đầu! Đặt cược của bạn và kiếm phần thưởng!%s',
['语言_s_2794']='Chúng tôi đưa ra 4 người chơi hàng đầu:   %s. Ai sẽ về đích trên đỉnh?',
['语言_s_2795']='Giải vô địch này đã kết thúc. Xin chúc mừng nhà vô địch, %s!',
['语言_s_2796']='Chúc mừng! Bạn đã hoàn thành với hạng.%s trong Hội Nindo của mùa này và nhận được những phần thưởng sau! ',
['语言_s_2797']='%s đã giành được %s thành tích trong Hội Nindo!%s',
['语言_s_2798']='Ồ, chờ một chút! %s hiện là nhà vô địch trong Hội Nindo! Tôi phải cho một Like! %s',
