----------------------------------------------------
---- UI 帮助工具
---- 
------------------------------------------------------
DebugSpineHelper = DebugSpineHelper or BaseClass()

function DebugSpineHelper:__init(obj)
    GM_UI_DEBUG = true
    DebugSpineHelper.Instance = self
    self.obj = obj
    self:initUI()
    self:registerEvents()
end

function DebugSpineHelper:getInstance(obj)
    if DebugSpineHelper.Instance == nil then
        DebugSpineHelper.New(obj)
    end
    return DebugSpineHelper.Instance
end

function DebugSpineHelper:initUI()
    self.root = ccui.Layout:create()
    ViewManager:addToLayerByTag(self.root, ViewMgrTag.DEBUG_TAG, 100)
    self.root:setContentSize(cc.size(display.width, display.height))
    self.root:setTouchEnabled(true)
    local size = cc.size(SCREEN_WIDTH, SCREEN_HEIGHT)
    self.container = ccui.Layout:create()
    self.root:addChild(self.container, 20)
    self.container:setBackGroundColor(cc.c3b(0,0,0))
    self.container:setBackGroundColorOpacity(255)
    self.container:setBackGroundColorType(1)
    self.container:setContentSize(size)
    self.container:setAnchorPoint(0.5, 0.5)
    self.container:setOpacity(255)
    self.container:setPosition(display.width/2, display.height/2)

    self.close_btn = CustomButton.New(self.container, PathTool.getResFrame("common", "common_1028"),nil, nil, LOADTEXT_TYPE_PLIST)
    self.close_btn:setAnchorPoint(cc.p(1,1))
    self.close_btn:setPosition(size.width - 2, size.height - 2)

    --创建输入框
    self.input_1 = createEditBox(self.container, PathTool.getResFrame("common", "common_1058"), cc.size(300, 45), cc.c3b(1, 1, 1), 25, nil, 25, "命令@", nil, nil, LOADTEXT_TYPE_PLIST)
    self.input_1:setPlaceHolder("请输入spine文件名@")
    self.input_1:setPosition(display.width/2 - 150, display.height - 130)

    self.input_2 = createEditBox(self.container, PathTool.getResFrame("common", "common_1058"), cc.size(300, 45), cc.c3b(1, 1, 1), 25, nil, 25, "命令@", nil, nil, LOADTEXT_TYPE_PLIST)
    self.input_2:setPlaceHolder("请输入spine动画名@")
    self.input_2:setPosition(display.width/2 - 150, display.height - 190)

    self.input_3 = createEditBox(self.container, PathTool.getResFrame("common", "common_1058"), cc.size(300, 45), cc.c3b(1, 1, 1), 25, nil, 25, "命令@", nil, nil, LOADTEXT_TYPE_PLIST)
    self.input_3:setPlaceHolder("loop: 1 循环 0 不循环@")
    self.input_3:setPosition(display.width/2 - 150, display.height - 249)

    self.input_4 = createEditBox(self.container, PathTool.getResFrame("common", "common_1058"), cc.size(300, 45), cc.c3b(1, 1, 1), 25, nil, 25, "命令@", nil, nil, LOADTEXT_TYPE_PLIST)
    self.input_4:setPlaceHolder("偏移 0,0@")
    self.input_4:setPosition(display.width/2 + 150, display.height - 249)
    self.input_4:registerScriptEditBoxHandler(function(strEventName,pSender)
        if strEventName == "return" then 
            local text = pSender:getText()
            local strList = string.split(text, ",")
            local x = tonumber(strList[1]) or 0
            local y = tonumber(strList[2]) or 0
            if self.dis_spine then
                self.dis_spine:setPosition(self.dis_spine.start_pos.x + x, self.dis_spine.start_pos.y + y)
            end
        end
    end)

    self.confirm_btn = CustomButton.New(self.container, PathTool.getResFrame("common", "common_1050"),nil, nil, LOADTEXT_TYPE_PLIST)
    self.confirm_btn:setAnchorPoint(cc.p(0.5,0.5))
    self.confirm_btn:setPosition(size.width/2 + 130, size.height - 130)
    local label = cc.Label:createWithTTF("", DEFAULT_FONT, 20)
    label:setTextColor(cc.c4b(0,0,255,255))
    label:setAnchorPoint(0.5, 0.5)
    self.confirm_btn:addChild(label, 10)
    label:setPosition(self.confirm_btn:getContentSize().width/2, self.confirm_btn:getContentSize().height/2)
    label:setString("展示@")
    self.confirm_btn:setLocalZOrder(10)

    self.show_btn = CustomButton.New(self.container, PathTool.getResFrame("common", "common_1050"),nil, nil, LOADTEXT_TYPE_PLIST)
    self.show_btn:setAnchorPoint(cc.p(0.5,0.5))
    self.show_btn:setPosition(size.width/2 + 130, size.height - 190)
    local label = cc.Label:createWithTTF("", DEFAULT_FONT, 20)
    label:setTextColor(cc.c4b(0,0,255,255))
    label:setAnchorPoint(0.5, 0.5)
    self.show_btn:addChild(label)
    label:setPosition(self.show_btn:getContentSize().width/2, self.show_btn:getContentSize().height/2)
    label:setString("隐藏按钮@") --or 显示按钮
    self.show_btn.show_label = label
    self.show_btn:setLocalZOrder(10)

    self.show_all_btn = CustomButton.New(self.container, PathTool.getResFrame("common", "common_1050"),nil, nil, LOADTEXT_TYPE_PLIST)
    self.show_all_btn:setAnchorPoint(cc.p(0.5,0.5))
    self.show_all_btn:setPosition(size.width/2 + 280, size.height - 190)
    local label = cc.Label:createWithTTF("", DEFAULT_FONT, 20)
    label:setTextColor(cc.c4b(0,0,255,255))
    label:setAnchorPoint(0.5, 0.5)
    self.show_all_btn:addChild(label)
    label:setPosition(self.show_all_btn:getContentSize().width/2, self.show_all_btn:getContentSize().height/2)
    label:setString("自动展示@") --or 显示按钮
    self.show_all_btn.show_label = label
    self.show_all_btn:setLocalZOrder(10)

    local node_btn = cc.Node:create()
    self.container:addChild(node_btn, 10)
    self.node_btn = node_btn
    self.node_btn.isShow = true
end

function DebugSpineHelper:createBtn(name, pos, callback)
    local _btn = CustomButton.New(self.node_btn, PathTool.getResFrame("common", "common_1050"),nil, nil, LOADTEXT_TYPE_PLIST)
    _btn:setAnchorPoint(cc.p(0.5,0.5))
    local pos = pos or cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2)
    _btn:setPosition(pos)
    local label = cc.Label:createWithTTF("", DEFAULT_FONT, 20)
    label:setTextColor(cc.c4b(0,0,255,255))
    label:setAnchorPoint(0.5, 0.5)
    _btn:addChild(label)
    label:setPosition(_btn:getContentSize().width/2, _btn:getContentSize().height/2)
    label:setString(name)
    _btn:setName(name)
    _btn:addTouchEventListener(function(sender, event)
        if ccui.TouchEventType.ended == event then
            callback(sender)
        end
    end)
    return _btn
end

function DebugSpineHelper:onClickConfirmHandler()
    local str_1 = self.input_1:getText()
    local str_2 = self.input_2:getText()
    if str_1 ~= "" then
        if self.dis_spine then
            self.dis_spine:removeFromParent()
            self.dis_spine = nil
        end
        if self.ani_btn_list and #self.ani_btn_list > 0 then
            for i,v in ipairs(self.ani_btn_list) do
                v:removeFromParent()
            end
            self.ani_btn_list = nil
        end
        local action = nil
        if str_2 ~= "" then
            action = str_2
        end
        local strList = string.split(str_1, ",")
        local spine_name = strList[1]
        local action_name = strList[2] or self:getInitAction(spine_name)
        self.input_1:setText(spine_name..","..action_name)
        local dis_spine = createSpineByName(spine_name, action_name)--(str_1, cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2 - 100), cc.p(0.5, 0.5), true, action)
        if dis_spine then
            dis_spine.start_pos = cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2 - 50)
            dis_spine:setPosition(cc.p(cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2 - 50)))
            dis_spine:setAnchorPoint(cc.p(0.5, 0.5))
            self.container:addChild(dis_spine, 9)
            local str_3 = self.input_3:getText()
            self.dis_spine = dis_spine
            local initaction = action or self:getInitAnimation(dis_spine)
            if initaction and self.dis_spine:findAnimation(initaction) then
                dis_spine:setAnimation(0, initaction, str_3 == "1")
            end
            self.ani_btn_list = {}
            --查找包含的动画名
            local func = function(sender)
                local str_3 = self.input_3:getText()
                self.dis_spine:setAnimation(0, sender:getName(), str_3 == "1")
            end
            for k,v in pairs(PlayerAction) do
                if self.dis_spine:findAnimation(v) then
                    local x = 60 + (#self.ani_btn_list%6 * 120)
                    local y = SCREEN_HEIGHT/2 - 200 - 50*(math.floor(#self.ani_btn_list/6))
                    local pos = cc.p(cc.p(x, y))
                    self.ani_btn_list[#self.ani_btn_list + 1] = self:createBtn(v, pos, func)
                end
            end
            local function animationEventFunc(event)
                if event and event.eventData and event.eventData.name then
                    print("-----------------动画帧事件",event.eventData.name)
                end
            end
            dis_spine:registerSpineEventHandler(animationEventFunc, sp.EventType.ANIMATION_EVENT)
        end
    end
end

function DebugSpineHelper:getInitAction(spine_name)
    for k,v in pairs(PlayerAction) do
        local spine_path = string_format("spine/%s/%s", spine_name, v)
        local atlas = string_format("%s.atlas", spine_path)
        if PathTool.isFileExist(atlas) then
            return v;
        end
    end
    print("-----------------没有动作")
    return PlayerAction.action
end

function DebugSpineHelper:getActionList(spine_name)
    local list = {}
    for k,v in pairs(PlayerAction) do
        local spine_path = string_format("spine/%s/%s", spine_name, v)
        local atlas = string_format("%s.atlas", spine_path)
        if PathTool.isFileExist(atlas) then
            table.insert(list,v)
        end
    end
    return list
end

function DebugSpineHelper:getInitAnimation(dis_spine)
    for k,v in pairs(PlayerAction) do
        if dis_spine:findAnimation(v) then
            return v
        end
    end
    return PlayerAction.action
end

function DebugSpineHelper:showBtnNode()
    if not self.dis_spine then
        return
    end
    local offx = 0
    if self.node_btn.isShow then
        offx = -770
    end

    local array = {}
    local position = cc.p(offx, 0)
    array[#array+1] = cc.MoveTo:create(0.2, position)
    array[#array+1] = cc.CallFunc:create(function()
        self.node_btn.isShow = not self.node_btn.isShow
        self.show_btn.show_label:setString(self.node_btn.isShow and "隐藏按钮@" or "显示按钮@")
        self.show_btn:setTouchEnabled(true)
    end)
    local action = cc.Sequence:create(array)
    self.node_btn:runAction(action)
    self.show_btn:setTouchEnabled(false)
end

-- 测试所有配置的动画文件，可以识别动画skel文件知道有多少个动画
function DebugSpineHelper:showAllSpine()
    if self.showTestSpine then return end
    self.showTestSpine = true
    self.showSpineList = {"H69001","H70000","H99999"}
    if TEST_SHOW_SPINE_LIST then
        self.showSpineList = TEST_SHOW_SPINE_LIST
    end
    if not self.oneSpineLayer then
        self.oneSpineLayer = cc.Node:create()
        self.container:addChild(self.oneSpineLayer, 11)
    end
    self.showSpineIndex = 1
    self:showSpineLoop()
end

function DebugSpineHelper:showSpineLoop()
    local sname = self.showSpineList[self.showSpineIndex]
    local actionList = self:getActionList(sname)
    self.oneSpineLayer:removeAllChildren(true)
    self.oneSpineLayer:stopAllActions()
    if not sname then
        self.showTestSpine = false
        print("@显示结束")
        return
    end
    if #actionList > 0 then
        for key, value in pairs(actionList) do
            local nameall = sname..","..value
            print("showSpineLoop",nameall)
            self.input_1:setText(nameall)
            if key == 1 then
                self.showSpineIndex = self.showSpineIndex + 1
                delayRun(
                    self.oneSpineLayer, 5, function()
                        self:showSpineLoop()
                    end
                )
                self:showOneSpine(nameall,true)
            else
                self:showOneSpine(nameall,false)
            end
        end
    else
        self.showSpineIndex = self.showSpineIndex + 1
        self:showSpineLoop()
    end
end

function DebugSpineHelper:showOneSpine(nameall,backcall)
    local str_1 = nameall
    if str_1 ~= "" then
        local action = nil
        local strList = string.split(str_1, ",")
        local spine_name = strList[1]
        local action_name = strList[2] or self:getInitAction(spine_name)
        self.input_1:setText(spine_name..","..action_name)
        local one_spine = createSpineByName(spine_name, action_name)
        if one_spine then
            one_spine.start_pos = cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2 - 50)
            one_spine:setPosition(cc.p(cc.p(SCREEN_WIDTH/2, SCREEN_HEIGHT/2 - 50)))
            one_spine:setAnchorPoint(cc.p(0.5, 0.5))
            self.oneSpineLayer:addChild(one_spine)
            local str_3 = self.input_3:getText()
            self.one_spine = one_spine
            local initaction = action or self:getInitAnimation(one_spine)
            if initaction and one_spine:findAnimation(initaction) then
                one_spine:setAnimation(0, initaction, str_3 == "1")
            end
            local function animationEndFunc(event)
                delayRun(
                    self.oneSpineLayer, 3 / display.DEFAULT_FPS, function()
                        -- one_spine:setVisible(false)
                        self:showSpineLoop()
                    end
                )
            end
            if backcall then
                one_spine:registerSpineEventHandler(animationEndFunc, sp.EventType.ANIMATION_COMPLETE)
            end
        end
    end
end

function DebugSpineHelper:registerEvents()
    handleTouchEnded(self.close_btn, function()
        self:close()
    end)

    handleTouchEnded(self.confirm_btn, function()
        self:onClickConfirmHandler()
    end)

    self.show_btn:addTouchEventListener(function(sender, event)
        if ccui.TouchEventType.ended == event then
            self:showBtnNode()
        end
    end)

    self.show_all_btn:addTouchEventListener(function(sender, event)
        if ccui.TouchEventType.ended == event then
            self:showAllSpine()
        end
    end)
end

function DebugSpineHelper:open()
    self.root:setVisible(true)
end

function DebugSpineHelper:close()
    self.root:setVisible(false)
end
