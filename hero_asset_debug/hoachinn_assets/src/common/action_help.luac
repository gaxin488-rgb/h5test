-- 部分动作工具类
-- author:cloud
ActionHelp = ActionHelp or {}


--移动操作
--move_node:操作节点
--size：节点尺寸
--pos_old--运动前位置
--pos_new--运动后位置
--time--运动时间
function ActionHelp.MoveAction(move_node,size,pos,time,call_back)
    if tolua.isnull(move_node) then return end
    -- if not move_node then return end
    local fun = function ()  
    end
    if not call_back then
        call_back = fun
    end
    size = size or cc.size(0,0)
    pos = pos or cc.p(0,0)
    pos_new = pos_new or cc.p(0,0)
    time = time or 0.1
    local act_move = cc.MoveTo:create(time,pos)
    local act_move1 = cc.MoveTo:create(0.1,cc.p(pos.x,pos.y+5))
    local act_move2 = cc.MoveTo:create(0.1,pos)
    move_node:runAction(cc.Sequence:create(act_move,act_move1,act_move2, cc.CallFunc:create(call_back)))
end

--放大缩小
function ActionHelp.ScaleAction(scale_node,call_back)
    if tolua.isnull(move_node) then return end
    -- if not scale_node then return end
    local fun = function ()  
    end
    if not call_back then
        call_back = fun
    end
    local action1 = cc.ScaleTo:create(0.2, 1.1)
    local action2 = cc.ScaleTo:create(0.2, 1)
    scale_node:runAction(cc.Sequence:create(action1,action2, cc.CallFunc:create(call_back)))
end

--==============================--
--desc:Item scrollview动画
--time:2020-03-17 06:46:35
--@obj:节点
--@move_x:偏移X坐标
--@move_y:偏移Y坐标
--@time:移动时间
--@not_ease:不要回弹
--@delay_time:延迟执行时间
--@return 
--==============================--
function ActionHelp.itemUpAction(obj, move_x, move_y, time, not_ease, delay_time, callback, ease_name, more)
    if obj == nil or tolua.isnull(obj) then return end
    move_x = move_x or 400
    move_y = move_y or 0
    time = time or 0.2
    delay_time = delay_time or 0
    local pos_x, pos_y = obj:getPosition()
    obj:setOpacity(0)
    obj:setPosition(pos_x-move_x, pos_y-move_y)
    local act_move
    if not_ease then
        act_move = cc.MoveBy:create(time,cc.p(move_x, move_y))
    else
        ease_name = ease_name or "BACKOUT"
        act_move = transition.newEasing(cc.MoveBy:create(time,cc.p(move_x, move_y)), ease_name, more)
    end
    obj:runAction(transition.sequence({
        cc.DelayTime:create(delay_time),
        cc.Spawn:create(act_move, cc.FadeIn:create(time)),
        cc.CallFunc:create(function()
            if callback then
                callback()
            end
        end)
    }))
end

--==============================--
--desc:Item scrollview动画
--time:2020-03-17 06:46:35
--@obj:节点
--@sscale:开始缩放
--@escale:结束缩放
--@time:移动时间
--@isOpacity:是否显隐
--@delay_time:延迟
--@noEase:不要回弹
--@return 
--==============================--
function ActionHelp.itemScaleAction(obj, sscale, escale, time,isOpacity,delay_time,ease_type,noEase)
    if obj == nil or tolua.isnull(obj) then return end
    sscale = sscale or 0.3
    escale = escale or 1
    time = time or 0.3
    if isOpacity == nil or isOpacity == true then
        obj:setOpacity(0)
    end
    
    obj:setScale(sscale)
    noEase = noEase or false
    local fadeIn = cc.FadeIn:create(time - 0.1)

    local act_scale = cc.ScaleTo:create(time, escale)
    local act_1 = noEase and act_scale or cc.EaseBackOut:create(act_scale)
    local spawn_action = cc.Spawn:create(act_1, fadeIn)
    if delay_time then
        obj:runAction(cc.Sequence:create(cc.DelayTime:create(delay_time),spawn_action))
    else
        obj:runAction(spawn_action)
    end
end

--==============================--
--desc:Item scrollview动画
--time:2020-03-17 06:46:35
--@obj:节点
--@sOpacity:开始透明度
--@time:移动时间
--@return 
--==============================--
function ActionHelp.itemOpacityAction(obj, sOpacity, time)
    if obj == nil or tolua.isnull(obj) then return end
    sOpacity = sOpacity or 0
    time = time or 0.3
    obj:setOpacity(sOpacity)
    local fadeIn = cc.FadeIn:create(time)
    local spawn_action = cc.Spawn:create(fadeIn)
    obj:runAction(spawn_action)
end

--[[
    @desc: 列表item从上往下掉、渐显动画
    author:qyx
    --@obj:
	--@move_x:
	--@move_y:
	--@opacity:
	--@time: 
]]
function ActionHelp.itemFadeDownAction( obj, move_x, move_y, opacity, time, is_ease, is_callfuc)
    if obj == nil or tolua.isnull(obj) then return end

    time = time or 0.3
    move_x = move_x or 0
    move_y = move_y or 0

    local pos_x, pos_y = obj:getPosition()
    
    obj:setPosition(pos_x - move_x, pos_y - move_y)
    obj:setOpacity(opacity or 0)
    
    if is_callfuc == true and obj.setTouchEnabled then
        obj:setTouchEnabled(false) -- 防止误触
    end
    local act_1 = cc.MoveBy:create(time, cc.p(move_x, move_y))
    local act_2 = cc.FadeIn:create(time)
    local callfunc = cc.CallFunc:create(function()
        if obj.setTouchEnabled and is_callfuc == true then
            obj:setTouchEnabled(true)
        end
    end)
    local spawn = cc.Spawn:create(act_1, act_2)
    if is_ease == true then
        -- obj:runAction(cc.Spawn:create(cc.EaseBackOut:create(act_1), act_2))
        spawn = cc.Spawn:create(cc.EaseBackOut:create(act_1), act_2)
    else
        -- obj:runAction(cc.Spawn:create(act_1, act_2))
    end
    obj:runAction(cc.Sequence:create(spawn,callfunc))
end


-- 翻转动画
function ActionHelp.itemFlipAction( obj, time ,is_ease)
    if obj == nil or tolua.isnull(obj) then return end
    time = time or 0.1
    local act_1 = cc.ScaleTo:create(time, 0.01,1)
    local act_2 = cc.ScaleTo:create(time, 1)
    if is_ease == true then
        act_1 = cc.EaseBackOut:create(cc.ScaleTo:create(time, -1, 1.2))
        act_2 = cc.EaseBackOut:create(cc.ScaleTo:create(time, 1))
    end
    obj:runAction(cc.Sequence:create(act_1, act_2))
end

-- 展开
function ActionHelp.itemUnfoldAction( obj, time )
    if obj == nil or tolua.isnull(obj) then return end
    time = time or 0.3
    obj:setScaleX(0)
    obj:setOpacity(0)
    local scale_act_1 = cc.ScaleTo:create(time-0.1, 1.2, 1)
    local scale_act_2 = cc.ScaleTo:create(0.1, 1)
    local fade_in = cc.FadeIn:create(time)
    obj:runAction(cc.Spawn:create((cc.Sequence:create(scale_act_1, scale_act_2)), fade_in))
end

-- 放大压下去效果
function ActionHelp.pressDownAction(obj, enlarge_time, narrow_time, callback)
    if obj == nil or tolua.isnull(obj) then return end
    enlarge_time = enlarge_time or 0.15
    narrow_time = narrow_time or 0.1
    obj:setScale(1)
    obj:setOpacity(255)
    local scale_enlarge = cc.ScaleTo:create(enlarge_time, 1.3)
    local scale_narrow = cc.ScaleTo:create(narrow_time, 1)
    obj:runAction(cc.Sequence:create(scale_enlarge, scale_narrow,
    cc.CallFunc:create(function()
        if callback then
            callback()
        end
    end)))
end

-- 放大淡出效果
function ActionHelp.ZoomFadeoutAction(obj, time, callback)
    if obj == nil or tolua.isnull(obj) then return end
    time = 0.15
    obj:setScale(1)
    obj:setOpacity(255)
    local scale = cc.ScaleTo:create(time, 1.3)
    local fade_out = cc.FadeOut:create(time)
    obj:runAction(
    cc.Sequence:create(cc.Spawn:create(scale, fade_out),
        cc.CallFunc:create(function()
            if callback then
                callback()
            end
            obj:setScale(1)
            obj:setOpacity(255)
        end)))
end

--[[
    @desc: 呼吸灯效果
    author:yq
    --@obj:
	--@time: 
]]
function ActionHelp.breathingLampAction(obj, time)
    if obj == nil or tolua.isnull(obj) then return end
    time = time or 0.1
    local fade_out = cc.FadeOut:create(time)
    local fade_in = cc.FadeIn:create(time)
    obj:runAction(cc.RepeatForever:create(cc.Sequence:create(fade_out, fade_in)))
end