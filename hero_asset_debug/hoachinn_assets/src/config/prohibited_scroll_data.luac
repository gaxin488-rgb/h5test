-- -------------------get_scroll_hand_book_start-------------------
Config.ProhibitedScrollData.data_get_scroll_hand_book_length = 44
Config.ProhibitedScrollData.data_get_scroll_hand_book_cache = {}
Config.ProhibitedScrollData.data_get_scroll_hand_book = function(key)
	if Config.ProhibitedScrollData.data_get_scroll_hand_book_cache[key] == nil then
		local base = Config.ProhibitedScrollData.data_get_scroll_hand_book_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.ProhibitedScrollData.data_get_scroll_hand_book_cache[key] = {
			id = base[1],
			group = base[2],
			level = base[3],
			need_id1 = base[4],
			need_id2 = base[5],
			need_star1 = base[6],
			need_star2 = base[7],
			attr4 = base[8],
			attr3 = base[9],
			name = base[10],
			unlock = base[11],
			proh_hand_book_sort = base[12],
		}
	end
	return Config.ProhibitedScrollData.data_get_scroll_hand_book_cache[key] 
end
