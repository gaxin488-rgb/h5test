Config.ProhibitedScrollData.data_get_unlock_info_fun = function(key)
	local data=Config.ProhibitedScrollData.data_get_unlock_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.ProhibitedScrollData.data_get_unlock_info['..key..'])not found') return
	end
	return data
end
