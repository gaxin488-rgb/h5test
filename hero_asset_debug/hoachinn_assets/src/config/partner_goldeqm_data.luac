Config.PartnerGoldeqmData.data_get_eqm_star = function(key)
	if Config.PartnerGoldeqmData.data_get_eqm_star_cache[key] == nil then
		local base = Config.PartnerGoldeqmData.data_get_eqm_star_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerGoldeqmData.data_get_eqm_star_cache[key] = {
			id = base[1],
			lev = base[2],
			cost = base[3],
			per_attr = base[4],
			attr = base[5],
		}
	end
	return Config.PartnerGoldeqmData.data_get_eqm_star_cache[key] 
end
