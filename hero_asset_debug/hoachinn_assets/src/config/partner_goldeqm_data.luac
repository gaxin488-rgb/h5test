Config.PartnerGoldeqmData.data_get_eqm_refine_length = 48
Config.PartnerGoldeqmData.data_get_eqm_refine_cache = {}
Config.PartnerGoldeqmData.data_get_eqm_refine = function(key)
	if Config.PartnerGoldeqmData.data_get_eqm_refine_cache[key] == nil then
		local base = Config.PartnerGoldeqmData.data_get_eqm_refine_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerGoldeqmData.data_get_eqm_refine_cache[key] = {
			id = base[1],
			lev = base[2],
			enchant_max_lev = base[3],
			cost = base[4],
			attr = base[5],
		}
	end
	return Config.PartnerGoldeqmData.data_get_eqm_refine_cache[key] 
end
