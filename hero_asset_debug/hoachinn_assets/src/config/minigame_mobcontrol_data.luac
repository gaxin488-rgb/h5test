Config.MinigameMobcontrolData.data_obj_info_fun = function(key)
	local data=Config.MinigameMobcontrolData.data_obj_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.MinigameMobcontrolData.data_obj_info['..key..'])not found') return
	end
	return data
end
