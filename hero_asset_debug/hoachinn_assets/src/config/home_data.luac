-- -------------------home_unit_start-------------------
Config.HomeData.data_home_unit_length = 80
Config.HomeData.data_home_unit_cache = {}
Config.HomeData.data_home_unit = function(key)
	if Config.HomeData.data_home_unit_cache[key] == nil then
		local base = Config.HomeData.data_home_unit_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.HomeData.data_home_unit_cache[key] = {
			bid = base[1],
			name = base[2],
			soft = base[3],
			set_id = base[4],
			tile_list_1 = base[5],
			tile_list_2 = base[6],
			offset_1 = base[7],
			offset_2 = base[8],
			type = base[9],
			dir = base[10],
			desc = base[11],
			res = base[12],
			icon = base[13],
			grid_desc = base[14],
			effect_count = base[15],
			soruce_id = base[16],
		}
	end
	return Config.HomeData.data_home_unit_cache[key] 
end
