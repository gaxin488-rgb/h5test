Config.HolidayBossData.data_boss_info_cache = {}
Config.HolidayBossData.data_boss_info = function(key)
	if Config.HolidayBossData.data_boss_info_cache[key] == nil then
		local base = Config.HolidayBossData.data_boss_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.HolidayBossData.data_boss_info_cache[key] = {
			order_id = base[1],
			add_skills = base[2],
			add_skill_decs = base[3],
			unit_id = base[4],
			star = base[5],
			head_id = base[6],
			head_half_id = base[7],
			name = base[8],
			level = base[9],
			dps_score = base[10],
			kill_score = base[11],
			group_id = base[12],
		}
	end
	return Config.HolidayBossData.data_boss_info_cache[key] 
end
