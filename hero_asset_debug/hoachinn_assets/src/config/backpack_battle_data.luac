Config.BackpackBattleData.data_weapon_attr_fun = function(key)
	local data=Config.BackpackBattleData.data_weapon_attr[key]
	if DATA_DEBUG and data == nil then
		print('(Config.BackpackBattleData.data_weapon_attr['..key..'])not found') return
	end
	return data
end
