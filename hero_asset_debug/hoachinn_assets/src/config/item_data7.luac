Config.ItemData7.data_unit = function(key)
	if Config.ItemData7.data_unit_cache[key] == nil then
		local base = Config.ItemData7.data_unit_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
