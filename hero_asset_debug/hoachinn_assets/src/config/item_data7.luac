			id = base[1],
			remark = base[2],
			name = base[3],
			icon = base[4],
			type = base[5],
			sub_type = base[6],
			quality = base[7],
			overlap = base[8],
			gain_type = base[9],
			use_type = base[10],
			value = base[11],
			desc = base[12],
			lev = base[13],
			career = base[14],
			sex = base[15],
			eqm_set = base[16],
			eqm_star = base[17],
			ext = base[18],
			eqm_output_id = base[19],
			eqm_jie = base[20],
			is_effect = base[21],
			type_desc = base[22],
			can_share = base[23],
		}
	end
	return Config.ItemData7.data_unit_cache[key] 
end
