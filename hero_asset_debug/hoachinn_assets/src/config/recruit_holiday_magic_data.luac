-- -------------------action_start-------------------
Config.RecruitHolidayMagicData.data_action_length = 15
Config.RecruitHolidayMagicData.data_action = {
	[50109] = {camp_id=50109, group_id=10001, desc=TI18N("·1、每期魔法召唤都可自选<div fontcolor=#c23f35>1位【心愿英雄】</div>为当期UP英雄，玩家选定<div fontcolor=#c23f35>【心愿英雄】</div>后开启抽奖；抽奖途中可随意<div fontcolor=#c23f35>更换</div>选定英雄\n·2、魔法召唤中，风水火系每50次（光暗系70次）召唤，<div fontcolor=#c23f35>必定获得选定的心愿英雄</div>。通过魔法召唤获取到<div fontcolor=#c23f35>当前选定心愿英雄时</div>，最大剩余召唤次数将<div fontcolor=#c23f36>重置为初始值</div>，并重新开始计算。\n·3、每次十连召唤<div fontcolor=#c23f35>必出5星英雄</div>，5星英雄库含：5星随机碎片*50、5星五系随机碎片*50、心愿英雄；\n·4、如果在中途<div fontcolor=#c23f36>更换</div>心愿英雄，剩余召唤次数将根据<div fontcolor=#c23f35>现有已累计召唤次数切换为所选英雄对应的保底次数</div>（如当前选择的为风水火up英雄，剩余必出招募次数为10次，切换为光暗英雄后，则剩余必出招募次数变更为30次）；\n·5、如果更换前累计召唤次数大于或等于更换后保底次数，则切换后下一次召唤必定获得心愿英雄")},
	[50130] = {camp_id=50130, group_id=10002, desc=TI18N("<div fontcolor=#c23f35>【本期魔法召唤加入新心愿英雄-乌列】</div>\n·1、每期魔法召唤都可自选<div fontcolor=#c23f35>1位【心愿英雄】</div>为当期UP英雄，玩家选定<div fontcolor=#c23f35>【心愿英雄】</div>后开启抽奖；抽奖途中可随意<div fontcolor=#c23f35>更换</div>选定英雄\n·2、魔法召唤中，风水火系每50次（光暗系70次）召唤，<div fontcolor=#c23f35>必定获得选定的心愿英雄</div>。通过魔法召唤获取到<div fontcolor=#c23f35>当前选定心愿英雄时</div>，最大剩余召唤次数将<div fontcolor=#c23f36>重置为初始值</div>，并重新开始计算。\n·3、每次十连召唤<div fontcolor=#c23f35>必出5星英雄</div>，5星英雄库含：5星随机碎片*50、5星五系随机碎片*50、心愿英雄；\n·4、如果在中途<div fontcolor=#c23f36>更换</div>心愿英雄，剩余召唤次数将根据<div fontcolor=#c23f35>现有已累计召唤次数切换为所选英雄对应的保底次数</div>（如当前选择的为风水火up英雄，剩余必出招募次数为10次，切换为光暗英雄后，则剩余必出招募次数变更为30次）；\n·5、如果更换前累计召唤次数大于或等于更换后保底次数，则切换后下一次召唤必定获得心愿英雄")},
