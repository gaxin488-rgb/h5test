Config.RecruitHolidayMagicData.data_special_item_fun = function(key)
	local data=Config.RecruitHolidayMagicData.data_special_item[key]
	if DATA_DEBUG and data == nil then
		print('(Config.RecruitHolidayMagicData.data_special_item['..key..'])not found') return
	end
	return data
end
-- -------------------special_item_end---------------------
