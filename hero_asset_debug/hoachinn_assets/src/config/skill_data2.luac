	[701073] = [[{701073,"trung cấp cấp cứu","phụ trợ thức tỉnh", 70107, 0, 2, 0, 0,"passive_skill", 0, 0, 2, 1, {7010703}, {}, 0,"sử dụng trị liệu chủ động kỹ năng thì ， đối nhau mệnh thấp hơn 25% đích hữu phương ， khiến cho thêm vào đã bị 25%（ cố định giá trị ）* tự thân dĩ tổn thất sinh mệnh chiêm so hiệu quả trị liệu","","","71107", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701063] = [[{701063,"trung cấp linh cảm","phụ trợ thức tỉnh", 70106, 0, 2, 0, 2,"passive_skill", 0, 0, 5, 1, {7010603}, {}, 0,"sử dụng tăng chủ động kỹ năng thì ， có 25% xác suất sử tăng duy trì liên tục hiệp +1， cai hiệu quả làm lạnh 2 hiệp ； sử dụng giảm ích kỹ năng thì ， hiệu quả Thi triển tỷ số +7%","","","71106", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701053] = [[{701053,"trung cấp che chở","xe tăng thức tỉnh", 70105, 0, 2, 0, 4,"passive_skill", 0, 0, 3, 1, {7010503}, {}, 0,"Đồng đội đã bị vết thương trí mệnh hại chết vong hậu ， chuyển vận tự thân 12% sinh mệnh đối kỳ che chở ， tự thân khí huyết thấp hơn 35% sẽ không Thi triển ， làm lạnh 4 hiệp 。","","","71105", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701043] = [[{701043,"trung cấp tín ngưỡng","xe tăng thức tỉnh", 70104, 0, 2, 0, 0,"passive_skill", 0, 0, 5, 1, {7010403,7010413}, {}, 0,"tự thân sinh mệnh ở 50% trở lên thì ， bị vật lý thương tổn rơi chậm lại 8%；50% dưới thì ， đã bị trị liệu tăng 15%","","","71104", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701033] = [[{701033,"trung cấp chế tài","pháp sư thức tỉnh", 70103, 0, 2, 0, 0,"passive_skill", 0, 0, 1, 1, {7010303}, {}, 0,"tấn công thì sử mục tiêu thêm vào đã bị kỳ sinh mệnh hạn mức cao nhất *5% đích thương tổn giá trị （ không vượt lên trước lần này sở thụ kỹ năng thương tổn đáng giá 30%）","","","71103", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701023] = [[{701023,"trung cấp linh xảo","pháp sư thức tỉnh", 70102, 0, 2, 0, 0,"passive_skill", 0, 0, 5, 1, {7010203}, {}, 0,"không nhìn sở hữu giảm tốc độ hiệu quả ； mỗi hiệp bắt đầu ， mỗi tồn tại 1 vị cùng hệ hữu Phương anh hùng ， tự thân tốc độ lần lượt đề cao 5%/8%/11%/13%（ vô pháp dữ (mau lẹ) cùng tồn tại ， ưu tiên có hiệu lực ）","","","71102", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[701013] = [[{701013,"trung cấp súc lực","chiến sĩ thức tỉnh", 70101, 0, 2, 0, 0,"passive_skill", 0, 0, 5, 1, {7010103}, {}, 0,"bản hiệp vô pháp hành động thì ， lần sau thả ra tấn công kỹ năng thì thương tổn thêm vào đề cao 20%（ nhưng chồng ， vô pháp bị đuổi tản ra ， mỗi lần thả ra tấn công kỹ năng lui về phía sau trừ ）","","","71101", 0, 1, 1, {}, 2100, 0, 0, 0}]],
