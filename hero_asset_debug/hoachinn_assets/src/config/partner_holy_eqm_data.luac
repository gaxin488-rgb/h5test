Config.PartnerHolyEqmData.data_base_info_length = 1680
Config.PartnerHolyEqmData.data_base_info_cache = {}
Config.PartnerHolyEqmData.data_base_info = function(key)
	if Config.PartnerHolyEqmData.data_base_info_cache[key] == nil then
		local base = Config.PartnerHolyEqmData.data_base_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerHolyEqmData.data_base_info_cache[key] = {id = base[1],attr_num = base[2],group_id = base[3],limit = base[4],reset_price = base[5],unlock_desc = base[6],is_show = base[7],sort = base[8],tips_info = base[9],show_name = base[10],score = base[11],}
	end
	return Config.PartnerHolyEqmData.data_base_info_cache[key] 
end

