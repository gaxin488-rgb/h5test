	["show_star_condition"] = {val=8, desc=TI18N("Anh hùng đạt 9 sao mở trang phục thần")},
	["open_star_condition"] = {val=9, desc=TI18N("Yêu cầu xếp hạng sao anh hùng để mở trang phục thần thánh")},
	["open_worldlev_condition"] = {val=110, desc=TI18N("Cấp độ thế giới cần thiết để mở trang phục thần thánh")},
	["open_lev_condition"] = {val=105, desc=TI18N("Cấp độ cá nhân cần thiết để mở trang phục thần thánh")},
	["open_lev_second_condition"] = {val=120, desc=TI18N("Cấp độ cá nhân thứ hai cần thiết để mở trang phục thần thánh")},
	["clear_return"] = {val={{10030,600}}, desc=TI18N("Tỷ lệ tài nguyên được trả lại bằng cách giặt，Nếu không điền, mặc định là không trả lại")},
	["lock_pay_diamon"] = {val={{1,50},{2,200}}, desc=TI18N("Khóa tiêu thụ thuộc tính（thay thế，không tích lũy")},
	["game_rule_1"] = {val=1, desc=TI18N("1.Bộ trang phục thần thánh đạt cấp độ cá nhân<div fontcolor=65df74>Cấp 105</div>、đạt đẳng cấp thế giới<div fontcolor=65df74>110级</div>mở；khi anh hùng đến<div fontcolor=65df74>9*</div>时，Mở khóa trang phục thần của anh hùng\n2.每个神装的分为<div fontcolor=65df74>凡品、良品、极品</div>，各自对应有0-2条随机属性，神装的★级和品阶均不可被改变\n3.同时穿戴同名且同★级的神装部件才能激活套装效果，2件套和4件套分别可激活一个套装效果\n4.良品和极品神装可洗练，洗练后可改变随机属性类型和数值，每个装备洗练达到一定次数时，属性会达到最大值\n5.可通过<div fontcolor=65df74>天界副本、神装商店、天界祈祷</div>获取神装 \n6.神装出售后可获得<div fontcolor=65df74>天界神石</div>，天界神石可用于洗练神装\n7.当同时穿戴同系列的不同★级神装时，触发最低★级套装的效果，且<div fontcolor=65df74>2件套与4件套效果分别触发</div>，互不影响")},
	["game_rule_2"] = {val=2, desc=TI18N("1.良品和极品神装可洗练，洗练后可改变随机属性类型和数值\n2.每个装备洗练达到一定次数时，属性会达到最大值\n3.锁定属性后，在洗练时不会改变该属性的类型")},
	["text_show_1"] = {val=1, desc=TI18N("[非良品或以上神装无第1随机属性]")},
	["text_show_2"] = {val=2, desc=TI18N("[非极品神装无第2随机属性]")},
	["text_show_3"] = {val=3, desc=TI18N("[非极品神装无第2随机属性]")},
	["text_show_4"] = {val=4, desc=TI18N("[非极品神装无第2随机属性]")},
	["handbook_unlock_condition"] = {val={{1,0},{2,0},{3,0},{4,15000},{5,24000},{6,9999999},{7,9999999},{8,9999999},{9,9999999},{10,9999999}}, desc=TI18N("Đã mở khóa thẻ Pokédex {ngôi sao, điểm}")},
	["shop_unlock_condition"] = {val={{1,0},{2,0},{3,0},{4,0},{5,15000},{6,15000},{7,15000},{8,15000},{9,20000},{10,20000},{11,20000},{12,20000},{13,20000},{14,20000}}, desc=TI18N("Đã mở khóa thẻ cửa hàng {Đặt ID, điểm}")}
}
