Config.BlindBoxData.data_slot_cfg_length = 11900
Config.BlindBoxData.data_slot_cfg_cache = {}
Config.BlindBoxData.data_slot_cfg = function(key)
	if Config.BlindBoxData.data_slot_cfg_cache[key] == nil then
		local base = Config.BlindBoxData.data_slot_cfg_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.BlindBoxData.data_slot_cfg_cache[key] = {
			chip_id = base[1],
			level = base[2],
			slot1 = base[3],
			slot2 = base[4],
			slot3 = base[5],
			slot4 = base[6],
			slot5 = base[7],
			skill_group_id = base[8],
			items = base[9],
			exp = base[10],
			attr_type = base[11],
			attr_limit = base[12],
			limit_text = base[13],
		}
	end
	return Config.BlindBoxData.data_slot_cfg_cache[key] 
end
