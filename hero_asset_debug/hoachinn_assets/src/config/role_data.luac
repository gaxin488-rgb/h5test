Config.RoleData.data_city_id_to_province_id_length = 476
Config.RoleData.data_city_id_to_province_id_cache = {}
Config.RoleData.data_city_id_to_province_id = function(key)
	if Config.RoleData.data_city_id_to_province_id_cache[key] == nil then
		local base = Config.RoleData.data_city_id_to_province_id_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.RoleData.data_city_id_to_province_id_cache[key] = {
			province_id = base[1],
			province_name = base[2],
			city_name = base[3],
		}	end
	return Config.RoleData.data_city_id_to_province_id_cache[key] 
end
