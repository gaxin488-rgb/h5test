-- -------------------chapter_reward_start-------------------
Config.GuildSecretAreaData.data_chapter_reward_length = 250
Config.GuildSecretAreaData.data_chapter_reward_cache = {}
Config.GuildSecretAreaData.data_chapter_reward = function(key)
	if Config.GuildSecretAreaData.data_chapter_reward_cache[key] == nil then
		local base = Config.GuildSecretAreaData.data_chapter_reward_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.GuildSecretAreaData.data_chapter_reward_cache[key] = {
			id = base[1],
			harm_times = base[2],
			max_times = base[3],
			change_reward = base[4],
			marketplace_rand_reward = base[5],
			marketplace_reward = base[6],
		}
	end
	return Config.GuildSecretAreaData.data_chapter_reward_cache[key] 
end
