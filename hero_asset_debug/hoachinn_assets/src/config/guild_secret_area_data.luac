Config.GuildSecretAreaData.data_boss_info_length = 250
Config.GuildSecretAreaData.data_boss_info_cache = {}
Config.GuildSecretAreaData.data_boss_info = function(key)
	if Config.GuildSecretAreaData.data_boss_info_cache[key] == nil then
		local base = Config.GuildSecretAreaData.data_boss_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.GuildSecretAreaData.data_boss_info_cache[key] = {
			pass_id = base[1],
			id = base[2],
			name = base[3],
			unit_id = base[4],
			open_lev = base[5],
			difficulty = base[6],
			difficulty_res = base[7],
			time = base[8],
			active = base[9],
			difficulty_change = base[10],
			boss_skill_id = base[11],
			boss_reward = base[12],
		}
	end
	return Config.GuildSecretAreaData.data_boss_info_cache[key] 
end
