-- -------------------drama_start-------------------
Config.SecretDunData.data_drama_length = 5
Config.SecretDunData.data_drama = {
	[1] = {dialogue={{TI18N([[魂·酒神]]),0,0,[[jiushen]],TI18N([[哟，最近来的人类可真不少~]]),300,200,65},{TI18N([[魂·酒神]]),0,0,[[jiushen]],TI18N([[想过来喝一杯酒么？我在这个空间的最深处等着你，不过在这之前，你要打败外面那些碍事的家伙。]]),300,200,65},{TI18N([[魂·酒神]]),0,0,[[jiushen]],TI18N([[一路上会有很多好东西，顺手拿走我也是不介意的哦~]]),300,200,65},{TI18N([[魂·酒神]]),0,0,[[jiushen]],TI18N([[还有，可千万别迷路了哟~]]),300,200,65}}},
	[2] = {dialogue={{TI18N([[魂·洛基]]),0,0,[[luoji]],TI18N([[没想到居然有人类敢闯入这个地方，想尝尝被烧成灰烬的滋味？]]),300,250,65},{TI18N([[魂·洛基]]),0,0,[[luoji]],TI18N([[不过就算你这样求我，也得你有足够的实力来到我面前啊~]]),300,250,65}}},
	[3] = {dialogue={{TI18N([[魂·芬尼尔]]),0,0,[[fennier]],TI18N([[你和我之间，到底谁会是猎物呢？]]),0,150,80},{TI18N([[魂·芬尼尔]]),0,0,[[fennier]],TI18N([[真叫本王期待啊，人类！我已经很久没有尝过美味了。]]),0,150,80}}},
	[4] = {dialogue={{TI18N([[魂·神灵大祭司]]),0,0,[[shenlingdajisi]],TI18N([[终于等到你了，冒险者。]]),250,150,80},{TI18N([[魂·神灵大祭司]]),0,0,[[shenlingdajisi]],TI18N([[如果你是预言中的驱逐黑暗之人，请你以真正的实力将我击败！]]),250,150,80}}},
	[5] = {dialogue={{TI18N([[魂·尼德霍格]]),0,0,[[nidehuoge]],TI18N([[嘿嘿嘿，看来我当年带给你们的绝望还不够刻骨铭心啊。]]),0,150,80},{TI18N([[魂·尼德霍格]]),0,0,[[nidehuoge]],TI18N([[想再体验一次绝望的滋味么？渺小的人类。]]),0,150,80}}}
}
