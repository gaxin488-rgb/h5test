-- -------------------board_start-------------------
Config.SecretDunData.data_board_length = 14
Config.SecretDunData.data_board = {
	[1001] = {id=1001, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("世界本源有五，分别为水、火、风、光、暗五大元素。\n水主生长，能够滋润万物，是万物生存必不可少的元素之一。\n但波涛汹涌之时，水也会湮灭万物。凝结为冰，冰将使万物无法动弹。\n所以，即使心如止水的生命也总会有惊涛骇浪的一面。")},
	[1002] = {id=1002, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("波塞冬本可以继续生活在阿斯加德之中，但他厌倦了所谓的“神的法则”的束缚。\n他只想寻找一个能够随性生活的地方，于是极北之海开始有了“海神”的存在。\n当波塞冬心情平和时，海面风平浪静，但波塞冬一旦动怒，极北之海也将掀起惊天巨浪，吞没一切。")},
	[1003] = {id=1003, btn_str=TI18N("转动"), res_id="board_img_8", title=TI18N("升降开关"), desc_1=TI18N("路上放着一个奇怪的机关，触发后会发生什么呢？"), desc_2=""},
	[1004] = {id=1004, btn_str=TI18N("破坏"), res_id="board_img_6", title=TI18N("可破坏障碍"), desc_1=TI18N("沉重的障碍挡住了前进的道路，里面似乎藏有物品，看来可以拿什么破坏它......"), desc_2=""},
	[2001] = {id=2001, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("世界本源有五，分别为水、火、风、光、暗五大元素。\n火主消亡，炼狱之火足以将世间万物梵为灰烬。\n但看似无尽的消亡中也将孕育出新的希望，所以菲尼克斯浴火后的新生更为强大，普罗米修斯盗取的火种延续了人类的生命。")},
	[2002] = {id=2002, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("普罗米修斯以自身为形象创造出了最初的人类，他坚信智慧将会令人类拥有无限的可能。\n但如今的人类却仍旧无法凭借自己的能力生存，于是普罗米修斯为人类盗取火种。\n人类也由此学会了用火，真正拥有了生存的基础，以及文明发展的根本。")},
	[9901] = {id=9901, btn_str=TI18N("复活"), res_id="board_img_4", title=TI18N("复活十字架"), desc_1=TI18N("蕴含神灵之力的十字架，虔诚的信仰可以沟通到神灵的伟力，其中似乎蕴含着永生的力量。"), desc_2=TI18N("可以随机复活一位已阵亡的英雄并回复其<div fontcolor=289b14>70%</div>的生命值，若当前无阵亡英雄则回复生命值最低的一位英雄<div fontcolor=289b14>100%</div>的生命。")},
	[9951] = {id=9951, btn_str=TI18N("浸泡"), res_id="board_img_7", title=TI18N("回复泉水"), desc_1=TI18N("蕴含生命气息的泉水，即使相隔甚远依然能够感受到泉水所散发出的磅礴生机。"), desc_2=TI18N("浸泡泉水可使所有存活的英雄恢复<div fontcolor=289b14>30%</div>的生命值，泉水仅可使用一次。")},
	[3001] = {id=3001, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("世界本源有五，分别为水、火、风、光、暗五大元素。\n风主传承，无数的生命借由风飞向远方，传播到另一片沃土之上。\n但当怨恨的种子在人心中生根发芽之时，风将会成为无形的利刃，隐匿于暗处，收割生命。")},
	[3002] = {id=3002, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("亡灵收割者的称呼来自于他只将亡灵作为唯一的猎杀目标。\n怨恨会使人变得强大，在一切因亡灵侵袭而化为乌有之后，他的变化完美地验证着这句话。\n没有人知道他的力量从何而来，但复仇，已经成为了他活下去的唯一动力。")},
	[4001] = {id=4001, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("世界本源有五，分别为水、火、风、光、暗五大元素。\n光主创造，万物向往着无尽的光，追寻着属于自己的方向。\n于是伟大先知集齐五大神器，建立先知殿，守卫冒险大陆的和平。在永夜降临之时又不惜献祭自己的生命，封印恶魔，留下预言。")},
	[4002] = {id=4002, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("伟大先知虔诚地信仰着光，他坚信着光与暗存在都有其意义，但光永远比暗更胜一筹。\n于是他游历大陆，在先知能力的指引下终于寻得了五大神器，建立起以守卫大陆稳定为宗旨的先知殿。\n但他的心中隐隐不安，因为预言中大陆将会面临着灭亡的危机。\n“永夜将至，唯有异界之人，凝聚元素之心，方能驱逐黑暗，令希望重燃……”")},
	[5001] = {id=5001, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("世界本源有五，分别为水、火、风、光、暗五大元素。\n暗主毁灭，诅咒在空间之中蔓延开来。\n在漫无边际的黑暗之中，万物的意志将会被不断侵蚀、腐化，直至成为行尸走肉的恶魔。\n冒险大陆的“永夜”也由此而来。")},
	[5002] = {id=5002, btn_str="", res_id="board_img_1", title=TI18N("告示牌"), desc_1=TI18N("位面之中矗立的木板，上面似乎记载着什么"), desc_2=TI18N("黑暗之主隐藏于大陆的角落，开启“永夜祭典”，企图让世界陷入无尽的黑暗之中。\n但大陆西南方久久不散的迷雾引起了先知殿的怀疑，永夜祭典因为伟大先知的到来而中断。\n但人类的力量无法令黑暗之主消亡，伟大先知无奈之下以生命为代价，借助五大神器的力量构筑封印结界，将黑暗之主封印。")}
}
Config.SecretDunData.data_board_fun = function(key)
	local data=Config.SecretDunData.data_board[key]
	if DATA_DEBUG and data == nil then
		print('(Config.SecretDunData.data_board['..key..'])not found') return
	end
	return data
end
