	local data=Config.NinjaTreasureData.data_pro_mine_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.NinjaTreasureData.data_pro_mine_info['..key..'])not found') return
	end
	return data
end
-- -------------------pro_mine_info_end---------------------


