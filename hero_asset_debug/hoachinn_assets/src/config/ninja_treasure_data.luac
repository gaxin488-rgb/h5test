Config.NinjaTreasureData.data_pro_info_fun = function(key)
	local data=Config.NinjaTreasureData.data_pro_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.NinjaTreasureData.data_pro_info['..key..'])not found') return
	end
	return data
end
