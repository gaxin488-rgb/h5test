-- -------------------get_skill_start-------------------
Config.SkillExtensionData.data_get_skill_length = 250
Config.SkillExtensionData.data_get_skill_cache = {}
Config.SkillExtensionData.data_get_skill = function(key)
	if Config.SkillExtensionData.data_get_skill_cache[key] == nil then
		local base = Config.SkillExtensionData.data_get_skill_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.SkillExtensionData.data_get_skill_cache[key] = {
			bid = base[1],
			group = base[2],
			next_id = base[3],
			level = base[4],
			short_des = base[5],
			owner = base[6],
		}
	end
	return Config.SkillExtensionData.data_get_skill_cache[key] 
end
