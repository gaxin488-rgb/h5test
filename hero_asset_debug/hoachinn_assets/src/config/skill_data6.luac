			hurt_effect_list = base[12],
			trc_effect_list = base[13],
			shake_id = base[14],
			ready_sound = base[15],
			attack_sound = base[16],
			hit_sound = base[17],
			is_play_hit_sound = base[18],
			effect_desc = base[19],
			hit_action = base[20],
			act_hurt_type = base[21],
			is_move_map = base[22],
