-- -------------------info_start-------------------
Config.GuildSkillData.data_info_length = 960
Config.GuildSkillData.data_info_cache = {}
Config.GuildSkillData.data_info = function(key)
	if Config.GuildSkillData.data_info_cache[key] == nil then
		local base = Config.GuildSkillData.data_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.GuildSkillData.data_info_cache[key] = {
			id = base[1],
			name = base[2],
			group_id = base[3],
			loss = base[4],
			seq = base[5],
			guild_lev = base[6],
			attr_list = base[7],
			lev = base[8],
		}
	end
	return Config.GuildSkillData.data_info_cache[key] 
end
