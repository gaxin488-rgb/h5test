Config.GuildSkillData.data_pvp_skill_info_length = 36
Config.GuildSkillData.data_pvp_skill_info_cache = {}
Config.GuildSkillData.data_pvp_skill_info = function(key)
	if Config.GuildSkillData.data_pvp_skill_info_cache[key] == nil then
		local base = Config.GuildSkillData.data_pvp_skill_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.GuildSkillData.data_pvp_skill_info_cache[key] = {
			skill_id = base[1],
			career = base[2],
			lev = base[3],
			need_lev = base[4],
			loss = base[5],
			power = base[6],
			return_res = base[7],
		}
	end
	return Config.GuildSkillData.data_pvp_skill_info_cache[key] 
end
