-- -------------------pvp_attr_info_start-------------------
Config.GuildSkillData.data_pvp_attr_info_length = 656
Config.GuildSkillData.data_pvp_attr_info_cache = {}
Config.GuildSkillData.data_pvp_attr_info = function(key)
	if Config.GuildSkillData.data_pvp_attr_info_cache[key] == nil then
		local base = Config.GuildSkillData.data_pvp_attr_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.GuildSkillData.data_pvp_attr_info_cache[key] = {
			id = base[1],
			lev = base[2],
			need_lev = base[3],
			loss = base[4],
			power = base[5],
			return_res = base[6],
			desc = base[7],
			client_attr = base[8],
		}	end
	return Config.GuildSkillData.data_pvp_attr_info_cache[key] 
end
Config.GuildSkillData.data_pvp_attr_info_table = {
