Config.DungeonNinjaWarData.data_drama_dungeon_info_length = 1060
Config.DungeonNinjaWarData.data_drama_dungeon_info_cache = {}
Config.DungeonNinjaWarData.data_drama_dungeon_info = function(key)
	if Config.DungeonNinjaWarData.data_drama_dungeon_info_cache[key] == nil then
		local base = Config.DungeonNinjaWarData.data_drama_dungeon_info_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.DungeonNinjaWarData.data_drama_dungeon_info_cache[key] = {
			name = base[1],
			chapter_id = base[2],
			land_id = base[3],
			id = base[4],
			next_id = base[5],
			hook_items = base[6],
			daily_items = base[7],
			pos = base[8],
			unit_id = base[9],
			face_id = base[10],
			power = base[11],
			lev_limit = base[12],
			add_role_lev = base[13],
			floor = base[14],
			show_items = base[15],
			show_bid = base[16],
			type1 = base[17],
			last_id = base[18],
		}	end
	return Config.DungeonNinjaWarData.data_drama_dungeon_info_cache[key] 
end
