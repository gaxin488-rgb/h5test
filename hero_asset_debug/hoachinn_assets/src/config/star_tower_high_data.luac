Config.StarTowerHighData.data_boss_info_fun = function(key)
	local data=Config.StarTowerHighData.data_boss_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.StarTowerHighData.data_boss_info['..key..'])not found') return
	end
	return data
end
