	[701071] = [[{701071, "初级急救", "辅助觉醒", 70107, 0, 1, 0, 0, "passive_skill", 0, 0, 2, 1, {7010701}, {}, 0, "使用治疗主动技能时，对生命低于20%的友方，使其额外受到20%（固定值）*自身已损失生命占比的治疗效果", "", "", "70107", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701061] = [[{701061, "初级灵感", "辅助觉醒", 70106, 0, 1, 0, 2, "passive_skill", 0, 0, 5, 1, {7010601}, {}, 0, "使用增益主动技能时，有20%概率使增益持续回合+1，该效果冷却2回合；使用减益技能时，效果触发率+5%", "", "", "70106", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701051] = [[{701051, "初级庇护", "坦克觉醒", 70105, 0, 1, 0, 4, "passive_skill", 0, 0, 3, 1, {7010501}, {}, 0, "队友受到致命伤害死亡后，输送自身10%生命对其庇护，自身气血低于40%不会触发，冷却4回合。", "", "", "70105", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701041] = [[{701041, "初级信仰", "坦克觉醒", 70104, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {7010401,7010411}, {}, 0, "自身生命在50%及以上时，受到的物理伤害降低5%；50%以下时，受到治疗增加10%", "", "", "70104", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701031] = [[{701031, "初级制裁", "法师觉醒", 70103, 0, 1, 0, 0, "passive_skill", 0, 0, 1, 1, {7010301}, {}, 0, "攻击时使目标额外受到其生命上限*3%的伤害值（不超过本次所受技能伤害值的30%）", "", "", "70103", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701021] = [[{701021, "初级灵巧", "法师觉醒", 70102, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {7010201}, {}, 0, "无视所有减速效果；每回合开始，每存在1位同系友方英雄，自身速度依次提高3%/6%/9%/11%（无法与【迅捷】共存，优先生效）", "", "", "70102", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701011] = [[{701011, "初级蓄力", "战士觉醒", 70101, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {7010101}, {}, 0, "本回合无法行动时，下次释放攻击技能时伤害额外提高15%（可叠加，无法被驱散，每次释放攻击技能后移除）", "", "", "70101", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[701001] = [[{701001, "初级破裂", "战士觉醒", 70100, 0, 1, 0, 0, "passive_skill", 0, 0, 1, 1, {7010001}, {}, 0, "对带有【护盾】的敌人额外造成5%的伤害，且造成伤害值的30%将直接无视护盾效果", "", "", "70100", 0, 1, 1, {}, 700, 0, 0, 0}]],
	[620506] = [[{620506, "超级吸取", "通用被动", 75040, 0, 4, 0, 0, "passive_skill", 0, 0, 5, 1, {6205006}, {}, 0, "使用物理伤害技能时，以伤害量的33%恢复攻击者自身生命值", "", "", "75043", 0, 1, 1, {}, 4900, 0, 0, 0}]],
	[750403] = [[{750403, "超级吸取", "通用被动", 75040, 0, 4, 0, 0, "passive_skill", 0, 0, 5, 1, {7504004}, {}, 0, "使用物理伤害技能时，以伤害量的33%恢复攻击者自身生命值", "", "", "75044", 0, 1, 1, {}, 1500, 0, 0, 0}]],
