	[701035] = [[{701035, "高级制裁", "法师觉醒", 70103, 0, 3, 0, 0, "passive_skill", 0, 0, 1, 1, {7010305}, {}, 0, "攻击时使目标额外受到其生命上限*7%的伤害值（不超过本次所受技能伤害值的30%）", "", "", "72103", 0, 1, 1, {}, 3500, 0, 0, 0}]],
	[701025] = [[{701025, "高级灵巧", "法师觉醒", 70102, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {7010205}, {}, 0, "无视所有减速效果；每回合开始，每存在1位同系友方英雄，自身速度依次提高8%/11%/14%/18%（无法与【迅捷】共存，优先生效）", "", "", "72102", 0, 1, 1, {}, 3500, 0, 0, 0}]],
	[701015] = [[{701015, "高级蓄力", "战士觉醒", 70101, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {7010105}, {}, 0, "本回合无法行动时，下次释放攻击技能时伤害额外提高25%（可叠加，无法被驱散，每次释放攻击技能后移除）", "", "", "72101", 0, 1, 1, {}, 3500, 0, 0, 0}]],
	[701005] = [[{701005, "高级破裂", "战士觉醒", 70100, 0, 3, 0, 0, "passive_skill", 0, 0, 1, 1, {7010005}, {}, 0, "对带有【护盾】的敌人额外造成15%的伤害，且造成伤害值的50%将直接无视护盾效果", "", "", "72100", 0, 1, 1, {}, 3500, 0, 0, 0}]],
	[835242] = [[{835242, "中级抵抗", "神器被动", 83524, 835243, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {}, {{'dodge_magic',150}}, 0, "提升佩戴者15%效果抵抗", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835232] = [[{835232, "中级命中", "神器被动", 83523, 835233, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {}, {{'hit_magic',150}}, 0, "提升佩戴者15%效果命中", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835222] = [[{835222, "中级封印", "神器被动", 83522, 835223, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8352202}, {}, 0, "攻击有20%几率封印目标，使目标无法触发暴击与英雄技能被动效果", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835212] = [[{835212, "中级冲锋", "神器被动", 83521, 835213, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8352102}, {}, 0, "敌方回合结束时，20%几率获得加速10%效果，1回合", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835202] = [[{835202, "中级玄甲", "神器被动", 83520, 835203, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8352002}, {}, 0, "进入战斗时，增加自身免伤12%，持续2回合", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835192] = [[{835192, "中级复生", "神器被动", 83519, 835193, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8351902}, {}, 0, "死亡时有10%概率复活，恢复40%生命值", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835182] = [[{835182, "中级重击", "神器被动", 83518, 835183, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351802}, {}, 0, "攻击目标时，若单次伤害超过目标生命值上限的35%，则有25%概率使目标眩晕一回合", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835172] = [[{835172, "中级狂暴", "神器被动", 83517, 835173, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351702}, {{'dam_p',100}}, 0, "物理伤害提升10%，若目标携带抗暴，则对其造成的伤害提升15%", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835162] = [[{835162, "中级穿刺", "神器被动", 83516, 835163, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351602}, {{'dam_s',100}}, 0, "魔法伤害提升10%，若目标携带圣盾，则对其造成的伤害提升15%", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
