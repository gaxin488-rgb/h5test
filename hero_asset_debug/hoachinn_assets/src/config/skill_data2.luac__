	[650031] = [[{650031, "风系强化", "活动副本", 65003, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {6500031}, {}, 0, "我方风系英雄伤害提升100%", "", "", "24720", 0, 1, 0, {}, 0, 0, 0, 0}]],
	[650021] = [[{650021, "暗系强化", "活动副本", 65002, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {6500021}, {}, 0, "我方火系英雄伤害提升100%", "", "", "24720", 0, 1, 0, {}, 0, 0, 0, 0}]],
