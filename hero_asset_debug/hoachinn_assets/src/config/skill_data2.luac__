	[811142] = [[{811142, "中级庇佑", "英雄被动", 81114, 0, 1, 0, 0, "passive_skill", 0, 0, 2, 1, {8111410}, {}, 0, "友方被攻击时，40%概率保护队友，并分担50%伤害，自己受到的伤害为所承担伤害的50%", "", "", "81114", 0, 1, 1, {}, 100, 0, 0, 0}]],
