Config.SkillData2.data_get_skill_length = 1622
Config.SkillData2.data_get_skill_cache = {}
Config.SkillData2.data_get_skill = function(key)
	if Config.SkillData2.data_get_skill_cache[key] == nil then
		local base = Config.SkillData2.data_get_skill_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.SkillData2.data_get_skill_cache[key] = {
			bid = base[1],
			name = base[2],
			owner = base[3],
			group = base[4],
			next_id = base[5],
			level = base[6],
			is_normal_skill = base[7],
			cd = base[8],
			type = base[9],
			fit_combat_type = base[10],
			best_target = base[11],
			target = base[12],
			count = base[13],
			effect_list = base[14],
			add_attr = base[15],
			hallows_atk = base[16],
			des = base[17],
			open_desc = base[18],
			skill_desc = base[19],
			icon = base[20],
			is_play_sound = base[21],
			skill_type = base[22],
			passive_skill_show = base[23],
			buff_des = base[24],
			power = base[25],
			target_multi = base[26],
			fire_cd = base[27],
			client_lev = base[28],
		}
	end
	return Config.SkillData2.data_get_skill_cache[key] 
end
