	[835193] = [[{835193, "高级复生", "神器被动", 83519, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8351903}, {}, 0, "死亡时有10%概率复活，恢复50%生命值", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835183] = [[{835183, "高级重击", "神器被动", 83518, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351803}, {}, 0, "攻击目标时，若单次伤害超过目标生命值上限的35%，则有30%概率使目标眩晕一回合", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835173] = [[{835173, "高级狂暴", "神器被动", 83517, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351703}, {{'dam_p',150}}, 0, "物理伤害提升15%，若目标携带抗暴，则对其造成的伤害提升20%", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
