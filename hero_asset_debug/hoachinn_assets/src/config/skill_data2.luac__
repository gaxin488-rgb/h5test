	[835051] = [[{835051, "连击", "神器被动", 83505, 835052, 1, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8350501}, {}, 0, "连击，攻击时10%一定概率触发连击，连击伤害为原伤害的50%，若英雄自身带有连击，则不触发神器被动连击", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
