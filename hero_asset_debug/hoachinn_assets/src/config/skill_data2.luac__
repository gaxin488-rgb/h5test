	[835083] = [[{835083, "高级洞察", "神器被动", 83508, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8350801}, {{'dam',150}}, 0, "伤害提高15%，无视目标隐身，且有30%概率将目标打出隐身状态", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
