	[701076] = [[{701076, "超级急救", "辅助觉醒", 70107, 0, 4, 0, 0, "passive_skill", 0, 0, 2, 1, {7010706}, {}, 0, "使用治疗主动技能时，对生命低于30%的友方，使其额外受到35%（固定值）*自身已损失生命占比的治疗效果", "", "", "73107", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701066] = [[{701066, "超级灵感", "辅助觉醒", 70106, 0, 4, 0, 2, "passive_skill", 0, 0, 5, 1, {7010606}, {}, 0, "使用增益主动技能时，有30%概率使增益持续回合+1，该效果冷却2回合；使用减益技能时，效果触发率+15%", "", "", "73106", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701056] = [[{701056, "超级庇护", "坦克觉醒", 70105, 0, 4, 0, 4, "passive_skill", 0, 0, 3, 1, {7010506}, {}, 0, "队友受到致命伤害死亡后，输送自身20%生命对其庇护，自身气血低于30%不会触发，冷却4回合。", "", "", "73105", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701046] = [[{701046, "超级信仰", "坦克觉醒", 70104, 0, 4, 0, 0, "passive_skill", 0, 0, 5, 1, {7010406,7010416}, {}, 0, "自身生命在50%及以上时，受到的物理伤害降低18%；50%以下时，受到治疗增加30%", "", "", "73104", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701036] = [[{701036, "超级制裁", "法师觉醒", 70103, 0, 4, 0, 0, "passive_skill", 0, 0, 1, 1, {7010306}, {}, 0, "攻击时使目标额外受到其生命上限*10%的伤害值（不超过本次所受技能伤害值的30%）", "", "", "73103", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701026] = [[{701026, "超级灵巧", "法师觉醒", 70102, 0, 4, 0, 0, "passive_skill", 0, 0, 5, 1, {7010206}, {}, 0, "无视所有减速效果；每回合开始，每存在1位同系友方英雄，自身速度依次提高12%/15%/19%/25%（无法与【迅捷】共存，优先生效）", "", "", "73102", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701016] = [[{701016, "超级蓄力", "战士觉醒", 70101, 0, 4, 0, 0, "passive_skill", 0, 0, 5, 1, {7010106}, {}, 0, "本回合无法行动时，下次释放攻击技能时伤害额外提高40%（可叠加，无法被驱散，每次释放攻击技能后移除）", "", "", "73101", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[701006] = [[{701006, "超级破裂", "战士觉醒", 70100, 0, 4, 0, 0, "passive_skill", 0, 0, 1, 1, {7010006}, {}, 0, "对带有【护盾】的敌人额外造成25%的伤害，且造成伤害值的65%将直接无视护盾效果", "", "", "73100", 0, 1, 1, {}, 4500, 0, 0, 0}]],
	[835243] = [[{835243, "高级抵抗", "神器被动", 83524, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {}, {{'dodge_magic',200}}, 0, "提升佩戴者20%效果抵抗", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835233] = [[{835233, "高级命中", "神器被动", 83523, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {}, {{'hit_magic',200}}, 0, "提升佩戴者20%效果命中", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835223] = [[{835223, "高级封印", "神器被动", 83522, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8352203}, {}, 0, "攻击有25%几率封印目标，使目标无法触发暴击与英雄技能被动效果", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
