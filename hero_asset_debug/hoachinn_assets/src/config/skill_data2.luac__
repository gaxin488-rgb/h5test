	[835142] = [[{835142, "中级扰咒", "神器被动", 83514, 835143, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351402}, {{'crit_rate',100}}, 0, "暴击提升10%，若目标携带幸运，则对其造成的伤害提升15%", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835132] = [[{835132, "中级禁制", "神器被动", 83513, 835133, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351302}, {}, 0, "攻击时25%概率为目标附加禁制状态，禁制状态目标无法获得任何增益Buff", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835122] = [[{835122, "中级蓄势", "神器被动", 83512, 835123, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8351202}, {}, 0, "每次受到攻击时，若伤害量超过自身10%，则增加自身5%攻击条", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835112] = [[{835112, "中级疗愈", "神器被动", 83511, 835113, 2, 0, 0, "eqm_passive_skill", 0, 0, 2, 1, {8351102}, {{'cure',100}}, 0, "治疗效果提升10%，治疗目标时25%概率解除目标生命值上限10%的暗伤状态", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835102] = [[{835102, "中级暗伤", "神器被动", 83510, 835103, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351002}, {}, 0, "伤害时40%概率使目标暗伤，损失本次受伤量*10%的生命值上限（单次不超过5%），该效果可叠加，最多削减目标50%生命值上限", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835092] = [[{835092, "中级洞察", "神器被动", 83509, 835093, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8350901}, {}, 0, "伤害提高10%，无视目标隐身，且有30%概率将目标打出隐身状态", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835082] = [[{835082, "中级洞察", "神器被动", 83508, 835083, 2, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8350801}, {{'dam',100}}, 0, "伤害提高10%，无视目标隐身，且有30%概率将目标打出隐身状态", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
	[835072] = [[{835072, "中级隐身", "神器被动", 83507, 835073, 2, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8350702}, {}, 0, "进入战斗时，隐身2回合，不会受到攻击，同时自身攻击力下降30%", "", "", "83501", 0, 1, 1, {}, 1500, 0, 0, 0}]],
