	[835131] = [[{835131, "禁制", "神器被动", 83513, 835132, 1, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351301}, {}, 0, "攻击时20%概率为目标附加禁制状态，禁制状态目标无法获得任何增益Buff", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835121] = [[{835121, "蓄势", "神器被动", 83512, 835122, 1, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8351201}, {}, 0, "每次受到攻击时，若伤害量超过自身15%，则增加自身5%攻击条", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835111] = [[{835111, "疗愈", "神器被动", 83511, 835112, 1, 0, 0, "eqm_passive_skill", 0, 0, 2, 1, {8351101}, {{'cure',50}}, 0, "治疗效果提升5%，治疗目标时20%概率解除目标生命值上限10%的暗伤状态", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835101] = [[{835101, "暗伤", "神器被动", 83510, 835102, 1, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351001}, {}, 0, "伤害时30%概率使目标暗伤，损失本次受伤量*10%的生命值上限（单次不超过5%），该效果可叠加，最多削减目标50%生命值上限", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835091] = [[{835091, "洞察", "神器被动", 83509, 835092, 1, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8350901}, {}, 0, "伤害提高5%，无视目标隐身，且有30%概率将目标打出隐身状态", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835081] = [[{835081, "洞察", "神器被动", 83508, 835082, 1, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8350801}, {{'dam',50}}, 0, "伤害提高5%，无视目标隐身，且有30%概率将目标打出隐身状态", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
	[835071] = [[{835071, "隐身", "神器被动", 83507, 835072, 1, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8350701}, {}, 0, "进入战斗时，隐身2回合，不会受到攻击，同时自身攻击力下降40%", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
