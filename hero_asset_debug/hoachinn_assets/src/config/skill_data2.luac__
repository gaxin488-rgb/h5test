	[835133] = [[{835133, "高级禁制", "神器被动", 83513, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351303}, {}, 0, "攻击时30%概率为目标附加禁制状态，禁制状态目标无法获得任何增益Buff", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835123] = [[{835123, "高级蓄势", "神器被动", 83512, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 5, 1, {8351203}, {}, 0, "每次受到攻击时，若伤害量超过自身10%，则增加自身10%攻击条", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835113] = [[{835113, "高级疗愈", "神器被动", 83511, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 2, 1, {8351103}, {{'cure',150}}, 0, "治疗效果提升15%，治疗目标时30%概率解除目标生命值上限10%的暗伤状态", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
	[835103] = [[{835103, "高级暗伤", "神器被动", 83510, 0, 3, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351003}, {}, 0, "伤害时50%概率使目标暗伤，损失本次受伤量*10%的生命值上限（单次不超过5%），该效果可叠加，最多削减目标50%生命值上限", "", "", "83502", 0, 1, 1, {}, 2100, 0, 0, 0}]],
