	[835181] = [[{835181, "重击", "神器被动", 83518, 835182, 1, 0, 0, "eqm_passive_skill", 0, 0, 1, 1, {8351801}, {}, 0, "攻击目标时，若单次伤害超过目标生命值上限的35%，则有20%概率使目标眩晕一回合", "", "", "83500", 0, 1, 0, {}, 800, 0, 0, 0}]],
