-- -------------------unit_start-------------------
Config.ItemData10.data_unit_length = 1
Config.ItemData10.data_unit_cache = {}
Config.ItemData10.data_unit = function(key)
	if Config.ItemData10.data_unit_cache[key] == nil then
		local base = Config.ItemData10.data_unit_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.ItemData10.data_unit_cache[key] = {
			id = base[1],
			remark = base[2],
			name = base[3],
			icon = base[4],
			type = base[5],
			sub_type = base[6],
			quality = base[7],
			overlap = base[8],
			gain_type = base[9],
			use_type = base[10],
			expire_type = base[11],
			value = base[12],
			effect = base[13],
			client_effect = base[14],
			source = base[15],
			desc = base[16],
			lev = base[17],
			career = base[18],
			sex = base[19],
			ext = base[20],
			is_effect = base[21],
			eqm_jie = base[22],
			fast_use = base[23],
			tips_btn = base[24],
			type_desc = base[25],
			use_desc = base[26],
			can_share = base[27],
			use_count = base[28],
		}
	end
	return Config.ItemData10.data_unit_cache[key] 
end
