Config.PartnerSpecialData.data_partner_star_step_length = 12
Config.PartnerSpecialData.data_partner_star_step_cache = {}
Config.PartnerSpecialData.data_partner_star_step = function(key)
	if Config.PartnerSpecialData.data_partner_star_step_cache[key] == nil then
		local base = Config.PartnerSpecialData.data_partner_star_step_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerSpecialData.data_partner_star_step_cache[key] = {
			bid = base[1],
			star = base[2],
			star_step = base[3],
			add_hp = base[4],
			add_atk = base[5],
			add_def = base[6],
			add_speed = base[7],
			lev_max_up = base[8],
			attr = base[9],
			skill_energy_per = base[10],
			talent_pos = base[11],
			attr_show = base[12],
			expend1 = base[13],
			expend2 = base[14],
			expend3 = base[15],
			other_expend = base[16],
			is_second = base[17],
			expend1_2 = base[18],
			expend2_2 = base[19],
			expend3_2 = base[20],
			other_expend_2 = base[21],
			add_hp_c = base[22],
			add_atk_c = base[23],
			add_def_c = base[24],
			add_speed_c = base[25],
			attr_c = base[26],
		}
	end
	return Config.PartnerSpecialData.data_partner_star_step_cache[key] 
end
