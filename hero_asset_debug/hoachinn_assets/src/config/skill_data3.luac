Config.SkillData3.data_get_effect = function(key)
	if Config.SkillData3.data_get_effect_cache[key] == nil then
		local base = Config.SkillData3.data_get_effect_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
