Config.PrimusElementData.data_single_info_fun = function(key)
	local data=Config.PrimusElementData.data_single_info[key]
	if DATA_DEBUG and data == nil then
		print('(Config.PrimusElementData.data_single_info['..key..'])not found') return
	end
	return data
end
